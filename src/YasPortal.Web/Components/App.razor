@using Microsoft.AspNetCore.Components.Web
@using YasPortal.Web.Components.Layout
@using YasPortal.Web.Components

<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <!--
        Stylesheet load order matters — each file's header comment explains
        why. Summary: base must load first (defines the app shell and the
        generic defaults admin styles override), then shared components and
        notifications, then the admin design system (core -> tables/lists ->
        permission chips -> positions), and rtl-utilities always loads last.
    -->
    <link rel="stylesheet" href="css/base.css?v=20260828-1" />
    <link rel="stylesheet" href="css/components.css?v=20260828-1" />
    <link rel="stylesheet" href="css/notifications.css?v=20260828-1" />
    <link rel="stylesheet" href="css/admin/admin-core.css?v=20260828-2" />
    <link rel="stylesheet" href="css/admin/admin-tables-and-lists.css?v=20260828-2" />
    <link rel="stylesheet" href="css/admin/permission-checkboxes.css?v=20260828-1" />
    <link rel="stylesheet" href="css/admin/positions.css?v=20260828-1" />
    <link rel="stylesheet" href="css/rtl-utilities.css?v=20260828-1" />
    <link rel="stylesheet" href="lib/boxicons/css/boxicons.min.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <ApplicationShell @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/admin-ui.js"></script>
    <script src="js/active-position-dropdown.js"></script>
    <script src="js/server-lookup.js"></script>
    <script src="js/persian-date-picker.js"></script>
    <script src="js/persian-digits.js"></script>
</body>

</html>
