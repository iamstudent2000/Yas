@using Microsoft.AspNetCore.Components.Web
@using YasPortal.Web.Components.Layout
@using YasPortal.Web.Components
@using System.Security.Claims
@using YasPortal.Domain.Preferences
@using YasPortal.Web.Services
@inject UserPreferenceService PreferenceService

@* The outermost page of the whole portal: the HTML document that every screen is delivered inside. *@
@* The page is right-to-left Persian, and the theme, accent colour, font, size and density come from the user's saved preferences. *@
<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="@_ui.Theme" data-accent="@_ui.Accent" data-font="@_ui.Font" data-size="@_ui.Size" data-density="@_ui.Density">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Resolves "system" theme to light/dark before first paint, so there is no flash. *@
    <script>(function(){var r=document.documentElement,t=r.getAttribute('data-theme'),d=t==='dark'||(t==='system'&&window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches);r.setAttribute('data-scheme',d?'dark':'light');})();</script>
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <!--
        Stylesheet load order matters — each file's header comment explains
        why. Summary: base must load first (defines the app shell and the
        generic defaults admin styles override), then shared components and
        notifications, then the admin design system (core -> tables/lists ->
        permission chips -> positions), then personal-pages (dashboard/profile/
        my-positions) and login (branded sign-in screen), and rtl-utilities
        always loads last.
    -->
    <link rel="stylesheet" href="@Assets["css/base.css"]" />
    <link rel="stylesheet" href="@Assets["css/components.css"]" />
    <link rel="stylesheet" href="@Assets["css/notifications.css"]" />
    <link rel="stylesheet" href="@Assets["css/admin/admin-core.css"]" />
    <link rel="stylesheet" href="@Assets["css/admin/admin-tables-and-lists.css"]" />
    <link rel="stylesheet" href="@Assets["css/admin/permission-checkboxes.css"]" />
    <link rel="stylesheet" href="@Assets["css/admin/positions.css"]" />
    <link rel="stylesheet" href="@Assets["css/personal-pages.css"]" />
    <link rel="stylesheet" href="@Assets["css/requests.css"]" />
    <link rel="stylesheet" href="@Assets["css/login.css"]" />
    <link rel="stylesheet" href="@Assets["css/landing.css"]" />
    <link rel="stylesheet" href="@Assets["css/phone-book.css"]" />
    <link rel="stylesheet" href="@Assets["css/guides.css"]" />
    <link rel="stylesheet" href="@Assets["css/gallery.css"]" />
    <link rel="stylesheet" href="@Assets["css/store.css"]" />
    <link rel="stylesheet" href="@Assets["css/server-lookup.css"]" />
    <link rel="stylesheet" href="@Assets["css/theme.css"]" />
    <link rel="stylesheet" href="@Assets["css/rtl-utilities.css"]" />
    <link rel="stylesheet" href="@Assets["css/print.css"]" />
    <link rel="stylesheet" href="@Assets["css/reconnect-modal.css"]" />
    <link rel="stylesheet" href="@Assets["lib/tabler-icons/tabler-icons.min.css"]" />
    @* Head outlet = lets individual pages set their own browser tab title. *@
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

@* Style sheets are listed in a deliberate order (see the note above them); each address comes from the build with a fingerprint in its name, so browsers fetch a new copy after a change by themselves. *@
<body>
    @* The application shell (side menu, top bar and the current page) is created here and stays interactive after the first load. *@
    <ApplicationShell @rendermode="InteractiveServer" />
    @* Pop-up shown when the live connection to the server drops; it lets the user retry or reloads the page when the server gave up. *@
    <div id="components-reconnect-modal">
        <div class="reconnect-box">
            <i class="ti @Icons.Spinner reconnect-spin"></i>
            <p class="reconnect-message"></p>
            <p class="reconnect-attempt">تلاش <span id="components-reconnect-current-attempt"></span> از
                <span id="components-reconnect-max-retries"></span></p>
            <button type="button" class="btn btn-primary reconnect-retry-btn" onclick="window.Blazor.reconnect()">تلاش
                مجدد</button>
        </div>
    </div>
    @* Starts the live-connection engine that keeps the page interactive. *@
    <script src="_framework/blazor.web.js"></script>
    <script>
        document.getElementById('components-reconnect-modal')
            .addEventListener('components-reconnect-state-changed', function (event) {
                if (event.detail.state === 'rejected') {
                    location.reload();
                }
            });
    </script>
    @* Small helper scripts used by the widgets (date picker, dropdown placement, Persian digits, printing, file downloads and so on). *@
    <script src="@Assets["js/admin-ui.js"]"></script>
    <script src="@Assets["js/active-position-dropdown.js"]"></script>
    <script src="@Assets["js/popup-place.js"]"></script>
    <script src="@Assets["js/server-lookup.js"]"></script>
    <script src="@Assets["js/persian-date-picker.js"]"></script>
    <script src="@Assets["js/persian-digits.js"]"></script>
    <script src="@Assets["js/ui-prefs.js"]"></script>
    <script src="@Assets["js/file-download.js"]"></script>
    <script src="@Assets["js/print.js"]"></script>
    <script src="@Assets["js/gallery.js"]"></script>
</body>

</html>

@code {
    // The saved look-and-feel choices of the signed-in user are read once, so the page is painted correctly from the first moment.
    // The current web request, used here only to find out who is signed in.
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // Look-and-feel settings; the defaults apply to visitors who are not signed in.
    private UiPreferenceAttributes _ui = UiPreferenceAttributes.Default;

    // If someone is signed in, load their saved theme, accent colour, font, size and density.
    protected override async Task OnInitializedAsync()
    {
        var user = HttpContext?.User;
        if (user?.Identity?.IsAuthenticated == true && Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var employeeId))
            _ui = UiPreferenceAttributes.From(await PreferenceService.GetAsync(employeeId));
    }
}
