<ListFilterBar Busy="Busy" ActiveCount="State.AppliedCount" CanClear="@(State.AppliedCount > 0 || State.DraftCount > 0)" OnSearch="SearchAsync" OnClear="ClearAsync"
               ExportPermission="@(ExportPermission)" OnExport="OnExport" Exporting="Exporting" SortOptions="SortOptions" Sort="@(State.Sort)" DefaultSort="created:desc" SortChanged="OnSortAsync">
    <div class="admin-filter">
        <label class="form-label">جستجوی سمت</label>
        <input @key="_resetKey" class="form-control" placeholder="نام سمت..." @bind="State.Search" @bind:event="oninput" />
    </div>
    <div class="admin-filter">
        <label class="form-label">وضعیت</label>
        <LookupSelect @key="_resetKey" Options="StatusOptions" Value="@(State.Status == "" ? null : State.Status)" ValueChanged="k => State.Status = k ?? string.Empty" Placeholder="همه وضعیت‌ها" />
    </div>
</ListFilterBar>

@code {
    /// <summary>
    /// The choices of one delegation list. Search and Status are the draft the boxes edit; "جستجو" copies them to
    /// the Applied values the page queries with. Sort needs no search button, so it is used as it is.
    /// </summary>
    public sealed class FilterState
    {
        public string Search { get; set; } = "";
        /// <summary>Empty for all, otherwise a DelegationStatus name.</summary>
        public string Status { get; set; } = "";
        public string Sort { get; set; } = "created:desc";

        public string AppliedSearch { get; private set; } = "";
        public string AppliedStatus { get; private set; } = "";

        public int AppliedCount => (AppliedSearch.Trim().Length > 0 ? 1 : 0) + (AppliedStatus != "" ? 1 : 0);
        public int DraftCount => (Search.Trim().Length > 0 ? 1 : 0) + (Status != "" ? 1 : 0);
        /// <summary>True while a search or status choice narrows the list (sorting alone does not).</summary>
        public bool IsActive => AppliedCount > 0;

        public void Apply() { AppliedSearch = Search.Trim(); AppliedStatus = Status; }
        public void Reset() { Search = ""; Status = ""; AppliedSearch = ""; AppliedStatus = ""; }
    }

    [Parameter, EditorRequired] public FilterState State { get; set; } = new();
    [Parameter] public bool Busy { get; set; }
    /// <summary>Optional: puts "خروجی CSV" in the ⋯ menu; it exports everything the last search matched.</summary>
    [Parameter] public EventCallback OnExport { get; set; }
    [Parameter] public bool Exporting { get; set; }
    [Parameter] public string ExportPermission { get; set; } = "";
    /// <summary>Raised after a search, clear or sort change; the page goes back to page 1 and reloads.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private int _resetKey;

    private static readonly IReadOnlyList<(string Key, string Text)> StatusOptions =
    [
        ("Active", "فعال"),
        ("Upcoming", "در انتظار شروع"),
        ("Expired", "منقضی"),
        ("Revoked", "لغو شده"),
    ];

    private static readonly IReadOnlyList<(string Key, string Text)> SortOptions =
    [
        SortSelect.Option("created:desc", "جدیدترین ثبت"),
        SortSelect.Option("created:asc", "قدیمی‌ترین ثبت"),
        SortSelect.Option("start:desc", "شروع (نزدیک‌ترین اول)"),
        SortSelect.Option("start:asc", "شروع (دورترین اول)"),
        SortSelect.Option("end:desc", "پایان (دیرترین اول)"),
        SortSelect.Option("end:asc", "پایان (زودترین اول)"),
        SortSelect.Option("position:asc", "نام سمت"),
    ];

    private Task SearchAsync() { State.Apply(); return Changed.InvokeAsync(); }
    private Task ClearAsync() { State.Reset(); _resetKey++; return Changed.InvokeAsync(); }
    private Task OnSortAsync(string value) { State.Sort = value; return Changed.InvokeAsync(); }
}
