@using System.Text.Json
@using YasPortal.Domain.Workflows
@using YasPortal.Web.Services

<div class="field-summary">
    @foreach (var field in WorkflowFieldCatalog.GetFields(Request.WorkflowType))
    {
        var value = WorkflowDisplay.FormatFieldValue(field, GetFieldValue(field.Key));
        if (!string.IsNullOrWhiteSpace(value))
        {
            <div class="field-summary-item"><span>@field.Label</span><strong>@value</strong></div>
        }
    }
</div>

@{
    var rounds = Request.Steps.GroupBy(x => x.Round).OrderBy(g => g.Key).ToList();
    if (rounds.Count == 0)
    {
        rounds = new[] { Request.Steps.GroupBy(x => 1).FirstOrDefault() }.Where(x => x != null).ToList()!;
    }
    var requesterName = EmployeeNames.TryGetValue(Request.RequesterEmployeeId, out var rn) ? rn : null;
    var allRoundKeys = rounds.Select(g => g.Key).DefaultIfEmpty(1).ToList();
}

@foreach (var round in rounds.DefaultIfEmpty())
{
    var roundKey = round?.Key ?? 1;
    var isCurrentRound = roundKey == Request.CurrentRound;
    var roundSteps = round?.OrderBy(x => x.Order).ToList() ?? new List<WorkflowRequestStep>();

    if (isCurrentRound)
    {
        @if (allRoundKeys.Count > 1)
        {
            <p class="round-heading">دور @ToPersianDigits(roundKey.ToString()) (فعلی)</p>
        }
        <div class="approval-timeline">
            @* Requester row — always visible *@
            @if (roundKey == 1)
            {
                <div class="approval-step">
                    <span class="approval-step-icon is-requester"><i class="bx bx-plus-circle"></i></span>
                    <div class="approval-step-body">
                        <strong>ثبت درخواست</strong>
                        <div class="approval-step-meta">
                            توسط درخواست‌کننده ثبت شد
                            @if (requesterName is not null)
                            {
                                <span> — @requesterName</span>
                            }
                            <span> · @Request.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="approval-step">
                    <span class="approval-step-icon is-requester"><i class="bx bx-refresh"></i></span>
                    <div class="approval-step-body">
                        <strong>ارسال مجدد</strong>
                        <div class="approval-step-meta">
                            درخواست‌کننده پس از اصلاح دوباره ارسال کرد
                            @if (requesterName is not null)
                            {
                                <span> — @requesterName</span>
                            }
                        </div>
                    </div>
                </div>
            }

            <WorkflowStepTimeline Steps="roundSteps"
                                  CurrentRound="Request.CurrentRound"
                                  CurrentStepOrder="Request.CurrentStepOrder"
                                  EmployeeNames="EmployeeNames"
                                  HolderNames="HolderNames"
                                  HighlightStepId="HighlightStepId"
                                  ShowHolderForCurrentStep="ShowHolderForCurrentStep" />

            @if (Request.Status == WorkflowRequestStatus.Cancelled)
            {
                <div class="approval-step">
                    <span class="approval-step-icon is-cancelled"><i class="bx bx-x-circle"></i></span>
                    <div class="approval-step-body">
                        <strong>لغو درخواست</strong>
                        <div class="approval-step-meta">
                            توسط درخواست‌کننده لغو شد
                            @if (requesterName is not null)
                            {
                                <span> — @requesterName</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        var expanded = _expandedRounds.Contains(roundKey);
        <div class="round-history">
            <button type="button" class="round-history-toggle" @onclick="() => ToggleRound(roundKey)">
                <i class="bx @(expanded ? "bx-chevron-up" : "bx-chevron-down")"></i>
                <span>دور @ToPersianDigits(roundKey.ToString()) (پیشین — بازگشت به درخواست‌کننده)</span>
            </button>
            @if (expanded)
            {
                <div class="approval-timeline">
                    @if (roundKey == 1)
                    {
                        <div class="approval-step">
                            <span class="approval-step-icon is-requester"><i class="bx bx-plus-circle"></i></span>
                            <div class="approval-step-body">
                                <strong>ثبت درخواست</strong>
                                <div class="approval-step-meta">
                                    توسط درخواست‌کننده ثبت شد
                                    @if (requesterName is not null)
                                    {
                                        <span> — @requesterName</span>
                                    }
                                    <span> · @Request.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="approval-step">
                            <span class="approval-step-icon is-requester"><i class="bx bx-refresh"></i></span>
                            <div class="approval-step-body">
                                <strong>ارسال مجدد</strong>
                                <div class="approval-step-meta">
                                    درخواست‌کننده پس از اصلاح دوباره ارسال کرد
                                    @if (requesterName is not null)
                                    {
                                        <span> — @requesterName</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    <WorkflowStepTimeline Steps="roundSteps"
                                          CurrentRound="Request.CurrentRound"
                                          CurrentStepOrder="Request.CurrentStepOrder"
                                          EmployeeNames="EmployeeNames"
                                          HolderNames="HolderNames"
                                          HighlightStepId="HighlightStepId"
                                          ShowHolderForCurrentStep="ShowHolderForCurrentStep" />
                </div>
            }
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public WorkflowRequest Request { get; set; } = null!;
    [Parameter] public Dictionary<Guid, string> EmployeeNames { get; set; } = [];
    [Parameter] public Dictionary<Guid, string> HolderNames { get; set; } = [];
    [Parameter] public Guid? HighlightStepId { get; set; }
    [Parameter] public bool ShowHolderForCurrentStep { get; set; } = true;

    private readonly HashSet<int> _expandedRounds = [];

    private void ToggleRound(int round)
    {
        if (!_expandedRounds.Add(round))
            _expandedRounds.Remove(round);
    }

    private string? GetFieldValue(string key)
    {
        try
        {
            var values = JsonSerializer.Deserialize<Dictionary<string, string?>>(Request.FieldValuesJson);
            return values is not null && values.TryGetValue(key, out var value) ? value : null;
        }
        catch (JsonException) { return null; }
    }

    private static string ToPersianDigits(string value)
    {
        const string digits = "۰۱۲۳۴۵۶۷۸۹";
        var chars = value.Select(c => c is >= '0' and <= '9' ? digits[c - '0'] : c).ToArray();
        return new string(chars);
    }
}
