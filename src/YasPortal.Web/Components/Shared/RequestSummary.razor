@using System.Text.Json
@using YasPortal.Domain.Workflows
@using System.Linq
@using YasPortal.Web.Services

@{
    var currentSteps = Request.Steps.Where(x => x.Round == Request.CurrentRound).ToList();
    var stageViews = currentSteps
        .GroupBy(x => x.Order)
        .OrderBy(g => g.Key)
        .Select(g =>
        {
            var members = g.OrderBy(x => x.Name, StringComparer.Ordinal).ThenBy(x => x.Id).ToList();
            var live = Request.Status == WorkflowRequestStatus.PendingApproval && g.Key == Request.CurrentStepOrder;
            return new StageView(g.Key, members, WorkflowStageSummary.Of(members, live));
        })
        .ToList();
}
@if (stageViews.Count > 0)
{
    var now = DescribeNow(stageViews);
    <div class="rt-progress">
        <div class="rt-progress-track" role="list" aria-label="پیشرفت مسیر تایید">
            @for (var i = 0; i < stageViews.Count; i++)
            {
                var view = stageViews[i];
                var stateClass = WorkflowDisplay.StageStateClass(view.Summary.State);
                var tip = string.Join(" / ", view.Members.Select(m => m.Name)) + " — " + WorkflowDisplay.StageStateLabel(view.Summary.State);
                <span class="rt-progress-dot @stateClass" role="listitem" title="@tip">
                    @if (view.Summary.State is WorkflowStageState.Approved or WorkflowStageState.Rejected or WorkflowStageState.Returned)
                    {
                        <i class="bx @WorkflowDisplay.StageStateIcon(view.Summary.State)"></i>
                    }
                    else
                    {
                        <text>@ToPersianDigits(view.Order.ToString())</text>
                    }
                </span>
                @if (i < stageViews.Count - 1)
                {
                    <span class="rt-progress-line @(view.Summary.State == WorkflowStageState.Approved ? "is-done" : "")"></span>
                }
            }
        </div>
        <p class="rt-now @now.Class"><i class="bx @now.Icon"></i><span>@now.Text</span></p>
    </div>
}

@{
    var formParts = WorkflowFieldCatalog.GetParts(Request.WorkflowType);
    var isMultiPart = formParts.Count > 1;
}
<div class="field-summary">
    <div class="field-summary-item"><span>شناسه درخواست</span><strong dir="ltr">#@(Request.Id.ToString("N")[..8])</strong></div>
    @if (isMultiPart)
    {
        <p class="round-heading">بخش @ToPersianDigits(formParts[0].Part.ToString()): @formParts[0].Title</p>
    }
    @foreach (var field in WorkflowFieldCatalog.GetFields(Request.WorkflowType, 1))
    {
        var value = WorkflowDisplay.FormatFieldValue(field, GetFieldValue(field.Key));
        if (!string.IsNullOrWhiteSpace(value))
        {
            <div class="field-summary-item"><span>@field.Label</span><strong>@value</strong></div>
        }
    }
</div>
@if (isMultiPart)
{
    @foreach (var part in formParts.Where(p => p.Part > 1))
    {
        var partFields = WorkflowFieldCatalog.GetFields(Request.WorkflowType, part.Part);
        var filled = partFields
            .Select(f => (Field: f, Value: WorkflowDisplay.FormatFieldValue(f, GetFieldValue(f.Key))))
            .Where(x => !string.IsNullOrWhiteSpace(x.Value))
            .ToList();
        <div class="field-summary">
            <p class="round-heading">بخش @ToPersianDigits(part.Part.ToString()): @part.Title</p>
            @if (filled.Count == 0)
            {
                <div class="field-summary-item"><span>وضعیت</span><strong class="muted">هنوز تکمیل نشده است</strong></div>
            }
            @foreach (var item in filled)
            {
                <div class="field-summary-item"><span>@item.Field.Label</span><strong>@item.Value</strong></div>
            }
        </div>
    }
}

@if (Request.RequesterActions.Any(a => a.Kind == WorkflowRequesterActionKind.Reopened))
{
    <div class="field-summary field-history">
        <p class="round-heading">بازگشایی‌ها</p>
        @foreach (var reopen in Request.RequesterActions.Where(a => a.Kind == WorkflowRequesterActionKind.Reopened).OrderBy(a => a.AtUtc))
        {
            var by = EmployeeNames.TryGetValue(reopen.EmployeeId, out var reopenedBy) ? reopenedBy : null;
            <div class="field-summary-item">
                <span>بازگشایی رد‌شده (دور @ToPersianDigits(reopen.Round.ToString()))</span>
                <strong>@(string.IsNullOrWhiteSpace(reopen.Reason) ? "—" : reopen.Reason)</strong>
                <div class="approval-step-meta">@(by is null ? "" : by + " · ")@reopen.AtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
            </div>
        }
    </div>
}

@if (Request.FieldChanges.Count > 0)
{
    <div class="field-summary field-history">
        <p class="round-heading">تاریخچه تغییر فیلدها</p>
        @foreach (var change in Request.FieldChanges.OrderBy(x => x.ChangedAtUtc).ThenBy(x => x.FieldKey, StringComparer.Ordinal))
        {
            var field = WorkflowFieldCatalog.GetFields(Request.WorkflowType).FirstOrDefault(f => f.Key == change.FieldKey);
            var label = field?.Label ?? change.FieldKey;
            var oldText = field is null ? change.OldValue : WorkflowDisplay.FormatFieldValue(field, change.OldValue);
            var newText = field is null ? change.NewValue : WorkflowDisplay.FormatFieldValue(field, change.NewValue);
            var editor = EmployeeNames.TryGetValue(change.ChangedByEmployeeId, out var en) ? en : null;
            <div class="field-summary-item">
                <span>@label (دور @ToPersianDigits(change.Round.ToString()))</span>
                <strong>@(string.IsNullOrWhiteSpace(oldText) ? "—" : oldText) ← @(string.IsNullOrWhiteSpace(newText) ? "—" : newText)</strong>
                <div class="approval-step-meta">@(editor is null ? "" : editor + " · ")@change.ChangedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
            </div>
        }
    </div>
}

@{
    var rounds = Request.Steps.GroupBy(x => x.Round).OrderBy(g => g.Key).ToList();
    var requesterName = EmployeeNames.TryGetValue(Request.RequesterEmployeeId, out var rn) ? rn : null;
    var stepDecisions = Request.StepDecisions.ToList();
    var roundKeys = rounds.Select(g => g.Key).DefaultIfEmpty(1).ToList();
}

@foreach (var roundKey in roundKeys)
{
    var isCurrentRound = roundKey == Request.CurrentRound;
    var roundSteps = rounds.FirstOrDefault(g => g.Key == roundKey)?.OrderBy(x => x.Order).ToList() ?? new List<WorkflowRequestStep>();

    if (isCurrentRound)
    {
        @if (roundKeys.Count > 1)
        {
            <p class="round-heading">دور @ToPersianDigits(roundKey.ToString()) (فعلی)</p>
        }
        <RequestFlow Request="Request" RoundKey="roundKey" RoundSteps="roundSteps" IsCurrentRound="true"
                     RequesterName="@requesterName" EmployeeNames="EmployeeNames" HolderNames="HolderNames"
                     Decisions="stepDecisions" HighlightStepId="HighlightStepId" YourStepId="YourStepId"
                     ShowHolderForCurrentStep="ShowHolderForCurrentStep" />
    }
    else
    {
        var expanded = _expandedRounds.Contains(roundKey);
        <div class="round-history">
            <button type="button" class="round-history-toggle" @onclick="() => ToggleRound(roundKey)">
                <i class="bx @(expanded ? "bx-chevron-up" : "bx-chevron-down")"></i>
                <span>دور @ToPersianDigits(roundKey.ToString()) (پیشین — بازگشت به درخواست‌کننده)</span>
            </button>
            @if (expanded)
            {
                <RequestFlow Request="Request" RoundKey="roundKey" RoundSteps="roundSteps" IsCurrentRound="false"
                             RequesterName="@requesterName" EmployeeNames="EmployeeNames" HolderNames="HolderNames"
                             Decisions="stepDecisions" HighlightStepId="HighlightStepId" YourStepId="YourStepId"
                             ShowHolderForCurrentStep="ShowHolderForCurrentStep" />
            }
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public WorkflowRequest Request { get; set; } = null!;
    [Parameter] public Dictionary<Guid, string> EmployeeNames { get; set; } = [];
    [Parameter] public Dictionary<Guid, string> HolderNames { get; set; } = [];
    [Parameter] public Guid? HighlightStepId { get; set; }

    /// <summary>The step the viewer is being asked to decide right now (inbox), so the summary can say "نوبت شماست".</summary>
    [Parameter] public Guid? YourStepId { get; set; }
    [Parameter] public bool ShowHolderForCurrentStep { get; set; } = true;

    private readonly HashSet<int> _expandedRounds = [];

    private void ToggleRound(int round)
    {
        if (!_expandedRounds.Add(round))
            _expandedRounds.Remove(round);
    }

    private string? GetFieldValue(string key)
    {
        try
        {
            var values = JsonSerializer.Deserialize<Dictionary<string, string?>>(Request.FieldValuesJson);
            return values is not null && values.TryGetValue(key, out var value) ? value : null;
        }
        catch (JsonException) { return null; }
    }

    private sealed record StageView(int Order, List<WorkflowRequestStep> Members, WorkflowStageSummary Summary);

    /// <summary>The one-sentence "where is this request now" line shown above the details.</summary>
    private (string Icon, string Class, string Text) DescribeNow(List<StageView> stages)
    {
        switch (Request.Status)
        {
            case WorkflowRequestStatus.PendingApproval:
            {
                var live = stages.FirstOrDefault(s => s.Order == Request.CurrentStepOrder);
                var waiting = live?.Members.Where(m => m.Status == WorkflowStepStatus.Pending).ToList() ?? [];
                if (waiting.Count == 0)
                    return ("bx-time", "is-queued", "درخواست در حال بررسی است.");

                string Who(WorkflowRequestStep step) => ShowHolderForCurrentStep
                    ? $"«{step.Name}» — {(HolderNames.TryGetValue(step.ApproverPositionId, out var holder) ? holder : "سمت خالی")}"
                    : $"«{step.Name}»";

                var yours = YourStepId is Guid mine && waiting.Any(m => m.Id == mine);
                if (yours)
                {
                    var others = waiting.Where(m => m.Id != YourStepId).ToList();
                    return ("bx-time-five", "is-awaiting",
                        others.Count == 0
                            ? "نوبت شماست."
                            : "نوبت شماست؛ هم‌زمان در انتظار: " + string.Join("، ", others.Select(Who)) + ".");
                }

                return ("bx-time-five", "is-awaiting",
                    waiting.Count == 1
                        ? "در انتظار تصمیم " + Who(waiting[0]) + "."
                        : $"در انتظار {ToPersianDigits(waiting.Count.ToString())} تاییدکننده هم‌زمان: " + string.Join("، ", waiting.Select(Who)) + ".");
            }

            case WorkflowRequestStatus.Approved:
                return ("bx-check-circle", "is-approved", "درخواست تایید نهایی شد.");

            case WorkflowRequestStatus.Rejected:
            {
                var rejecting = stages.SelectMany(s => s.Members).Where(m => m.Status == WorkflowStepStatus.Rejected).OrderByDescending(m => m.ActedAtUtc).FirstOrDefault();
                var by = rejecting?.ActedByEmployeeId is Guid actor && EmployeeNames.TryGetValue(actor, out var actorName) ? " توسط " + actorName : "";
                return ("bx-x-circle", "is-rejected", rejecting is null ? "درخواست رد شد." : $"درخواست در «{rejecting.Name}» رد شد{by}.");
            }

            case WorkflowRequestStatus.ReturnedToRequester:
                return ("bx-undo", "is-returned", "درخواست به درخواست‌کننده بازگردانده شد؛ پس از اصلاح باید دوباره ارسال شود.");

            default:
                return ("bx-x-circle", "is-skipped", Request.ForceClosedByEmployeeId is not null ? "درخواست توسط مدیر سامانه بسته شد." : "درخواست لغو شد.");
        }
    }

    private static string ToPersianDigits(string value)
    {
        const string digits = "۰۱۲۳۴۵۶۷۸۹";
        var chars = value.Select(c => c is >= '0' and <= '9' ? digits[c - '0'] : c).ToArray();
        return new string(chars);
    }
}
