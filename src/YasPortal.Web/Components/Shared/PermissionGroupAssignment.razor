@using Microsoft.EntityFrameworkCore
@using YasPortal.Domain.Authorization
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Services
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AppState AppState

<section class="permission-group-assignment">
    <div class="group-assignment-header">
        <div>
            <h3 class="sub-title" style="margin:0"><i class="bx bx-layer"></i> گروه‌های مجوز</h3>
            @if (IsAdmin)
            {
                <p class="help-text">این گروه‌ها مستقیماً به مدیر سامانه اختصاص داده می‌شوند و به هیچ سمت سازمانی وابسته نیستند.</p>
            }
            else if (PositionId == Guid.Empty)
            {
                <p class="help-text">برای مدیریت گروه‌ها ابتدا یک سمت فعال را انتخاب کنید.</p>
            }
            else
            {
                <p class="help-text">گروه‌ها فقط مجوز اضافه می‌کنند. مجوز نهایی این ترکیب = مجوزهای مستقیم + مجوزهای همه گروه‌ها.</p>
            }
        </div>
        @if (CanAssign)
        {
            <span class="effective-permission-badge">@_effectivePermissionCount مجوز نهایی</span>
        }
    </div>

    @if (CanAssign)
    {
        <div class="group-search"><i class="bx bx-search"></i><input class="form-control" placeholder="جستجوی گروه..." @bind="_search" @bind:event="oninput" /></div>
        <div class="group-assignment-grid">
            @foreach (var group in FilteredGroups)
            {
                <label class="group-assignment-card @(IsAssigned(group.Id) ? "assigned" : "")">
                    <input type="checkbox" checked="@IsAssigned(group.Id)" disabled="@_saving" @onchange="e => ToggleGroup(group.Id, e.Value is bool value && value)" />
                    <span class="group-check"></span>
                    <span class="group-info"><strong>@group.Name</strong><small>@group.PermissionCount مجوز @(!string.IsNullOrWhiteSpace(group.Description) ? $" — {group.Description}" : "")</small></span>
                    <span class="group-state">@(IsAssigned(group.Id) ? "فعال" : "اختصاص")</span>
                </label>
            }
        </div>
        @if (FilteredGroups.Count == 0)
        {
            <div class="empty-state">گروه مجوزی تعریف نشده است. از «مدیریت سامانه ← گروه‌های مجوز» یک گروه بسازید.</div>
        }
    }
</section>

@code {
    [Parameter] public Guid EmployeeId { get; set; }
    [Parameter] public Guid PositionId { get; set; }
    [Parameter] public bool IsAdmin { get; set; }

    private List<GroupRow> _groups = [];
    private HashSet<Guid> _assignedGroupIds = [];
    private string _search = "";
    private bool _saving;
    private int _effectivePermissionCount;

    private bool CanAssign => EmployeeId != Guid.Empty && (IsAdmin || PositionId != Guid.Empty);

    private IReadOnlyList<GroupRow> FilteredGroups => _groups
        .Where(x => string.IsNullOrWhiteSpace(_search) || x.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || (x.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private bool IsAssigned(Guid groupId) => _assignedGroupIds.Contains(groupId);

    private async Task LoadAsync()
    {
        if (!CanAssign)
        {
            _groups = [];
            _assignedGroupIds = [];
            _effectivePermissionCount = 0;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        _groups = await db.PermissionGroups.AsNoTracking().OrderBy(x => x.Name)
            .Select(x => new GroupRow(x.Id, x.Name, x.Description, db.PermissionGroupPermissions.Count(p => p.GroupId == x.Id)))
            .ToListAsync();

        _assignedGroupIds = IsAdmin
            ? await db.EmployeePermissionGroups.AsNoTracking().Where(x => x.EmployeeId == EmployeeId).Select(x => x.GroupId).ToHashSetAsync()
            : await db.UserPositionPermissionGroups.AsNoTracking().Where(x => x.EmployeeId == EmployeeId && x.PositionId == PositionId).Select(x => x.GroupId).ToHashSetAsync();

        var directIds = IsAdmin
            ? await db.EmployeePermissions.AsNoTracking().Where(x => x.EmployeeId == EmployeeId).Select(x => x.PermissionId).ToListAsync()
            : await db.UserPositionPermissions.AsNoTracking().Where(x => x.EmployeeId == EmployeeId && x.PositionId == PositionId).Select(x => x.PermissionId).ToListAsync();

        var groupIds = _assignedGroupIds.ToList();
        var groupPermissionIds = groupIds.Count == 0
            ? []
            : await db.PermissionGroupPermissions.AsNoTracking().Where(x => groupIds.Contains(x.GroupId)).Select(x => x.PermissionId).ToListAsync();
        _effectivePermissionCount = directIds.Concat(groupPermissionIds).Distinct().Count();
    }

    private async Task ToggleGroup(Guid groupId, bool assign)
    {
        if (!CanAssign) return;
        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (IsAdmin)
            {
                var link = await db.EmployeePermissionGroups.SingleOrDefaultAsync(x => x.EmployeeId == EmployeeId && x.GroupId == groupId);
                if (assign && link is null) db.EmployeePermissionGroups.Add(new EmployeePermissionGroup(EmployeeId, groupId));
                else if (!assign && link is not null) db.EmployeePermissionGroups.Remove(link);
                else return;
            }
            else
            {
                if (!await db.EmployeePositions.AnyAsync(x => x.EmployeeId == EmployeeId && x.PositionId == PositionId && x.EndedAt == null))
                {
                    AppState.AddToast("این سمت دیگر فعال نیست.", ToastLevel.Error);
                    await LoadAsync();
                    return;
                }

                var link = await db.UserPositionPermissionGroups.SingleOrDefaultAsync(x => x.EmployeeId == EmployeeId && x.PositionId == PositionId && x.GroupId == groupId);
                if (assign && link is null) db.UserPositionPermissionGroups.Add(new UserPositionPermissionGroup(EmployeeId, PositionId, groupId));
                else if (!assign && link is not null) db.UserPositionPermissionGroups.Remove(link);
                else return;
            }

            await db.SaveChangesAsync();
            await LoadAsync();
            AppState.AddToast(assign ? "گروه مجوز اختصاص یافت." : "گروه مجوز حذف شد.", ToastLevel.Success);
        }
        catch (DbUpdateException)
        {
            AppState.AddToast("تغییر گروه مجوز ذخیره نشد. دوباره تلاش کنید.", ToastLevel.Error);
            await LoadAsync();
        }
        finally { _saving = false; }
    }

    private sealed record GroupRow(Guid Id, string Name, string? Description, int PermissionCount);
}

<style>
.permission-group-assignment{margin-top:18px;padding-top:16px;border-top:1px solid #eaecf0}.group-assignment-header{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}.effective-permission-badge{white-space:nowrap;padding:7px 11px;border-radius:999px;background:#eef4ff;color:#175cd3;font-size:12px;font-weight:700}.group-search{display:flex;align-items:center;gap:8px;margin:12px 0}.group-search i{font-size:20px}.group-assignment-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.group-assignment-card{display:flex;align-items:center;gap:10px;padding:12px;border:1px solid #eaecf0;border-radius:12px;cursor:pointer;background:#fff}.group-assignment-card.assigned{border-color:#84adff;background:#f5f8ff}.group-assignment-card input{margin:0}.group-info{display:flex;flex-direction:column;gap:3px;min-width:0;flex:1}.group-info strong{overflow:hidden;text-overflow:ellipsis}.group-info small{color:#667085;line-height:1.6}.group-state{font-size:11px;color:#667085}.group-assignment-card.assigned .group-state{font-weight:700;color:#175cd3}@media(max-width:900px){.group-assignment-grid{grid-template-columns:1fr}}
</style>
