@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using YasPortal.Web.Services
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@* One sidebar link for a whole section: shown when the person may open at least one of its tabs, and it leads to the first of them. *@
@if (_first is not null)
{
    <a href="@_first.Href" class="@(IsActive ? "active" : "")"><i class="ti @Icon"></i><span>@Title</span>@if (Badge > 0)
        {
            <span class="nav-badge">@Badge</span>
        }</a>
}

@code {
    // The section key, the link text, the icon and an optional counter bubble, all handed in by the sidebar.
    [Parameter, EditorRequired] public string Group { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter] public int Badge { get; set; }

    // The first tab this person may open (where the link leads), and all tabs they may open.
    private SectionTab? _first;
    private IReadOnlyList<SectionTab> _tabs = [];

    // The link is highlighted while the person is on any page that belongs to this section.
    private bool IsActive
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
            return _tabs.Any(t => t.IsCurrent(path));
        }
    }

    // On start: find the section, keep only the tabs this person has permission for; no permitted tab means no link at all.
    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        var section = SectionNav.Find(Group);
        if (section is null) return;
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _tabs = await SectionNav.VisibleAsync(AuthorizationService, user, section);
        _first = _tabs.FirstOrDefault();
    }

    // Re-draw whenever the address changes so the highlight follows navigation.
    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => await InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
