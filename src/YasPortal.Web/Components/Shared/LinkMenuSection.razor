@using YasPortal.Domain.Landing
@* One group in the links menu. The top group is shown open inside its dropdown; a sub-group is a closed heading that opens (and
   closes) when clicked, so a deep tree stays short. Each level opens on its own. *@
@if (Depth == 0)
{
    <div class="lm-section"><LinkMenuBody Node="Node" Depth="Depth" /></div>
}
else
{
    <div class="lm-section is-sub @(_expanded ? "is-expanded" : "")">
        <button type="button" class="lm-sub-toggle" aria-expanded="@(_expanded ? "true" : "false")" @onclick="() => _expanded = !_expanded">
            <i class="ti ti-chevron-left lm-sub-caret"></i>
            <i class="ti ti-folder"></i> <span>@Node.Name</span> <span class="lm-count">@Node.TotalLinks</span>
        </button>
        @if (_expanded)
        {
            <div class="lm-sub-body"><LinkMenuBody Node="Node" Depth="Depth" /></div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public LinkGroupNode Node { get; set; } = null!;
    [Parameter] public int Depth { get; set; }

    private bool _expanded;
}
