<div class="admin-filter">
    <label class="form-label">@Label</label>
    <LookupSelect Options="Options" Value="@(IsDefault ? null : Value)" ValueChanged="OnChanged"
                  Placeholder="@DefaultLabel" SearchPlaceholder="جستجو در ترتیب‌ها..." />
</div>

@code {
    /// <summary>Sort choices as (value, label). A value is "key:asc" or "key:desc"; see <see cref="Split"/>.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<(string Key, string Text)> Options { get; set; } = [];
    [Parameter] public string Label { get; set; } = "ترتیب";
    [Parameter] public string Value { get; set; } = "";
    /// <summary>The page's normal order; the ✕ on the picker goes back to it and it is what an unpicked box shows.</summary>
    [Parameter, EditorRequired] public string Default { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private bool IsDefault => string.IsNullOrEmpty(Value) || Value == Default;
    private string DefaultLabel => Options.FirstOrDefault(o => o.Key == Default).Text ?? "پیش‌فرض";

    private Task OnChanged(string? key) => ValueChanged.InvokeAsync(string.IsNullOrEmpty(key) ? Default : key);

    /// <summary>Splits "created:desc" into the sort key and whether it is descending.</summary>
    public static (string Key, bool Descending) Split(string? value)
    {
        var text = value ?? "";
        var colon = text.LastIndexOf(':');
        return colon < 0 ? (text, false) : (text[..colon], text[(colon + 1)..] == "desc");
    }

    public static (string Key, string Text) Option(string value, string label) => (value, label);
}
