@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using YasPortal.Domain.Notifications
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@inject NotificationService NotificationSvc
@inject AppState AppState
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>@(AdminView ? "اعلان‌های مدیر" : "اعلان‌ها") - یاس پورتال</PageTitle>

<div class="requests-page" dir="rtl">
    <div class="page-header">
        <div>
            <div class="page-kicker">@(AdminView ? "مدیریت سامانه" : "درخواست‌ها و گردش‌کار")</div>
            <h1 class="page-title"><i class="ti @Icons.Bell"></i> @(AdminView ? "اعلان‌های مدیر" : "اعلان‌ها")</h1>
            <p class="page-subtitle">@(AdminView ? "هشدارهای سامانه برای مدیران، مانند مرحله‌ای که سمت آن خالی است و درخواست نمی‌تواند پیش برود." : "رویدادهای مربوط به درخواست‌های شما و مراحلی که به شما رسیده است.")</p>
        </div>
        <div class="form-actions">
            <button class="btn btn-secondary" disabled="@(_unread == 0)" @onclick="MarkAllReadAsync"><i class="ti @Icons.ConfirmAll"></i> خواندن همه</button>
        </div>
    </div>

    <ListFilterBar Busy="_loading" ActiveCount="@((_unreadOnly ? 1 : 0) + (_kind is null ? 0 : 1))"
                   CanClear="@(_unreadOnly || _kind is not null || _dUnread || _dKind is not null)" OnSearch="SearchAsync" OnClear="ClearAsync"
                   SortOptions="_sortOptions" Sort="@(_sort)" DefaultSort="created:desc" SortChanged="OnSortChangedAsync">
        @if (!AdminView)
        {
            <div class="admin-filter">
                <label class="form-label">نوع اعلان</label>
                <LookupSelect @key="_resetKey" Options="KindOptions" Value="@(_dKind?.ToString())" ValueChanged="k => _dKind = Enum.TryParse<NotificationKind>(k, out var kind) ? kind : null" Placeholder="همه انواع" />
            </div>
        }
        <div class="admin-filter">
            <label class="form-label">وضعیت خواندن</label>
            <LookupSelect @key="_resetKey" Options="_readOptions" Value="@(_dUnread ? "unread" : null)" ValueChanged="k => _dUnread = k is not null" Placeholder="همه" />
        </div>
    </ListFilterBar>

    @if (_loading)
    {
        <section class="card"><LoadingState /></section>
    }
    else if (_items.Count == 0)
    {
        <section class="card"><div class="empty-state"><i class="ti @Icons.NoNotifications"></i><strong>@(_unreadOnly || _kind is not null ? "اعلانی با این فیلترها پیدا نشد" : (AdminView ? "اعلانی برای مدیران ثبت نشده است" : "هنوز اعلانی ندارید"))</strong></div></section>
    }
    else
    {
        @foreach (var item in _items)
        {
            <div class="request-card notification-card @(item.IsRead ? "is-read" : "is-unread")">
                <div class="request-card-header is-clickable" role="link" tabindex="0" @onclick="() => OpenAsync(item)" @onkeydown="e => OnKeyAsync(e, item)">
                    <span class="request-card-icon"><i class="ti @IconFor(item.Kind)"></i></span>
                    <span class="request-card-title">
                        <strong>@item.Message</strong>
                        <span>@item.RequestType · @item.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                    </span>
                    @if (!item.IsRead)
                    {
                        <span class="badge badge-info">جدید</span>
                    }
                </div>
            </div>
        }
        <ServerPagination Page="_page" PageSize="_pageSize" TotalCount="_total" Busy="_loading" PageChanged="GoToPageAsync" PageSizeChanged="OnPageSizeChangedAsync" />
    }
</div>

@code {
    /// <summary>True on /admin/notifications: administrators' own alerts (vacant positions), without the request-event filters.</summary>
    [Parameter] public bool AdminView { get; set; }

    private bool _loading = true;
    private bool _unreadOnly;
    private NotificationKind? _kind;
    private string _sort = "created:desc";
    private static readonly IReadOnlyList<(string Key, string Text)> _sortOptions =
    [
        SortSelect.Option("created:desc", "جدیدترین اول"),
        SortSelect.Option("created:asc", "قدیمی‌ترین اول"),
        SortSelect.Option("unread:desc", "خوانده‌نشده‌ها اول"),
    ];
    private Guid? _employeeId;
    private List<Notification> _items = [];
    private int _page = 1;
    private int _pageSize = 20;
    private int _total;
    private int _unread;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _employeeId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            if (_employeeId is not Guid employeeId)
            {
                _items = [];
                return;
            }

            var (sortKey, sortDesc) = SortSelect.Split(_sort);
            var oldestFirst = sortKey == "created" && !sortDesc;
            var unreadFirst = sortKey == "unread";
            (_items, _total) = await NotificationSvc.ListAsync(employeeId, _unreadOnly, _page, _pageSize, _kind, oldestFirst, unreadFirst);
            if (_items.Count == 0 && _page > 1)
            {
                _page = Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));
                (_items, _total) = await NotificationSvc.ListAsync(employeeId, _unreadOnly, _page, _pageSize, _kind, oldestFirst, unreadFirst);
            }
            _unread = await NotificationSvc.CountUnreadAsync(employeeId);
        }
        finally { _loading = false; }
    }

    // The boxes edit the draft (_d…); "جستجو" copies it to _kind/_unreadOnly, which LoadAsync reads.
    private NotificationKind? _dKind;
    private bool _dUnread;
    private int _resetKey;
    private static readonly IReadOnlyList<(string Key, string Text)> _readOptions = [("unread", "فقط خوانده‌نشده")];

    private static IReadOnlyList<(string Key, string Text)> KindOptions { get; } =
        Enum.GetValues<NotificationKind>().Select(k => (k.ToString(), KindLabel(k))).ToList();

    private async Task SearchAsync()
    {
        _kind = _dKind;
        _unreadOnly = _dUnread;
        _page = 1;
        await LoadAsync();
    }

    private async Task ClearAsync()
    {
        _kind = _dKind = null;
        _unreadOnly = _dUnread = false;
        _resetKey++;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnSortChangedAsync(string value)
    {
        _sort = value;
        _page = 1;
        await LoadAsync();
    }

    private static string KindLabel(NotificationKind kind) => kind switch
    {
        NotificationKind.StepReached => "رسیدن درخواست به مرحله شما",
        NotificationKind.ReturnedToStep => "بازگشت درخواست به مرحله شما",
        NotificationKind.RequestApproved => "تایید نهایی درخواست",
        NotificationKind.RequestRejected => "رد درخواست",
        NotificationKind.RequestReturned => "بازگشت درخواست به شما",
        NotificationKind.RequestForceClosed => "بسته‌شدن توسط مدیر",
        NotificationKind.RequestReopened => "بازگشایی درخواست",
        NotificationKind.DelegationReceived => "تفویض دریافتی",
        NotificationKind.RequestCreatedForYou => "ثبت درخواست توسط مدیر",
        NotificationKind.VacantPosition => "سمت خالی",
        _ => kind.ToString(),
    };

    private async Task GoToPageAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task OnPageSizeChangedAsync(int size)
    {
        _pageSize = Math.Clamp(size, 1, 100);
        _page = 1;
        await LoadAsync();
    }

    private async Task OnKeyAsync(KeyboardEventArgs e, Notification item)
    {
        if (e.Key is "Enter" or " ")
            await OpenAsync(item);
    }

    private async Task OpenAsync(Notification item)
    {
        if (_employeeId is Guid employeeId && !item.IsRead)
        {
            await NotificationSvc.MarkReadAsync(employeeId, item.Id);
            AppState.NotifyRequestBadgesChanged();
        }
        Navigation.NavigateTo(item.LinkPath);
    }

    private async Task MarkAllReadAsync()
    {
        if (_employeeId is not Guid employeeId)
            return;
        await NotificationSvc.MarkAllReadAsync(employeeId);
        AppState.NotifyRequestBadgesChanged();
        await LoadAsync();
    }

    private static string IconFor(NotificationKind kind) => kind switch
    {
        NotificationKind.StepReached => Icons.Inbox,
        NotificationKind.ReturnedToStep => Icons.Returned,
        NotificationKind.RequestApproved => Icons.Approved,
        NotificationKind.RequestRejected => Icons.Rejected,
        NotificationKind.RequestReturned => Icons.Returned,
        NotificationKind.RequestForceClosed => Icons.ForceClose,
        NotificationKind.RequestCreatedForYou => Icons.NewRequestForOthers,
        NotificationKind.VacantPosition => Icons.PositionVacant,
        _ => Icons.Bell,
    };
}
