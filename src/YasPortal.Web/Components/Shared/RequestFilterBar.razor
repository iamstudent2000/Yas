@using YasPortal.Domain.Workflows
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Services

<section class="card request-filter @(_open ? "is-open" : "")" dir="rtl">
    <button type="button" class="request-filter-toggle" aria-expanded="@(_open ? "true" : "false")" @onclick="() => _open = !_open">
        <i class="bx bx-filter-alt"></i> فیلترها
        @if (ActiveCount > 0)
        {
            <span class="badge badge-info">@ActiveCount</span>
        }
        <i class="bx @(_open ? "bx-chevron-up" : "bx-chevron-down") request-filter-toggle-chevron"></i>
    </button>
    <div class="admin-filters request-filter-body">
        <div class="admin-filter">
            <label class="form-label">شناسه درخواست</label>
            <input class="form-control" placeholder="مثلا a1b2c3d4" value="@Filter.IdText" @oninput="e => SetDebounced(() => Filter.IdText = e.Value?.ToString())" />
        </div>
        <div class="admin-filter">
            <label class="form-label">نوع درخواست</label>
            <select class="form-control" value="@(Filter.Type?.ToString() ?? "")" @onchange="e => Set(() => Filter.Type = Enum.TryParse<WorkflowTypeCode>(e.Value?.ToString(), out var t) ? t : null)">
                <option value="">همه انواع</option>
                @foreach (var type in WorkflowFieldCatalog.AllTypes)
                {
                    <option value="@type">@WorkflowFieldCatalog.GetDisplayName(type)</option>
                }
            </select>
        </div>
        @if (StatusOptions.Count > 0)
        {
            <div class="admin-filter">
                <label class="form-label">وضعیت</label>
                <select class="form-control" value="@(Filter.Status?.ToString() ?? "")" @onchange="e => Set(() => Filter.Status = Enum.TryParse<WorkflowRequestStatus>(e.Value?.ToString(), out var s) ? s : null)">
                    <option value="">همه وضعیت‌ها</option>
                    @foreach (var status in StatusOptions)
                    {
                        <option value="@status">@WorkflowDisplay.StatusLabel(status)</option>
                    }
                </select>
            </div>
        }
        @if (ShowRequester)
        {
            <div class="admin-filter">
                <label class="form-label">درخواست‌کننده</label>
                <input class="form-control" placeholder="بخشی از نام" value="@Filter.RequesterName" @oninput="e => SetDebounced(() => Filter.RequesterName = e.Value?.ToString())" />
            </div>
        }
        @if (ShowStep)
        {
            <div class="admin-filter">
                <label class="form-label">مرحله جاری</label>
                <input class="form-control" placeholder="بخشی از نام مرحله" value="@Filter.StepName" @oninput="e => SetDebounced(() => Filter.StepName = e.Value?.ToString())" />
            </div>
        }
        <div class="admin-filter"><label class="form-label">از تاریخ</label><PersianDatePicker Value="Filter.From" ValueChanged="d => Set(() => Filter.From = d)" Placeholder="تاریخ شروع" /></div>
        <div class="admin-filter"><label class="form-label">تا تاریخ</label><PersianDatePicker Value="Filter.To" ValueChanged="d => Set(() => Filter.To = d)" Placeholder="تاریخ پایان" /></div>
        <div class="admin-filter request-filter-clear">
            <button type="button" class="btn btn-secondary" disabled="@Filter.IsEmpty" @onclick="ClearAsync"><i class="bx bx-eraser"></i> پاک کردن فیلترها</button>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public WorkflowRequestFilter Filter { get; set; } = new();

    /// <summary>The statuses offered in the status filter; empty hides it (the list is already one status).</summary>
    [Parameter] public IReadOnlyList<WorkflowRequestStatus> StatusOptions { get; set; } = [];
    [Parameter] public bool ShowRequester { get; set; } = true;
    [Parameter] public bool ShowStep { get; set; }

    /// <summary>Raised after any change, so the page reloads from page 1.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    // Only matters on phones, where the filters start folded so the list is the first thing on screen.
    private bool _open;

    private int ActiveCount =>
        (Filter.Status is null ? 0 : 1) + (Filter.Type is null ? 0 : 1) + (Filter.From is null ? 0 : 1) + (Filter.To is null ? 0 : 1)
        + (string.IsNullOrWhiteSpace(Filter.RequesterName) ? 0 : 1) + (string.IsNullOrWhiteSpace(Filter.StepName) ? 0 : 1)
        + (string.IsNullOrWhiteSpace(Filter.IdText) ? 0 : 1);

    private async Task Set(Action apply)
    {
        apply();
        await Changed.InvokeAsync();
    }

    private CancellationTokenSource? _debounce;

    /// <summary>Text boxes search while typing, shortly after the last keystroke, so nothing needs Enter or a click away.</summary>
    private async Task SetDebounced(Action apply)
    {
        apply();
        _debounce?.Cancel();
        var cts = _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        await Changed.InvokeAsync();
    }

    private async Task ClearAsync()
    {
        Filter.Clear();
        await Changed.InvokeAsync();
    }
}
