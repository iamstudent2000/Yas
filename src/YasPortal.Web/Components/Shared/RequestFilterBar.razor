@using YasPortal.Domain.Workflows
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Services
@inject AdminQueryService AdminQueries

<section class="card request-filter @(_open ? "is-open" : "")" dir="rtl">
    <button type="button" class="request-filter-toggle" aria-expanded="@(_open ? "true" : "false")" @onclick="() => _open = !_open">
        <i class="bx bx-filter-alt"></i> فیلترها
        @if (ActiveCount > 0)
        {
            <span class="badge badge-info">@ActiveCount</span>
        }
        <i class="bx @(_open ? "bx-chevron-up" : "bx-chevron-down") request-filter-toggle-chevron"></i>
    </button>
    <div class="admin-filters request-filter-body">
        <div class="admin-filter">
            <label class="form-label">شناسه درخواست</label>
            <input class="form-control" placeholder="مثلا a1b2c3d4" @bind="_d.IdText" @bind:event="onchange" />
        </div>
        <div class="admin-filter">
            <label class="form-label">متن در فرم درخواست</label>
            <input class="form-control" placeholder="بخشی از هر فیلد، مثلا نام کالا" @bind="_d.Text" @bind:event="onchange" />
        </div>
        <div class="admin-filter">
            <label class="form-label">نوع درخواست</label>
            <select class="form-control" @onchange="e => _d.Type = Enum.TryParse<WorkflowTypeCode>(e.Value?.ToString(), out var t) ? t : null">
                <option value="" selected="@(_d.Type is null)">همه انواع</option>
                @foreach (var type in WorkflowFieldCatalog.AllTypes)
                {
                    <option value="@type" selected="@(_d.Type == type)">@WorkflowFieldCatalog.GetDisplayName(type)</option>
                }
            </select>
        </div>
        @if (StatusOptions.Count > 0)
        {
            <div class="admin-filter">
                <label class="form-label">وضعیت</label>
                <select class="form-control" @onchange="OnStatusChanged">
                    <option value="" selected="@(_d.Status is null)">همه وضعیت‌ها</option>
                    @foreach (var status in StatusOptions)
                    {
                        <option value="@status" selected="@(_d.Status == status)">@WorkflowDisplay.StatusLabel(status)</option>
                    }
                </select>
            </div>
        }
        @if (ShowRequester)
        {
            <div class="admin-filter">
                <label class="form-label">درخواست‌کننده</label>
                <ServerSearchableGuidSelect @key="_resetKey" Value="_d.RequesterEmployeeId" ValueChanged="SetRequester"
                                            SearchAsync="SearchEmployeesAsync" SelectedText="@_requesterText"
                                            Placeholder="همه درخواست‌کننده‌ها" SearchPlaceholder="نام، کد یا نام کاربری..." />
            </div>
        }
        @if (ShowStep)
        {
            <div class="admin-filter">
                <label class="form-label">مرحله جاری</label>
                <select class="form-control" @onchange="e => _d.StepName = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()">
                    <option value="" selected="@string.IsNullOrWhiteSpace(_d.StepName)">همه مرحله‌ها</option>
                    @foreach (var name in _stepNames)
                    {
                        <option value="@name" selected="@(_d.StepName == name)">@name</option>
                    }
                </select>
            </div>
        }
        @if (ShowAdminExtras)
        {
            <div class="admin-filter">
                <label class="form-label">نحوه لغو</label>
                <select class="form-control" @onchange="OnCancelKindChanged">
                    <option value="" selected="@(_d.CancelledBy is null)">همه</option>
                    <option value="ByRequester" selected="@(_d.CancelledBy == WorkflowRequestFilter.CancelKind.ByRequester)">لغو توسط درخواست‌کننده</option>
                    <option value="ByAdmin" selected="@(_d.CancelledBy == WorkflowRequestFilter.CancelKind.ByAdmin)">بسته‌شده توسط مدیر</option>
                </select>
            </div>
            <div class="admin-filter">
                <label class="form-label">سمت درخواست‌کننده</label>
                <ServerSearchableGuidSelect @key="_resetKey" Value="_d.RequesterPositionId" ValueChanged="id => { _d.RequesterPositionId = id; return Task.CompletedTask; }"
                                            SearchAsync="SearchPositionsAsync" SelectedText="@_positionText"
                                            Placeholder="همه سمت‌ها" SearchPlaceholder="نام یا کد سمت..." />
            </div>
            <div class="admin-filter">
                <label class="form-label">سازمان درخواست‌کننده</label>
                <ServerSearchableGuidSelect @key="_resetKey" Value="_d.RequesterOrganizationId" ValueChanged="id => { _d.RequesterOrganizationId = id; return Task.CompletedTask; }"
                                            SearchAsync="SearchOrganizationsAsync" SelectedText=""
                                            Placeholder="همه سازمان‌ها" SearchPlaceholder="نام سازمان..." />
            </div>
            <div class="admin-filter">
                <label class="form-label">منتظر تصمیم سمت</label>
                <ServerSearchableGuidSelect @key="_resetKey" Value="_d.WaitingAtPositionId" ValueChanged="id => { _d.WaitingAtPositionId = id; return Task.CompletedTask; }"
                                            SearchAsync="SearchPositionsAsync" SelectedText=""
                                            Placeholder="همه سمت‌ها" SearchPlaceholder="نام یا کد سمت..." />
            </div>
            <div class="admin-filter">
                <label class="form-label">تصمیم‌گیرنده (تایید/رد کرده)</label>
                <ServerSearchableGuidSelect @key="_resetKey" Value="_d.ActedByEmployeeId" ValueChanged="id => { _d.ActedByEmployeeId = id; return Task.CompletedTask; }"
                                            SearchAsync="SearchEmployeesAsync" SelectedText=""
                                            Placeholder="همه" SearchPlaceholder="نام، کد یا نام کاربری..." />
            </div>
            <div class="admin-filter admin-filter-check">
                <label class="check-row"><input type="checkbox" checked="@_d.CreatedByAdminOnly" @onchange="e => _d.CreatedByAdminOnly = (bool)(e.Value ?? false)" /> <span>فقط ثبت‌شده توسط مدیر</span></label>
            </div>
        }
        <div class="admin-filter"><label class="form-label">از تاریخ</label><PersianDatePicker Value="_d.From" ValueChanged="d => _d.From = d" Placeholder="تاریخ شروع" /></div>
        <div class="admin-filter"><label class="form-label">تا تاریخ</label><PersianDatePicker Value="_d.To" ValueChanged="d => _d.To = d" Placeholder="تاریخ پایان" /></div>
        <div class="admin-filter request-filter-clear">
            <button type="button" class="btn btn-primary" @onclick="SearchAsync"><i class="bx bx-search"></i> جستجو</button>
            <button type="button" class="btn btn-secondary" disabled="@(Filter.IsEmpty && _d.IsEmpty)" @onclick="ClearAsync"><i class="bx bx-eraser"></i> پاک کردن فیلترها</button>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public WorkflowRequestFilter Filter { get; set; } = new();

    /// <summary>The statuses offered in the status filter; empty hides it (the list is already one status).</summary>
    [Parameter] public IReadOnlyList<WorkflowRequestStatus> StatusOptions { get; set; } = [];
    [Parameter] public bool ShowRequester { get; set; } = true;
    [Parameter] public bool ShowStep { get; set; }

    /// <summary>Administrator-only filters: requester position and "submitted by an admin".</summary>
    [Parameter] public bool ShowAdminExtras { get; set; }

    /// <summary>Raised when the user presses "جستجو" (or clears), so the page reloads from page 1.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    // Edits are kept in a draft and only applied to Filter when the search button is pressed — nothing searches while typing or picking.
    private readonly WorkflowRequestFilter _d = new();
    private string _requesterText = "", _positionText = "";
    private IReadOnlyList<string> _stepNames = [];
    private int _resetKey;

    // Only matters on phones, where the filters start folded so the list is the first thing on screen.
    private bool _open;

    protected override async Task OnInitializedAsync()
    {
        _d.CopyFrom(Filter);
        if (ShowStep)
            _stepNames = await AdminQueries.GetWorkflowStepNamesAsync();
    }

    private int ActiveCount =>
        (Filter.Status is null ? 0 : 1) + (Filter.CancelledBy is null ? 0 : 1) + (Filter.Type is null ? 0 : 1) + (Filter.From is null ? 0 : 1) + (Filter.To is null ? 0 : 1)
        + (Filter.RequesterEmployeeId is null && string.IsNullOrWhiteSpace(Filter.RequesterName) ? 0 : 1) + (string.IsNullOrWhiteSpace(Filter.StepName) ? 0 : 1)
        + (string.IsNullOrWhiteSpace(Filter.IdText) ? 0 : 1) + (Filter.RequesterPositionId is null ? 0 : 1) + (Filter.CreatedByAdminOnly ? 1 : 0)
        + (Filter.RequesterOrganizationId is null ? 0 : 1) + (Filter.WaitingAtPositionId is null ? 0 : 1) + (Filter.ActedByEmployeeId is null ? 0 : 1) + (string.IsNullOrWhiteSpace(Filter.Text) ? 0 : 1);

    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchEmployeesAsync(string search, CancellationToken ct) =>
        AdminQueries.SearchEmployeesAsync(search, ct);

    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchPositionsAsync(string search, CancellationToken ct) =>
        AdminQueries.SearchPositionsAsync(search, null, null, ct);

    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchOrganizationsAsync(string search, CancellationToken ct) =>
        AdminQueries.SearchOrganizationsAsync(search, true, ct);

    private void OnStatusChanged(ChangeEventArgs e)
    {
        _d.Status = Enum.TryParse<WorkflowRequestStatus>(e.Value?.ToString(), out var st) ? st : null;
        // A cancel kind only makes sense for cancelled requests, so choosing another status drops it.
        if (_d.Status is not null && _d.Status != WorkflowRequestStatus.Cancelled)
            _d.CancelledBy = null;
    }

    private void OnCancelKindChanged(ChangeEventArgs e)
    {
        _d.CancelledBy = Enum.TryParse<WorkflowRequestFilter.CancelKind>(e.Value?.ToString(), out var k) ? k : null;
        if (_d.CancelledBy is not null)
            _d.Status = WorkflowRequestStatus.Cancelled;
    }

    private Task SetRequester(Guid? id)
    {
        _d.RequesterEmployeeId = id;
        return Task.CompletedTask;
    }

    private async Task SearchAsync()
    {
        Filter.CopyFrom(_d);
        await Changed.InvokeAsync();
    }

    private async Task ClearAsync()
    {
        Filter.Clear();
        _d.Clear();
        _requesterText = _positionText = "";
        _resetKey++;   // re-creates the pickers so they show "all" again
        await Changed.InvokeAsync();
    }
}
