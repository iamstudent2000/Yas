@using YasPortal.Domain.Landing
@* The home page's horizontal links menu: one dropdown per top group (its links and its
   sub-groups), and "سایر" for links in no group. With a mouse a dropdown opens when the pointer is over its button and closes when
   the pointer leaves it; a click keeps it open. On touch screens it opens on tap. Escape, a click outside, or opening another closes it.
   A sub-group is an item with an arrow; it opens as its own menu beside the parent menu (not inside it).
 *@
<nav class="lm" dir="rtl" aria-label="پیوندها" @onkeydown="OnKeyDown">
    @* While a dropdown is open, an invisible layer behind it closes everything when clicked. *@
    @if (_open is not null)
    {
        <div class="lm-backdrop" @onclick="Close"></div>
    }
    <ul class="lm-bar">
        @* One dropdown button per top-level link group; the panel with its links appears only for the open one. *@
        @for (var i = 0; i < Tree.Groups.Count; i++)
        {
            var group = Tree.Groups[i];
            var key = group.Id.ToString();
            <li class="lm-item" @onpointerenter="e => HoverOpen(key, e)" @onpointerleave="() => HoverLeave(key)">
                <button type="button" class="lm-top @(_open == key ? "is-open" : "")" aria-expanded="@(_open == key ? "true" : "false")" @onclick="() => Toggle(key)">
                    <i class="ti ti-folder"></i> @group.Name <i class="ti ti-chevron-down lm-caret"></i>
                </button>
                @if (_open == key)
                {
                    @* A menu with sub-groups must not clip them, so it does not scroll by itself ("has-fly"). *@
                    <div class="lm-panel @(Flip(i) ? "is-flipped" : "") @(group.Children.Count > 0 ? "has-fly" : "")"><LinkMenuSection Node="group" /></div>
                }
            </li>
        }
        @* Links that belong to no group are collected under one extra dropdown. *@
        @if (Tree.Ungrouped.Count > 0)
        {
            <li class="lm-item" @onpointerenter="e => HoverOpen(OtherKey, e)" @onpointerleave="() => HoverLeave(OtherKey)">
                <button type="button" class="lm-top @(_open == OtherKey ? "is-open" : "")" aria-expanded="@(_open == OtherKey ? "true" : "false")" @onclick="() => Toggle(OtherKey)">
                    <i class="ti ti-folder"></i> سایر <i class="ti ti-chevron-down lm-caret"></i>
                </button>
                @if (_open == OtherKey)
                {
                    <div class="lm-panel @(Flip(Tree.Groups.Count) ? "is-flipped" : "")"><ul class="lm-links">@foreach (var link in Tree.Ungrouped) { <li><LinkMenuEntry Link="link" /></li> }</ul></div>
                }
            </li>
        }
    </ul>
</nav>

@code {
    // Which dropdown is open right now (nothing when closed), .
    private const string OtherKey = "other";
    private string? _open;
    // The dropdown that the mouse pointer opened (it closes when the pointer leaves, unless it was clicked to keep it open).
    private string? _hoverOpened;

    // The links tree (groups, sub-groups and ungrouped links) handed in by the home page.
    [Parameter, EditorRequired] public LinkTree Tree { get; set; } = null!;

    // The last dropdowns sit on the far side of the bar, so they open towards the middle instead of off the screen.
    // The bar is right-to-left: item 0 is at the right edge. A panel normally opens from the button's right edge and grows to the
    // left (under the bar). Only the last few buttons, at the left end of a crowded bar, would run past the left edge, so only
    // those open from their left edge and grow to the right. In a short bar nothing is flipped, so no panel leaves the bar.
    private bool Flip(int index)
    {
        var total = Tree.Groups.Count + (Tree.Ungrouped.Count > 0 ? 1 : 0);
        return total > 4 && index >= total - 3;
    }

    // Mouse pointer over a group button: open its dropdown (a finger on a touch screen does not count, it opens by the tap).
    private void HoverOpen(string key, PointerEventArgs e)
    {
        if (e.PointerType != "mouse") return;
        _open = key;
        _hoverOpened = key;
    }

    // Pointer left the button and its dropdown: close it, but only if it was opened by the pointer and not kept open by a click.
    private void HoverLeave(string key)
    {
        if (_hoverOpened != key) return;
        _hoverOpened = null;
        _open = null;
    }

    private void Toggle(string key)
    {
        // A click on a dropdown that the pointer just opened keeps it open (it would otherwise close it at once).
        if (_hoverOpened == key) { _hoverOpened = null; return; }
        _hoverOpened = null;
        _open = _open == key ? null : key;
    }

    private void Close()
    {
        _open = null;
        _hoverOpened = null;
    }

    // Escape closes the open dropdown.
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
    }

}
