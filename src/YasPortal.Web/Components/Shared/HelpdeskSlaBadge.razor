@using YasPortal.Domain.Workflows
@using YasPortal.Web.Services

@* How long a helpdesk request has been waiting, with its priority. Nothing for any other request or once it is no longer pending. *@
@if (_waiting is not null)
{
    <span class="badge badge-muted" title="در انتظار از: @WorkflowDisplay.ToPersianDateTime(_waiting.SinceUtc)">
        <i class="ti @Icons.Age"></i>
        @(_waiting.Priority is null ? "" : $"اولویت {_waiting.Priority} · ")@WaitedText()
    </span>
}

@code {
    [Parameter, EditorRequired] public WorkflowRequest Request { get; set; } = null!;

    private HelpdeskWaitingStatus? _waiting;

    protected override void OnParametersSet() => _waiting = HelpdeskWaiting.For(Request, DateTime.UtcNow);

    private string WaitedText() => WorkflowDisplay.FormatDuration(_waiting!.Waited) + " در انتظار";
}
