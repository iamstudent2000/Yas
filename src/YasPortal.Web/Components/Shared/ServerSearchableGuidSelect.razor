@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using YasPortal.Web.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="server-lookup @(Disabled ? "disabled" : "")" dir="rtl">
    <button @ref="_trigger" type="button" class="server-lookup-trigger form-control" disabled="@Disabled"
            @onclick="ToggleAsync">
        <span class="server-lookup-value">@(string.IsNullOrWhiteSpace(SelectedText) ? (_selectedDisplayText ??
                        Placeholder) : SelectedText)</span>
            <i class="bx bx-chevron-down"></i>
        </button>
        @if (_open && !Disabled)
        {
            <button type="button" class="server-lookup-backdrop" aria-label="بستن فهرست انتخاب" @onclick="CloseAsync"></button>
            <div @ref="_menu" class="server-lookup-menu">
                <div class="server-lookup-search">
                    <i class="bx bx-search"></i>
                    <input @ref="_input" value="@_search" @oninput="SearchInputChanged" @onkeydown="HandleKeyDown"
                           placeholder="@SearchPlaceholder" autocomplete="off" />
                </div>
                @if (_loading)
                {
                    <div class="server-lookup-empty"><i class="bx bx-loader-alt bx-spin"></i> در حال جستجو...</div>
                }
                else if (_options.Count == 0)
                {
                    <div class="server-lookup-empty">نتیجه‌ای پیدا نشد.</div>
                }
                else
                {
                    <div class="server-lookup-results">
                        @foreach (var option in _options)
                        {
                            <button type="button" class="server-lookup-option @(option.Id == Value ? "selected" : "")"
                                    @onclick="() => SelectAsync(option)">
                                <span>@option.Text</span>
                                @if (option.Id == Value)
                                {
                                    <i class="bx bx-check"></i>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </div>

@code {
    [Parameter] public Guid? Value { get; set; }
    [Parameter] public EventCallback<Guid?> ValueChanged { get; set; }
    [Parameter]
    public Func<string, CancellationToken, Task<IReadOnlyList<AdminQueryService.LookupItem>>> SearchAsync
    {
        get;
        set;
    } = default!;
    [Parameter] public string Placeholder { get; set; } = "انتخاب کنید...";
    [Parameter] public string SearchPlaceholder { get; set; } = "جستجو...";
    [Parameter] public string? SelectedText { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private ElementReference _trigger;
    private ElementReference _menu;
    private ElementReference _input;
    private List<AdminQueryService.LookupItem> _options = [];
    private string _search = "";
    private string? _selectedDisplayText;
    private bool _open, _loading, _positioned;
    private CancellationTokenSource? _cts;
    private Guid? _resolvedValue;

    protected override async Task OnParametersSetAsync()
    {
        if (Value is null)
        {
            _selectedDisplayText = null;
            _resolvedValue = null;
            return;
        }

        if (!string.IsNullOrWhiteSpace(SelectedText))
        {
            _selectedDisplayText = SelectedText;
            _resolvedValue = Value;
            return;
        }

        if (_resolvedValue == Value && !string.IsNullOrWhiteSpace(_selectedDisplayText))
            return;

        try
        {
            var options = await SearchAsync(string.Empty, CancellationToken.None);
            var selected = options.FirstOrDefault(x => x.Id == Value.Value);
            _selectedDisplayText = selected?.Text;
            _resolvedValue = Value;
        }
        catch
        {
            _resolvedValue = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_open || Disabled || _positioned)
            return;

        _positioned = true;

        try
        {
            await JS.InvokeVoidAsync("serverLookupDropdown.attach", _trigger, _menu);
            await _input.FocusAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task ToggleAsync()
    {
        _open = !_open;
        _positioned = false;

        if (_open)
        {
            _search = "";
            await SearchNowAsync();
        }
    }

    private Task CloseAsync()
    {
        _open = false;
        _positioned = false;
        _search = "";
        return Task.CompletedTask;
    }

    private Task SearchInputChanged(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        return SearchNowAsync();
    }

    private async Task SearchNowAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new();
        var token = _cts.Token;
        _loading = true;

        try
        {
            await Task.Delay(180, token);
            _options = (await SearchAsync(_search, token)).ToList();
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (!token.IsCancellationRequested)
                _loading = false;
        }
    }

    private Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _open = false;
            _positioned = false;
        }

        return Task.CompletedTask;
    }

    private async Task SelectAsync(AdminQueryService.LookupItem option)
    {
        _open = false;
        _positioned = false;
        _search = "";
        _selectedDisplayText = option.Text;
        _resolvedValue = option.Id;

        if (Value != option.Id)
            await ValueChanged.InvokeAsync(option.Id);
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();

        try
        {
            if (_open)
                await JS.InvokeVoidAsync("serverLookupDropdown.detach", _trigger, _menu);
        }
        catch (JSDisconnectedException)
        {
        }
    }
}

<style>
    .server-lookup {
        position: relative;
        width: 100%;
        min-width: 0
    }

    .server-lookup-trigger {
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-align: right;
        min-height: 42px;
        cursor: pointer;
        direction: rtl
    }

    .server-lookup.disabled {
        opacity: .65
    }

    .server-lookup-value {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0
    }

    .server-lookup-backdrop {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        padding: 0;
        margin: 0;
        border: 0;
        background: transparent;
        z-index: 2147483646;
        cursor: default
    }

    .server-lookup-menu {
        position: fixed !important;
        z-index: 2147483647 !important;
        background: var(--surface, #fff);
        border: 1px solid var(--border, #e5e7eb);
        border-radius: 12px;
        box-shadow: 0 18px 45px rgba(0, 0, 0, .18);
        overflow: hidden;
        direction: rtl;
        min-width: 180px
    }

    .server-lookup-search {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px;
        border-bottom: 1px solid var(--border, #e5e7eb);
        background: var(--surface, #fff);
        position: sticky;
        top: 0;
        z-index: 1
    }

    .server-lookup-search i {
        color: #667085;
        flex: 0 0 auto
    }

    .server-lookup-search input {
        width: 100%;
        min-width: 0;
        border: 0;
        outline: 0;
        background: transparent;
        padding: 5px;
        text-align: right;
        font: inherit
    }

    .server-lookup-results {
        max-height: 260px;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 5px
    }

    .server-lookup-option {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        border: 0;
        background: transparent;
        padding: 9px 10px;
        border-radius: 8px;
        text-align: right;
        cursor: pointer;
        font: inherit;
        direction: rtl
    }

    .server-lookup-option:hover,
    .server-lookup-option.selected {
        background: rgba(37, 99, 235, .08)
    }

    .server-lookup-option span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0
    }

    .server-lookup-empty {
        padding: 18px;
        text-align: center;
        color: #667085;
        font-size: 12px
    }
</style>
