@using Microsoft.AspNetCore.Components.Web

@* A type-to-search drop-down for choosing ONE item from a list that is already loaded in memory (for example a short list of *@
@* positions). The chosen item is identified by its unique id (a GUID). For very large lists the portal uses the *@
@* server-backed picker instead. *@
<div class="ys-search-select" @onfocusout="HandleFocusOut" tabindex="-1" dir="rtl">
    <input class="form-control ys-search-input" value="@SearchText" @oninput="HandleInput" @onfocus="Open"
           @onkeydown="HandleKeyDown" placeholder="@(_open ? SearchPlaceholder : Placeholder)" autocomplete="off"
           aria-autocomplete="list" aria-expanded="@_open" disabled="@Disabled" />

    @* The list of matching items, shown only while the box is active and not disabled. *@
    @if (_open && !Disabled)
    {
        <div class="ys-search-dropdown" role="listbox">
            @if (FilteredOptions.Count == 0)
            {
                <div class="ys-search-empty">
                    <i class="ti @Icons.Search"></i>
                    <span>موردی پیدا نشد</span>
                </div>
            }
            else
            {
                @foreach (var option in FilteredOptions.Take(MaxVisibleResults))
                {
                    <button type="button" class="ys-search-option @(option.Value == Value ? "selected" : "")"
                            @onmousedown="PreventBlur" @onclick="() => SelectAsync(option.Value)">
                        <span class="ys-search-check">
                            <i class="ti @(option.Value == Value ? Icons.Confirm : Icons.PageNext)"></i>
                        </span>
                        <span class="ys-search-option-text">@option.Text</span>
                    </button>
                }

                @* Only the first few matches are listed; this line tells the person how many there are and asks them to type more to narrow down. *@
                @if (FilteredOptions.Count > MaxVisibleResults)
                {
                    <div class="ys-search-more">
                        <span>@FilteredOptions.Count نتیجه</span>
                        <span>برای نتایج دقیق‌تر جستجو کنید.</span>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    // Parameters handed in by the page: the available items, the chosen id, the callback for a new choice, the texts shown,
    // whether the box is disabled, and the maximum number of items listed at once.
    [Parameter, EditorRequired] public IReadOnlyList<SearchableGuidOption> Options { get; set; } = [];
    [Parameter] public Guid? Value { get; set; }
    [Parameter] public EventCallback<Guid?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "جستجو و انتخاب...";
    [Parameter] public string SearchPlaceholder { get; set; } = "برای جستجو تایپ کنید...";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public int MaxVisibleResults { get; set; } = 12;

    // Internal state: what is typed in the box, whether the list is open, which row the keyboard arrows are on,
    // and a flag that stops the list closing when the person clicks an item.
    private string SearchText { get; set; } = "";
    private bool _open;
    private int _activeIndex = -1;
    private bool _preventBlur;

    // The items whose text contains what the person typed (all items when the box is empty).
    private List<SearchableGuidOption> FilteredOptions =>
        string.IsNullOrWhiteSpace(SearchText)
            ? Options.ToList()
            : Options.Where(x => x.Text.Contains(SearchText.Trim(), StringComparison.CurrentCultureIgnoreCase)).ToList();

    // Whenever the page changes the chosen id, show its name in the box (unless the person is typing).
    protected override void OnParametersSet()
    {
        if (!_open)
            SearchText = Options.FirstOrDefault(x => x.Value == Value)?.Text ?? "";
    }

    // Open the list and clear the box so the person can start typing a search.
    private void Open()
    {
        if (Disabled) return;
        if (!_open)
            SearchText = "";
        _open = true;
        _activeIndex = -1;
    }

    private void HandleInput(ChangeEventArgs e)
    {
        if (Disabled) return;
        SearchText = e.Value?.ToString() ?? "";
        _open = true;
        _activeIndex = -1;
    }

    // An item was chosen: report it to the page, show its name in the box and close the list.
    private async Task SelectAsync(Guid? value)
    {
        if (Disabled) return;
        await ValueChanged.InvokeAsync(value);
        SearchText = Options.FirstOrDefault(x => x.Value == value)?.Text ?? "";
        _open = false;
        _activeIndex = -1;
    }

    // Keyboard support: Escape cancels, the up and down arrows move through the matches, Enter picks the highlighted one.
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (Disabled) return;
        if (e.Key == "Escape")
        {
            SearchText = Options.FirstOrDefault(x => x.Value == Value)?.Text ?? "";
            _open = false;
            return;
        }

        if (e.Key == "ArrowDown")
        {
            if (!_open) Open();
            _activeIndex = Math.Min(_activeIndex + 1, Math.Max(0, Math.Min(FilteredOptions.Count, MaxVisibleResults) - 1));
        }
        else if (e.Key == "ArrowUp")
        {
            _activeIndex = Math.Max(_activeIndex - 1, 0);
        }
        else if (e.Key == "Enter" && _open && _activeIndex >= 0 && _activeIndex < Math.Min(FilteredOptions.Count,
MaxVisibleResults))
        {
            await SelectAsync(FilteredOptions[_activeIndex].Value);
        }
    }

    // Clicking an item would normally make the box lose focus and close the list before the click registers; this flag prevents that.
    private void PreventBlur() => _preventBlur = true;

    // When the person leaves the box without choosing, put the previously chosen name back and close the list.
    private async Task HandleFocusOut()
    {
        await Task.Delay(100);
        if (_preventBlur)
        {
            _preventBlur = false;
            return;
        }
        SearchText = Options.FirstOrDefault(x => x.Value == Value)?.Text ?? "";
        _open = false;
        _activeIndex = -1;
    }

    // One choice in the list: its unique id and the text shown to the person.
    public sealed record SearchableGuidOption(Guid Value, string Text);
}

<style>
    .ys-search-select {
        position: relative;
        width: 100%;
        outline: none;
    }

    .ys-search-input {
        width: 100%;
        min-height: 42px;
        padding: 7px 11px;
        font-size: 14px;
        line-height: 1.4;
    }

    .ys-search-input:focus {
        border-color: var(--primary, var(--accent,#2563eb));
        box-shadow: 0 0 0 2px rgba(37, 99, 235, .10);
    }

    .ys-search-dropdown {
        position: absolute;
        z-index: 4000;
        top: calc(100% + 4px);
        right: 0;
        left: 0;
        max-height: 292px;
        overflow-y: auto;
        padding: 4px;
        border: 1px solid var(--border, #e5e7eb);
        border-radius: 9px;
        background: var(--card-bg, #fff);
        box-shadow: 0 10px 24px rgba(15, 23, 42, .14);
    }

    .ys-search-option {
        display: flex;
        align-items: center;
        gap: 6px;
        width: 100%;
        min-height: 32px;
        padding: 5px 7px;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: inherit;
        text-align: right;
        font: inherit;
        font-size: 13px;
        line-height: 1.35;
        cursor: pointer;
    }

    .ys-search-option:hover,
    .ys-search-option.selected {
        background: rgba(37, 99, 235, .08);
    }

    .ys-search-option.selected {
        font-weight: 700;
    }

    .ys-search-option-text {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ys-search-check {
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 5px;
        flex: none;
        color: var(--text-muted, #64748b);
        font-size: 15px;
    }

    .ys-search-option.selected .ys-search-check {
        background: var(--primary, var(--accent,#2563eb));
        color: #fff;
    }

    .ys-search-empty {
        min-height: 78px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        color: var(--text-muted, #6b7280);
        font-size: 13px;
    }

    .ys-search-empty i {
        font-size: 22px;
    }

    .ys-search-more {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 7px 8px 5px;
        color: var(--text-muted, #6b7280);
        font-size: 11px;
        border-top: 1px solid var(--border, #e5e7eb);
        white-space: nowrap;
    }
</style>
