@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using YasPortal.Web.Services
@implements IAsyncDisposable
@inject NotificationService NotificationSvc
@inject AppState AppState
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<a href="@_href" class="icon-button notification-bell" title="@(_unread > 0 ? $"اعلان‌ها ({_unread} خوانده‌نشده)" : "اعلان‌ها")" aria-label="اعلان‌ها">
    <i class="ti @Icons.Bell"></i>
    @if (_unread > 0)
    {
        <span class="notification-bell-badge">@(_unread > 99 ? "۹۹+" : ToPersianDigits(_unread.ToString()))</span>
    }
</a>

@code {
    private int _unread;
    private string _href = "/notifications";

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        AppState.OnChange += OnAppStateChanged;
        await RefreshAsync();
        // Pick up new notifications without a page refresh: every so often tell the bell and the sidebar badges to re-read their counts.
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(RefreshInterval);
        _ = PollAsync(_cts.Token);
    }

    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(30);
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    private async Task PollAsync(CancellationToken ct)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(ct))
                AppState.NotifyRequestBadgesChanged();
        }
        catch (OperationCanceledException)
        {
            // The circuit ended.
        }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => await RefreshAndRenderAsync();

    private async void OnAppStateChanged() => await RefreshAndRenderAsync();

    private async Task RefreshAndRenderAsync()
    {
        await RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            var employeeId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? (Guid?)id : null;
            // Administrators have no position, so their alerts are on their own page, not the personal one.
            _href = user.HasClaim("yas_is_admin", "True") ? "/admin/notifications" : "/notifications";
            _unread = await NotificationSvc.CountUnreadAsync(employeeId);
        }
        catch
        {
            // Best-effort badge; a transient failure must never break the top bar.
            _unread = 0;
        }
    }

    public ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        AppState.OnChange -= OnAppStateChanged;
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
        return ValueTask.CompletedTask;
    }

    private static string ToPersianDigits(string value)
    {
        const string digits = "۰۱۲۳۴۵۶۷۸۹";
        return new string(value.Select(c => c is >= '0' and <= '9' ? digits[c - '0'] : c).ToArray());
    }
}
