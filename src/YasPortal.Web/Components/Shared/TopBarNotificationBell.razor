@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using YasPortal.Web.Services
@implements IAsyncDisposable
@inject NotificationService NotificationSvc
@inject AppState AppState
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

@* The bell icon in the top bar. It links to the notifications page (administrators go to their own alert page) and shows a red unread count. *@
<a href="@_href" class="icon-button notification-bell" title="@(_unread > 0 ? $"اعلان‌ها ({_unread} خوانده‌نشده)" : "اعلان‌ها")" aria-label="اعلان‌ها">
    <i class="ti @Icons.Bell"></i>
    @if (_unread > 0)
    {
        <span class="notification-bell-badge">@(_unread > 99 ? "۹۹+" : ToPersianDigits(_unread.ToString()))</span>
    }
</a>

@* Number of unread notifications and the page the bell leads to. *@
@code {
    private int _unread;
    private string _href = "/notifications";

    // On start: listen for page changes and for "counts changed" signals, read the count, and start the 30-second refresh timer.
    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        AppState.OnChange += OnAppStateChanged;
        await RefreshAsync();
        // Pick up new notifications without a page refresh: every so often tell the bell and the sidebar badges to re-read their counts.
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(RefreshInterval);
        _ = PollAsync(_cts.Token);
    }

    // Every 30 seconds the bell asks the whole app (including sidebar badges) to re-read its counters.
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(30);
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    // Background loop that sends the periodic refresh signal until the session ends.
    private async Task PollAsync(CancellationToken ct)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(ct))
                AppState.NotifyRequestBadgesChanged();
        }
        catch (OperationCanceledException)
        {
            // The circuit ended.
        }
    }

    // The count is re-read whenever the person moves to another page or something in the app signals a change.
    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => await RefreshAndRenderAsync();

    private async void OnAppStateChanged() => await RefreshAndRenderAsync();

    private async Task RefreshAndRenderAsync()
    {
        await RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    // Reads the unread count and decides which notifications page the bell links to. A failure just shows no badge.
    private async Task RefreshAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            var employeeId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? (Guid?)id : null;
            // Administrators have no position, so their alerts are on their own page, not the personal one.
            _href = user.HasClaim("yas_is_admin", "True") ? "/admin/notifications" : "/notifications";
            _unread = await NotificationSvc.CountUnreadAsync(employeeId);
        }
        catch
        {
            // Best-effort badge; a transient failure must never break the top bar.
            _unread = 0;
        }
    }

    // Stop listening and stop the timer when the top bar goes away.
    public ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        AppState.OnChange -= OnAppStateChanged;
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
        return ValueTask.CompletedTask;
    }

    // Converts 0-9 into Persian digits.
    private static string ToPersianDigits(string value)
    {
        const string digits = "۰۱۲۳۴۵۶۷۸۹";
        return new string(value.Select(c => c is >= '0' and <= '9' ? digits[c - '0'] : c).ToArray());
    }
}
