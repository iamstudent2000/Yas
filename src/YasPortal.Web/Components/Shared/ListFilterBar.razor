@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using YasPortal.Infrastructure.Persistence
@inject ExportOptions ExportFile
@inject AuditEventWriter Audit
@inject NavigationManager Navigation
@* The one filter/sort card every list page uses, so filtering behaves the same everywhere:
   - nothing is searched while you pick or type; "جستجو" (or Enter) applies the draft,
   - "پاک کردن فیلترها" resets the draft and the list in one step,
   - sorting (optional) applies at once, because it never changes which rows match,
   - while a search runs the button shows a spinner and is disabled,
   - the whole card folds with its header (collapsed by default; the header still shows how many filters are active) on every screen size.
   Put the fields in as <div class="admin-filter"> children; the page keeps a draft and an applied copy. *@
@* The card: a header button that folds the filter fields away, and a body holding the fields and the buttons. *@
<section class="card request-filter list-filter @(_open ? "is-open" : "")" dir="rtl">
    <button type="button" class="request-filter-toggle" aria-expanded="@(_open ? "true" : "false")" @onclick="() => _open = !_open">
        <i class="ti @Icons.Search"></i> جستجو
        @if (ActiveCount > 0)
        {
            <span class="badge badge-info">@ActiveCount فیلتر فعال</span>
        }
        <i class="ti @(_open ? Icons.ChevronUp : Icons.ChevronDown) request-filter-toggle-chevron"></i>
    </button>
    @* Body: the fields supplied by the page, then the optional sort choice, then the search / clear / menu buttons. *@
    <div class="admin-filters request-filter-body" @onkeydown="OnKeyDownAsync">
        @ChildContent
        @if (SortOptions.Count > 0)
        {
            <SortSelect Options="SortOptions" Value="@(Sort)" Default="@(DefaultSort)" ValueChanged="SortChanged" />
        }
        @* Button row. Search is disabled while a search runs; Enter pressed inside any field also searches. *@
        <div class="admin-filter request-filter-clear">
            <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="SearchAsync" @onkeydown:stopPropagation="true">
                <i class="ti @(Busy ? Icons.Spinner : Icons.Search)"></i> جستجو
            </button>
            @* While a long search runs and the page allows cancelling, the clear button turns into a cancel button. *@
            @if (Busy && OnCancel.HasDelegate)
            {
                <button type="button" class="btn btn-danger" @onclick="OnCancel" @onkeydown:stopPropagation="true"><i class="ti @Icons.CancelSearch"></i> لغو</button>
            }
            else
            {
                <button type="button" class="btn btn-secondary" disabled="@(Busy || !CanClear)" @onclick="ClearAsync" @onkeydown:stopPropagation="true">
                    <i class="ti @Icons.FilterClear"></i> پاک کردن فیلترها
                </button>
            }
            @if (OnExport.HasDelegate || OnExportSteps.HasDelegate)
            {
                <AuthorizeView Policy="@ExportPermission">
                <div class="list-more">
                    <button type="button" class="btn btn-secondary list-more-btn" disabled="@(Busy || Exporting)" aria-haspopup="menu" aria-expanded="@(_menu ? "true" : "false")" title="گزارش و خروجی"
                            @onclick="() => _menu = !_menu" @onkeydown:stopPropagation="true">
                        <i class="ti @(Exporting ? Icons.Spinner : Icons.More)"></i>
                    </button>
                    @if (_menu)
                    {
                        <div class="list-more-backdrop" @onclick="() => _menu = false"></div>
                        <div class="list-more-menu" role="menu">
                            @if (OnExport.HasDelegate)
                            {
                                <button type="button" role="menuitem" title="همه نتایج آخرین جستجو، با همین ترتیب" @onclick="() => RunAsync(OnExport)" @onkeydown:stopPropagation="true">
                                    <i class="ti @Icons.ExportData"></i> خروجی CSV
                                </button>
                                @* the same export, but the file is a PDF: a page that exports through ExportFilesService needs no extra code for it *@
                                <button type="button" role="menuitem" title="همه نتایج آخرین جستجو، به شکل فایل PDF" @onclick="() => RunAsync(OnExport, pdf: true)" @onkeydown:stopPropagation="true">
                                    <i class="ti @Icons.Pdf"></i> خروجی PDF
                                </button>
                            }
                            @if (OnExportSteps.HasDelegate)
                            {
                                <button type="button" role="menuitem" title="هر مرحله یک ردیف: تصمیم‌گیرنده، زمان، توضیح و مدت انتظار" @onclick="() => RunAsync(OnExportSteps)" @onkeydown:stopPropagation="true">
                                    <i class="ti @Icons.ExportSteps"></i> گزارش مراحل (CSV)
                                </button>
                            }
                        </div>
                    }
                </div>
                </AuthorizeView>
            }
        </div>
    </div>
</section>

@code {
    // The filter fields themselves are placed here by the page that uses this card.
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>True while the page is loading; shows the spinner and blocks a second search.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>How many filters are applied right now (the badge on the phone toggle).</summary>
    [Parameter] public int ActiveCount { get; set; }

    /// <summary>False when there is nothing to clear (no draft and nothing applied).</summary>
    [Parameter] public bool CanClear { get; set; } = true;

    // Tell the page that the person pressed search or clear; the page then reloads its list.
    [Parameter] public EventCallback OnSearch { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }

    /// <summary>Optional: for slow searches the page can cancel; while busy the clear button becomes "لغو".</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Optional: shows "خروجی CSV", which exports everything the last search matched (not just this page).</summary>
    [Parameter] public EventCallback OnExport { get; set; }


    /// <summary>The report permission that shows the ⋯ menu (see ReportPermissions); every list that exports names its own.</summary>
    [Parameter] public string ExportPermission { get; set; } = "";
    // True while an export is being produced.
    [Parameter] public bool Exporting { get; set; }

    /// <summary>Optional: shows "گزارش مراحل (CSV)", the detailed one-row-per-step report of the last search.</summary>
    [Parameter] public EventCallback OnExportSteps { get; set; }

    /// <summary>
    /// Optional: the filters that are applied after a search (read once <see cref="OnSearch"/> has finished).
    /// When set, every search is recorded in the audit log with these filters, and so is the next export.
    /// </summary>
    [Parameter] public Func<object?>? FilterSnapshot { get; set; }

    /// <summary>Optional sort choices ("key:asc|desc" → label); applied immediately, the ✕ goes back to <see cref="DefaultSort"/>.</summary>
    [Parameter] public IReadOnlyList<(string Key, string Text)> SortOptions { get; set; } = [];
    // The current sort choice and its default, and the notice sent to the page when the person changes the sort.
    [Parameter] public string Sort { get; set; } = "";
    [Parameter] public string DefaultSort { get; set; } = "";
    [Parameter] public EventCallback<string> SortChanged { get; set; }

    // Whether the card is unfolded and whether the "more" menu is open.
    // Open by default; the header folds the card away to give the list the whole screen.
    private bool _open;
    private bool _menu;

    // Run one of the export actions after recording which filters it covered in the audit log.
    // pdf = true makes the page's export produce a PDF of the same rows instead of the CSV.
    private async Task RunAsync(EventCallback callback, bool pdf = false)
    {
        _menu = false;
        // The export service reads this when the file is ready, so the export event says which filters it matched.
        Audit.PendingExportFilters = FilterSnapshot?.Invoke();
        // tells the page's export which file to make; always switched off again, even if the export fails
        ExportFile.Pdf = pdf;
        try { await callback.InvokeAsync(); }
        finally { ExportFile.Pdf = false; }
    }

    // Search: ignored if one is already running; otherwise the page reloads, and the search with its filters is written to the audit log.
    private async Task SearchAsync()
    {
        if (Busy)
            return;
        await OnSearch.InvokeAsync();
        if (FilterSnapshot is not null)
            await Audit.WriteSearchAsync(new Uri(Navigation.Uri).AbsolutePath, FilterSnapshot());
    }

    private Task ClearAsync() => OnClear.InvokeAsync();

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }
}
