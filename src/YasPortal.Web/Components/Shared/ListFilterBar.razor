@using Microsoft.AspNetCore.Components.Authorization
@* The one filter/sort card every list page uses, so filtering behaves the same everywhere:
   - nothing is searched while you pick or type; "جستجو" (or Enter) applies the draft,
   - "پاک کردن فیلترها" resets the draft and the list in one step,
   - sorting (optional) applies at once, because it never changes which rows match,
   - while a search runs the button shows a spinner and is disabled,
   - the whole card folds with its header (open by default) on every screen size.
   Put the fields in as <div class="admin-filter"> children; the page keeps a draft and an applied copy. *@
<section class="card request-filter list-filter @(_open ? "is-open" : "")" dir="rtl">
    <button type="button" class="request-filter-toggle" aria-expanded="@(_open ? "true" : "false")" @onclick="() => _open = !_open">
        <i class="bx bx-filter-alt"></i> فیلترها@(SortOptions.Count > 0 ? " و ترتیب" : "")
        @if (ActiveCount > 0)
        {
            <span class="badge badge-info">@ActiveCount فیلتر فعال</span>
        }
        <i class="bx @(_open ? "bx-chevron-up" : "bx-chevron-down") request-filter-toggle-chevron"></i>
    </button>
    <div class="admin-filters request-filter-body" @onkeydown="OnKeyDownAsync">
        @ChildContent
        @if (SortOptions.Count > 0)
        {
            <SortSelect Options="SortOptions" Value="@(Sort)" Default="@(DefaultSort)" ValueChanged="SortChanged" />
        }
        <div class="admin-filter request-filter-clear">
            <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="SearchAsync" @onkeydown:stopPropagation="true">
                <i class="bx @(Busy ? "bx-loader-alt bx-spin" : "bx-search")"></i> جستجو
            </button>
            @if (Busy && OnCancel.HasDelegate)
            {
                <button type="button" class="btn btn-danger" @onclick="OnCancel" @onkeydown:stopPropagation="true"><i class="bx bx-x-circle"></i> لغو</button>
            }
            else
            {
                <button type="button" class="btn btn-secondary" disabled="@(Busy || !CanClear)" @onclick="ClearAsync" @onkeydown:stopPropagation="true">
                    <i class="bx bx-eraser"></i> پاک کردن فیلترها
                </button>
            }
            @if (OnExport.HasDelegate || OnExportSteps.HasDelegate)
            {
                <AuthorizeView Policy="@ExportPermission">
                <div class="list-more">
                    <button type="button" class="btn btn-secondary list-more-btn" disabled="@(Busy || Exporting)" aria-haspopup="menu" aria-expanded="@(_menu ? "true" : "false")" title="گزارش و خروجی"
                            @onclick="() => _menu = !_menu" @onkeydown:stopPropagation="true">
                        <i class="bx @(Exporting ? "bx-loader-alt bx-spin" : "bx-dots-horizontal-rounded")"></i>
                    </button>
                    @if (_menu)
                    {
                        <div class="list-more-backdrop" @onclick="() => _menu = false"></div>
                        <div class="list-more-menu" role="menu">
                            @if (OnExport.HasDelegate)
                            {
                                <button type="button" role="menuitem" title="همه نتایج آخرین جستجو، با همین ترتیب" @onclick="() => RunAsync(OnExport)" @onkeydown:stopPropagation="true">
                                    <i class="bx bx-export"></i> خروجی CSV
                                </button>
                            }
                            @if (OnExportSteps.HasDelegate)
                            {
                                <button type="button" role="menuitem" title="هر مرحله یک ردیف: تصمیم‌گیرنده، زمان، توضیح و مدت انتظار" @onclick="() => RunAsync(OnExportSteps)" @onkeydown:stopPropagation="true">
                                    <i class="bx bx-spreadsheet"></i> گزارش مراحل (CSV)
                                </button>
                            }
                        </div>
                    }
                </div>
                </AuthorizeView>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>True while the page is loading; shows the spinner and blocks a second search.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>How many filters are applied right now (the badge on the phone toggle).</summary>
    [Parameter] public int ActiveCount { get; set; }

    /// <summary>False when there is nothing to clear (no draft and nothing applied).</summary>
    [Parameter] public bool CanClear { get; set; } = true;

    [Parameter] public EventCallback OnSearch { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }

    /// <summary>Optional: for slow searches the page can cancel; while busy the clear button becomes "لغو".</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Optional: shows "خروجی CSV", which exports everything the last search matched (not just this page).</summary>
    [Parameter] public EventCallback OnExport { get; set; }

    /// <summary>The report permission that shows the ⋯ menu (see ReportPermissions); every list that exports names its own.</summary>
    [Parameter] public string ExportPermission { get; set; } = "";
    [Parameter] public bool Exporting { get; set; }

    /// <summary>Optional: shows "گزارش مراحل (CSV)", the detailed one-row-per-step report of the last search.</summary>
    [Parameter] public EventCallback OnExportSteps { get; set; }

    /// <summary>Optional sort choices ("key:asc|desc" → label); applied immediately, the ✕ goes back to <see cref="DefaultSort"/>.</summary>
    [Parameter] public IReadOnlyList<(string Key, string Text)> SortOptions { get; set; } = [];
    [Parameter] public string Sort { get; set; } = "";
    [Parameter] public string DefaultSort { get; set; } = "";
    [Parameter] public EventCallback<string> SortChanged { get; set; }

    // Open by default; the header folds the card away to give the list the whole screen.
    private bool _open = true;
    private bool _menu;

    private async Task RunAsync(EventCallback callback)
    {
        _menu = false;
        await callback.InvokeAsync();
    }

    private async Task SearchAsync()
    {
        if (!Busy)
            await OnSearch.InvokeAsync();
    }

    private Task ClearAsync() => OnClear.InvokeAsync();

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }
}
