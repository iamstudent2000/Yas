@using YasPortal.Domain.Landing
@* One group of the home page: its links, then its sub-groups (this component again). A collapsible block with no script. *@
<details class="landing-group" open="@(Open || Depth == 0)">
    <summary><i class="ti ti-folder"></i> <strong>@Node.Name</strong> <span class="badge badge-muted">@Node.TotalLinks</span></summary>
    <div class="landing-group-body">
        @if (Node.Links.Count > 0)
        {
            <ul class="landing-linklist">
                @foreach (var link in Node.Links)
                {
                    <li>
                        <a href="@link.Url" target="@(PortalLink.IsExternal(link.Url) ? "_blank" : null)" rel="@(PortalLink.IsExternal(link.Url) ? "noopener noreferrer" : null)">
                            <i class="ti @(PortalLink.IsExternal(link.Url) ? "ti-external-link" : "ti-link")"></i>
                            <span>@link.Title@if (link.Description is not null) { <small>@link.Description</small> }</span>
                        </a>
                    </li>
                }
            </ul>
        }
        @foreach (var child in Node.Children)
        {
            <LinkGroupView Node="child" Depth="Depth + 1" Open="Open" />
        }
    </div>
</details>

@code {
    [Parameter, EditorRequired] public LinkGroupNode Node { get; set; } = null!;
    [Parameter] public int Depth { get; set; }
    /// <summary>True while searching: every group is shown open.</summary>
    [Parameter] public bool Open { get; set; }
}
