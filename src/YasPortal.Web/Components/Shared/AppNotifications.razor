@implements IDisposable
@using YasPortal.Web.Services
@inject AppState AppState

@if (AppState.Toasts.Count > 0)
{
    <div class="app-toast-container" aria-live="polite" aria-atomic="true">
        @foreach (var toast in AppState.Toasts)
        {
            <div class="app-toast app-toast-@toast.Level.ToString().ToLowerInvariant()" role="alert">
                <div class="app-toast-icon">
                    <i class="@GetIcon(toast.Level)" aria-hidden="true"></i>
                </div>
                <div class="app-toast-content">
                    <div class="app-toast-title">@GetTitle(toast.Level)</div>
                    <div class="app-toast-message">@toast.Message</div>
                </div>
                <button type="button" class="app-toast-close" @onclick="() => AppState.RemoveToast(toast)" aria-label="بستن">
                    <i class="bx bx-x"></i>
                </button>
            </div>
        }
    </div>
}

@code {
    protected override void OnInitialized()
    {
        AppState.OnChange += StateChanged;
    }

    private void StateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static string GetIcon(ToastLevel level) => level switch
    {
        ToastLevel.Success => "bx bx-check-circle",
        ToastLevel.Warning => "bx bx-error",
        ToastLevel.Error => "bx bx-x-circle",
        _ => "bx bx-info-circle"
    };

    private static string GetTitle(ToastLevel level) => level switch
    {
        ToastLevel.Success => "موفق",
        ToastLevel.Warning => "توجه",
        ToastLevel.Error => "خطا",
        _ => "اطلاع"
    };

    public void Dispose()
    {
        AppState.OnChange -= StateChanged;
    }
}
