@if (TotalCount > 0)
{
    <div class="server-pagination" dir="rtl" aria-label="صفحه‌بندی">
        <div class="server-pagination-size">
            <span>نمایش</span>
            <div class="server-pagination-size-wrap">
                <select class="server-pagination-size-select" value="@PageSize" @onchange="OnPageSizeChangedAsync" disabled="@Busy" aria-label="تعداد موارد در صفحه">
                    @foreach (var size in PageSizes)
                    {
                        <option value="@size">@ToPersianDigits(size.ToString())</option>
                    }
                </select>
                <i class="bx bx-chevron-down server-pagination-size-icon"></i>
            </div>
            <span>مورد</span>
        </div>
        <span class="server-pagination-info"><strong>@ToPersianDigits((((Page - 1) * PageSize) + 1).ToString())–@ToPersianDigits(Math.Min(Page * PageSize, TotalCount).ToString())</strong><span class="server-pagination-info-muted">از @ToPersianDigits(TotalCount.ToString("N0"))</span></span>
        @if (TotalPages > 1)
        {
            <div class="server-pagination-buttons">
                <button type="button" class="server-pagination-nav" disabled="@(Page <= 1 || Busy)" @onclick="() => GoAsync(Page - 1)" aria-label="صفحه قبلی"><i class="bx bx-chevron-right"></i></button>
                @if (Pages.First() > 1)
                {
                    <button type="button" class="server-pagination-page" disabled="@Busy" @onclick="() => GoAsync(1)">@ToPersianDigits("1")</button>
                    @if (Pages.First() > 2){<span class="server-pagination-ellipsis">…</span>}
                }
                @foreach (var p in Pages){<button type="button" class="server-pagination-page @(p == Page ? "active" : "")" disabled="@Busy" aria-current="@(p == Page ? "page" : null)" @onclick="() => GoAsync(p)">@ToPersianDigits(p.ToString())</button>}
                @if (Pages.Last() < TotalPages)
                {
                    @if (Pages.Last() < TotalPages - 1){<span class="server-pagination-ellipsis">…</span>}
                    <button type="button" class="server-pagination-page" disabled="@Busy" @onclick="() => GoAsync(TotalPages)">@ToPersianDigits(TotalPages.ToString())</button>
                }
                <button type="button" class="server-pagination-nav" disabled="@(Page >= TotalPages || Busy)" @onclick="() => GoAsync(Page + 1)" aria-label="صفحه بعدی"><i class="bx bx-chevron-left"></i></button>
            </div>
        }
    </div>
}
@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 20;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public IReadOnlyList<int> PageSizes { get; set; } = new[] { 5, 10, 20, 50, 100 };
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)Math.Max(1, PageSize)));
    private IEnumerable<int> Pages => Enumerable.Range(Math.Max(1, Math.Min(Page - 2, Math.Max(1, TotalPages - 4))), Math.Min(TotalPages, 5));
    private Task GoAsync(int page) => PageChanged.InvokeAsync(Math.Clamp(page, 1, TotalPages));
    private Task OnPageSizeChangedAsync(ChangeEventArgs args){if(int.TryParse(args.Value?.ToString(),out var size)&&PageSizes.Contains(size))return PageSizeChanged.InvokeAsync(size);return Task.CompletedTask;}
    private static string ToPersianDigits(string value)=>value.Replace('0','۰').Replace('1','۱').Replace('2','۲').Replace('3','۳').Replace('4','۴').Replace('5','۵').Replace('6','۶').Replace('7','۷').Replace('8','۸').Replace('9','۹');
}
<style>
.server-pagination{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:14px 16px;margin-top:4px;border-top:1px solid #eef1f5;background:#fafbfc;direction:rtl}.server-pagination-size{display:flex;align-items:center;gap:8px;font-size:12px;color:#667085;white-space:nowrap}.server-pagination-size-wrap{position:relative;display:inline-flex;align-items:center}.server-pagination-size-select{appearance:none;-webkit-appearance:none;min-width:64px;height:34px;padding:0 26px 0 10px;border:1px solid #d0d5dd;border-radius:9px;background:#fff;color:#344054;font:inherit;font-size:12px;font-weight:700;outline:none;cursor:pointer;transition:border-color .15s ease,box-shadow .15s ease}.server-pagination-size-select:hover{border-color:#98a2b3}.server-pagination-size-select:focus{border-color:#3157d5;box-shadow:0 0 0 3px rgba(49,87,213,.12)}.server-pagination-size-select:disabled{opacity:.5;cursor:not-allowed}.server-pagination-size-icon{position:absolute;left:8px;top:50%;transform:translateY(-50%);font-size:14px;color:#98a2b3;pointer-events:none}.server-pagination-info{display:flex;align-items:baseline;gap:5px;font-size:12.5px;color:#475467;white-space:nowrap}.server-pagination-info strong{color:#172033;font-weight:800}.server-pagination-info-muted{color:#98a2b3}.server-pagination-buttons{display:flex;align-items:center;gap:4px;flex-wrap:wrap}.server-pagination-nav{display:grid;place-items:center;width:32px;height:32px;border:1px solid #d0d5dd;border-radius:8px;background:#fff;color:#475467;font-size:15px;cursor:pointer;transition:background .15s ease,border-color .15s ease,color .15s ease}.server-pagination-nav:hover:not(:disabled){background:#eef4ff;border-color:#b8c9f5;color:#3157d5}.server-pagination-nav:disabled{opacity:.4;cursor:not-allowed}.server-pagination-page{min-width:32px;height:32px;padding:0 8px;border:1px solid transparent;border-radius:8px;background:transparent;color:#475467;font:inherit;font-size:12.5px;font-weight:700;cursor:pointer;transition:background .15s ease,color .15s ease,border-color .15s ease}.server-pagination-page:hover:not(:disabled):not(.active){background:#f2f4f7;border-color:#e4e7ec}.server-pagination-page:disabled{cursor:not-allowed}.server-pagination-page.active{background:#3157d5;border-color:#3157d5;color:#fff;box-shadow:0 2px 6px rgba(49,87,213,.3)}.server-pagination-ellipsis{display:grid;place-items:center;width:24px;height:32px;color:#98a2b3;font-size:13px}
@@media(max-width:700px){.server-pagination{gap:12px;padding:12px}.server-pagination-size{order:1;flex:1 1 auto}.server-pagination-info{order:2;flex:1 1 auto;justify-content:flex-start}.server-pagination-buttons{order:3;flex:1 1 100%;justify-content:center}}
</style>