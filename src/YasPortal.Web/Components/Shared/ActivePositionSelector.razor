@using System.Security.Claims
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using YasPortal.Infrastructure.Authorization
@using YasPortal.Infrastructure.Persistence
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@if (_positions.Count > 1)
{
    <form method="post" action="/account/position" class="active-position-form">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@GetReturnUrl()" />
        <label for="active-position-selector" class="sr-only">سمت فعال</label>
        <select id="active-position-selector" name="positionId" class="active-position-select" value="@_activePositionId">
            @foreach (var position in _positions)
            {
                <option value="@position.Id">@position.Name</option>
            }
        </select>
        <button type="submit" class="active-position-submit" title="انتخاب سمت فعال">
            <i class="bx bx-check"></i>
        </button>
    </form>
}
else if (_positions.Count == 1)
{
    <div class="active-position-single">
        <i class="bx bx-briefcase-alt-2"></i>
        <span title="@_positions[0].Name">@_positions[0].Name</span>
    </div>
}

@code {
    private List<PositionItem> _positions = [];
    private Guid _activePositionId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (!Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var employeeId))
            return;

        Guid.TryParse(user.FindFirstValue(AuthClaimNames.ActivePositionId), out _activePositionId);

        await using var db = await DbFactory.CreateDbContextAsync();
        _positions = await db.EmployeePositions
            .AsNoTracking()
            .Where(x => x.EmployeeId == employeeId && x.EndedAt == null)
            .OrderBy(x => x.Position.Name)
            .Select(x => new PositionItem(x.PositionId, x.Position.Name))
            .ToListAsync();

        if (_activePositionId == Guid.Empty || !_positions.Any(x => x.Id == _activePositionId))
            _activePositionId = _positions.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private string GetReturnUrl()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return string.IsNullOrWhiteSpace(relative) ? "/" : "/" + relative;
    }

    private sealed record PositionItem(Guid Id, string Name);
}

<style>
    .active-position-form {
        display: flex;
        align-items: center;
        gap: 5px;
        width: min(300px, 32vw);
        min-width: 220px;
        direction: rtl;
        position: relative;
        z-index: 1100;
    }

    .active-position-select {
        flex: 1 1 auto;
        width: 100%;
        min-width: 0;
        height: 36px;
        padding: 0 10px;
        border: 1px solid #d9e0ea;
        border-radius: 9px;
        background: #fff;
        color: #344054;
        font: inherit;
        font-size: 12px;
        cursor: pointer;
        direction: rtl;
        text-align: right;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .active-position-select option {
        direction: rtl;
        text-align: right;
        padding: 8px 10px;
        white-space: normal;
    }

    .active-position-select:focus {
        outline: none;
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37,99,235,.1);
    }

    .active-position-submit {
        flex: 0 0 36px;
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 9px;
        background: #2563eb;
        color: #fff;
        display: grid;
        place-items: center;
        cursor: pointer;
    }

    .active-position-submit:hover { background: #1d4ed8; }

    .active-position-single {
        display: flex;
        align-items: center;
        gap: 6px;
        max-width: 300px;
        padding: 0 10px;
        height: 36px;
        border: 1px solid #e4e7ec;
        border-radius: 9px;
        color: #475467;
        font-size: 12px;
        background: #f8fafc;
        direction: rtl;
    }

    .active-position-single span {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .active-position-single i { color: #2563eb; font-size: 17px; flex: 0 0 auto; }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0,0,0,0);
        white-space: nowrap;
        border: 0;
    }

    @media (max-width: 850px) {
        .active-position-form { width: min(100%, 300px); min-width: 180px; }
        .active-position-single { max-width: 220px; }
    }
</style>
