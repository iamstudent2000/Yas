@using System.Security.Claims
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using YasPortal.Infrastructure.Authorization
@using YasPortal.Infrastructure.Persistence
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div class="active-position-picker" @onclick:stopPropagation="true">
    @if (_positions.Count > 1)
    {
        <form @ref="_form" method="post" action="/account/position" class="active-position-form">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@GetReturnUrl()" />
            <input type="hidden" name="positionId" value="@_activePositionId" />

            <button @ref="_trigger" type="button" class="active-position-trigger" aria-haspopup="listbox"
                    aria-expanded="@_open" disabled="@_switching" @onclick="ToggleDropdown">
                <i class="bx bx-briefcase-alt-2"></i>
                <span class="active-position-value" title="@ActivePositionName">@ActivePositionName</span>
                <i class="bx bx-chevron-down active-position-chevron"></i>
            </button>

            @if (_open)
            {
                <div @ref="_dropdown" class="active-position-dropdown" role="listbox">
                    <div class="active-position-dropdown-header">انتخاب سمت فعال</div>
                    <div class="active-position-options">
                        @foreach (var position in _positions)
                        {
                            <button type="button"
                                    class="active-position-option @(position.Id == _activePositionId ? "selected" : "")"
                                    @onclick="() => SelectPosition(position.Id)">
                                <span class="position-option-icon"><i class="bx bx-briefcase"></i></span>
                                <span class="position-option-text" title="@position.Name">@position.Name</span>
                                @if (position.Id == _activePositionId)
                                {
                                    <i class="bx bx-check position-option-check"></i>
                                }
                            </button>
                        }
                    </div>
                </div>
            }

        </form>
    }
    else if (_positions.Count == 1)
    {
        <div class="active-position-single">
            <i class="bx bx-briefcase-alt-2"></i>
            <span title="@_positions[0].Name">@_positions[0].Name</span>
        </div>
    }
</div>

@code {
    private List<PositionItem> _positions = [];
    private Guid _activePositionId;
    private bool _open;
    private bool _jsReady;
    private bool _disposed;
    private ElementReference _form;
    private ElementReference _trigger;
    private bool _switching;
    private bool _submitPending;
    private ElementReference _dropdown;
    private DotNetObjectReference<ActivePositionSelector>? _dotNetRef;

    private string ActivePositionName => _positions.FirstOrDefault(x => x.Id == _activePositionId)?.Name ??
        _positions.FirstOrDefault()?.Name ?? "انتخاب سمت";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        if (!Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var employeeId)) return;
        Guid.TryParse(user.FindFirstValue(AuthClaimNames.ActivePositionId), out _activePositionId);

        await using var db = await DbFactory.CreateDbContextAsync();
        _positions = await db.EmployeePositions.AsNoTracking()
            .Where(x => x.EmployeeId == employeeId && x.EndedAt == null)
            .OrderBy(x => x.Position.Name)
            .Select(x => new PositionItem(x.PositionId, x.Position.Name))
            .ToListAsync();

        if (_activePositionId == Guid.Empty || !_positions.Any(x => x.Id == _activePositionId))
            _activePositionId = _positions.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _jsReady = true;

        // The chosen position is now in the form's hidden input, so the switch can be sent.
        if (_submitPending && !_disposed)
        {
            _submitPending = false;
            try
            {
                await JS.InvokeVoidAsync("activePositionDropdown.submit", _form);
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone; the user can pick again after reconnecting.
            }
        }
    }

    private async Task ToggleDropdown()
    {
        if (_disposed || !_jsReady)
            return;

        _open = !_open;
        if (_open)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
            if (_disposed || !_jsReady)
                return;
            await JS.InvokeVoidAsync("activePositionDropdown.start", _trigger, _dropdown, _dotNetRef);
        }
        else
        {
            await StopDropdownAsync();
        }
    }

    private async Task SelectPosition(Guid positionId)
    {
        if (_disposed)
            return;

        _open = false;
        await StopDropdownAsync();

        // Picking the position that is already active needs no round trip.
        if (positionId == _activePositionId || _switching)
            return;

        // Switch right away: no separate confirm button. The page reloads with the new position's permissions.
        _activePositionId = positionId;
        _switching = true;
        _submitPending = true;
    }

    [JSInvokable]
    public async Task CloseDropdown()
    {
        if (_disposed || !_open)
            return;

        _open = false;
        await StopDropdownAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task StopDropdownAsync()
    {
        if (!_jsReady || _disposed)
            return;

        try
        {
            await JS.InvokeVoidAsync("activePositionDropdown.stop");
        }
        catch (JSDisconnectedException)
        {
            // The Blazor circuit has already disconnected; no JS cleanup is possible.
        }
        catch (InvalidOperationException)
        {
            // JS interop can be unavailable during prerendering/disposal.
        }
    }

    private string GetReturnUrl()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return string.IsNullOrWhiteSpace(relative) ? "/" : "/" + relative;
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        _open = false;

        if (_jsReady)
        {
            try
            {
                await JS.InvokeVoidAsync("activePositionDropdown.stop");
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already disconnected.
            }
            catch (InvalidOperationException)
            {
                // JS interop is unavailable during static rendering/disposal.
            }
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }

    private sealed record PositionItem(Guid Id, string Name);
}

<style>
    .active-position-picker {
        position: relative;
        z-index: 2000;
        direction: rtl;
    }

    .active-position-form {
        display: flex;
        align-items: center;
        gap: 6px;
        width: min(320px, 32vw);
        min-width: 220px;
        direction: rtl;
        position: relative;
    }

    .active-position-trigger {
        flex: 1 1 auto;
        min-width: 0;
        width: 100%;
        height: 38px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 11px;
        border: 1px solid var(--border,#d9e0ea);
        border-radius: 10px;
        background: var(--surface,#fff);
        color: var(--text,#344054);
        font: inherit;
        font-size: 12px;
        cursor: pointer;
        direction: rtl;
        text-align: right;
        transition: border-color .15s, box-shadow .15s;
    }

    .active-position-trigger:hover,
    .active-position-trigger[aria-expanded="true"] {
        border-color: #98a2b3;
        box-shadow: 0 2px 8px rgba(16, 24, 40, .08);
    }

    .active-position-trigger>i:first-child {
        color: var(--accent,#2563eb);
        font-size: 17px;
        flex: 0 0 auto;
    }

    .active-position-value {
        min-width: 0;
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .active-position-chevron {
        font-size: 18px;
        flex: 0 0 auto;
        color: var(--text-muted,#667085);
    }

    .active-position-dropdown {
        position: absolute;
        width: 320px;
        max-width: calc(100vw - 16px);
        max-height: calc(100vh - 16px);
        overflow: hidden;
        border: 1px solid var(--border,#e4e7ec);
        border-radius: 12px;
        background: var(--surface,#fff);
        box-shadow: 0 18px 45px rgba(16, 24, 40, .18);
        direction: rtl;
        text-align: right;
    }

    .active-position-dropdown-header {
        padding: 11px 14px;
        border-bottom: 1px solid var(--border,#eaecf0);
        color: var(--text-muted,#667085);
        font-size: 11px;
        font-weight: 700;
        background: var(--surface-2,#f8fafc);
    }

    .active-position-options {
        max-height: 350px;
        overflow-y: auto;
        padding: 5px;
    }

    .active-position-option {
        width: 100%;
        min-height: 44px;
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 8px 9px;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: var(--text,#344054);
        font: inherit;
        font-size: 12px;
        text-align: right;
        direction: rtl;
        cursor: pointer;
    }

    .active-position-option:hover {
        background: var(--surface-2,#f2f4f7);
    }

    .active-position-option.selected {
        background: var(--accent-soft,#eff6ff);
        color: var(--accent-strong,#1d4ed8);
        font-weight: 600;
    }

    .position-option-icon {
        width: 30px;
        height: 30px;
        flex: 0 0 30px;
        display: grid;
        place-items: center;
        border-radius: 7px;
        background: var(--surface-2,#f2f4f7);
        color: var(--text-muted,#667085);
    }

    .selected .position-option-icon {
        background: var(--accent-soft2,#dbeafe);
        color: var(--accent,#2563eb);
    }

    .position-option-text {
        min-width: 0;
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .position-option-check {
        flex: 0 0 auto;
        color: var(--accent,#2563eb);
        font-size: 18px;
    }

    .active-position-submit {
        flex: 0 0 38px;
        width: 38px;
        height: 38px;
        border: 0;
        border-radius: 10px;
        background: var(--accent,#2563eb);
        color: #fff;
        display: grid;
        place-items: center;
        cursor: pointer;
    }

    .active-position-submit:hover {
        background: var(--accent-strong,#1d4ed8);
    }

    .active-position-single {
        display: flex;
        align-items: center;
        gap: 7px;
        max-width: 320px;
        padding: 0 11px;
        height: 38px;
        border: 1px solid var(--border,#e4e7ec);
        border-radius: 10px;
        color: var(--text-muted,#475467);
        font-size: 12px;
        background: var(--surface-2,#f8fafc);
        direction: rtl;
    }

    .active-position-single span {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .active-position-single i {
        color: var(--accent,#2563eb);
        font-size: 17px;
        flex: 0 0 auto;
    }
</style>
