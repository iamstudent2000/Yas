ext-align:center;padding:14px 5px;color:#94a3b8;font-size:12px}.pdp-weekdays,.pdp-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;text-align:center}.pdp-weekdays{margin-bottom:4px}.pdp-weekdays span{font-size:11px;color:#94a3b8;font-weight:700;padding:5px 0}.pdp-day,.pdp-empty{height:34px}.pdp-day{border:0;background:transparent;border-radius:8px;cursor:pointer;color:#334155;font-family:inherit}.pdp-day:hover{background:#e2e8f0}.pdp-day.today{box-shadow:inset 0 0 0 1px #2563eb}.pdp-day.selected{background:#2563eb;color:#fff;font-weight:700}.pdp-footer{display:flex;justify-content:space-between;margin-top:10px;padding-top:10px;border-top:1px solid #f1f5f9}.pdp-today,.pdp-clear{border:0;background:transparent;cursor:pointer;font-family:inherit;font-size:12px;font-weight:600}.pdp-today{color:#2563eb}.pdp-clear{color:#64748b}
