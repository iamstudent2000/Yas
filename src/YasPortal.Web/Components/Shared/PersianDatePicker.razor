@using System.Globalization

<div class="pdp" dir="rtl">
    <button type="button" class="pdp-input" @onclick="Toggle" aria-haspopup="dialog" aria-expanded="@_open">
        <span class="pdp-value">@(_selected.HasValue ? ToPersianDate(_selected.Value) : Placeholder)</span>
        <span class="pdp-icon">📅</span>
    </button>

    @if (_open)
    {
        <div class="pdp-popover">
            <div class="pdp-header">
                <button type="button" class="pdp-nav" @onclick="PreviousMonth" aria-label="ماه قبل">‹</button>
                <div class="pdp-month-title">
                    <button type="button" class="pdp-month-part" @onclick="PreviousYear" aria-label="سال قبل">@ToPersianDigits(_displayYear.ToString())</button>
                    <span>@MonthNames[_displayMonth - 1]</span>
                </div>
                <button type="button" class="pdp-nav" @onclick="NextMonth" aria-label="ماه بعد">›</button>
            </div>

            <div class="pdp-year-nav">
                <button type="button" @onclick="PreviousYear">سال قبل</button>
                <button type="button" @onclick="GoToday">امروز</button>
                <button type="button" @onclick="NextYear">سال بعد</button>
            </div>

            <div class="pdp-weekdays">
                @foreach (var day in Weekdays) { <span>@day</span> }
            </div>
            <div class="pdp-grid">
                @foreach (var cell in GetCells())
                {
                    if (cell.Day == 0)
                    {
                        <span class="pdp-empty"></span>
                    }
                    else
                    {
                        <button type="button" class="pdp-day @(cell.IsSelected ? "selected" : "") @(cell.IsToday ? "today" : "")" @onclick="() => Select(cell.Day)">@ToPersianDigits(cell.Day.ToString())</button>
                    }
                }
            </div>

            <div class="pdp-footer">
                <button type="button" class="pdp-today" @onclick="GoToday">امروز</button>
                @if (_selected.HasValue)
                {
                    <button type="button" class="pdp-clear" @onclick="Clear">پاک کردن</button>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "انتخاب تاریخ";

    private bool _open;
    private DateTime? _selected;
    private int _displayYear;
    private int _displayMonth;
    private readonly PersianCalendar _calendar = new();

    private static readonly string[] MonthNames =
    [
        "فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور",
        "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند"
    ];

    private static readonly string[] Weekdays = ["ش", "ی", "د", "س", "چ", "پ", "ج"];

    protected override void OnInitialized()
    {
        SetDisplayDate(Value ?? DateTime.Now);
        _selected = Value;
    }

    protected override void OnParametersSet()
    {
        if (Value != _selected)
        {
            _selected = Value;
            SetDisplayDate(Value ?? DateTime.Now);
        }

        EnsureDisplayDate();
    }

    private void SetDisplayDate(DateTime date)
    {
        _displayYear = _calendar.GetYear(date);
        _displayMonth = _calendar.GetMonth(date);
    }

    private void EnsureDisplayDate()
    {
        if (_displayYear < 1 || _displayMonth < 1 || _displayMonth > 12)
            SetDisplayDate(_selected ?? DateTime.Now);
    }

    private void Toggle()
    {
        EnsureDisplayDate();
        _open = !_open;
    }

    private void PreviousMonth()
    {
        EnsureDisplayDate();
        if (_displayMonth == 1)
        {
            _displayMonth = 12;
            _displayYear--;
        }
        else
        {
            _displayMonth--;
        }
    }

    private void NextMonth()
    {
        EnsureDisplayDate();
        if (_displayMonth == 12)
        {
            _displayMonth = 1;
            _displayYear++;
        }
        else
        {
            _displayMonth++;
        }
    }

    private void PreviousYear()
    {
        EnsureDisplayDate();
        if (_displayYear > 1)
            _displayYear--;
    }

    private void NextYear()
    {
        EnsureDisplayDate();
        _displayYear++;
    }

    private void GoToday()
    {
        SetDisplayDate(DateTime.Now);
    }

    private async Task Select(int day)
    {
        EnsureDisplayDate();
        _selected = _calendar.ToDateTime(_displayYear, _displayMonth, day, 0, 0, 0, 0);
        _open = false;
        await ValueChanged.InvokeAsync(_selected);
    }

    private async Task Clear()
    {
        _selected = null;
        _open = false;
        await ValueChanged.InvokeAsync(null);
    }

    private string ToPersianDate(DateTime date) =>
        ToPersianDigits($"{_calendar.GetYear(date):0000}/{_calendar.GetMonth(date):00}/{_calendar.GetDayOfMonth(date):00}");

    private static string ToPersianDigits(string value) =>
        value.Replace("0", "۰").Replace("1", "۱").Replace("2", "۲").Replace("3", "۳").Replace("4", "۴")
             .Replace("5", "۵").Replace("6", "۶").Replace("7", "۷").Replace("8", "۸").Replace("9", "۹");

    private IEnumerable<DayCell> GetCells()
    {
        EnsureDisplayDate();

        var first = _calendar.ToDateTime(_displayYear, _displayMonth, 1, 0, 0, 0, 0);
        var offset = ((int)first.DayOfWeek + 1) % 7;
        var days = _calendar.GetDaysInMonth(_displayYear, _displayMonth);

        for (var i = 0; i < offset; i++)
            yield return new DayCell(0, false, false);

        var today = DateTime.Now;
        var todayYear = _calendar.GetYear(today);
        var todayMonth = _calendar.GetMonth(today);
        var todayDay = _calendar.GetDayOfMonth(today);

        for (var d = 1; d <= days; d++)
        {
            var date = _calendar.ToDateTime(_displayYear, _displayMonth, d, 0, 0, 0, 0);
            yield return new DayCell(
                d,
                _selected.HasValue && _selected.Value.Date == date.Date,
                todayYear == _displayYear && todayMonth == _displayMonth && todayDay == d);
        }
    }

    private sealed record DayCell(int Day, bool IsSelected, bool IsToday);
}

