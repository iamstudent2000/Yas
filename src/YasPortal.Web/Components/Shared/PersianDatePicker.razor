@using System.Globalization

<div class="pdp" dir="rtl">
    <button type="button" class="pdp-input" @onclick="Toggle" aria-haspopup="dialog" aria-expanded="@_open">
        <span class="pdp-value">@(_selected.HasValue ? ToPersianDate(_selected.Value) : Placeholder)</span>
        <span class="pdp-icon">📅</span>
    </button>

    @if (_open)
    {
        <div class="pdp-popover">
            <div class="pdp-header">
                <button type="button" class="pdp-nav" @onclick="PreviousMonth" aria-label="ماه قبل">‹</button>
                <div class="pdp-selectors">
                    <div class="pdp-picker">
                        <button type="button" class="pdp-select pdp-picker-button" @onclick="ToggleYearPicker">
                            @ToPersianDigits(_displayYear.ToString()) <span>⌄</span>
                        </button>
                        @if (_yearPickerOpen)
                        {
                            <div class="pdp-menu">
                                <input class="pdp-search" value="@_yearSearch" @oninput="SearchYear" placeholder="جستجوی سال..." autocomplete="off" />
                                <div class="pdp-options">
                                    @if (FilteredYears.Any())
                                    {
                                        @foreach (var year in FilteredYears)
                                        {
                                            <button type="button" class="pdp-option @(year == _displayYear ? "active" : "")" @onclick="() => SelectYear(year)">@ToPersianDigits(year.ToString())</button>
                                        }
                                    }
                                    else { <div class="pdp-no-results">موردی یافت نشد</div> }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="pdp-picker">
                        <button type="button" class="pdp-select pdp-picker-button" @onclick="ToggleMonthPicker">
                            @MonthNames[_displayMonth - 1] <span>⌄</span>
                        </button>
                        @if (_monthPickerOpen)
                        {
                            <div class="pdp-menu pdp-month-menu">
                                <input class="pdp-search" value="@_monthSearch" @oninput="SearchMonth" placeholder="جستجوی ماه..." autocomplete="off" />
                                <div class="pdp-options">
                                    @if (FilteredMonths.Any())
                                    {
                                        @foreach (var month in FilteredMonths)
                                        {
                                            <button type="button" class="pdp-option @(month == _displayMonth ? "active" : "")" @onclick="() => SelectMonth(month)">@MonthNames[month - 1]</button>
                                        }
                                    }
                                    else { <div class="pdp-no-results">موردی یافت نشد</div> }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <button type="button" class="pdp-nav" @onclick="NextMonth" aria-label="ماه بعد">›</button>
            </div>

            <div class="pdp-weekdays">
                @foreach (var day in Weekdays) { <span>@day</span> }
            </div>
            <div class="pdp-grid">
                @foreach (var cell in GetCells())
                {
                    if (cell.Day == 0) <span class="pdp-empty"></span>
                    else <button type="button" class="pdp-day @(cell.IsSelected ? "selected" : "") @(cell.IsToday ? "today" : "")" @onclick="() => Select(cell.Day)">@ToPersianDigits(cell.Day.ToString())</button>
                }
            </div>
            <div class="pdp-footer">
                <button type="button" class="pdp-today" @onclick="GoToday">امروز</button>
                @if (_selected.HasValue) { <button type="button" class="pdp-clear" @onclick="Clear">پاک کردن</button> }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "انتخاب تاریخ";

    private bool _open, _yearPickerOpen, _monthPickerOpen;
    private string _yearSearch = "", _monthSearch = "";
    private DateTime? _selected;
    private int _displayYear, _displayMonth;
    private readonly PersianCalendar _calendar = new();
    private static readonly string[] MonthNames = ["فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور", "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند"];
    private static readonly string[] Weekdays = ["ش", "ی", "د", "س", "چ", "پ", "ج"];
    private IEnumerable<int> YearOptions => Enumerable.Range(1300, 151);
    private IEnumerable<int> FilteredYears => string.IsNullOrWhiteSpace(NormalizeDigits(_yearSearch.Trim())) ? YearOptions : YearOptions.Where(y => y.ToString().Contains(NormalizeDigits(_yearSearch.Trim())));
    private IEnumerable<int> FilteredMonths => string.IsNullOrWhiteSpace(_monthSearch.Trim()) ? Enumerable.Range(1, 12) : Enumerable.Range(1, 12).Where(m => MonthNames[m - 1].Contains(_monthSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized() { SetDisplayDate(Value ?? DateTime.Now); _selected = Value; }
    protected override void OnParametersSet() { if (Value != _selected) { _selected = Value; SetDisplayDate(Value ?? DateTime.Now); } EnsureDisplayDate(); }
    private void SetDisplayDate(DateTime date) { _displayYear = _calendar.GetYear(date); _displayMonth = _calendar.GetMonth(date); }
    private void EnsureDisplayDate() { if (_displayYear < 1 || _displayMonth < 1 || _displayMonth > 12) SetDisplayDate(_selected ?? DateTime.Now); }
    private void Toggle() { EnsureDisplayDate(); _open = !_open; if (!_open) ClosePickers(); }
    private void ClosePickers() { _yearPickerOpen = false; _monthPickerOpen = false; _yearSearch = _monthSearch = ""; }
    private void ToggleYearPicker() { _yearPickerOpen = !_yearPickerOpen; _monthPickerOpen = false; _yearSearch = ""; }
    private void ToggleMonthPicker() { _monthPickerOpen = !_monthPickerOpen; _yearPickerOpen = false; _monthSearch = ""; }
    private void SearchYear(ChangeEventArgs e) => _yearSearch = e.Value?.ToString() ?? "";
    private void SearchMonth(ChangeEventArgs e) => _monthSearch = e.Value?.ToString() ?? "";
    private void SelectYear(int year) { _displayYear = year; _yearPickerOpen = false; _yearSearch = ""; }
    private void SelectMonth(int month) { _displayMonth = month; _monthPickerOpen = false; _monthSearch = ""; }
    private void PreviousMonth() { EnsureDisplayDate(); if (_displayMonth == 1) { if (_displayYear > 1) { _displayMonth = 12; _displayYear--; } } else _displayMonth--; }
    private void NextMonth() { EnsureDisplayDate(); if (_displayMonth == 12) { _displayMonth = 1; _displayYear++; } else _displayMonth++; }
    private void GoToday() { SetDisplayDate(DateTime.Now); ClosePickers(); }
    private async Task Select(int day) { EnsureDisplayDate(); _selected = _calendar.ToDateTime(_displayYear, _displayMonth, day, 0, 0, 0, 0); _open = false; ClosePickers(); await ValueChanged.InvokeAsync(_selected); }
    private async Task Clear() { _selected = null; _open = false; ClosePickers(); await ValueChanged.InvokeAsync(null); }
    private string ToPersianDate(DateTime date) => ToPersianDigits($"{_calendar.GetYear(date):0000}/{_calendar.GetMonth(date):00}/{_calendar.GetDayOfMonth(date):00}");
    private static string ToPersianDigits(string value) => value.Replace("0", "۰").Replace("1", "۱").Replace("2", "۲").Replace("3", "۳").Replace("4", "۴").Replace("5", "۵").Replace("6", "۶").Replace("7", "۷").Replace("8", "۸").Replace("9", "۹");
    private static string NormalizeDigits(string value) => value.Replace("۰", "0").Replace("۱", "1").Replace("۲", "2").Replace("۳", "3").Replace("۴", "4").Replace("۵", "5").Replace("۶", "6").Replace("۷", "7").Replace("۸", "8").Replace("۹", "9");
    private IEnumerable<DayCell> GetCells() { EnsureDisplayDate(); var first = _calendar.ToDateTime(_displayYear, _displayMonth, 1, 0, 0, 0, 0); var offset = ((int)first.DayOfWeek + 1) % 7; var days = _calendar.GetDaysInMonth(_displayYear, _displayMonth); for (var i = 0; i < offset; i++) yield return new DayCell(0, false, false); var today = DateTime.Now; var ty = _calendar.GetYear(today); var tm = _calendar.GetMonth(today); var td = _calendar.GetDayOfMonth(today); for (var d = 1; d <= days; d++) { var date = _calendar.ToDateTime(_displayYear, _displayMonth, d, 0, 0, 0, 0); yield return new DayCell(d, _selected.HasValue && _selected.Value.Date == date.Date, ty == _displayYear && tm == _displayMonth && td == d); } }
    private sealed record DayCell(int Day, bool IsSelected, bool IsToday);
}

