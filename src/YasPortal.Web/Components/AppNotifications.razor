@using YasPortal.Web.Services
@implements IDisposable
@inject AppState AppState

@* Pop-up messages (toasts) shown in a corner of the screen: success, information, warning and error notices. *@
@* Each message comes from the shared application state, which pages use to announce the result of an action. *@
<div class="app-toast-container" aria-live="polite" aria-relevant="additions removals">
    @foreach (var toast in AppState.Toasts)
    {
        var expanded = _expandedIds.Contains(toast.Id);
        @* One card per message. Clicking the text expands or collapses a long message; the close button dismisses it. *@
        <div @key="toast.Id" class="app-toast app-toast-@toast.Level.ToString().ToLowerInvariant() @(expanded ? "app-toast-expanded" : "")" role="status">
            <div class="app-toast-icon" aria-hidden="true">
                <i class="@GetIcon(toast.Level)"></i>
            </div>

            <div class="app-toast-content" @onclick="() => ToggleExpanded(toast.Id)" style="cursor:pointer">
                <div class="app-toast-title">@GetTitle(toast.Level)</div>
                <div class="app-toast-message">@toast.Message</div>
            </div>

            <button type="button" class="app-toast-close" aria-label="بستن" @onclick="() => AppState.RemoveToast(toast)">
                <i class="ti @Icons.Close"></i>
            </button>
        </div>
    }
</div>

@code {
    // Messages the user has clicked open, so long text is shown in full.
    private readonly HashSet<Guid> _expandedIds = [];

    // Expand a message if it was collapsed, collapse it if it was expanded.
    private void ToggleExpanded(Guid id)
    {
        if (!_expandedIds.Add(id))
            _expandedIds.Remove(id);
    }

    // Start listening so the screen refreshes whenever a new message appears or one is removed.
    protected override void OnInitialized()
    {
        AppState.OnChange += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    // Chooses the icon that matches the kind of message.
    private static string GetIcon(ToastLevel level) => level switch
    {
        ToastLevel.Success => ("ti " + Icons.Success),
        ToastLevel.Info => ("ti " + Icons.Info),
        ToastLevel.Warning => ("ti " + Icons.Warning),
        ToastLevel.Error => ("ti " + Icons.Failure),
        _ => ("ti " + Icons.Info)
    };

    // Chooses the short heading (success, information, warning or error) for the kind of message.
    private static string GetTitle(ToastLevel level) => level switch
    {
        ToastLevel.Success => "عملیات موفق",
        ToastLevel.Info => "اطلاع",
        ToastLevel.Warning => "توجه",
        ToastLevel.Error => "خطا",
        _ => "اطلاع"
    };

    // Stop listening when this widget goes away, so no stale updates are delivered.
    public void Dispose()
    {
        AppState.OnChange -= HandleStateChanged;
    }
}
