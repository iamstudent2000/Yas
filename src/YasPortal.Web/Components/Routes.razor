@using Microsoft.AspNetCore.Components.Authorization

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(YasPortal.Web.Components.Layout.ApplicationLayout">
            <NotAuthorized>
                <h1>Sign in required</h1>
                <p>You must sign in to access this page.</p>
                <a href="/login">Go to sign in</a>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(YasPortal.Web.Components.Layout.ApplicationLayout)">
            <h1>Not found</h1>
            <p>Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>
