@page "/admin/positions"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Domain.Organization
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Services
@attribute [Authorize(Policy = "Admin.Positions")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AppState AppState

<PageTitle>سمت‌ها - یاس پورتال</PageTitle>
<div class="page-header"><div><div class="page-subtitle">مدیریت سامانه / سمت‌ها</div><h1 class="page-title">مدیریت سمت‌ها</h1><p class="page-subtitle">ایجاد، ویرایش و مشاهده سمت‌های قابل تخصیص به کارکنان</p></div><a class="btn btn-secondary" href="/dashboard"><i class="bx bx-arrow-back"></i> داشبورد</a></div>
<div class="stat-grid"><div class="stat-card"><div class="stat-icon"><i class="bx bx-briefcase"></i></div><span class="stat-label">کل سمت‌ها</span><strong class="stat-value">@_positions.Count</strong></div><div class="stat-card"><div class="stat-icon"><i class="bx bx-group"></i></div><span class="stat-label">کارکنان دارای سمت</span><strong class="stat-value">@_assignedEmployeeCount</strong></div><div class="stat-card"><div class="stat-icon"><i class="bx bx-key"></i></div><span class="stat-label">تخصیص‌های مجوز</span><strong class="stat-value">@_permissionAssignmentCount</strong></div></div>
<div class="admin-two-col"><section class="card"><h2 class="section-title"><i class="bx bx-plus-circle"></i> @(_editingId is null?"سمت جدید":"ویرایش سمت")</h2><label class="form-label">نام سمت</label><input class="form-control" @bind="_name" maxlength="200" placeholder="مثلاً مدیر واحد"/><div class="form-actions"><button class="btn btn-primary" @onclick="Save"><i class="bx bx-save"></i> @(_editingId is null?"ایجاد":"ذخیره")</button>@if(_editingId is not null){<button class="btn btn-secondary" @onclick="Cancel">انصراف</button>}</div></section>
<section class="card table-card"><div class="table-toolbar"><h2 class="section-title" style="margin:0">فهرست سمت‌ها</h2></div><div class="data-table-wrap"><table class="data-table"><thead><tr><th>سمت</th><th>کارکنان فعال</th><th>مجوزها</th><th>عملیات</th></tr></thead><tbody>@foreach(var x in _positions){<tr @key="x.Id"><td><strong>@x.Name</strong></td><td>@x.EmployeeCount</td><td>@x.PermissionCount</td><td class="action-cell"><button class="btn btn-secondary btn-sm" @onclick="()=>Edit(x.Id)"><i class="bx bx-edit-alt"></i> ویرایش</button>@if(x.EmployeeCount==0&&x.PermissionCount==0){<button class="btn btn-danger btn-sm" @onclick="()=>Delete(x.Id)"><i class="bx bx-trash"></i></button>}else{<button class="btn btn-disabled btn-sm" disabled title="این سمت دارای تخصیص است"><i class="bx bx-lock-alt"></i></button>}</td></tr>}</tbody></table></div></section></div>
<section class="card" style="margin-top:16px"><h2 class="section-title">نکته</h2><p class="page-subtitle">حذف سمت فقط وقتی مجاز است که هیچ کارمند یا مجوزی به آن سمت وابسته نباشد. برای حفظ سابقه، تخصیص سمت کارکنان در صفحه کاربران پایان داده می‌شود.</p></section>
@code { private List<PositionRow> _positions=[];private Guid? _editingId;private string _name="";private int _assignedEmployeeCount,_permissionAssignmentCount;protected override async Task OnInitializedAsync()=>await LoadAsync();private async Task LoadAsync(){await using var db=await DbFactory.CreateDbContextAsync();_positions=await db.Positions.AsNoTracking().OrderBy(x=>x.Name).Select(x=>new PositionRow(x.Id,x.Name,db.EmployeePositions.Count(ep=>ep.PositionId==x.Id&&ep.EndedAt==null),db.UserPositionPermissions.Count(up=>up.PositionId==x.Id))).ToListAsync();_assignedEmployeeCount=_positions.Sum(x=>x.EmployeeCount);_permissionAssignmentCount=_positions.Sum(x=>x.PermissionCount);}private void Edit(Guid id){_editingId=id;_name=_positions.Single(x=>x.Id==id).Name;}private void Cancel(){_editingId=null;_name="";}private async Task Save(){var name=_name.Trim();if(string.IsNullOrWhiteSpace(name)){AppState.AddToast("نام سمت الزامی است.",ToastLevel.Error);return;}await using var db=await DbFactory.CreateDbContextAsync();if(await db.Positions.AnyAsync(x=>x.Name==name&&x.Id!=(_editingId??Guid.Empty))){AppState.AddToast("سمتی با این نام قبلاً ثبت شده است.",ToastLevel.Error);return;}if(_editingId is Guid id){(await db.Positions.SingleAsync(x=>x.Id==id)).Rename(name);AppState.AddToast("سمت ویرایش شد.",ToastLevel.Success);}else{db.Positions.Add(new Position(name));AppState.AddToast("سمت جدید ایجاد شد.",ToastLevel.Success);}await db.SaveChangesAsync();Cancel();await LoadAsync();}private async Task Delete(Guid id){await using var db=await DbFactory.CreateDbContextAsync();if(await db.EmployeePositions.AnyAsync(x=>x.PositionId==id)||await db.UserPositionPermissions.AnyAsync(x=>x.PositionId==id)){AppState.AddToast("این سمت دارای تخصیص است و قابل حذف نیست.",ToastLevel.Error);return;}var x=await db.Positions.SingleAsync(x=>x.Id==id);db.Positions.Remove(x);await db.SaveChangesAsync();AppState.AddToast("سمت حذف شد.",ToastLevel.Success);await LoadAsync();}private sealed record PositionRow(Guid Id,string Name,int EmployeeCount,int PermissionCount);}
<style>.admin-two-col{display:grid;grid-template-columns:minmax(280px,340px) 1fr;gap:16px;align-items:start}.form-label{display:block;margin:12px 0 6px}.form-actions{display:flex;gap:8px;margin-top:13px}.btn-sm{padding:7px 10px;font-size:12px}.btn-disabled{background:#f2f4f7;color:#98a2b3;border:1px solid #eaecf0;cursor:not-allowed}.action-cell{white-space:nowrap}@@media(max-width:900px){.admin-two-col{grid-template-columns:1fr}}</style>
