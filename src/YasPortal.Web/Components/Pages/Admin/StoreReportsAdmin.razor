@page "/admin/store/reports"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using YasPortal.Infrastructure.Store
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize(Policy = Perm.StoreReportsView)]
@inject StoreReportService Reports
@inject IJSRuntime JS
@inject AppState AppState

<PageTitle>گزارش‌های فروشگاه - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <StoreAdminTabs />
    <div class="page-header">
        <div>
            <div class="page-kicker">فروشگاه</div>
            <h1 class="page-title"><i class="ti @Icons.AuditLog"></i> گزارش‌های فروشگاه</h1>
            <p class="page-subtitle">گزارش را انتخاب کنید؛ جدول را می‌توانید چاپ کنید یا به‌صورت فایل CSV (باز شدن در اکسل) بگیرید.</p>
        </div>
        <div class="form-actions">
            <button type="button" class="btn btn-secondary" disabled="@(_table is null || _table.Rows.Count == 0)" @onclick="ExportAsync"><i class="ti @Icons.ExportData"></i> خروجی CSV</button>
            <button type="button" class="btn btn-secondary" onclick="window.print()"><i class="ti @Icons.Print"></i> چاپ</button>
        </div>
    </div>

    <section class="card list-filter no-print">
        <div class="store-chips" role="group" aria-label="نوع گزارش">
            @foreach (var kind in StoreReportService.Kinds)
            {
                <button type="button" class="store-chip @(_key == kind.Key ? "is-active" : "")" @onclick="() => SelectAsync(kind.Key)">@kind.Name</button>
            }
        </div>
    </section>

    @if (Current.UsesDates || Current.UsesDays)
    {
        <ListFilterBar Busy="_loading" ActiveCount="FilterCount" CanClear="@(FilterCount > 0 || _dFrom is not null || _dTo is not null || _dDays != 90)"
                       OnSearch="ApplyFiltersAsync" OnClear="ClearFiltersAsync">
            @if (Current.UsesDates)
            {
                <div class="admin-filter"><label class="form-label">از تاریخ</label><PersianDatePicker @key="_key" Value="_dFrom" ValueChanged="d => _dFrom = d" Placeholder="تاریخ" /></div>
                <div class="admin-filter"><label class="form-label">تا تاریخ</label><PersianDatePicker @key="_key" Value="_dTo" ValueChanged="d => _dTo = d" Placeholder="تاریخ" /></div>
            }
            @if (Current.UsesDays)
            {
                <div class="admin-filter"><label class="form-label">بدون گردش در</label>
                    <LookupSelect Options="DayOptions" Value="@_dDays.ToString()" ValueChanged="k => _dDays = int.TryParse(k, out var d) ? d : 90" Placeholder="انتخاب" /></div>
            }
        </ListFilterBar>
    }

    @if (_loading)
    {
        <LoadingState />
    }
    else if (_table is not null)
    {
        <section class="card">
            <h2 class="section-title">@_table.Title</h2>
            <p class="muted">@_table.Description</p>
            @if (_table.Rows.Count == 0)
            {
                <div class="empty-state"><strong>برای این گزارش داده‌ای نیست</strong></div>
            }
            else
            {
                <div class="data-table-wrap">
                    <table class="data-table data-table-bordered-rows">
                        <thead><tr>@foreach (var h in _table.Headers) {<th>@h</th>}</tr></thead>
                        <tbody>
                            @foreach (var row in _table.Rows)
                            {
                                <tr>@foreach (var cell in row) {<td>@WorkflowDisplay.ToPersianDigits(cell)</td>}</tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="muted">@WorkflowDisplay.ToPersianDigits(_table.Rows.Count.ToString()) ردیف</p>
            }
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private string _key = "categories";
    private DateTime? _from, _to;
    private int _days = 90;
    // What is chosen in the filter card; it becomes the applied value above only when "جستجو" is pressed.
    private DateTime? _dFrom, _dTo;
    private int _dDays = 90;
    private StoreReportTable? _table;
    private static readonly IReadOnlyList<(string Key, string Text)> DayOptions = [("30", "۳۰ روز"), ("60", "۶۰ روز"), ("90", "۹۰ روز"), ("180", "۱۸۰ روز"), ("365", "یک سال")];

    private (string Key, string Name, bool UsesDates, bool UsesDays) Current => StoreReportService.Kinds.First(k => k.Key == _key);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try { _table = await Reports.BuildAsync(_key, _from, _to, _days); }
        catch (Exception) { AppState.AddToast("ساخت گزارش انجام نشد.", ToastLevel.Error); }
        finally { _loading = false; }
    }

    private int FilterCount => (Current.UsesDates ? (_from is null ? 0 : 1) + (_to is null ? 0 : 1) : 0) + (Current.UsesDays && _days != 90 ? 1 : 0);

    // Picking another report applies at once (it is a choice of report, not a filter); the card then shows the values in use.
    private async Task SelectAsync(string key)
    {
        _key = key;
        (_dFrom, _dTo, _dDays) = (_from, _to, _days);
        await LoadAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        (_from, _to, _days) = (_dFrom, _dTo, _dDays);
        await LoadAsync();
    }

    private async Task ClearFiltersAsync()
    {
        (_dFrom, _dTo, _dDays) = (null, null, 90);
        await ApplyFiltersAsync();
    }

    private async Task ExportAsync()
    {
        if (_table is null) return;
        var bytes = StoreCsv.Build(_table.Headers, _table.Rows);
        await JS.InvokeVoidAsync("yasDownloadFile", $"store-{_key}-{DateTime.Now:yyyyMMdd-HHmm}.csv", "text/csv;charset=utf-8", bytes);
    }
}
