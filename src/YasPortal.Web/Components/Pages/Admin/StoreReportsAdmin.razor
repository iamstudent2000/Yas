@page "/admin/store/reports"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using YasPortal.Infrastructure.Store
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize(Policy = Perm.StoreReportsView)]
@inject StoreReportService Reports
@inject IJSRuntime JS
@inject AppState AppState

<PageTitle>گزارش‌های فروشگاه - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <StoreAdminTabs />
    <div class="page-header">
        <div>
            <div class="page-kicker">فروشگاه</div>
            <h1 class="page-title"><i class="ti @Icons.AuditLog"></i> گزارش‌های فروشگاه</h1>
            <p class="page-subtitle">گزارش را انتخاب کنید؛ جدول را می‌توانید چاپ کنید یا به‌صورت فایل CSV (باز شدن در اکسل) بگیرید.</p>
        </div>
    </div>

    @{ var draft = StoreReportService.Kinds.First(k => k.Key == _dKey); }
    <ListFilterBar Busy="_loading" ActiveCount="FilterCount" CanClear="@(FilterCount > 0 || _dKey != "categories" || _dFrom is not null || _dTo is not null || _dDays != 90)"
                   OnSearch="ApplyFiltersAsync" OnClear="ClearFiltersAsync"
                   OnExport="ExportAsync" ExportPermission="@Perm.StoreReportsView" Exporting="_exporting">
        <div class="admin-filter"><label class="form-label">نوع گزارش</label>
            <LookupSelect Options="KindOptions" Value="@_dKey" ValueChanged="k => { if (!string.IsNullOrEmpty(k)) _dKey = k; }" Placeholder="انتخاب گزارش" /></div>
        @if (draft.UsesDates)
        {
            <div class="admin-filter"><label class="form-label">از تاریخ</label><PersianDatePicker @key="_dKey" Value="_dFrom" ValueChanged="d => _dFrom = d" Placeholder="تاریخ" /></div>
            <div class="admin-filter"><label class="form-label">تا تاریخ</label><PersianDatePicker @key="_dKey" Value="_dTo" ValueChanged="d => _dTo = d" Placeholder="تاریخ" /></div>
        }
        @if (draft.UsesDays)
        {
            <div class="admin-filter"><label class="form-label">بدون گردش در</label>
                <LookupSelect Options="DayOptions" Value="@_dDays.ToString()" ValueChanged="k => _dDays = int.TryParse(k, out var d) ? d : 90" Placeholder="انتخاب" /></div>
        }
    </ListFilterBar>

    @if (_loading)
    {
        <LoadingState />
    }
    else if (_table is not null)
    {
        <section class="card">
            <h2 class="section-title">@_table.Title</h2>
            <p class="muted">@_table.Description</p>
            @if (_table.Rows.Count == 0)
            {
                <div class="empty-state"><strong>برای این گزارش داده‌ای نیست</strong></div>
            }
            else
            {
                <div class="data-table-wrap">
                    <table class="data-table data-table-bordered-rows">
                        <thead><tr>@for (var ci = 0; ci < _table.Headers.Count; ci++) { var col = ci; <SortableHeader Text="@_table.Headers[col]" Column="@col.ToString()" CurrentSort="@_sortCol" CurrentDescending="@_sortDesc" OnSort="SortByAsync" /> }</tr></thead>
                        <tbody>
                            @foreach (var row in SortedRows)
                            {
                                <tr>@foreach (var cell in row) {<td>@WorkflowDisplay.ToPersianDigits(cell)</td>}</tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="muted">@WorkflowDisplay.ToPersianDigits(_table.Rows.Count.ToString()) ردیف</p>
            }
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private string _key = "categories";
    private string _dKey = "categories";
    private bool _exporting;
    private DateTime? _from, _to;
    private int _days = 90;
    // What is chosen in the filter card; it becomes the applied value above only when "جستجو" is pressed.
    private DateTime? _dFrom, _dTo;
    private int _dDays = 90;
    private StoreReportTable? _table;
    private string? _sortCol;
    private bool _sortDesc;

    private Task SortByAsync(string col) { (_sortCol, _sortDesc) = TableSort.Toggle(_sortCol, _sortDesc, col); return Task.CompletedTask; }

    private IReadOnlyList<IReadOnlyList<string>> SortedRows
    {
        get
        {
            if (_table is null) return [];
            var rows = _table.Rows.Select(r => (IReadOnlyList<string>)r).ToList();
            if (!int.TryParse(_sortCol, out var c)) return rows;
            return TableSort.Apply(rows, _sortCol, _sortDesc, (_sortCol!, r => c < r.Count ? r[c] : null));
        }
    }
    private static readonly IReadOnlyList<(string Key, string Text)> DayOptions = [("30", "۳۰ روز"), ("60", "۶۰ روز"), ("90", "۹۰ روز"), ("180", "۱۸۰ روز"), ("365", "یک سال")];

    private static readonly IReadOnlyList<(string Key, string Text)> KindOptions = StoreReportService.Kinds.Select(k => (k.Key, k.Name)).ToList();

    private (string Key, string Name, bool UsesDates, bool UsesDays) Current => StoreReportService.Kinds.First(k => k.Key == _key);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _sortCol = null; _sortDesc = false;
        try { _table = await Reports.BuildAsync(_key, _from, _to, _days); }
        catch (Exception) { AppState.AddToast("ساخت گزارش انجام نشد.", ToastLevel.Error); }
        finally { _loading = false; }
    }

    private int FilterCount => (Current.UsesDates ? (_from is null ? 0 : 1) + (_to is null ? 0 : 1) : 0) + (Current.UsesDays && _days != 90 ? 1 : 0);

    private async Task ApplyFiltersAsync()
    {
        (_key, _from, _to, _days) = (_dKey, _dFrom, _dTo, _dDays);
        await LoadAsync();
    }

    private async Task ClearFiltersAsync()
    {
        (_dKey, _dFrom, _dTo, _dDays) = ("categories", null, null, 90);
        await ApplyFiltersAsync();
    }

    private async Task ExportAsync()
    {
        if (_table is null || _table.Rows.Count == 0) { AppState.AddToast("داده‌ای برای خروجی نیست.", ToastLevel.Info); return; }
        _exporting = true;
        try
        {
            var bytes = StoreCsv.Build(_table.Headers, SortedRows);
            await JS.InvokeVoidAsync("yasDownloadFile", $"store-{_key}-{DateTime.Now:yyyyMMdd-HHmm}.csv", "text/csv;charset=utf-8", bytes);
        }
        finally { _exporting = false; }
    }
}
