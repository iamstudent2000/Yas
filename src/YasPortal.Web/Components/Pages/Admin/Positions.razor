@page "/admin/positions"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Rendering
@using YasPortal.Domain.Organization
@using YasPortal.Domain.Workflows
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Services
@using YasPortal.Web.Components.Shared
@attribute [Authorize(Policy = "Admin.Positions")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AdminQueryService AdminQueries
@inject AppState AppState
@inject ReportExportService Reports

<PageTitle>سمت‌ها - یاس پورتال</PageTitle>

<div dir="rtl" class="positions-page admin-page">
    <div class="page-header">
        <div>
            <div class="page-kicker">مدیریت سامانه / سمت‌ها</div>
            <h1 class="page-title">ساختار و تخصیص سمت‌ها</h1>
            <p class="page-subtitle">ساختار سمت‌ها درختی است؛ برای تعداد زیاد سمت‌ها شاخه‌ها را باز و بسته کنید.</p>
        </div>
        <div class="form-actions">
            <a class="btn btn-secondary" href="/admin/users"><i class="bx bx-group"></i> کاربران</a>
            <a class="btn btn-secondary" href="/dashboard"><i class="bx bx-arrow-back"></i> داشبورد</a>
        </div>
    </div>

    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-icon"><i class="bx bx-sitemap"></i></div><span class="stat-label">کل سمت‌ها</span><strong
            class="stat-value">@_positions.Count</strong>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="bx bx-user-check"></i></div><span class="stat-label">دارای
            کارمند</span><strong class="stat-value">@_positions.Count(x => x.IsOccupied)</strong>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="bx bx-briefcase"></i></div><span class="stat-label">سمت آزاد</span><strong
            class="stat-value">@_positions.Count(x => !x.IsOccupied)</strong>
        </div>
    </div>

        <section class="card admin-form-row position-form-row">
        <div class="admin-form-row-head">
            <h2 class="section-title"><i class="bx @(_editingId is null ? "bx-plus-circle" : "bx-edit-alt")"></i> @(_editingId is null ? "ایجاد سمت" : "ویرایش سمت")</h2>
            <p class="muted">بدون بالادست = سمت ریشه. سمت زیرمجموعه باید در همان سازمان سمت بالادست باشد؛ سمت ریشه می‌تواند سازمان نداشته باشد.</p>
        </div>
        <div class="admin-row-grid">
            <div class="form-field"><label class="form-label">کد سمت</label><input class="form-control" @bind="_code" maxlength="50" placeholder="مثلاً POS-006" /></div>
            <div class="form-field"><label class="form-label">نام سمت</label><input class="form-control" @bind="_name" maxlength="200" placeholder="مثلاً مدیر واحد" /></div>
            <div class="form-field"><label class="form-label">سمت بالادست</label>
                <ServerSearchableGuidSelect Value="@_parentPositionId" ValueChanged="ParentChanged"
                                            SearchAsync="SearchParentPositionsAsync" SelectedText="@_parentPositionName"
                                            Placeholder="ریشه / انتخاب بالادست..." SearchPlaceholder="نام سمت بالادست را جستجو کنید..." /></div>
            <div class="form-field"><label class="form-label">سازمان (دپارتمان)</label>
                <ServerSearchableGuidSelect Value="@_organizationId" ValueChanged="OrganizationChanged" SearchAsync="SearchOrganizationsAsync"
                                            SelectedText="@_organizationName" Placeholder="بدون سازمان" SearchPlaceholder="نام سازمان..." /></div>
            <div class="form-field admin-row-submit">
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="Save"><i class="bx bx-save"></i> @(_editingId is null ? "ایجاد سمت" : "ذخیره")</button>
                    @if (_editingId is not null)
                    {
                        <button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button>
                    }
                </div>
            </div>
        </div>
        @if (_blockers.Count > 0)
                                        {
                                            <div class="blocker-panel">
                                                <strong>@_blockerTitle</strong>
                                                <p class="muted">تا زمانی که این درخواست‌ها بسته یا به نتیجه نرسند، تغییر انجام نمی‌شود. در «درخواست‌های فعال» می‌توانید آن‌ها را به‌صورت اجباری ببندید.</p>
                                                <ul>
                                                    @foreach (var b in _blockers.Take(20))
                                                    {
                                                        <li><span dir="ltr">#@b.ShortId</span> — @WorkflowFieldCatalog.GetDisplayName(b.Type) — @b.Reason</li>
                                                    }
                                                </ul>
                                                @if (_blockers.Count > 20)
                                                {
                                                    <p class="muted">و @(_blockers.Count - 20) مورد دیگر…</p>
                                                }
                                                <a class="btn btn-secondary btn-sm" href="/admin/active-requests"><i class="bx bx-error-circle"></i> رفتن به درخواست‌های فعال</a>
                                            </div>
                                        }
        <div class="rules-mini">
                                            <div><i class="bx bx-check"></i><span>هر سمت فقط یک بالادست دارد.</span></div>
                                            <div><i class="bx bx-check"></i><span>هر سمت می‌تواند چند زیرسمت داشته باشد.</span></div>
                                            <div><i class="bx bx-check"></i><span>هر سمت فقط یک کارمند فعال دارد.</span></div>
                                            <div><i class="bx bx-check"></i><span>تخصیص و آزادسازی فقط از همین صفحه است.</span></div>
                                        </div>
    </section>

    <ListFilterBar Busy="_loading" ActiveCount="@((_treeSearch.Trim().Length > 0 ? 1 : 0) + (_occupancyFilter != "" ? 1 : 0) + (_activeFilter != "" ? 1 : 0) + (_organizationFilterId is null ? 0 : 1))"
                   CanClear="@(HasTreeFilter || _draftTreeSearch != "" || _draftOccupancy != "" || _draftActive != "" || _draftOrganizationId is not null)"
                   OnSearch="SearchTreeFilters" OnClear="ClearTreeFilters" ExportPermission="@(ReportPermissions.Positions)" OnExport="ExportAsync">
        <div class="admin-filter"><label class="form-label">جستجو</label>
            <input class="form-control" placeholder="نام یا کد سمت..." @bind="_draftTreeSearch" @bind:event="oninput" /></div>
        <div class="admin-filter"><label class="form-label">اشغال سمت</label>
            <LookupSelect Options="_occupancyOptions" Value="@(_draftOccupancy == "" ? null : _draftOccupancy)" ValueChanged="k => _draftOccupancy = k ?? string.Empty" Placeholder="همه سمت‌ها" /></div>
        <div class="admin-filter"><label class="form-label">وضعیت</label>
            <LookupSelect Options="_activeOptions" Value="@(_draftActive == "" ? null : _draftActive)" ValueChanged="k => _draftActive = k ?? string.Empty" Placeholder="فعال و غیرفعال" /></div>
        <div class="admin-filter"><label class="form-label">سازمان</label>
            <ServerSearchableGuidSelect @key="_treeResetKey" Value="_draftOrganizationId" ValueChanged="id => { _draftOrganizationId = id; return Task.CompletedTask; }" SearchAsync="SearchOrganizationsAsync"
                                        SelectedText="@_organizationFilterName" Placeholder="همه سازمان‌ها" SearchPlaceholder="نام سازمان..." /></div>
    </ListFilterBar>

    <div class="positions-layout">
        <section class="card position-tree-card-wrap">
            <div class="card-toolbar positions-tree-toolbar">
                <div>
                    <h2 class="section-title"><i class="bx bx-sitemap"></i> درخت سمت‌ها</h2>
                    <p class="muted">روی نام سمت برای مدیریت تخصیص کلیک کنید. دکمه‌های <strong>+</strong> و
                        <strong>−</strong> شاخه‌ها را باز و بسته می‌کنند.</p>
                    </div>
                    <div class="toolbar-tools">
                    <div class="tree-toolbar-actions">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="ExpandAll"><i
                            class="bx bx-chevrons-down"></i> باز کردن همه</button>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="CollapseAll"><i
                                class="bx bx-chevrons-up"></i> بستن همه</button>
                                </div>
                                </div>
                            </div>

                            @if (_loading)
                            {
                                <LoadingState />
                            }
                            else if (_positions.Count == 0)
                            {
                                <div class="empty-state"><i class="bx bx-sitemap empty-icon"></i><strong>سمتی ثبت نشده
                                    است</strong><span>اولین سمت ریشه را ایجاد کنید.</span></div>
                                }
            else
                                {
                                    <div class="tree-summary">
                                        @if (_visiblePositionIds is not null)
                                        {
                                            <span><i class="bx bx-search"></i> @_treeMatchCount نتیجه از @_positions.Count سمت</span>
                                        }
                                        else
                                        {
                                            <span><i class="bx bx-sitemap"></i> @_positions.Count سمت</span>
                                            <span><i class="bx bx-git-branch"></i> @Roots.Count() سمت ریشه</span>
                                            <span><i class="bx bx-layer"></i> شاخه‌های باز: @_positions.Count(x => !_collapsedNodeIds.Contains(x.Id)
                                                                    && HasChildren(x.Id))</span>
                                        }
                                        </div>
                                        @if (_visiblePositionIds is not null && _visiblePositionIds.Count == 0)
                                        {
                                            <div class="empty-state"><i class="bx bx-search-alt empty-icon"></i><strong>نتیجه‌ای پیدا نشد</strong><span>نام سمت دیگری را جستجو کنید.</span></div>
                                        }
                                        else
                                        {
                                            <div class="position-tree" role="tree" aria-label="درخت سمت‌ها">
                                                @foreach (var root in Roots)
                                                {
                                                    @RenderNode(root, 0)
                                                }
                                            </div>
                                        }
                                    }
                                </section>

                                </div>

                                @if (_selectedPositionId is Guid selectedPositionId)
                                {
                                    <PositionAssignmentHistoryPanel PositionId="selectedPositionId" />
                                }
                            </div>

@code {
    private List<PositionRow> _positions = [];
    private readonly HashSet<Guid> _collapsedNodeIds = [];
    private string _treeSearch = "";
    private string _occupancyFilter = "";
    private string _activeFilter = "";
    private Guid? _organizationFilterId;
    private string? _organizationFilterName;
    private Guid? _organizationId;
    private string? _organizationName;
    private List<PositionChangeGuard.Blocker> _blockers = [];
    private string? _blockerTitle;
    private HashSet<Guid>? _visiblePositionIds;
    private int _treeMatchCount;
    private Guid? _editingId, _parentPositionId, _selectedPositionId, _employeeToAssign, _assigningPositionId, _confirmingReassignPositionId;
    private string _code = "", _name = "", _parentPositionName = "", _employeeToAssignName = "";
    private string? _selectedPositionEmployeeName;
    private bool _loading, _savingAssignment, _treeInitialized;

    private IEnumerable<PositionRow> Roots => _positions.Where(x => x.ParentPositionId is null
        && (_visiblePositionIds is null || _visiblePositionIds.Contains(x.Id))).OrderBy(x => x.Name);

    private void TreeSearchChanged()
    {
        _assigningPositionId = null;
        var q = _treeSearch.Trim();
        if (q.Length == 0 && _occupancyFilter == "" && _activeFilter == "" && _organizationFilterId is null) { _visiblePositionIds = null; _treeMatchCount = 0; return; }

        // Text search (name/code) and the occupied/vacant filter combine; ancestors of every match stay visible so the tree keeps its shape.
        var matches = _positions
            .Where(x => q.Length == 0 || x.Name.Contains(q, StringComparison.OrdinalIgnoreCase) || x.Code.Contains(q, StringComparison.OrdinalIgnoreCase))
            .Where(x => _occupancyFilter == "" || (_occupancyFilter == "vacant" ? !x.IsOccupied : x.IsOccupied))
            .Where(x => _activeFilter == "" || (_activeFilter == "inactive" ? !x.IsActive : x.IsActive))
            .Where(x => _organizationFilterId is null || x.OrganizationId == _organizationFilterId)
            .Select(x => x.Id).ToHashSet();
        _treeMatchCount = matches.Count;

        var visible = new HashSet<Guid>(matches);
        var byId = _positions.ToDictionary(x => x.Id);
        foreach (var matchId in matches)
        {
            var current = byId[matchId];
            while (current.ParentPositionId is Guid parentId && visible.Add(parentId))
                current = byId[parentId];
        }
        _visiblePositionIds = visible;
    }

    /// <summary>
    /// Exports the positions the last search matched (everything when nothing is filtered), in tree order,
    /// with the full path so the hierarchy survives in a flat file.
    /// </summary>
    private async Task ExportAsync()
    {
        var byId = _positions.ToDictionary(x => x.Id);
        var children = _positions.Where(x => x.ParentPositionId is Guid p && byId.ContainsKey(p)).GroupBy(x => x.ParentPositionId!.Value).ToDictionary(g => g.Key, g => g.OrderBy(x => x.Name).ToList());
        var roots = _positions.Where(x => x.ParentPositionId is not Guid p || !byId.ContainsKey(p)).OrderBy(x => x.Name).ToList();
        var matches = _positions.Where(PositionMatchesFilter).Select(x => x.Id).ToHashSet();
        var rows = new List<IReadOnlyList<string>>();

        void Walk(PositionRow node, string path, int level)
        {
            var here = path.Length == 0 ? node.Name : path + " / " + node.Name;
            if (matches.Contains(node.Id))
                rows.Add([node.Code, node.Name, node.ParentPositionId is Guid pid && byId.TryGetValue(pid, out var parent) ? parent.Name : "", here, WorkflowDisplay.ToPersianDigits(level.ToString()),
                    node.OrganizationName ?? "", node.EmployeeName ?? "خالی", node.IsActive ? "فعال" : "غیرفعال"]);
            if (children.TryGetValue(node.Id, out var kids))
                foreach (var kid in kids)
                    Walk(kid, here, level + 1);
        }

        foreach (var root in roots)
            Walk(root, "", 1);
        await Reports.ExportRowsAsync(ReportPermissions.Positions, "positions", ["کد", "نام سمت", "سمت والد", "مسیر", "سطح", "سازمان", "متصدی فعلی", "وضعیت"], rows);
    }

    private bool PositionMatchesFilter(PositionRow x)
    {
        var q = _treeSearch.Trim();
        return (q.Length == 0 || x.Name.Contains(q, StringComparison.OrdinalIgnoreCase) || x.Code.Contains(q, StringComparison.OrdinalIgnoreCase))
            && (_occupancyFilter == "" || (_occupancyFilter == "vacant" ? !x.IsOccupied : x.IsOccupied))
            && (_activeFilter == "" || (_activeFilter == "inactive" ? !x.IsActive : x.IsActive))
            && (_organizationFilterId is null || x.OrganizationId == _organizationFilterId);
    }

    private static readonly IReadOnlyList<(string Key, string Text)> _occupancyOptions = [("occupied", "دارای متصدی"), ("vacant", "خالی")];
    private static readonly IReadOnlyList<(string Key, string Text)> _activeOptions = [("active", "فعال"), ("inactive", "غیرفعال")];

    private Task OrganizationChanged(Guid? id)
    {
        _organizationId = id;
        _organizationName = id is null ? null : _organizationName;
        return Task.CompletedTask;
    }

    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchOrganizationsAsync(string search, CancellationToken ct) =>
        AdminQueries.SearchOrganizationsAsync(search, true, ct);

    // The boxes edit the draft; "جستجو" copies it into the applied filters that TreeSearchChanged reads.
    private string _draftTreeSearch = "", _draftOccupancy = "", _draftActive = "";
    private Guid? _draftOrganizationId;
    private int _treeResetKey;
    private bool HasTreeFilter => _treeSearch.Trim().Length > 0 || _occupancyFilter != "" || _activeFilter != "" || _organizationFilterId is not null;

    private void SearchTreeFilters()
    {
        _treeSearch = _draftTreeSearch.Trim();
        _occupancyFilter = _draftOccupancy;
        _activeFilter = _draftActive;
        _organizationFilterId = _draftOrganizationId;
        TreeSearchChanged();
    }

    private void ClearTreeFilters()
    {
        _treeSearch = _draftTreeSearch = "";
        _occupancyFilter = _draftOccupancy = "";
        _activeFilter = _draftActive = "";
        _organizationFilterId = _draftOrganizationId = null;
        _organizationFilterName = null;
        _treeResetKey++;
        TreeSearchChanged();
    }

    private void ClearTreeSearch()
    {
        _treeSearch = _draftTreeSearch = "";
        TreeSearchChanged();
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _positions = await db.Positions.AsNoTracking().OrderBy(x => x.Name).Select(x => new PositionRow(
                x.Id,
                x.Code,
                x.Name,
                x.ParentPositionId,
                db.EmployeePositions.Where(ep => ep.PositionId == x.Id && ep.EndedAt == null).Select(ep =>
(string?)ep.Employee.FullName).FirstOrDefault(),
                x.IsActive,
                x.OrganizationId,
                db.Organizations.Where(o => o.Id == x.OrganizationId).Select(o => (string?)o.Name).FirstOrDefault()
            )).ToListAsync();

            if (!_treeInitialized)
            {
                CollapseAll();
                _treeInitialized = true;
            }
            else
            {
                _collapsedNodeIds.RemoveWhere(id => !_positions.Any(x => x.Id == id));
            }

            if (_treeSearch.Trim().Length > 0 || _occupancyFilter != "" || _activeFilter != "" || _organizationFilterId is not null)
                TreeSearchChanged();

            if (_selectedPositionId is Guid selected)
                await LoadSelectedAssignmentAsync(selected);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadSelectedAssignmentAsync(Guid positionId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _selectedPositionEmployeeName = await db.EmployeePositions.AsNoTracking()
            .Where(x => x.PositionId == positionId && x.EndedAt == null)
            .Select(x => (string?)x.Employee.FullName)
            .FirstOrDefaultAsync();
    }

    private bool HasChildren(Guid positionId) => _positions.Any(x => x.ParentPositionId == positionId);
    private bool IsExpanded(Guid positionId) => !_collapsedNodeIds.Contains(positionId);

    private void ToggleNode(Guid positionId)
    {
        _assigningPositionId = null;
        if (!_collapsedNodeIds.Add(positionId))
            _collapsedNodeIds.Remove(positionId);
    }

    private void ExpandAll() { ClearTreeSearch(); _collapsedNodeIds.Clear(); }

    private void CollapseAll()
    {
        ClearTreeSearch();
        _collapsedNodeIds.Clear();
        foreach (var position in _positions.Where(x => HasChildren(x.Id)))
            _collapsedNodeIds.Add(position.Id);
    }

    private void BeginCreateChild(Guid parentId)
    {
        _assigningPositionId = null;
        _editingId = null;
        _code = "";
        _name = "";
        _parentPositionId = parentId;
        _parentPositionName = _positions.FirstOrDefault(x => x.Id == parentId)?.Name ?? "";
        _organizationId = _positions.FirstOrDefault(x => x.Id == parentId)?.OrganizationId;
        _organizationName = _positions.FirstOrDefault(x => x.Id == parentId)?.OrganizationName;
        _collapsedNodeIds.Remove(parentId);
    }

    private void Edit(Guid id)
    {
        _assigningPositionId = null;
        var p = _positions.Single(x => x.Id == id);
        _editingId = id;
        _code = p.Code;
        _name = p.Name;
        _parentPositionId = p.ParentPositionId;
        _parentPositionName = p.ParentPositionId is Guid parent ? _positions.FirstOrDefault(x => x.Id == parent)?.Name ?? "" :
"";
        _organizationId = p.OrganizationId;
        _organizationName = p.OrganizationName;
        _blockers = [];
    }

    private void CancelEdit()
    {
        _editingId = null;
        _code = "";
        _name = "";
        _parentPositionId = null;
        _parentPositionName = "";
        _organizationId = null;
        _organizationName = null;
        _blockers = [];
    }

    private Task ParentChanged(Guid? id)
    {
        _parentPositionId = id;
        _parentPositionName = id is Guid value ? _positions.FirstOrDefault(x => x.Id == value)?.Name ?? "" : "";
        return Task.CompletedTask;
    }

    private Task EmployeeChanged(Guid? id)
    {
        _employeeToAssign = id;
        _employeeToAssignName = "";
        _confirmingReassignPositionId = null;
        return Task.CompletedTask;
    }

    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchParentPositionsAsync(string search, CancellationToken
ct) => AdminQueries.SearchPositionsAsync(search, null, _editingId, ct);
    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchAssignableEmployeesAsync(string search,
CancellationToken ct) => AdminQueries.SearchAssignableEmployeesAsync(search, ct);

    private async Task Save()
    {
        var code = _code.Trim();
        if (string.IsNullOrWhiteSpace(code))
        {
            AppState.AddToast("کد سمت الزامی است.", ToastLevel.Error);
            return;
        }

        var name = _name.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            AppState.AddToast("نام سمت الزامی است.", ToastLevel.Error);
            return;
        }

        if (_editingId is Guid id && _parentPositionId == id)
        {
            AppState.AddToast("یک سمت نمی‌تواند بالادست خودش باشد.", ToastLevel.Error);
            return;
        }

        if (_editingId is Guid editing && _parentPositionId is Guid parent && IsDescendantOf(parent, editing))
        {
            AppState.AddToast("یک سمت نمی‌تواند زیرمجموعه یکی از فرزندان خودش قرار بگیرد.", ToastLevel.Error);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Positions.AnyAsync(x => x.Code == code && x.Id != (_editingId ?? Guid.Empty)))
        {
            AppState.AddToast("سمتی با این کد قبلاً ثبت شده است.", ToastLevel.Error);
            return;
        }
        if (await db.Positions.AnyAsync(x => x.Name == name && x.Id != (_editingId ?? Guid.Empty)))
        {
            AppState.AddToast("سمتی با این نام قبلاً ثبت شده است.", ToastLevel.Error);
            return;
        }

        // §3.2: a position sits in the same department (organization) as its parent.
        if (_parentPositionId is Guid parentId)
        {
            var parentOrg = _positions.FirstOrDefault(x => x.Id == parentId)?.OrganizationId;
            if (parentOrg is not null && parentOrg != _organizationId)
            {
                AppState.AddToast("سمت باید در همان سازمان سمت بالادست خود باشد.", ToastLevel.Error);
                return;
            }
        }

        _blockers = [];
        if (_editingId is Guid eid)
        {
            var p = await db.Positions.SingleAsync(x => x.Id == eid);

            // §19: moving a position moves its whole branch, so every active request touching it must be resolved first.
            if (p.ParentPositionId != _parentPositionId)
            {
                var branch = await PositionChangeGuard.SubtreeAsync(db, eid);
                var blockers = await PositionChangeGuard.ActiveRequestsTouchingAsync(db, branch);
                if (blockers.Count > 0)
                {
                    _blockers = blockers.ToList();
                    _blockerTitle = "تغییر بالادست این سمت به‌دلیل درخواست‌های فعال زیر ممکن نیست:";
                    AppState.AddToast("سمت دارای درخواست فعال است و تا رسیدگی به آن‌ها ساختار قابل تغییر نیست.", ToastLevel.Error);
                    return;
                }
            }

            p.ChangeCode(code);
            p.Rename(name);
            p.ChangeParent(_parentPositionId);
            p.ChangeOrganization(_organizationId);
            AppState.AddToast("سمت و ساختار آن ویرایش شد.", ToastLevel.Success);
        }
        else
        {
            var created = new Position(code, name, _parentPositionId);
            created.ChangeOrganization(_organizationId);
            db.Positions.Add(created);
            AppState.AddToast("سمت جدید ایجاد شد.", ToastLevel.Success);
        }

        await db.SaveChangesAsync();
        CancelEdit();
        await LoadAsync();
    }

    private async Task SelectPosition(Guid id)
    {
        _assigningPositionId = null;
        _selectedPositionId = id;
        _employeeToAssign = null;
        _employeeToAssignName = "";
        await LoadSelectedAssignmentAsync(id);
    }

    private void ClearSelection()
    {
        _selectedPositionId = null;
        _employeeToAssign = null;
        _employeeToAssignName = "";
        _selectedPositionEmployeeName = null;
    }

    private void ToggleAssigning(Guid positionId)
    {
        if (_assigningPositionId == positionId)
        {
            _assigningPositionId = null;
        }
        else
        {
            _assigningPositionId = positionId;
            _employeeToAssign = null;
            _employeeToAssignName = "";
        }
        _confirmingReassignPositionId = null;
    }

    private void RequestReplaceConfirmation(Guid positionId)
    {
        if (_employeeToAssign is null || _savingAssignment)
            return;
        _confirmingReassignPositionId = positionId;
    }

    private async Task ReassignEmployeeAsync(Guid positionId)
    {
        if (_positions.FirstOrDefault(x => x.Id == positionId)?.IsActive == false)
        {
            AppState.AddToast("سمت غیرفعال قابل تخصیص نیست.", ToastLevel.Error);
            return;
        }

        if (_employeeToAssign is not Guid employeeId || _savingAssignment)
            return;

        _savingAssignment = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var employee = await db.Employees.SingleAsync(x => x.Id == employeeId);
            if (!employee.IsActive || employee.IsAdmin)
            {
                AppState.AddToast("فقط کارمند فعال قابل تخصیص به سمت است.", ToastLevel.Error);
                return;
            }

            var current = await db.EmployeePositions.SingleOrDefaultAsync(x => x.PositionId == positionId && x.EndedAt == null);
            if (current is not null)
            {
                if (current.EmployeeId == employeeId)
                {
                    AppState.AddToast("این سمت هم‌اکنون به همین کارمند تخصیص دارد.", ToastLevel.Error);
                    return;
                }

                var previousEmployee = await db.Employees.SingleAsync(x => x.Id == current.EmployeeId);
                if (previousEmployee.LastActivePositionId == positionId)
                    previousEmployee.SetLastActivePosition(null);
                current.End();
            }

            var link = await db.EmployeePositions.SingleOrDefaultAsync(x => x.EmployeeId == employeeId && x.PositionId == positionId);
            if (link is null)
                db.EmployeePositions.Add(new EmployeePosition(employeeId, positionId));
            else
                link.Reactivate();

            employee.SetLastActivePosition(positionId);

            try
            {
                await db.SaveChangesAsync();
                AppState.AddToast(current is null ? "کارمند به سمت تخصیص یافت." : "تخصیص سمت جابه‌جا شد.", ToastLevel.Success);
            }
            catch (DbUpdateException)
            {
                AppState.AddToast("این سمت هم‌زمان توسط کارمند دیگری تخصیص داده شد.", ToastLevel.Error);
            }

            _assigningPositionId = null;
            _confirmingReassignPositionId = null;
            _employeeToAssign = null;
            _employeeToAssignName = "";
            await LoadAsync();
        }
        finally
        {
            _savingAssignment = false;
        }
    }

    private async Task FreePosition(Guid positionId)
    {
        if (_savingAssignment)
            return;

        _savingAssignment = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var assignment = await db.EmployeePositions.SingleOrDefaultAsync(x => x.PositionId == positionId && x.EndedAt == null);
            if (assignment is null)
            {
                AppState.AddToast("این سمت در حال حاضر آزاد است.", ToastLevel.Error);
                return;
            }

            var employee = await db.Employees.SingleAsync(x => x.Id == assignment.EmployeeId);
            if (employee.LastActivePositionId == positionId)
                employee.SetLastActivePosition(null);

            assignment.End();
            await db.SaveChangesAsync();
            AppState.AddToast("سمت آزاد شد و اکنون قابل تخصیص است.", ToastLevel.Success);
            await LoadAsync();
        }
        finally
        {
            _savingAssignment = false;
        }
    }

    /// <summary>
    /// Deactivation (spec §3.3, §19, §26.3): refused while the position still has an occupant, is a fixed
    /// approver in a workflow, or any active request is waiting on it or was submitted from it. The blockers
    /// are listed so the admin can resolve them (§22.2). Child positions are not affected.
    /// </summary>
    private async Task DeactivateAsync(Guid id)
    {
        _blockers = [];
        await using var db = await DbFactory.CreateDbContextAsync();
        var position = await db.Positions.SingleOrDefaultAsync(x => x.Id == id);
        if (position is null || !position.IsActive)
        {
            await LoadAsync();
            return;
        }

        if (await db.EmployeePositions.AnyAsync(x => x.PositionId == id && x.EndedAt == null))
        {
            AppState.AddToast("سمت دارای متصدی است؛ ابتدا با «آزاد» تخصیص فعلی را پایان دهید.", ToastLevel.Error);
            return;
        }

        var steps = await PositionChangeGuard.WorkflowStepsUsingAsync(db, id);
        if (steps.Count > 0)
        {
            AppState.AddToast("این سمت در گردش‌کار استفاده شده است: " + string.Join("، ", steps) + ". ابتدا گردش‌کار را اصلاح کنید.", ToastLevel.Error);
            return;
        }

        var blockers = await PositionChangeGuard.ActiveRequestsTouchingAsync(db, [id]);
        if (blockers.Count > 0)
        {
            _blockers = blockers.ToList();
            _blockerTitle = "غیرفعال‌سازی این سمت به‌دلیل درخواست‌های فعال زیر ممکن نیست:";
            AppState.AddToast("سمت دارای درخواست فعال است و باید ابتدا به آن‌ها رسیدگی شود.", ToastLevel.Error);
            return;
        }

        position.Deactivate();
        await db.SaveChangesAsync();
        AppState.AddToast("سمت غیرفعال شد.", ToastLevel.Success);
        await LoadAsync();
    }

    private async Task ActivateAsync(Guid id)
    {
        _blockers = [];
        await using var db = await DbFactory.CreateDbContextAsync();
        var position = await db.Positions.SingleOrDefaultAsync(x => x.Id == id);
        if (position is null || position.IsActive)
        {
            await LoadAsync();
            return;
        }

        position.Activate();
        await db.SaveChangesAsync();
        AppState.AddToast("سمت فعال شد.", ToastLevel.Success);
        await LoadAsync();
    }

    private async Task Delete(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Positions.AnyAsync(x => x.ParentPositionId == id))
        {
            AppState.AddToast("سمتی که زیرمجموعه دارد قابل حذف نیست.", ToastLevel.Error);
            return;
        }

        // §3.4: a position that was ever used is never deleted — it can only be deactivated.
        if (await PositionChangeGuard.HistoricalUsageAsync(db, id) is string usage)
        {
            AppState.AddToast($"این سمت دارای سابقه ({usage}) است و قابل حذف نیست؛ فقط می‌توان آن را غیرفعال کرد.", ToastLevel.Error);
            return;
        }

        var p = await db.Positions.SingleAsync(x => x.Id == id);
        db.Positions.Remove(p);
        await db.SaveChangesAsync();
        AppState.AddToast("سمت حذف شد.", ToastLevel.Success);
        if (_selectedPositionId == id)
            ClearSelection();
        await LoadAsync();
    }

    private bool IsDescendantOf(Guid candidateId, Guid ancestorId)
    {
        var current = _positions.FirstOrDefault(x => x.Id == candidateId);
        while (current?.ParentPositionId is Guid parentId)
        {
            if (parentId == ancestorId)
                return true;
            current = _positions.FirstOrDefault(x => x.Id == parentId);
        }
        return false;
    }

    private RenderFragment RenderNode(PositionRow position, int depth) => builder =>
    {
        var children = _positions.Where(x => x.ParentPositionId == position.Id
            && (_visiblePositionIds is null || _visiblePositionIds.Contains(x.Id))).OrderBy(x => x.Name).ToList();
        var hasChildren = children.Count > 0;
        var expanded = _visiblePositionIds is not null ? true : IsExpanded(position.Id);
        var s = 0;

        builder.OpenElement(s++, "div");
        builder.AddAttribute(s++, "class", "tree-node");
        builder.AddAttribute(s++, "role", "treeitem");
        if (hasChildren)
            builder.AddAttribute(s++, "aria-expanded", expanded);

        builder.OpenElement(s++, "div");
        builder.AddAttribute(s++, "class", _selectedPositionId == position.Id ? "tree-item selected" : "tree-item");
        builder.AddAttribute(s++, "style", $"--depth:{depth};");

        if (hasChildren)
        {
            builder.OpenElement(s++, "button");
            builder.AddAttribute(s++, "class", "tree-toggle");
            builder.AddAttribute(s++, "type", "button");
            builder.AddAttribute(s++, "title", expanded ? "بستن شاخه" : "باز کردن شاخه");
            builder.AddAttribute(s++, "aria-label", expanded ? $"بستن {position.Name}" : $"باز کردن {position.Name}");
            builder.AddAttribute(s++, "onclick", EventCallback.Factory.Create(this, () => ToggleNode(position.Id)));
            builder.OpenElement(s++, "i");
            builder.AddAttribute(s++, "class", expanded ? "bx bx-minus" : "bx bx-plus");
            builder.CloseElement();
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(s++, "span");
            builder.AddAttribute(s++, "class", "tree-toggle-placeholder");
            builder.CloseElement();
        }

        builder.OpenElement(s++, "button");
        builder.AddAttribute(s++, "class", "tree-main");
        builder.AddAttribute(s++, "type", "button");
        builder.AddAttribute(s++, "title", "مدیریت تخصیص این سمت");
        builder.AddAttribute(s++, "onclick", EventCallback.Factory.Create(this, () => SelectPosition(position.Id)));

        builder.OpenElement(s++, "span");
        builder.AddAttribute(s++, "class", position.IsOccupied ? "tree-icon occupied" : "tree-icon free");
        builder.OpenElement(s++, "i");
        builder.AddAttribute(s++, "class", position.IsOccupied ? "bx bx-user" : "bx bx-briefcase");
        builder.CloseElement();
        builder.CloseElement();

        builder.OpenElement(s++, "span");
        builder.AddAttribute(s++, "class", "tree-text");
        builder.OpenElement(s++, "strong");
        builder.AddAttribute(s++, "title", position.Name);
        builder.AddContent(s++, $"{position.Name} ");
        builder.OpenElement(s++, "small");
        builder.AddAttribute(s++, "class", "badge badge-muted");
        builder.AddContent(s++, position.Code);
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(s++, "small");
        builder.AddContent(s++, position.IsOccupied ? $"کارمند: {position.EmployeeName}" : "سمت آزاد");
        if (!position.IsActive)
            builder.AddContent(s++, " • غیرفعال");
        if (!string.IsNullOrWhiteSpace(position.OrganizationName))
            builder.AddContent(s++, $" • {position.OrganizationName}");
        if (hasChildren)
            builder.AddContent(s++, $" • {children.Count} زیرسمت");
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();

        builder.OpenElement(s++, "div");
        builder.AddAttribute(s++, "class", "tree-actions");
        AddButton(builder, ref s, "btn btn-secondary btn-sm", "bx bx-plus", "زیرسمت", () => BeginCreateChild(position.Id));
        AddButton(builder, ref s, "btn btn-secondary btn-sm", "bx bx-edit-alt", "ویرایش", () => Edit(position.Id));
        if (position.IsActive)
            AddButton(builder, ref s, "btn btn-primary btn-sm", position.IsOccupied ? "bx bx-transfer" : "bx bx-link",
                position.IsOccupied ? "تغییر کارمند" : "تخصیص کارمند", () => ToggleAssigning(position.Id));
        if (position.IsOccupied)
            AddAsyncButton(builder, ref s, "btn btn-danger btn-sm", "bx bx-unlink", "آزاد", () => FreePosition(position.Id));
        if (position.IsActive)
            AddAsyncButton(builder, ref s, "btn btn-secondary btn-sm", "bx bx-block", "غیرفعال‌سازی", () => DeactivateAsync(position.Id));
        else
            AddAsyncButton(builder, ref s, "btn btn-primary btn-sm", "bx bx-check-circle", "فعال‌سازی", () => ActivateAsync(position.Id));
        AddAsyncButton(builder, ref s, "btn btn-secondary btn-sm icon-only", "bx bx-trash", "حذف", () => Delete(position.Id));
        builder.CloseElement();
        builder.CloseElement();

        if (_assigningPositionId == position.Id)
        {
            builder.OpenElement(s++, "div");
            builder.AddAttribute(s++, "class", "tree-assign-inline");
            builder.OpenElement(s++, "span");
            builder.AddAttribute(s++, "class", "tree-assign-label");
            builder.AddContent(s++, position.IsOccupied
                ? $"کارمند جدید را برای جایگزینی «{position.EmployeeName}» انتخاب کنید:"
                : "کارمند مورد نظر را انتخاب کنید:");
            builder.CloseElement();
            builder.OpenComponent<ServerSearchableGuidSelect>(s++);
            builder.AddComponentParameter(s++, "Value", _employeeToAssign);
            builder.AddComponentParameter(s++, "ValueChanged", EventCallback.Factory.Create<Guid?>(this, EmployeeChanged));
            builder.AddComponentParameter(s++, "SearchAsync",
                (Func<string, CancellationToken, Task<IReadOnlyList<AdminQueryService.LookupItem>>>)SearchAssignableEmployeesAsync);
            builder.AddComponentParameter(s++, "SelectedText", _employeeToAssignName);
            builder.AddComponentParameter(s++, "Placeholder", "کارمند را جستجو کنید...");
            builder.AddComponentParameter(s++, "SearchPlaceholder", "نام یا نام کاربری را تایپ کنید...");
            builder.CloseComponent();
            if (position.IsOccupied && _confirmingReassignPositionId == position.Id)
            {
                builder.OpenElement(s++, "div");
                builder.AddAttribute(s++, "class", "tree-assign-replace-warning");
                builder.OpenElement(s++, "i");
                builder.AddAttribute(s++, "class", "bx bx-error");
                builder.CloseElement();
                builder.AddContent(s++, $"«{position.EmployeeName}» از این سمت خارج و کارمند جدید جایگزین می‌شود. مطمئن هستید؟");
                builder.CloseElement();
            }

            builder.OpenElement(s++, "div");
            builder.AddAttribute(s++, "class", "tree-assign-actions");
            if (position.IsOccupied && _confirmingReassignPositionId != position.Id)
            {
                AddButton(builder, ref s, "btn btn-primary btn-sm", "bx bx-check", "تایید جابه‌جایی",
                    () => RequestReplaceConfirmation(position.Id));
            }
            else
            {
                AddAsyncButton(builder, ref s, "btn btn-primary btn-sm", "bx bx-check",
                    position.IsOccupied ? "بله، جایگزین شود" : "تایید تخصیص", () => ReassignEmployeeAsync(position.Id));
            }
            AddButton(builder, ref s, "btn btn-secondary btn-sm", "bx bx-x", "انصراف", () => ToggleAssigning(position.Id));
            builder.CloseElement();
            builder.CloseElement();
        }

        if (hasChildren && expanded)
        {
            builder.OpenElement(s++, "div");
            builder.AddAttribute(s++, "class", "tree-children");
            foreach (var child in children)
                builder.AddContent(s++, RenderNode(child, depth + 1));
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private void AddButton(RenderTreeBuilder builder, ref int seq, string css, string icon, string text, Action action)
    {
        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "class", css);
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "title", text);
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, action));
        builder.OpenElement(seq++, "i");
        builder.AddAttribute(seq++, "class", icon);
        builder.CloseElement();
        if (text != "حذف")
            builder.AddContent(seq++, " " + text);
        builder.CloseElement();
    }

    private void AddAsyncButton(RenderTreeBuilder builder, ref int seq, string css, string icon, string text, Func<Task>
action)
    {
        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "class", css);
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "title", text);
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, action));
        builder.OpenElement(seq++, "i");
        builder.AddAttribute(seq++, "class", icon);
        builder.CloseElement();
        if (text != "حذف")
            builder.AddContent(seq++, " " + text);
        builder.CloseElement();
    }

    private sealed record PositionRow(Guid Id, string Code, string Name, Guid? ParentPositionId, string? EmployeeName, bool IsActive, Guid? OrganizationId, string? OrganizationName)
    {
        public bool IsOccupied => !string.IsNullOrWhiteSpace(EmployeeName);
    }
}

