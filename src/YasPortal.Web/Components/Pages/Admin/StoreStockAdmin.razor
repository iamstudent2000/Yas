@page "/admin/store/stock"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Authorization
@using YasPortal.Domain.Store
@using YasPortal.Infrastructure.Store
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize(Policy = Perm.StoreStockView)]
@inject StoreService Store
@inject IPermissionChecker PermissionChecker
@inject AuthenticationStateProvider AuthState
@inject AppState AppState
@inject IJSRuntime JS

<PageTitle>انبار فروشگاه - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <StoreAdminTabs />
    <div class="page-header">
        <div>
            <div class="page-kicker">فروشگاه</div>
            <h1 class="page-title"><i class="ti @Icons.Store"></i> انبار فروشگاه</h1>
            <p class="page-subtitle">@(_canManage ? "" : "فقط خواندنی. ")موجودی هر کالا مجموع گردش‌های ثبت‌شده آن است. گردش ثبت‌شده ویرایش یا حذف نمی‌شود؛ اشتباه با یک «اصلاح موجودی» جبران می‌شود.</p>
        </div>
        <div class="form-actions">
            <button type="button" class="btn btn-secondary" onclick="window.print()"><i class="ti @Icons.Print"></i> چاپ</button>
        </div>
    </div>

    @if (_loading)
    {
        <LoadingState />
    }
    else
    {
        <div class="admin-stack">
            @if (_canManage)
            {
                <section class="card admin-form-row no-print">
                    <div class="admin-form-row-head">
                        <h2 class="section-title"><i class="ti @Icons.Add"></i> ثبت گردش انبار</h2>
                        <p class="muted">ورود، خروج و برگشت: مقدار مثبت. اصلاح موجودی: مقدار با علامت (منفی = کم می‌کند). خروج بیش از موجودی ممکن نیست.</p>
                    </div>
                    <div class="admin-row-grid">
                        <div class="form-field is-grow"><label class="form-label">کالا</label>
                            <LookupSelect @key="_formKey" Options="ItemOptions" Value="@(_formItemId?.ToString())" ValueChanged="SetFormItem" Placeholder="انتخاب کالا" SearchPlaceholder="نام یا کد کالا..." /></div>
                        <div class="form-field"><label class="form-label">نوع</label>
                            <LookupSelect @key="_formKey" Options="KindOptions" Value="@(((int)_formKind).ToString())" ValueChanged="SetFormKind" /></div>
                        <div class="form-field"><label class="form-label">مقدار</label><input class="form-control" inputmode="decimal" autocomplete="off" placeholder="۰" @bind="_formQuantity" @bind:event="oninput" @bind:after="ClearPreview" /></div>
                        <div class="form-field"><label class="form-label">مرجع (فاکتور، حواله...)</label><input class="form-control" @bind="_formReference" maxlength="@StoreStockMovement.ReferenceMax" /></div>
                        <div class="form-field is-grow"><label class="form-label">توضیح</label><input class="form-control" @bind="_formNote" maxlength="@StoreStockMovement.NoteMax" /></div>
                        <div class="form-field admin-row-submit"><div class="form-actions">
                            <button class="btn btn-primary" disabled="@(_busy || _preview is not null)" @onclick="PrepareAsync"><i class="ti @Icons.Save"></i> بررسی و ثبت</button>
                        </div></div>
                    </div>
                    @if (_preview is not null)
                    {
                        <div class="card" style="border-color:var(--accent,#155eef);margin-top:10px">
                            <p><strong>@_preview.ItemName</strong> — @StoreService.KindLabel(_formKind):
                                موجودی فعلی <strong>@WorkflowDisplay.ToPersianDigits(_preview.Current.ToString("0.###"))</strong>
                                ← بعد از ثبت <strong>@WorkflowDisplay.ToPersianDigits(_preview.After.ToString("0.###"))</strong> @_preview.Unit</p>
                            <div class="form-actions">
                                <button class="btn btn-primary" disabled="@_busy" @onclick="RecordAsync"><i class="ti @Icons.Save"></i> تأیید و ثبت</button>
                                <button class="btn btn-secondary" disabled="@_busy" @onclick="() => _preview = null">اصلاح</button>
                            </div>
                        </div>
                    }
                </section>
            }

            <div class="form-actions no-print">
                <button class="btn @(_tab == "levels" ? "btn-primary" : "btn-secondary")" @onclick='() => SwitchTabAsync("levels")'>موجودی کالاها</button>
                <button class="btn @(_tab == "moves" ? "btn-primary" : "btn-secondary")" @onclick='() => SwitchTabAsync("moves")'>گردش انبار</button>
            </div>

            @if (_tab == "levels")
            {
                <ListFilterBar Busy="_busy" ActiveCount="@((string.IsNullOrWhiteSpace(_search) ? 0 : 1) + (_categoryId is null ? 0 : 1) + (_stockFilter is null ? 0 : 1))"
                               CanClear="@(!string.IsNullOrWhiteSpace(_search) || _categoryId is not null || _stockFilter is not null || !string.IsNullOrWhiteSpace(_dSearch) || _dCategory is not null || _dStock is not null)"
                               OnSearch="ApplyLevelsAsync" OnClear="ClearLevelsAsync">
                    <div class="admin-filter"><label class="form-label">جستجو</label>
                        <input class="form-control" placeholder="نام یا کد..." @bind="_dSearch" @bind:event="oninput" /></div>
                    <div class="admin-filter"><label class="form-label">گروه</label>
                        <LookupSelect Options="CategoryOptions" Value="@_dCategory" ValueChanged="k => _dCategory = string.IsNullOrEmpty(k) ? null : k" Placeholder="همه گروه‌ها" /></div>
                    <div class="admin-filter"><label class="form-label">موجودی</label>
                        <LookupSelect Options="StockOptions" Value="@_dStock" ValueChanged="k => _dStock = string.IsNullOrEmpty(k) ? null : k" Placeholder="همه" /></div>
                </ListFilterBar>
                <section class="card">
                    <h2 class="section-title print-only">موجودی کالاهای فروشگاه</h2>
                    <div class="data-table-wrap">
                        <table class="data-table">
                            <thead><tr><th>کد</th><th>کالا</th><th>گروه</th><th>واحد</th><th>موجودی</th><th>وضعیت</th></tr></thead>
                            <tbody>
                                @foreach (var i in _levels.Rows)
                                {
                                    <tr>
                                        <td dir="ltr" style="text-align:right">@i.Code</td><td>@i.Name</td><td>@i.CategoryName</td><td>@i.Unit</td>
                                        <td><strong>@Num(i.Stock)</strong></td>
                                        <td>@if (i.Stock <= 0) {<span class="badge badge-danger">ناموجود</span>} else {<span class="badge badge-success">موجود</span>}</td>
                                    </tr>
                                }
                                @if (_levels.Rows.Count == 0) { <tr><td colspan="6" class="muted">کالایی پیدا نشد.</td></tr> }
                            </tbody>
                        </table>
                    </div>
                    <ServerPagination Page="_pageNo" PageSize="_pageSize" TotalCount="_levels.Total" Busy="_busy" PageChanged="PageChangedAsync" PageSizeChanged="PageSizeChangedAsync" />
                </section>
            }
            else
            {
                <ListFilterBar Busy="_busy" ActiveCount="@((_moveItemId is null ? 0 : 1) + (_moveKind is null ? 0 : 1) + (string.IsNullOrWhiteSpace(_moveText) ? 0 : 1) + (_moveFrom is null ? 0 : 1) + (_moveTo is null ? 0 : 1))"
                               CanClear="@(_moveItemId is not null || _moveKind is not null || !string.IsNullOrWhiteSpace(_moveText) || _moveFrom is not null || _moveTo is not null || _dMoveItem is not null || _dMoveKind is not null || !string.IsNullOrWhiteSpace(_dMoveText) || _dMoveFrom is not null || _dMoveTo is not null)"
                               OnSearch="ApplyMovesAsync" OnClear="ClearMovesAsync"
                               OnExport="ExportMovesAsync" ExportPermission="@Perm.StoreStockView" Exporting="_exporting">
                    <div class="admin-filter"><label class="form-label">کالا</label>
                        <LookupSelect Options="ItemOptions" Value="@_dMoveItem" ValueChanged="k => _dMoveItem = string.IsNullOrEmpty(k) ? null : k" Placeholder="همه کالاها" SearchPlaceholder="نام یا کد کالا..." /></div>
                    <div class="admin-filter"><label class="form-label">نوع</label>
                        <LookupSelect Options="KindOptions" Value="@_dMoveKind" ValueChanged="k => _dMoveKind = string.IsNullOrEmpty(k) ? null : k" Placeholder="همه انواع" /></div>
                    <div class="admin-filter"><label class="form-label">جستجو در مرجع و توضیح</label>
                        <input class="form-control" placeholder="شماره فاکتور، حواله، سفارش..." @bind="_dMoveText" @bind:event="oninput" /></div>
                    <div class="admin-filter"><label class="form-label">از تاریخ</label><PersianDatePicker Value="_dMoveFrom" ValueChanged="d => _dMoveFrom = d" Placeholder="تاریخ" /></div>
                    <div class="admin-filter"><label class="form-label">تا تاریخ</label><PersianDatePicker Value="_dMoveTo" ValueChanged="d => _dMoveTo = d" Placeholder="تاریخ" /></div>
                </ListFilterBar>
                <section class="card">
                    <h2 class="section-title print-only">گردش انبار فروشگاه</h2>
                    <div class="data-table-wrap">
                        <table class="data-table">
                            <thead><tr><th>زمان</th><th>کالا</th><th>نوع</th><th>مقدار</th><th>مرجع</th><th>توضیح</th><th>ثبت‌کننده</th></tr></thead>
                            <tbody>
                                @foreach (var m in _moves.Rows)
                                {
                                    <tr>
                                        <td>@WorkflowDisplay.ToPersianDateTime(m.CreatedAtUtc)</td>
                                        <td>@m.ItemName <span class="muted" dir="ltr">@m.ItemCode</span></td>
                                        <td>@StoreService.KindLabel(m.Kind)</td>
                                        <td dir="ltr" style="text-align:right"><strong style="color:@(m.Delta < 0 ? "var(--danger,#d92d20)" : "var(--success,#067647)")">@(m.Delta > 0 ? "+" : "")@Num(m.Delta)</strong> @m.Unit</td>
                                        <td>@m.Reference</td><td>@m.Note</td><td>@m.CreatedBy</td>
                                    </tr>
                                }
                                @if (_moves.Rows.Count == 0) { <tr><td colspan="7" class="muted">گردشی ثبت نشده است.</td></tr> }
                            </tbody>
                        </table>
                    </div>
                    <ServerPagination Page="_pageNo" PageSize="_pageSize" TotalCount="_moves.Total" Busy="_busy" PageChanged="PageChangedAsync" PageSizeChanged="PageSizeChangedAsync" />
                </section>
            }
        </div>
    }
</div>

@code {
    private bool _loading = true, _busy, _canManage;
    private Guid? _employeeId;
    private string _tab = "levels", _search = "";
    private Guid? _categoryId, _moveItemId;
    private StockMovementKind? _moveKind;
    private DateTime? _moveFrom, _moveTo;
    private string _moveText = "";
    // What is typed in the filter cards; it becomes the applied filter above only when "جستجو" is pressed.
    private string _dSearch = "", _dMoveText = "";
    private string? _dCategory, _dStock, _dMoveItem, _dMoveKind;
    private DateTime? _dMoveFrom, _dMoveTo;

    private bool _exporting;

    private async Task ExportMovesAsync()
    {
        _exporting = true;
        try { await ExportMovesCoreAsync(); }
        finally { _exporting = false; }
    }

    private async Task ExportMovesCoreAsync()
    {
        var all = await Store.SearchMovementsAsync(_moveItemId, _moveKind, _moveFrom?.Date.ToUniversalTime(), _moveTo?.Date.AddDays(1).ToUniversalTime(), 1, 20000, _moveText);
        var csv = StoreCsv.Build(["زمان", "کد کالا", "کالا", "نوع", "مقدار", "واحد", "مرجع", "توضیح", "ثبت‌کننده"],
            all.Rows.Select(m => (IReadOnlyList<string>)[WorkflowDisplay.ToPersianDateTime(m.CreatedAtUtc), m.ItemCode, m.ItemName, StoreService.KindLabel(m.Kind),
                m.Delta.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture), m.Unit, m.Reference ?? "", m.Note ?? "", m.CreatedBy ?? ""]));
        await JS.InvokeVoidAsync("yasDownloadFile", $"store-movements-{DateTime.Now:yyyyMMdd-HHmm}.csv", "text/csv;charset=utf-8", csv);
        if (all.Total > all.Rows.Count) AppState.AddToast("فقط ۲۰٬۰۰۰ ردیف اول در فایل آمد؛ فیلتر را محدودتر کنید.", ToastLevel.Info);
    }
    private string? _stockFilter;
    private static readonly IReadOnlyList<(string Key, string Text)> StockOptions = [("in", "فقط موجود"), ("out", "فقط ناموجود")];
    private int _pageNo = 1, _pageSize = 20, _formKey;
    private StorePage<StoreItemRow> _levels = new([], 0);
    private StorePage<StoreMovementRow> _moves = new([], 0);
    private IReadOnlyList<(string Key, string Text)> ItemOptions = [], CategoryOptions = [];
    private static readonly IReadOnlyList<(string Key, string Text)> KindOptions =
        Enum.GetValues<StockMovementKind>().Select(k => (((int)k).ToString(), StoreService.KindLabel(k))).ToList();

    private Guid? _formItemId;
    private StockMovementKind _formKind = StockMovementKind.Receive;
    private string _formQuantity = "", _formReference = "", _formNote = "";

    private static string Num(decimal v) => WorkflowDisplay.ToPersianDigits(v.ToString("0.###"));

    protected override async Task OnInitializedAsync()
    {
        _canManage = await PermissionChecker.HasPermissionAsync(Perm.StoreStockManage);
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _employeeId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : null;
        await LoadOptionsAsync();
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadOptionsAsync()
    {
        CategoryOptions = (await Store.ListCategoriesAsync(true)).Select(c => (c.Id.ToString(), c.Name)).ToList();
        ItemOptions = (await Store.AllItemsAsync(null, null)).Select(i => (i.Id.ToString(), $"{i.Name} ({i.Code})")).ToList();
    }

    private async Task LoadAsync()
    {
        if (_tab == "levels") _levels = await Store.SearchItemsAsync(_search, _categoryId, false, _pageNo, _pageSize, _stockFilter switch { "in" => true, "out" => false, _ => null });
        else _moves = await Store.SearchMovementsAsync(_moveItemId, _moveKind, _moveFrom?.Date.ToUniversalTime(), _moveTo?.Date.AddDays(1).ToUniversalTime(), _pageNo, _pageSize, _moveText);
    }

    private sealed record MovementPreview(string ItemName, string Unit, decimal Current, decimal After);
    private MovementPreview? _preview;

    private void ClearPreview() => _preview = null;
    private void SetFormItem(string? k) { _formItemId = Guid.TryParse(k, out var g) ? g : null; _preview = null; }
    private void SetFormKind(string? k) { _formKind = Enum.TryParse<StockMovementKind>(k, out var v) ? v : StockMovementKind.Receive; _preview = null; }

    /// <summary>Shows what the stock will be before anything is written, so a typo (500 instead of 50) is caught by the person, not by a later report.</summary>
    private async Task PrepareAsync()
    {
        if (_busy) return;
        if (_formItemId is null) { AppState.AddToast("کالا را انتخاب کنید.", ToastLevel.Error); return; }
        if (!StoreNumber.TryParse(_formQuantity, out var quantity) || quantity == 0) { AppState.AddToast("مقدار را به صورت عدد (غیر صفر) وارد کنید.", ToastLevel.Error); return; }
        var item = await Store.GetItemAsync(_formItemId.Value);
        if (item is null) { AppState.AddToast("این کالا دیگر وجود ندارد.", ToastLevel.Error); return; }
        if (_formKind != StockMovementKind.Adjustment && quantity < 0) { AppState.AddToast("برای ورود، خروج و برگشت مقدار را مثبت وارد کنید؛ برای کم‌کردن موجودی از «اصلاح موجودی» با مقدار منفی استفاده کنید.", ToastLevel.Error); return; }
        var current = await Store.StockOfAsync(item.Id);
        var after = current + (_formKind == StockMovementKind.Issue ? -quantity : quantity);
        if (after < 0) { AppState.AddToast($"موجودی کافی نیست؛ موجودی فعلی {WorkflowDisplay.ToPersianDigits(current.ToString("0.###"))} {item.Unit} است.", ToastLevel.Error); return; }
        _preview = new MovementPreview(item.Name, item.Unit, current, after);
    }

    private async Task RecordAsync()
    {
        if (_busy) return;
        if (_formItemId is null) { AppState.AddToast("کالا را انتخاب کنید.", ToastLevel.Error); return; }
        if (!StoreNumber.TryParse(_formQuantity, out var quantity) || quantity == 0) { AppState.AddToast("مقدار را به صورت عدد (غیر صفر) وارد کنید.", ToastLevel.Error); return; }
        _busy = true;
        try
        {
            var result = await Store.RecordMovementAsync(_formItemId.Value, _formKind, quantity, _formReference, _formNote, _employeeId);
            if (!result.Ok) { _preview = null; AppState.AddToast(result.Error ?? "ثبت نشد.", ToastLevel.Error); return; }
            AppState.AddToast("گردش انبار ثبت شد.", ToastLevel.Success);
            _preview = null; _formItemId = null; _formQuantity = ""; _formReference = _formNote = ""; _formKind = StockMovementKind.Receive; _formKey++;
            await LoadAsync();
        }
        catch (Exception) { AppState.AddToast("ثبت گردش انجام نشد.", ToastLevel.Error); }
        finally { _busy = false; }
    }

    private async Task SwitchTabAsync(string tab) { _tab = tab; _pageNo = 1; await LoadAsync(); }
    private async Task ApplyLevelsAsync()
    {
        _search = _dSearch.Trim();
        _categoryId = Guid.TryParse(_dCategory, out var g) ? g : null;
        _stockFilter = _dStock;
        _pageNo = 1;
        await LoadAsync();
    }

    private async Task ClearLevelsAsync() { _dSearch = ""; _dCategory = _dStock = null; await ApplyLevelsAsync(); }

    private async Task ApplyMovesAsync()
    {
        _moveItemId = Guid.TryParse(_dMoveItem, out var g) ? g : null;
        _moveKind = Enum.TryParse<StockMovementKind>(_dMoveKind, out var v) ? v : null;
        _moveText = _dMoveText.Trim();
        _moveFrom = _dMoveFrom;
        _moveTo = _dMoveTo;
        _pageNo = 1;
        await LoadAsync();
    }

    private async Task ClearMovesAsync() { _dMoveItem = _dMoveKind = null; _dMoveText = ""; _dMoveFrom = _dMoveTo = null; await ApplyMovesAsync(); }
    private async Task PageChangedAsync(int p) { _pageNo = p; await LoadAsync(); }
    private async Task PageSizeChangedAsync(int s) { _pageSize = s; _pageNo = 1; await LoadAsync(); }
}
