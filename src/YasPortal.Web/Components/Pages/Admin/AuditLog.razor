@page "/admin/audit-log"
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Components.Shared
@attribute [Authorize(Policy = "Admin.AuditLog")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>گزارش رویدادها - یاس پورتال</PageTitle>

<div class="page-header" dir="rtl">
    <div><div class="page-subtitle">مدیریت سامانه / گزارش رویدادها</div><h1 class="page-title">گزارش رویدادها</h1><p class="page-subtitle">تغییرات مهم سامانه همراه با کاربر و سمت فعال ثبت می‌شوند.</p></div>
    <a class="btn btn-secondary" href="/dashboard"><i class="bx bx-arrow-back"></i> داشبورد</a>
</div>

<section class="card" dir="rtl">
    <div class="audit-filters">
        <div class="filter-field"><label>کاربر</label><input class="form-control" placeholder="نام کاربر..." @bind="_employeeSearch" /></div>
        <div class="filter-field"><label>سمت فعال</label><input class="form-control" placeholder="نام سمت..." @bind="_positionSearch" /></div>
        <div class="filter-field"><label>موجودیت</label><input class="form-control" placeholder="مثلاً Permission" @bind="_entityType" /></div>
        <div class="filter-field"><label>عملیات</label><select class="form-control" @bind="_action"><option value="">همه عملیات</option><option value="Created">ایجاد</option><option value="Updated">ویرایش</option><option value="Deleted">حذف</option></select></div>
        <div class="filter-field"><label>از تاریخ</label><PersianDatePicker @bind-Value="_fromDate" Placeholder="تاریخ شروع" /></div>
        <div class="filter-field"><label>تا تاریخ</label><PersianDatePicker @bind-Value="_toDate" Placeholder="تاریخ پایان" /></div>
    </div>
    <div class="audit-filter-footer">
        <div class="active-filters">
            @if (_fromDate.HasValue) { <span class="filter-chip">از @ToPersianDate(_fromDate.Value)<button type="button" @onclick="() => RemoveFromDateAsync()">×</button></span> }
            @if (_toDate.HasValue) { <span class="filter-chip">تا @ToPersianDate(_toDate.Value)<button type="button" @onclick="() => RemoveToDateAsync()">×</button></span> }
            @if (!string.IsNullOrWhiteSpace(_employeeSearch)) { <span class="filter-chip">کاربر: @_employeeSearch</span> }
            @if (!string.IsNullOrWhiteSpace(_positionSearch)) { <span class="filter-chip">سمت: @_positionSearch</span> }
            @if (!string.IsNullOrWhiteSpace(_entityType)) { <span class="filter-chip">موجودیت: @_entityType</span> }
            @if (!string.IsNullOrWhiteSpace(_action)) { <span class="filter-chip">عملیات: @GetActionText(_action)</span> }
        </div>
        <div class="filter-actions"><button class="btn btn-primary" @onclick="SearchAsync"><i class="bx bx-search"></i> جستجو</button><button class="btn btn-secondary" @onclick="ClearFiltersAsync"><i class="bx bx-reset"></i> پاک کردن</button></div>
    </div>

    @if (_loading) { <div class="empty-state">در حال بارگذاری...</div> }
    else if (_rows.Count == 0) { <div class="empty-state">رویدادی مطابق فیلترها پیدا نشد.</div> }
    else {
        <div class="audit-result-info"><span>@_totalCount.ToString("N0") رویداد مطابق فیلترها</span><div class="page-size"><label>تعداد در صفحه</label><select @bind="_pageSize" @bind:after="PageSizeChangedAsync"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div></div>
        <div class="data-table-wrap"><table class="data-table audit-table"><colgroup><col class="col-time" /><col class="col-user" /><col class="col-position" /><col class="col-action" /><col class="col-entity" /><col class="col-details" /></colgroup><thead><tr><th>زمان</th><th>کاربر</th><th>سمت فعال</th><th>عملیات</th><th>موجودیت</th><th>جزئیات</th></tr></thead><tbody>
        @foreach (var row in _rows) { <tr @key="row.Id"><td class="audit-time">@row.OccurredAtUtc.ToLocalTime().ToString("yyyy/MM/dd")<small>@row.OccurredAtUtc.ToLocalTime().ToString("HH:mm:ss")</small></td><td><div class="actor-cell"><span class="actor-avatar"><i class="bx bx-user"></i></span><span class="truncate">@(row.EmployeeName ?? (row.EmployeeId is null ? "سیستم" : row.EmployeeId.ToString()))</span></div></td><td><span class="truncate">@(row.PositionName ?? (row.ActivePositionId is null ? "-" : row.ActivePositionId.ToString()))</span></td><td><span class="audit-action @GetActionClass(row.Action)"><i class="bx @GetActionIcon(row.Action)"></i>@GetActionText(row.Action)</span></td><td><div class="entity-cell"><strong>@GetEntityText(row.EntityType)</strong><small title="@row.EntityId">@row.EntityId</small></div></td><td><button class="audit-details-btn" @onclick="() => ShowDetails(row)"><i class="bx bx-show-alt"></i> مشاهده جزئیات</button></td></tr> }
        </tbody></table></div>
        <div class="audit-pagination"><button class="page-btn" disabled="@(_page <= 1)" @onclick="PreviousPageAsync"><i class="bx bx-chevron-right"></i> قبلی</button><div class="page-numbers">@foreach (var pageNumber in GetPageNumbers()) { <button class="page-number @(pageNumber == _page ? "active" : "")" @onclick="() => GoToPageAsync(pageNumber)">@(pageNumber)</button> }</div><button class="page-btn" disabled="@(_page >= TotalPages)" @onclick="NextPageAsync">بعدی <i class="bx bx-chevron-left"></i></button></div>
    }
</section>

@if (_selected is not null) { <div class="audit-overlay" @onclick="CloseDetails"><div class="audit-modal" dir="rtl" @onclick:stopPropagation="true"><div class="audit-modal-header"><div><div class="audit-modal-kicker">گزارش رویداد</div><h2>@GetActionText(_selected.Action) @GetEntityText(_selected.EntityType)</h2><div class="audit-modal-time"><i class="bx bx-time-five"></i>@_selected.OccurredAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</div></div><button class="audit-close" @onclick="CloseDetails" aria-label="بستن"><i class="bx bx-x"></i></button></div><div class="audit-meta-grid"><div class="audit-meta-card"><span><i class="bx bx-user"></i> کاربر</span><strong>@(_selected.EmployeeName ?? (_selected.EmployeeId is null ? "سیستم" : _selected.EmployeeId.ToString()))</strong></div><div class="audit-meta-card"><span><i class="bx bx-briefcase"></i> سمت فعال</span><strong>@(_selected.PositionName ?? (_selected.ActivePositionId is null ? "-" : _selected.ActivePositionId.ToString()))</strong></div><div class="audit-meta-card"><span><i class="bx bx-category"></i> موجودیت</span><strong>@GetEntityText(_selected.EntityType)</strong><small>@_selected.EntityId</small></div><div class="audit-meta-card"><span><i class="bx bx-bolt-circle"></i> عملیات</span><strong><span class="audit-action @GetActionClass(_selected.Action)">@GetActionText(_selected.Action)</span></strong></div></div><div class="audit-changes"><div class="change-panel"><div class="change-header"><i class="bx bx-history"></i> قبل از تغییر</div><div class="change-body">@RenderJson(_selected.BeforeJson)</div></div><div class="change-arrow"><i class="bx bx-left-arrow-alt"></i></div><div class="change-panel"><div class="change-header"><i class="bx bx-check-circle"></i> بعد از تغییر</div><div class="change-body">@RenderJson(_selected.AfterJson)</div></div></div><div class="audit-modal-footer"><span>شناسه رویداد: @_selected.Id</span><button class="btn btn-secondary" @onclick="CloseDetails">بستن</button></div></div></div> }

@code {
    private List<AuditRow> _rows = [];
    private AuditRow? _selected;
    private string _employeeSearch = ""; private string _positionSearch = ""; private string _entityType = ""; private string _action = "";
    private DateTime? _fromDate; private DateTime? _toDate; private int _page = 1; private int _pageSize = 25; private int _totalCount; private bool _loading;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)_pageSize));
    protected override async Task OnInitializedAsync() => await SearchAsync();
    private async Task SearchAsync(){_loading=true;try{await using var db=await DbFactory.CreateDbContextAsync();var query=db.AuditEntries.AsNoTracking().AsQueryable();if(!string.IsNullOrWhiteSpace(_entityType))query=query.Where(x=>x.EntityType.Contains(_entityType.Trim()));if(!string.IsNullOrWhiteSpace(_action))query=query.Where(x=>x.Action==_action);if(_fromDate.HasValue){var from=DateTime.SpecifyKind(_fromDate.Value.Date,DateTimeKind.Local).ToUniversalTime();query=query.Where(x=>x.OccurredAtUtc>=from);}if(_toDate.HasValue){var to=DateTime.SpecifyKind(_toDate.Value.Date.AddDays(1),DateTimeKind.Local).ToUniversalTime();query=query.Where(x=>x.OccurredAtUtc<to);}var all=await query.OrderByDescending(x=>x.OccurredAtUtc).ToListAsync();var eids=all.Where(x=>x.EmployeeId.HasValue).Select(x=>x.EmployeeId!.Value).Distinct().ToList();var pids=all.Where(x=>x.ActivePositionId.HasValue).Select(x=>x.ActivePositionId!.Value).Distinct().ToList();var employees=await db.Employees.AsNoTracking().Where(x=>eids.Contains(x.Id)).ToDictionaryAsync(x=>x.Id,x=>x.FullName);var positions=await db.Positions.AsNoTracking().Where(x=>pids.Contains(x.Id)).ToDictionaryAsync(x=>x.Id,x=>x.Name);var et=_employeeSearch.Trim();var pt=_positionSearch.Trim();var filtered=all.Where(x=>string.IsNullOrWhiteSpace(et)||(x.EmployeeId.HasValue&&employees.TryGetValue(x.EmployeeId.Value,out var n)&&n.Contains(et,StringComparison.OrdinalIgnoreCase))).Where(x=>string.IsNullOrWhiteSpace(pt)||(x.ActivePositionId.HasValue&&positions.TryGetValue(x.ActivePositionId.Value,out var n)&&n.Contains(pt,StringComparison.OrdinalIgnoreCase))).ToList();_totalCount=filtered.Count;if(_page>TotalPages)_page=TotalPages;_rows=filtered.Skip((_page-1)*_pageSize).Take(_pageSize).Select(x=>new AuditRow(x.Id,x.OccurredAtUtc,x.EmployeeId,x.ActivePositionId,x.EmployeeId is Guid ei&&employees.TryGetValue(ei,out var en)?en:null,x.ActivePositionId is Guid pi&&positions.TryGetValue(pi,out var pn)?pn:null,x.Action,x.EntityType,x.EntityId,x.BeforeJson,x.AfterJson)).ToList();}finally{_loading=false;}}
    private async Task PageSizeChangedAsync(){_page=1;await SearchAsync();} private async Task ClearFiltersAsync(){_employeeSearch="";_positionSearch="";_entityType="";_action="";_fromDate=null;_toDate=null;_page=1;await SearchAsync();} private async Task RemoveFromDateAsync(){_fromDate=null;_page=1;await SearchAsync();} private async Task RemoveToDateAsync(){_toDate=null;_page=1;await SearchAsync();} private async Task GoToPageAsync(int p){_page=p;await SearchAsync();} private async Task PreviousPageAsync(){if(_page>1){_page--;await SearchAsync();}} private async Task NextPageAsync(){if(_page<TotalPages){_page++;await SearchAsync();}}
    private IEnumerable<int> GetPageNumbers(){var s=Math.Max(1,_page-2);var e=Math.Min(TotalPages,s+4);s=Math.Max(1,e-4);return Enumerable.Range(s,e-s+1);} private void ShowDetails(AuditRow r)=>_selected=r; private void CloseDetails()=>_selected=null;
    private static string GetActionText(string a)=>a switch{"Created"=>"ایجاد","Updated"=>"ویرایش","Deleted"=>"حذف",_=>a}; private static string GetActionClass(string a)=>a switch{"Created"=>"audit-created","Deleted"=>"audit-deleted",_=>"audit-updated"}; private static string GetActionIcon(string a)=>a switch{"Created"=>"bx-plus","Deleted"=>"bx-trash",_=>"bx-edit-alt"}; private static string GetEntityText(string e)=>e switch{"Permission"=>"مجوز","Employee"=>"کارمند","Position"=>"سمت","Organization"=>"سازمان","EmployeePosition"=>"تخصیص سمت","PermissionGroup"=>"گروه مجوز",_=>e};
    private static string ToPersianDate(DateTime date){var pc=new System.Globalization.PersianCalendar();return ToPersianDigits($"{pc.GetYear(date):0000}/{pc.GetMonth(date):00}/{pc.GetDayOfMonth(date):00}");} private static string ToPersianDigits(string value)=>value.Replace("0","۰").Replace("1","۱").Replace("2","۲").Replace("3","۳").Replace("4","۴").Replace("5","۵").Replace("6","۶").Replace("7","۷").Replace("8","۸").Replace("9","۹");
    private static RenderFragment RenderJson(string? json)=>builder=>{if(string.IsNullOrWhiteSpace(json)){builder.AddMarkupContent(0,"<div class='no-change'>بدون تغییر</div>");return;}try{using var doc=JsonDocument.Parse(json);var i=0;builder.OpenElement(i++,"div");builder.AddAttribute(i++,"class","json-properties");foreach(var p in doc.RootElement.EnumerateObject()){builder.OpenElement(i++,"div");builder.AddAttribute(i++,"class","json-property");builder.OpenElement(i++,"span");builder.AddAttribute(i++,"class","json-key");builder.AddContent(i++,GetPropertyText(p.Name));builder.CloseElement();builder.OpenElement(i++,"span");builder.AddAttribute(i++,"class","json-value");builder.AddContent(i++,FormatJsonValue(p.Value));builder.CloseElement();builder.CloseElement();}builder.CloseElement();}catch{builder.AddMarkupContent(0,$"<pre class='json-fallback'>{System.Net.WebUtility.HtmlEncode(json)}</pre>");}};
    private static string GetPropertyText(string n)=>n switch{"Id"=>"شناسه","Code"=>"کد","Name"=>"نام","FullName"=>"نام و نام خانوادگی","Username"=>"نام کاربری","IsActive"=>"فعال","OrganizationId"=>"سازمان","PositionId"=>"سمت","EmployeeId"=>"کارمند","StartedAt"=>"تاریخ شروع","EndedAt"=>"تاریخ پایان",_=>n}; private static string FormatJsonValue(JsonElement v)=>v.ValueKind switch{JsonValueKind.Null=>"-",JsonValueKind.True=>"بله",JsonValueKind.False=>"خیر",JsonValueKind.String=>v.GetString()??"-",_=>v.ToString()};
    private sealed record AuditRow(Guid Id,DateTime OccurredAtUtc,Guid? EmployeeId,Guid? ActivePositionId,string? EmployeeName,string? PositionName,string Action,string EntityType,string? EntityId,string? BeforeJson,string? AfterJson);
}

<style>
.audit-filters{display:grid;grid-template-columns:repeat(6,minmax(120px,1fr));gap:12px;align-items:end;margin-bottom:12px}.filter-field label,.page-size label{display:block;font-size:11px;color:#64748b;margin-bottom:6px;font-weight:600}.audit-filter-footer{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px;padding-top:2px}.active-filters{display:flex;flex-wrap:wrap;gap:6px;min-height:30px;align-items:center}.filter-chip{display:inline-flex;align-items:center;gap:5px;background:#f1f5f9;color:#475569;border:1px solid #e2e8f0;border-radius:999px;padding:4px 9px;font-size:11px}.filter-chip button{border:0;background:transparent;color:#64748b;cursor:pointer;font-size:15px;line-height:1;padding:0}.filter-actions{display:flex;gap:8px;flex-shrink:0}.audit-result-info{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;color:#64748b;font-size:12px}.page-size{display:flex;align-items:center;gap:8px}.page-size label{margin:0}.page-size select{border:1px solid #e2e8f0;border-radius:7px;padding:5px 8px;background:#fff}.audit-table{table-layout:fixed;width:100%}.audit-table .col-time{width:105px}.audit-table .col-user{width:18%}.audit-table .col-position{width:17%}.audit-table .col-action{width:105px}.audit-table .col-entity{width:25%}.audit-table .col-details{width:150px}.audit-table th,.audit-table td{overflow:hidden}.audit-time{width:105px;white-space:nowrap}.audit-time small{display:block;color:#94a3b8;font-size:11px;margin-top:2px}.actor-cell{display:flex;align-items:center;gap:8px;min-width:0}.actor-avatar{width:30px;height:30px;flex:0 0 30px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:#f1f5f9;color:#475569}.truncate{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.entity-cell strong{display:block}.entity-cell small{display:block;color:#94a3b8;font-size:10px;direction:ltr;text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.audit-action{display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;font-size:12px;font-weight:600}.audit-created{background:#ecfdf5;color:#047857}.audit-updated{background:#eff6ff;color:#1d4ed8}.audit-deleted{background:#fef2f2;color:#b91c1c}.audit-details-btn{border:0;background:#f8fafc;color:#475569;border-radius:7px;padding:7px 9px;font-family:inherit;font-size:11px;cursor:pointer;white-space:nowrap}.audit-details-btn:hover{background:#eef2ff;color:#3730a3}.audit-pagination{display:flex;justify-content:center;align-items:center;gap:10px;margin-top:18px}.page-numbers{display:flex;gap:4px}.page-btn,.page-number{border:1px solid #e2e8f0;background:#fff;border-radius:7px;padding:6px 9px;cursor:pointer;font-family:inherit;font-size:11px;color:#475569}.page-number.active{background:#2563eb;color:#fff;border-color:#2563eb}.page-btn:disabled{opacity:.45;cursor:not-allowed}.audit-overlay{position:fixed;inset:0;background:rgba(15,23,42,.45);display:flex;align-items:center;justify-content:center;padding:20px;z-index:5000}.audit-modal{width:min(1000px,96vw);max-height:90vh;overflow:auto;background:#fff;border-radius:16px;box-shadow:0 25px 70px rgba(15,23,42,.28);padding:20px}.audit-modal-header{display:flex;justify-content:space-between;gap:20px}.audit-modal-kicker{font-size:11px;color:#94a3b8}.audit-modal-header h2{margin:3px 0;font-size:20px}.audit-modal-time{color:#64748b;font-size:12px}.audit-close{border:0;background:#f1f5f9;border-radius:8px;width:36px;height:36px;cursor:pointer;font-size:20px}.audit-meta-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:18px 0}.audit-meta-card{padding:12px;border:1px solid #e2e8f0;border-radius:10px;background:#f8fafc}.audit-meta-card span{display:block;color:#64748b;font-size:11px;margin-bottom:6px}.audit-meta-card strong{display:block;font-size:13px}.audit-meta-card small{display:block;color:#94a3b8;font-size:10px;margin-top:4px;direction:ltr}.audit-changes{display:grid;grid-template-columns:1fr 40px 1fr;align-items:stretch;gap:8px}.change-panel{border:1px solid #e2e8f0;border-radius:10px;overflow:hidden}.change-header{padding:9px 11px;background:#f8fafc;font-size:12px;font-weight:700}.change-body{padding:10px;min-height:120px}.change-arrow{display:flex;align-items:center;justify-content:center;color:#94a3b8}.json-properties{display:flex;flex-direction:column;gap:5px}.json-property{display:flex;justify-content:space-between;gap:12px;padding:6px 8px;background:#f8fafc;border-radius:6px}.json-key{color:#64748b;font-size:11px}.json-value{color:#1e293b;font-size:11px;word-break:break-word}.no-change{color:#94a3b8;font-size:12px}.json-fallback{white-space:pre-wrap;font-size:10px;direction:ltr;text-align:left}.audit-modal-footer{display:flex;justify-content:space-between;align-items:center;margin-top:16px;padding-top:12px;border-top:1px solid #e2e8f0;color:#94a3b8;font-size:10px;direction:ltr}.audit-modal-footer .btn{direction:rtl}@media(max-width:1100px){.audit-filters{grid-template-columns:repeat(3,1fr)}}@media(max-width:700px){.audit-filters{grid-template-columns:1fr}.audit-filter-footer{align-items:stretch;flex-direction:column}.filter-actions{justify-content:flex-end}.audit-meta-grid{grid-template-columns:1fr 1fr}.audit-changes{grid-template-columns:1fr}.change-arrow{display:none}}
</style>
