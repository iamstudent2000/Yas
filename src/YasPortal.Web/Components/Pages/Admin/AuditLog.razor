@page "/admin/audit-log"
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Components.Shared
@attribute [Authorize(Policy = "Admin.AuditLog")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>گزارش رویدادها - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <header class="admin-page-header">
        <div class="admin-page-header__title"><h1><i class="bx bx-history"></i> گزارش رویدادها</h1><p>ثبت و بررسی تغییرات انجام‌شده در سامانه</p></div>
        <div class="admin-page-header__actions"><span class="admin-chip"><i class="bx bx-time-five"></i> امروز: @ToPersianDate(DateTime.Today)</span><a class="admin-btn admin-btn-secondary" href="/dashboard"><i class="bx bx-arrow-back"></i> داشبورد</a></div>
    </header>

    <section class="admin-card">
        <div class="admin-card__header"><div><h2 class="admin-card__title">فیلتر گزارش‌ها</h2><p class="admin-card__subtitle">نتایج به‌صورت سروری و صفحه‌بندی‌شده بارگذاری می‌شوند.</p></div><span class="admin-chip"><i class="bx bx-data"></i> @_totalCount.ToString("N0") رویداد</span></div>
        <div class="admin-filters">
            <div class="admin-filter"><label>کاربر</label><input placeholder="نام کاربر..." @bind="_employeeSearch" /></div>
            <div class="admin-filter"><label>سمت فعال</label><input placeholder="نام سمت..." @bind="_positionSearch" /></div>
            <div class="admin-filter"><label>موجودیت</label><input placeholder="مثلاً Permission" @bind="_entityType" /></div>
            <div class="admin-filter"><label>عملیات</label><select @bind="_action"><option value="">همه عملیات</option><option value="Created">ایجاد</option><option value="Updated">ویرایش</option><option value="Deleted">حذف</option></select></div>
            <div class="admin-filter"><label>از تاریخ</label><PersianDatePicker @bind-Value="_fromDate" Placeholder="تاریخ شروع" /></div>
            <div class="admin-filter"><label>تا تاریخ</label><PersianDatePicker @bind-Value="_toDate" Placeholder="تاریخ پایان" /></div>
        </div>
        <div class="admin-toolbar"><div class="admin-toolbar__meta">
            @if (_fromDate.HasValue) { <span class="admin-chip">از @ToPersianDate(_fromDate.Value)<button type="button" @onclick="RemoveFromDateAsync">×</button></span> }
            @if (_toDate.HasValue) { <span class="admin-chip">تا @ToPersianDate(_toDate.Value)<button type="button" @onclick="RemoveToDateAsync">×</button></span> }
            @if (!string.IsNullOrWhiteSpace(_employeeSearch)) { <span class="admin-chip">کاربر: @_employeeSearch</span> }
            @if (!string.IsNullOrWhiteSpace(_positionSearch)) { <span class="admin-chip">سمت: @_positionSearch</span> }
            @if (!string.IsNullOrWhiteSpace(_entityType)) { <span class="admin-chip">موجودیت: @_entityType</span> }
            @if (!string.IsNullOrWhiteSpace(_action)) { <span class="admin-chip">عملیات: @GetActionText(_action)</span> }
        </div><div class="admin-toolbar__actions"><button class="admin-btn admin-btn-primary" @onclick="SearchAsync" disabled="@_loading"><i class="bx bx-search"></i> جستجو</button><button class="admin-btn admin-btn-secondary" @onclick="ClearFiltersAsync" disabled="@_loading"><i class="bx bx-reset"></i> پاک کردن</button></div></div>

        @if (_loading) { <div class="admin-loading"><div><div class="admin-spinner"></div><div>در حال بارگذاری گزارش‌ها...</div></div></div> }
        else if (_rows.Count == 0) { <div class="admin-empty"><i class="bx bx-search-alt"></i><strong>رویدادی پیدا نشد</strong><span>فیلترها را تغییر دهید و دوباره جستجو کنید.</span></div> }
        else {
            <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th style="width:120px">زمان</th><th style="min-width:180px">کاربر</th><th style="min-width:160px">سمت فعال</th><th style="width:110px">عملیات</th><th style="width:170px">موجودیت</th><th style="width:130px">جزئیات</th></tr></thead><tbody>
            @foreach (var row in _rows) { <tr @key="row.Id"><td><strong>@row.OccurredAtUtc.ToLocalTime().ToString("yyyy/MM/dd")</strong><small style="display:block;color:#98a2b3;margin-top:2px">@row.OccurredAtUtc.ToLocalTime().ToString("HH:mm:ss")</small></td><td><div class="admin-actor"><span class="admin-avatar"><i class="bx bx-user"></i></span><span class="admin-truncate">@(row.EmployeeName ?? (row.EmployeeId is null ? "سیستم" : row.EmployeeId.ToString()))</span></div></td><td><span class="admin-truncate">@(row.PositionName ?? (row.ActivePositionId is null ? "-" : row.ActivePositionId.ToString()))</span></td><td><span class="admin-action @GetActionClass(row.Action)"><i class="bx @GetActionIcon(row.Action)"></i>@GetActionText(row.Action)</span></td><td><div><strong>@GetEntityText(row.EntityType)</strong><small class="admin-truncate" style="display:block;color:#98a2b3;max-width:145px" title="@row.EntityId">@row.EntityId</small></div></td><td><button type="button" class="admin-details-btn" @onclick="() => ShowDetails(row)"><i class="bx bx-show-alt"></i> جزئیات</button></td></tr> }
            </tbody></table></div>
            <div class="admin-pagination"><div class="admin-page-size"><span>نمایش</span><select @bind="_pageSize" @bind:after="PageSizeChangedAsync"><option value="20">20</option><option value="50">50</option><option value="100">100</option><option value="200">200</option></select><span>مورد</span></div><div class="admin-pagination__pages"><button class="admin-page-btn" disabled="@(_page <= 1)" @onclick="PreviousPageAsync"><i class="bx bx-chevron-right"></i></button>@foreach (var p in GetPageNumbers()) { <button class="admin-page-btn @(p == _page ? "active" : "")" @onclick="() => GoToPageAsync(p)">@p</button> }<button class="admin-page-btn" disabled="@(_page >= TotalPages)" @onclick="NextPageAsync"><i class="bx bx-chevron-left"></i></button></div><span style="font-size:11px;color:#667085">صفحه @_page از @TotalPages</span></div>
        }
    </section>
</div>

@if (_selected is not null)
{
    <div class="audit-modal-backdrop" dir="rtl" @onclick="CloseDetails">
        <section class="audit-modal" role="dialog" aria-modal="true" aria-labelledby="audit-details-title" @onclick:stopPropagation="true">
            <header class="audit-modal__header">
                <div><div class="audit-modal__kicker">جزئیات رویداد</div><h2 id="audit-details-title">@GetActionText(_selected.Action) · @GetEntityText(_selected.EntityType)</h2><div class="audit-modal__time"><i class="bx bx-time-five"></i>@_selected.OccurredAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</div></div>
                <button type="button" class="audit-modal__close" aria-label="بستن" @onclick="CloseDetails"><i class="bx bx-x"></i></button>
            </header>
            <div class="audit-modal__body">
                <div class="audit-meta-grid"><div class="admin-meta-card"><span>کاربر</span><strong>@(_selected.EmployeeName ?? (_selected.EmployeeId is null ? "سیستم" : _selected.EmployeeId.ToString()))</strong></div><div class="admin-meta-card"><span>سمت فعال</span><strong>@(_selected.PositionName ?? (_selected.ActivePositionId is null ? "-" : _selected.ActivePositionId.ToString()))</strong></div><div class="admin-meta-card"><span>موجودیت</span><strong>@GetEntityText(_selected.EntityType)</strong><small>@_selected.EntityId</small></div><div class="admin-meta-card"><span>عملیات</span><strong><span class="admin-action @GetActionClass(_selected.Action)">@GetActionText(_selected.Action)</span></strong></div></div>
                <div class="admin-changes"><div class="admin-change-panel"><div class="admin-change-header"><i class="bx bx-history"></i> قبل از تغییر</div><div class="admin-change-body">@RenderJson(_selected.BeforeJson)</div></div><div class="admin-change-arrow"><i class="bx bx-left-arrow-alt"></i></div><div class="admin-change-panel"><div class="admin-change-header"><i class="bx bx-check-circle"></i> بعد از تغییر</div><div class="admin-change-body">@RenderJson(_selected.AfterJson)</div></div></div>
            </div>
            <footer class="audit-modal__footer"><span>شناسه: @_selected.Id</span><button type="button" class="admin-btn admin-btn-secondary" @onclick="CloseDetails"><i class="bx bx-x"></i> بستن</button></footer>
        </section>
    </div>
}

<style>
    .audit-modal-backdrop{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:24px;background:rgba(15,23,42,.58);backdrop-filter:blur(3px);overflow:auto;animation:auditFadeIn .16s ease-out}
    .audit-modal{width:min(1000px,calc(100vw - 48px));max-height:calc(100vh - 48px);display:flex;flex-direction:column;background:#fff;border:1px solid rgba(15,23,42,.08);border-radius:18px;box-shadow:0 24px 70px rgba(15,23,42,.25);overflow:hidden;animation:auditModalIn .18s ease-out}
    .audit-modal__header{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding:22px 26px;border-bottom:1px solid #eaecf0;background:#fff;flex-shrink:0}
    .audit-modal__header h2{margin:4px 0 7px;font-size:19px;font-weight:750;color:#101828}
    .audit-modal__kicker{font-size:12px;color:#667085;font-weight:600}.audit-modal__time{font-size:12px;color:#667085;display:flex;align-items:center;gap:6px}.audit-modal__close{width:38px;height:38px;border:1px solid #eaecf0;border-radius:10px;background:#fff;color:#667085;display:grid;place-items:center;cursor:pointer;font-size:21px;transition:.15s}.audit-modal__close:hover{background:#f2f4f7;color:#101828;border-color:#d0d5dd}.audit-modal__body{padding:22px 26px;overflow:auto}.audit-modal__footer{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:15px 26px;border-top:1px solid #eaecf0;background:#f8fafc;color:#667085;font-size:11px;flex-shrink:0}.audit-modal__footer .admin-btn{min-width:92px}.admin-details-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:7px 12px;border:1px solid #d0d5dd;border-radius:9px;background:#fff;color:#344054;font-size:12px;font-weight:650;cursor:pointer;transition:.15s;white-space:nowrap}.admin-details-btn:hover{background:#f8fafc;border-color:#98a2b3;color:#101828;box-shadow:0 1px 2px rgba(16,24,40,.06)}.admin-details-btn:active{transform:translateY(1px)}
    @keyframes auditFadeIn{from{opacity:0}to{opacity:1}}@keyframes auditModalIn{from{opacity:0;transform:translateY(10px) scale(.985)}to{opacity:1;transform:translateY(0) scale(1)}}
    @media(max-width:700px){.audit-modal-backdrop{padding:10px}.audit-modal{width:100%;max-height:calc(100vh - 20px);border-radius:14px}.audit-modal__header,.audit-modal__body{padding:18px}.audit-modal__footer{padding:12px 18px}.admin-changes{display:block}.admin-change-arrow{display:none}}
</style>

@code {
    private List<AuditRow> _rows = [];
    private AuditRow? _selected;
    private string _employeeSearch = ""; private string _positionSearch = ""; private string _entityType = ""; private string _action = "";
    private DateTime? _fromDate = DateTime.Today; private DateTime? _toDate = DateTime.Today; private int _page = 1; private int _pageSize = 20; private int _totalCount; private bool _loading;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)_pageSize));
    protected override async Task OnInitializedAsync() => await SearchAsync();
    private async Task SearchAsync(){_loading=true;try{await using var db=await DbFactory.CreateDbContextAsync();var query=db.AuditEntries.AsNoTracking().AsQueryable();if(!string.IsNullOrWhiteSpace(_entityType))query=query.Where(x=>x.EntityType.Contains(_entityType.Trim()));if(!string.IsNullOrWhiteSpace(_action))query=query.Where(x=>x.Action==_action);if(_fromDate.HasValue){var from=DateTime.SpecifyKind(_fromDate.Value.Date,DateTimeKind.Local).ToUniversalTime();query=query.Where(x=>x.OccurredAtUtc>=from);}if(_toDate.HasValue){var to=DateTime.SpecifyKind(_toDate.Value.Date.AddDays(1),DateTimeKind.Local).ToUniversalTime();query=query.Where(x=>x.OccurredAtUtc<to);}var et=_employeeSearch.Trim();var pt=_positionSearch.Trim();if(!string.IsNullOrWhiteSpace(et))query=query.Where(x=>x.EmployeeId.HasValue&&db.Employees.Any(e=>e.Id==x.EmployeeId&&e.FullName.Contains(et)));if(!string.IsNullOrWhiteSpace(pt))query=query.Where(x=>x.ActivePositionId.HasValue&&db.Positions.Any(p=>p.Id==x.ActivePositionId&&p.Name.Contains(pt)));_totalCount=await query.CountAsync();if(_page>TotalPages)_page=TotalPages;var entries=await query.OrderByDescending(x=>x.OccurredAtUtc).Skip((_page-1)*_pageSize).Take(_pageSize).ToListAsync();var eids=entries.Where(x=>x.EmployeeId.HasValue).Select(x=>x.EmployeeId!.Value).Distinct().ToList();var pids=entries.Where(x=>x.ActivePositionId.HasValue).Select(x=>x.ActivePositionId!.Value).Distinct().ToList();var employees=await db.Employees.AsNoTracking().Where(x=>eids.Contains(x.Id)).ToDictionaryAsync(x=>x.Id,x=>x.FullName);var positions=await db.Positions.AsNoTracking().Where(x=>pids.Contains(x.Id)).ToDictionaryAsync(x=>x.Id,x=>x.Name);_rows=entries.Select(x=>new AuditRow(x.Id,x.OccurredAtUtc,x.EmployeeId,x.ActivePositionId,x.EmployeeId is Guid ei&&employees.TryGetValue(ei,out var en)?en:null,x.ActivePositionId is Guid pi&&positions.TryGetValue(pi,out var pn)?pn:null,x.Action,x.EntityType,x.EntityId,x.BeforeJson,x.AfterJson)).ToList();}finally{_loading=false;}}
    private async Task PageSizeChangedAsync(){_page=1;await SearchAsync();} private async Task ClearFiltersAsync(){_employeeSearch="";_positionSearch="";_entityType="";_action="";_fromDate=DateTime.Today;_toDate=DateTime.Today;_page=1;await SearchAsync();} private async Task RemoveFromDateAsync(){_fromDate=null;_page=1;await SearchAsync();} private async Task RemoveToDateAsync(){_toDate=null;_page=1;await SearchAsync();} private async Task GoToPageAsync(int p){_page=p;await SearchAsync();} private async Task PreviousPageAsync(){if(_page>1){_page--;await SearchAsync();}} private async Task NextPageAsync(){if(_page<TotalPages){_page++;await SearchAsync();}}
    private IEnumerable<int> GetPageNumbers(){var s=Math.Max(1,_page-2);var e=Math.Min(TotalPages,s+4);s=Math.Max(1,e-4);return Enumerable.Range(s,e-s+1);} private void ShowDetails(AuditRow r)=>_selected=r; private void CloseDetails()=>_selected=null;
    private static string GetActionText(string a)=>a switch{"Created"=>"ایجاد","Updated"=>"ویرایش","Deleted"=>"حذف",_=>a}; private static string GetActionClass(string a)=>a switch{"Created"=>"admin-action--success","Deleted"=>"admin-action--danger","Updated"=>"admin-action--warning",_=>"admin-action--neutral"}; private static string GetActionIcon(string a)=>a switch{"Created"=>"bx-plus","Deleted"=>"bx-trash",_=>"bx-edit-alt"}; private static string GetEntityText(string e)=>e switch{"Permission"=>"مجوز","Employee"=>"کارمند","Position"=>"سمت","Organization"=>"سازمان","EmployeePosition"=>"تخصیص سمت","PermissionGroup"=>"گروه مجوز",_=>e};
    private static string ToPersianDate(DateTime date){var pc=new System.Globalization.PersianCalendar();return ToPersianDigits($"{pc.GetYear(date):0000}/{pc.GetMonth(date):00}/{pc.GetDayOfMonth(date):00}");} private static string ToPersianDigits(string value)=>value.Replace("0","۰").Replace("1","۱").Replace("2","۲").Replace("3","۳").Replace("4","۴").Replace("5","۵").Replace("6","۶").Replace("7","۷").Replace("8","۸").Replace("9","۹");
    private static RenderFragment RenderJson(string? json)=>builder=>{if(string.IsNullOrWhiteSpace(json)){builder.AddMarkupContent(0,"<div class='admin-no-change'>بدون تغییر</div>");return;}try{using var doc=JsonDocument.Parse(json);var i=0;builder.OpenElement(i++,"div");builder.AddAttribute(i++,"class","admin-json-properties");foreach(var p in doc.RootElement.EnumerateObject()){builder.OpenElement(i++,"div");builder.AddAttribute(i++,"class","admin-json-property");builder.OpenElement(i++,"span");builder.AddAttribute(i++,"class","admin-json-key");builder.AddContent(i++,GetPropertyText(p.Name));builder.CloseElement();builder.OpenElement(i++,"span");builder.AddAttribute(i++,"class","admin-json-value");builder.AddContent(i++,FormatJsonValue(p.Value));builder.CloseElement();builder.CloseElement();}builder.CloseElement();}catch{builder.AddMarkupContent(0,$"<pre class='admin-json-fallback'>{System.Net.WebUtility.HtmlEncode(json)}</pre>");}};
    private static string GetPropertyText(string n)=>n switch{"Id"=>"شناسه","Code"=>"کد","Name"=>"نام","FullName"=>"نام و نام خانوادگی","Username"=>"نام کاربری","IsActive"=>"فعال","OrganizationId"=>"سازمان","PositionId"=>"سمت","EmployeeId"=>"کارمند","StartedAt"=>"تاریخ شروع","EndedAt"=>"تاریخ پایان",_=>n}; private static string FormatJsonValue(JsonElement v)=>v.ValueKind switch{JsonValueKind.Null=>"-",JsonValueKind.True=>"بله",JsonValueKind.False=>"خیر",JsonValueKind.String=>v.GetString()??"-",_=>v.ToString()};
    private sealed record AuditRow(Guid Id,DateTime OccurredAtUtc,Guid? EmployeeId,Guid? ActivePositionId,string? EmployeeName,string? PositionName,string Action,string EntityType,string? EntityId,string? BeforeJson,string? AfterJson);
}
