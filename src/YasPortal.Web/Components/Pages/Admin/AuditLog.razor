@page "/admin/audit-log"
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Domain.Auditing
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize(Policy = "Admin.AuditLog")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AdminQueryService AdminQueries
@inject ReportExportService Reports
@inject AppState AppState

<PageTitle>گزارش رویدادها - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <div class="page-header">
        <div>
            <div class="page-kicker">مدیریت سامانه / گزارش‌ها</div>
            <h1 class="page-title"><i class="bx bx-history"></i> گزارش رویدادها</h1>
            <p class="page-subtitle">ثبت و بررسی تغییرات انجام‌شده در سامانه</p>
        </div>
        <div class="form-actions">
            <span class="badge badge-muted"><i class="bx bx-time-five"></i> امروز: @ToPersianDate(DateTime.Today)</span>
            <a class="btn btn-secondary" href="/dashboard"><i class="bx bx-arrow-back"></i> داشبورد</a>
        </div>
    </div>

    <ListFilterBar Busy="_loading" ActiveCount="_applied.Count" CanClear="@(_applied.Count > 0 || _hasSearched || DraftCount > 0)"
                   OnSearch="SearchAsync" OnClear="ClearOrCancelAsync" OnCancel="CancelLoad" ExportPermission="@(ReportPermissions.AuditLog)" OnExport="ExportAsync" Exporting="_exporting">
        <div class="admin-filter"><label class="form-label">کاربر</label>
            <ServerSearchableGuidSelect @key="_resetKey" Value="@_employeeId" ValueChanged="EmployeeChanged"
                                        SearchAsync="SearchEmployeesAsync" SelectedText="@_employeeSearch" Placeholder="همه کاربران"
                                        SearchPlaceholder="نام، نام کاربری یا کد کارمند را جستجو کنید..." />
        </div>
        <div class="admin-filter"><label class="form-label">سمت فعال</label>
            <ServerSearchableGuidSelect @key="_resetKey" Value="@_positionId" ValueChanged="PositionChanged"
                                        SearchAsync="SearchPositionsAsync" SelectedText="@_positionSearch" Placeholder="همه سمت‌ها"
                                        SearchPlaceholder="نام یا کد سمت را جستجو کنید..." />
        </div>
        <div class="admin-filter"><label class="form-label">موجودیت</label><LookupSelect Options="EntityOptions" Value="@(string.IsNullOrEmpty(_entityType) ? null : _entityType)" ValueChanged="k => _entityType = k ?? string.Empty" Placeholder="همه موجودیت‌ها" /></div>
        <div class="admin-filter"><label class="form-label">شناسه موجودیت</label><input class="form-control" dir="ltr" placeholder="بخشی از شناسه" @bind="_entityId" @bind:event="oninput" /></div>
        <div class="admin-filter"><label class="form-label">عملیات</label><LookupSelect Options="_actionOptions" Value="@(string.IsNullOrEmpty(_action) ? null : _action)" ValueChanged="k => _action = k ?? string.Empty" Placeholder="همه عملیات" /></div>
        <div class="admin-filter"><label class="form-label">از تاریخ</label><PersianDatePicker @key="_resetKey" @bind-Value="_fromDate" Placeholder="تاریخ شروع" /></div>
        <div class="admin-filter"><label class="form-label">تا تاریخ</label><PersianDatePicker @key="_resetKey" @bind-Value="_toDate" Placeholder="تاریخ پایان" /></div>
    </ListFilterBar>

    <section class="card">
        <div class="card-toolbar">
            <div>
                <h2 class="section-title">رویدادها</h2>
                <p class="muted">برای شروع، فیلترها را انتخاب کرده و «جستجو» را بزنید.</p>
            </div>
            @if (_hasSearched)
            {
                <span class="badge badge-muted"><i class="bx bx-data"></i> @ToPersianDigits(_totalCount.ToString("N0")) رویداد</span>
            }
            else
            {
                <span class="badge badge-muted"><i class="bx bx-search"></i> آماده جستجو</span>
            }
        </div>

        @if(!_hasSearched){
            <div class="empty-state"><i class="bx bx-search-alt"></i><strong>گزارش آماده جستجو است</strong><span>هیچ داده‌ای هنوز دریافت نشده است.</span></div>
        }
        else if(_loading){
            <div class="empty-state"><i class="bx bx-loader-alt bx-spin"></i><strong>در حال بارگذاری گزارش‌ها...</strong><span>می‌توانید هر زمان درخواست را لغو کنید.</span></div>
        }
        else if(_rows.Count==0){
            <div class="empty-state"><i class="bx bx-search-alt"></i><strong>رویدادی پیدا نشد</strong><span>فیلترها را تغییر دهید و دوباره جستجو کنید.</span></div>
        }
        else{
            <div class="data-table-wrap" data-no-auto-paginate>
                <table class="data-table data-table-bordered-rows">
                    <thead><tr>
                        <SortableHeader Text="زمان" Column="time" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortByAsync" />
                        <SortableHeader Text="کاربر" Column="actor" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortByAsync" />
                        <SortableHeader Text="سمت فعال" Column="position" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortByAsync" />
                        <SortableHeader Text="عملیات" Column="action" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortByAsync" />
                        <SortableHeader Text="موجودیت" Column="entity" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortByAsync" />
                        <th>جزئیات</th>
                    </tr></thead>
                    <tbody>
                    @foreach(var row in _rows){
                        var local=row.OccurredAtUtc.ToLocalTime();
                        <tr @key="row.Id">
                            <td class="date-cell"><strong>@ToPersianDate(local)</strong><small class="muted">@ToPersianDigits(local.ToString("HH:mm:ss"))</small></td>
                            <td><div class="admin-actor"><span class="admin-avatar"><i class="bx bx-user"></i></span><span class="admin-truncate" lang="en" data-persian-digits="off" title="@(row.EmployeeName ?? (row.EmployeeId is null ? "سیستم" : row.EmployeeId.ToString()))">@(row.EmployeeName ?? (row.EmployeeId is null ? "سیستم" : row.EmployeeId.ToString()))</span></div></td>
                            <td><span class="admin-truncate" lang="en" data-persian-digits="off" title="@(row.PositionName ?? "-")">@(row.PositionName ?? (row.ActivePositionId is null ? "-" : row.ActivePositionId.ToString()))</span></td>
                            <td><span class="admin-action @GetActionClass(row.Action)"><i class="bx @GetActionIcon(row.Action)"></i>@GetActionText(row.Action)</span></td>
                            <td><div><strong>@GetEntityText(row.EntityType)</strong>@if(!string.IsNullOrEmpty(row.EntityName)){<small lang="en" data-persian-digits="off">@row.EntityName <span class="entity-id">(@row.EntityId)</span></small>}else{<small class="entity-id" lang="en" data-persian-digits="off">@row.EntityId</small>}</div></td>
                            <td class="action-cell"><button type="button" class="btn btn-secondary btn-sm" @onclick="() => ShowDetailsAsync(row)"><i class="bx bx-show-alt"></i> جزئیات</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <ServerPagination Page="@_page" PageSize="@_pageSize" TotalCount="@_totalCount" Busy="@_loading" PageChanged="GoToPageAsync" PageSizeChanged="OnPageSizeChangedAsync" />
        }
    </section>

    @if(_selected is not null){
        <div class="admin-modal-overlay" @onclick="CloseDetails">
            <section class="admin-modal" dir="rtl" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
                <header class="admin-modal-header">
                    <div><div class="muted">جزئیات رویداد</div><h2>@GetActionText(_selected.Action) · @GetEntityText(_selected.EntityType)</h2><div class="muted"><i class="bx bx-time-five"></i> @ToPersianDate(_selected.OccurredAtUtc.ToLocalTime()) @ToPersianDigits(_selected.OccurredAtUtc.ToLocalTime().ToString("HH:mm:ss"))</div></div>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseDetails" aria-label="بستن"><i class="bx bx-x"></i></button>
                </header>
                <div class="admin-modal__body">
                    <div class="admin-meta-grid"><div class="admin-meta-card"><span>کاربر</span><strong lang="en" data-persian-digits="off" title="@(_selected.EmployeeName ?? (_selected.EmployeeId is null ? "سیستم" : _selected.EmployeeId.ToString()))">@(_selected.EmployeeName ?? (_selected.EmployeeId is null ? "سیستم" : _selected.EmployeeId.ToString()))</strong></div><div class="admin-meta-card"><span>سمت فعال</span><strong lang="en" data-persian-digits="off" title="@(_selected.PositionName ?? (_selected.ActivePositionId is null ? "-" : _selected.ActivePositionId.ToString()))">@(_selected.PositionName ?? (_selected.ActivePositionId is null ? "-" : _selected.ActivePositionId.ToString()))</strong></div><div class="admin-meta-card admin-meta-card-wide"><span>موجودیت</span><strong>@GetEntityText(_selected.EntityType)</strong>@if(!string.IsNullOrEmpty(_selected.EntityName)){<small lang="en" data-persian-digits="off">@_selected.EntityName <span class="entity-id">(@_selected.EntityId)</span></small>}else{<small class="entity-id" lang="en" data-persian-digits="off">@FormatEntityId(_selected.EntityType,_selected.EntityId)</small>}</div><div class="admin-meta-card"><span>عملیات</span><strong><span class="admin-action @GetActionClass(_selected.Action)">@GetActionText(_selected.Action)</span></strong></div></div>
                    <div class="admin-changes"><div class="admin-change-panel"><div class="admin-change-header"><i class="bx bx-history"></i> قبل از تغییر</div><div class="admin-change-properties">@RenderJson(_selected.BeforeJson)</div></div><div class="admin-change-arrow"><i class="bx bx-left-arrow-alt"></i></div><div class="admin-change-panel"><div class="admin-change-header"><i class="bx bx-check-circle"></i> بعد از تغییر</div><div class="admin-change-properties">@RenderJson(_selected.AfterJson)</div></div></div>
                </div>
                <footer class="admin-modal-footer"><span dir="ltr" lang="en" data-persian-digits="off">@_selected.Id</span><button type="button" class="btn btn-secondary" @onclick="CloseDetails"><i class="bx bx-x"></i> بستن</button></footer>
            </section>
        </div>
    }
</div>

@code {
    private List<AuditRow> _rows = [];
    private AuditRow? _selected;
    private Guid? _employeeId;
    private Guid? _positionId;
    private string _employeeSearch = "";
    private string _positionSearch = "";
    private string _entityType = "";
    private string _action = "";
    private string _entityId = "";
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private int _page = 1;
    private int _pageSize = 20;
    private int _totalCount;
    private bool _loading;
    private bool _hasSearched;
    private string _sortBy = "time"; private bool _sortDesc = true;
    private CancellationTokenSource? _loadCts;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)_pageSize));

    // The boxes edit the draft fields above; "جستجو" copies them here, and paging/sorting reload from this copy.
    private sealed record AuditFilter(Guid? EmployeeId, Guid? PositionId, string EntityType, string EntityId, string Action, DateTime? From, DateTime? To)
    {
        public int Count => (EmployeeId is null ? 0 : 1) + (PositionId is null ? 0 : 1) + (EntityType.Trim().Length > 0 ? 1 : 0) + (EntityId.Trim().Length > 0 ? 1 : 0) + (Action.Length > 0 ? 1 : 0) + (From is null ? 0 : 1) + (To is null ? 0 : 1);
    }
    private AuditFilter _applied = new(null, null, "", "", "", null, null);
    private int _resetKey;
    private int DraftCount => new AuditFilter(_employeeId, _positionId, _entityType, _entityId, _action, _fromDate, _toDate).Count;
    private void CancelLoad() => _loadCts?.Cancel();
    private async Task SearchAsync(){if(_loading)return;_applied=new AuditFilter(_employeeId,_positionId,_entityType,_entityId,_action,_fromDate,_toDate);await LoadPageAsync(1);}
    private async Task LoadPageAsync(int page)
    {
        _loadCts?.Cancel();_loadCts?.Dispose();_loadCts=new CancellationTokenSource();var cts=_loadCts;var token=cts.Token;_loading=true;_hasSearched=true;_page=page;await InvokeAsync(StateHasChanged);
        try
        {
            await using var db=await DbFactory.CreateDbContextAsync(token);var query=ApplyFilter(db);
            _totalCount=await query.CountAsync(token);if(_page>TotalPages)_page=TotalPages;
            query=ApplySort(db,query);
            var entries=await query.Skip((_page-1)*_pageSize).Take(_pageSize).ToListAsync(token);
            var eids=entries.Where(x=>x.EmployeeId.HasValue).Select(x=>x.EmployeeId!.Value).Distinct().ToList();var pids=entries.Where(x=>x.ActivePositionId.HasValue).Select(x=>x.ActivePositionId!.Value).Distinct().ToList();
            var employees=await db.Employees.AsNoTracking().Where(x=>eids.Contains(x.Id)).ToDictionaryAsync(x=>x.Id,x=>x.FullName,token);var positions=await db.Positions.AsNoTracking().Where(x=>pids.Contains(x.Id)).ToDictionaryAsync(x=>x.Id,x=>x.Name,token);
            var permissionEntityIds=new List<Guid>();var employeeEntityIds=new List<Guid>();var positionEntityIds=new List<Guid>();var organizationEntityIds=new List<Guid>();var groupEntityIds=new List<Guid>();
            foreach(var x in entries){if(!Guid.TryParse(x.EntityId,out var eid))continue;switch(x.EntityType){case "Permission":permissionEntityIds.Add(eid);break;case "Employee":employeeEntityIds.Add(eid);break;case "Position":positionEntityIds.Add(eid);break;case "Organization":organizationEntityIds.Add(eid);break;case "PermissionGroup":groupEntityIds.Add(eid);break;}}
            var permissionNames=await db.Permissions.AsNoTracking().Where(x=>permissionEntityIds.Contains(x.Id)).ToDictionaryAsync(x=>x.Id,x=>x.Name,token);
            var employeeEntityNames=await db.Employees.AsNoTracking().Where(x=>employeeEntityIds.Contains(x.Id)).ToDictionaryAsync(x=>x.Id,x=>x.FullName,token);
            var positionEntityNames=await db.Positions.AsNoTracking().Where(x=>positionEntityIds.Contains(x.Id)).ToDictionaryAsync(x=>x.Id,x=>x.Name,token);
            var organizationNames=await db.Organizations.AsNoTracking().Where(x=>organizationEntityIds.Contains(x.Id)).ToDictionaryAsync(x=>x.Id,x=>x.Name,token);
            var groupNames=await db.PermissionGroups.AsNoTracking().Where(x=>groupEntityIds.Contains(x.Id)).ToDictionaryAsync(x=>x.Id,x=>x.Name,token);
            string? ResolveEntityName(string entityType,string? entityId){if(!Guid.TryParse(entityId,out var id))return null;return entityType switch{"Permission"=>permissionNames.GetValueOrDefault(id),"Employee"=>employeeEntityNames.GetValueOrDefault(id),"Position"=>positionEntityNames.GetValueOrDefault(id),"Organization"=>organizationNames.GetValueOrDefault(id),"PermissionGroup"=>groupNames.GetValueOrDefault(id),_=>null};}
            var rows=entries.Select(x=>new AuditRow(x.Id,x.OccurredAtUtc,x.EmployeeId,x.ActivePositionId,x.EmployeeId is Guid ei&&employees.TryGetValue(ei,out var en)?en:null,x.ActivePositionId is Guid pi&&positions.TryGetValue(pi,out var pn)?pn:null,x.Action,x.EntityType,x.EntityId,ResolveEntityName(x.EntityType,x.EntityId),x.BeforeJson,x.AfterJson)).ToList();token.ThrowIfCancellationRequested();_rows=rows;
        }
        catch(OperationCanceledException)when(token.IsCancellationRequested){}
        finally{if(ReferenceEquals(_loadCts,cts)){_loading=false;await InvokeAsync(StateHasChanged);}}
    }
    private IQueryable<AuditEntry> ApplyFilter(ApplicationDbContext db)
    {
        var query=db.AuditEntries.AsNoTracking().AsQueryable();
            if(!string.IsNullOrWhiteSpace(_applied.EntityType))query=query.Where(x=>x.EntityType.Contains(_applied.EntityType.Trim()));
            if(!string.IsNullOrWhiteSpace(_applied.Action))query=query.Where(x=>x.Action==_applied.Action);
            if(!string.IsNullOrWhiteSpace(_applied.EntityId)){var idPart=_applied.EntityId.Trim().TrimStart('#');query=query.Where(x=>x.EntityId!=null&&EF.Functions.Like(x.EntityId,"%"+idPart+"%"));}
            if(_applied.From.HasValue){var from=DateTime.SpecifyKind(_applied.From.Value.Date,DateTimeKind.Local).ToUniversalTime();query=query.Where(x=>x.OccurredAtUtc>=from);}
            if(_applied.To.HasValue){var to=DateTime.SpecifyKind(_applied.To.Value.Date.AddDays(1),DateTimeKind.Local).ToUniversalTime();query=query.Where(x=>x.OccurredAtUtc<to);}
            if(_applied.EmployeeId is Guid eidFilter)query=query.Where(x=>x.EmployeeId==eidFilter);
            if(_applied.PositionId is Guid pidFilter)query=query.Where(x=>x.ActivePositionId==pidFilter);
        return query;
    }
    private IOrderedQueryable<AuditEntry> ApplySort(ApplicationDbContext db,IQueryable<AuditEntry> query)
    {
        return (_sortBy,_sortDesc)switch{
                ("time",false)=>query.OrderBy(x=>x.OccurredAtUtc),
                ("actor",false)=>query.OrderBy(x=>x.EmployeeId.HasValue?db.Employees.Where(e=>e.Id==x.EmployeeId).Select(e=>e.FullName).FirstOrDefault():null),
                ("actor",true)=>query.OrderByDescending(x=>x.EmployeeId.HasValue?db.Employees.Where(e=>e.Id==x.EmployeeId).Select(e=>e.FullName).FirstOrDefault():null),
                ("position",false)=>query.OrderBy(x=>x.ActivePositionId.HasValue?db.Positions.Where(p=>p.Id==x.ActivePositionId).Select(p=>p.Name).FirstOrDefault():null),
                ("position",true)=>query.OrderByDescending(x=>x.ActivePositionId.HasValue?db.Positions.Where(p=>p.Id==x.ActivePositionId).Select(p=>p.Name).FirstOrDefault():null),
                ("action",false)=>query.OrderBy(x=>x.Action),
                ("action",true)=>query.OrderByDescending(x=>x.Action),
                ("entity",false)=>query.OrderBy(x=>x.EntityType),
                ("entity",true)=>query.OrderByDescending(x=>x.EntityType),
                _=>query.OrderByDescending(x=>x.OccurredAtUtc),
            };
    }
    private bool _exporting;
    private static Dictionary<string,string>? ReadJson(string? json)
    {
        if(string.IsNullOrWhiteSpace(json))return null;
        try
        {
            using var doc=JsonDocument.Parse(json);
            if(doc.RootElement.ValueKind!=JsonValueKind.Object)return new(){["مقدار"]=ExportValue(doc.RootElement)};
            var result=new Dictionary<string,string>();
            foreach(var prop in doc.RootElement.EnumerateObject())result[GetPropertyText(prop.Name)]=ExportValue(prop.Value);
            return result;
        }
        catch(JsonException){return new(){["مقدار"]=json};}
    }
    private static string ExportValue(JsonElement v)=>v.ValueKind switch{JsonValueKind.Null=>"-",JsonValueKind.True=>"بله",JsonValueKind.False=>"خیر",JsonValueKind.String=>v.GetString()??"-",_=>v.ToString()};
    /// <summary>All fields of one snapshot as "label: value · label: value".</summary>
    private static string DescribeJson(string? json){var d=ReadJson(json);return d is null?"":string.Join(" · ",d.Select(p=>$"{p.Key}: {p.Value}"));}
    /// <summary>Only the fields that differ, as "label: before ← after"; a created or deleted entity has nothing to compare.</summary>
    private static string DescribeChanges(string? before,string? after)
    {
        var b=ReadJson(before);var a=ReadJson(after);
        if(b is null||a is null)return "";
        var keys=b.Keys.Union(a.Keys);
        return string.Join(" · ",keys.Where(k=>b.GetValueOrDefault(k,"-")!=a.GetValueOrDefault(k,"-")).Select(k=>$"{k}: {b.GetValueOrDefault(k,"-")} ← {a.GetValueOrDefault(k,"-")}"));
    }
    /// <summary>Exports every event the last search matched, in the table's current order.</summary>
    private async Task ExportAsync()
    {
        if(_exporting)return;
        if(!_hasSearched){AppState.AddToast("ابتدا جستجو کنید.",ToastLevel.Info);return;}
        _exporting=true;
        try
        {
            await Reports.ExportTableAsync(ReportPermissions.AuditLog, "audit-log",
                ["زمان","کاربر","سمت فعال","عملیات","موجودیت","شناسه موجودیت","تغییرات","قبل از تغییر","بعد از تغییر"],
                db=>ApplySort(db,ApplyFilter(db)).ThenBy(x=>x.Id),
                async(db,chunk,ct)=>
                {
                    var eids=chunk.Where(x=>x.EmployeeId.HasValue).Select(x=>x.EmployeeId!.Value).Distinct().ToList();
                    var pids=chunk.Where(x=>x.ActivePositionId.HasValue).Select(x=>x.ActivePositionId!.Value).Distinct().ToList();
                    var employees=await db.Employees.AsNoTracking().Where(x=>eids.Contains(x.Id)).ToDictionaryAsync(x=>x.Id,x=>x.FullName,ct);
                    var positions=await db.Positions.AsNoTracking().Where(x=>pids.Contains(x.Id)).ToDictionaryAsync(x=>x.Id,x=>x.Name,ct);
                    return chunk.Select(x=>(IReadOnlyList<string>)[
                        ReportExportService.Time(x.OccurredAtUtc),
                        x.EmployeeId is Guid ei?employees.GetValueOrDefault(ei,"—"):"سیستم",
                        x.ActivePositionId is Guid pi?positions.GetValueOrDefault(pi,"—"):"",
                        GetActionText(x.Action),
                        GetEntityText(x.EntityType),
                        x.EntityId??"",
                        DescribeChanges(x.BeforeJson,x.AfterJson),
                        DescribeJson(x.BeforeJson),
                        DescribeJson(x.AfterJson)]).ToList();
                });
        }
        finally{_exporting=false;}
    }
    private async Task ClearOrCancelAsync(){if(_loading){_loadCts?.Cancel();return;}_applied=new AuditFilter(null,null,"","","",null,null);_resetKey++;_employeeId=null;_positionId=null;_employeeSearch="";_positionSearch="";_entityType="";_entityId="";_action="";_fromDate=null;_toDate=null;_page=1;_totalCount=0;_rows.Clear();_selected=null;_hasSearched=false;await InvokeAsync(StateHasChanged);}
    private async Task OnPageSizeChangedAsync(int size){_pageSize=size;_page=1;if(_hasSearched)await LoadPageAsync(1);}
    private async Task GoToPageAsync(int p){if(_hasSearched)await LoadPageAsync(p);}
    private async Task SortByAsync(string column){if(_sortBy==column)_sortDesc=!_sortDesc;else{_sortBy=column;_sortDesc=false;}await LoadPageAsync(1);}
    private static readonly IReadOnlyList<(string Key, string Text)> _actionOptions = [("Created", "ایجاد"), ("Updated", "ویرایش"), ("Deleted", "حذف")];
    private static IReadOnlyList<(string Key, string Text)> EntityOptions => EntityTypes.Select(t => (t, GetEntityText(t))).ToList();
    private static readonly string[] EntityTypes = ["Employee","Position","Organization","Permission","PermissionGroup","EmployeePosition","UserPositionPermission","UserPositionPermissionGroup"];
    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchEmployeesAsync(string search, CancellationToken ct) => AdminQueries.SearchEmployeesAsync(search, ct);
    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchPositionsAsync(string search, CancellationToken ct) => AdminQueries.SearchPositionsAsync(search, null, null, ct);
    private async Task EmployeeChanged(Guid? id)
    {
        _employeeId = id;
        _employeeSearch = "";
        if (id is Guid eid)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var employee = await db.Employees.AsNoTracking().Where(x => x.Id == eid).Select(x => new { x.Code, x.FullName }).SingleOrDefaultAsync();
            if (employee is not null) _employeeSearch = $"{employee.Code} — {employee.FullName}";
        }
        _page = 1;
    }
    private async Task PositionChanged(Guid? id)
    {
        _positionId = id;
        _positionSearch = "";
        if (id is Guid pid)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var position = await db.Positions.AsNoTracking().Where(x => x.Id == pid).Select(x => new { x.Code, x.Name }).SingleOrDefaultAsync();
            if (position is not null) _positionSearch = $"{position.Code} — {position.Name}";
        }
        _page = 1;
    }
    private Dictionary<Guid,string> _idNameMap=new();
    private async Task ShowDetailsAsync(AuditRow r)
    {
        _selected=r;
        _idNameMap=await ResolveIdsInJsonAsync(r.BeforeJson,r.AfterJson,r.EntityId);
    }
    private void CloseDetails()=>_selected=null;
    private async Task<Dictionary<Guid,string>> ResolveIdsInJsonAsync(string? beforeJson,string? afterJson,string? entityId)
    {
        var ids=new HashSet<Guid>();
        CollectGuids(beforeJson,ids);
        CollectGuids(afterJson,ids);
        CollectGuidsFromComposite(entityId,ids);
        var map=new Dictionary<Guid,string>();
        if(ids.Count==0)return map;
        await using var db=await DbFactory.CreateDbContextAsync();
        foreach(var x in await db.Employees.AsNoTracking().Where(x=>ids.Contains(x.Id)).Select(x=>new{x.Id,x.FullName}).ToListAsync())map[x.Id]=x.FullName;
        foreach(var x in await db.Positions.AsNoTracking().Where(x=>ids.Contains(x.Id)).Select(x=>new{x.Id,x.Name}).ToListAsync())map[x.Id]=x.Name;
        foreach(var x in await db.Organizations.AsNoTracking().Where(x=>ids.Contains(x.Id)).Select(x=>new{x.Id,x.Name}).ToListAsync())map[x.Id]=x.Name;
        foreach(var x in await db.Permissions.AsNoTracking().Where(x=>ids.Contains(x.Id)).Select(x=>new{x.Id,x.Name}).ToListAsync())map[x.Id]=x.Name;
        foreach(var x in await db.PermissionGroups.AsNoTracking().Where(x=>ids.Contains(x.Id)).Select(x=>new{x.Id,x.Name}).ToListAsync())map[x.Id]=x.Name;
        return map;
    }
    private static void CollectGuids(string? json,HashSet<Guid> ids)
    {
        if(string.IsNullOrWhiteSpace(json))return;
        try
        {
            using var doc=JsonDocument.Parse(json);
            foreach(var p in doc.RootElement.EnumerateObject())
                if(p.Value.ValueKind==JsonValueKind.String&&Guid.TryParse(p.Value.GetString(),out var id))ids.Add(id);
        }
        catch{}
    }
    private static void CollectGuidsFromComposite(string? entityId,HashSet<Guid> ids)
    {
        if(string.IsNullOrWhiteSpace(entityId)||!entityId.Contains('='))return;
        foreach(var part in entityId.Split(','))
        {
            var kv=part.Split('=',2);
            if(kv.Length==2&&Guid.TryParse(kv[1].Trim(),out var id))ids.Add(id);
        }
    }
    private string FormatEntityId(string entityType,string? entityId)
    {
        if(string.IsNullOrWhiteSpace(entityId))return "-";
        if(!entityId.Contains('='))return entityId;
        var parts=new List<string>();
        foreach(var part in entityId.Split(','))
        {
            var kv=part.Split('=',2);
            if(kv.Length!=2)continue;
            var label=GetPropertyText(kv[0].Trim());
            var rawValue=kv[1].Trim();
            var value=Guid.TryParse(rawValue,out var id)&&_idNameMap.TryGetValue(id,out var name)?$"{name} ({rawValue})":rawValue;
            parts.Add($"{label}: {value}");
        }
        return parts.Count>0?string.Join(" · ",parts):entityId;
    }
