    private string FormatJsonValue(string propertyName,JsonElement v)
    {
        if(v.ValueKind==JsonValueKind.String)
        {
            var s=v.GetString();
            if(propertyName!="Id"&&s is not null&&Guid.TryParse(s,out var id)&&_idNameMap.TryGetValue(id,out var name))return name;
            return s??"-";
        }
        return v.ValueKind switch{JsonValueKind.Null=>"-",JsonValueKind.True=>"بله",JsonValueKind.False=>"خیر",_=>v.ToString()};
    }
