@page "/admin/audit-log"
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Components.Shared
@attribute [Authorize(Policy = "Admin.AuditLog")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>گزارش رویدادها - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <div class="page-header">
        <div>
            <div class="page-kicker">مدیریت سامانه / گزارش‌ها</div>
            <h1 class="page-title"><i class="bx bx-history"></i> گزارش رویدادها</h1>
            <p class="page-subtitle">ثبت و بررسی تغییرات انجام‌شده در سامانه</p>
        </div>
        <div class="form-actions">
            <span class="badge badge-muted"><i class="bx bx-time-five"></i> امروز: @ToPersianDate(DateTime.Today)</span>
            <a class="btn btn-secondary" href="/dashboard"><i class="bx bx-arrow-back"></i> داشبورد</a>
        </div>
    </div>

    <section class="card">
        <div class="section-head">
            <div>
                <h2 class="section-title">فیلتر گزارش‌ها</h2>
                <p class="muted">برای شروع، فیلترها را انتخاب کرده و «جستجو» را بزنید.</p>
            </div>
            @if (_hasSearched)
            {
                <span class="badge badge-muted"><i class="bx bx-data"></i> @ToPersianDigits(_totalCount.ToString("N0")) رویداد</span>
            }
            else
            {
                <span class="badge badge-muted"><i class="bx bx-search"></i> آماده جستجو</span>
            }
        </div>

        <div class="admin-filters">
            <div class="admin-filter"><label>کاربر</label><input class="form-control" placeholder="نام کاربر..." @bind="_employeeSearch" /></div>
            <div class="admin-filter"><label>سمت فعال</label><input class="form-control" placeholder="نام سمت..." @bind="_positionSearch" /></div>
            <div class="admin-filter"><label>موجودیت</label><input class="form-control" placeholder="مثلاً Permission" @bind="_entityType" /></div>
            <div class="admin-filter"><label>عملیات</label><select class="form-control" @bind="_action"><option value="">همه عملیات</option><option value="Created">ایجاد</option><option value="Updated">ویرایش</option><option value="Deleted">حذف</option></select></div>
            <div class="admin-filter"><label>از تاریخ</label><PersianDatePicker @bind-Value="_fromDate" Placeholder="تاریخ شروع" /></div>
            <div class="admin-filter"><label>تا تاریخ</label><PersianDatePicker @bind-Value="_toDate" Placeholder="تاریخ پایان" /></div>
        </div>

        <div class="table-toolbar">
            <div class="admin-active-filters">
                @if(_fromDate.HasValue){<span class="badge badge-muted">از @ToPersianDate(_fromDate.Value)</span>}
                @if(_toDate.HasValue){<span class="badge badge-muted">تا @ToPersianDate(_toDate.Value)</span>}
                @if(!string.IsNullOrWhiteSpace(_employeeSearch)){<span class="badge badge-muted">کاربر: @_employeeSearch</span>}
                @if(!string.IsNullOrWhiteSpace(_positionSearch)){<span class="badge badge-muted">سمت: @_positionSearch</span>}
                @if(!string.IsNullOrWhiteSpace(_entityType)){<span class="badge badge-muted">موجودیت: @_entityType</span>}
                @if(!string.IsNullOrWhiteSpace(_action)){<span class="badge badge-muted">عملیات: @GetActionText(_action)</span>}
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SearchAsync" disabled="@_loading"><i class="bx bx-search"></i><span>جستجو</span></button>
                <button class="btn @(_loading ? "btn-danger" : "btn-secondary")" @onclick="ClearOrCancelAsync"><i class="bx @(_loading ? "bx-x-circle" : "bx-eraser")"></i><span>@(_loading ? "لغو" : "پاک کردن فیلترها")</span></button>
            </div>
        </div>

        @if(!_hasSearched){
            <div class="empty-state"><i class="bx bx-search-alt"></i><strong>گزارش آماده جستجو است</strong><span>هیچ داده‌ای هنوز دریافت نشده است.</span></div>
        }
        else if(_loading){
            <div class="empty-state"><i class="bx bx-loader-alt bx-spin"></i><strong>در حال بارگذاری گزارش‌ها...</strong><span>می‌توانید هر زمان درخواست را لغو کنید.</span></div>
        }
        else if(_rows.Count==0){
            <div class="empty-state"><i class="bx bx-search-alt"></i><strong>رویدادی پیدا نشد</strong><span>فیلترها را تغییر دهید و دوباره جستجو کنید.</span></div>
        }
        else{
            <div class="data-table-wrap" data-no-auto-paginate>
                <table class="data-table data-table-bordered-rows">
                    <thead><tr><th>زمان</th><th>کاربر</th><th>سمت فعال</th><th>عملیات</th><th>موجودیت</th><th>جزئیات</th></tr></thead>
                    <tbody>
                    @foreach(var row in _rows){
                        var local=row.OccurredAtUtc.ToLocalTime();
                        <tr @key="row.Id">
                            <td class="date-cell"><strong>@ToPersianDate(local)</strong><small class="muted">@ToPersianDigits(local.ToString("HH:mm:ss"))</small></td>
                            <td><div class="admin-actor"><span class="admin-avatar"><i class="bx bx-user"></i></span><span class="admin-truncate">@(row.EmployeeName ?? (row.EmployeeId is null ? "سیستم" : row.EmployeeId.ToString()))</span></div></td>
                            <td><span class="admin-truncate" title="@(row.PositionName ?? "-")">@(row.PositionName ?? (row.ActivePositionId is null ? "-" : row.ActivePositionId.ToString()))</span></td>
                            <td><span class="admin-action @GetActionClass(row.Action)"><i class="bx @GetActionIcon(row.Action)"></i>@GetActionText(row.Action)</span></td>
                            <td><div><strong>@GetEntityText(row.EntityType)</strong><small class="entity-id">@row.EntityId</small></div></td>
                            <td class="action-cell"><button type="button" class="btn btn-secondary btn-sm" @onclick="() => ShowDetails(row)"><i class="bx bx-show-alt"></i> جزئیات</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <ServerPagination Page="@_page" PageSize="@_pageSize" TotalCount="@_totalCount" Busy="@_loading" PageChanged="GoToPageAsync" PageSizeChanged="OnPageSizeChangedAsync" />
        }
    </section>

    @if(_selected is not null){
        <div class="admin-modal-overlay" @onclick="CloseDetails">
            <section class="admin-modal" dir="rtl" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
                <header class="admin-modal-header">
                    <div><div class="muted">جزئیات رویداد</div><h2>@GetActionText(_selected.Action) · @GetEntityText(_selected.EntityType)</h2><div class="muted"><i class="bx bx-time-five"></i> @ToPersianDate(_selected.OccurredAtUtc.ToLocalTime()) @ToPersianDigits(_selected.OccurredAtUtc.ToLocalTime().ToString("HH:mm:ss"))</div></div>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseDetails" aria-label="بستن"><i class="bx bx-x"></i></button>
                </header>
                <div class="admin-modal__body">
                    <div class="admin-meta-grid"><div class="admin-meta-card"><span>کاربر</span><strong>@(_selected.EmployeeName ?? (_selected.EmployeeId is null ? "سیستم" : _selected.EmployeeId.ToString()))</strong></div><div class="admin-meta-card"><span>سمت فعال</span><strong>@(_selected.PositionName ?? (_selected.ActivePositionId is null ? "-" : _selected.ActivePositionId.ToString()))</strong></div><div class="admin-meta-card"><span>موجودیت</span><strong>@GetEntityText(_selected.EntityType)</strong><small class="entity-id">@_selected.EntityId</small></div><div class="admin-meta-card"><span>عملیات</span><strong><span class="admin-action @GetActionClass(_selected.Action)">@GetActionText(_selected.Action)</span></strong></div></div>
                    <div class="admin-changes"><div class="admin-change-panel"><div class="admin-change-header"><i class="bx bx-history"></i> قبل از تغییر</div><div class="admin-change-body">@RenderJson(_selected.BeforeJson)</div></div><div class="admin-change-arrow"><i class="bx bx-left-arrow-alt"></i></div><div class="admin-change-panel"><div class="admin-change-header"><i class="bx bx-check-circle"></i> بعد از تغییر</div><div class="admin-change-body">@RenderJson(_selected.AfterJson)</div></div></div>
                </div>
                <footer class="admin-modal-footer"><span dir="ltr">@_selected.Id</span><button type="button" class="btn btn-secondary" @onclick="CloseDetails"><i class="bx bx-x"></i> بستن</button></footer>
            </section>
        </div>
    }
</div>

@code {
    private List<AuditRow> _rows = [];
    private AuditRow? _selected;
    private string _employeeSearch = "";
    private string _positionSearch = "";
    private string _entityType = "";
    private string _action = "";
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private int _page = 1;
    private int _pageSize = 20;
    private int _totalCount;
    private bool _loading;
    private bool _hasSearched;
    private CancellationTokenSource? _loadCts;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)_pageSize));

    private async Task SearchAsync(){if(_loading)return;await LoadPageAsync(1);}
    private async Task LoadPageAsync(int page)
    {
        _loadCts?.Cancel();_loadCts?.Dispose();_loadCts=new CancellationTokenSource();var cts=_loadCts;var token=cts.Token;_loading=true;_hasSearched=true;_page=page;await InvokeAsync(StateHasChanged);
        try
        {
            await using var db=await DbFactory.CreateDbContextAsync(token);var query=db.AuditEntries.AsNoTracking().AsQueryable();
            if(!string.IsNullOrWhiteSpace(_entityType))query=query.Where(x=>x.EntityType.Contains(_entityType.Trim()));
            if(!string.IsNullOrWhiteSpace(_action))query=query.Where(x=>x.Action==_action);
            if(_fromDate.HasValue){var from=DateTime.SpecifyKind(_fromDate.Value.Date,DateTimeKind.Local).ToUniversalTime();query=query.Where(x=>x.OccurredAtUtc>=from);}
            if(_toDate.HasValue){var to=DateTime.SpecifyKind(_toDate.Value.Date.AddDays(1),DateTimeKind.Local).ToUniversalTime();query=query.Where(x=>x.OccurredAtUtc<to);}
            var et=_employeeSearch.Trim();var pt=_positionSearch.Trim();
            if(!string.IsNullOrWhiteSpace(et))query=query.Where(x=>x.EmployeeId.HasValue&&db.Employees.Any(e=>e.Id==x.EmployeeId&&e.FullName.Contains(et)));
            if(!string.IsNullOrWhiteSpace(pt))query=query.Where(x=>x.ActivePositionId.HasValue&&db.Positions.Any(p=>p.Id==x.ActivePositionId&&p.Name.Contains(pt)));
            _totalCount=await query.CountAsync(token);if(_page>TotalPages)_page=TotalPages;
            var entries=await query.OrderByDescending(x=>x.OccurredAtUtc).Skip((_page-1)*_pageSize).Take(_pageSize).ToListAsync(token);
            var eids=entries.Where(x=>x.EmployeeId.HasValue).Select(x=>x.EmployeeId!.Value).Distinct().ToList();var pids=entries.Where(x=>x.ActivePositionId.HasValue).Select(x=>x.ActivePositionId!.Value).Distinct().ToList();
            var employees=await db.Employees.AsNoTracking().Where(x=>eids.Contains(x.Id)).ToDictionaryAsync(x=>x.Id,x=>x.FullName,token);var positions=await db.Positions.AsNoTracking().Where(x=>pids.Contains(x.Id)).ToDictionaryAsync(x=>x.Id,x=>x.Name,token);
            var rows=entries.Select(x=>new AuditRow(x.Id,x.OccurredAtUtc,x.EmployeeId,x.ActivePositionId,x.EmployeeId is Guid ei&&employees.TryGetValue(ei,out var en)?en:null,x.ActivePositionId is Guid pi&&positions.TryGetValue(pi,out var pn)?pn:null,x.Action,x.EntityType,x.EntityId,x.BeforeJson,x.AfterJson)).ToList();token.ThrowIfCancellationRequested();_rows=rows;
        }
        catch(OperationCanceledException)when(token.IsCancellationRequested){}
        finally{if(ReferenceEquals(_loadCts,cts)){_loading=false;await InvokeAsync(StateHasChanged);}}
    }
    private async Task ClearOrCancelAsync(){if(_loading){_loadCts?.Cancel();return;}_employeeSearch="";_positionSearch="";_entityType="";_action="";_fromDate=null;_toDate=null;_page=1;_totalCount=0;_rows.Clear();_selected=null;_hasSearched=false;await InvokeAsync(StateHasChanged);}
    private async Task OnPageSizeChangedAsync(int size){_pageSize=size;_page=1;if(_hasSearched)await LoadPageAsync(1);}
    private async Task GoToPageAsync(int p){if(_hasSearched)await LoadPageAsync(p);}
    private void ShowDetails(AuditRow r)=>_selected=r;private void CloseDetails()=>_selected=null;
    private static string GetActionText(string a)=>a switch{"Created"=>"ایجاد","Updated"=>"ویرایش","Deleted"=>"حذف",_=>a};
    private static string GetActionClass(string a)=>a switch{"Created"=>"admin-action--success","Deleted"=>"admin-action--danger","Updated"=>"admin-action--warning",_=>"admin-action--neutral"};
    private static string GetActionIcon(string a)=>a switch{"Created"=>"bx-plus","Deleted"=>"bx-trash",_=>"bx-edit-alt"};
    private static string GetEntityText(string e)=>e switch{"Permission"=>"مجوز","Employee"=>"کارمند","Position"=>"سمت","Organization"=>"سازمان","EmployeePosition"=>"تخصیص سمت","PermissionGroup"=>"گروه مجوز",_=>e};
    private static string ToPersianDate(DateTime date){var pc=new System.Globalization.PersianCalendar();return ToPersianDigits($"{pc.GetYear(date):0000}/{pc.GetMonth(date):00}/{pc.GetDayOfMonth(date):00}");}
    private static string ToPersianDigits(string value)=>value.Replace("0","۰").Replace("1","۱").Replace("2","۲").Replace("3","۳").Replace("4","۴").Replace("5","۵").Replace("6","۶").Replace("7","۷").Replace("8","۸").Replace("9","۹");
    private static RenderFragment RenderJson(string? json)=>builder=>{if(string.IsNullOrWhiteSpace(json)){builder.AddMarkupContent(0,"<div class='admin-no-change'>بدون تغییر</div>");return;}try{using var doc=JsonDocument.Parse(json);var i=0;builder.OpenElement(i++,"div");builder.AddAttribute(i++,"class","admin-json-properties");foreach(var p in doc.RootElement.EnumerateObject()){builder.OpenElement(i++,"div");builder.AddAttribute(i++,"class","admin-json-property");builder.OpenElement(i++,"span");builder.AddAttribute(i++,"class","admin-json-key");builder.AddContent(i++,GetPropertyText(p.Name));builder.CloseElement();builder.OpenElement(i++,"span");builder.AddAttribute(i++,"class","admin-json-value");builder.AddContent(i++,FormatJsonValue(p.Value));builder.CloseElement();builder.CloseElement();}builder.CloseElement();}catch{builder.AddMarkupContent(0,$"<pre class='admin-json-fallback'>{System.Net.WebUtility.HtmlEncode(json)}</pre>");}};
    private static string GetPropertyText(string n)=>n switch{"Id"=>"شناسه","Code"=>"کد","Name"=>"نام","FullName"=>"نام و نام خانوادگی","Username"=>"نام کاربری","IsActive"=>"فعال","OrganizationId"=>"سازمان","PositionId"=>"سمت","EmployeeId"=>"کارمند","StartedAt"=>"تاریخ شروع","EndedAt"=>"تاریخ پایان",_=>n};
    private static string FormatJsonValue(JsonElement v)=>v.ValueKind switch{JsonValueKind.Null=>"-",JsonValueKind.True=>"بله",JsonValueKind.False=>"خیر",JsonValueKind.String=>v.GetString()??"-",_=>v.ToString()};
    private sealed record AuditRow(Guid Id,DateTime OccurredAtUtc,Guid? EmployeeId,Guid? ActivePositionId,string? EmployeeName,string? PositionName,string Action,string EntityType,string? EntityId,string? BeforeJson,string? AfterJson);
    public async ValueTask DisposeAsync(){_loadCts?.Cancel();_loadCts?.Dispose();await Task.CompletedTask;}
}
