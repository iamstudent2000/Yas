    private string FormatJsonValue(string propertyName,JsonElement v)
    {
        if(v.ValueKind==JsonValueKind.String)
        {
            var s=v.GetString();
            if(propertyName!="Id"&&s is not null&&Guid.TryParse(s,out var id)&&_idNameMap.TryGetValue(id,out var name))return name;
            // Times are stored in UTC (SentAtUtc, CreatedAtUtc, ...); show them as the local Persian date and time.
            if(s is not null&&propertyName.EndsWith("AtUtc",StringComparison.Ordinal)&&DateTime.TryParse(s,System.Globalization.CultureInfo.InvariantCulture,System.Globalization.DateTimeStyles.RoundtripKind,out var moment))
            {
                var utc=moment.Kind==DateTimeKind.Unspecified?DateTime.SpecifyKind(moment,DateTimeKind.Utc):moment.ToUniversalTime();
                var local=utc.ToLocalTime();
                return ToPersianDate(local)+" "+ToPersianDigits(local.ToString("HH:mm:ss"));
            }
            // Event details (searches, request views) store enums by name; show the same wording as the request pages.
            if(s is not null)
            {
                var named=propertyName switch{
                    "NotificationKind"=>Enum.TryParse<YasPortal.Domain.Notifications.NotificationKind>(s,out var notificationKind)?notificationKind switch{
                        YasPortal.Domain.Notifications.NotificationKind.StepReached=>"رسیدن درخواست به مرحله",YasPortal.Domain.Notifications.NotificationKind.ReturnedToStep=>"بازگشت به مرحله",
                        YasPortal.Domain.Notifications.NotificationKind.RequestApproved=>"تایید درخواست",YasPortal.Domain.Notifications.NotificationKind.RequestRejected=>"رد درخواست",
                        YasPortal.Domain.Notifications.NotificationKind.RequestReturned=>"بازگشت به درخواست‌کننده",YasPortal.Domain.Notifications.NotificationKind.RequestForceClosed=>"بسته‌شدن توسط مدیر",
                        YasPortal.Domain.Notifications.NotificationKind.RequestReopened=>"بازگشایی درخواست",YasPortal.Domain.Notifications.NotificationKind.DelegationReceived=>"دریافت نمایندگی",
                        YasPortal.Domain.Notifications.NotificationKind.RequestCreatedForYou=>"ثبت درخواست برای شما",YasPortal.Domain.Notifications.NotificationKind.VacantPosition=>"سمت خالی",
                        YasPortal.Domain.Notifications.NotificationKind.Manual=>"پیام دستی",_=>null}:null,
                    "Status"=>Enum.TryParse<WorkflowRequestStatus>(s,out var requestStatus)&&Enum.IsDefined(requestStatus)?WorkflowDisplay.StatusLabel(requestStatus):null,
                    "Type"=>Enum.TryParse<WorkflowTypeCode>(s,out var typeCode)&&Enum.IsDefined(typeCode)?WorkflowFieldCatalog.GetDisplayName(typeCode):null,
                    "CancelledBy"=>s switch{"ByRequester"=>"لغو توسط درخواست‌کننده","ByAdmin"=>"بسته‌شده توسط مدیر",_=>null},
                    _=>null};
                if(named is not null)return named;
            }
            if(propertyName=="Reason"&&s is not null)return s switch{AuditReasons.UnknownOrInactive=>"کاربر ناشناس یا غیرفعال",AuditReasons.BadPassword=>"رمز عبور نادرست",AuditReasons.NoPosition=>"بدون سمت فعال",AuditReasons.IdentityInvalid=>"هویت دیگر معتبر نیست (کاربر غیرفعال یا نقش/سمت تغییر کرده)",_=>s};
            return s??"-";
        }
        // Enums are stored as numbers; show the same wording the request pages use.
        if(v.ValueKind==JsonValueKind.Number&&v.TryGetInt32(out var n))
        {
            var label=(_selected?.EntityType,propertyName)switch{
                ("WorkflowRequest","Status")=>WorkflowDisplay.StatusLabel((WorkflowRequestStatus)n),
                ("WorkflowRequest","WorkflowType")=>WorkflowFieldCatalog.GetDisplayName((WorkflowTypeCode)n),
                ("WorkflowStepDecision","Outcome") or ("WorkflowRequestStep","Status")=>WorkflowDisplay.StepLabel((WorkflowStepStatus)n,isCurrent:false),
                ("WorkflowRequesterAction","Kind")=>(WorkflowRequesterActionKind)n switch{WorkflowRequesterActionKind.Submitted=>"ثبت",WorkflowRequesterActionKind.Resubmitted=>"ارسال مجدد",WorkflowRequesterActionKind.Cancelled=>"لغو",WorkflowRequesterActionKind.Reopened=>"بازگشایی",_=>null},
                _=>null};
            if(label is not null)return label;
        }
        return v.ValueKind switch{JsonValueKind.Null=>"-",JsonValueKind.True=>"بله",JsonValueKind.False=>"خیر",_=>v.ToString()};
    }
    private sealed record AuditRow(Guid Id,DateTime OccurredAtUtc,Guid? EmployeeId,Guid? ActivePositionId,string? EmployeeName,string? PositionName,string Action,string EntityType,string? EntityId,string? EntityName,string? BeforeJson,string? AfterJson);
    public async ValueTask DisposeAsync(){_loadCts?.Cancel();_loadCts?.Dispose();await Task.CompletedTask;}
}
