@page "/admin/audit-log"
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Components.Shared
@attribute [Authorize(Policy = "Admin.AuditLog")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>گزارش رویدادها - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <header class="admin-page-header">
        <div><div class="admin-breadcrumb">مدیریت سامانه / گزارش رویدادها</div><h1>گزارش رویدادها</h1><p>تغییرات مهم سامانه همراه با کاربر و سمت فعال ثبت می‌شوند.</p></div>
        <a class="admin-btn admin-btn-secondary" href="/dashboard"><i class="bx bx-arrow-back"></i> داشبورد</a>
    </header>
    <section class="admin-card">
        <div class="admin-filter-grid">
            <div class="admin-filter-field"><label>کاربر</label><input class="admin-input" placeholder="نام کاربر..." @bind="_employeeSearch" /></div>
            <div class="admin-filter-field"><label>سمت فعال</label><input class="admin-input" placeholder="نام سمت..." @bind="_positionSearch" /></div>
            <div class="admin-filter-field"><label>موجودیت</label><input class="admin-input" placeholder="مثلاً Permission" @bind="_entityType" /></div>
            <div class="admin-filter-field"><label>عملیات</label><select class="admin-input" @bind="_action"><option value="">همه عملیات</option><option value="Created">ایجاد</option><option value="Updated">ویرایش</option><option value="Deleted">حذف</option></select></div>
            <div class="admin-filter-field"><label>از تاریخ</label><PersianDatePicker @bind-Value="_fromDate" Placeholder="تاریخ شروع" /></div>
            <div class="admin-filter-field"><label>تا تاریخ</label><PersianDatePicker @bind-Value="_toDate" Placeholder="تاریخ پایان" /></div>
        </div>
        <div class="admin-filter-footer"><div class="admin-filter-chips">
            @if (_fromDate.HasValue) { <span class="admin-chip">از @ToPersianDate(_fromDate.Value)<button type="button" @onclick="RemoveFromDateAsync">×</button></span> }
            @if (_toDate.HasValue) { <span class="admin-chip">تا @ToPersianDate(_toDate.Value)<button type="button" @onclick="RemoveToDateAsync">×</button></span> }
            @if (!string.IsNullOrWhiteSpace(_employeeSearch)) { <span class="admin-chip">کاربر: @_employeeSearch</span> }
            @if (!string.IsNullOrWhiteSpace(_positionSearch)) { <span class="admin-chip">سمت: @_positionSearch</span> }
            @if (!string.IsNullOrWhiteSpace(_entityType)) { <span class="admin-chip">موجودیت: @_entityType</span> }
            @if (!string.IsNullOrWhiteSpace(_action)) { <span class="admin-chip">عملیات: @GetActionText(_action)</span> }
        </div><div class="admin-filter-actions"><button class="admin-btn admin-btn-primary" @onclick="SearchAsync"><i class="bx bx-search"></i> جستجو</button><button class="admin-btn admin-btn-secondary" @onclick="ClearFiltersAsync"><i class="bx bx-reset"></i> پاک کردن</button></div></div>
        @if (_loading) { <div class="admin-empty">در حال بارگذاری...</div> }
        else if (_rows.Count == 0) { <div class="admin-empty">رویدادی مطابق فیلترها پیدا نشد.</div> }
        else {
            <div class="admin-toolbar"><span>@_totalCount.ToString("N0") رویداد مطابق فیلترها</span><div class="admin-page-size"><label>تعداد در صفحه</label><select class="admin-input" @bind="_pageSize" @bind:after="PageSizeChangedAsync"><option value="50">50</option><option value="100">100</option><option value="200">200</option></select></div></div>
            <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>زمان</th><th>کاربر</th><th>سمت فعال</th><th>عملیات</th><th>موجودیت</th><th>جزئیات</th></tr></thead><tbody>
            @foreach (var row in _rows) { <tr @key="row.Id"><td class="admin-time">@row.OccurredAtUtc.ToLocalTime().ToString("yyyy/MM/dd")<small>@row.OccurredAtUtc.ToLocalTime().ToString("HH:mm:ss")</small></td><td><div class="admin-actor"><span class="admin-avatar"><i class="bx bx-user"></i></span><span class="admin-truncate">@(row.EmployeeName ?? (row.EmployeeId is null ? "سیستم" : row.EmployeeId.ToString()))</span></div></td><td><span class="admin-truncate">@(row.PositionName ?? (row.ActivePositionId is null ? "-" : row.ActivePositionId.ToString()))</span></td><td><span class="admin-badge @GetActionClass(row.Action)"><i class="bx @GetActionIcon(row.Action)"></i>@GetActionText(row.Action)</span></td><td><div class="admin-entity"><strong>@GetEntityText(row.EntityType)</strong><small title="@row.EntityId">@row.EntityId</small></div></td><td><button class="admin-details-btn" @onclick="() => ShowDetails(row)"><i class="bx bx-show-alt"></i> مشاهده جزئیات</button></td></tr> }
            </tbody></table></div>
            <div class="admin-pagination"><button class="admin-page-btn" disabled="@(_page <= 1)" @onclick="PreviousPageAsync"><i class="bx bx-chevron-right"></i> قبلی</button><div class="admin-page-numbers">@foreach (var pageNumber in GetPageNumbers()) { <button class="admin-page-number @(pageNumber == _page ? "active" : "")" @onclick="() => GoToPageAsync(pageNumber)">@(pageNumber)</button> }</div><button class="admin-page-btn" disabled="@(_page >= TotalPages)" @onclick="NextPageAsync">بعدی <i class="bx bx-chevron-left"></i></button></div>
        }
    </section>
</div>

@if (_selected is not null) { <div class="admin-overlay" @onclick="CloseDetails"><div class="admin-modal" dir="rtl" @onclick:stopPropagation="true"><div class="admin-modal-header"><div><div class="admin-modal-kicker">گزارش رویداد</div><h2>@GetActionText(_selected.Action) @GetEntityText(_selected.EntityType)</h2><div class="admin-modal-time"><i class="bx bx-time-five"></i>@_selected.OccurredAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</div></div><button class="admin-close" @onclick="CloseDetails" aria-label="بستن"><i class="bx bx-x"></i></button></div><div class="admin-meta-grid"><div class="admin-meta-card"><span><i class="bx bx-user"></i> کاربر</span><strong>@(_selected.EmployeeName ?? (_selected.EmployeeId is null ? "سیستم" : _selected.EmployeeId.ToString()))</strong></div><div class="admin-meta-card"><span><i class="bx bx-briefcase"></i> سمت فعال</span><strong>@(_selected.PositionName ?? (_selected.ActivePositionId is null ? "-" : _selected.ActivePositionId.ToString()))</strong></div><div class="admin-meta-card"><span><i class="bx bx-category"></i> موجودیت</span><strong>@GetEntityText(_selected.EntityType)</strong><small>@_selected.EntityId</small></div><div class="admin-meta-card"><span><i class="bx bx-bolt-circle"></i> عملیات</span><strong><span class="admin-badge @GetActionClass(_selected.Action)">@GetActionText(_selected.Action)</span></strong></div></div><div class="admin-changes"><div class="admin-change-panel"><div class="admin-change-header"><i class="bx bx-history"></i> قبل از تغییر</div><div class="admin-change-body">@RenderJson(_selected.BeforeJson)</div></div><div class="admin-change-arrow"><i class="bx bx-left-arrow-alt"></i></div><div class="admin-change-panel"><div class="admin-change-header"><i class="bx bx-check-circle"></i> بعد از تغییر</div><div class="admin-change-body">@RenderJson(_selected.AfterJson)</div></div></div><div class="admin-modal-footer"><span>شناسه رویداد: @_selected.Id</span><button class="admin-btn admin-btn-secondary" @onclick="CloseDetails">بستن</button></div></div></div> }

@code {
    private List<AuditRow> _rows = [];
    private AuditRow? _selected;
    private string _employeeSearch = ""; private string _positionSearch = ""; private string _entityType = ""; private string _action = "";
    private DateTime? _fromDate = DateTime.Today; private DateTime? _toDate = DateTime.Today; private int _page = 1; private int _pageSize = 200; private int _totalCount; private bool _loading;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)_pageSize));
    protected override async Task OnInitializedAsync() => await SearchAsync();
    private async Task SearchAsync(){_loading=true;try{await using var db=await DbFactory.CreateDbContextAsync();var query=db.AuditEntries.AsNoTracking().AsQueryable();if(!string.IsNullOrWhiteSpace(_entityType))query=query.Where(x=>x.EntityType.Contains(_entityType.Trim()));if(!string.IsNullOrWhiteSpace(_action))query=query.Where(x=>x.Action==_action);if(_fromDate.HasValue){var from=DateTime.SpecifyKind(_fromDate.Value.Date,DateTimeKind.Local).ToUniversalTime();query=query.Where(x=>x.OccurredAtUtc>=from);}if(_toDate.HasValue){var to=DateTime.SpecifyKind(_toDate.Value.Date.AddDays(1),DateTimeKind.Local).ToUniversalTime();query=query.Where(x=>x.OccurredAtUtc<to);}var et=_employeeSearch.Trim();var pt=_positionSearch.Trim();if(!string.IsNullOrWhiteSpace(et))query=query.Where(x=>x.EmployeeId.HasValue&&db.Employees.Any(e=>e.Id==x.EmployeeId&&e.FullName.Contains(et)));if(!string.IsNullOrWhiteSpace(pt))query=query.Where(x=>x.ActivePositionId.HasValue&&db.Positions.Any(p=>p.Id==x.ActivePositionId&&p.Name.Contains(pt)));_totalCount=await query.CountAsync();if(_page>TotalPages)_page=TotalPages;var pageEntries=await query.OrderByDescending(x=>x.OccurredAtUtc).Skip((_page-1)*_pageSize).Take(_pageSize).ToListAsync();var eids=pageEntries.Where(x=>x.EmployeeId.HasValue).Select(x=>x.EmployeeId!.Value).Distinct().ToList();var pids=pageEntries.Where(x=>x.ActivePositionId.HasValue).Select(x=>x.ActivePositionId!.Value).Distinct().ToList();var employees=await db.Employees.AsNoTracking().Where(x=>eids.Contains(x.Id)).ToDictionaryAsync(x=>x.Id,x=>x.FullName);var positions=await db.Positions.AsNoTracking().Where(x=>pids.Contains(x.Id)).ToDictionaryAsync(x=>x.Id,x=>x.Name);_rows=pageEntries.Select(x=>new AuditRow(x.Id,x.OccurredAtUtc,x.EmployeeId,x.ActivePositionId,x.EmployeeId is Guid ei&&employees.TryGetValue(ei,out var en)?en:null,x.ActivePositionId is Guid pi&&positions.TryGetValue(pi,out var pn)?pn:null,x.Action,x.EntityType,x.EntityId,x.BeforeJson,x.AfterJson)).ToList();}finally{_loading=false;}}
    private async Task PageSizeChangedAsync(){_page=1;await SearchAsync();} private async Task ClearFiltersAsync(){_employeeSearch="";_positionSearch="";_entityType="";_action="";_fromDate=DateTime.Today;_toDate=DateTime.Today;_page=1;await SearchAsync();} private async Task RemoveFromDateAsync(){_fromDate=null;_page=1;await SearchAsync();} private async Task RemoveToDateAsync(){_toDate=null;_page=1;await SearchAsync();} private async Task GoToPageAsync(int p){_page=p;await SearchAsync();} private async Task PreviousPageAsync(){if(_page>1){_page--;await SearchAsync();}} private async Task NextPageAsync(){if(_page<TotalPages){_page++;await SearchAsync();}}
    private IEnumerable<int> GetPageNumbers(){var s=Math.Max(1,_page-2);var e=Math.Min(TotalPages,s+4);s=Math.Max(1,e-4);return Enumerable.Range(s,e-s+1);} private void ShowDetails(AuditRow r)=>_selected=r; private void CloseDetails()=>_selected=null;
    private static string GetActionText(string a)=>a switch{"Created"=>"ایجاد","Updated"=>"ویرایش","Deleted"=>"حذف",_=>a}; private static string GetActionClass(string a)=>a switch{"Created"=>"created","Deleted"=>"deleted",_=>"updated"}; private static string GetActionIcon(string a)=>a switch{"Created"=>"bx-plus","Deleted"=>"bx-trash",_=>"bx-edit-alt"}; private static string GetEntityText(string e)=>e switch{"Permission"=>"مجوز","Employee"=>"کارمند","Position"=>"سمت","Organization"=>"سازمان","EmployeePosition"=>"تخصیص سمت","PermissionGroup"=>"گروه مجوز",_=>e};
    private static string ToPersianDate(DateTime date){var pc=new System.Globalization.PersianCalendar();return ToPersianDigits($"{pc.GetYear(date):0000}/{pc.GetMonth(date):00}/{pc.GetDayOfMonth(date):00}");} private static string ToPersianDigits(string value)=>value.Replace("0","۰").Replace("1","۱").Replace("2","۲").Replace("3","۳").Replace("4","۴").Replace("5","۵").Replace("6","۶").Replace("7","۷").Replace("8","۸").Replace("9","۹");
    private static RenderFragment RenderJson(string? json)=>builder=>{if(string.IsNullOrWhiteSpace(json)){builder.AddMarkupContent(0,"<div class='admin-no-change'>بدون تغییر</div>");return;}try{using var doc=JsonDocument.Parse(json);var i=0;builder.OpenElement(i++,"div");builder.AddAttribute(i++,"class","admin-json-properties");foreach(var p in doc.RootElement.EnumerateObject()){builder.OpenElement(i++,"div");builder.AddAttribute(i++,"class","admin-json-property");builder.OpenElement(i++,"span");builder.AddAttribute(i++,"class","admin-json-key");builder.AddContent(i++,GetPropertyText(p.Name));builder.CloseElement();builder.OpenElement(i++,"span");builder.AddAttribute(i++,"class","admin-json-value");builder.AddContent(i++,FormatJsonValue(p.Value));builder.CloseElement();builder.CloseElement();}builder.CloseElement();}catch{builder.AddMarkupContent(0,$"<pre class='admin-json-fallback'>{System.Net.WebUtility.HtmlEncode(json)}</pre>");}};
    private static string GetPropertyText(string n)=>n switch{"Id"=>"شناسه","Code"=>"کد","Name"=>"نام","FullName"=>"نام و نام خانوادگی","Username"=>"نام کاربری","IsActive"=>"فعال","OrganizationId"=>"سازمان","PositionId"=>"سمت","EmployeeId"=>"کارمند","StartedAt"=>"تاریخ شروع","EndedAt"=>"تاریخ پایان",_=>n}; private static string FormatJsonValue(JsonElement v)=>v.ValueKind switch{JsonValueKind.Null=>"-",JsonValueKind.True=>"بله",JsonValueKind.False=>"خیر",JsonValueKind.String=>v.GetString()??"-",_=>v.ToString()};
    private sealed record AuditRow(Guid Id,DateTime OccurredAtUtc,Guid? EmployeeId,Guid? ActivePositionId,string? EmployeeName,string? PositionName,string Action,string EntityType,string? EntityId,string? BeforeJson,string? AfterJson);
}
