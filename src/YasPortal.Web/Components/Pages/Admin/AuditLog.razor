tom:1px solid #e2e8f0}.change-body{padding:8px;max-height:390px;overflow:auto}.json-properties{display:flex;flex-direction:column}.json-property{display:grid;grid-template-columns:minmax(110px,35%) 1fr;gap:10px;padding:10px 8px;border-bottom:1px solid #f1f5f9;font-size:12px}.json-key{color:#64748b;font-weight:600}.json-value{color:#0f172a;word-break:break-word;direction:auto}.no-change{text-align:center;color:#94a3b8;padding:45px 10px;font-size:13px}.json-fallback{white-space:pre-wrap;direction:ltr;text-align:left;font-size:11px;margin:0;padding:10px;background:#f8fafc;border-radius:8px}.change-arrow{display:flex;align-items:center;justify-content:center;color:#94a3b8;font-size:24px}.audit-modal-footer{display:flex;align-items:center;justify-content:space-between;margin-top:18px;padding-top:14px;border-top:1px solid #e2e8f0;color:#94a3b8;font-size:10px}
