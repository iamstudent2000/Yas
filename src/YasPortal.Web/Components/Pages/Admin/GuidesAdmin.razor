@page "/admin/guides"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Domain.Guides
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize(Policy = Perm.AdminGuidesView)]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IPermissionChecker PermissionChecker
@inject AppState AppState

<PageTitle>مدیریت راهنماهای کاربری - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <div class="page-header">
        <div>
            <div class="page-kicker">مدیریت سامانه</div>
            <h1 class="page-title"><i class="ti @Icons.Guide"></i> راهنماهای کاربری</h1>
            <p class="page-subtitle">@(_canManage ? "" : "فقط خواندنی. ")راهنماها را خودتان بنویسید: هر راهنما از چند بلوک (پاراگراف، عنوان، فهرست، یادداشت) ساخته می‌شود و هر بلوک جهت و سبک نوشتار خودش را دارد. همه کاربران واردشده راهنماهای فعال را می‌بینند، مگر راهنمایی که به یک مجوز وابسته باشد.</p>
        </div>
        <div class="form-actions">
            <a class="btn btn-secondary" href="/guides"><i class="ti @Icons.Details"></i> مشاهده راهنماها</a>
        </div>
    </div>

    <div class="admin-stack">
        @if (_canManage)
        {
            <section class="card admin-form-row">
                <div class="admin-form-row-head">
                    <h2 class="section-title"><i class="ti @(_editingId is null ? Icons.Add : Icons.Edit)"></i> @(_editingId is null ? "افزودن راهنما" : "ویرایش راهنما")</h2>
                    <p class="muted">عنوان و جهت کلی راهنما را بنویسید، سپس بلوک‌های متن را اضافه کنید. جهت هر بلوک را می‌توان جداگانه تغییر داد (مثلاً یک جمله‌ی انگلیسی در میان متن فارسی).</p>
                </div>
                <div class="admin-row-grid">
                    <div class="form-field is-grow"><label class="form-label">عنوان</label><input class="form-control" @bind="_title" maxlength="@UserGuide.TitleMax" /></div>
                    <div class="form-field"><label class="form-label">جهت راهنما</label>
                        <select class="form-control" @bind="_direction">
                            <option value="@GuideDirection.Rtl">راست‌به‌چپ</option>
                            <option value="@GuideDirection.Ltr">چپ‌به‌راست</option>
                        </select></div>
                    <div class="form-field"><label class="form-label">ترتیب</label><input class="form-control" type="number" @bind="_sortOrder" /></div>
                </div>
                <div class="admin-row-grid" style="margin-top:12px">
                    <div class="form-field is-grow"><label class="form-label">خلاصه (اختیاری)</label><input class="form-control" @bind="_summary" maxlength="@UserGuide.SummaryMax" /></div>
                    <div class="form-field is-grow"><label class="form-label">مجوز مرتبط (اختیاری)</label>
                        <LookupSelect Options="_permissionOptions" Value="@_permission" ValueChanged="k => _permission = k" Placeholder="همه کاربران واردشده" />
                        <p class="muted" style="margin:6px 0 0">اگر مجوزی انتخاب شود، فقط کسانی که آن مجوز را دارند این راهنما را می‌بینند.</p></div>
                </div>

                <div class="guide-blocks-editor">
                    <h3 class="section-title" style="margin:0">متن راهنما <span class="badge badge-muted">@_drafts.Count بلوک</span></h3>
                    @for (var i = 0; i < _drafts.Count; i++)
                    {
                        var index = i;
                        var draft = _drafts[index];
                        <div class="guide-block-edit" @key="draft">
                            <div class="guide-block-edit-head">
                                <strong>بلوک @(index + 1)</strong>
                                <div class="form-actions">
                                    <button type="button" class="btn btn-secondary btn-sm" title="بالا" disabled="@(index == 0)" @onclick="() => Move(index, -1)"><i class="ti @Icons.MoveUp"></i></button>
                                    <button type="button" class="btn btn-secondary btn-sm" title="پایین" disabled="@(index == _drafts.Count - 1)" @onclick="() => Move(index, 1)"><i class="ti @Icons.MoveDown"></i></button>
                                    <button type="button" class="btn btn-danger btn-sm" title="حذف بلوک" @onclick="() => RemoveBlock(index)"><i class="ti @Icons.Delete"></i></button>
                                </div>
                            </div>
                            <textarea class="form-control" rows="@(draft.Kind is GuideBlockKind.Heading or GuideBlockKind.Subheading ? 1 : 3)" dir="@GuideBlocks.DirAttr(draft.Direction ?? _direction)"
                                      placeholder="@(draft.Kind == GuideBlockKind.List ? "هر خط یک مورد فهرست است" : "متن بلوک")" @bind="draft.Text" @bind:event="oninput" maxlength="@GuideBlock.TextMax"></textarea>
                            <div class="guide-block-opts">
                                <div class="form-field"><label class="form-label">نوع</label>
                                    <select class="form-control" @bind="draft.Kind">
                                        <option value="@GuideBlockKind.Paragraph">پاراگراف</option>
                                        <option value="@GuideBlockKind.Heading">عنوان بخش</option>
                                        <option value="@GuideBlockKind.Subheading">زیرعنوان</option>
                                        <option value="@GuideBlockKind.List">فهرست</option>
                                        <option value="@GuideBlockKind.Note">کادر یادداشت</option>
                                    </select></div>
                                <div class="form-field"><label class="form-label">جهت</label>
                                    <select class="form-control" @bind="draft.Direction">
                                        <option value="">مانند راهنما</option>
                                        <option value="@GuideDirection.Rtl">راست‌به‌چپ</option>
                                        <option value="@GuideDirection.Ltr">چپ‌به‌راست</option>
                                    </select></div>
                                <div class="form-field"><label class="form-label">تراز</label>
                                    <select class="form-control" @bind="draft.Align">
                                        <option value="@GuideAlign.Start">ابتدا</option>
                                        <option value="@GuideAlign.Center">وسط</option>
                                        <option value="@GuideAlign.End">انتها</option>
                                        <option value="@GuideAlign.Justify">تراز دوطرفه</option>
                                    </select></div>
                                <div class="form-field"><label class="form-label">اندازه</label>
                                    <select class="form-control" @bind="draft.Size">
                                        <option value="@GuideSize.Normal">معمولی</option>
                                        <option value="@GuideSize.Small">کوچک</option>
                                        <option value="@GuideSize.Large">بزرگ</option>
                                    </select></div>
                                <div class="form-field"><label class="form-label">رنگ</label>
                                    <select class="form-control" @bind="draft.Tone">
                                        <option value="@GuideTone.Default">پیش‌فرض</option>
                                        <option value="@GuideTone.Accent">آبی</option>
                                        <option value="@GuideTone.Success">سبز</option>
                                        <option value="@GuideTone.Warning">نارنجی</option>
                                        <option value="@GuideTone.Danger">قرمز</option>
                                        <option value="@GuideTone.Muted">خاکستری</option>
                                    </select></div>
                                <label class="check-row"><input type="checkbox" @bind="draft.Bold" /> <span>ضخیم</span></label>
                                <label class="check-row"><input type="checkbox" @bind="draft.Italic" /> <span>کج</span></label>
                            </div>
                        </div>
                    }
                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" disabled="@(_drafts.Count >= UserGuide.MaxBlocks)" @onclick="AddBlock"><i class="ti @Icons.Add"></i> افزودن بلوک</button>
                        <button type="button" class="btn btn-secondary" @onclick="() => _showPreview = !_showPreview"><i class="ti @Icons.Details"></i> @(_showPreview ? "بستن پیش‌نمایش" : "پیش‌نمایش")</button>
                    </div>
                    @if (_showPreview)
                    {
                        <div class="guide-preview"><GuideBlocks Blocks="PreviewBlocks()" Direction="_direction" /></div>
                    }
                </div>

                <div class="admin-row-grid" style="margin-top:14px">
                    <div class="form-field admin-row-submit"><div class="form-actions">
                        <button class="btn btn-primary" disabled="@_saving" @onclick="SaveAsync"><i class="ti @Icons.Save"></i> @(_editingId is null ? "افزودن راهنما" : "ذخیره")</button>
                        @if (_editingId is not null)
                        {
                            <button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button>
                        }
                    </div></div>
                </div>
            </section>
        }

        <section class="card table-card">
            <div class="card-toolbar">
                <div>
                    <h2 class="section-title" style="margin:0">فهرست راهنماها</h2>
                    <p class="muted">به ترتیب نمایش. راهنمای غیرفعال برای کاربران دیده نمی‌شود.</p>
                </div>
                <span class="badge badge-muted">@_guides.Count راهنما</span>
            </div>
            @if (_loading)
            {
                <LoadingState />
            }
            else if (_guides.Count == 0)
            {
                <div class="empty-state"><div class="empty-icon"><i class="ti @Icons.Guide"></i></div><strong>راهنمایی نوشته نشده است</strong><span>@(_canManage ? "از فرم بالا نخستین راهنما را بنویسید." : "هنوز راهنمایی ثبت نشده است.")</span></div>
            }
            else
            {
                <div class="data-table-wrap">
                    <table class="data-table data-table-bordered-rows">
                        <thead><tr><th>ترتیب</th><th>راهنما</th><th>جهت</th><th>دسترسی</th><th>بلوک‌ها</th><th>وضعیت</th><th>آخرین ویرایش</th><th>عملیات</th></tr></thead>
                        <tbody>
                        @foreach (var guide in _guides)
                        {
                            <tr>
                                <td>@guide.SortOrder</td>
                                <td dir="@GuideBlocks.DirAttr(guide.Direction)"><strong>@guide.Title</strong>@if (guide.Summary is not null) { <div class="muted">@guide.Summary</div> }</td>
                                <td>@(guide.Direction == GuideDirection.Ltr ? "چپ‌به‌راست" : "راست‌به‌چپ")</td>
                                <td>@if (guide.RelatedPermissionCode is null) { <span class="muted">همه کاربران</span> } else { <span class="badge badge-info" title="@guide.RelatedPermissionCode"><i class="ti @Icons.Permission"></i> @PermissionName(guide.RelatedPermissionCode)</span> }</td>
                                <td>@(_blockCounts.TryGetValue(guide.Id, out var count) ? count : 0)</td>
                                <td><span class="badge @(guide.IsActive ? "badge-success" : "badge-muted")">@(guide.IsActive ? "فعال" : "غیرفعال")</span></td>
                                <td>@guide.UpdatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                <td class="action-cell">
                                    <a class="btn btn-secondary btn-sm" href="/guides/@guide.Id"><i class="ti @Icons.Details"></i> مشاهده</a>
                                    @if (_canManage)
                                    {
                                        <button class="btn btn-secondary btn-sm" @onclick="() => BeginEditAsync(guide)"><i class="ti @Icons.Edit"></i> ویرایش</button>
                                        <button class="btn btn-secondary btn-sm" @onclick="() => ToggleAsync(guide.Id)"><i class="ti @(guide.IsActive ? Icons.Deactivate : Icons.Activate)"></i> @(guide.IsActive ? "غیرفعال" : "فعال")</button>
                                        @if (_confirmDeleteId == guide.Id)
                                        {
                                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteAsync(guide.Id)"><i class="ti @Icons.Delete"></i> تأیید حذف</button>
                                            <button class="btn btn-secondary btn-sm" @onclick="() => _confirmDeleteId = null">انصراف</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-danger btn-sm" @onclick="() => _confirmDeleteId = guide.Id"><i class="ti @Icons.Delete"></i> حذف</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>

@code {
    private sealed class BlockDraft
    {
        public GuideBlockKind Kind { get; set; } = GuideBlockKind.Paragraph;
        public string Text { get; set; } = "";
        public GuideDirection? Direction { get; set; }
        public GuideAlign Align { get; set; } = GuideAlign.Start;
        public GuideSize Size { get; set; } = GuideSize.Normal;
        public GuideTone Tone { get; set; } = GuideTone.Default;
        public bool Bold { get; set; }
        public bool Italic { get; set; }
    }

    private static readonly IReadOnlyList<(string Key, string Text)> _permissionOptions =
        PermissionCatalog.All.OrderBy(x => x.Code, StringComparer.Ordinal).Select(x => (x.Code, $"{x.Name} — {x.Code}")).ToList();

    private bool _loading = true, _canManage, _saving, _showPreview;
    private List<UserGuide> _guides = [];
    private Dictionary<Guid, int> _blockCounts = [];
    private Guid? _editingId, _confirmDeleteId;
    private string _title = "", _summary = "";
    private string? _permission;
    private GuideDirection _direction = GuideDirection.Rtl;
    private int _sortOrder;
    private List<BlockDraft> _drafts = [new()];

    protected override async Task OnInitializedAsync()
    {
        _canManage = await PermissionChecker.HasPermissionAsync(Perm.AdminGuidesManage);
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _guides = await db.UserGuides.AsNoTracking().OrderBy(x => x.SortOrder).ThenBy(x => x.CreatedAtUtc).ToListAsync();
        _blockCounts = (await db.GuideBlocks.AsNoTracking().GroupBy(x => x.GuideId).Select(g => new { g.Key, Count = g.Count() }).ToListAsync()).ToDictionary(x => x.Key, x => x.Count);
        if (_editingId is null) _sortOrder = _guides.Count == 0 ? 1 : _guides.Max(x => x.SortOrder) + 1;
    }

    private static string PermissionName(string code) =>
        PermissionCatalog.All.FirstOrDefault(x => string.Equals(x.Code, code, StringComparison.OrdinalIgnoreCase))?.Name ?? code;

    private void AddBlock()
    {
        if (_drafts.Count < UserGuide.MaxBlocks) _drafts.Add(new BlockDraft());
    }

    private void RemoveBlock(int index)
    {
        if (index < 0 || index >= _drafts.Count) return;
        _drafts.RemoveAt(index);
        if (_drafts.Count == 0) _drafts.Add(new BlockDraft());
    }

    private void Move(int index, int delta)
    {
        var target = index + delta;
        if (index < 0 || index >= _drafts.Count || target < 0 || target >= _drafts.Count) return;
        (_drafts[index], _drafts[target]) = (_drafts[target], _drafts[index]);
    }

    // The preview draws only the blocks that already have text, so a half-written block never breaks it.
    private IReadOnlyList<GuideBlock> PreviewBlocks() =>
        _drafts.Where(x => !string.IsNullOrWhiteSpace(x.Text))
            .Select(x => new GuideBlock(Guid.Empty, 0, x.Kind, x.Text, x.Direction, x.Align, x.Size, x.Tone, x.Bold, x.Italic))
            .ToList();

    private async Task BeginEditAsync(UserGuide guide)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var blocks = await db.GuideBlocks.AsNoTracking().Where(x => x.GuideId == guide.Id).OrderBy(x => x.SortOrder).ToListAsync();
        _editingId = guide.Id;
        _title = guide.Title; _summary = guide.Summary ?? ""; _direction = guide.Direction; _permission = guide.RelatedPermissionCode; _sortOrder = guide.SortOrder;
        _drafts = blocks.Select(b => new BlockDraft { Kind = b.Kind, Text = b.Text, Direction = b.Direction, Align = b.Align, Size = b.Size, Tone = b.Tone, Bold = b.Bold, Italic = b.Italic }).ToList();
        if (_drafts.Count == 0) _drafts.Add(new BlockDraft());
        _showPreview = false;
    }

    private async Task CancelEdit()
    {
        ResetForm();
        await LoadAsync();
    }

    private void ResetForm()
    {
        _editingId = null;
        _title = _summary = "";
        _permission = null;
        _direction = GuideDirection.Rtl;
        _drafts = [new BlockDraft()];
        _showPreview = false;
    }

    private async Task SaveAsync()
    {
        if (_saving || !_canManage || !await PermissionChecker.HasPermissionAsync(Perm.AdminGuidesManage)) return;

        var filled = _drafts.Where(x => !string.IsNullOrWhiteSpace(x.Text)).ToList();
        if (filled.Count == 0) { AppState.AddToast("حداقل یک بلوک با متن لازم است.", ToastLevel.Error); return; }
        if (_permission is not null && !PermissionCatalog.Codes.Contains(_permission, StringComparer.OrdinalIgnoreCase))
        { AppState.AddToast("مجوز انتخاب‌شده در سامانه وجود ندارد.", ToastLevel.Error); return; }

        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            UserGuide guide;
            if (_editingId is Guid id)
            {
                var existing = await db.UserGuides.SingleOrDefaultAsync(x => x.Id == id);
                if (existing is null) { AppState.AddToast("این راهنما دیگر وجود ندارد.", ToastLevel.Error); ResetForm(); await LoadAsync(); return; }
                guide = existing;
                guide.Update(_title, _summary, _direction, _permission, _sortOrder);
                db.GuideBlocks.RemoveRange(await db.GuideBlocks.Where(x => x.GuideId == id).ToListAsync());
            }
            else
            {
                guide = new UserGuide(_title, _summary, _direction, _permission, _sortOrder);
                db.UserGuides.Add(guide);
            }

            var order = 1;
            foreach (var d in filled)
                db.GuideBlocks.Add(new GuideBlock(guide.Id, order++, d.Kind, d.Text, d.Direction, d.Align, d.Size, d.Tone, d.Bold, d.Italic));

            await db.SaveChangesAsync();
            AppState.AddToast(_editingId is null ? "راهنما اضافه شد." : "راهنما ذخیره شد.", ToastLevel.Success);
            ResetForm();
            await LoadAsync();
        }
        catch (ArgumentException ex)
        {
            AppState.AddToast(Explain(ex), ToastLevel.Error);
        }
        catch (Exception)
        {
            AppState.AddToast("ذخیره راهنما انجام نشد.", ToastLevel.Error);
        }
        finally { _saving = false; }
    }

    // The domain's messages are English; the person sees a Persian sentence for the field that failed.
    private static string Explain(ArgumentException ex) => ex.ParamName switch
    {
        "title" => $"عنوان لازم است و حداکثر {UserGuide.TitleMax} نویسه باشد.",
        "summary" => $"خلاصه حداکثر {UserGuide.SummaryMax} نویسه باشد.",
        "text" => $"متن هر بلوک لازم است و حداکثر {GuideBlock.TextMax} نویسه باشد.",
        "relatedPermissionCode" => "مجوز مرتبط معتبر نیست.",
        _ => "اطلاعات راهنما معتبر نیست.",
    };

    private async Task ToggleAsync(Guid id)
    {
        if (!_canManage || !await PermissionChecker.HasPermissionAsync(Perm.AdminGuidesManage)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var guide = await db.UserGuides.SingleOrDefaultAsync(x => x.Id == id);
        if (guide is not null)
        {
            if (guide.IsActive) guide.Deactivate(); else guide.Activate();
            guide.Touch();
            await db.SaveChangesAsync();
        }
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        _confirmDeleteId = null;
        if (!_canManage || !await PermissionChecker.HasPermissionAsync(Perm.AdminGuidesManage)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var guide = await db.UserGuides.SingleOrDefaultAsync(x => x.Id == id);
        if (guide is not null)
        {
            db.UserGuides.Remove(guide);   // its blocks go with it (cascade)
            await db.SaveChangesAsync();
            AppState.AddToast("راهنما حذف شد.", ToastLevel.Success);
        }
        if (_editingId == id) ResetForm();
        await LoadAsync();
    }
}
