@page "/guides/manage"
@page "/admin/guides"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using YasPortal.Domain.Guides
@using YasPortal.Domain.Paging
@using YasPortal.Infrastructure.Guides
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize(Policy = Perm.GuidesWorkspacePolicy)]
@implements IAsyncDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IPermissionChecker PermissionChecker
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState
@inject AppState AppState
@inject GuideProvider GuideFiles
@inject GuideGroupService GuideGroups
@using Microsoft.AspNetCore.Components.Forms

@* Guides management page (/guides/manage and /admin/guides). A guide is a written how-to article for portal users, shown on the *@
@* Guides screen. People with the right permission can write, edit, hide or delete guides here. Someone who may only manage *@
@* their own guides sees and edits only the guides they wrote; people with full rights see every guide. *@
<PageTitle>مدیریت راهنماها - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <SectionTabs Group="content-admin" />
    <div class="page-header">
        <div>
            <div class="page-kicker">مدیریت سامانه</div>
            <h1 class="page-title"><i class="ti @Icons.Guide"></i> مدیریت راهنماها</h1>
            <p class="page-subtitle">@SubtitleLead راهنما را مثل یک سند ساده بنویسید و قالب‌بندی کنید (عنوان، فهرست، رنگ، تراز، راست‌به‌چپ یا چپ‌به‌راست). برای هر راهنما مشخص کنید پیش از ورود هم دیده شود یا فقط پس از ورود.</p>
        </div>
        <div class="form-actions">
            <a class="btn btn-secondary" href="/guides"><i class="ti @Icons.Details"></i> مشاهده راهنماها</a>
        </div>
    </div>

    @* Sub tabs, the same as on the store items page: the list of guides, the form for a new guide, and the groups. *@
    @* Only people who may write guides get the form tab; others just see the list. *@
    @if (_canCreate)
    {
        <div class="form-actions no-print">
            <button class="btn @(_tab == "list" ? "btn-primary" : "btn-secondary")" @onclick="@(() => _tab = "list")">راهنماها</button>
            <button class="btn @(_tab == "form" ? "btn-primary" : "btn-secondary")" @onclick="@(() => _tab = "form")">افزودن راهنما</button>
            @* The groups tab is only for people who may manage every guide, because groups are shared by all guides. *@
            @if (_canEditAll)
            {
                <button class="btn @(_tab == "groups" ? "btn-primary" : "btn-secondary")" @onclick="@(() => _tab = "groups")">گروه‌ها</button>
            }
        </div>
    }

    <div class="admin-stack">
        @* The write/edit form is shown only to people who may create or edit guides. *@
        @* A NEW guide is written on the "add" tab; the form is hidden (not removed) on the list tab, so the text typed in the *@
        @* editor and the picked files are not lost when switching tabs. *@
        @* An EXISTING guide is edited in a window over the list. That window does not close by a click outside it, because *@
        @* a long text could be lost by accident; the form's own cancel button closes it. *@
        @if (_canCreate)
        {
            <FormHost Modal="@(_editingId is not null)" OnClose="CancelEdit" Size="large" CloseOnOutsideClick="false">
            <div hidden="@(_tab != "form" && _editingId is null)">
            <section class="card admin-form-row">
                <div class="admin-form-row-head">
                    <h2 class="section-title"><i class="ti @(_editingId is null ? Icons.Add : Icons.Edit)"></i> @(_editingId is null ? "افزودن راهنما" : "ویرایش راهنما")</h2>
                    <p class="muted">عنوان را بنویسید و متن راهنما را در ویرایشگر زیر تایپ کنید. نوار بالای ویرایشگر برای عنوان، پررنگ‌کردن، فهرست، رنگ، تراز، جهت متن و پیوند است.</p>
                </div>
                <div class="admin-row-grid">
                    <div class="form-field is-grow"><label class="form-label">عنوان</label><input class="form-control" @bind="_title" maxlength="@UserGuide.TitleMax" /></div>
                    <div class="form-field"><label class="form-label">نمایش برای</label>
                        <select class="form-control" @bind="_visibility">
                            <option value="@GuideVisibility.SignedIn">فقط پس از ورود</option>
                            <option value="@GuideVisibility.Public">عمومی (پیش از ورود هم)</option>
                        </select></div>
                    <div class="form-field"><label class="form-label">ترتیب</label><input class="form-control" type="number" @bind="_sortOrder" /></div>
                </div>
                @* A public guide (readable without signing in) also needs a short summary that is shown under its title in the list. *@
                @if (_visibility == GuideVisibility.Public)
                {
                    <p class="muted" style="margin:8px 0 0"><i class="ti @Icons.Warning"></i> هر کسی که به این سامانه دسترسی شبکه‌ای داشته باشد، بدون ورود این راهنما را می‌بیند؛ مطلب غیرعمومی در آن ننویسید.</p>
                }
                <div class="admin-row-grid" style="margin-top:12px">
                    @* The group is picked from the list of groups (made on the groups tab), the same way the store picks an item's group. *@
                    <div class="form-field"><label class="form-label">گروه (اختیاری)</label>
                        <LookupSelect @key="_formKey" Options="FormGroupOptions" Value="@(_groupId?.ToString())" ValueChanged="k => _groupId = Guid.TryParse(k, out var pickedGroup) ? pickedGroup : null" Placeholder="بدون گروه" SearchPlaceholder="جستجوی گروه..." /></div>
                    <div class="form-field is-grow"><label class="form-label">خلاصه (اختیاری، زیر عنوان در فهرست نمایش داده می‌شود)</label><input class="form-control" @bind="_summary" maxlength="@UserGuide.SummaryMax" /></div>
                </div>

                @* Files for readers to download. Existing files can be marked for removal; new ones are added to the list and are stored when the guide is saved. *@
                <div style="margin-top:12px">
                    <label class="form-label">فایل‌های پیوست (اختیاری، تا @UserGuideAttachment.MaxPerGuide فایل، هر کدام حداکثر @(UserGuideAttachment.MaxBytes / (1024 * 1024)) مگابایت)</label>
                    <InputFile @key="_pickKey" class="form-control" multiple accept="@_accept" OnChange="FilesPicked" />
                    @foreach (var file in _existingFiles)
                    {
                        var removed = _removeIds.Contains(file.Id);
                        <div class="guide-file-row @(removed ? "is-removed" : "")">
                            <i class="ti @Icons.Attachment"></i><span>@file.FileName</span><small>@SizeText(file.SizeBytes)</small>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => ToggleRemove(file.Id)">@(removed ? "نگه‌داشتن" : "حذف")</button>
                        </div>
                    }
                    @foreach (var file in _newFiles)
                    {
                        <div class="guide-file-row is-new">
                            <i class="ti @Icons.Attachment"></i><span>@file.Name</span><small>@SizeText(file.Content.Length)</small><span class="badge badge-info">جدید</span>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _newFiles.Remove(file)">حذف</button>
                        </div>
                    }
                    <p class="muted" style="margin:6px 0 0">PDF، تصویر، Word، Excel، PowerPoint، متن و ZIP پذیرفته می‌شود. هر کسی که بتواند راهنما را ببیند (برای راهنمای عمومی، بدون ورود) می‌تواند فایل‌ها را بگیرد.</p>
                </div>

                <div style="margin-top:12px">
                    <label class="form-label">متن راهنما</label>
                    <div @key="_formKey" @ref="_host" class="guide-editor-host"></div>
                    @* If the rich-text editor cannot start in the browser, say so (saving is switched off in that case). *@
                    @if (_editorFailed)
                    {
                        <p class="muted" style="color:var(--danger,#b42318)"><i class="ti @Icons.Alert"></i> ویرایشگر بارگذاری نشد. صفحه را دوباره باز کنید.</p>
                    }
                </div>

                <div class="admin-row-grid" style="margin-top:14px">
                    <div class="form-field admin-row-submit"><div class="form-actions">
                        <button class="btn btn-primary" disabled="@(_saving || _editorFailed)" @onclick="SaveAsync"><i class="ti @Icons.Save"></i> @(_editingId is null ? "افزودن راهنما" : "ذخیره")</button>
                        @if (_editingId is not null)
                        {
                            <button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button>
                        }
                    </div></div>
                </div>
            </section>
            </div>
            </FormHost>
        }

        @* Groups tab (only for people who may manage every guide): add, rename, order, switch on or off and delete the groups that gather *@
        @* guides under one heading on the guides page. It works like the groups of the store. An existing group is edited in a window over the list. *@
        @if (_tab == "groups" && _canEditAll)
        {
            <FormHost Modal="@(_editGroupId is not null)" OnClose="ResetGroupForm" Size="small" CloseOnOutsideClick="true">
            <section class="card admin-form-row">
                <div class="admin-form-row-head">
                    <h2 class="section-title"><i class="ti @(_editGroupId is null ? Icons.Add : Icons.Edit)"></i> @(_editGroupId is null ? "افزودن گروه" : "ویرایش گروه")</h2>
                    <p class="muted">مثلاً «درخواست‌ها» یا «فروشگاه». راهنماهای هر گروه در صفحه راهنماها زیر یک عنوان می‌آیند.</p>
                </div>
                <div class="admin-row-grid">
                    <div class="form-field is-grow"><label class="form-label">نام گروه</label><input class="form-control" @bind="_groupName" maxlength="@UserGuideGroup.NameMax" /></div>
                    <div class="form-field"><label class="form-label">ترتیب</label><input class="form-control" type="number" @bind="_groupOrder" /></div>
                    <div class="form-field admin-row-submit"><div class="form-actions">
                        <button class="btn btn-primary" disabled="@_groupBusy" @onclick="SaveGroupAsync"><i class="ti @Icons.Save"></i> @(_editGroupId is null ? "افزودن گروه" : "ذخیره")</button>
                        @if (_editGroupId is not null) { <button class="btn btn-secondary" @onclick="ResetGroupForm">انصراف</button> }
                    </div></div>
                </div>
            </section>
            </FormHost>

            @* The list of groups with the number of guides in each, and buttons to edit, switch on or off and delete (delete asks twice). *@
            <section class="card">
                <h2 class="section-title"><i class="ti @Icons.Guide"></i> گروه‌ها</h2>
                <p class="muted">گروهِ غیرفعال همراه با راهنماهایش از دید کاربران پنهان می‌شود (خود راهنماها پاک نمی‌شوند). گروهی که راهنما دارد حذف نمی‌شود.</p>
                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead><tr><th>نام</th><th>ترتیب</th><th>تعداد راهنما</th><th>وضعیت</th><th>عملیات</th></tr></thead>
                        <tbody>
                            @foreach (var group in _groups)
                            {
                                <tr>
                                    <td>@group.Name</td>
                                    <td>@group.SortOrder</td>
                                    <td>@(_groupCounts.TryGetValue(group.Id, out var guideCount) ? guideCount : 0)</td>
                                    <td>@if (group.IsActive) { <span class="badge badge-success">فعال</span> } else { <span class="badge badge-muted">غیرفعال</span> }</td>
                                    <td><div class="form-actions">
                                        <button class="btn btn-secondary btn-sm" @onclick="() => BeginEditGroup(group)"><i class="ti @Icons.Edit"></i> ویرایش</button>
                                        <button class="btn btn-secondary btn-sm" disabled="@_groupBusy" @onclick="() => ToggleGroupAsync(group)">@(group.IsActive ? "غیرفعال‌کردن" : "فعال‌کردن")</button>
                                        @if (_confirmGroupId == group.Id)
                                        {
                                            <button class="btn btn-danger btn-sm" disabled="@_groupBusy" @onclick="() => DeleteGroupAsync(group.Id)"><i class="ti @Icons.Delete"></i> تأیید حذف</button>
                                            <button class="btn btn-secondary btn-sm" @onclick="() => _confirmGroupId = null">انصراف</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-danger btn-sm" @onclick="() => _confirmGroupId = group.Id"><i class="ti @Icons.Delete"></i> حذف</button>
                                        }
                                    </div></td>
                                </tr>
                            }
                            @if (_groups.Count == 0) { <tr><td colspan="5" class="muted">هنوز گروهی تعریف نشده است.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        @* Everything below is the list tab: the search card and the table of guides. *@
        @if (_tab == "list")
        {
        @* Search card, like the other lists: nothing is filtered until "جستجو" is pressed. It looks at title, summary and group. *@
        <ListFilterBar Busy="_loading" ActiveCount="FilterCount" CanClear="@(FilterCount > 0 || HasDraft)" OnSearch="ApplyFilters" OnClear="ClearFilters">
            <div class="admin-filter"><label class="form-label">جستجو</label>
                <input class="form-control" placeholder="عنوان، خلاصه یا گروه..." @bind="_dSearch" @bind:event="oninput" /></div>
            <div class="admin-filter"><label class="form-label">گروه</label>
                <LookupSelect Options="GroupOptions" Value="@_dGroup" ValueChanged="k => _dGroup = string.IsNullOrEmpty(k) ? null : k" Placeholder="همه گروه‌ها" SearchPlaceholder="جستجوی گروه..." /></div>
            <div class="admin-filter"><label class="form-label">وضعیت</label>
                <LookupSelect Options="StatusOptions" Value="@_dStatus" ValueChanged="k => _dStatus = string.IsNullOrEmpty(k) ? null : k" Placeholder="همه" /></div>
        </ListFilterBar>

        @* The list of guides the person is allowed to see, with actions to open, edit, show/hide and delete. *@
        <section class="card table-card">
            <div class="card-toolbar">
                <div>
                    <h2 class="section-title" style="margin:0">فهرست راهنماها</h2>
                    <p class="muted">به ترتیب نمایش. راهنمای غیرفعال برای کاربران دیده نمی‌شود.</p>
                </div>
                <span class="badge badge-muted">@(FilterCount > 0 ? $"{Shown.Count} از {_guides.Count}" : _guides.Count.ToString()) راهنما</span>
            </div>
            @if (_loading)
            {
                <LoadingState />
            }
            else if (_guides.Count == 0)
            {
                <div class="empty-state"><div class="empty-icon"><i class="ti @Icons.Guide"></i></div><strong>راهنمایی نوشته نشده است</strong><span>@(_canCreate ? "از فرم بالا نخستین راهنما را بنویسید." : "هنوز راهنمایی ثبت نشده است.")</span></div>
            }
            else if (Shown.Count == 0)
            {
                <div class="empty-state"><div class="empty-icon"><i class="ti @Icons.Search"></i></div><strong>راهنمایی با این فیلتر پیدا نشد</strong><span>فیلترها را تغییر دهید یا پاک کنید.</span></div>
            }
            else
            {
                var shown = Shown;
                <div class="data-table-wrap">
                    <table class="data-table data-table-bordered-rows">
                        @* Click a heading to sort by it, click again to reverse. The buttons column cannot be sorted. *@
                        <thead><tr>
                            <SortableHeader Text="ترتیب" Column="order" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortBy" />
                            <SortableHeader Text="راهنما" Column="title" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortBy" />
                            <SortableHeader Text="گروه" Column="group" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortBy" />
                            <SortableHeader Text="نویسنده" Column="author" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortBy" />
                            <SortableHeader Text="نمایش برای" Column="visibility" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortBy" />
                            <SortableHeader Text="وضعیت" Column="status" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortBy" />
                            <SortableHeader Text="آخرین ویرایش" Column="updated" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortBy" />
                            <th>عملیات</th>
                        </tr></thead>
                        <tbody>
                        @* One row per guide: order, title, author, who can read it, and the action buttons. *@
                        @foreach (var guide in ListPaging.Slice(shown, _page, _pageSize))
                        {
                            <tr>
                                <td>@guide.SortOrder</td>
                                <td><strong>@guide.Title</strong>@if (_fileCounts.TryGetValue(guide.Id, out var fileCount)) { <span class="badge badge-muted" title="فایل پیوست"><i class="ti @Icons.Attachment"></i> @fileCount</span> }@if (guide.Summary is not null) { <div class="muted">@guide.Summary</div> }</td>
                                <td>@if (guide.GroupId is not null) { <span class="badge badge-info">@GroupLabel(guide.GroupId)</span> } else { <span class="muted">—</span> }</td>
                                <td>@(guide.CreatedByEmployeeId is Guid author && _authors.TryGetValue(author, out var authorName) ? authorName : "—")@if (guide.IsOwnedBy(_employeeId)) { <span class="badge badge-muted">من</span> }</td>
                                <td><span class="badge @(guide.Visibility == GuideVisibility.Public ? "badge-info" : "badge-muted")">@(guide.Visibility == GuideVisibility.Public ? "عمومی" : "پس از ورود")</span></td>
                                <td><span class="badge @(guide.IsActive ? "badge-success" : "badge-muted")">@(guide.IsActive ? "فعال" : "غیرفعال")</span></td>
                                <td>@guide.UpdatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                <td class="action-cell">
                                    <a class="btn btn-secondary btn-sm" href="/guides/@guide.Id"><i class="ti @Icons.Details"></i> مشاهده</a>
                                    @* Edit, hide/show and delete are offered only to someone allowed to change this particular guide. *@
                                    @if (guide.CanBeEditedBy(_canEditAll, _canEditOwn, _employeeId))
                                    {
                                        <button class="btn btn-secondary btn-sm" @onclick="() => BeginEdit(guide)"><i class="ti @Icons.Edit"></i> ویرایش</button>
                                        <button class="btn btn-secondary btn-sm" @onclick="() => ToggleAsync(guide.Id)"><i class="ti @(guide.IsActive ? Icons.Deactivate : Icons.Activate)"></i> @(guide.IsActive ? "غیرفعال" : "فعال")</button>
                                        @* Deleting asks for a second click so a guide is not removed by accident. *@
                                        @if (_confirmDeleteId == guide.Id)
                                        {
                                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteAsync(guide.Id)"><i class="ti @Icons.Delete"></i> تأیید حذف</button>
                                            <button class="btn btn-secondary btn-sm" @onclick="() => _confirmDeleteId = null">انصراف</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-danger btn-sm" @onclick="() => _confirmDeleteId = guide.Id"><i class="ti @Icons.Delete"></i> حذف</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @* Page navigation under the list (rows are cut into pages here in the page, because the whole list is already loaded). *@
                <ServerPagination Page="@ListPaging.ClampPage(_page, shown.Count, _pageSize)" PageSize="@_pageSize" TotalCount="@shown.Count"
                                  PageChanged="p => _page = p" PageSizeChanged="PageSizeChanged" />
            }
        </section>
        }
    </div>
</div>

@code {
    private const string EditorModule = "./js/guide-editor.js?v=20261104-1";

    // The tab shown: "list" (the guides) or "form" (a new or edited guide).
    private string _tab = "list";
    private bool _loading = true, _canViewAll, _canEditAll, _canEditOwn, _saving, _editorFailed;
    private Guid? _employeeId;
    private List<UserGuide> _guides = [];
    private Dictionary<Guid, string> _authors = [];

    // ---- attached files ----

    private static readonly string _accept = string.Join(",", UserGuideAttachment.AllowedExtensions);
    // How many files each guide has (for the list), the files of the guide being edited, those marked for removal,
    // and the newly picked ones that are stored when the guide is saved. _pickKey clears the file picker after each pick.
    private Dictionary<Guid, int> _fileCounts = [];
    private List<GuideFileItem> _existingFiles = [];
    private HashSet<Guid> _removeIds = [];
    private List<PendingFile> _newFiles = [];

    // A picked file already read into memory (name and bytes). It is read at once because clearing the picker (below) would
    // otherwise cut the browser's link to the file before the guide is saved.
    private sealed record PendingFile(string Name, byte[] Content);
    private int _pickKey;

    private static string SizeText(long bytes) =>
        WorkflowDisplay.ToPersianDigits(bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.#} مگابایت" : $"{Math.Max(1, bytes / 1024)} کیلوبایت");

    // Mark an existing file for removal (or take the mark back); nothing is deleted until the guide is saved.
    private void ToggleRemove(Guid id) { if (!_removeIds.Remove(id)) _removeIds.Add(id); }

    // Check each picked file (type and size) at once, read the good ones into memory and keep them until the guide is saved;
    // the total number of files is checked too.
    private async Task FilesPicked(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(UserGuideAttachment.MaxPerGuide))
        {
            var error = UserGuideAttachment.Validate(file.Name, file.Size);
            if (error is not null) { AppState.AddToast($"{file.Name}: {error}", ToastLevel.Error); continue; }
            var countError = UserGuideAttachment.ValidateCount(_existingFiles.Count(f => !_removeIds.Contains(f.Id)) + _newFiles.Count + 1);
            if (countError is not null) { AppState.AddToast(countError, ToastLevel.Error); break; }
            try
            {
                using var buffer = new MemoryStream();
                await using (var stream = file.OpenReadStream(UserGuideAttachment.MaxBytes))
                    await stream.CopyToAsync(buffer);
                _newFiles.Add(new PendingFile(file.Name, buffer.ToArray()));
            }
            catch (Exception ex) when (ex is IOException or JSException)
            {
                AppState.AddToast($"{file.Name}: خواندن فایل انجام نشد.", ToastLevel.Error);
            }
        }
        _pickKey++;   // empties the picker so more files can be added
    }

    // Stores the picked files (already in memory) and removes the marked ones, in the same save as the guide itself.
    private async Task ApplyFilesAsync(ApplicationDbContext db, Guid guideId)
    {
        if (_removeIds.Count > 0)
        {
            var doomed = await db.UserGuideAttachments.Where(x => x.GuideId == guideId && _removeIds.Contains(x.Id)).ToListAsync();
            db.UserGuideAttachments.RemoveRange(doomed);
        }
        foreach (var file in _newFiles)
            db.UserGuideAttachments.Add(new UserGuideAttachment(guideId, file.Name, file.Content));
    }

    // Who may do what: Admin.Guides.View sees every guide; Admin.Guides.Manage edits every guide; Guides.Own.Manage writes new guides
    // and edits only the ones the person wrote. Someone holding only Guides.Own.Manage sees only their own guides here.
    private bool _canCreate => _canEditAll || _canEditOwn;
    private string SubtitleLead => _canCreate ? (_canViewAll ? "" : "فقط راهنماهایی که خودتان نوشته‌اید در این صفحه دیده و ویرایش می‌شوند. ") : "فقط خواندنی. ";
    private Guid? _editingId, _confirmDeleteId;
    private string _title = "", _summary = "", _initialHtml = "";
    private GuideVisibility _visibility = GuideVisibility.SignedIn;
    private int _sortOrder, _formKey;
    private bool _initEditor = true;
    private ElementReference _host;
    private IJSObjectReference? _module;

    // ---- guide groups ----

    // The groups (also the switched-off ones) and how many guides each holds; loaded together with the guides.
    private IReadOnlyList<UserGuideGroup> _groups = [];
    private IReadOnlyDictionary<Guid, int> _groupCounts = new Dictionary<Guid, int>();
    // The group picked in the guide form (empty = no group).
    private Guid? _groupId;
    // The group form on the groups tab: which group is being edited (empty = a new one), its name and order number.
    private Guid? _editGroupId, _confirmGroupId;
    private string _groupName = "";
    private int _groupOrder;
    private bool _groupBusy;

    // The name of a group, or null when the guide has no group (or the group is not in the list).
    private string? GroupNameOf(Guid? id) => id is Guid g ? _groups.FirstOrDefault(x => x.Id == g)?.Name : null;

    // The name shown in the list; a switched-off group is marked.
    private string GroupLabel(Guid? id) => id is Guid g && _groups.FirstOrDefault(x => x.Id == g) is { } group ? (group.IsActive ? group.Name : group.Name + " (غیرفعال)") : "";

    // The groups offered in the guide form: the ones that are on, plus the group the edited guide already belongs to (even if it was switched off later).
    private IReadOnlyList<(string Key, string Text)> FormGroupOptions
    {
        get
        {
            var current = _editingId is Guid eid ? _guides.FirstOrDefault(x => x.Id == eid)?.GroupId : null;
            return _groups.Where(g => g.IsActive || g.Id == current)
                .Select(g => (g.Id.ToString(), g.IsActive ? g.Name : g.Name + " (غیرفعال)")).ToList();
        }
    }

    // Checked again at the moment of every group change (the permissions may have changed since the page was drawn).
    private async Task<bool> MayManageGroupsAsync() => await PermissionChecker.HasPermissionAsync(Perm.AdminGuidesManage);

    // Edit button on a group: copy it into the form; the form opens in a window over the list.
    private void BeginEditGroup(UserGuideGroup group)
    {
        _editGroupId = group.Id; _groupName = group.Name; _groupOrder = group.SortOrder;
    }

    // Cancel or finish: empty the group form (this also closes the edit window) and suggest the next free order number.
    private void ResetGroupForm()
    {
        _editGroupId = null; _groupName = "";
        _groupOrder = _groups.Count == 0 ? 1 : _groups.Max(x => x.SortOrder) + 1;
    }

    // Save a new group or the changes to an edited one; the service refuses an empty, too long or already used name.
    private async Task SaveGroupAsync()
    {
        if (_groupBusy || !_canEditAll) return;
        _groupBusy = true;
        try
        {
            if (!await MayManageGroupsAsync()) { AppState.AddToast(NotAllowedGroups, ToastLevel.Error); return; }
            var result = await GuideGroups.SaveAsync(_editGroupId, _groupName, _groupOrder);
            if (!result.Ok) { AppState.AddToast(result.Error ?? "ذخیره گروه انجام نشد.", ToastLevel.Error); return; }
            AppState.AddToast(_editGroupId is null ? "گروه اضافه شد." : "گروه ذخیره شد.", ToastLevel.Success);
            _editGroupId = null; _groupName = "";
            await LoadAsync();
            ResetGroupForm();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            AppState.AddToast("ذخیره گروه انجام نشد.", ToastLevel.Error);
        }
        finally { _groupBusy = false; }
    }

    // Switch a group on or off. Off hides the group and its guides from readers.
    private async Task ToggleGroupAsync(UserGuideGroup group)
    {
        if (_groupBusy) return;
        _groupBusy = true;
        try
        {
            if (!await MayManageGroupsAsync()) { AppState.AddToast(NotAllowedGroups, ToastLevel.Error); return; }
            var result = await GuideGroups.SetActiveAsync(group.Id, !group.IsActive);
            if (!result.Ok) { AppState.AddToast(result.Error ?? "تغییر وضعیت گروه انجام نشد.", ToastLevel.Error); return; }
            AppState.AddToast(group.IsActive ? "گروه غیرفعال شد." : "گروه فعال شد.", ToastLevel.Success);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            AppState.AddToast("تغییر وضعیت گروه انجام نشد.", ToastLevel.Error);
        }
        finally { _groupBusy = false; }
    }

    // Delete a group that no guide uses (the service refuses otherwise and says why).
    private async Task DeleteGroupAsync(Guid id)
    {
        _confirmGroupId = null;
        if (_groupBusy) return;
        _groupBusy = true;
        try
        {
            if (!await MayManageGroupsAsync()) { AppState.AddToast(NotAllowedGroups, ToastLevel.Error); return; }
            var result = await GuideGroups.DeleteAsync(id);
            if (!result.Ok) { AppState.AddToast(result.Error ?? "حذف گروه انجام نشد.", ToastLevel.Error); return; }
            AppState.AddToast("گروه حذف شد.", ToastLevel.Success);
            if (_editGroupId == id) ResetGroupForm();
            await LoadAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            AppState.AddToast("حذف گروه انجام نشد.", ToastLevel.Error);
        }
        finally { _groupBusy = false; }
    }

    private const string NotAllowedGroups = "اجازه‌ی مدیریت گروه‌ها را ندارید.";

    // ---- search card ----

    // The filter fields: what is being typed or picked (the "draft") and what was applied by the search button.
    private string _dSearch = "", _search = "";
    private string? _dGroup, _group, _dStatus, _status;

    // Key used in the group filter for "guides without a group" (a real group id can never look like this).
    private const string NoGroupKey = "\u0001none";
    private static readonly IReadOnlyList<(string Key, string Text)> StatusOptions = [("on", "فعال"), ("off", "غیرفعال")];

    // The choices of the group filter: every group (a switched-off one is marked) and "no group".
    private IReadOnlyList<(string Key, string Text)> GroupOptions =>
        _groups.Select(g => (g.Id.ToString(), g.IsActive ? g.Name : g.Name + " (غیرفعال)")).Append((NoGroupKey, "بدون گروه")).ToList();

    // How many filters are applied right now, and whether something typed or picked is not applied yet.
    private int FilterCount => (string.IsNullOrWhiteSpace(_search) ? 0 : 1) + (_group is null ? 0 : 1) + (_status is null ? 0 : 1);
    private bool HasDraft => !string.IsNullOrWhiteSpace(_dSearch) || _dGroup is not null || _dStatus is not null;

    // The guides left after the applied filters (all of them when none are applied), in the chosen sort order
    // (the display order set by the administrator when no column is chosen).
    private IReadOnlyList<UserGuide> Shown => TableSort.Apply(_guides.Where(g =>
        GuideSearch.Matches(g.Title, g.Summary, GroupNameOf(g.GroupId), _search)
        && (_group is null || (_group == NoGroupKey ? g.GroupId is null : g.GroupId?.ToString() == _group))
        && (_status is null || g.IsActive == (_status == "on"))), _sortBy, _sortDesc,
        ("order", g => g.SortOrder), ("title", g => g.Title), ("group", g => GroupNameOf(g.GroupId)),
        ("author", g => g.CreatedByEmployeeId is Guid a && _authors.TryGetValue(a, out var name) ? name : null),
        ("visibility", g => (int)g.Visibility), ("status", g => g.IsActive), ("updated", g => g.UpdatedAtUtc));

    // The column the list is sorted by (empty = the display order set by the administrator), its direction, and the page shown.
    private string? _sortBy;
    private bool _sortDesc;
    private int _page = 1, _pageSize = 20;

    // Heading click: sort by that column (again = reverse) and go back to the first page.
    private void SortBy(string column) { (_sortBy, _sortDesc) = TableSort.Toggle(_sortBy, _sortDesc, column); _page = 1; }

    // Page size changed: show the first page of the new size.
    private void PageSizeChanged(int size) { _pageSize = size; _page = 1; }

    // Search button: apply what was typed and picked, and go back to the first page.
    private void ApplyFilters() { (_search, _group, _status) = (_dSearch.Trim(), _dGroup, _dStatus); _page = 1; }

    // Clear button: forget every filter.
    private void ClearFilters()
    {
        (_dSearch, _dGroup, _dStatus) = ("", null, null);
        ApplyFilters();
    }

    // On opening: learn who the person is and which guide permissions they hold, then load the list.
    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _employeeId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : null;
        _canEditAll = await PermissionChecker.HasPermissionAsync(Perm.AdminGuidesManage);
        _canViewAll = _canEditAll || await PermissionChecker.HasPermissionAsync(Perm.AdminGuidesView);
        _canEditOwn = await PermissionChecker.HasPermissionAsync(Perm.GuidesOwnManage);
        await LoadAsync();
        _loading = false;
    }

    // The editor is built in the browser once its element exists (and again for every new element: a new guide, or a guide picked for editing).
    // Starts the rich-text editor in the browser once its place on the page exists; needed again for each new form.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_initEditor || !_canCreate) return;
        _initEditor = false;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", EditorModule);
            await _module.InvokeVoidAsync("init", _host, _initialHtml, "متن راهنما را اینجا بنویسید...");
            _editorFailed = false;
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            _editorFailed = true;
            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
            // the circuit is gone; nothing to show
        }
    }

    // Load the guides this person may see (all, or only their own) together with the names of their authors.
    private async Task LoadAsync()
    {
        // The groups come first: the form, the filter and the list column all need their names.
        _groups = await GuideGroups.ListAsync(true);
        _groupCounts = await GuideGroups.CountGuidesAsync();
        if (_editGroupId is null) _groupOrder = _groups.Count == 0 ? 1 : _groups.Max(x => x.SortOrder) + 1;
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.UserGuides.AsNoTracking();
        if (!_canViewAll)
        {
            // only their own guides; a person we cannot identify sees none (never the guides that have no recorded author)
            if (_employeeId is not Guid me) { _guides = []; _authors = []; return; }
            query = query.Where(x => x.CreatedByEmployeeId == me);
        }
        _guides = await query.OrderBy(x => x.SortOrder).ThenBy(x => x.CreatedAtUtc).ToListAsync();
        var ids = _guides.Select(x => x.Id).ToList();
        _fileCounts = ids.Count == 0 ? [] : (await db.UserGuideAttachments.AsNoTracking().Where(a => ids.Contains(a.GuideId)).GroupBy(a => a.GuideId)
            .Select(g => new { g.Key, Count = g.Count() }).ToListAsync()).ToDictionary(x => x.Key, x => x.Count);
        var authorIds = _guides.Where(x => x.CreatedByEmployeeId != null).Select(x => x.CreatedByEmployeeId!.Value).Distinct().ToList();
        _authors = authorIds.Count == 0 ? [] : await db.Employees.AsNoTracking().Where(e => authorIds.Contains(e.Id)).ToDictionaryAsync(e => e.Id, e => e.FullName);
        if (_editingId is null) _sortOrder = _guides.Count == 0 ? 1 : _guides.Max(x => x.SortOrder) + 1;
    }

    // Fill the form with an existing guide so it can be changed. The page stays on the list; the form opens in a window over it.
    private async Task BeginEdit(UserGuide guide)
    {
        _editingId = guide.Id;
        _newFiles = []; _removeIds = []; _pickKey++;
        _existingFiles = (await GuideFiles.ListAttachmentsAsync(guide.Id)).ToList();
        _title = guide.Title; _summary = guide.Summary ?? ""; _groupId = guide.GroupId; _visibility = guide.Visibility; _sortOrder = guide.SortOrder;
        _initialHtml = GuideHtmlSanitizer.Sanitize(guide.ContentHtml);
        _formKey++; _initEditor = true;
    }

    // Leave edit mode (this also closes the edit window) and empty the form.
    private async Task CancelEdit()
    {
        _tab = "list";
        ResetForm();
        await LoadAsync();
    }

    // Return the form to its empty 'new guide' state.
    private void ResetForm()
    {
        _editingId = null;
        _title = _summary = _initialHtml = "";
        _groupId = null;
        _existingFiles = []; _removeIds = []; _newFiles = []; _pickKey++;
        _visibility = GuideVisibility.SignedIn;
        _formKey++; _initEditor = true;
    }

    // Save a new guide or the changes to an edited one. The text typed in the editor is cleaned of unsafe content first,
    // permissions are checked again, and any problem is reported to the person as a message instead of a crash.
    private async Task SaveAsync()
    {
        if (_saving || _module is null || !_canCreate) return;
        _saving = true;
        try
        {
            // The text comes from the browser, so it is cleaned here before anything is stored.
            var html = GuideHtmlSanitizer.Sanitize(await _module.InvokeAsync<string>("getHtml", _host));
            if (!UserGuide.HasText(html)) { AppState.AddToast("متن راهنما را بنویسید.", ToastLevel.Error); return; }

            await using var db = await DbFactory.CreateDbContextAsync();
            if (_editingId is Guid id)
            {
                var guide = await db.UserGuides.SingleOrDefaultAsync(x => x.Id == id);
                if (guide is null) { AppState.AddToast("این راهنما دیگر وجود ندارد.", ToastLevel.Error); ResetForm(); await LoadAsync(); return; }
                if (!await MayEditAsync(guide)) { AppState.AddToast(NotAllowed, ToastLevel.Error); return; }
                // The chosen group must still exist and be on (a guide may keep a group that was switched off later).
                var groupError = await GuideGroups.CheckChoiceAsync(_groupId, guide.GroupId);
                if (groupError is not null) { AppState.AddToast(groupError, ToastLevel.Error); return; }
                guide.Update(_title, _summary, html, _visibility, _sortOrder, _groupId);
                var kept = await db.UserGuideAttachments.CountAsync(x => x.GuideId == id && !_removeIds.Contains(x.Id));
                var countError = UserGuideAttachment.ValidateCount(kept + _newFiles.Count);
                if (countError is not null) { AppState.AddToast(countError, ToastLevel.Error); return; }
                await ApplyFilesAsync(db, id);
            }
            else
            {
                // a new guide records who wrote it; without that a person who may edit only their own guides could never edit it again
                if (!await MayCreateAsync()) { AppState.AddToast(NotAllowed, ToastLevel.Error); return; }
                var groupError = await GuideGroups.CheckChoiceAsync(_groupId, null);
                if (groupError is not null) { AppState.AddToast(groupError, ToastLevel.Error); return; }
                var created = new UserGuide(_title, _summary, html, _visibility, _sortOrder, _employeeId, _groupId);
                db.UserGuides.Add(created);
                await ApplyFilesAsync(db, created.Id);
            }

            await db.SaveChangesAsync();
            AppState.AddToast(_editingId is null ? "راهنما اضافه شد." : "راهنما ذخیره شد.", ToastLevel.Success);
            _tab = "list";   // back to the list to see the result
            ResetForm();
            await LoadAsync();
        }
        catch (ArgumentException ex)
        {
            AppState.AddToast(Explain(ex), ToastLevel.Error);
        }
        catch (JSException)
        {
            AppState.AddToast("خواندن متن از ویرایشگر انجام نشد. دوباره تلاش کنید.", ToastLevel.Error);
        }
        catch (Exception ex) when (ex is not OperationCanceledException and not JSDisconnectedException)
        {
            AppState.AddToast("ذخیره راهنما انجام نشد.", ToastLevel.Error);
        }
        finally { _saving = false; }
    }

    private const string NotAllowed = "اجازه‌ی تغییر این راهنما را ندارید.";

    // Checked again at the moment of every change (the permissions may have changed since the page was drawn).
    private async Task<bool> MayEditAsync(UserGuide guide) =>
        guide.CanBeEditedBy(await PermissionChecker.HasPermissionAsync(Perm.AdminGuidesManage), await PermissionChecker.HasPermissionAsync(Perm.GuidesOwnManage), _employeeId);

    private async Task<bool> MayCreateAsync() =>
        await PermissionChecker.HasPermissionAsync(Perm.AdminGuidesManage) || (_employeeId is not null && await PermissionChecker.HasPermissionAsync(Perm.GuidesOwnManage));

    // The domain's messages are English; the person sees a Persian sentence for the field that failed.
    private static string Explain(ArgumentException ex) => ex.ParamName switch
    {
        "title" => $"عنوان لازم است و حداکثر {UserGuide.TitleMax} نویسه باشد.",
        "summary" => $"خلاصه حداکثر {UserGuide.SummaryMax} نویسه باشد.",
        "fileName" => ex.Message,   // the file's own messages are already Persian
        "contentHtml" => "متن راهنما لازم است و نباید بیش از حد طولانی باشد؛ آن را به چند راهنما تقسیم کنید.",
        _ => "اطلاعات راهنما معتبر نیست.",
    };

    // Hide a guide from readers or show it again; the guide itself is kept.
    private async Task ToggleAsync(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var guide = await db.UserGuides.SingleOrDefaultAsync(x => x.Id == id);
        if (guide is not null && !await MayEditAsync(guide)) { AppState.AddToast(NotAllowed, ToastLevel.Error); return; }
        if (guide is not null)
        {
            if (guide.IsActive) guide.Deactivate(); else guide.Activate();
            guide.Touch();
            await db.SaveChangesAsync();
        }
        await LoadAsync();
    }

    // Permanently delete a guide (after the confirmation click), if the person is allowed to change it.
    private async Task DeleteAsync(Guid id)
    {
        _confirmDeleteId = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        var guide = await db.UserGuides.SingleOrDefaultAsync(x => x.Id == id);
        if (guide is not null && !await MayEditAsync(guide)) { AppState.AddToast(NotAllowed, ToastLevel.Error); return; }
        if (guide is not null)
        {
            db.UserGuides.Remove(guide);
            await db.SaveChangesAsync();
            AppState.AddToast("راهنما حذف شد.", ToastLevel.Success);
        }
        if (_editingId == id) ResetForm();
        await LoadAsync();
    }

    // Clean up the editor when the page is left.
    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try { await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
