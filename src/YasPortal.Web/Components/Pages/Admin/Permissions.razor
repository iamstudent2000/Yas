@page "/admin/permissions"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using YasPortal.Domain.Authorization
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Services
@using YasPortal.Web.Components.Shared
@attribute [Authorize(Policy = "Admin.Permissions")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AdminQueryService AdminQueries
@inject AppState AppState

<PageTitle>مجوزها - یاس پورتال</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <div>
            <div class="page-kicker">مدیریت سامانه / کنترل دسترسی</div>
            <h1 class="page-title">مجوزها</h1>
            <p class="page-subtitle">نام و کد فنی هر مجوز را ببینید و دقیقاً بررسی کنید چه کسی یا چه گروهی از آن استفاده
                می‌کند.</p>
            </div>
            <div class="form-actions">
                <a class="btn btn-primary" href="/admin/permission-groups"><i class="bx bx-layer"></i> گروه‌های مجوز</a>
                <a class="btn btn-secondary" href="/admin/access"><i class="bx bx-shield-quarter"></i> مدیریت دسترسی</a>
            </div>
        </div>

        <div class="stat-grid">
            <div class="stat-card">
                <div class="stat-icon"><i class="bx bx-key"></i></div>
                <span class="stat-label">کل مجوزها</span>
                <strong class="stat-value">@_totalCount</strong>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="bx bx-user-check"></i></div>
                <span class="stat-label">تخصیص مستقیم</span>
                <strong class="stat-value">@_directAssignmentCount</strong>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="bx bx-layer"></i></div>
                <span class="stat-label">استفاده در گروه‌ها</span>
                <strong class="stat-value">@_groupMembershipCount</strong>
            </div>
        </div>

        <div class="admin-stack">
@if (_editingId is not null)
        {
        <section class="card admin-form-row">
            <div class="admin-form-row-head">
                <h2 class="section-title"><i class="bx bx-edit-alt"></i> ویرایش نام مجوز</h2>
                <p class="muted">مجوزها در برنامه ثابت هستند؛ فقط نام نمایشی قابل ویرایش است و کد فنی تغییر نمی‌کند.</p>
            </div>
            <div class="admin-row-grid">
                <div class="form-field is-grow"><label class="form-label">کد فنی مجوز</label><input class="form-control" value="@_code" dir="ltr" readonly /></div>
                <div class="form-field is-grow"><label class="form-label">نام مجوز</label><input class="form-control" @bind="_name" maxlength="300" /></div>
                <div class="form-field admin-row-submit">
                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="Save"><i class="bx bx-save"></i> ذخیره نام</button>
                        <button class="btn btn-secondary" @onclick="Cancel">انصراف</button>
                    </div>
                </div>
            </div>
        </section>
        }


                        <ListFilterBar Busy="_loading" ActiveCount="@((_search.Trim().Length > 0 ? 1 : 0) + (_usageFilter != "" ? 1 : 0))"
                                       CanClear="@(_search != "" || _usageFilter != "" || _draftSearch != "" || _draftUsage != "")" OnSearch="SearchFiltersAsync" OnClear="ClearFiltersAsync">
                            <div class="admin-filter"><label class="form-label">جستجو</label>
                                <input class="form-control" placeholder="نام یا کد مجوز..." @bind="_draftSearch" @bind:event="oninput" /></div>
                            <div class="admin-filter"><label class="form-label">مصرف</label>
                                <LookupSelect Options="_usageOptions" Value="@(_draftUsage == "" ? null : _draftUsage)" ValueChanged="k => _draftUsage = k ?? string.Empty" Placeholder="همه" /></div>
                        </ListFilterBar>

                        <section class="card">
                            <div class="card-toolbar">
                                <div>
                                    <h2 class="section-title">فهرست مجوزها <span class="badge badge-muted">@_totalCount مجوز</span></h2>
                                    <p class="muted">برای مشاهده مصرف‌کنندگان، روی «مصرف و تخصیص‌ها» کلیک کنید.</p>
                                </div>
                                <div class="toolbar-tools">
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ExpandAllAreas"><i class="bx bx-expand-alt"></i> باز کردن همه</button>
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CollapseAllAreas"><i class="bx bx-collapse-alt"></i> بستن همه</button>
                                </div>
                            </div>

                                @if (_loading)
                                {
                                    <div class="admin-loading"><i class="bx bx-loader-alt bx-spin"></i><span>در حال بارگذاری...</span></div>
                                }
                                else if (_permissions.Count == 0)
                                {
                                    <div class="admin-empty"><i class="bx bx-search-alt"></i><strong>مجوزی پیدا نشد</strong><span>عبارت جستجو یا
                                        فیلتر را تغییر دهید.</span></div>
                                    }
            else
                                    {
                                        <div class="permission-sections-list">@foreach (var area in
                                            _permissions.GroupBy(x => PermissionCategory(x.Code)).OrderBy(x => x.Key))
                                            {
                                                var collapsed = _collapsedAreas.Contains(area.Key) && string.IsNullOrWhiteSpace(_search);
                                                <section class="permission-section @(collapsed ? "collapsed" : "")">
                                                    <div class="permission-section-heading" @onclick="() => ToggleArea(area.Key)">
                                                        <div><i class="bx bx-folder-open"></i><strong>@area.Key</strong></div>
                                                        <span class="badge badge-muted">@area.Count() مجوز</span>
                                                        <i class="bx bx-chevron-down chevron"></i>
                                                    </div>
                                                    <div class="permission-section-body">
                                                        <div class="admin-list-table-head"><span>مجوز</span><span>استفاده</span><span>عملیات</span></div>
                                        @foreach (var x in area)
                                        {
                                            var isExpanded = _expandedPermissionId == x.Id;
                                            <div @key="x.Id">
                                                <div class="admin-list-row">
                                                    <div class="admin-list-primary">
                                                        <div class="admin-list-avatar"><i class="bx bx-key"></i></div>
                                                        <div class="admin-list-text">
                                                            <strong title="@x.Name">@x.Name</strong>
                                                            <code class="admin-code" dir="ltr">@x.Code</code>
                                                        </div>
                                                    </div>
                                                    <div class="admin-list-meta">
                                                        <span class="admin-pill"><i class="bx bx-user-check"></i>@x.DirectAssignmentCount مستقیم</span>
                                                        <span class="admin-pill"><i class="bx bx-layer"></i>@x.GroupMembershipCount گروه</span>
                                                    </div>
                                                    <div class="admin-list-actions">
                                                        <button class="btn btn-primary btn-sm" @onclick="() => ToggleUsage(x.Id)">
                                                            <i class="bx @(isExpanded ? "bx-chevron-up" : "bx-show")"></i> @(isExpanded ? "بستن جزئیات" : "مصرف و تخصیص‌ها")
                                                        </button>
                                                        <button class="btn btn-secondary btn-sm" @onclick="() => Edit(x)"><i class="bx bx-edit-alt"></i>
                                                            ویرایش</button>
                                                            </div>
                                                        </div>

                                                        @if (isExpanded)
                                                        {
                                                            <div class="admin-detail">
                                                                @if (_usageLoading)
                                                                {
                                                                    <div class="admin-loading"><i class="bx bx-loader-alt bx-spin"></i><span>در حال بارگذاری
                                                                        جزئیات...</span></div>
                                                                    }
                                else if (_usage is null)
                                                                    {
                                                                        <div class="admin-empty is-compact"><span>اطلاعات مصرف این مجوز پیدا نشد.</span></div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="admin-detail-header">
                                                                            <div><strong>ردیابی استفاده از مجوز</strong><span>@_usage.PermissionName</span></div>
                                                                            <code class="admin-code" dir="ltr">@_usage.PermissionCode</code>
                                                                        </div>
                                                                        <div class="admin-detail-grid">
                                                                            <div class="admin-detail-panel">
                                                                                <div class="admin-detail-panel-title"><i class="bx bx-user-check"></i><strong>تخصیص
                                                                                    مستقیم</strong><span>@_usage.DirectAssignments.Count</span></div>
                                                                                    @if (_usage.DirectAssignments.Count > 5)
                                                                                    {
                                                                                        <div class="admin-detail-panel-search"><i class="bx bx-search"></i><input
                                                                                            class="form-control" placeholder="جستجوی کارمند..." value="@_directSearch"
                                                                                            @oninput="e => { _directSearch = e.Value?.ToString() ?? string.Empty; _directPage = 1; }" /></div>
                                                                                    }
                                                                                    @{ var filteredDirect = FilteredDirect(); }
                                                                                    @if (_usage.DirectAssignments.Count == 0)
                                                                                    {
                                                                                        <div class="admin-empty is-compact"><span>این مجوز مستقیماً به هیچ کاربری
                                                                                            تخصیص داده نشده است.</span></div>
                                                                                        }
                                            else if (filteredDirect.Count == 0)
                                                                                        {
                                                                                            <div class="admin-empty is-compact"><span>موردی با این عبارت پیدا نشد.</span></div>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            @foreach (var d in PageOf(filteredDirect, _directPage))
                                                                                            {
                                                                                                <div class="admin-detail-item">
                                                                                                    <div class="admin-detail-item-icon"><i class="bx bx-user"></i></div>
                                                                                                    <div class="admin-detail-item-main"><strong>@d.EmployeeName</strong><span
                                                                                                        dir="ltr">@d.Username</span></div>
                                                                                                        <div class="admin-detail-item-side"><span>@d.Source</span>@if (d.PositionName is not
                                                                                                            null){
                                                                                                                <small>@d.PositionName</small>
                                                                                                            }
                                                                                                        </div>
                                                                                                    </div>
                                                                                                }
                                                                                            <UsagePager Page="_directPage" TotalCount="filteredDirect.Count" PageSize="UsagePageSize"
                                                                                                        PageChanged="p => _directPage = p" />
                                                                                            }
                                                                                        </div>
                                                                                        <div class="admin-detail-panel">
                                                                                            <div class="admin-detail-panel-title"><i class="bx bx-layer"></i><strong>گروه‌های دارای این
                                                                                                مجوز</strong><span>@_usage.Groups.Count</span></div>
                                                                                                @if (_usage.Groups.Count > 5)
                                                                                                {
                                                                                                    <div class="admin-detail-panel-search"><i class="bx bx-search"></i><input
                                                                                                        class="form-control" placeholder="جستجوی گروه..." value="@_groupsSearch"
                                                                                                        @oninput="e => { _groupsSearch = e.Value?.ToString() ?? string.Empty; _groupsPage = 1; }" /></div>
                                                                                                }
                                                                                                @{ var filteredGroups = FilteredGroups(); }
                                                                                                @if (_usage.Groups.Count == 0)
                                                                                                {
                                                                                                    <div class="admin-empty is-compact"><span>هیچ گروهی این مجوز را شامل
                                                                                                        نمی‌شود.</span></div>
                                                                                                    }
                                            else if (filteredGroups.Count == 0)
                                                                                                {
                                                                                                    <div class="admin-empty is-compact"><span>موردی با این عبارت پیدا نشد.</span></div>
                                                                                                }
                                                                                                    else
                                                                                                    {
                                                                                                        @foreach (var g in PageOf(filteredGroups, _groupsPage))
                                                                                                        {
                                                                                                            var groupExpanded = _expandedUsageGroupId == g.GroupId;
                                                                                                            <div class="admin-detail-item admin-detail-item-expandable">
                                                                                                                <div class="admin-detail-item-icon"><i class="bx bx-layer"></i></div>
                                                                                                                <div class="admin-detail-item-main"><strong>@g.GroupName</strong>@if
                                                                                                                    (!string.IsNullOrWhiteSpace(g.Description)){
                                                                                                                        <span>@g.Description</span>
                                                                                                                    }
                                                                                                                </div>
                                                                                                                <div class="admin-detail-item-side"><span>@g.PermissionCount
                                                                                                                    مجوز</span>
                                                                                                                    <button type="button" class="admin-detail-item-toggle"
                                                                                                                            @onclick="() => ToggleUsageGroup(g.GroupId)"><span>@g.AssignedEmployeeCount
                                                                                                                        تخصیص</span><i class="bx @(groupExpanded ? "bx-chevron-up" : "bx-chevron-down")"></i></button>
                                                                                                                </div>
                                                                                                                @if (groupExpanded)
                                                                                                                {
                                                                                                                    <div class="admin-detail-subitems">
                                                                                                                        @if (g.Assignments.Count == 0)
                                                                                                                        {
                                                                                                                            <div class="admin-detail-subitem-empty">این گروه به کسی تخصیص داده نشده است.</div>
                                                                                                                        }
                                                                                                                        else
                                                                                                                        {
                                                                                                                            @foreach (var a in g.Assignments)
                                                                                                                            {
                                                                                                                                <div class="admin-detail-subitem">
                                                                                                                                    <span>@a.EmployeeName</span><small dir="ltr">@a.Username</small>
                                                                                                                                    <span class="admin-detail-subitem-tag">@(a.PositionName ?? a.Source)</span>
                                                                                                                                </div>
                                                                                                                            }
                                                                                                                        }
                                                                                                                    </div>
                                                                                                                }
                                                                                                                </div>
                                                                                                            }
                                                                                                        <UsagePager Page="_groupsPage" TotalCount="filteredGroups.Count" PageSize="UsagePageSize"
                                                                                                                    PageChanged="p => _groupsPage = p" />
                                                                                                        }
                                                                                                    </div>
                                                                                                </div>
                                                                                            }
                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                            }
                                                    </div>
                                                </section>
                                            }
                                        </div>
                                                                        }
                                                                    </section>
                                                                </div>

                                                                <section class="card admin-note">
                                                                    <div class="admin-note-icon"><i class="bx bx-shield-quarter"></i></div>
                                                                    <div><strong>مدل دسترسی یاس پورتال</strong>
                                                                        <p>هیچ Deny permission وجود ندارد. مجوز نهایی برابر است با اجتماع مجوزهای مستقیم و تمام گروه‌های
                                                                            اختصاص‌یافته.</p>
                                                                        </div>
                                                                    </section>
                                                                </div>

@code {
    private List<AdminQueryService.PermissionPageRow> _permissions = [];
    private AdminQueryService.PermissionUsageDetails? _usage;
    private Guid? _expandedPermissionId, _editingId, _expandedUsageGroupId;
    private string _code = "", _name = "", _search = "", _usageFilter = "", _directSearch = "", _groupsSearch = "";
    private int _totalCount, _directAssignmentCount, _groupMembershipCount, _directPage = 1, _groupsPage = 1;
    private bool _loading, _usageLoading;
    private HashSet<string> _collapsedAreas = [];
    private const int UsagePageSize = 6;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private void ToggleArea(string key) { if (!_collapsedAreas.Add(key)) _collapsedAreas.Remove(key); }
    private async Task ExpandAllAreas()
    {
        _collapsedAreas.Clear();
        if (!string.IsNullOrWhiteSpace(_search)) { _search = _draftSearch = string.Empty; await LoadAsync(); }
    }
    private async Task CollapseAllAreas()
    {
        if (!string.IsNullOrWhiteSpace(_search)) { _search = _draftSearch = string.Empty; await LoadAsync(); }
        _collapsedAreas = _permissions.Select(x => PermissionCategory(x.Code)).ToHashSet();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await AdminQueries.GetAllPermissionsAsync(_search, _usageFilter);
            _permissions = result.ToList();
            _totalCount = _permissions.Count;
            await using var db = await DbFactory.CreateDbContextAsync();
            _directAssignmentCount = await db.UserPositionPermissions.CountAsync() + await db.EmployeePermissions.CountAsync();
            _groupMembershipCount = await db.PermissionGroupPermissions.CountAsync();
        }
        finally { _loading = false; }
    }

    private async Task ToggleUsage(Guid id)
    {
        if (_expandedPermissionId == id) { _expandedPermissionId = null; _usage = null; return; }
        _expandedPermissionId = id;
        _usage = null;
        _directSearch = _groupsSearch = "";
        _directPage = _groupsPage = 1;
        _expandedUsageGroupId = null;
        _usageLoading = true;
        try { _usage = await AdminQueries.GetPermissionUsageAsync(id); }
        finally { _usageLoading = false; }
    }

    private void ToggleUsageGroup(Guid groupId) => _expandedUsageGroupId = _expandedUsageGroupId == groupId ? null : groupId;

    private List<AdminQueryService.DirectPermissionUsage> FilteredDirect()
    {
        if (_usage is null) return [];
        var q = _directSearch.Trim();
        if (q.Length == 0) return _usage.DirectAssignments.ToList();
        return _usage.DirectAssignments.Where(x => x.EmployeeName.Contains(q, StringComparison.CurrentCultureIgnoreCase)
            || x.Username.Contains(q, StringComparison.CurrentCultureIgnoreCase)
            || (x.PositionName?.Contains(q, StringComparison.CurrentCultureIgnoreCase) ?? false)).ToList();
    }

    private List<AdminQueryService.GroupPermissionUsage> FilteredGroups()
    {
        if (_usage is null) return [];
        var q = _groupsSearch.Trim();
        if (q.Length == 0) return _usage.Groups.ToList();
        return _usage.Groups.Where(x => x.GroupName.Contains(q, StringComparison.CurrentCultureIgnoreCase)
            || (x.Description?.Contains(q, StringComparison.CurrentCultureIgnoreCase) ?? false)).ToList();
    }

    private static List<T> PageOf<T>(List<T> items, int page) => items.Skip((page - 1) * UsagePageSize).Take(UsagePageSize).ToList();

    // The boxes edit the draft; "جستجو" copies it into _search/_usageFilter, which every load uses.
    private string _draftSearch = "", _draftUsage = "";

    private async Task SearchFiltersAsync()
    {
        _search = _draftSearch.Trim();
        _usageFilter = _draftUsage;
        _expandedPermissionId = null;
        _usage = null;
        await LoadAsync();
    }
    private async Task ClearFiltersAsync()
    {
        _search = _draftSearch = "";
        _usageFilter = _draftUsage = "";
        _expandedPermissionId = null;
        _usage = null;
        await LoadAsync();
    }

    private static readonly IReadOnlyList<(string Key, string Text)> _usageOptions = [("used", "در حال استفاده"), ("unused", "بدون استفاده")];

    private static string PermissionCategory(string code) => code.Split('.', 2)[0] switch
    {
        "Dashboard" => "داشبورد",
        "Profile" => "پروفایل",
        "Requests" => "درخواست‌ها و گردش‌کار",
        "Employees" => "کارکنان",
        "Organizations" => "سازمان‌ها",
        "Positions" => "سمت‌ها",
        "Permissions" => "مجوزها",
        "Admin" => "مدیریت سامانه",
        _ => code.Split('.', 2)[0]
    };

    private void Edit(AdminQueryService.PermissionPageRow x) { _editingId = x.Id; _code = x.Code; _name = x.Name; }
    private void Cancel() { _editingId = null; _code = _name = ""; }

    private async Task Save()
    {
        var name = _name.Trim();
        if (_editingId is not Guid id || string.IsNullOrWhiteSpace(name))
        {
            AppState.AddToast("نام مجوز الزامی است.", ToastLevel.Error); return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var permission = await db.Permissions.SingleAsync(x => x.Id == id);
        permission.Rename(permission.Code, name);
        await db.SaveChangesAsync();
        AppState.AddToast("نام مجوز ویرایش شد.", ToastLevel.Success);
        Cancel(); await LoadAsync();
    }
}