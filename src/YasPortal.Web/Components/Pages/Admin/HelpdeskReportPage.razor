@page "/admin/helpdesk-report"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Domain.Workflows
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize(Policy = Perm.AdminHelpdeskReportView)]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>گزارش پشتیبانی - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <SectionTabs Group="request-admin" />
    <div class="page-header">
        <div>
            <div class="page-kicker">مدیریت سامانه / گردش‌کار</div>
            <h1 class="page-title"><i class="ti @Icons.HelpdeskReport"></i> گزارش پشتیبانی</h1>
            <p class="page-subtitle">آمار درخواست‌های پشتیبانی ثبت‌شده در بازه‌ی انتخابی: تعداد به تفکیک دسته‌بندی و اولویت، زمان میانگین رسیدگی و درخواست‌هایی که بیشتر از همه منتظر مانده‌اند. «رسیدگی‌شده» یعنی تایید نهایی پس از ثبت اقدام پشتیبانی.</p>
        </div>
    </div>

    <ListFilterBar Busy="_loading" ActiveCount="0" CanClear="true" OnSearch="LoadAsync" OnClear="ResetAsync">
        <div class="admin-filter"><label class="form-label">از تاریخ ثبت</label><PersianDatePicker @key="_resetKey" Value="_from" ValueChanged="d => _from = d" Placeholder="تاریخ شروع" /></div>
        <div class="admin-filter"><label class="form-label">تا تاریخ ثبت</label><PersianDatePicker @key="_resetKey" Value="_to" ValueChanged="d => _to = d" Placeholder="تاریخ پایان" /></div>
    </ListFilterBar>

    @if (_loading && _report is null)
    {
        <section class="card"><LoadingState /></section>
    }
    else if (_report is null || _report.Total == 0)
    {
        <section class="card"><div class="empty-state"><i class="ti @Icons.Reports"></i><strong>درخواست پشتیبانی در این بازه ثبت نشده است</strong></div></section>
    }
    else
    {
        <div class="stat-grid">
            <div class="stat-card"><div class="stat-icon"><i class="ti @Icons.HelpdeskReport"></i></div><span class="stat-label">کل درخواست‌ها</span><strong class="stat-value">@Num(_report.Total)</strong></div>
            <div class="stat-card"><div class="stat-icon"><i class="ti @Icons.Awaiting"></i></div><span class="stat-label">در انتظار رسیدگی</span><strong class="stat-value">@Num(_report.Open)</strong></div>
            <div class="stat-card"><div class="stat-icon"><i class="ti @Icons.Approved"></i></div><span class="stat-label">رسیدگی‌شده</span><strong class="stat-value">@Num(_report.Resolved)</strong></div>
            <div class="stat-card"><div class="stat-icon"><i class="ti @Icons.Rejected"></i></div><span class="stat-label">ردشده</span><strong class="stat-value">@Num(_report.Rejected)</strong></div>
            <div class="stat-card"><div class="stat-icon"><i class="ti @Icons.Age"></i></div><span class="stat-label">میانگین زمان رسیدگی</span><strong class="stat-value">@(_report.AverageResolution is { } avg ? WorkflowDisplay.FormatDuration(avg) : "—")</strong></div>
            <div class="stat-card"><div class="stat-icon"><i class="ti @Icons.Clock"></i></div><span class="stat-label">میانگین زمان صرف‌شده (دقیقه)</span><strong class="stat-value">@(_report.AverageMinutesSpent is { } spent ? Num(Math.Round(spent)) : "—")</strong></div>
        </div>

        @if (_capped)
        {
            <p class="muted">فقط @Num(MaxRows) درخواست جدیدتر بازه در گزارش آمده است؛ بازه را کوتاه‌تر کنید.</p>
        }

        <div class="admin-stack">
            <section class="card table-card">
                <div class="card-toolbar"><h2 class="section-title">به تفکیک دسته‌بندی</h2></div>
                <GroupTable Rows="_report.ByCategory" />
            </section>
            <section class="card table-card">
                <div class="card-toolbar"><h2 class="section-title">به تفکیک اولویت</h2></div>
                <GroupTable Rows="_report.ByPriority" />
            </section>
            <section class="card table-card">
                <div class="card-toolbar"><h2 class="section-title">بیشترین زمان انتظار (در انتظار رسیدگی)</h2></div>
                @if (_report.LongestWaiting.Count == 0)
                {
                    <div class="empty-state"><i class="ti @Icons.Success"></i><strong>درخواست بازی وجود ندارد</strong></div>
                }
                else
                {
                    <div class="admin-table-wrap">
                        <table class="admin-table">
                            <thead><tr><th>شناسه</th><th>موضوع</th><th>دسته‌بندی</th><th>اولویت</th><th>مدت انتظار</th></tr></thead>
                            <tbody>
                                @foreach (var item in _report.LongestWaiting)
                                {
                                    <tr>
                                        <td dir="ltr">#@item.Id.ToString("N")[..8]</td>
                                        <td>@item.Subject</td>
                                        <td>@(item.Category ?? "—")</td>
                                        <td>@(item.Priority ?? "—")</td>
                                        <td>@WorkflowDisplay.FormatDuration(item.Waited)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    }
</div>

@code {
    private const int MaxRows = 5000;

    private DateTime? _from = DateTime.Today.AddDays(-30);
    private DateTime? _to = DateTime.Today;
    private bool _loading;
    private int _resetKey;
    private bool _capped;
    private HelpdeskReportResult? _report;

    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>Back to the default range, the last 30 days.</summary>
    private Task ResetAsync()
    {
        _from = DateTime.Today.AddDays(-30);
        _to = DateTime.Today;
        _resetKey++;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var query = db.WorkflowRequests.AsNoTracking().Where(x => x.WorkflowType == WorkflowTypeCode.Helpdesk);
            if (_from is DateTime from)
            {
                var start = from.Date;
                query = query.Where(x => x.CreatedAtUtc >= start);
            }
            if (_to is DateTime to)
            {
                var end = to.Date.AddDays(1);
                query = query.Where(x => x.CreatedAtUtc < end);
            }

            var rows = await query.OrderByDescending(x => x.CreatedAtUtc).Take(MaxRows)
                .Select(x => new
                {
                    x.Id,
                    x.Status,
                    x.CreatedAtUtc,
                    x.FieldValuesJson,
                    RoundStart = x.RequesterActions
                        .Where(a => a.Round == x.CurrentRound && (a.Kind == WorkflowRequesterActionKind.Submitted || a.Kind == WorkflowRequesterActionKind.Resubmitted))
                        .Max(a => (DateTime?)a.AtUtc),
                    Finished = x.StepDecisions.Max(d => (DateTime?)d.ActedAtUtc),
                })
                .ToListAsync();

            _capped = rows.Count == MaxRows;
            _report = HelpdeskReport.Build(
                rows.Select(r => new HelpdeskReportRow(r.Id, r.Status, r.CreatedAtUtc, r.RoundStart ?? r.CreatedAtUtc, r.Finished, r.FieldValuesJson)),
                DateTime.UtcNow);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Num(double value) => WorkflowDisplay.ToPersianDigits(value.ToString("N0"));
}
