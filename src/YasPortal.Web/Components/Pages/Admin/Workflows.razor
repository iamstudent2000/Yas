@page "/admin/workflows"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Domain.Workflows
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize(Policy = "Admin.Workflows")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AdminQueryService AdminQueries
@inject WorkflowService WorkflowSvc
@inject AppState AppState

<PageTitle>مراحل گردش‌کار - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <div class="page-header">
        <div>
            <div class="page-kicker">مدیریت سامانه / گردش‌کار</div>
            <h1 class="page-title"><i class="bx bx-git-branch"></i> مراحل گردش‌کار</h1>
            <p class="page-subtitle">فیلدهای هر نوع گردش‌کار ثابت است؛ مسیر تایید (مراحل) هر نوع را اینجا تعریف کنید.
            </p>
        </div>
    </div>

<div class="admin-stack">
        <section class="card">
            <div class="card-heading">
                <div class="card-heading-icon"><i class="bx bx-list-ul"></i></div>
                <div>
                    <h2 class="section-title">انواع گردش‌کار</h2>
                    <p class="muted">یک نوع را انتخاب کنید تا مراحل تایید آن را ببینید.</p>
                </div>
            </div>
            <div class="admin-list-rows workflow-type-list">
                @foreach (var type in WorkflowFieldCatalog.AllTypes)
                {
                    var selected = _selectedType == type;
                    <div class="admin-list-row @(selected ? "admin-list-row-selected" : "")"
                         @onclick="() => SelectType(type)">
                        <div class="admin-list-primary">
                            <span class="admin-list-avatar"><i class="bx bx-shape-square"></i></span>
                            <span class="admin-list-text">
                                <strong>@WorkflowFieldCatalog.GetDisplayName(type)</strong>
                                <span class="badge badge-muted">@type</span>
                            </span>
                        </div>
                        <div class="admin-list-meta">
                            <span class="admin-pill"><i class="bx bx-list-check"></i> @StepCountFor(type) مرحله</span>
                        </div>
                    </div>
                }
            </div>
        </section>

<section class="card admin-form-row workflow-form-row">
            <div class="card-heading">
                <div class="card-heading-icon"><i
                    class="bx @(_editingId is null ? "bx-layer-plus" : "bx-edit-alt")"></i></div>
                    <div>
                        <h2 class="section-title">@(_editingId is null ? "مرحله جدید" : "ویرایش مرحله")</h2>
                        <p class="muted">برای «@WorkflowFieldCatalog.GetDisplayName(_selectedType)» یک مرحله تایید تعریف
                            کنید.</p>
                        </div>
                    </div>

                    @if (_blockingCount > 0)
                    {
                        <div class="empty-state" role="alert">
                            <i class="bx bx-lock-alt"></i>
                            <strong>تغییر مراحل فعلاً ممکن نیست</strong>
                            <span>@ToPersianDigits(_blockingCount.ToString()) درخواست فعال از این نوع در جریان است. تا زمانی که این درخواست‌ها تعیین تکلیف نشوند، مراحل این گردش‌کار قابل تغییر نیست.
                                <a href="/admin/active-requests">مشاهده و تعیین تکلیف درخواست‌های فعال</a></span>
                        </div>
                    }

<div class="admin-row-grid">
<div class="form-field is-grow">
                    <label class="form-label">نام مرحله</label>
                    <input class="form-control" @bind="_name" maxlength="200" placeholder="مثلاً تایید مدیر مستقیم" />
</div>

<div class="form-field is-grow">
                    <label class="form-label">نحوه تعیین تاییدکننده</label>
                    <div class="form-radio-group">
                        <label><input type="radio" name="approverKind"
                                          checked="@(_ruleKind == ApproverRuleKind.RequesterManagerLevel)"
                                          @onchange='() => _ruleKind = ApproverRuleKind.RequesterManagerLevel' /> بر اساس سلسله‌مراتب
                            درخواست‌کننده (چند سطح بالاتر)</label>
                            <label><input type="radio" name="approverKind"
                                              checked="@(_ruleKind == ApproverRuleKind.SpecificPosition)"
                                              @onchange='() => _ruleKind = ApproverRuleKind.SpecificPosition' /> یک سمت ثابت مشخص</label>
                            <label><input type="radio" name="approverKind"
                                              checked="@(_ruleKind == ApproverRuleKind.EscalateToTreeLevel)"
                                              @onchange='() => _ruleKind = ApproverRuleKind.EscalateToTreeLevel' /> ارجاع پله‌به‌پله تا یک سطح از بالای درخت سازمانی</label>
                            </div>
</div>

                            @if (_ruleKind == ApproverRuleKind.RequesterManagerLevel)
                            {
<div class="form-field">
                                <label class="form-label">چند سطح بالاتر از سمت درخواست‌کننده؟</label>
                                <input class="form-control" type="number" min="1" max="10" @bind="_managerLevel" />
                                <p class="muted">۱ یعنی مدیر مستقیم سمت درخواست‌کننده، ۲ یعنی مدیرِ مدیر او و به همین ترتیب.</p>
</div>
                            }
                            else if (_ruleKind == ApproverRuleKind.EscalateToTreeLevel)
                            {
<div class="form-field">
                                <label class="form-label">تا کدام سطح از بالای درخت سازمانی؟</label>
                                <input class="form-control" type="number" min="1" max="20" @bind="_treeLevel" />
                                <p class="muted">بالاترین سمت سازمان «سطح ۱» است و زیرمجموعه‌های مستقیم آن «سطح ۲». درخواست ابتدا به مدیر مستقیم درخواست‌کننده می‌رسد و بعد پله‌به‌پله، یکی‌یکی از تک‌تک مدیران میانی عبور می‌کند تا به سمتِ این سطح برسد؛ پس از تایید آن سمت، به مرحله بعدی می‌رود. تعداد تاییدها به عمق سمت درخواست‌کننده بستگی دارد.</p>
</div>
                            }
                            else
                            {
<div class="form-field">
                                <label class="form-label">سمت تاییدکننده</label>
                                <ServerSearchableGuidSelect Value="@_approverPositionId" ValueChanged="id => _approverPositionId = id"
                                                            SearchAsync="SearchPositionsAsync" SelectedText="@_approverPositionSearch"
                                                            Placeholder="یک سمت را انتخاب کنید" SearchPlaceholder="نام یا کد سمت را جستجو کنید..." />
</div>
                            }

                            @if (_editingId is null && _steps.Count > 0)
                            {
<div class="form-field">
                                <label class="form-label">محل افزودن</label>
                                <select class="form-control" value="@_placement" @onchange="e => _placement = e.Value?.ToString() ?? PlacementEnd">
                                    <option value="@PlacementEnd">مرحله جدید در انتهای مسیر</option>
                                    @foreach (var order in _steps.Select(x => x.Order).Distinct().OrderBy(x => x))
                                    {
                                        <option value="@($"after:{order}")">مرحله جدید، بعد از مرحله @ToPersianDigits(order.ToString())</option>
                                        <option value="@($"join:{order}")">تاییدکننده موازی در مرحله @ToPersianDigits(order.ToString())</option>
                                    }
                                </select>
                                <p class="muted">«موازی» یعنی این تاییدکننده هم‌زمان با تاییدکننده‌های همان مرحله تصمیم می‌گیرد. شرط تکمیل و سیاست رد را در سرتیتر کارت همان مرحله تنظیم می‌کنید.</p>
</div>
                            }

<div class="form-field is-grow admin-row-check">
                            <label class="form-label" style="display:flex;align-items:center;gap:8px">
                                <input type="checkbox" @bind="_allowDelegation" />
                                <span>تاییدکننده می‌تواند اختیار این مرحله را تفویض کند</span>
                            </label>
                            <p class="muted">اگر خاموش باشد، فقط جانشین موقتی که مدیر سامانه تعیین می‌کند می‌تواند به‌جای تاییدکننده تصمیم بگیرد.</p>
</div>

@if (WorkflowFieldCatalog.IsMultiPart(_selectedType))
{
<div class="form-field is-grow">
                            <label class="form-label">بخشی از فرم که تاییدکننده‌ی این مرحله تکمیل می‌کند</label>
                            <select class="form-control" disabled="@(_ruleKind == ApproverRuleKind.EscalateToTreeLevel)" value="@_fillsPart" @onchange="e => _fillsPart = int.TryParse(e.Value?.ToString(), out var chosenPart) ? chosenPart : 0">
                                <option value="0">— هیچ بخشی (فقط تصمیم می‌گیرد) —</option>
                                @foreach (var part in WorkflowFieldCatalog.GetParts(_selectedType).Where(p => p.Part > 1))
                                {
                                    <option value="@part.Part">بخش @ToPersianDigits(part.Part.ToString()): @part.Title</option>
                                }
                            </select>
                            <p class="muted">این فرم چندبخشی است. بخش اول را درخواست‌کننده پر می‌کند؛ هر بخش بعدی به یک مرحله‌ی تایید اختصاص می‌یابد: یک تاییدکننده، یا یک گروه موازی با شرط «تایید یکی کافی است» (هر عضوی که اول تایید کند بخش را پر می‌کند و تنظیم برای همه‌ی اعضای گروه یکسان می‌شود). مرحله‌ی «ارجاع پله‌به‌پله» نمی‌تواند بخشی را تکمیل کند. تاییدکننده پیش از تایید باید آن بخش را تکمیل کند.</p>
</div>
}

<div class="form-field admin-row-submit">
                            <div class="form-actions">
                                <button class="btn btn-primary" @onclick="SaveStep"><i class="bx bx-save"></i> @(_editingId is null ?
                                          "افزودن مرحله" : "ذخیره")</button>
                                    @if (_editingId is not null)
                                    {
                                        <button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button>
                                    }
                                </div>
</div></div>
</section>
<section class="card workflow-steps-card">

                                @if (!_loading && _steps.Count > 0 && WorkflowFieldCatalog.IsMultiPart(_selectedType) && PartProblems() is { Count: > 0 } partProblems)
                                {
                                    <div class="empty-state" role="alert">
                                        <i class="bx bx-error-circle"></i>
                                        <strong>تخصیص بخش‌های فرم کامل نیست</strong>
                                        @foreach (var problem in partProblems)
                                        {
                                            <span>@problem</span>
                                        }
                                    </div>
                                }

                                @if (_loading)
                                {
                                    <LoadingState />
                                }
                                else if (_steps.Count == 0)
                                {
                                    <div class="empty-state"><i class="bx bx-error-circle"></i><strong>هنوز مرحله‌ای تعریف نشده
                                        است</strong><span>تا وقتی حداقل یک مرحله تعریف نشود، کارمندان نمی‌توانند این نوع گردش‌کار را ثبت
                                        کنند.</span></div>
                                    }
            else
                                    {
                                        var stages = _steps.GroupBy(x => x.Order).OrderBy(g => g.Key).ToList();
                                        <div class="stage-list">
                                            @foreach (var stage in stages)
                                            {
                                                var members = stage.OrderBy(x => x.Name, StringComparer.Ordinal).ToList();
                                                var parallel = members.Count > 1;
                                                <div class="stage-card @(parallel ? "is-parallel" : "")">
                                                    <div class="stage-card-head">
                                                        <span class="admin-list-avatar">@ToPersianDigits(stage.Key.ToString())</span>
                                                        <strong>@(parallel ? "مرحله موازی" : "مرحله")</strong>
                                                        @if (parallel)
                                                        {
                                                            <select class="form-control stage-policy" title="شرط تکمیل مرحله" value="@members[0].ApprovalMode" @onchange="e => SetStageApprovalModeAsync(stage.Key, e)">
                                                                <option value="@ParallelApprovalMode.All">تایید همه لازم است</option>
                                                                <option value="@ParallelApprovalMode.Any">تایید یکی کافی است</option>
                                                            </select>
                                                            <select class="form-control stage-policy" title="سیاست رد" value="@members[0].RejectPolicy" @onchange="e => SetStageRejectPolicyAsync(stage.Key, e)">
                                                                <option value="@ParallelRejectPolicy.Immediate">رد فوری</option>
                                                                <option value="@ParallelRejectPolicy.WaitForAll">رد پس از پاسخ همه</option>
                                                            </select>
                                                        }
                                                        <span class="stage-actions">
                                                            <button type="button" class="btn btn-secondary btn-sm" title="انتقال مرحله به بالا" disabled="@(stage.Key == _steps.Min(x => x.Order))" @onclick="() => MoveUp(members[0].Id)"><i class="bx bx-up-arrow-alt"></i></button>
                                                            <button type="button" class="btn btn-secondary btn-sm" title="انتقال مرحله به پایین" disabled="@(stage.Key == _steps.Max(x => x.Order))" @onclick="() => MoveDown(members[0].Id)"><i class="bx bx-down-arrow-alt"></i></button>
                                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => StartAdd(PlacementJoin(stage.Key))"><i class="bx bx-user-plus"></i> تاییدکننده موازی</button>
                                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => StartAdd(PlacementAfter(stage.Key))"><i class="bx bx-layer-plus"></i> مرحله بعد از این</button>
                                                        </span>
                                                    </div>
                                                    <div class="stage-members">
                                                        @foreach (var step in members)
                                                        {
                                                            <div class="stage-member @(step.IsActive ? "" : "is-inactive")">
                                                                <span class="admin-list-text">
                                                                    <strong>@step.Name</strong>
                                                                    <span>@DescribeRule(step)</span>
                                                                    @if (!step.IsActive)
                                                                    {
                                                                        <span class="badge badge-muted">غیرفعال</span>
                                                                    }
                                                                    @if (!step.AllowDelegation)
                                                                    {
                                                                        <span class="badge badge-warning">بدون تفویض</span>
                                                                    }
                                                                    @if (WorkflowFieldCatalog.GetStepPart(step.WorkflowType, step.FillsPart) is { } fillsPart)
                                                                    {
                                                                        <span class="badge badge-info"><i class="bx bx-edit"></i> تکمیل بخش @ToPersianDigits(fillsPart.Part.ToString()): @fillsPart.Title</span>
                                                                    }
                                                                </span>
                                                                <span class="stage-actions">
                                                                    <button type="button" class="btn btn-secondary btn-sm" disabled="@(!parallel && step.Order == _steps.Min(x => x.Order))" @onclick="() => ToggleParallel(step.Id)"><i class="bx bx-git-compare"></i> @(parallel ? "جدا کردن به مرحله مستقل" : "موازی با مرحله قبل")</button>
                                                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => EditStep(step)"><i class="bx bx-edit-alt"></i> ویرایش</button>
                                                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => ToggleActive(step.Id)"><i class="bx @(step.IsActive ? "bx-pause-circle" : "bx-play-circle")"></i> @(step.IsActive ? "غیرفعال کردن" : "فعال کردن")</button>
                                                                    <button type="button" class="btn btn-danger btn-sm" @onclick="() => DeleteStep(step.Id)"><i class="bx bx-trash"></i> حذف</button>
                                                                </span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                                @if (stage.Key != stages[^1].Key)
                                                {
                                                    <div class="stage-arrow" aria-hidden="true"><i class="bx bx-down-arrow-alt"></i></div>
                                                }
                                            }
                                        </div>
                                    }

                                    @if (_steps.Count > 0)
                                    {
                                        <hr class="section-divider" />
                                        <div class="card-heading">
                                            <div class="card-heading-icon"><i class="bx bx-test-tube"></i></div>
                                            <div>
                                                <h2 class="section-title">آزمایش مسیر</h2>
                                                <p class="muted">سمت یک درخواست‌کننده را انتخاب کنید تا ببینید درخواستِ او دقیقاً از چه مسیری می‌گذرد؛ همان منطقی که هنگام ثبت واقعی اجرا می‌شود.</p>
                                            </div>
                                        </div>
                                        <ServerSearchableGuidSelect Value="@_previewPositionId" ValueChanged="OnPreviewPositionAsync"
                                                                    SearchAsync="SearchPositionsAsync"
                                                                    Placeholder="سمت درخواست‌کننده را انتخاب کنید" SearchPlaceholder="نام یا کد سمت را جستجو کنید..." />
                                        @if (_preview is not null)
                                        {
                                            @if (!_preview.Success)
                                            {
                                                <div class="empty-state" role="alert">
                                                    <i class="bx bx-error-circle"></i>
                                                    <strong>درخواستی از این سمت ثبت نمی‌شود</strong>
                                                    <span>@WorkflowService.DescribeErrors(_preview.Errors)</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="stage-list stage-preview">
                                                    @foreach (var stage in _preview.Stages)
                                                    {
                                                        <div class="stage-card @(stage.IsParallel ? "is-parallel" : "")">
                                                            <div class="stage-card-head">
                                                                <span class="admin-list-avatar">@ToPersianDigits(stage.Number.ToString())</span>
                                                                <strong>@(stage.IsParallel ? "مرحله موازی" : "مرحله")</strong>
                                                                @if (stage.IsParallel)
                                                                {
                                                                    <span class="badge badge-info">@(stage.Mode == ParallelApprovalMode.Any ? "تایید یکی کافی است" : "تایید همه لازم است")</span>
                                                                    <span class="badge badge-muted">@(stage.RejectPolicy == ParallelRejectPolicy.WaitForAll ? "رد پس از پاسخ همه" : "رد فوری")</span>
                                                                }
                                                            </div>
                                                            <div class="stage-members">
                                                                @foreach (var approver in stage.Approvers)
                                                                {
                                                                    var holder = _previewHolders.TryGetValue(approver.PositionId, out var holderName) ? holderName : null;
                                                                    <div class="stage-member">
                                                                        <span class="admin-list-text">
                                                                            <strong>@approver.Name</strong>
                                                                            <span>@(_previewPositionNames.TryGetValue(approver.PositionId, out var positionName) ? positionName : "؟") — @(holder ?? "سمت خالی است")</span>
                                                                            @if (holder is null)
                                                                            {
                                                                                <span class="badge badge-danger">سمت خالی؛ درخواست همین‌جا متوقف می‌شود</span>
                                                                            }
                                                                            @if (_previewInactivePositions.Contains(approver.PositionId))
                                                                            {
                                                                                <span class="badge badge-danger">سمت غیرفعال؛ ثبت درخواست رد می‌شود</span>
                                                                            }
                                                                        </span>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                        @if (stage.Number != _preview.Stages[^1].Number)
                                                        {
                                                            <div class="stage-arrow" aria-hidden="true"><i class="bx bx-down-arrow-alt"></i></div>
                                                        }
                                                    }
                                                </div>
                                            }
                                        }
                                    }
                                                </section>
                                            </div>
                                        </div>

@code {
    private WorkflowTypeCode _selectedType = WorkflowFieldCatalog.AllTypes[0];
    private List<WorkflowStepDefinition> _steps = [];
    private Dictionary<WorkflowTypeCode, int> _stepCounts = [];
    private Dictionary<Guid, string> _positionNames = [];
    private Dictionary<Guid, string> _holderNames = [];
    private bool _loading;

    // Active requests of the selected type (spec §18 / §22.2): while this is above zero the
    // type's steps cannot be changed. Refreshed whenever the steps are (re)loaded.
    private int _blockingCount;

    private Guid? _editingId;
    private string _name = "";
    private ApproverRuleKind _ruleKind = ApproverRuleKind.RequesterManagerLevel;
    private int _managerLevel = 1;
    private int _treeLevel = 2;
    private bool _allowDelegation = true;
    private int _fillsPart; // 0 = the step fills no part of the form

    // Where a new step goes: "end", "after:N" (a new stage after stage N) or "join:N" (parallel approver in stage N).
    private const string PlacementEnd = "end";
    private static string PlacementAfter(int order) => $"after:{order}";
    private static string PlacementJoin(int order) => $"join:{order}";
    private string _placement = PlacementEnd;

    // "Try it" preview: the resolved path for a chosen requester position.
    private Guid? _previewPositionId;
    private WorkflowPathPreview? _preview;
    private Dictionary<Guid, string> _previewPositionNames = [];
    private Dictionary<Guid, string> _previewHolders = [];
    private HashSet<Guid> _previewInactivePositions = [];
    private Guid? _approverPositionId;
    private string _approverPositionSearch = "";

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        foreach (var type in WorkflowFieldCatalog.AllTypes)
            _stepCounts[type] = await db.WorkflowStepDefinitions.CountAsync(x => x.WorkflowType == type);
        await LoadStepsAsync();
    }

    private int StepCountFor(WorkflowTypeCode type) => _stepCounts.TryGetValue(type, out var count) ? count : 0;

    private async Task SelectType(WorkflowTypeCode type)
    {
        _selectedType = type;
        _previewPositionId = null;
        CancelEdit();
        await LoadStepsAsync();
    }

    private async Task LoadStepsAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _steps = await db.WorkflowStepDefinitions.AsNoTracking().Where(x => x.WorkflowType == _selectedType).OrderBy(x =>
x.Order).ToListAsync();
            var positionIds = _steps.Where(x => x.ApproverPositionId is not null).Select(x =>
x.ApproverPositionId!.Value).Distinct().ToList();
            _positionNames = positionIds.Count == 0
                ? []
                : await db.Positions.AsNoTracking().Where(x => positionIds.Contains(x.Id)).ToDictionaryAsync(x => x.Id, x => x.Name);
            _holderNames = positionIds.Count == 0 ? [] : await WorkflowSvc.GetCurrentHolderNamesAsync(positionIds);
            _stepCounts[_selectedType] = _steps.Count;
            _blockingCount = await WorkflowSvc.CountBlockingRequestsAsync(_selectedType);
            await RefreshPreviewAsync();
        }
        finally { _loading = false; }
    }

    /// <summary>
    /// Server-side enforcement of spec §18 / §22.2, checked fresh right before every change (the
    /// banner above is only informational and can be stale). Returns true when the change may go ahead.
    /// </summary>
    private async Task<bool> EnsureNoBlockingRequestsAsync()
    {
        var count = await WorkflowSvc.CountBlockingRequestsAsync(_selectedType);
        _blockingCount = count;
        if (count == 0)
            return true;

        AppState.AddToast($"این نوع گردش‌کار {ToPersianDigits(count.ToString())} درخواست فعال دارد که باید ابتدا تعیین تکلیف شود؛ تا آن زمان مراحل آن قابل تغییر نیست.", ToastLevel.Error);
        return false;
    }

    private string DescribeRule(WorkflowStepDefinition step) => step.ApproverRuleKind switch
    {
        ApproverRuleKind.RequesterManagerLevel =>
            $"{ToPersianDigits(step.ManagerLevel!.Value.ToString())} سطح بالاتر از درخواست‌کننده",
        ApproverRuleKind.EscalateToTreeLevel =>
            $"ارجاع پله‌به‌پله از مدیر مستقیم تا سطح {ToPersianDigits(step.TreeLevel!.Value.ToString())} درخت سازمانی (از بالا)",
        _ => $"سمت ثابت: {(_positionNames.TryGetValue(step.ApproverPositionId!.Value, out var name) ? name : "؟")}" +
             $" — کارمند فعلی: {(_holderNames.TryGetValue(step.ApproverPositionId!.Value, out var holder) ? holder : "سمت خالی است")}",
    };

    private void EditStep(WorkflowStepDefinition step)
    {
        _editingId = step.Id;
        _name = step.Name;
        _ruleKind = step.ApproverRuleKind;
        _managerLevel = step.ManagerLevel ?? 1;
        _treeLevel = step.TreeLevel ?? 2;
        _allowDelegation = step.AllowDelegation;
        _fillsPart = step.FillsPart ?? 0;
        _approverPositionId = step.ApproverPositionId;
        _approverPositionSearch = step.ApproverPositionId is Guid pid && _positionNames.TryGetValue(pid, out var name) ? name :
"";
    }

    private void CancelEdit()
    {
        _editingId = null;
        _name = "";
        _ruleKind = ApproverRuleKind.RequesterManagerLevel;
        _managerLevel = 1;
        _treeLevel = 2;
        _allowDelegation = true;
        _fillsPart = 0;
        _placement = PlacementEnd;
        _approverPositionId = null;
        _approverPositionSearch = "";
    }

    /// <summary>
    /// Why <paramref name="kind"/> / <paramref name="positionId"/> cannot sit in a group with
    /// <paramref name="siblings"/>, or null when it can: an escalation expands into its own sequence,
    /// and two members on the same fixed position would make that position approve twice side by side.
    /// </summary>
    private static string? ParallelMemberProblem(IReadOnlyCollection<WorkflowStepDefinition> siblings, ApproverRuleKind kind, Guid? positionId)
    {
        if (siblings.Count == 0)
            return null;
        if (kind == ApproverRuleKind.EscalateToTreeLevel || siblings.Any(x => x.ApproverRuleKind == ApproverRuleKind.EscalateToTreeLevel))
            return "مرحله‌ی «ارجاع پله‌به‌پله» نمی‌تواند در گروه موازی باشد.";
        if (kind == ApproverRuleKind.SpecificPosition && positionId is Guid pid && siblings.Any(x => x.ApproverPositionId == pid))
            return "یک سمت نمی‌تواند دو بار در یک گروه موازی بیاید.";
        return null;
    }

    /// <summary>
    /// Why a step cannot fill the chosen form part, or null when it can (0 = no part).
    /// <paramref name="groupMode"/> is the approval mode of the parallel group the step ends up in (null when it
    /// is alone); <paramref name="otherStages"/> are the steps outside this step's own stage.
    /// </summary>
    private static string? FillsPartProblem(int part, ApproverRuleKind kind, ParallelApprovalMode? groupMode, IEnumerable<WorkflowStepDefinition> otherStages)
    {
        if (part == 0)
            return null;
        if (kind == ApproverRuleKind.EscalateToTreeLevel)
            return "مرحله‌ی «ارجاع پله‌به‌پله» چند تاییدکننده دارد و نمی‌تواند یک بخش فرم را تکمیل کند.";
        if (groupMode == ParallelApprovalMode.All)
            return "در گروه موازی، بخش فرم فقط وقتی قابل تکمیل است که شرط تکمیل مرحله «تایید یکی کافی است» باشد؛ هر عضوی که اول تایید کند آن را پر می‌کند. ابتدا شرط تکمیل مرحله را تغییر دهید.";
        if (otherStages.Any(x => x.IsActive && x.FillsPart == part))
            return "این بخش از فرم قبلاً به مرحله‌ی دیگری اختصاص داده شده است.";
        return null;
    }

    /// <summary>What is wrong with how the selected type's form parts are assigned to its active steps (empty when all is well).</summary>
    private List<string> PartProblems()
    {
        var problems = new List<string>();
        foreach (var part in WorkflowFieldCatalog.GetParts(_selectedType).Where(p => p.Part > 1))
        {
            var assigned = _steps.Where(x => x.IsActive && x.FillsPart == part.Part).ToList();
            if (assigned.Count == 0)
            {
                problems.Add($"بخش «{part.Title}» به هیچ مرحله‌ای اختصاص داده نشده است؛ تا آن زمان ثبت درخواست جدید از این نوع ممکن نیست.");
                continue;
            }
            if (assigned.Select(x => x.Order).Distinct().Count() > 1)
            {
                problems.Add($"بخش «{part.Title}» به بیش از یک مرحله اختصاص داده شده است؛ هر بخش فقط به یک مرحله تعلق دارد.");
                continue;
            }

            var stage = _steps.Where(x => x.IsActive && x.Order == assigned[0].Order).ToList();
            if (stage.Any(x => x.ApproverRuleKind == ApproverRuleKind.EscalateToTreeLevel))
                problems.Add($"بخش «{part.Title}» به مرحله‌ی «ارجاع پله‌به‌پله» اختصاص دارد که نمی‌تواند آن را تکمیل کند.");
            else if (stage.Count > 1 && stage.Count != assigned.Count)
                problems.Add($"بخش «{part.Title}» باید برای همه‌ی تاییدکننده‌های گروه موازی یکسان تنظیم شود.");
            else if (stage.Count > 1 && stage[0].ApprovalMode != ParallelApprovalMode.Any)
                problems.Add($"بخش «{part.Title}» به یک گروه موازی اختصاص دارد؛ شرط تکمیل آن گروه باید «تایید یکی کافی است» باشد.");
        }
        return problems;
    }

    private static (string Kind, int Order) ParsePlacement(string placement)
    {
        var parts = placement.Split(':', 2);
        return parts.Length == 2 && int.TryParse(parts[1], out var order) && parts[0] is "after" or "join"
            ? (parts[0], order)
            : (PlacementEnd, 0);
    }

    /// <summary>Points the add form at a stage ("add a parallel approver here", "add a stage after this").</summary>
    private void StartAdd(string placement)
    {
        CancelEdit();
        _placement = placement;
        AppState.AddToast("فرم افزودن در بالای صفحه برای همین محل تنظیم شد.", ToastLevel.Info);
    }

    private async Task SetStageApprovalModeAsync(int order, ChangeEventArgs e)
    {
        if (Enum.TryParse<ParallelApprovalMode>(e.Value?.ToString(), out var mode))
            await SetStagePolicyAsync(order, mode, null);
    }

    private async Task SetStageRejectPolicyAsync(int order, ChangeEventArgs e)
    {
        if (Enum.TryParse<ParallelRejectPolicy>(e.Value?.ToString(), out var policy))
            await SetStagePolicyAsync(order, null, policy);
    }

    /// <summary>One mode and one reject policy per stage: changing either updates every approver in it.</summary>
    private async Task SetStagePolicyAsync(int order, ParallelApprovalMode? mode, ParallelRejectPolicy? policy)
    {
        if (!await EnsureNoBlockingRequestsAsync())
        {
            await LoadStepsAsync();
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var members = await db.WorkflowStepDefinitions.Where(x => x.WorkflowType == _selectedType && x.Order == order).ToListAsync();
        if (mode == ParallelApprovalMode.All && members.Count > 1 && members.Any(x => x.FillsPart is not null))
        {
            AppState.AddToast("این گروه موازی یک بخش فرم را تکمیل می‌کند و باید روی «تایید یکی کافی است» بماند؛ ابتدا تخصیص بخش را از آن بردارید.", ToastLevel.Error);
            await LoadStepsAsync();
            return;
        }
        foreach (var member in members)
            member.SetParallelPolicy(mode ?? member.ApprovalMode, policy ?? member.RejectPolicy);
        await db.SaveChangesAsync();
        await LoadStepsAsync();
    }

    private async Task OnPreviewPositionAsync(Guid? positionId)
    {
        _previewPositionId = positionId;
        await RefreshPreviewAsync();
    }

    /// <summary>
    /// Resolves the path with the same <see cref="WorkflowStepResolver"/> real submissions use, so what
    /// the admin sees here is what a request from that position would get — or why it would be refused.
    /// </summary>
    private async Task RefreshPreviewAsync()
    {
        _preview = null;
        _previewPositionNames = [];
        _previewHolders = [];
        _previewInactivePositions = [];
        if (_previewPositionId is not Guid positionId || _steps.Count == 0)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var parents = await db.Positions.AsNoTracking().Select(x => new { x.Id, x.ParentPositionId }).ToDictionaryAsync(x => x.Id, x => x.ParentPositionId);
        _preview = WorkflowPathPreview.From(WorkflowStepResolver.Resolve(_steps, positionId, parents));

        var ids = _preview.Stages.SelectMany(s => s.Approvers).Select(a => a.PositionId).Distinct().ToList();
        if (ids.Count == 0)
            return;
        var positions = await db.Positions.AsNoTracking().Where(x => ids.Contains(x.Id)).Select(x => new { x.Id, x.Name, x.IsActive }).ToListAsync();
        _previewPositionNames = positions.ToDictionary(x => x.Id, x => x.Name);
        _previewInactivePositions = positions.Where(x => !x.IsActive).Select(x => x.Id).ToHashSet();
        _previewHolders = await WorkflowSvc.GetCurrentHolderNamesAsync(ids);
    }

    private async Task SaveStep()
    {
        var name = _name.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            AppState.AddToast("نام مرحله الزامی است.", ToastLevel.Error);
            return;
        }
        if (_ruleKind == ApproverRuleKind.RequesterManagerLevel && _managerLevel < 1)
        {
            AppState.AddToast("سطح مدیریت باید حداقل ۱ باشد.", ToastLevel.Error);
            return;
        }
        if (_ruleKind == ApproverRuleKind.EscalateToTreeLevel && _treeLevel < 1)
        {
            AppState.AddToast("سطح درخت سازمانی باید حداقل ۱ باشد.", ToastLevel.Error);
            return;
        }
        if (_ruleKind == ApproverRuleKind.SpecificPosition && _approverPositionId is null)
        {
            AppState.AddToast("یک سمت تاییدکننده را انتخاب کنید.", ToastLevel.Error);
            return;
        }

        if (!await EnsureNoBlockingRequestsAsync())
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        if (_editingId is Guid id)
        {
            var existing = await db.WorkflowStepDefinitions.SingleAsync(x => x.Id == id);
            var siblings = await db.WorkflowStepDefinitions.Where(x => x.WorkflowType == existing.WorkflowType && x.Order == existing.Order && x.Id != id).ToListAsync();
            if (ParallelMemberProblem(siblings, _ruleKind, _approverPositionId) is string groupProblem)
            {
                AppState.AddToast(groupProblem, ToastLevel.Error);
                return;
            }
            var otherStages = await db.WorkflowStepDefinitions.Where(x => x.WorkflowType == existing.WorkflowType && x.Order != existing.Order).ToListAsync();
            if (FillsPartProblem(_fillsPart, _ruleKind, siblings.Count > 0 ? siblings[0].ApprovalMode : null, otherStages) is string partProblem)
            {
                AppState.AddToast(partProblem, ToastLevel.Error);
                return;
            }
            existing.Rename(name);
            existing.SetAllowDelegation(_allowDelegation);
            // One part per stage: in a parallel group the setting applies to every member, so whichever approves first fills it.
            foreach (var member in siblings.Append(existing))
                member.SetFillsPart(_fillsPart == 0 ? null : _fillsPart);
            switch (_ruleKind)
            {
                case ApproverRuleKind.RequesterManagerLevel: existing.UseManagerLevel(_managerLevel); break;
                case ApproverRuleKind.EscalateToTreeLevel: existing.UseTreeLevel(_treeLevel); break;
                default: existing.UseSpecificPosition(_approverPositionId!.Value); break;
            }
            await db.SaveChangesAsync();
            AppState.AddToast("مرحله ویرایش شد.", ToastLevel.Success);
        }
        else
        {
            var existingSteps = await db.WorkflowStepDefinitions.Where(x => x.WorkflowType == _selectedType).ToListAsync();
            var lastOrder = existingSteps.Count == 0 ? 0 : existingSteps.Max(x => x.Order);
            var (placementKind, placementOrder) = ParsePlacement(_placement);
            // A placement pointing at a stage that no longer exists falls back to the end of the path.
            if (existingSteps.Count == 0 || (placementKind != PlacementEnd && existingSteps.All(x => x.Order != placementOrder)))
                placementKind = PlacementEnd;

            var joining = placementKind == "join";
            var groupMembers = joining ? existingSteps.Where(x => x.Order == placementOrder).ToList() : new List<WorkflowStepDefinition>();
            if (ParallelMemberProblem(groupMembers, _ruleKind, _approverPositionId) is string joinProblem)
            {
                AppState.AddToast(joinProblem, ToastLevel.Error);
                return;
            }

            // A newcomer to a group that fills a part carries the same part (one part per stage); choosing a different one is refused.
            var groupPart = groupMembers.Select(x => x.FillsPart).FirstOrDefault(x => x is not null);
            if (joining && groupPart is not null && _fillsPart != 0 && _fillsPart != groupPart)
            {
                AppState.AddToast("این گروه موازی بخش دیگری از فرم را تکمیل می‌کند؛ تاییدکننده‌ی جدید باید همان بخش را تکمیل کند.", ToastLevel.Error);
                return;
            }
            var effectivePart = _fillsPart != 0 ? _fillsPart : groupPart ?? 0;
            // A group of one becomes "any one approves" when it is made to fill a part; an existing group keeps its mode.
            ParallelApprovalMode? resultingMode = joining ? (groupMembers.Count == 1 ? ParallelApprovalMode.Any : groupMembers[0].ApprovalMode) : null;
            if (FillsPartProblem(effectivePart, _ruleKind, resultingMode, existingSteps.Where(x => !(joining && x.Order == placementOrder))) is string newPartProblem)
            {
                AppState.AddToast(newPartProblem, ToastLevel.Error);
                return;
            }

            int nextOrder;
            switch (placementKind)
            {
                case "join":
                    nextOrder = placementOrder;
                    break;
                case "after":
                    // A new stage right after stage N: later stages make room (no unique order index to trip over).
                    nextOrder = placementOrder + 1;
                    foreach (var later in existingSteps.Where(x => x.Order > placementOrder))
                        later.SetOrder(later.Order + 1);
                    break;
                default:
                    nextOrder = lastOrder + 1;
                    break;
            }
            var step = _ruleKind switch
            {
                ApproverRuleKind.RequesterManagerLevel => new WorkflowStepDefinition(_selectedType, nextOrder, name, _managerLevel),
                ApproverRuleKind.EscalateToTreeLevel => WorkflowStepDefinition.EscalatingToTreeLevel(_selectedType, nextOrder, name, _treeLevel),
                _ => new WorkflowStepDefinition(_selectedType, nextOrder, name, _approverPositionId!.Value),
            };
            step.SetAllowDelegation(_allowDelegation);
            step.SetFillsPart(effectivePart == 0 ? null : effectivePart);
            // A newcomer to a parallel group follows the group's mode and reject policy (set on the stage card).
            if (joining && groupMembers.Count > 0)
            {
                var mode = effectivePart != 0 && groupMembers.Count == 1 ? ParallelApprovalMode.Any : groupMembers[0].ApprovalMode;
                foreach (var member in groupMembers.Append(step))
                {
                    member.SetParallelPolicy(mode, groupMembers[0].RejectPolicy);
                    if (effectivePart != 0)
                        member.SetFillsPart(effectivePart);
                }
            }
            db.WorkflowStepDefinitions.Add(step);
            await db.SaveChangesAsync();
            AppState.AddToast("مرحله اضافه شد.", ToastLevel.Success);
        }
        CancelEdit();
        await LoadStepsAsync();
    }

    private async Task DeleteStep(Guid id)
    {
        if (!await EnsureNoBlockingRequestsAsync())
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.WorkflowRequestSteps.AnyAsync(x => x.StepDefinitionId == id))
        {
            AppState.AddToast("این مرحله در درخواست‌های موجود استفاده شده و قابل حذف نیست؛ می‌توانید آن را غیرفعال کنید.",
ToastLevel.Error);
            return;
        }

        // The delete and the renumbering that closes the gap are two saves, so they run in one
        // transaction: a failure in between rolls the delete back instead of leaving the step order
        // with a hole in it. Removing one member of a parallel group leaves the rest of the group at
        // its order (a group of one is simply a sequential step), so only a vanished order closes up.
        await using var transaction = await db.Database.BeginTransactionAsync();
        var existing = await db.WorkflowStepDefinitions.SingleAsync(x => x.Id == id);
        db.WorkflowStepDefinitions.Remove(existing);
        await db.SaveChangesAsync();
        await NormalizeOrdersAsync(db, _selectedType);
        await transaction.CommitAsync();

        AppState.AddToast("مرحله حذف شد.", ToastLevel.Success);
        if (_editingId == id)
            CancelEdit();
        await LoadStepsAsync();
    }

    /// <summary>Renumbers the type's orders to 1..N, keeping their relative order. Steps sharing an order keep sharing one.</summary>
    private static async Task NormalizeOrdersAsync(ApplicationDbContext db, WorkflowTypeCode type)
    {
        var all = await db.WorkflowStepDefinitions.Where(x => x.WorkflowType == type).ToListAsync();
        var number = 0;
        foreach (var group in all.GroupBy(x => x.Order).OrderBy(g => g.Key))
        {
            number++;
            foreach (var definition in group.Where(d => d.Order != number))
                definition.SetOrder(number);
        }
        await db.SaveChangesAsync();
    }

    // Moving a step moves its whole order — a parallel group travels as one block.
    private async Task MoveUp(Guid id) => await MoveGroupAsync(id, -1);

    private async Task MoveDown(Guid id) => await MoveGroupAsync(id, +1);

    private async Task MoveGroupAsync(Guid id, int direction)
    {
        var step = _steps.FirstOrDefault(x => x.Id == id);
        if (step is null)
            return;
        var orders = _steps.Select(x => x.Order).Distinct().OrderBy(x => x).ToList();
        var index = orders.IndexOf(step.Order) + direction;
        if (index < 0 || index >= orders.Count)
            return;
        await SwapOrders(step.Order, orders[index]);
    }

    private async Task SwapOrders(int firstOrder, int secondOrder)
    {
        if (!await EnsureNoBlockingRequestsAsync())
            return;

        // No unique (WorkflowType, Order) index any more (parallel groups share an order), so
        // the swap is a single save.
        await using var db = await DbFactory.CreateDbContextAsync();
        var affected = await db.WorkflowStepDefinitions.Where(x => x.WorkflowType == _selectedType && (x.Order == firstOrder || x.Order == secondOrder)).ToListAsync();
        foreach (var definition in affected)
            definition.SetOrder(definition.Order == firstOrder ? secondOrder : firstOrder);
        await db.SaveChangesAsync();
        await LoadStepsAsync();
    }

    /// <summary>
    /// Makes a step run in parallel with the group before it, or — if it is already in a group —
    /// splits it off into its own step right after that group (spec §12.2).
    /// </summary>
    private async Task ToggleParallel(Guid id)
    {
        if (!await EnsureNoBlockingRequestsAsync())
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var all = await db.WorkflowStepDefinitions.Where(x => x.WorkflowType == _selectedType).ToListAsync();
        var step = all.SingleOrDefault(x => x.Id == id);
        if (step is null)
            return;

        var group = all.Where(x => x.Order == step.Order).ToList();
        if (group.Count > 1)
        {
            // Split: later orders make room, the step takes the order right after its old group.
            foreach (var later in all.Where(x => x.Order > step.Order))
                later.SetOrder(later.Order + 1);
            step.SetOrder(step.Order + 1);
            step.SetParallelPolicy(ParallelApprovalMode.All, ParallelRejectPolicy.Immediate);
            // The rest of the group keeps the form part (one part per stage); the separated step fills nothing.
            step.SetFillsPart(null);
        }
        else
        {
            var previousOrder = all.Where(x => x.Order < step.Order).Select(x => (int?)x.Order).Max();
            if (previousOrder is null)
            {
                AppState.AddToast("مرحله‌ای پیش از این وجود ندارد که بتواند با آن موازی شود.", ToastLevel.Error);
                return;
            }
            var previousGroup = all.Where(x => x.Order == previousOrder).ToList();
            if (ParallelMemberProblem(previousGroup, step.ApproverRuleKind, step.ApproverPositionId) is string problem)
            {
                AppState.AddToast(problem, ToastLevel.Error);
                return;
            }
            // One form part per stage: the merged stage carries the part of whichever side had one (both different is refused),
            // and a part needs "any one approves" — a group of one switches to it, an existing "all must approve" group is refused.
            var groupPart = previousGroup.Select(x => x.FillsPart).FirstOrDefault(x => x is not null);
            if (groupPart is not null && step.FillsPart is not null && groupPart != step.FillsPart)
            {
                AppState.AddToast("این دو مرحله بخش‌های متفاوتی از فرم را تکمیل می‌کنند و نمی‌توانند موازی شوند؛ ابتدا یکی از تخصیص‌ها را بردارید.", ToastLevel.Error);
                return;
            }
            var mergedPart = groupPart ?? step.FillsPart;
            var mergedMode = previousGroup[0].ApprovalMode;
            if (mergedPart is not null)
            {
                if (previousGroup.Count > 1 && mergedMode != ParallelApprovalMode.Any)
                {
                    AppState.AddToast("بخش فرم فقط در گروه موازیِ «تایید یکی کافی است» قابل تکمیل است؛ ابتدا شرط تکمیل آن گروه را تغییر دهید.", ToastLevel.Error);
                    return;
                }
                mergedMode = ParallelApprovalMode.Any;
            }
            // The newcomer adopts the group's policy; a group that was a single step starts from the defaults.
            foreach (var member in previousGroup.Append(step))
            {
                member.SetParallelPolicy(mergedMode, previousGroup[0].RejectPolicy);
                member.SetFillsPart(mergedPart);
            }
            step.SetOrder(previousOrder.Value);
        }
        await db.SaveChangesAsync();
        await NormalizeOrdersAsync(db, _selectedType);
        if (_editingId == id)
            CancelEdit();
        await LoadStepsAsync();
    }

    private async Task ToggleActive(Guid id)
    {
        if (!await EnsureNoBlockingRequestsAsync())
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.WorkflowStepDefinitions.SingleAsync(x => x.Id == id);
        if (existing.IsActive)
            existing.Deactivate();
        else
            existing.Activate();
        await db.SaveChangesAsync();

        AppState.AddToast(existing.IsActive ? "مرحله فعال شد." : "مرحله غیرفعال شد.", ToastLevel.Success);
        await LoadStepsAsync();
    }

    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchPositionsAsync(string search, CancellationToken ct) =>
AdminQueries.SearchPositionsAsync(search, null, null, ct, activeOnly: true);

    private static string ToPersianDigits(string value)
    {
        var digits = "۰۱۲۳۴۵۶۷۸۹";
        var chars = value.Select(c => c is >= '0' and <= '9' ? digits[c - '0'] : c).ToArray();
        return new string(chars);
    }
