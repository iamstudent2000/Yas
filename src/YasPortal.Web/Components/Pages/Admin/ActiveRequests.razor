@page "/admin/active-requests"
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Domain.Workflows
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize(Policy = "Requests.ForceClose")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject WorkflowService Workflows
@inject NotificationService NotificationSvc
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AppState AppState

<PageTitle>درخواست‌های فعال - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <div class="page-header">
        <div>
            <div class="page-kicker">مدیریت سامانه / گردش‌کار</div>
            <h1 class="page-title"><i class="bx bx-error-circle"></i> درخواست‌های فعال</h1>
            <p class="page-subtitle">
                هر درخواستی که هنوز در جریان است، صرف‌نظر از این‌که چه کسی آن را ثبت کرده یا در چه مرحله‌ای گیر کرده است.
                بستن اجباری یک اقدام برگشت‌ناپذیر SuperAdmin است — درخواست بدون نیاز به تایید هیچ‌یک از تاییدکنندگان بسته می‌شود
                و دلیل آن برای همیشه در سوابق ثبت می‌گردد.
            </p>
        </div>
    </div>

    <RequestFilterBar Filter="_filter" StatusOptions="_statusOptions" ShowStep="true" Changed="OnFilterChangedAsync" />

    @if (_loading)
    {
        <p class="muted">در حال بارگذاری...</p>
    }
    else if (_requests.Count == 0)
    {
        <p class="muted">@(_filter.IsEmpty ? "در حال حاضر هیچ درخواست فعالی در سامانه وجود ندارد." : "درخواستی با این فیلترها پیدا نشد.")</p>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>نوع</th>
                        <th>درخواست‌کننده</th>
                        <th>وضعیت</th>
                        <th>مرحله جاری</th>
                        <th>نزد سمت</th>
                        <th>تاریخ ثبت</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in _requests)
                    {
                        var currentStep = request.CurrentStep;
                        var vacant = currentStep is not null && !_holderNames.ContainsKey(currentStep.ApproverPositionId);
                        <tr>
                            <td>@WorkflowFieldCatalog.GetDisplayName(request.WorkflowType)</td>
                            <td>@(_employeeNames.TryGetValue(request.RequesterEmployeeId, out var rn) ? rn : "—")</td>
                            <td><span class="badge @WorkflowDisplay.StatusBadgeClass(request.Status)">@WorkflowDisplay.StatusLabel(request.Status)</span></td>
                            <td>@(currentStep?.Name ?? "—")</td>
                            <td>
                                @if (currentStep is null)
                                {
                                    <span class="muted">—</span>
                                }
                                else if (vacant)
                                {
                                    <span class="badge badge-danger">سمت خالی است</span>
                                }
                                else
                                {
                                    @(_holderNames.TryGetValue(currentStep.ApproverPositionId, out var holder) ? holder : "—")
                                }
                            </td>
                            <td>@WorkflowDisplay.ToPersianDate(request.CreatedAtUtc)</td>
                            <td>
                                @if (_openReasonFor == request.Id)
                                {
                                    <div class="force-close-panel">
                                        <input type="text" class="form-control" placeholder="دلیل بستن اجباری (الزامی)"
                                               value="@GetReason(request.Id)" @oninput="e => SetReason(request.Id, e)" />
                                        <div class="force-close-actions">
                                            <button type="button" class="btn btn-danger btn-sm" disabled="@(_busyId == request.Id || string.IsNullOrWhiteSpace(GetReason(request.Id)))"
                                                    @onclick="() => ForceCloseAsync(request.Id)">
                                                @if (_busyId == request.Id)
                                                {
                                                    <span><i class="bx bx-loader-alt bx-spin"></i> در حال ثبت...</span>
                                                }
                                                else
                                                {
                                                    <span>تایید بستن اجباری</span>
                                                }
                                            </button>
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _openReasonFor = null">انصراف</button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-danger btn-sm" @onclick="() => { _openReasonFor = request.Id; _openReassignFor = null; }">
                                        <i class="bx bx-x-circle"></i> بستن اجباری
                                    </button>
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => OpenReassign(request)">
                                        <i class="bx bx-transfer"></i> انتقال به گردش‌کار دیگر
                                    </button>
                                }
                                @if (_openReassignFor == request.Id)
                                {
                                    <div class="force-close-panel">
                                        <p class="muted">درخواست از مرحله اول گردش‌کار جدید دوباره شروع می‌شود؛ تایید‌های قبلی در سوابق می‌مانند و «کنار گذاشته‌شده» علامت می‌خورند. فیلدهای گردش‌کار جدید را تکمیل کنید.</p>
                                        <label class="form-label">گردش‌کار جدید</label>
                                        <select class="form-control" value="@_reassignType.ToString()" @onchange="e => ReassignTypeChanged(request, e)">
                                            @foreach (var type in WorkflowFieldCatalog.AllTypes.Where(t => t != request.WorkflowType))
                                            {
                                                <option value="@type">@WorkflowFieldCatalog.GetDisplayName(type)</option>
                                            }
                                        </select>
                                        <WorkflowFieldsForm Type="_reassignType" Values="_reassignValues" />
                                        <input type="text" class="form-control" placeholder="دلیل انتقال (الزامی)" value="@_reassignReason" @oninput="e => _reassignReason = e.Value?.ToString() ?? string.Empty" />
                                        <div class="force-close-actions">
                                            <button type="button" class="btn btn-primary btn-sm" disabled="@(_busyId == request.Id || string.IsNullOrWhiteSpace(_reassignReason))" @onclick="() => ReassignAsync(request.Id)">تایید انتقال</button>
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _openReassignFor = null">انصراف</button>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <ServerPagination Page="_page" PageSize="_pageSize" TotalCount="_total" Busy="_loading" PageChanged="GoToPageAsync" PageSizeChanged="OnPageSizeChangedAsync" />
    }
</div>

@code {
    private bool _loading = true;
    private List<WorkflowRequest> _requests = [];
    private Dictionary<Guid, string> _employeeNames = [];
    private Dictionary<Guid, string> _holderNames = [];
    private Dictionary<Guid, string> _reasons = [];
    private Guid? _openReasonFor;
    private Guid? _openReassignFor;
    private WorkflowTypeCode _reassignType;
    private Dictionary<string, string?> _reassignValues = [];
    private string _reassignReason = string.Empty;
    private Guid? _busyId;
    private Guid? _employeeId;
    private readonly WorkflowRequestFilter _filter = new();
    private readonly IReadOnlyList<WorkflowRequestStatus> _statusOptions = new[] { WorkflowRequestStatus.PendingApproval, WorkflowRequestStatus.ReturnedToRequester };
    private int _page = 1;
    private int _pageSize = 20;
    private int _total;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _employeeId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var eid) ? eid : null;
        await LoadAsync();
    }

    private async Task OnFilterChangedAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task OnPageSizeChangedAsync(int size)
    {
        _pageSize = Math.Clamp(size, 1, 100);
        _page = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();

        // "Active" here means still able to move — the same two statuses CanBeCancelled cares
        // about. Approved/Rejected/Cancelled requests are terminal and need no admin attention.
        var query = _filter.Apply(db.WorkflowRequests.Active(), db);
        _total = await query.CountAsync();
        if (_page > 1 && (_page - 1) * _pageSize >= _total)
            _page = Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));

        _requests = await query
            .Include(x => x.Steps)
            .OrderBy(x => x.CreatedAtUtc)
            .Skip((_page - 1) * _pageSize)
            .Take(_pageSize)
            .ToListAsync();

        var requesterIds = _requests.Select(x => x.RequesterEmployeeId).Distinct().ToList();
        _employeeNames = requesterIds.Count == 0 ? [] : await db.Employees.AsNoTracking()
            .Where(x => requesterIds.Contains(x.Id))
            .ToDictionaryAsync(x => x.Id, x => x.FullName);

        var pendingPositionIds = _requests.Select(x => x.CurrentStep).Where(x => x is not null).Select(x => x!.ApproverPositionId).Distinct().ToList();
        _holderNames = await Workflows.GetCurrentHolderNamesAsync(pendingPositionIds);

        _loading = false;
    }

    private void OpenReassign(WorkflowRequest request)
    {
        _openReasonFor = null;
        _openReassignFor = request.Id;
        _reassignReason = string.Empty;
        SelectReassignType(request, WorkflowFieldCatalog.AllTypes.First(t => t != request.WorkflowType));
    }

    private void ReassignTypeChanged(WorkflowRequest request, ChangeEventArgs e)
    {
        if (Enum.TryParse<WorkflowTypeCode>(e.Value?.ToString(), out var type) && type != request.WorkflowType)
            SelectReassignType(request, type);
    }

    /// <summary>Starts the new form with the values the request already has for fields the new type shares (same key).</summary>
    private void SelectReassignType(WorkflowRequest request, WorkflowTypeCode type)
    {
        _reassignType = type;
        _reassignValues = [];
        Dictionary<string, string?>? current = null;
        try { current = JsonSerializer.Deserialize<Dictionary<string, string?>>(request.FieldValuesJson); }
        catch (JsonException) { }
        foreach (var field in WorkflowFieldCatalog.GetFields(type))
            if (current is not null && current.TryGetValue(field.Key, out var value))
                _reassignValues[field.Key] = value;
    }

    private async Task ReassignAsync(Guid requestId)
    {
        if (_employeeId is not Guid adminId || string.IsNullOrWhiteSpace(_reassignReason))
            return;

        var errors = WorkflowFieldCatalog.ValidateValues(_reassignType, _reassignValues);
        if (errors.Count > 0)
        {
            AppState.AddToast(string.Join(" ", errors.Select(e => $"{e.Label}: {e.Message}")), ToastLevel.Error);
            return;
        }

        _busyId = requestId;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var tracked = await db.WorkflowRequests.Include(x => x.Steps).Include(x => x.FieldChanges).Include(x => x.RequesterActions).SingleOrDefaultAsync(x => x.Id == requestId);
            if (tracked is null)
            {
                await LoadAsync();
                return;
            }

            var resolved = await Workflows.ResolveStepsAsync(_reassignType, tracked.RequesterPositionId);
            if (!resolved.Success)
            {
                AppState.AddToast(resolved.Error!, ToastLevel.Error);
                return;
            }

            try
            {
                tracked.Reassign(adminId, _reassignType, JsonSerializer.Serialize(_reassignValues),
                    resolved.Steps.Select(s => (s.StepDefinitionId, s.Order, s.Name, s.ApproverPositionId)).ToList(), _reassignReason.Trim());
            }
            catch (InvalidOperationException)
            {
                AppState.AddToast("این درخواست دیگر فعال نیست؛ فهرست به‌روزرسانی شد.", ToastLevel.Info);
                await LoadAsync();
                return;
            }

            await NotificationSvc.StageAsync(db, tracked, WorkflowNotificationEvent.Reassigned);
            try
            {
                await db.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                AppState.AddToast("وضعیت این درخواست هم‌زمان تغییر کرد؛ فهرست به‌روزرسانی شد.", ToastLevel.Info);
                await LoadAsync();
                return;
            }

            AppState.AddToast("درخواست به گردش‌کار جدید منتقل شد.", ToastLevel.Success);
            _openReassignFor = null;
            await LoadAsync();
        }
        finally
        {
            _busyId = null;
        }
    }

    private string GetReason(Guid requestId) => _reasons.TryGetValue(requestId, out var r) ? r : "";
    private void SetReason(Guid requestId, ChangeEventArgs e) => _reasons[requestId] = e.Value?.ToString() ?? "";

    private async Task ForceCloseAsync(Guid requestId)
    {
        if (_employeeId is not Guid adminId)
            return;
        var reason = GetReason(requestId).Trim();
        if (string.IsNullOrWhiteSpace(reason))
            return;

        _busyId = requestId;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var tracked = await db.WorkflowRequests.Include(x => x.Steps).SingleOrDefaultAsync(x => x.Id == requestId);
            if (tracked is null)
            {
                await LoadAsync();
                return;
            }

            try
            {
                tracked.ForceClose(adminId, reason);
            }
            catch (InvalidOperationException)
            {
                // The list on screen was stale: someone approved, rejected or cancelled this
                // request after the page loaded. Refresh instead of crashing the circuit.
                AppState.AddToast("این درخواست دیگر فعال نیست؛ فهرست به‌روزرسانی شد.", ToastLevel.Info);
                await LoadAsync();
                return;
            }

            await NotificationSvc.StageAsync(db, tracked, WorkflowNotificationEvent.ForceClosed);

            try
            {
                await db.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                AppState.AddToast("وضعیت این درخواست هم‌زمان تغییر کرد؛ فهرست به‌روزرسانی شد.", ToastLevel.Info);
                await LoadAsync();
                return;
            }

            AppState.AddToast("درخواست با موفقیت بسته شد.", ToastLevel.Success);
            _reasons.Remove(requestId);
            _openReasonFor = null;
            await LoadAsync();
        }
        finally
        {
            _busyId = null;
        }
    }
}
