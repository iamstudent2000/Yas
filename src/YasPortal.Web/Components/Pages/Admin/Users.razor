@page "/admin/users"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using YasPortal.Domain.Auditing
@using YasPortal.Domain.Organization
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Services
@using YasPortal.Web.Components.Shared
@attribute [Authorize(Policy = Perm.AdminUsersView)]
@inject IPermissionChecker PermissionChecker
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IPasswordHasher<Employee> PasswordHasher
@inject AdminQueryService AdminQueries
@inject AppState AppState
@inject ReportExportService Reports
@inject PasswordPolicyService PolicyService
@inject AuditEventWriter Audit

<PageTitle>کاربران - یاس پورتال</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <div>
            <div class="page-kicker">مدیریت سامانه / کاربران</div>
            <h1 class="page-title">کاربران و کارکنان</h1>
            <p class="page-subtitle">حساب و اطلاعات کارکنان را مدیریت کنید. تخصیص سمت فقط در «مدیریت سمت‌ها» انجام
                می‌شود.</p>
            </div>
            <div class="form-actions"><a class="btn btn-primary" href="/admin/access"><i class="ti @Icons.AccessManagement"></i>
                مدیریت دسترسی</a><a class="btn btn-primary" href="/admin/positions"><i class="ti @Icons.Position"></i>
                مدیریت سمت‌ها</a><a class="btn btn-secondary" href="/dashboard"><i class="ti @Icons.Back"></i>
                داشبورد</a></div>
            </div>

            <div class="stat-grid">
                <div class="stat-card">
                    <div class="stat-icon"><i class="ti @Icons.Users"></i></div><span class="stat-label">کل کاربران</span><strong
                    class="stat-value">@_totalCount</strong>
                </div>
                <div class="stat-card">
                    <div class="stat-icon"><i class="ti @Icons.Success"></i></div><span class="stat-label">کاربران
                    فعال</span><strong class="stat-value">@_activeCount</strong>
                </div>
                <div class="stat-card">
                    <div class="stat-icon"><i class="ti @Icons.Admin"></i></div><span class="stat-label">مدیر
                    سامانه</span><strong class="stat-value">@_adminCount</strong>
                </div>
            </div>

            <div class="admin-stack">
@if (_canManage) {
<section class="card admin-form-row">
    <div class="admin-form-row-head">
        <h2 class="section-title"><i class="ti @(_editingId is null ? Icons.UserAdd : Icons.Edit)"></i> @(_editingId is null ? "کاربر جدید" : "ویرایش کاربر")</h2>
        <p class="muted">مدیر سامانه سمت سازمانی لازم ندارد؛ دسترسی مدیر در «مدیریت دسترسی» حساب‌محور است.</p>
    </div>
    <div class="admin-row-grid">
        <div class="form-field"><label class="form-label">کد کارمند</label><input class="form-control" @bind="_code" maxlength="50" placeholder="مثلاً EMP-006" /></div>
        <div class="form-field"><label class="form-label">نام کاربری</label><input class="form-control" @bind="_username" maxlength="256" disabled="@(_editingId is not null)" /></div>
        <div class="form-field"><label class="form-label">نام و نام خانوادگی</label><input class="form-control" @bind="_fullName" maxlength="256" /></div>
        <div class="form-field"><label class="form-label">سازمان</label>
            <ServerSearchableGuidSelect Value="@_organizationId" ValueChanged="OrganizationChanged"
                                        SearchAsync="SearchOrganizationsAsync" SelectedText="@_organizationName"
                                        Placeholder="سازمان را جستجو کنید..." SearchPlaceholder="نام سازمان را تایپ کنید..." /></div>
        @if (_editingId is null || _canSetPassword) {<div class="form-field"><label class="form-label">رمز عبور @(_editingId is null ? "" : "جدید - اختیاری")</label><input class="form-control" type="password" @bind="_password" autocomplete="new-password" />
            <small class="help-text">@string.Join(" · ", _policy.Describe())</small></div>}
        <div class="form-field admin-row-check"><label class="check-row"><input type="checkbox" @bind="_isAdmin" /> <span>مدیر سامانه باشد</span></label></div>
        <div class="form-field admin-row-submit">
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SaveEmployee"><i class="ti @Icons.Save"></i> @(_editingId is null ? "ایجاد کاربر" : "ذخیره")</button>
                @if (_editingId is not null)
                {
                    <button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button>
                }
            </div>
        </div>
    </div>
    </section>
}


                <ListFilterBar Busy="_loading" ActiveCount="_applied.Count" CanClear="@(_applied.Count > 0 || _draft.Count > 0)" OnSearch="SearchFiltersAsync" OnClear="ClearFiltersAsync" ExportPermission="@(ReportPermissions.Users)" OnExport="ExportAsync" Exporting="_exporting">
                    <div class="admin-filter"><label class="form-label">جستجو</label>
                        <input class="form-control" placeholder="نام یا نام کاربری..." @bind="_draft.Search" @bind:event="oninput" /></div>
                    <div class="admin-filter"><label class="form-label">وضعیت</label>
                        <LookupSelect Options="_statusOptions" Value="@(_draft.Status == "" ? null : _draft.Status)" ValueChanged="k => _draft.Status = k ?? string.Empty" Placeholder="همه" /></div>
                    <div class="admin-filter"><label class="form-label">سازمان</label>
                        <ServerSearchableGuidSelect @key="_resetKey" Value="_draft.OrganizationId" ValueChanged="id => { _draft.OrganizationId = id; return Task.CompletedTask; }"
                                                    SearchAsync="SearchOrganizationsAsync"
                                                    Placeholder="همه سازمان‌ها" SearchPlaceholder="نام سازمان را تایپ کنید..." /></div>
                    <div class="admin-filter"><label class="form-label">سمت فعلی</label>
                        <ServerSearchableGuidSelect @key="_resetKey" Value="_draft.PositionId" ValueChanged="id => { _draft.PositionId = id; return Task.CompletedTask; }"
                                                    SearchAsync="SearchFilterPositionsAsync"
                                                    Placeholder="همه سمت‌ها" SearchPlaceholder="نام یا کد سمت را تایپ کنید..." /></div>
                </ListFilterBar>

                <section class="card">
                    <div class="card-toolbar">
                        <div>
                            <h2 class="section-title">فهرست کاربران</h2>
                            <p class="muted">جستجو و صفحه‌بندی در SQL Server انجام می‌شود.</p>
                        </div>
                        
                        </div>
                        <div class="data-table-wrap">
                            @if (_loading)
                            {
                                <LoadingState />
                            }
                            else
                            {
                                <table class="data-table data-table-bordered-rows">
                                    <thead>
                                        <tr>
                                            <SortableHeader Text="کد" Column="code" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortByAsync" />
                                            <SortableHeader Text="کاربر" Column="name" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortByAsync" />
                                            <SortableHeader Text="نوع" Column="type" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortByAsync" />
                                            <SortableHeader Text="سازمان" Column="organization" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortByAsync" />
                                            <th>سمت‌ها</th>
                                            <SortableHeader Text="وضعیت" Column="status" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortByAsync" />
                                            <th>عملیات</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var x in _employees)
                                        {
                                            <tr @key="x.Id">
                                                <td><span class="badge badge-muted">@x.Code</span></td>
                                                <td><strong>@x.FullName</strong><small class="muted-line">@x.Username</small></td>
                                                <td><span class="badge @(x.IsAdmin ? "badge-success" : "badge-muted")">@(x.IsAdmin ? "مدیر سامانه" : "کارمند")</span></td>
                                                <td>@x.OrganizationName</td>
                                                <td>
                                                    @if (x.IsAdmin)
                                                    {
                                                        <span class="badge badge-muted">نیاز ندارد</span>
                                                    }
                                                    else if (x.ActivePositions is { Count: > 0 })
                                                    {
                                                        <div class="position-badge-list">
                                                            @foreach (var position in x.ActivePositions)
                                                            {
                                                                <a class="badge badge-muted position-badge"
                                                                   href="@($"/admin/positions?employee={x.Id}&position={position.Id}")"
                                                                   title="مدیریت این سمت"><i
                                                                    class="ti @Icons.PositionTree"></i><span>@position.Name</span></a>
                                                                }
                                                            </div>
                                                            <small class="position-count">@x.ActivePositions.Count سمت فعال</small>
                                                        }
                                    else
                                                        {

                                                            <span class="badge badge-muted">بدون سمت فعال</span>
                                                        }
                                                    </td>
                                                    <td><span class="badge @(x.IsActive ? "badge-success" : "badge-muted")">@(x.IsActive ?
                                                                                            "فعال" : "غیرفعال")</span>
                                                    </td>
                                                    <td class="action-cell">@if (_canManage) {<button class="btn btn-secondary btn-sm"
                                                                                    @onclick="() => BeginEdit(x)" title="ویرایش"><i
                                                        class="ti @Icons.Edit"></i></button>}@if (_canManage) {<button
                                                        class="btn @(x.IsActive ? "btn-danger" : "btn-primary") btn-sm"
                                                        @onclick="() => ToggleEmployee(x.Id)"
                                                        title="@(x.IsActive ? "غیرفعال کردن" : "فعال کردن")"><i
                                                        class="ti @(x.IsActive ? Icons.UserDeactivate : Icons.UserActivate)"></i></button>}@if(!x.IsAdmin){
                                                        <a class="btn btn-secondary btn-sm" href="/admin/positions?employee=@x.Id"><i
                                                            class="ti @Icons.PositionTree"></i> سمت‌ها</a>
                                                        }
                                                        <a class="btn btn-secondary btn-sm" href="/admin/access?employee=@x.Id"><i
                                                            class="ti @Icons.AccessManagement"></i> دسترسی</a>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        @if (_employees.Count == 0)
                                        {
                                            <div class="empty-state">کاربری مطابق جستجو پیدا نشد.</div>
                                        }
                                    }
                                </div>
                                <ServerPagination Page="@_page" PageSize="@_pageSize" TotalCount="@_totalCount" Busy="@_loading"
                                                  PageChanged="PageChanged" PageSizeChanged="PageSizeChanged" />
                            </section>
                        </div>

                        <section class="card admin-notice-card" dir="rtl">
                            <div class="stat-icon"><i class="ti @Icons.Position"></i></div>
                            <div>
                                <h2 class="section-title">تخصیص سمت متمرکز شد</h2>
                                <p class="page-subtitle">دیگر از صفحه کاربران سمت تخصیص یا آزاد نمی‌شود. برای مشاهده درخت، مالک فعلی و
                                    آزادسازی/تخصیص سمت به <strong>مدیریت سمت‌ها</strong> بروید.</p>
                                </div><a class="btn btn-primary" href="/admin/positions">باز کردن مدیریت سمت‌ها <i
                                class="ti @Icons.ArrowGo"></i></a>
                            </section>
                        </div>

@code {
    private bool _canManage, _canSetPassword;
    private List<AdminQueryService.EmployeePageRow> _employees = [];
    private Guid? _editingId, _organizationId;
    private string _code = "", _username = "", _fullName = "", _password = "", _organizationName = "";
    private bool _isAdmin, _loading;
    private int _page = 1, _pageSize = 20, _totalCount, _activeCount, _adminCount;
    private string? _sortBy; private bool _sortDesc;
    // The boxes edit the draft; "جستجو" copies it to the applied filters, which is what every load (paging, sorting) uses.
    private sealed class UserFilter
    {
        public string Search = "", Status = "";
        public Guid? OrganizationId, PositionId;
        public int Count => (Search.Trim().Length > 0 ? 1 : 0) + (Status != "" ? 1 : 0) + (OrganizationId is null ? 0 : 1) + (PositionId is null ? 0 : 1);
        public UserFilter Clone() => (UserFilter)MemberwiseClone();
    }
    private UserFilter _draft = new(), _applied = new();
    private int _resetKey;

    private static readonly IReadOnlyList<(string Key, string Text)> _statusOptions = [("active", "فعال"), ("inactive", "غیرفعال")];
    private async Task SearchFiltersAsync() { _applied = _draft.Clone(); _page = 1; await LoadAsync(); }
    private async Task ClearFiltersAsync()
    {
        _draft = new(); _applied = new(); _resetKey++;
        _page = 1; await LoadAsync();
    }
    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchFilterPositionsAsync(string search, CancellationToken ct) =>
        AdminQueries.SearchPositionsAsync(search, null, null, ct);

    protected override async Task OnInitializedAsync() { _canManage = await PermissionChecker.HasPermissionAsync(Perm.AdminUsersManage); _canSetPassword = await PermissionChecker.HasPermissionAsync(Perm.AdminUsersPasswordSet);  _policy = await PolicyService.GetAsync(); await LoadAsync(); }
    private async Task LoadAsync()
    {
        _loading = true; try
        {
            var result = await
AdminQueries.GetEmployeesAsync(_page, _pageSize, _applied.Search, _sortBy, _sortDesc, default, _applied.Status == "" ? null : _applied.Status == "active", _applied.OrganizationId, _applied.PositionId); _employees = result.Items.ToList(); _totalCount =
result.TotalCount; await
using var db = await DbFactory.CreateDbContextAsync(); _activeCount = await
db.Employees.CountAsync(x => x.IsActive); _adminCount = await
db.Employees.CountAsync(x => x.IsAdmin);
        }
        finally { _loading = false; }
    }
    private bool _exporting;
    /// <summary>Exports every user the last search matched, in the table's current order.</summary>
    private async Task ExportAsync()
    {
        if (_exporting) return;
        _exporting = true;
        try
        {
            await Reports.ExportPagedAsync(ReportPermissions.Users, "users",
                ["کد", "نام کاربری", "نام و نام خانوادگی", "سازمان", "وضعیت", "نوع", "سمت‌های فعال"],
                (page, size) => AdminQueries.GetEmployeesAsync(page, size, _applied.Search, _sortBy, _sortDesc, default, _applied.Status == "" ? null : _applied.Status == "active", _applied.OrganizationId, _applied.PositionId),
                x => [x.Code, x.Username, x.FullName, x.OrganizationName ?? "", x.IsActive ? "فعال" : "غیرفعال", x.IsAdmin ? "مدیر سامانه" : "کاربر", string.Join(" / ", (x.ActivePositions ?? []).Select(pos => pos.Name))]);
        }
        finally { _exporting = false; }
    }
    private async Task PageChanged(int page) { _page = page; await LoadAsync(); }
    private async Task PageSizeChanged(int size) { _pageSize = size; _page = 1; await LoadAsync(); }
    private async Task SortByAsync(string column)
    {
        if (_sortBy == column) _sortDesc = !_sortDesc; else { _sortBy = column; _sortDesc = false; }
        _page = 1;
        await LoadAsync();
    }
    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchOrganizationsAsync(string search, CancellationToken
ct) => AdminQueries.SearchOrganizationsAsync(search, true, ct);
    private Task OrganizationChanged(Guid? id) { _organizationId = id; return Task.CompletedTask; }
    private void BeginEdit(AdminQueryService.EmployeePageRow
x)
    { if (!_canManage) return;
        _editingId = x.Id; _code = x.Code; _username = x.Username; _fullName = x.FullName; _organizationId = null; _organizationName =
x.OrganizationName ?? ""; _isAdmin = x.IsAdmin; _password = ""; _
= LoadOrganizationIdAsync(x.Id);
    }
    private async Task LoadOrganizationIdAsync(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync(); var
x = await
db.Employees.AsNoTracking().Where(e => e.Id == id).Select(e => new
{
    e.OrganizationId,
    e.Organization.Name
}).SingleAsync(); _organizationId = x.OrganizationId; _organizationName = x.Name; await
InvokeAsync(StateHasChanged);
    }
    private void
CancelEdit()
    {
        _editingId = null; _code = _username = _fullName = _password = _organizationName = ""; _organizationId = null; _isAdmin =
false;
    }
    private YasPortal.Domain.Security.PasswordPolicy _policy = YasPortal.Domain.Security.PasswordPolicy.CreateDefault();
    private async Task
SaveEmployee()
    { if (!_canManage) return;
        if (string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_fullName) || _organizationId is
null) { AppState.AddToast("کد، نام کاربری، نام و سازمان الزامی است.", ToastLevel.Error); return; }
        var code = _code.Trim();
        await using var db = await
DbFactory.CreateDbContextAsync();
        if (await db.Employees.AnyAsync(x => x.Code == code && x.Id != (_editingId ?? Guid.Empty))) { AppState.AddToast("کارمندی با این کد قبلاً ثبت شده است.", ToastLevel.Error); return; }
        if (_editingId is not null && !_canSetPassword && !string.IsNullOrWhiteSpace(_password))
        {
            AppState.AddToast("شما مجوز تغییر رمز عبور کاربران را ندارید.", ToastLevel.Error);
            return;
        }
        if (!string.IsNullOrWhiteSpace(_password))
        {
            _policy = await PolicyService.GetAsync();
            var passwordErrors = _policy.Validate(_password, _username);
            if (passwordErrors.Count > 0) { AppState.AddToast(string.Join(" ", passwordErrors), ToastLevel.Error); return; }
        }
        var resettingPassword = _editingId is not null && !string.IsNullOrWhiteSpace(_password);
        Employee employee; var wasAdmin = false; if (_editingId is Guid id)
        {
            employee = await
db.Employees.SingleAsync(x => x.Id == id); wasAdmin = employee.IsAdmin; employee.ChangeCode(code); employee.SetFullName(_fullName);
            employee.ChangeOrganization(_organizationId.Value); employee.SetAdmin(_isAdmin); if
            (!string.IsNullOrWhiteSpace(_password)) employee.SetPasswordHash(PasswordHasher.HashPassword(employee, _password)); if
            (!wasAdmin && _isAdmin)
            {
                foreach (var
a in await
db.EmployeePositions.Where(x => x.EmployeeId == id && x.EndedAt == null).ToListAsync()) a.End();
                employee.SetLastActivePosition(null);
            }
        }
        else
        {
            var
username = _username.Trim(); if (await db.Employees.AnyAsync(x => x.Username == username)) { AppState.AddToast("این نام کاربری قبلاً استفاده شده است.", ToastLevel.Error); return; }
            if (string.IsNullOrWhiteSpace(_password))
            {
                AppState.AddToast("برای کاربر جدید رمز عبور الزامی است.", ToastLevel.Error);
                return;
            }
            employee = new
Employee(code, username, _fullName, _organizationId.Value, _isAdmin);
            employee.SetPasswordHash(PasswordHasher.HashPassword(employee, _password)); db.Employees.Add(employee);
        }
        await
db.SaveChangesAsync(); if (resettingPassword) await Audit.WriteAsync(AuditActions.PasswordReset, nameof(Employee), employee.Id.ToString(), new { employee.Username }); AppState.AddToast(_editingId is null ? "کاربر جدید ایجاد شد." : "کاربر ویرایش شد.",
ToastLevel.Success); CancelEdit(); await LoadAsync();
    }
    private async Task ToggleEmployee(Guid id)
    { if (!_canManage) return;
        await using var db = await DbFactory.CreateDbContextAsync(); var employee = await
db.Employees.SingleAsync(x => x.Id == id); if (employee.IsActive)
        {
            var activeAssignments = await
db.EmployeePositions.Where(x => x.EmployeeId == id && x.EndedAt == null).ToListAsync(); foreach (var assignment in
activeAssignments) assignment.End(); employee.Deactivate(); employee.SetLastActivePosition(null);
        }
        else { employee.Activate(); }
        await
db.SaveChangesAsync(); AppState.AddToast(employee.IsActive ? "کاربر فعال شد." : "کاربر غیرفعال شد.",
ToastLevel.Success); await
LoadAsync();
    }
}
