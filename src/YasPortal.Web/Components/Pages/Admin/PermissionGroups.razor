@page "/admin/permission-groups"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using YasPortal.Domain.Authorization
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Services
@using YasPortal.Web.Components.Shared
@attribute [Authorize(Policy = Perm.AdminPermissionsView)]
@inject IPermissionChecker PermissionChecker
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AdminQueryService AdminQueries
@inject AppState AppState

<PageTitle>گروه‌های مجوز - یاس پورتال</PageTitle>
<div class="admin-page" dir="rtl">
    <div class="page-header">
        <div>
            <div class="page-kicker">مدیریت سامانه / کنترل دسترسی</div>
            <h1 class="page-title">گروه‌های مجوز</h1>
            <p class="page-subtitle">گروه را یک‌بار تعریف کنید و بعد آن را به مدیر یا ترکیب دقیق «کارمند + سمت» اختصاص
                دهید.</p>
            </div>
            <div class="admin-page-actions"><a class="btn btn-secondary" href="/admin/permissions"><i class="ti @Icons.Permission"></i>
                مجوزها</a><a class="btn btn-primary" href="/admin/access"><i class="ti @Icons.AccessManagement"></i> مدیریت
                دسترسی</a></div>
            </div>
            <div class="admin-stack">
@if (_canManage) {
<section class="card admin-form-row">
    <div class="admin-form-row-head">
        <h2 class="section-title"><i class="ti @(_editingId is null ? Icons.Add : Icons.Edit)"></i> @(_editingId is null ? "گروه جدید" : "ویرایش گروه")</h2>
        <p class="muted">نام گروه برای مدیران واضح باشد.</p>
    </div>
    <div class="admin-row-grid">
        <div class="form-field"><label class="form-label">کد گروه</label><input class="form-control" @bind="_code" maxlength="50" placeholder="مثلاً GRP-006" /></div>
        <div class="form-field"><label class="form-label">نام گروه</label><input class="form-control" @bind="_name" maxlength="200" placeholder="مثلاً اپراتور درخواست" /></div>
        <div class="form-field is-grow"><label class="form-label">توضیح</label><input class="form-control" @bind="_description" maxlength="500" /></div>
        <div class="form-field admin-row-submit">
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SaveGroup"><i class="ti @Icons.Save"></i> @(_editingId is null ? "ایجاد گروه" : "ذخیره")</button>
                @if (_editingId is not null)
                {
                    <button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button>
                }
            </div>
        </div>
    </div>
    </section>
}

                <ListFilterBar Busy="_groupLoading" ActiveCount="@(_groupSearch.Trim().Length > 0 ? 1 : 0)"
                               CanClear="@(_groupSearch != "" || _draftGroupSearch != "")" OnSearch="SearchGroupsFilterAsync" OnClear="ClearGroupFilterAsync">
                    <div class="admin-filter"><label class="form-label">جستجو</label>
                        <input class="form-control" placeholder="نام گروه..." @bind="_draftGroupSearch" @bind:event="oninput" /></div>
                </ListFilterBar>

                <section class="card">
                    <div class="card-toolbar">
                        <div>
                            <h2 class="section-title">گروه‌ها</h2>
                            <p class="muted">@_groupTotal گروه</p>
                        </div>
                        </div>@if(_groupLoading){
                        <LoadingState />
                    }else if (_groups.Count == 0)
                    {

                        <div class="empty-state">گروهی پیدا نشد.</div>
                    }
                    else
                    {

                        <div class="admin-list-table-head">
                            <span>گروه</span><span>آمار</span><span>عملیات</span>
                        </div>
                        <div class="admin-list-rows">@foreach(var group in _groups){var selected=_selectedGroupId==group.Id;
                            <div class="admin-list-row @(selected ? "admin-list-row-selected" : "")"
                                 @onclick="() => SelectGroup(group.Id)">
                                <div class="admin-list-primary"><span class="admin-list-avatar"><i
                                    class="ti @Icons.PermissionGroup"></i></span><span
                                    class="admin-list-text"><strong title="@group.Name">@group.Name</strong><span class="badge badge-muted">@group.Code</span>@if(!string.IsNullOrWhiteSpace(group.Description)){
                                    <span>@group.Description</span>
                                }
                            </span>
                        </div>
                        <div class="admin-list-meta"><span class="admin-pill"><i class="ti @Icons.Permission"></i>
                            @group.PermissionCount مجوز</span><span class="admin-pill"><i class="ti @Icons.Assignments"></i>
                            @group.AssignmentCount تخصیص</span></div>
                            <div class="admin-list-actions">@if (_canManage) {<button type="button" class="btn btn-secondary btn-sm"
                                                                    @onclick:stopPropagation="true" @onclick="() => EditGroup(group)"><i
                                class="ti @Icons.Edit"></i> ویرایش</button>}@if(group.AssignmentCount==0){
                                @if (_canManage) {<button type="button" class="btn btn-danger btn-sm" @onclick:stopPropagation="true"
                                        @onclick="() => DeleteGroup(group.Id)"><i class="ti @Icons.Delete"></i> حذف</button>}
                            }
                        </div>
                    </div>
                }
            </div>
            <ServerPagination Page="@_groupPage" PageSize="@_groupPageSize" TotalCount="@_groupTotal"
                              Busy="@_groupLoading" PageChanged="GroupPageChanged" PageSizeChanged="GroupPageSizeChanged" />
        }
    </section>
</div>
@if (_selectedGroupId is Guid gid)
{
    <section class="card access-panel group-permission-editor">
        <div class="panel-heading">
            <div>
                <div class="panel-step">گروه انتخاب‌شده</div>
                <h2><i class="ti @Icons.Permission"></i> @SelectedGroupName</h2>
                <p>@_selectedPermissionIds.Count مجوز انتخاب شده از @_permissionTotal مجوز.</p>
            </div>
            <div class="panel-heading-tools">
                <div class="admin-filter-chips"><span class="badge badge-muted"><i class="ti @Icons.List"></i>
                    @_permissionTotal مجوز</span><span class="badge badge-success"><i class="ti @Icons.Confirm"></i>
                    @_selectedPermissionIds.Count انتخاب شده</span></div>
                <div class="search-box"><i class="ti @Icons.Search"></i><input class="form-control"
                                                                                   placeholder="نام مجوز..." @bind="_permissionSearch" @bind:event="oninput"
                                                                                   @onkeyup="PermissionSearchChanged" />@if(!string.IsNullOrEmpty(_permissionSearch)){<button
                    type="button" class="search-clear" @onclick="ClearPermissionSearch"><i class="ti @Icons.Close"></i></button>}</div>
                <label class="only-selected"><input type="checkbox"
                                                                                                   checked="@_onlySelected" @onchange="OnlySelectedChanged" /> فقط انتخاب‌شده‌ها</label>
                <div class="selection-actions"><button class="btn btn-secondary btn-sm" disabled="@_saving"
                                 @onclick="() => SetVisiblePermissions(gid, true)"><i class="ti @Icons.ConfirmAll"></i> انتخاب نتایج</button><button
                    class="btn btn-secondary btn-sm" disabled="@_saving"
                    @onclick="() => SetVisiblePermissions(gid, false)"><i class="ti @Icons.Close"></i> حذف نتایج</button></div>
            </div>
        </div>@if(_permissionLoading){
            <LoadingState Text="در حال بارگذاری مجوزها..." />
        }else
            if (_permissions.Count == 0)
            {

                <div class="empty-state">مجوزی پیدا نشد.</div>
            }
            else
            {

                <div class="permission-sections">@foreach(var area in
                    _permissions.GroupBy(x => PermissionCategory(x.Code)).OrderBy(x => x.Key)){
                        var collapsed = _collapsedAreas.Contains(area.Key);
                        <section class="permission-section @(collapsed ? "collapsed" : "")">
                            <div class="permission-section-heading" @onclick="() => ToggleArea(area.Key)">
                                <div><i class="ti @Icons.Folder"></i><strong>@area.Key</strong></div><span class="badge badge-muted">@area.Count() مجوز</span><i class="ti @Icons.ChevronDown chevron"></i>
                            </div>
                            <div class="permission-grid">@foreach(var permission in area){var
                                granted = _selectedPermissionIds.Contains(permission.Id);
                                <label class="permission-choice @(granted ? "selected" : "")"><input type="checkbox"
                                                                                                         checked="@granted" disabled="@_saving"
                                                                                                         @onchange="e => ToggleGroupPermission(gid, permission.Id, e.Value is bool v && v)" /><span
                                    class="choice-box"><i class="ti @Icons.Confirm"></i></span><span
                                    class="choice-text"><strong>@permission.Name</strong><PermissionReachBadge Code="@(permission.Code)" /></span></label>
                                }
                            </div>
                        </section>
                    }
                </div>
            }
        </section>
    }
else
    {

        <section class="card editor-placeholder"><i class="ti @Icons.PermissionGroup"></i><strong>یک گروه را انتخاب
            کنید</strong><span>سپس مجوزهای آن را جستجو و مدیریت کنید.</span></section>
        }
    </div>
@code {
    private bool _canManage;
    private List<AdminQueryService.PermissionGroupPageRow> _groups = []; private List<AdminQueryService.PermissionPageRow>
    _permissions = []; private Guid? _editingId, _selectedGroupId; private string
    _name = "", _description = "", _groupSearch = "", _permissionSearch = "", _code = ""; private int
    _groupPage = 1, _groupPageSize = 20, _groupTotal, _permissionTotal; private bool
    _groupLoading, _permissionLoading, _saving, _onlySelected; private HashSet<Guid> _selectedPermissionIds = []; private
string
    SelectedGroupName => _groups.FirstOrDefault(x => x.Id == _selectedGroupId)?.Name ?? "گروه";
    private HashSet<string> _collapsedAreas = [];
    private void ToggleArea(string key) { if (!_collapsedAreas.Add(key)) _collapsedAreas.Remove(key); }
    protected override async Task OnInitializedAsync() { _canManage = await PermissionChecker.HasPermissionAsync(Perm.AdminPermissionsManage); await LoadGroupsAsync(); }
    private async Task LoadGroupsAsync()
    {
        _groupLoading = true; try
        {
            var r = await
    AdminQueries.GetPermissionGroupsAsync(_groupPage, _groupPageSize, _groupSearch); _groups = r.Items.ToList(); _groupTotal
= r.TotalCount; if (_groupTotal > 0 && _groupPage > Math.Max(1, (int)Math.Ceiling(_groupTotal /
(double)_groupPageSize)))
            {
                _groupPage = 1; var
    reset = await
    AdminQueries.GetPermissionGroupsAsync(_groupPage, _groupPageSize, _groupSearch); _groups = reset.Items.ToList();
                _groupTotal = reset.TotalCount;
            }
        }
        finally { _groupLoading = false; }
    }
    private async Task GroupPageChanged(int page) { _groupPage = page; await LoadGroupsAsync(); }
    private async Task GroupPageSizeChanged(int size) { _groupPageSize = size; _groupPage = 1; await LoadGroupsAsync(); }
    private async Task LoadPermissionsAsync()
    {
        if (_selectedGroupId is not Guid gid) return; _permissionLoading = true; try
        {
            var
    all = await
    AdminQueries.GetAllPermissionsAsync(_permissionSearch); _permissions = all.Where(x => !_onlySelected ||
_selectedPermissionIds.Contains(x.Id)).ToList(); _permissionTotal = _permissions.Count;
        }
        finally { _permissionLoading = false; }
    }
    private async Task SelectGroup(Guid
    id)
    {
        if (_saving) return; _selectedGroupId = id; _permissionSearch = ""; _onlySelected = false; await
    LoadSelectedGroupAsync(id); await LoadPermissionsAsync();
    }
    private async Task LoadSelectedGroupAsync(Guid id)
    {
        await using var db = await
    DbFactory.CreateDbContextAsync(); _selectedPermissionIds = await
    db.PermissionGroupPermissions.AsNoTracking().Where(x => x.GroupId == id).Select(x => x.PermissionId).ToHashSetAsync();
    }
    // The box edits the draft; "جستجو" copies it into _groupSearch, which every load (paging) uses.
    private string _draftGroupSearch = "";
    private async Task SearchGroupsFilterAsync() { _groupSearch = _draftGroupSearch.Trim(); _groupPage = 1; await LoadGroupsAsync(); }
    private async Task ClearGroupFilterAsync() { _groupSearch = _draftGroupSearch = ""; _groupPage = 1; await LoadGroupsAsync(); }
    private async Task PermissionSearchChanged(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or
    "Tab" || _permissionSearch.Length == 0) await LoadPermissionsAsync();
    }
    private async Task ClearPermissionSearch() { _permissionSearch = ""; await LoadPermissionsAsync(); }
    private async Task OnlySelectedChanged(ChangeEventArgs e)
    {
        _onlySelected = e.Value is bool b && b; await
    LoadPermissionsAsync();
    }
    private void EditGroup(AdminQueryService.PermissionGroupPageRow
    x)
    { if (!_canManage) return; _editingId = x.Id; _code = x.Code; _name = x.Name; _description = x.Description ?? ""; }
    private void
    CancelEdit()
    { _editingId = null; _code = _name = _description = ""; }
    private async Task SaveGroup()
    { if (!_canManage) return;
        var code = _code.Trim(); if (string.IsNullOrWhiteSpace(code))
        {
            AppState.AddToast("کد گروه الزامی است.", ToastLevel.Error); return;
        }
        var name = _name.Trim(); if (string.IsNullOrWhiteSpace(name))
        {
            AppState.AddToast("نام گروه الزامی است.",
ToastLevel.Error); return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.PermissionGroups.AnyAsync(x => x.Code == code && x.Id != (_editingId ?? Guid.Empty))) { AppState.AddToast("گروهی با این کد قبلاً ثبت شده است.", ToastLevel.Error); return; }
        if (await
    db.PermissionGroups.AnyAsync(x => x.Name == name && x.Id != (_editingId ?? Guid.Empty))) { AppState.AddToast("این نام گروه قبلاً استفاده شده است.", ToastLevel.Error); return; }
        if (_editingId is Guid id)
        {
            var existing = await db.PermissionGroups.SingleAsync(x => x.Id == id);
            existing.ChangeCode(code);
            existing.Rename(name, _description);
        }
        else db.PermissionGroups.Add(new
    PermissionGroup(code, name, _description)); await db.SaveChangesAsync(); AppState.AddToast(_editingId is null ? "گروه ایجاد شد." : "گروه ویرایش شد.", ToastLevel.Success); CancelEdit(); await LoadGroupsAsync();
    }
    private async Task DeleteGroup(Guid id)
    { if (!_canManage) return;
        await using var db = await DbFactory.CreateDbContextAsync(); if (await
    db.UserPositionPermissionGroups.AnyAsync(x => x.GroupId == id) || await
    db.EmployeePermissionGroups.AnyAsync(x => x.GroupId == id)) { AppState.AddToast("این گروه هنوز تخصیص دارد و قابل حذف نیست.", ToastLevel.Error); return; }
        db.PermissionGroups.Remove(await db.PermissionGroups.SingleAsync(x => x.Id == id)); await
    db.SaveChangesAsync(); if (_selectedGroupId == id) { _selectedGroupId = null; _selectedPermissionIds.Clear(); }
        _groupSearch = _draftGroupSearch = ""; if (_groupPage > 1 && _groups.Count == 1) _groupPage--; await
    LoadGroupsAsync();
    }
    private async Task ToggleGroupPermission(Guid groupId, Guid permissionId, bool grant)
    { if (!_canManage) return;
        _saving = true; try
        {
            await using var
    db = await DbFactory.CreateDbContextAsync(); var link = await
    db.PermissionGroupPermissions.SingleOrDefaultAsync(x => x.GroupId == groupId && x.PermissionId == permissionId); if
(grant && link
    is null)
            {
                db.PermissionGroupPermissions.Add(new
    PermissionGroupPermission(groupId, permissionId)); _selectedPermissionIds.Add(permissionId);
                await db.SaveChangesAsync();
                AppState.AddToast("مجوز به گروه اضافه شد.", ToastLevel.Success);
            }
            else if (!grant && link is not
    null)
            {
                db.PermissionGroupPermissions.Remove(link); _selectedPermissionIds.Remove(permissionId);
                await db.SaveChangesAsync();
                AppState.AddToast("مجوز از گروه حذف شد.", ToastLevel.Success);
            }
            else return;
        }
        finally { _saving = false; }
    }
    private async Task SetVisiblePermissions(Guid groupId, bool grant)
    { if (!_canManage) return;
        var
    ids = _permissions.Select(x => x.Id).ToList(); if (ids.Count == 0) return; _saving = true; try
        {
            await using var db = await
    DbFactory.CreateDbContextAsync(); var existing = await
    db.PermissionGroupPermissions.Where(x => x.GroupId == groupId && ids.Contains(x.PermissionId)).ToListAsync(); if (grant)
            {
                var
    existingIds = existing.Select(x => x.PermissionId).ToHashSet(); var toAdd = ids.Except(existingIds).ToList(); foreach (var id in
    toAdd) db.PermissionGroupPermissions.Add(new
    PermissionGroupPermission(groupId, id)); _selectedPermissionIds.UnionWith(ids);
                await db.SaveChangesAsync();
                AppState.AddToast(toAdd.Count > 0 ? $"{toAdd.Count} مجوز به گروه اضافه شد." : "همه مجوزهای نمایش داده‌شده از قبل در گروه بودند.", ToastLevel.Success);
            }
            else
            {
                db.PermissionGroupPermissions.RemoveRange(existing); _selectedPermissionIds.ExceptWith(ids);
                await db.SaveChangesAsync();
                AppState.AddToast(existing.Count > 0 ? $"{existing.Count} مجوز از گروه حذف شد." : "هیچ مجوزی از این فهرست در گروه نبود.", ToastLevel.Success);
            }
        }
        finally { _saving = false; }
    }
    private static string PermissionCategory(string code) => code.Split('.', 2)[0]
    switch
    {
        "Dashboard" => "داشبورد",
        "Profile" => "پروفایل",
        "Requests" => "درخواست‌ها و گردش‌کار",
        "Employees" => "کارکنان",
        "Organizations" => "سازمان‌ها",
        "Positions" => "سمت‌ها",
        "Permissions" => "مجوزها",
        "Reports" => "گزارش‌ها",
        "Forms" => "فرم‌های چاپی",
        "Delegation" or "Delegations" => "تفویض‌ها",
        "Admin" => "مدیریت سامانه",
        _ =>
        code.Split('.', 2)[0]
    };
}
