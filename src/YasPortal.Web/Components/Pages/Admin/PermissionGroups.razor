@page "/admin/permission-groups"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using YasPortal.Domain.Authorization
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Services
@using YasPortal.Web.Components.Shared
@attribute [Authorize(Policy = "Admin.Permissions")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AdminQueryService AdminQueries
@inject AppState AppState

<PageTitle>گروه‌های مجوز - یاس پورتال</PageTitle>
<div class="admin-page" dir="rtl">
    <div class="page-header">
        <div>
            <div class="page-kicker">مدیریت سامانه / کنترل دسترسی</div>
            <h1 class="page-title">گروه‌های مجوز</h1>
            <p class="page-subtitle">گروه را یک‌بار تعریف کنید و بعد آن را به مدیر یا ترکیب دقیق «کارمند + سمت» اختصاص
                دهید.</p>
            </div>
            <div class="admin-page-actions"><a class="btn btn-secondary" href="/admin/permissions"><i class="bx bx-key"></i>
                مجوزها</a><a class="btn btn-primary" href="/admin/access"><i class="bx bx-shield-quarter"></i> مدیریت
                دسترسی</a></div>
            </div>
            <div class="admin-two-col">
                <section class="card">
                    <div class="card-heading">
                        <div class="card-heading-icon"><i
                            class="bx @(_editingId is null ? "bx-layer-plus" : "bx-edit-alt")"></i></div>
                            <div>
                                <h2 class="section-title">@(_editingId is null ? "گروه جدید" : "ویرایش گروه")</h2>
                                <p class="muted">نام گروه برای مدیران واضح باشد.</p>
                            </div>
                        </div><label class="form-label">نام گروه</label><input class="form-control" @bind="_name" maxlength="200"
                                                                               placeholder="مثلاً اپراتور درخواست" /><label class="form-label">توضیح</label><textarea
                        class="form-control" @bind="_description" maxlength="500" rows="4"></textarea>
                        <div class="form-actions"><button class="btn btn-primary" @onclick="SaveGroup"><i class="bx bx-save"></i>
                            @(_editingId is null ? "ایجاد گروه" : "ذخیره")</button>@if(_editingId is not null){
                            <button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button>
                        }
                    </div>
                </section>
                <section class="card">
                    <div class="card-toolbar">
                        <div>
                            <h2 class="section-title">گروه‌ها</h2>
                            <p class="muted">@_groupTotal گروه</p>
                        </div>
                        <div class="search-box"><i class="bx bx-search"></i><input class="form-control"
                                                                                           placeholder="جستجوی گروه..." @bind="_groupSearch" @bind:event="oninput"
                                                                                           @onkeyup="GroupSearchChanged" /></div>
                        </div>@if(_groupLoading){
                        <div class="empty-state">در حال بارگذاری...</div>
                    }else if (_groups.Count == 0)
                    {

                        <div class="empty-state">گروهی پیدا نشد.</div>
                    }
                    else
                    {

                        <div class="admin-list-table-head">
                            <span>گروه</span><span>آمار</span><span>عملیات</span>
                        </div>
                        <div class="admin-list-rows">@foreach(var group in _groups){var selected=_selectedGroupId==group.Id;
                            <div class="admin-list-row @(selected ? "admin-list-row-selected" : "")"
                                 @onclick="() => SelectGroup(group.Id)">
                                <div class="admin-list-primary"><span class="admin-list-avatar"><i
                                    class="bx bx-layer"></i></span><span
                                    class="admin-list-text"><strong>@group.Name</strong>@if(!string.IsNullOrWhiteSpace(group.Description)){
                                    <span>@group.Description</span>
                                }
                            </span>
                        </div>
                        <div class="admin-list-meta"><span class="admin-pill"><i class="bx bx-key"></i>
                            @group.PermissionCount مجوز</span><span class="admin-pill"><i class="bx bx-link"></i>
                            @group.AssignmentCount تخصیص</span></div>
                            <div class="admin-list-actions"><button type="button" class="btn btn-secondary btn-sm"
                                                                    @onclick:stopPropagation="true" @onclick="() => EditGroup(group)"><i
                                class="bx bx-edit-alt"></i> ویرایش</button>@if(group.AssignmentCount==0){
                                <button type="button" class="btn btn-danger btn-sm" @onclick:stopPropagation="true"
                                        @onclick="() => DeleteGroup(group.Id)"><i class="bx bx-trash"></i> حذف</button>
                            }
                        </div>
                    </div>
                }
            </div>
            <ServerPagination Page="@_groupPage" PageSize="@_groupPageSize" TotalCount="@_groupTotal"
                              Busy="@_groupLoading" PageChanged="GroupPageChanged" PageSizeChanged="GroupPageSizeChanged" />
        }
    </section>
</div>
@if (_selectedGroupId is Guid gid)
{
    <section class="card access-panel group-permission-editor">
        <div class="panel-heading">
            <div>
                <div class="panel-step">گروه انتخاب‌شده</div>
                <h2><i class="bx bx-lock-open-alt"></i> @SelectedGroupName</h2>
                <p>@_selectedPermissionIds.Count مجوز انتخاب شده از @_permissionTotal مجوز.</p>
            </div>
            <div class="panel-heading-tools">
                <div class="search-box"><i class="bx bx-search"></i><input class="form-control"
                                                                                   placeholder="نام مجوز..." @bind="_permissionSearch" @bind:event="oninput"
                                                                                   @onkeyup="PermissionSearchChanged" /></div>
                <label class="only-selected"><input type="checkbox"
                                                                                                   checked="@_onlySelected" @onchange="OnlySelectedChanged" /> فقط انتخاب‌شده‌ها</label>
            </div>
        </div>@if(_permissionLoading){
            <div class="empty-state">در حال بارگذاری مجوزها...</div>
        }else
            if (_permissions.Count == 0)
            {

                <div class="empty-state">مجوزی پیدا نشد.</div>
            }
            else
            {

                <div class="permission-sections">@foreach(var area in
                    _permissions.GroupBy(x => PermissionCategory(x.Code)).OrderBy(x => x.Key)){
                        <section class="permission-section">
                            <div class="permission-section-heading">
                                <div><i class="bx bx-folder-open"></i><strong>@area.Key</strong></div><span class="badge badge-muted">@area.Count() مجوز</span>
                            </div>
                            <div class="permission-grid">@foreach(var permission in area){var
                                granted = _selectedPermissionIds.Contains(permission.Id);
                                <label class="permission-choice permission-tile @(granted ? "selected" : "")"><input type="checkbox"
                                                                                                         checked="@granted" disabled="@_saving"
                                                                                                         @onchange="e => ToggleGroupPermission(gid, permission.Id, e.Value is bool v && v)" /><span
                                    class="choice-box"><i class="bx bx-check"></i></span><span
                                    class="choice-text"><strong>@permission.Name</strong></span></label>
                                }
                            </div>
                        </section>
                    }
                </div>
            }
        <div class="bulk-toolbar"><span>@_permissionTotal مجوز در نتیجه</span>
            <div><button class="btn btn-secondary btn-sm" disabled="@_saving"
                             @onclick="() => SetVisiblePermissions(gid, true)">انتخاب نتایج</button><button
                class="btn btn-secondary btn-sm" disabled="@_saving"
                @onclick="() => SetVisiblePermissions(gid, false)">حذف نتایج</button></div>
            </div>
        </section>
    }
else
    {

        <section class="card editor-placeholder"><i class="bx bx-layer-plus"></i><strong>یک گروه را انتخاب
            کنید</strong><span>سپس مجوزهای آن را جستجو و مدیریت کنید.</span></section>
        }
    </div>
@code {
    private List<AdminQueryService.PermissionGroupPageRow> _groups = []; private List<AdminQueryService.PermissionPageRow>
    _permissions = []; private Guid? _editingId, _selectedGroupId; private string
    _name = "", _description = "", _groupSearch = "", _permissionSearch = ""; private int
    _groupPage = 1, _groupPageSize = 20, _groupTotal, _permissionTotal; private bool
    _groupLoading, _permissionLoading, _saving, _onlySelected; private HashSet<Guid> _selectedPermissionIds = []; private
string
    SelectedGroupName => _groups.FirstOrDefault(x => x.Id == _selectedGroupId)?.Name ?? "گروه";
    protected override async Task OnInitializedAsync() => await LoadGroupsAsync();
    private async Task LoadGroupsAsync()
    {
        _groupLoading = true; try
        {
            var r = await
    AdminQueries.GetPermissionGroupsAsync(_groupPage, _groupPageSize, _groupSearch); _groups = r.Items.ToList(); _groupTotal
= r.TotalCount; if (_groupTotal > 0 && _groupPage > Math.Max(1, (int)Math.Ceiling(_groupTotal /
(double)_groupPageSize)))
            {
                _groupPage = 1; var
    reset = await
    AdminQueries.GetPermissionGroupsAsync(_groupPage, _groupPageSize, _groupSearch); _groups = reset.Items.ToList();
                _groupTotal = reset.TotalCount;
            }
        }
        finally { _groupLoading = false; }
    }
    private async Task GroupPageChanged(int page) { _groupPage = page; await LoadGroupsAsync(); }
    private async Task GroupPageSizeChanged(int size) { _groupPageSize = size; _groupPage = 1; await LoadGroupsAsync(); }
    private async Task LoadPermissionsAsync()
    {
        if (_selectedGroupId is not Guid gid) return; _permissionLoading = true; try
        {
            var
    all = await
    AdminQueries.GetAllPermissionsAsync(_permissionSearch); _permissions = all.Where(x => !_onlySelected ||
_selectedPermissionIds.Contains(x.Id)).ToList(); _permissionTotal = _permissions.Count;
        }
        finally { _permissionLoading = false; }
    }
    private async Task SelectGroup(Guid
    id)
    {
        if (_saving) return; _selectedGroupId = id; _permissionSearch = ""; _onlySelected = false; await
    LoadSelectedGroupAsync(id); await LoadPermissionsAsync();
    }
    private async Task LoadSelectedGroupAsync(Guid id)
    {
        await using var db = await
    DbFactory.CreateDbContextAsync(); _selectedPermissionIds = await
    db.PermissionGroupPermissions.AsNoTracking().Where(x => x.GroupId == id).Select(x => x.PermissionId).ToHashSetAsync();
    }
    private async Task GroupSearchChanged(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or
    "Tab" || _groupSearch.Length == 0) { _groupPage = 1; await LoadGroupsAsync(); }
    }
    private async Task PermissionSearchChanged(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or
    "Tab" || _permissionSearch.Length == 0) await LoadPermissionsAsync();
    }
    private async Task OnlySelectedChanged(ChangeEventArgs e)
    {
        _onlySelected = e.Value is bool b && b; await
    LoadPermissionsAsync();
    }
    private void EditGroup(AdminQueryService.PermissionGroupPageRow
    x)
    { _editingId = x.Id; _name = x.Name; _description = x.Description ?? ""; }
    private void
    CancelEdit()
    { _editingId = null; _name = _description = ""; }
    private async Task SaveGroup()
    {
        var name = _name.Trim(); if (string.IsNullOrWhiteSpace(name))
        {
            AppState.AddToast("نام گروه الزامی است.",
ToastLevel.Error); return;
        }
        await using var db = await DbFactory.CreateDbContextAsync(); if (await
    db.PermissionGroups.AnyAsync(x => x.Name == name && x.Id != (_editingId ?? Guid.Empty))) { AppState.AddToast("این نام گروه قبلاً استفاده شده است.", ToastLevel.Error); return; }
        if (_editingId is Guid id) (await
    db.PermissionGroups.SingleAsync(x => x.Id == id)).Rename(name, _description);
        else db.PermissionGroups.Add(new
    PermissionGroup(name, _description)); await db.SaveChangesAsync(); AppState.AddToast(_editingId is null ? "گروه ایجاد شد." : "گروه ویرایش شد.", ToastLevel.Success); CancelEdit(); await LoadGroupsAsync();
    }
    private async Task DeleteGroup(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync(); if (await
    db.UserPositionPermissionGroups.AnyAsync(x => x.GroupId == id) || await
    db.EmployeePermissionGroups.AnyAsync(x => x.GroupId == id)) { AppState.AddToast("این گروه هنوز تخصیص دارد و قابل حذف نیست.", ToastLevel.Error); return; }
        db.PermissionGroups.Remove(await db.PermissionGroups.SingleAsync(x => x.Id == id)); await
    db.SaveChangesAsync(); if (_selectedGroupId == id) { _selectedGroupId = null; _selectedPermissionIds.Clear(); }
        _groupSearch = ""; if (_groupPage > 1 && _groups.Count == 1) _groupPage--; await
    LoadGroupsAsync();
    }
    private async Task ToggleGroupPermission(Guid groupId, Guid permissionId, bool grant)
    {
        _saving = true; try
        {
            await using var
    db = await DbFactory.CreateDbContextAsync(); var link = await
    db.PermissionGroupPermissions.SingleOrDefaultAsync(x => x.GroupId == groupId && x.PermissionId == permissionId); if
(grant && link
    is null)
            {
                db.PermissionGroupPermissions.Add(new
    PermissionGroupPermission(groupId, permissionId)); _selectedPermissionIds.Add(permissionId);
            }
            else if (!grant && link is not
    null) { db.PermissionGroupPermissions.Remove(link); _selectedPermissionIds.Remove(permissionId); }
            else return; await
    db.SaveChangesAsync();
        }
        finally { _saving = false; }
    }
    private async Task SetVisiblePermissions(Guid groupId, bool grant)
    {
        var
    ids = _permissions.Select(x => x.Id).ToList(); if (ids.Count == 0) return; _saving = true; try
        {
            await using var db = await
    DbFactory.CreateDbContextAsync(); var existing = await
    db.PermissionGroupPermissions.Where(x => x.GroupId == groupId && ids.Contains(x.PermissionId)).ToListAsync(); if (grant)
            {
                var
    existingIds = existing.Select(x => x.PermissionId).ToHashSet(); foreach (var id in
    ids.Except(existingIds)) db.PermissionGroupPermissions.Add(new
    PermissionGroupPermission(groupId, id)); _selectedPermissionIds.UnionWith(ids);
            }
            else { db.PermissionGroupPermissions.RemoveRange(existing); _selectedPermissionIds.ExceptWith(ids); }
            await
    db.SaveChangesAsync();
        }
        finally { _saving = false; }
    }
    private static string PermissionCategory(string code) => code.Split('.', 2)[0]
    switch
    {
        "Dashboard" => "داشبورد",
        "Profile" => "پروفایل",
        "Requests" => "درخواست‌ها و گردش‌کار",
        "Employees" => "کارکنان",
        "Organizations" => "سازمان‌ها",
        "Positions" => "سمت‌ها",
        "Permissions" => "مجوزها",
        "Admin" => "مدیریت سامانه",
        _ =>
        code.Split('.', 2)[0]
    };
}
