@page "/admin/password-policy"
@using Microsoft.AspNetCore.Authorization
@using YasPortal.Web.Services
@using YasPortal.Web.Components.Shared
@attribute [Authorize(Policy = Perm.AdminUsersManage)]
@inject PasswordPolicyService PolicyService
@inject AppState AppState

<PageTitle>سیاست رمز عبور - یاس پورتال</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <div>
            <h1 class="page-title"><i class="ti @Icons.PasswordPolicy"></i> سیاست رمز عبور</h1>
            <p class="page-subtitle">قوانینی که هنگام ایجاد کاربر، تعیین رمز توسط مدیر و تغییر رمز توسط خود کاربر اعمال می‌شود. رمزهای فعلی تا زمان تغییر بعدی دوباره بررسی نمی‌شوند.</p>
        </div>
        <div class="form-actions">
            <a class="btn btn-secondary" href="/admin/users"><i class="ti @Icons.Users"></i> کاربران</a>
        </div>
    </div>

    @if (_loading)
    {
        <LoadingState />
    }
    else
    {
        <div class="admin-stack">
            <section class="card admin-form-row">
                <div class="admin-form-row-head">
                    <h2 class="section-title"><i class="ti @Icons.PasswordRules"></i> قوانین</h2>
                    <p class="muted">طول و ترکیب نویسه‌های مجاز را تعیین کنید.</p>
                </div>
                <div class="admin-row-grid">
                    <div class="form-field"><label class="form-label">حداقل طول</label>
                        <input class="form-control" type="number" min="@YasPortal.Domain.Security.PasswordPolicy.LowestMinLength" max="@YasPortal.Domain.Security.PasswordPolicy.HighestMinLength" @bind="_minLength" /></div>
                    <div class="form-field"><label class="form-label">حداکثر طول</label>
                        <input class="form-control" type="number" min="@_minLength" max="@YasPortal.Domain.Security.PasswordPolicy.HardMaxLength" @bind="_maxLength" /></div>
                    <div class="form-field admin-row-check"><label class="check-row"><input type="checkbox" @bind="_upper" /> <span>حرف بزرگ انگلیسی</span></label></div>
                    <div class="form-field admin-row-check"><label class="check-row"><input type="checkbox" @bind="_lower" /> <span>حرف کوچک انگلیسی</span></label></div>
                    <div class="form-field admin-row-check"><label class="check-row"><input type="checkbox" @bind="_digit" /> <span>رقم</span></label></div>
                    <div class="form-field admin-row-check"><label class="check-row"><input type="checkbox" @bind="_symbol" /> <span>نماد</span></label></div>
                </div>
                <div class="admin-row-grid" style="margin-top:12px">
                    <div class="form-field admin-row-check"><label class="check-row"><input type="checkbox" @bind="_noUsername" /> <span>شامل نام کاربری نباشد</span></label></div>
                    <div class="form-field admin-row-check"><label class="check-row"><input type="checkbox" @bind="_noCommon" /> <span>رمزهای رایج و ساده مجاز نباشد</span></label></div>
                    <div class="form-field admin-row-check"><label class="check-row"><input type="checkbox" @bind="_noReuse" /> <span>رمز جدید با رمز فعلی یکسان نباشد</span></label></div>
                    <div class="form-field admin-row-submit">
                        <div class="form-actions">
                            <button class="btn btn-primary" disabled="@_saving" @onclick="SaveAsync"><i class="ti @Icons.Save"></i> ذخیره سیاست</button>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card admin-form-row">
                <div class="admin-form-row-head">
                    <h2 class="section-title"><i class="ti @Icons.Test"></i> آزمایش رمز عبور</h2>
                    <p class="muted">رمزی را بنویسید تا ببینید با قوانین ذخیره‌شده سازگار است. چیزی ذخیره نمی‌شود.</p>
                </div>
                <div class="admin-row-grid">
                    <div class="form-field is-grow"><label class="form-label">رمز عبور نمونه</label>
                        <input class="form-control" dir="ltr" autocomplete="off" @bind="_sample" @bind:event="oninput" /></div>
                    <div class="form-field"><label class="form-label">نام کاربری نمونه (اختیاری)</label>
                        <input class="form-control" dir="ltr" autocomplete="off" @bind="_sampleUser" @bind:event="oninput" /></div>
                </div>
                @if (_sample.Length > 0)
                {
                    var errors = _saved.Validate(_sample, _sampleUser);
                    if (errors.Count == 0)
                    {
                        <p class="muted" style="margin-top:10px;color:var(--success,#067647)"><i class="ti @Icons.Success"></i> این رمز با سیاست ذخیره‌شده سازگار است.</p>
                    }
                    else
                    {
                        <ul class="pw-rules" style="color:var(--danger,#b42318)">
                            @foreach (var e in errors) { <li><i class="ti @Icons.Alert"></i>@e</li> }
                        </ul>
                    }
                }
                <p class="muted" style="margin-top:10px">قوانین فعلی:</p>
                <ul class="pw-rules">
                    @foreach (var line in _saved.Describe()) { <li><i class="ti @Icons.Confirm"></i>@line</li> }
                </ul>
            </section>
        </div>
    }
</div>

@code {
    private bool _loading = true, _saving;
    private int _minLength = 8, _maxLength = 128;
    private bool _upper, _lower, _digit = true, _symbol, _noUsername = true, _noCommon = true, _noReuse = true;
    private string _sample = "", _sampleUser = "";
    private YasPortal.Domain.Security.PasswordPolicy _saved = YasPortal.Domain.Security.PasswordPolicy.CreateDefault();

    protected override async Task OnInitializedAsync()
    {
        _saved = await PolicyService.GetAsync();
        Apply(_saved);
        _loading = false;
    }

    private void Apply(YasPortal.Domain.Security.PasswordPolicy p)
    {
        _minLength = p.MinLength; _maxLength = p.MaxLength;
        _upper = p.RequireUppercase; _lower = p.RequireLowercase; _digit = p.RequireDigit; _symbol = p.RequireSymbol;
        _noUsername = p.DisallowUsername; _noCommon = p.DisallowCommonPasswords; _noReuse = p.DisallowReuseOfCurrent;
    }

    private async Task SaveAsync()
    {
        if (_minLength < YasPortal.Domain.Security.PasswordPolicy.LowestMinLength || _minLength > YasPortal.Domain.Security.PasswordPolicy.HighestMinLength)
        {
            AppState.AddToast($"حداقل طول باید بین {YasPortal.Domain.Security.PasswordPolicy.LowestMinLength} و {YasPortal.Domain.Security.PasswordPolicy.HighestMinLength} باشد.", ToastLevel.Error); return;
        }
        if (_maxLength < _minLength || _maxLength > YasPortal.Domain.Security.PasswordPolicy.HardMaxLength)
        {
            AppState.AddToast($"حداکثر طول باید از حداقل طول کمتر نباشد و از {YasPortal.Domain.Security.PasswordPolicy.HardMaxLength} بیشتر نشود.", ToastLevel.Error); return;
        }
        _saving = true;
        try
        {
            await PolicyService.SaveAsync(_minLength, _maxLength, _upper, _lower, _digit, _symbol, _noUsername, _noCommon, _noReuse);
            _saved = await PolicyService.GetAsync();
            AppState.AddToast("سیاست رمز عبور ذخیره شد.", ToastLevel.Success);
        }
        catch (Exception)
        {
            AppState.AddToast("ذخیره سیاست رمز عبور انجام نشد.", ToastLevel.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
