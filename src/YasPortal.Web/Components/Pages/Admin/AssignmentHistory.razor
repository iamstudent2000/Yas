@page "/admin/assignment-history"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Domain.Organization
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Services
@using YasPortal.Web.Components.Shared
@attribute [Authorize(Policy = Perm.AdminAssignmentHistoryView)]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AdminQueryService AdminQueries
@inject ReportExportService Reports

<PageTitle>سوابق تخصیص سمت‌ها - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <div class="page-header">
        <div>
            <div class="page-kicker">مدیریت سامانه / سمت‌ها / سوابق</div>
            <h1 class="page-title">سوابق تخصیص سمت‌ها</h1>
            <p class="page-subtitle">تاریخچه کامل حضور کارکنان در سمت‌ها؛ شامل تخصیص‌های قبلی، آزادسازی و تخصیص مجدد.
            </p>
        </div>
        <div class="admin-page-actions"><a class="btn btn-secondary" href="/admin/positions"><i
            class="ti @Icons.Position"></i> مدیریت سمت‌ها</a></div>
        </div>
        <ListFilterBar Busy="_loading" ActiveCount="_applied.Count" CanClear="@(_applied.Count > 0 || DraftCount > 0)" ExportPermission="@(ReportPermissions.AssignmentHistory)" OnExport="ExportAsync" Exporting="_exporting" OnSearch="SearchFiltersAsync" OnClear="ResetFilters">
            <div class="admin-filter"><label class="form-label">کارمند</label>
                <ServerSearchableGuidSelect @key="_resetKey" Value="@_employeeId" ValueChanged="EmployeeChanged"
                                            SearchAsync="SearchEmployeesAsync" SelectedText="@_employeeName" Placeholder="همه کارکنان"
                                            SearchPlaceholder="نام یا نام کاربری را جستجو کنید..." />
            </div>
            <div class="admin-filter"><label class="form-label">سمت</label>
                <ServerSearchableGuidSelect @key="_resetKey" Value="@_positionId" ValueChanged="PositionChanged"
                                            SearchAsync="SearchPositionsAsync" SelectedText="@_positionName" Placeholder="همه سمت‌ها"
                                            SearchPlaceholder="نام سمت را جستجو کنید..." />
            </div>
            <div class="admin-filter"><label class="form-label">وضعیت</label><LookupSelect Options="_statusOptions" Value="@(_status == "all" ? null : _status)" ValueChanged="OnStatusPicked" Placeholder="همه سوابق" /></div>
            <div class="admin-filter"><label class="form-label">سازمان کارمند</label>
                <ServerSearchableGuidSelect @key="_resetKey" Value="@_employeeOrgId" ValueChanged="id => { _employeeOrgId = id; return Task.CompletedTask; }"
                                            SearchAsync="SearchOrganizationsAsync" Placeholder="همه سازمان‌ها" SearchPlaceholder="نام سازمان..." />
            </div>
            <div class="admin-filter"><label class="form-label">سازمان سمت</label>
                <ServerSearchableGuidSelect @key="_resetKey" Value="@_positionOrgId" ValueChanged="id => { _positionOrgId = id; return Task.CompletedTask; }"
                                            SearchAsync="SearchOrganizationsAsync" Placeholder="همه سازمان‌ها" SearchPlaceholder="نام سازمان..." />
            </div>
            <div class="admin-filter"><label class="form-label">شروع تخصیص از تاریخ</label><PersianDatePicker @key="_resetKey" Value="_startFrom" ValueChanged="d => _startFrom = d" Placeholder="تاریخ" /></div>
            <div class="admin-filter"><label class="form-label">شروع تخصیص تا تاریخ</label><PersianDatePicker @key="_resetKey" Value="_startTo" ValueChanged="d => _startTo = d" Placeholder="تاریخ" /></div>
            <div class="admin-filter"><label class="form-label">پایان تخصیص از تاریخ</label><PersianDatePicker @key="_resetKey" Value="_endFrom" ValueChanged="d => _endFrom = d" Placeholder="تاریخ" /></div>
            <div class="admin-filter"><label class="form-label">پایان تخصیص تا تاریخ</label><PersianDatePicker @key="_resetKey" Value="_endTo" ValueChanged="d => _endTo = d" Placeholder="تاریخ" /></div>
        </ListFilterBar>

            <section class="card" style="margin-top:14px">
                <div class="card-toolbar">
                    <div>
                        <h2 class="section-title"><i class="ti @Icons.History"></i> تاریخچه</h2>
                        <p class="muted">@_total رکورد</p>
                    </div>
                </div>
                @if (_loading)
                {
                    <div class="empty-state"><i class="ti @Icons.Spinner"></i><span>در حال بارگذاری
                        سوابق...</span></div>
                    }
        else if (_rows.Count == 0)
                    {

                        <div class="empty-state"><i class="ti @Icons.History empty-icon"></i><strong>سابقه‌ای
                            پیدا نشد</strong><span>فیلترها را تغییر دهید یا اولین تخصیص را از صفحه سمت‌ها انجام دهید.</span></div>
                        }
        else
                        {

                            <div class="admin-table-wrap">
                                <table class="admin-table admin-table-bordered-rows">
                                    <thead>
                                        <tr>
                                            <SortableHeader Text="کارمند" Column="employee" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortByAsync" />
                                            <SortableHeader Text="سمت" Column="position" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortByAsync" />
                                            <SortableHeader Text="شروع تخصیص" Column="started" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortByAsync" />
                                            <SortableHeader Text="پایان تخصیص" Column="ended" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortByAsync" />
                                            <SortableHeader Text="وضعیت" Column="status" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortByAsync" />
                                        </tr>
                                    </thead>
                                    <tbody>@foreach(var row in _rows){
                                        <tr>
                                            <td>
                                                <div class="admin-list-primary"><span class="admin-list-avatar"><i
                                                    class="ti @Icons.User"></i></span><span
                                                    class="admin-list-text"><strong>@row.EmployeeName</strong><span>@row.Username</span></span>
                                                </div>
                                            </td>
                                            <td><span class="position-badge"><i class="ti @Icons.Position"></i> @row.PositionName</span></td>
                                            <td>@FormatDate(row.StartedAt)</td>
                                            <td>@FormatDate(row.EndedAt)</td>
                                            <td>@if(row.EndedAt is null){
                                                <span class="badge badge-success"><i class="ti @Icons.Success"></i> فعال</span>
                                            }else
                                            {

                                                <span class="badge badge-muted"><i class="ti @Icons.History"></i> پایان‌یافته</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <ServerPagination Page="@_page" PageSize="@_pageSize" TotalCount="@_total" Busy="@_loading"
                                  PageChanged="PageChanged" PageSizeChanged="PageSizeChanged" />
            </section>
            <section class="admin-two-col" style="grid-template-columns:repeat(3,minmax(0,1fr));margin-top:14px">
                <div class="admin-notice-card card"><i class="ti @Icons.User"></i>
                    <div><strong>سابقه کارکنان</strong><span>با انتخاب کارمند، تمام سمت‌هایی که در طول زمان داشته نمایش داده
                        می‌شود.</span></div>
                    </div>
                    <div class="admin-notice-card card"><i class="ti @Icons.Position"></i>
                        <div><strong>سابقه سمت‌ها</strong><span>با انتخاب سمت، تمام کارکنانی که در آن سمت بوده‌اند نمایش داده
                            می‌شود.</span></div>
                        </div>
                        <div class="admin-notice-card card"><i class="ti @Icons.Active"></i>
                            <div><strong>تخصیص فعال</strong><span>هر سمت همچنان فقط یک کارمند فعال دارد؛ سابقه فقط اطلاعات تاریخی را نگه
                                می‌دارد.</span></div>
                            </div>
                        </section>
                    </div>

@code {
    private List<HistoryRow> _rows = [];
    private Guid? _employeeId, _positionId;
    private string _employeeName = "", _positionName = "", _status = "all";
    private void OnStatusPicked(string? key) => _status = key ?? "all";
    // The boxes edit the draft fields; "جستجو" copies them here, and paging/sorting reload from this copy.
    private sealed record HistoryFilter(Guid? EmployeeId, Guid? PositionId, string Status, Guid? EmployeeOrgId, Guid? PositionOrgId, DateTime? StartFrom, DateTime? StartTo, DateTime? EndFrom, DateTime? EndTo)
    {
        public int Count => (EmployeeId is null ? 0 : 1) + (PositionId is null ? 0 : 1) + (Status != "all" ? 1 : 0) + (EmployeeOrgId is null ? 0 : 1) + (PositionOrgId is null ? 0 : 1)
            + (StartFrom is null ? 0 : 1) + (StartTo is null ? 0 : 1) + (EndFrom is null ? 0 : 1) + (EndTo is null ? 0 : 1);
    }
    private static readonly HistoryFilter NoFilter = new(null, null, "all", null, null, null, null, null, null);
    private HistoryFilter _applied = NoFilter;
    private Guid? _employeeOrgId, _positionOrgId;
    private DateTime? _startFrom, _startTo, _endFrom, _endTo;
    private int _resetKey;
    private int DraftCount => Draft().Count;
    private HistoryFilter Draft() => new(_employeeId, _positionId, _status, _employeeOrgId, _positionOrgId, _startFrom, _startTo, _endFrom, _endTo);
    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchOrganizationsAsync(string search, CancellationToken ct) => AdminQueries.SearchOrganizationsAsync(search, true, ct);
    private static DateTime LocalDayStartUtc(DateTime day) => DateTime.SpecifyKind(day.Date, DateTimeKind.Local).ToUniversalTime();
    private async Task SearchFiltersAsync() { _applied = Draft(); _page = 1; await LoadAsync(); }
    private static readonly IReadOnlyList<(string Key, string Text)> _statusOptions = [("active", "فقط تخصیص‌های فعال"), ("ended", "فقط سوابق پایان‌یافته")];
    private int _page = 1, _pageSize = 20, _total;
    private bool _loading;
    private string _sortBy = "started"; private bool _sortDesc = true;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        _loading = true; try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var query = BuildQuery(db);
            _total = await query.CountAsync(); var
                totalPages = Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize)); if (_page > totalPages) _page = totalPages;
            _rows = await
                            OrderHistory(query).Skip((_page - 1) * _pageSize).Take(_pageSize).Select(x => new
                            HistoryRow(x.Id, x.Employee.FullName, x.Employee.Username, x.Position.Name, x.StartedAt, x.EndedAt)).ToListAsync();
        }
        finally { _loading = false; }
    }
    /// <summary>The rows matching the applied filters; shared by the list and the CSV export.</summary>
    private IQueryable<PositionAssignmentHistory> BuildQuery(ApplicationDbContext db)
    {
        var query = db.PositionAssignmentHistories.AsNoTracking().AsQueryable(); if (_applied.EmployeeId is Guid
employeeId) query = query.Where(x => x.EmployeeId == employeeId); if (_applied.PositionId is Guid
positionId) query = query.Where(x => x.PositionId == positionId); if (_applied.EmployeeOrgId is Guid employeeOrgId) query = query.Where(x => x.Employee.OrganizationId == employeeOrgId);
            if (_applied.PositionOrgId is Guid positionOrgId) query = query.Where(x => x.Position.OrganizationId == positionOrgId);
            if (_applied.StartFrom is DateTime startFrom) { var from = LocalDayStartUtc(startFrom); query = query.Where(x => x.StartedAt >= from); }
            if (_applied.StartTo is DateTime startTo) { var to = LocalDayStartUtc(startTo.AddDays(1)); query = query.Where(x => x.StartedAt < to); }
            if (_applied.EndFrom is DateTime endFrom) { var from = LocalDayStartUtc(endFrom); query = query.Where(x => x.EndedAt >= from); }
            if (_applied.EndTo is DateTime endTo) { var to = LocalDayStartUtc(endTo.AddDays(1)); query = query.Where(x => x.EndedAt < to); }
            if (_applied.Status == "active") query = query.Where(x =>
x.EndedAt == null);
            else
                if (_applied.Status == "ended") query = query.Where(x => x.EndedAt != null);
        return query;
    }
    private bool _exporting;
    private async Task ExportAsync()
    {
        if (_exporting) return;
        _exporting = true;
        try
        {
            await Reports.ExportTableAsync(ReportPermissions.AssignmentHistory, "assignment-history",
                ["کارمند", "نام کاربری", "سمت", "شروع تخصیص", "پایان تخصیص", "وضعیت"],
                db => OrderHistory(BuildQuery(db)).ThenBy(x => x.Id)
                    .Select(x => new HistoryRow(x.Id, x.Employee.FullName, x.Employee.Username, x.Position.Name, x.StartedAt, x.EndedAt)),
                (_, chunk, _) => Task.FromResult<IReadOnlyList<IReadOnlyList<string>>>(chunk.Select(x => (IReadOnlyList<string>)
                    [x.EmployeeName, x.Username, x.PositionName, ReportExportService.Time(x.StartedAt), ReportExportService.Time(x.EndedAt), x.EndedAt is null ? "فعال" : "پایان‌یافته"]).ToList()));
        }
        finally { _exporting = false; }
    }
    private IOrderedQueryable<PositionAssignmentHistory> OrderHistory(IQueryable<PositionAssignmentHistory> query) => (_sortBy, _sortDesc) switch
    {
        ("employee", false) => query.OrderBy(x => x.Employee.FullName),
        ("employee", true) => query.OrderByDescending(x => x.Employee.FullName),
        ("position", false) => query.OrderBy(x => x.Position.Name),
        ("position", true) => query.OrderByDescending(x => x.Position.Name),
        ("started", false) => query.OrderBy(x => x.StartedAt ?? DateTime.MinValue),
        ("started", true) => query.OrderByDescending(x => x.StartedAt ?? DateTime.MinValue),
        ("ended", false) => query.OrderBy(x => x.EndedAt ?? DateTime.MaxValue),
        ("ended", true) => query.OrderByDescending(x => x.EndedAt ?? DateTime.MaxValue),
        ("status", false) => query.OrderBy(x => x.EndedAt == null),
        ("status", true) => query.OrderByDescending(x => x.EndedAt == null),
        _ => query.OrderByDescending(x => x.StartedAt ?? DateTime.MinValue).ThenByDescending(x => x.EndedAt ?? DateTime.MaxValue),
    };
    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchEmployeesAsync(string search, CancellationToken
ct) => AdminQueries.SearchEmployeesAsync(search, ct);
    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchPositionsAsync(string search, CancellationToken
ct) => AdminQueries.SearchPositionsAsync(search, null, null, ct);
    private Task EmployeeChanged(Guid? id) { _employeeId = id; _page = 1; return Task.CompletedTask; }
    private Task PositionChanged(Guid? id) { _positionId = id; _page = 1; return Task.CompletedTask; }
    private async Task
ResetFilters()
    {
        _employeeId = null; _positionId = null; _employeeName = ""; _positionName = ""; _status = "all"; _employeeOrgId = null; _positionOrgId = null; _startFrom = _startTo = _endFrom = _endTo = null; _applied = NoFilter; _resetKey++; _page = 1; await
LoadAsync();
    }
    private async Task PageChanged(int page) { _page = page; await LoadAsync(); }
    private async Task PageSizeChanged(int size) { _pageSize = size; _page = 1; await LoadAsync(); }
    private async Task SortByAsync(string column)
    {
        if (_sortBy == column) _sortDesc = !_sortDesc; else { _sortBy = column; _sortDesc = false; }
        _page = 1;
        await LoadAsync();
    }
    private static string FormatDate(DateTime? value) => value is null ? "—" :
value.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm");
    private sealed record HistoryRow(Guid Id, string EmployeeName, string Username, string PositionName, DateTime?
StartedAt, DateTime? EndedAt);
}