@page "/admin/organizations"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using YasPortal.Domain.Organization
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Services
@using YasPortal.Web.Components.Shared
@attribute [Authorize(Policy = Perm.AdminOrganizationsView)]
@inject IPermissionChecker PermissionChecker
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AdminQueryService AdminQueries
@inject AppState AppState
@inject ReportExportService Reports

<PageTitle>سازمان‌ها - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <div class="page-header">
        <div>
            <div class="page-kicker">مدیریت سامانه / سازمان‌ها</div>
            <h1 class="page-title">مدیریت سازمان‌ها</h1>
            <p class="page-subtitle">ایجاد سازمان، تغییر وضعیت و تعیین سازمان هر کارمند</p>
        </div><a class="btn btn-secondary" href="/dashboard"><i class="bx bx-arrow-back"></i> داشبورد</a>
    </div>
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-icon"><i class="bx bx-buildings"></i></div><span class="stat-label">کل
            سازمان‌ها</span><strong class="stat-value">@_organizationTotal</strong>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="bx bx-check-circle"></i></div><span class="stat-label">سازمان‌های
            فعال</span><strong class="stat-value">@_activeOrganizationCount</strong>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="bx bx-group"></i></div><span class="stat-label">کل کارکنان</span><strong
            class="stat-value">@_allEmployees.Count</strong>
        </div>
    </div>
    <div class="admin-stack">
@if (_canManage) {
<section class="card admin-form-row">
    <div class="admin-form-row-head">
        <h2 class="section-title"><i class="bx @(_editingId is null ? "bx-plus-circle" : "bx-edit-alt")"></i> @(_editingId is null ? "ایجاد سازمان جدید" : "ویرایش سازمان")</h2>
        <p class="muted">کد و نام سازمان را وارد کنید.</p>
    </div>
    <div class="admin-row-grid">
        <div class="form-field"><label class="form-label">کد سازمان</label><input class="form-control" @bind="_code" maxlength="50" placeholder="مثلاً ORG-004" /></div>
        <div class="form-field is-grow"><label class="form-label">نام سازمان</label><input class="form-control" @bind="_name" maxlength="200" placeholder="مثلاً معاونت منابع انسانی" /></div>
        <div class="form-field admin-row-submit">
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SaveOrganization"><i class="bx bx-save"></i> @(_editingId is null ? "ایجاد سازمان" : "ذخیره")</button>
                @if (_editingId is not null)
                {
                    <button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button>
                }
            </div>
        </div>
    </div>
    </section>
}

            <ListFilterBar Busy="_organizationLoading" ActiveCount="OrganizationFilterCount"
                           CanClear="@(OrganizationFilterCount > 0 || _draftOrganizationSearch != "" || _dOrgStatus != "" || _dOrgEmployees != "" || _dOrgEmployeeId is not null)"
                           OnSearch="SearchOrganizationsFilterAsync" OnClear="ClearOrganizationFilterAsync" ExportPermission="@(ReportPermissions.Organizations)" OnExport="ExportOrganizationsAsync" Exporting="_orgExporting">
                <div class="admin-filter"><label class="form-label">نام یا کد سازمان</label>
                    <input class="form-control" placeholder="نام یا کد سازمان..." @bind="_draftOrganizationSearch" @bind:event="oninput" /></div>
                <div class="admin-filter"><label class="form-label">وضعیت</label>
                    <LookupSelect Options="_orgStatusOptions" Value="@(_dOrgStatus == "" ? null : _dOrgStatus)" ValueChanged="k => _dOrgStatus = k ?? string.Empty" Placeholder="همه وضعیت‌ها" /></div>
                <div class="admin-filter"><label class="form-label">کارکنان</label>
                    <LookupSelect Options="_orgEmployeesOptions" Value="@(_dOrgEmployees == "" ? null : _dOrgEmployees)" ValueChanged="k => _dOrgEmployees = k ?? string.Empty" Placeholder="همه (با یا بدون کارمند)" /></div>
                <div class="admin-filter"><label class="form-label">شامل کارمند</label>
                    <ServerSearchableGuidSelect @key="_orgResetKey" Value="_dOrgEmployeeId" ValueChanged="id => { _dOrgEmployeeId = id; return Task.CompletedTask; }"
                                                SearchAsync="SearchEmployeesFilterAsync" Placeholder="همه کارکنان" SearchPlaceholder="نام، کد یا نام کاربری..." /></div>
            </ListFilterBar>

            <section class="card table-card">
                <div class="card-toolbar">
                    <div>
                        <h2 class="section-title" style="margin:0">فهرست سازمان‌ها</h2>
                        <p class="muted">جستجو و صفحه‌بندی در SQL Server انجام می‌شود.</p>
                    </div>
                    </div>
                    @if (_organizationLoading)
                    {
                        <LoadingState />
                    }
                    else if (_organizations.Count == 0)
                    {

                        <div class="empty-state">
                            <div class="empty-icon"><i class="bx bx-buildings"></i></div><strong>سازمانی پیدا نشد</strong>
                        </div>
                    }
                    else
                    {

                        <div class="data-table-wrap">
                            <table class="data-table data-table-bordered-rows">
                                <thead>
                                    <tr>
                                        <SortableHeader Text="کد" Column="code" CurrentSort="@_orgSortBy" CurrentDescending="@_orgSortDesc" OnSort="SortOrganizationsByAsync" />
                                        <SortableHeader Text="سازمان" Column="name" CurrentSort="@_orgSortBy" CurrentDescending="@_orgSortDesc" OnSort="SortOrganizationsByAsync" />
                                        <SortableHeader Text="کارکنان" Column="employees" CurrentSort="@_orgSortBy" CurrentDescending="@_orgSortDesc" OnSort="SortOrganizationsByAsync" />
                                        <SortableHeader Text="وضعیت" Column="status" CurrentSort="@_orgSortBy" CurrentDescending="@_orgSortDesc" OnSort="SortOrganizationsByAsync" />
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>@foreach(var organization in _organizations){
                                    <tr>
                                        <td><span class="badge badge-muted">@organization.Code</span></td>
                                        <td><strong>@organization.Name</strong></td>
                                        <td>@organization.EmployeeCount نفر</td>
                                        <td><span
                                            class="badge @(organization.IsActive ? "badge-success" : "badge-muted")">@(organization.IsActive
                                                                                ? "فعال" : "غیرفعال")</span>
                                        </td>
                                        <td class="action-cell">@if (_canManage) {<button class="btn btn-secondary btn-sm"
                                                                        @onclick="() => BeginEdit(organization)"><i class="bx bx-edit-alt"></i>
                                            ویرایش</button>}@if(organization.IsActive&&organization.EmployeeCount>0){
                                            <button class="btn btn-disabled btn-sm" disabled><i class="bx bx-lock-alt"></i>
                                                غیرفعال</button>
                                            }else
                                            {

                                                @if (_canManage) {<button class="btn @(organization.IsActive ? "btn-danger" : "btn-primary") btn-sm"
                                                        @onclick="() => ToggleOrganization(organization.Id)"><i
                                                    class="bx @(organization.IsActive ? "bx-pause-circle" : "bx-play-circle")"></i>
                                                    @(organization.IsActive ? "غیرفعال کردن" : "فعال کردن")</button>}
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    <ServerPagination Page="@_organizationPage" PageSize="@_organizationPageSize"
                                      TotalCount="@_organizationTotal" Busy="@_organizationLoading" PageChanged="OrganizationPageChanged"
                                      PageSizeChanged="OrganizationPageSizeChanged" />
                </section>
            </div>
            @if (_canManage) {
<section class="card organization-assignment">
                <div class="card-toolbar">
                    <div>
                        <h2 class="section-title" style="margin:0;">تخصیص سازمان به کارکنان</h2>
                        <p class="page-subtitle">کارکنان بر اساس سازمان فعلی گروه‌بندی شده‌اند. برای جابه‌جایی، سازمان جدید را انتخاب کنید.</p>
                    </div>
                    <div class="toolbar-tools">
                        <div class="search-box"><i class="bx bx-search"></i><input class="form-control"
                            placeholder="جستجوی نام کارمند یا سازمان..." @bind="_employeeSearch" @bind:event="oninput"
                            @onkeyup="EmployeeSearchChanged" />@if(!string.IsNullOrEmpty(_employeeSearch)){<button
                                type="button" class="search-clear" @onclick="ClearEmployeeSearch"><i class="bx bx-x"></i></button>}</div>
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="ExpandAllOrgGroups"><i
                            class="bx bx-chevrons-down"></i> باز کردن همه</button>
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="CollapseAllOrgGroups"><i
                            class="bx bx-chevrons-up"></i> بستن همه</button>
                    </div>
                </div>
                @if (_employeeLoading)
                {
                    <LoadingState />
                }
                else
                {
                    <div class="tree-summary">
                        @if (_orgAssignVisibleIds is not null)
                        {
                            <span><i class="bx bx-search"></i> @_orgAssignMatchCount نتیجه از @_allEmployees.Count کارمند</span>
                        }
                        else
                        {
                            <span><i class="bx bx-group"></i> @_allEmployees.Count کارمند</span>
                            <span><i class="bx bx-buildings"></i> @_employeeGroups.Count() سازمان</span>
                        }
                    </div>
                    @if (_orgAssignVisibleIds is not null && _orgAssignVisibleIds.Count == 0)
                    {
                        <div class="empty-state"><i class="bx bx-search-alt empty-icon"></i><strong>نتیجه‌ای پیدا نشد</strong><span>نام دیگری را جستجو کنید.</span></div>
                    }
                    else
                    {
                        <div class="org-assign-sections">
                            @foreach (var group in _employeeGroups)
                            {
                                var collapsed = _collapsedOrgGroups.Contains(group.Key);
                                <section class="permission-section @(collapsed ? "collapsed" : "")">
                                    <div class="permission-section-heading" @onclick="() => ToggleOrgGroup(group.Key)">
                                        <div><i class="bx bx-buildings"></i><strong>@group.Key</strong></div><span
                                            class="badge badge-muted">@group.Count() نفر</span><i class="bx bx-chevron-down chevron"></i>
                                    </div>
                                    <div class="org-assign-rows">
                                        @foreach (var employee in group)
                                        {
                                            <div class="org-assign-row">
                                                <div class="org-assign-person">
                                                    <span class="org-assign-avatar">@GetInitial(employee.FullName)</span>
                                                    <span class="org-assign-text"><strong title="@employee.FullName">@employee.FullName</strong><small>@employee.Code — @employee.Username</small></span>
                                                </div>
                                                <span class="badge @(employee.IsActive ? "badge-success" : "badge-muted")">@(employee.IsActive ? "فعال" : "غیرفعال")</span>
                                                <div class="org-assign-select">
                                                    <ServerSearchableGuidSelect Value="@employee.OrganizationId"
                                                        ValueChanged="id=>ChangeEmployeeOrganization(employee.Id,id)" SearchAsync="SearchOrganizationsAsync"
                                                        SelectedText="@employee.OrganizationName" Placeholder="انتخاب سازمان"
                                                        SearchPlaceholder="نام سازمان..." />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    }
                }
            </section>
}
        </div>

@code {
    private bool _canManage;
    private List<AdminQueryService.OrganizationPageRow> _organizations = [];
    private Guid? _editingId;
    private string _code = string.Empty, _name = string.Empty, _organizationSearch = "", _employeeSearch = "";
    private int
_organizationPage = 1, _organizationPageSize = 20, _organizationTotal, _activeOrganizationCount;
    private string? _orgSortBy; private bool _orgSortDesc;
    private bool _organizationLoading, _employeeLoading;
    private List<AdminQueryService.EmployeeAssignmentRow> _allEmployees = [];
    private readonly HashSet<string> _collapsedOrgGroups = [];
    private bool _employeeTreeInitialized;
    private HashSet<Guid>? _orgAssignVisibleIds;
    private int _orgAssignMatchCount;
    private IEnumerable<IGrouping<string, AdminQueryService.EmployeeAssignmentRow>> _employeeGroups =>
        _allEmployees.Where(x => _orgAssignVisibleIds is null || _orgAssignVisibleIds.Contains(x.Id))
            .GroupBy(x => string.IsNullOrWhiteSpace(x.OrganizationName) ? "بدون سازمان" : x.OrganizationName!)
            .OrderBy(g => g.Key);
    protected override async Task OnInitializedAsync() { _canManage = await PermissionChecker.HasPermissionAsync(Perm.AdminOrganizationsManage); await LoadAsync(); }
    private async Task LoadAsync() { await LoadOrganizationsAsync(); await LoadEmployeesAsync(); await LoadStatsAsync(); }
    private async Task LoadOrganizationsAsync()
    {
        _organizationLoading = true; try
        {
            var r = await
AdminQueries.GetOrganizationsAsync(_organizationPage, _organizationPageSize, _organizationSearch, _orgSortBy, _orgSortDesc, _orgStatus == "" ? null : _orgStatus == "active", _orgEmployees == "" ? null : _orgEmployees, _orgEmployeeId); _organizations =
r.Items.ToList(); _organizationTotal = r.TotalCount; if (_organizationTotal > 0 && _organizationPage > Math.Max(1,
(int)Math.Ceiling(_organizationTotal / (double)_organizationPageSize)))
            {
                _organizationPage = 1; var
reset = await
AdminQueries.GetOrganizationsAsync(_organizationPage, _organizationPageSize, _organizationSearch, _orgSortBy, _orgSortDesc, _orgStatus == "" ? null : _orgStatus == "active", _orgEmployees == "" ? null : _orgEmployees, _orgEmployeeId); _organizations =
reset.Items.ToList(); _organizationTotal = reset.TotalCount;
            }
        }
        finally { _organizationLoading = false; }
    }
    private bool _orgExporting;
    /// <summary>Exports every organization the last search matched, in the table's current order.</summary>
    private async Task ExportOrganizationsAsync()
    {
        if (_orgExporting) return;
        _orgExporting = true;
        try
        {
            await Reports.ExportPagedAsync(ReportPermissions.Organizations, "organizations",
                ["کد", "نام سازمان", "وضعیت", "تعداد کارکنان"],
                (page, size) => AdminQueries.GetOrganizationsAsync(page, size, _organizationSearch, _orgSortBy, _orgSortDesc, _orgStatus == "" ? null : _orgStatus == "active", _orgEmployees == "" ? null : _orgEmployees, _orgEmployeeId),
                x => [x.Code, x.Name, x.IsActive ? "فعال" : "غیرفعال", WorkflowDisplay.ToPersianDigits(x.EmployeeCount.ToString())]);
        }
        finally { _orgExporting = false; }
    }
    private async Task SortOrganizationsByAsync(string column)
    {
        if (_orgSortBy == column) _orgSortDesc = !_orgSortDesc; else { _orgSortBy = column; _orgSortDesc = false; }
        _organizationPage = 1;
        await LoadOrganizationsAsync();
    }
    private async Task LoadEmployeesAsync()
    {
        _employeeLoading = true; try
        {
            _allEmployees = (await AdminQueries.GetAllEmployeesForAssignmentAsync()).ToList();
            if (!_employeeTreeInitialized)
            {
                foreach (var key in _allEmployees.Select(x => string.IsNullOrWhiteSpace(x.OrganizationName) ? "بدون سازمان" : x.OrganizationName!).Distinct())
                    _collapsedOrgGroups.Add(key);
                _employeeTreeInitialized = true;
            }
            if (_employeeSearch.Trim().Length > 0)
                RecomputeOrgAssignVisible();
        }
        finally { _employeeLoading = false; }
    }
    private async Task LoadStatsAsync()
    {
        await using var db = await
DbFactory.CreateDbContextAsync(); _activeOrganizationCount = await db.Organizations.CountAsync(x => x.IsActive);
    }
    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchOrganizationsAsync(string search, CancellationToken
ct) => AdminQueries.SearchOrganizationsAsync(search, true, ct);
    private void ToggleOrgGroup(string key) { if (!_collapsedOrgGroups.Add(key)) _collapsedOrgGroups.Remove(key); }
    private void ExpandAllOrgGroups() { ClearEmployeeSearch(); _collapsedOrgGroups.Clear(); }
    private void CollapseAllOrgGroups()
    {
        ClearEmployeeSearch();
        _collapsedOrgGroups.Clear();
        foreach (var key in _allEmployees.Select(x => string.IsNullOrWhiteSpace(x.OrganizationName) ? "بدون سازمان" : x.OrganizationName!).Distinct())
            _collapsedOrgGroups.Add(key);
    }
    private void RecomputeOrgAssignVisible()
    {
        var q = _employeeSearch.Trim();
        if (q.Length == 0) { _orgAssignVisibleIds = null; _orgAssignMatchCount = 0; return; }
        var matches = _allEmployees.Where(x => x.FullName.Contains(q, StringComparison.OrdinalIgnoreCase)
            || x.Username.Contains(q, StringComparison.OrdinalIgnoreCase)
            || x.Code.Contains(q, StringComparison.OrdinalIgnoreCase)
            || (x.OrganizationName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
        _orgAssignMatchCount = matches.Count;
        _orgAssignVisibleIds = matches.Select(x => x.Id).ToHashSet();
        foreach (var key in matches.Select(x => string.IsNullOrWhiteSpace(x.OrganizationName) ? "بدون سازمان" : x.OrganizationName!).Distinct())
            _collapsedOrgGroups.Remove(key);
    }
    // The box edits the draft; "جستجو" copies it into _organizationSearch, which every load (paging, sorting) uses.
    private string _draftOrganizationSearch = "", _dOrgStatus = "", _dOrgEmployees = "";
    private Guid? _dOrgEmployeeId;
    private string _orgStatus = "", _orgEmployees = "";
    private Guid? _orgEmployeeId;
    private int _orgResetKey;
    private static readonly IReadOnlyList<(string Key, string Text)> _orgStatusOptions = [("active", "فعال"), ("inactive", "غیرفعال")];
    private static readonly IReadOnlyList<(string Key, string Text)> _orgEmployeesOptions = [("with", "دارای کارمند"), ("without", "بدون کارمند")];
    private int OrganizationFilterCount => (_organizationSearch.Trim().Length > 0 ? 1 : 0) + (_orgStatus != "" ? 1 : 0) + (_orgEmployees != "" ? 1 : 0) + (_orgEmployeeId is null ? 0 : 1);
    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchEmployeesFilterAsync(string search, CancellationToken ct) => AdminQueries.SearchEmployeesAsync(search, ct);

    private async Task SearchOrganizationsFilterAsync()
    {
        _organizationSearch = _draftOrganizationSearch.Trim();
        _orgStatus = _dOrgStatus; _orgEmployees = _dOrgEmployees; _orgEmployeeId = _dOrgEmployeeId;
        _organizationPage = 1; await LoadOrganizationsAsync();
    }
    private async Task ClearOrganizationFilterAsync()
    {
        _organizationSearch = _draftOrganizationSearch = "";
        _orgStatus = _dOrgStatus = ""; _orgEmployees = _dOrgEmployees = ""; _orgEmployeeId = _dOrgEmployeeId = null;
        _orgResetKey++;
        _organizationPage = 1; await LoadOrganizationsAsync();
    }
    private void EmployeeSearchChanged(KeyboardEventArgs e) => RecomputeOrgAssignVisible();
    private void ClearEmployeeSearch() { _employeeSearch = ""; _orgAssignVisibleIds = null; _orgAssignMatchCount = 0; }
    private async Task OrganizationPageChanged(int page) { _organizationPage = page; await LoadOrganizationsAsync(); }
    private async Task OrganizationPageSizeChanged(int size)
    {
        _organizationPageSize = size; _organizationPage = 1; await
LoadOrganizationsAsync();
    }
    private void BeginEdit(AdminQueryService.OrganizationPageRow x) { if (!_canManage) return; _editingId = x.Id; _code = x.Code; _name = x.Name; }
    private void CancelEdit() { _editingId = null; _code = string.Empty; _name = string.Empty; }
    private async Task SaveOrganization()
    { if (!_canManage) return;
        var code = _code.Trim(); if (string.IsNullOrWhiteSpace(code))
        {
            AppState.AddToast("کد سازمان الزامی است.", ToastLevel.Error); return;
        }
        var name = _name.Trim(); if (string.IsNullOrWhiteSpace(name))
        {
            AppState.AddToast("نام سازمان الزامی است.",
ToastLevel.Error); return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Organizations.AnyAsync(x => x.Code == code && x.Id != (_editingId ?? Guid.Empty))) { AppState.AddToast("سازمانی با این کد قبلاً ثبت شده است.", ToastLevel.Error); return; }
        if (await
db.Organizations.AnyAsync(x => x.Name == name && x.Id != (_editingId ?? Guid.Empty))) { AppState.AddToast("سازمانی با این نام قبلاً ثبت شده است.", ToastLevel.Error); return; }
        if (_editingId is Guid id)
        {
            var existing = await db.Organizations.SingleAsync(x => x.Id == id);
            existing.ChangeCode(code);
            existing.Rename(name); AppState.AddToast("سازمان ویرایش شد.", ToastLevel.Success);
        }
        else { db.Organizations.Add(new Organization(code, name)); AppState.AddToast("سازمان جدید ایجاد شد.", ToastLevel.Success); }
        await db.SaveChangesAsync(); CancelEdit(); await LoadAsync();
    }
    private async Task ToggleOrganization(Guid id)
    { if (!_canManage) return;
        await using var db = await DbFactory.CreateDbContextAsync(); var x = await
db.Organizations.Include(o => o.Employees).SingleAsync(x => x.Id == id); if (x.IsActive && x.Employees.Any())
        {
            AppState.AddToast("این سازمان دارای کارمند است و قابل غیرفعال‌سازی نیست.", ToastLevel.Error); return;
        }
        if (x.IsActive) x.Deactivate();
        else
            x.Activate(); await db.SaveChangesAsync(); AppState.AddToast(x.IsActive ? "سازمان فعال شد." : "سازمان غیرفعال شد.",
ToastLevel.Success); await LoadAsync();
    }
    private async Task ChangeEmployeeOrganization(Guid employeeId, Guid? organizationId)
    { if (!_canManage) return;
        if (organizationId is not Guid
oid) return; await using var db = await DbFactory.CreateDbContextAsync(); var organization = await
db.Organizations.SingleOrDefaultAsync(x => x.Id == oid && x.IsActive); if (organization is null)
        {
            AppState.AddToast("فقط سازمان فعال قابل انتخاب است.", ToastLevel.Error); return;
        }
        var employee = await
db.Employees.SingleAsync(x => x.Id == employeeId); employee.ChangeOrganization(oid); await
db.SaveChangesAsync(); AppState.AddToast($"سازمان «{organization.Name}» ثبت شد.", ToastLevel.Success); await
LoadEmployeesAsync(); await LoadOrganizationsAsync();
    }
    private static string GetInitial(string value) => string.IsNullOrWhiteSpace(value) ? "ک" : value.Trim()[0].ToString();
}