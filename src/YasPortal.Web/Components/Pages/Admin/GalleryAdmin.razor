@page "/admin/gallery"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using YasPortal.Domain.Gallery
@using YasPortal.Domain.Guides
@using YasPortal.Domain.Paging
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize(Policy = Perm.AdminGalleryView)]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IPermissionChecker PermissionChecker
@inject AppState AppState

@* Image gallery management page (/admin/gallery). Administrators upload one or several pictures (png, jpg, gif, webp), give each *@
@* a title and an optional caption, set the order, switch a picture on or off and delete it. Switched-on pictures are shown to *@
@* everyone on the public gallery page (/gallery). People with the view permission can look; people with the manage permission can change. *@
<PageTitle>گالری تصاویر - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <SectionTabs Group="content-admin" />
    <div class="page-header">
        <div>
            <div class="page-kicker">مدیریت سامانه / صفحه اصلی</div>
            <h1 class="page-title"><i class="ti @Icons.Gallery"></i> گالری تصاویر</h1>
            <p class="page-subtitle">@(_canManage ? "" : "فقط خواندنی. ")تصاویر فعال برای همه در صفحه گالری نمایش داده می‌شود. فرمت‌های PNG، JPG، GIF و WebP و حداکثر @(UserGuideAttachment.MaxBytes / (1024 * 1024)) مگابایت برای هر تصویر.</p>
        </div>
        <div class="form-actions">
            <a class="btn btn-secondary" href="/gallery"><i class="ti @Icons.Gallery"></i> مشاهده گالری</a>
        </div>
    </div>

    @* Sub tabs, the same as on the store items page: the list of pictures, and the form for new pictures. *@
    @* Only people who may manage the gallery get the form tab; others just see the list. *@
    @if (_canManage)
    {
        <div class="form-actions no-print">
            <button class="btn @(_tab == "list" ? "btn-primary" : "btn-secondary")" @onclick="@(() => _tab = "list")">تصاویر</button>
            <button class="btn @(_tab == "form" ? "btn-primary" : "btn-secondary")" @onclick="@(() => _tab = "form")">بارگذاری تصویر</button>
        </div>
    }

    <div class="admin-stack">
        @* The form is shown only to people who may manage the gallery. NEW pictures are uploaded on the "form" tab; the form is hidden *@
        @* (not removed) on the list tab, so picked files are not lost when switching tabs. An EXISTING picture is edited in a window *@
        @* over the list; that window does not close by a click outside it, so nothing typed is lost by accident. *@
        @if (_canManage)
        {
            <FormHost Modal="@(_editingId is not null)" OnClose="CancelEdit" Size="medium" CloseOnOutsideClick="false">
            <div hidden="@(_tab != "form" && _editingId is null)">
            <section class="card admin-form-row">
                <div class="admin-form-row-head">
                    <h2 class="section-title"><i class="ti @(_editingId is null ? Icons.Add : Icons.Edit)"></i> @(_editingId is null ? "بارگذاری تصویر" : "ویرایش تصویر")</h2>
                    <p class="muted">@(_editingId is null ? "یک یا چند تصویر انتخاب کنید (حداکثر " + GalleryImage.MaxPerUpload + " تصویر در هر بار). تصاویر در انتهای ترتیب فعلی اضافه می‌شوند." : "عنوان، توضیح و ترتیب تصویر را تغییر دهید. برای تصویر دیگر، این تصویر را حذف و تصویر جدید را بارگذاری کنید.")</p>
                </div>
                @if (_editingId is null)
                {
                    <div class="admin-row-grid">
                        <div class="form-field is-grow"><label class="form-label">تصاویر</label>
                            <InputFile @key="_formKey" class="form-control" multiple accept="@_accept" OnChange="FilesPicked" />
                            <p class="muted" style="margin:6px 0 0">@(_files.Count == 0 ? "هنوز تصویری انتخاب نشده است." : _files.Count + " تصویر انتخاب شد.")</p></div>
                    </div>
                }
                else
                {
                    <div class="admin-row-grid">
                        <div class="form-field"><img class="gallery-admin-preview" src="@GalleryImage.UrlFor(_editingId.Value)" alt="" /></div>
                    </div>
                }
                @* Title and caption: for one new picture, or when editing. Several new pictures take their titles from the file names. *@
                @if (_editingId is not null || _files.Count == 1)
                {
                    <div class="admin-row-grid" style="margin-top:12px">
                        <div class="form-field is-grow"><label class="form-label">عنوان@(_editingId is null ? " (اختیاری، پیش‌فرض نام فایل)" : "")</label><input class="form-control" @bind="_title" maxlength="@GalleryImage.TitleMax" /></div>
                        @if (_editingId is not null)
                        {
                            <div class="form-field"><label class="form-label">ترتیب</label><input class="form-control" type="number" @bind="_sortOrder" /></div>
                        }
                    </div>
                    <div class="admin-row-grid" style="margin-top:12px">
                        <div class="form-field is-grow"><label class="form-label">توضیح (اختیاری)</label><textarea class="form-control" rows="2" @bind="_caption" maxlength="@GalleryImage.CaptionMax"></textarea></div>
                    </div>
                }
                else if (_files.Count > 1)
                {
                    <p class="muted" style="margin:12px 0 0">عنوان هر تصویر از نام فایل آن گرفته می‌شود؛ بعد از بارگذاری می‌توانید عنوان و توضیح هر کدام را ویرایش کنید.</p>
                }
                <div class="admin-row-grid" style="margin-top:12px">
                    <div class="form-field admin-row-submit"><div class="form-actions">
                        <button class="btn btn-primary" disabled="@_saving" @onclick="SaveAsync"><i class="ti @Icons.Save"></i> @(_editingId is null ? "بارگذاری" : "ذخیره")</button>
                        @if (_editingId is not null)
                        {
                            <button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button>
                        }
                    </div></div>
                </div>
            </section>
            </div>
            </FormHost>
        }

        @* The list of pictures with their status and action buttons. *@
        @if (_tab == "list")
        {
        @* Search card, like the other lists: nothing is filtered until "جستجو" is pressed. It looks at title, caption and file name. *@
        <ListFilterBar Busy="_loading" ActiveCount="FilterCount" CanClear="@(FilterCount > 0 || HasDraft)" OnSearch="ApplyFilters" OnClear="ClearFilters">
            <div class="admin-filter"><label class="form-label">جستجو</label>
                <input class="form-control" placeholder="عنوان، توضیح یا نام فایل..." @bind="_dSearch" @bind:event="oninput" /></div>
            <div class="admin-filter"><label class="form-label">وضعیت</label>
                <LookupSelect Options="StatusOptions" Value="@_dStatus" ValueChanged="k => _dStatus = string.IsNullOrEmpty(k) ? null : k" Placeholder="همه" /></div>
        </ListFilterBar>

        <section class="card table-card">
            <div class="card-toolbar">
                <div>
                    <h2 class="section-title" style="margin:0">فهرست تصاویر</h2>
                    <p class="muted">به ترتیب نمایش. تصاویر غیرفعال در گالری دیده نمی‌شوند.</p>
                </div>
                <span class="badge badge-muted">@(FilterCount > 0 ? $"{Sorted.Count} از {_images.Count}" : _images.Count.ToString()) تصویر</span>
            </div>
            @if (_loading)
            {
                <LoadingState />
            }
            else if (_images.Count == 0)
            {
                <div class="empty-state"><div class="empty-icon"><i class="ti @Icons.Gallery"></i></div><strong>تصویری ثبت نشده است</strong><span>از زبانه «بارگذاری تصویر» تصویر اضافه کنید.</span></div>
            }
            else if (Sorted.Count == 0)
            {
                <div class="empty-state"><div class="empty-icon"><i class="ti @Icons.Search"></i></div><strong>تصویری با این فیلتر پیدا نشد</strong><span>فیلترها را تغییر دهید یا پاک کنید.</span></div>
            }
            else
            {
                var sorted = Sorted;
                <div class="data-table-wrap">
                    <table class="data-table data-table-bordered-rows">
                        @* Click a heading to sort by it, click again to reverse. The picture and buttons columns cannot be sorted. *@
                        <thead><tr>
                            <th>تصویر</th>
                            <SortableHeader Text="ترتیب" Column="order" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortBy" />
                            <SortableHeader Text="عنوان" Column="title" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortBy" />
                            <SortableHeader Text="فایل" Column="file" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortBy" />
                            <SortableHeader Text="وضعیت" Column="status" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortBy" />
                            @if (_canManage) { <th>عملیات</th> }
                        </tr></thead>
                        <tbody>
                        @* One row per picture: a small preview, order, title and caption, file, status and actions. *@
                        @foreach (var image in ListPaging.Slice(sorted, _page, _pageSize))
                        {
                            <tr>
                                <td><img class="gallery-admin-thumb" src="@GalleryImage.UrlFor(image.Id)" alt="" loading="lazy" /></td>
                                <td>@image.SortOrder</td>
                                <td><strong>@image.Title</strong>@if (image.Caption is not null) { <div class="muted">@image.Caption</div> }</td>
                                <td><span dir="ltr">@image.FileName</span><div class="muted">@SizeText(image.SizeBytes)</div></td>
                                <td><span class="badge @(image.IsActive ? "badge-success" : "badge-muted")">@(image.IsActive ? "فعال" : "غیرفعال")</span></td>
                                @* Edit, switch on/off and delete buttons only for people who may manage the gallery. *@
                                @if (_canManage)
                                {
                                    <td class="action-cell">
                                        <button class="btn btn-secondary btn-sm" @onclick="() => BeginEdit(image)"><i class="ti @Icons.Edit"></i> ویرایش</button>
                                        <button class="btn btn-secondary btn-sm" @onclick="() => ToggleAsync(image.Id)"><i class="ti @(image.IsActive ? Icons.Deactivate : Icons.Activate)"></i> @(image.IsActive ? "غیرفعال" : "فعال")</button>
                                        @* Deleting asks for a second click. *@
                                        @if (_confirmDeleteId == image.Id)
                                        {
                                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteAsync(image.Id)"><i class="ti @Icons.Delete"></i> تأیید حذف</button>
                                            <button class="btn btn-secondary btn-sm" @onclick="() => _confirmDeleteId = null">انصراف</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-danger btn-sm" @onclick="() => _confirmDeleteId = image.Id"><i class="ti @Icons.Delete"></i> حذف</button>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @* Page navigation under the list (rows are cut into pages here in the page, because the whole list is already loaded). *@
                <ServerPagination Page="@ListPaging.ClampPage(_page, sorted.Count, _pageSize)" PageSize="@_pageSize" TotalCount="@sorted.Count"
                                  PageChanged="p => _page = p" PageSizeChanged="PageSizeChanged" />
            }
        </section>
        }
    </div>
</div>

@code {
    // The tab shown: "list" (the pictures) or "form" (uploading new pictures).
    private string _tab = "list";
    private bool _loading = true, _canManage, _saving;
    // The picture details of the list. The picture bytes are never loaded here.
    private List<GalleryImage> _images = [];

    // ---- search, sorting and paging of the list ----
    // Applied filter values and what is typed in the search card (applied only when "جستجو" is pressed).
    private string _search = "", _dSearch = "";
    private string? _status, _dStatus;
    // The column the list is sorted by (empty = the display order set by the administrator), its direction, and the page shown.
    private string? _sortBy;
    private bool _sortDesc;
    private int _page = 1, _pageSize = 20;
    // The choices of the status filter: the same words the status column shows.
    private static readonly IReadOnlyList<(string Key, string Text)> StatusOptions = [("فعال", "فعال"), ("غیرفعال", "غیرفعال")];

    // How many filters are applied right now, and whether something typed or picked is not applied yet.
    private int FilterCount => (string.IsNullOrWhiteSpace(_search) ? 0 : 1) + (_status is null ? 0 : 1);
    private bool HasDraft => !string.IsNullOrWhiteSpace(_dSearch) || _dStatus is not null;

    // The pictures left after the applied filters, in the chosen sort order (the administrator's display order when no column is chosen).
    private IReadOnlyList<GalleryImage> Sorted
    {
        get
        {
            var rows = _images.Where(x => GalleryImage.Matches(x.Title, x.Caption, x.FileName, _search)
                && (_status is null || (x.IsActive ? "فعال" : "غیرفعال") == _status));
            return TableSort.Apply(rows, _sortBy, _sortDesc,
                ("order", x => x.SortOrder), ("title", x => x.Title), ("file", x => x.FileName), ("status", x => x.IsActive ? "فعال" : "غیرفعال"));
        }
    }

    // Search button: apply what was typed and picked, and go back to the first page.
    private void ApplyFilters() { (_search, _status) = (_dSearch.Trim(), _dStatus); _page = 1; }

    // Clear button: forget every filter.
    private void ClearFilters() { (_dSearch, _dStatus) = ("", null); ApplyFilters(); }

    // Heading click: sort by that column (again = reverse) and go back to the first page.
    private void SortBy(string column) { (_sortBy, _sortDesc) = TableSort.Toggle(_sortBy, _sortDesc, column); _page = 1; }

    // Page size changed: show the first page of the new size.
    private void PageSizeChanged(int size) { _pageSize = size; _page = 1; }

    // ---- the form ----
    private Guid? _editingId, _confirmDeleteId;
    private string _title = "", _caption = "";
    private int _sortOrder;
    // Changing this number gives the file picker a new life, which empties it.
    private int _formKey;
    // The pictures picked for upload (checked as soon as they are picked).
    private List<IBrowserFile> _files = [];
    private static readonly string _accept = string.Join(",", GalleryImage.AllowedExtensions);

    // On opening: find out whether the person may manage the gallery, then load the pictures.
    protected override async Task OnInitializedAsync()
    {
        _canManage = await PermissionChecker.HasPermissionAsync(Perm.AdminGalleryManage);
        await LoadAsync();
        _loading = false;
    }

    // Load all pictures' details in display order (the bytes stay in the database).
    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _images = await db.GalleryImages.AsNoTracking().OrderBy(x => x.SortOrder).ThenBy(x => x.CreatedAtUtc).ToListAsync();
    }

    // A file size in words: kilobytes below one megabyte, megabytes above.
    private static string SizeText(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / (1024.0 * 1024.0):0.#} مگابایت" : $"{Math.Max(1, bytes / 1024)} کیلوبایت";

    // Fill the form with an existing picture so it can be changed. The page stays on the list; the form opens in a window over it.
    private void BeginEdit(GalleryImage image)
    {
        _editingId = image.Id;
        _title = image.Title; _caption = image.Caption ?? ""; _sortOrder = image.SortOrder;
        _files = [];
        _formKey++;
    }

    // Leave edit mode (this also closes the edit window) and empty the form.
    private async Task CancelEdit()
    {
        _tab = "list";
        ResetForm();
        await LoadAsync();
    }

    // Return the form to its empty 'upload' state.
    private void ResetForm()
    {
        _editingId = null;
        _title = _caption = "";
        _files = [];
        _formKey++;
    }

    // Check the picked pictures (how many, type and size) as soon as they are picked. If anything is wrong, say so and empty the picker.
    private void FilesPicked(InputFileChangeEventArgs e)
    {
        var error = GalleryImage.ValidateCount(e.FileCount);
        var picked = error is null && e.FileCount > 0 ? e.GetMultipleFiles(e.FileCount).ToList() : [];
        foreach (var file in picked)
        {
            var fileError = GalleryImage.ValidateFile(file.Name, file.Size);
            if (fileError is not null) { error = file.Name + ": " + fileError; break; }
        }
        if (error is not null)
        {
            AppState.AddToast(error, ToastLevel.Error);
            _files = [];
            _formKey++;   // clears the picker
            return;
        }
        _files = picked;
    }

    // Save the edits to one picture, or upload the picked pictures (each goes to the end of the order).
    private async Task SaveAsync()
    {
        if (_saving || !_canManage || !await PermissionChecker.HasPermissionAsync(Perm.AdminGalleryManage)) return;
        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (_editingId is Guid id)
            {
                var image = await db.GalleryImages.SingleOrDefaultAsync(x => x.Id == id);
                if (image is null) { AppState.AddToast("این تصویر دیگر وجود ندارد.", ToastLevel.Error); ResetForm(); await LoadAsync(); return; }
                image.Update(_title, _caption, _sortOrder);
                await db.SaveChangesAsync();
                AppState.AddToast("تصویر ذخیره شد.", ToastLevel.Success);
            }
            else
            {
                if (_files.Count == 0) { AppState.AddToast("حداقل یک تصویر انتخاب کنید.", ToastLevel.Error); return; }
                var order = _images.Count == 0 ? 1 : _images.Max(x => x.SortOrder) + 1;
                foreach (var file in _files)
                {
                    // Read the file, then keep its details and its bytes in the two tables. A typed title and caption are used only for a single picture.
                    using var buffer = new MemoryStream();
                    await using (var stream = file.OpenReadStream(UserGuideAttachment.MaxBytes))
                        await stream.CopyToAsync(buffer);
                    var image = new GalleryImage(_files.Count == 1 ? _title : null, _files.Count == 1 ? _caption : null, order++, file.Name, buffer.Length);
                    db.GalleryImages.Add(image);
                    db.GalleryImageFiles.Add(new GalleryImageFile(image.Id, buffer.ToArray()));
                }
                await db.SaveChangesAsync();
                AppState.AddToast(_files.Count == 1 ? "تصویر اضافه شد." : _files.Count + " تصویر اضافه شد.", ToastLevel.Success);
            }
            _tab = "list";   // back to the list to see the result
            ResetForm();
            await LoadAsync();
        }
        catch (ArgumentException ex)
        {
            AppState.AddToast(Explain(ex), ToastLevel.Error);
        }
        catch (Exception)
        {
            AppState.AddToast("ذخیره تصویر انجام نشد.", ToastLevel.Error);
        }
        finally { _saving = false; }
    }

    // The domain's messages are English; the person sees a Persian sentence for the field that failed.
    private static string Explain(ArgumentException ex) => ex.ParamName switch
    {
        "title" => $"عنوان لازم است و حداکثر {GalleryImage.TitleMax} نویسه باشد.",
        "caption" => $"توضیح حداکثر {GalleryImage.CaptionMax} نویسه باشد.",
        "fileName" => ex.Message,   // the file rules' own messages are already Persian
        _ => "اطلاعات تصویر معتبر نیست.",
    };

    // Switch a picture on or off.
    private async Task ToggleAsync(Guid id)
    {
        if (!_canManage || !await PermissionChecker.HasPermissionAsync(Perm.AdminGalleryManage)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var image = await db.GalleryImages.SingleOrDefaultAsync(x => x.Id == id);
        if (image is not null)
        {
            if (image.IsActive) image.Deactivate(); else image.Activate();
            await db.SaveChangesAsync();
        }
        await LoadAsync();
    }

    // Delete a picture (after the confirmation click). Its bytes are removed together with it by the database.
    private async Task DeleteAsync(Guid id)
    {
        _confirmDeleteId = null;
        if (!_canManage || !await PermissionChecker.HasPermissionAsync(Perm.AdminGalleryManage)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var image = await db.GalleryImages.SingleOrDefaultAsync(x => x.Id == id);
        if (image is not null)
        {
            db.GalleryImages.Remove(image);
            await db.SaveChangesAsync();
            AppState.AddToast("تصویر حذف شد.", ToastLevel.Success);
        }
        await LoadAsync();
    }
}
