@page "/admin/permissions"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Domain.Authorization
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Services
@attribute [Authorize(Policy = "Admin.Permissions")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AppState AppState

<PageTitle>مجوزها - یاس پورتال</PageTitle>
<div class="page-header"><div><div class="page-subtitle">مدیریت سامانه / مجوزها</div><h1 class="page-title">مدیریت مجوزها</h1><p class="page-subtitle">تعریف مجوزهای قابل تخصیص به ترکیب کاربر و سمت</p></div><a class="btn btn-secondary" href="/dashboard"><i class="bx bx-arrow-back"></i> داشبورد</a></div>
<div class="stat-grid"><div class="stat-card"><div class="stat-icon"><i class="bx bx-key"></i></div><span class="stat-label">کل مجوزها</span><strong class="stat-value">@_permissions.Count</strong></div><div class="stat-card"><div class="stat-icon"><i class="bx bx-link"></i></div><span class="stat-label">تخصیص مجوز</span><strong class="stat-value">@_assignmentCount</strong></div><div class="stat-card"><div class="stat-icon"><i class="bx bx-user-check"></i></div><span class="stat-label">کاربران دارای مجوز</span><strong class="stat-value">@_employeeCount</strong></div></div>
<div class="admin-two-col"><section class="card"><h2 class="section-title"><i class="bx bx-plus-circle"></i> @(_editingId is null?"مجوز جدید":"ویرایش مجوز")</h2><label class="form-label">کد مجوز</label><input class="form-control" @bind="_code" maxlength="200" placeholder="Requests.Approve"/><label class="form-label">نام مجوز</label><input class="form-control" @bind="_name" maxlength="300" placeholder="تأیید درخواست‌ها"/><div class="form-actions"><button class="btn btn-primary" @onclick="Save"><i class="bx bx-save"></i> @(_editingId is null?"ایجاد":"ذخیره")</button>@if(_editingId is not null){<button class="btn btn-secondary" @onclick="Cancel">انصراف</button>}</div></section>
<section class="card table-card"><div class="table-toolbar"><h2 class="section-title" style="margin:0">فهرست مجوزها</h2></div><div class="data-table-wrap"><table class="data-table"><thead><tr><th>کد</th><th>نام</th><th>تخصیص</th><th>کاربر</th><th>عملیات</th></tr></thead><tbody>@foreach(var x in _permissions){<tr @key="x.Id"><td><code>@x.Code</code></td><td><strong>@x.Name</strong></td><td>@x.AssignmentCount</td><td>@x.EmployeeCount</td><td class="action-cell"><button class="btn btn-secondary btn-sm" @onclick="()=>Edit(x.Id)"><i class="bx bx-edit-alt"></i> ویرایش</button>@if(x.AssignmentCount==0){<button class="btn btn-danger btn-sm" @onclick="()=>Delete(x.Id)"><i class="bx bx-trash"></i></button>}else{<button class="btn btn-disabled btn-sm" disabled title="این مجوز در حال استفاده است"><i class="bx bx-lock-alt"></i></button>}</td></tr>}</tbody></table></div></section></div>
<section class="card" style="margin-top:16px"><h2 class="section-title">مدل دسترسی</h2><p class="page-subtitle">مجوز به خود کاربر یا سمت تعلق نمی‌گیرد؛ هر تخصیص همیشه شامل <strong>کاربر + سمت + مجوز</strong> است. مدیریت این تخصیص‌ها از صفحه کاربران انجام می‌شود.</p></section>
@code {private List<PermissionRow> _permissions=[];private Guid? _editingId;private string _code="",_name="";private int _assignmentCount,_employeeCount;protected override async Task OnInitializedAsync()=>await LoadAsync();private async Task LoadAsync(){await using var db=await DbFactory.CreateDbContextAsync();_permissions=await db.Permissions.AsNoTracking().OrderBy(x=>x.Code).Select(x=>new PermissionRow(x.Id,x.Code,x.Name,db.UserPositionPermissions.Count(up=>up.PermissionId==x.Id),db.UserPositionPermissions.Where(up=>up.PermissionId==x.Id).Select(up=>up.EmployeeId).Distinct().Count())).ToListAsync();_assignmentCount=_permissions.Sum(x=>x.AssignmentCount);_employeeCount=_permissions.Sum(x=>x.EmployeeCount);}private void Edit(Guid id){var x=_permissions.Single(x=>x.Id==id);_editingId=id;_code=x.Code;_name=x.Name;}private void Cancel(){_editingId=null;_code=_name="";}private async Task Save(){var code=_code.Trim();var name=_name.Trim();if(string.IsNullOrWhiteSpace(code)||string.IsNullOrWhiteSpace(name)){AppState.AddToast("کد و نام مجوز الزامی است.",ToastLevel.Error);return;}await using var db=await DbFactory.CreateDbContextAsync();if(await db.Permissions.AnyAsync(x=>x.Code==code&&x.Id!=(_editingId??Guid.Empty))){AppState.AddToast("این کد مجوز قبلاً ثبت شده است.",ToastLevel.Error);return;}if(_editingId is Guid id){(await db.Permissions.SingleAsync(x=>x.Id==id)).Rename(code,name);AppState.AddToast("مجوز ویرایش شد.",ToastLevel.Success);}else{db.Permissions.Add(new Permission(code,name));AppState.AddToast("مجوز جدید ایجاد شد.",ToastLevel.Success);}await db.SaveChangesAsync();Cancel();await LoadAsync();}private async Task Delete(Guid id){await using var db=await DbFactory.CreateDbContextAsync();if(await db.UserPositionPermissions.AnyAsync(x=>x.PermissionId==id)){AppState.AddToast("این مجوز در حال استفاده است و قابل حذف نیست.",ToastLevel.Error);return;}var x=await db.Permissions.SingleAsync(x=>x.Id==id);db.Permissions.Remove(x);await db.SaveChangesAsync();AppState.AddToast("مجوز حذف شد.",ToastLevel.Success);await LoadAsync();}private sealed record PermissionRow(Guid Id,string Code,string Name,int AssignmentCount,int EmployeeCount);}
<style>.admin-two-col{display:grid;grid-template-columns:minmax(280px,340px) 1fr;gap:16px;align-items:start}.form-label{display:block;margin:12px 0 6px}.form-actions{display:flex;gap:8px;margin-top:13px}.btn-sm{padding:7px 10px;font-size:12px}.btn-disabled{background:#f2f4f7;color:#98a2b3;border:1px solid #eaecf0;cursor:not-allowed}.action-cell{white-space:nowrap}@@media(max-width:900px){.admin-two-col{grid-template-columns:1fr}}</style>
