@page "/requests/inbox"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Application.Authorization
@using YasPortal.Domain.Workflows
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize(Policy = Perm.RequestsOwnView)]
@attribute [Authorize(Policy = "NonAdmin")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IPermissionChecker Permissions
@inject WorkflowService Workflows
@inject NotificationService NotificationSvc
@inject AppState AppState
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>کارتابل تاییدات - یاس پورتال</PageTitle>

<div class="requests-page" dir="rtl">
    <div class="page-header">
        <div>
            <div class="page-kicker">درخواست‌ها و گردش‌کار</div>
            <h1 class="page-title"><i class="ti @Icons.Inbox"></i> کارتابل تاییدات</h1>
            <p class="page-subtitle">درخواست‌هایی که در انتظار تصمیم شما (بر اساس سمت فعال شما) هستند.</p>
        </div>
    </div>

    @if (!_ready)
    {
        <section class="card"><LoadingState Text="در حال بررسی سمت فعال..." /></section>
    }
    else if (_approverPositionId is null)
    {
        <section class="card"><div class="empty-state"><i class="ti @Icons.Alert"></i><strong>سمت فعالی برای شما یافت نشد</strong></div></section>
    }
    else
    {
        <div class="inbox-tabs">
            <button type="button" class="inbox-tab @(!_historyMode ? "is-active" : "")" @onclick="ShowPending"><i class="ti @Icons.Awaiting"></i> در انتظار من @(_pendingTotalCount > 0 ? $"({ToPersianDigits(_pendingTotalCount.ToString())})" : "")</button>
            <button type="button" class="inbox-tab @(_historyMode ? "is-active" : "")" @onclick="ShowHistory"><i class="ti @Icons.History"></i> تاریخچه تصمیمات من</button>
        </div>

        @if (!_historyMode)
        {
            <RequestFilterBar Filter="_pendingFilter" Busy="_pendingLoading" Changed="OnPendingFilterChangedAsync"
                              SortOptions="_pendingSortOptions" Sort="@(_pendingSort)" DefaultSort="created:asc" SortChanged="OnPendingSortChangedAsync" />
            @if (_items.Count == 0)
            {
                <section class="card"><div class="empty-state"><i class="ti @Icons.Success inbox-empty-icon"></i><strong>کارتابل شما خالی است</strong><span>در حال حاضر درخواستی در انتظار تصمیم شما نیست.</span></div></section>
            }
            else
            {
                @foreach (var item in _items)
                {
                    var busy = _actingRequestId == item.Request.Id;
                    <div class="request-card">
                        <div class="request-card-header">
                            <span class="request-card-icon"><i class="ti @WorkflowDisplay.IconFor(item.Request.WorkflowType)"></i></span>
                            <span class="request-card-title">
                                <strong>@WorkflowFieldCatalog.GetDisplayName(item.Request.WorkflowType)</strong>
                                <span>از طرف @item.RequesterName · @item.Request.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                                <RequestNowLine Request="item.Request" ShowWaitingFor="false" />
                            </span>
                            <span class="admin-pill"><i class="ti @Icons.WorkflowStep"></i> @item.CurrentStep.Name</span>
                            @if (item.IsDelegated)
                            {
                                <span class="badge badge-info"><i class="ti @Icons.Delegation"></i> به نمایندگی از @(_holderNames.TryGetValue(item.CurrentStep.ApproverPositionId, out var delegatorName) ? delegatorName : "سمت خالی")</span>
                            }
                        </div>

                        <div class="request-card-body">
                            <RequestSummary Request="item.Request" EmployeeNames="_employeeNames" HolderNames="_holderNames" ShowHolderForCurrentStep="false" YourStepId="item.CurrentStep.Id" />

                            @{
                                // Multi-part forms: the approver at this step fills their own part before approving.
                                var stepPart = WorkflowFieldCatalog.GetStepPart(item.Request.WorkflowType, item.CurrentStep.FillsPart);
                            }
                            @if (stepPart is not null)
                            {
                                <div class="resubmit-panel">
                                    <h3 class="section-title" style="font-size:12.5px;margin:0 0 8px"><i class="ti @Icons.Edit"></i> بخش @ToPersianDigits(stepPart.Part.ToString()): @stepPart.Title — پیش از تایید، این بخش را تکمیل کنید</h3>
                                    <WorkflowFieldsForm Type="item.Request.WorkflowType" Part="stepPart.Part" Values="GetPartValues(item)" />
                                </div>
                            }

                            <div class="inbox-comment">
                                <label class="form-label">نظر (اختیاری)</label>
                                <textarea class="form-control" rows="2" placeholder="در صورت نیاز، توضیحی برای ثبت در کارتابل درخواست‌کننده بنویسید..." value="@GetComment(item.Request.Id)" @oninput="e => SetComment(item.Request.Id, e)"></textarea>
                            </div>

                            <div class="inbox-actions">
                                <div class="inbox-actions-primary">
                                <AuthorizeView Policy="@Perm.RequestsDecisionApprove">
                                    <button class="btn btn-primary" disabled="@busy" @onclick="() => Act(item, WorkflowAction.Approve)"><i class="ti @Icons.Approve"></i> تایید</button>
                                </AuthorizeView>
                                <AuthorizeView Policy="@Perm.RequestsDecisionReject">
                                    <button class="btn btn-danger" disabled="@busy" @onclick="() => Act(item, WorkflowAction.Reject)"><i class="ti @Icons.Reject"></i> رد</button>
                                </AuthorizeView>
                                </div>
                                <div class="inbox-actions-secondary">
                                <AuthorizeView Policy="@Perm.RequestsDecisionReturnToRequester">
                                    <button class="btn btn-secondary" disabled="@busy" @onclick="() => Act(item, WorkflowAction.ReturnToRequester)"><i class="ti @Icons.ReturnToRequester"></i> بازگشت به درخواست‌کننده</button>
                                </AuthorizeView>
                                <AuthorizeView Policy="@Perm.RequestsDecisionReturnToPreviousStep">
                                    <button class="btn btn-secondary" disabled="@busy" @onclick="() => Act(item, WorkflowAction.ReturnToPreviousStep)" title="@(item.HasPreviousStep ? "بازگشت به مرحله تایید قبلی" : "این اولین مرحله است؛ بازگشت به درخواست‌کننده انجام می‌شود")"><i class="ti @Icons.ReturnToPreviousStep"></i> بازگشت به مرحله قبل</button>
                                </AuthorizeView>
                                @{
                                    var earlierSteps = item.Request.Steps
                                        .Where(s => s.Round == item.Request.CurrentRound && s.Order < item.CurrentStep.Order)
                                        .GroupBy(s => s.Order)
                                        .OrderBy(g => g.Key)
                                        .Select(g => (Order: g.Key, Name: string.Join(" / ", g.Select(x => x.Name).OrderBy(n => n, StringComparer.Ordinal))))
                                        .ToList();
                                }
                                @* Returning to the immediate previous step already has its own button, so a
                                   choice is only worth offering when there are at least two steps to pick from. *@
                                @if (earlierSteps.Count >= 2)
                                {
                                    <AuthorizeView Policy="@Perm.RequestsDecisionReturnToSpecificStep">
                                        <select class="form-control inbox-return-target" disabled="@busy" value="@GetReturnTarget(item.Request.Id)" @onchange="e => SetReturnTarget(item.Request.Id, e)">
                                            <option value="0">بازگشت به مرحله‌ی...</option>
                                            @foreach (var earlier in earlierSteps)
                                            {
                                                <option value="@earlier.Order">@earlier.Name</option>
                                            }
                                        </select>
                                        <button class="btn btn-secondary" disabled="@(busy || GetReturnTarget(item.Request.Id) == 0)" @onclick="() => Act(item, WorkflowAction.ReturnToSpecificStep)"><i class="ti @Icons.ReturnToSpecificStep"></i> بازگشت به مرحله انتخاب‌شده</button>
                                    </AuthorizeView>
                                }
                                </div>
                                @if (busy)
                                {
                                    <span class="muted"><i class="ti @Icons.Spinner"></i> در حال ثبت...</span>
                                }
                            </div>
                        </div>
                    </div>
                }
                <ServerPagination Page="_pendingPage" PageSize="_pendingPageSize" TotalCount="_pendingTotalCount" Busy="_pendingLoading" PageChanged="GoToPendingPageAsync" PageSizeChanged="OnPendingPageSizeChangedAsync" />
            }
        }
        else
        {
            <ListFilterBar Busy="_historyLoading" ActiveCount="HistoryActiveCount"
                           CanClear="@(HistoryActiveCount > 0 || _dHistoryType is not null || _dHistoryStatus is not null || _dHistoryFrom is not null || _dHistoryTo is not null)"
                           OnSearch="SearchHistoryAsync" OnClear="ClearHistoryAsync"
                           SortOptions="_historySortOptions" Sort="@(_historySort)" DefaultSort="acted:desc" SortChanged="OnHistorySortChangedAsync">
                <div class="admin-filter">
                    <label class="form-label">نوع درخواست</label>
                    <LookupSelect @key="_historyResetKey" Options="_typeOptions" Value="@(_dHistoryType?.ToString())" ValueChanged="k => _dHistoryType = Enum.TryParse<WorkflowTypeCode>(k, out var t) ? t : null" Placeholder="همه انواع" />
                </div>
                <div class="admin-filter">
                    <label class="form-label">نتیجه</label>
                    <LookupSelect @key="_historyResetKey" Options="_outcomeOptions" Value="@(_dHistoryStatus?.ToString())" ValueChanged="k => _dHistoryStatus = Enum.TryParse<WorkflowStepStatus>(k, out var o) ? o : null" Placeholder="همه نتایج" />
                </div>
                <div class="admin-filter"><label class="form-label">از تاریخ</label><PersianDatePicker @key="_historyResetKey" Value="_dHistoryFrom" ValueChanged="d => _dHistoryFrom = d" Placeholder="تاریخ شروع" /></div>
                <div class="admin-filter"><label class="form-label">تا تاریخ</label><PersianDatePicker @key="_historyResetKey" Value="_dHistoryTo" ValueChanged="d => _dHistoryTo = d" Placeholder="تاریخ پایان" /></div>
            </ListFilterBar>

            @if (_historyLoading)
            {
                <section class="card"><LoadingState /></section>
            }
            else if (_historyItems.Count == 0)
            {
                <section class="card"><div class="empty-state"><i class="ti @Icons.History"></i><strong>موردی یافت نشد</strong><span>با این فیلترها هنوز تصمیمی ثبت نکرده‌اید.</span></div></section>
            }
            else
            {
                @foreach (var item in _historyItems)
                {
                    var expanded = _expandedHistoryId == item.Decision.Id;
                    <div class="request-card @(expanded ? "is-expanded" : "")">
                        <div class="request-card-header is-clickable" @onclick="() => ToggleHistory(item.Decision.Id)">
                            <span class="request-card-icon"><i class="ti @WorkflowDisplay.IconFor(item.Request.WorkflowType)"></i></span>
                            <span class="request-card-title">
                                <strong>@WorkflowFieldCatalog.GetDisplayName(item.Request.WorkflowType)</strong>
                                <span>از طرف @item.RequesterName · تصمیم شما در «@item.StepName»@(DelegatedLabel(item.Decision)) · @item.Decision.ActedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                            </span>
                            <span class="badge @WorkflowDisplay.StepBadgeClass(item.Decision.Outcome)">@WorkflowDisplay.StepLabel(item.Decision.Outcome, isCurrent: false)</span>
                            @if (CanReopen(item))
                            {
                                <span class="badge badge-warning"><i class="ti @Icons.Reopen"></i> قابل بازگشایی</span>
                            }
                            @if (item.Decision.ReturnTargetOrder is int targetOrder)
                            {
                                var targetName = item.Request.Steps.FirstOrDefault(st => st.Round == item.Decision.Round && st.Order == targetOrder)?.Name;
                                <span class="muted"> ← «@(targetName ?? ("مرحله " + targetOrder))»</span>
                            }
                            <i class="ti @Icons.ChevronDown request-card-chevron"></i>
                        </div>
                        @if (expanded)
                        {
                            <div class="request-card-body">
                                @if (CanReopen(item))
                                {
                                    <div class="force-close-panel">
                                        <p class="muted">این درخواست هنوز ردشده است. اگر رد کردن اشتباه بوده، می‌توانید آن را به مرحله‌ی خودتان برگردانید؛ تأییدهای مراحل قبل حفظ می‌شود و دلیل بازگشایی در تاریخچه ثبت می‌شود.</p>
                                        @if (_reopenOpenFor == item.Request.Id)
                                        {
                                            <input type="text" class="form-control" placeholder="دلیل بازگشایی (الزامی)" maxlength="1000"
                                                   value="@GetReopenReason(item.Request.Id)" @oninput="e => _reopenReasons[item.Request.Id] = e.Value?.ToString() ?? string.Empty" />
                                            <div class="force-close-actions">
                                                <button type="button" class="btn btn-primary btn-sm" disabled="@(_reopenBusyId == item.Request.Id || string.IsNullOrWhiteSpace(GetReopenReason(item.Request.Id)))"
                                                        @onclick="() => ReopenOwnAsync(item.Request.Id)">
                                                    @if (_reopenBusyId == item.Request.Id)
                                                    {
                                                        <span><i class="ti @Icons.Spinner"></i> در حال ثبت...</span>
                                                    }
                                                    else
                                                    {
                                                        <span>تایید بازگشایی</span>
                                                    }
                                                </button>
                                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _reopenOpenFor = null">انصراف</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-primary btn-sm" @onclick="() => _reopenOpenFor = item.Request.Id"><i class="ti @Icons.Reopen"></i> بازگشایی رد من</button>
                                        }
                                    </div>
                                }
                                <RequestSummary Request="item.Request" EmployeeNames="_employeeNames" HolderNames="_holderNames" HighlightStepId="item.Decision.StepId" />
                            </div>
                        }
                    </div>
                }
                <ServerPagination Page="_historyPage" PageSize="_historyPageSize" TotalCount="_historyTotalCount" Busy="_historyLoading" PageChanged="GoToHistoryPageAsync" PageSizeChanged="OnHistoryPageSizeChangedAsync" />
            }
        }
    }
</div>

@code {
    private enum WorkflowAction { Approve, Reject, ReturnToRequester, ReturnToPreviousStep, ReturnToSpecificStep }

    private sealed record InboxItem(WorkflowRequest Request, WorkflowRequestStep CurrentStep, string RequesterName, bool HasPreviousStep, bool IsDelegated);

    private IReadOnlyList<WorkflowService.ActiveDelegation> _delegations = [];
    // One history row per permanent decision (WorkflowStepDecision), not per step: a step's own
    // ActedBy/ActedAt are wiped by Reopen(), so only the decision log is a reliable history.
    private sealed record HistoryItem(WorkflowRequest Request, WorkflowStepDecision Decision, string StepName, string RequesterName);

    private bool _ready;
    private Guid? _employeeId;

    // ---- taking back my own rejection (Requests.Decision.ReopenOwn) ----
    private bool _canReopenOwn;
    private Guid? _reopenOpenFor, _reopenBusyId;
    private readonly Dictionary<Guid, string> _reopenReasons = [];
    private string GetReopenReason(Guid requestId) => _reopenReasons.TryGetValue(requestId, out var r) ? r : string.Empty;

    private bool CanReopen(HistoryItem item) =>
        _canReopenOwn && _employeeId is Guid me && item.Decision.Outcome == WorkflowStepStatus.Rejected
        && item.Decision.ActedByEmployeeId == me && item.Request.WasRejectedBy(me);

    private async Task ReopenOwnAsync(Guid requestId)
    {
        if (_employeeId is not Guid me || _reopenBusyId is not null) return;
        var reason = GetReopenReason(requestId).Trim();
        if (reason.Length == 0) return;
        _reopenBusyId = requestId;
        try
        {
            // The card is only shown with the permission, but the handler checks it again itself.
            if (!await Permissions.HasPermissionAsync(Perm.RequestsDecisionReopenOwn))
            {
                AppState.AddToast("شما مجوز بازگشایی درخواست ردشده را ندارید.", ToastLevel.Error);
                return;
            }
            await using var db = await DbFactory.CreateDbContextAsync();
            var tracked = await db.WorkflowRequests.Include(x => x.Steps).Include(x => x.StepDecisions).SingleOrDefaultAsync(x => x.Id == requestId);
            if (tracked is null)
            {
                await LoadHistoryAsync();
                return;
            }
            try
            {
                tracked.ReopenOwnRejection(me, reason);
            }
            catch (InvalidOperationException)
            {
                AppState.AddToast("این رد دیگر قابل بازگشایی نیست (بازگشایی یا بسته شده است)؛ فهرست به‌روزرسانی شد.", ToastLevel.Info);
                await LoadHistoryAsync();
                return;
            }
            await NotificationSvc.StageAsync(db, tracked, WorkflowNotificationEvent.Reopened);
            try
            {
                await db.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                AppState.AddToast("وضعیت این درخواست هم‌زمان تغییر کرد؛ فهرست به‌روزرسانی شد.", ToastLevel.Info);
                await LoadHistoryAsync();
                return;
            }
            AppState.AddToast("درخواست بازگشایی شد و دوباره در کارتابل شما قرار گرفت.", ToastLevel.Success);
            AppState.NotifyRequestBadgesChanged();
            _reopenReasons.Remove(requestId);
            _reopenOpenFor = null;
            await LoadHistoryAsync();
        }
        finally { _reopenBusyId = null; }
    }
    private Guid? _approverPositionId;
    private List<InboxItem> _items = [];
    private Dictionary<Guid, string> _employeeNames = [];
    private Dictionary<Guid, string> _holderNames = [];
    private Dictionary<Guid, string> _comments = [];
    private Guid? _actingRequestId;

    private bool _historyMode;
    private bool _historyLoading;
    private List<HistoryItem> _historyItems = [];
    private WorkflowTypeCode? _historyTypeFilter;
    private WorkflowStepStatus? _historyStatusFilter;
    private DateTime? _historyFrom;
    private DateTime? _historyTo;
    private Guid? _expandedHistoryId;

    private readonly WorkflowRequestFilter _pendingFilter = new();
    // The inbox has always listed the oldest request first, so that stays the default.
    private string _pendingSort = "created:asc";
    private string _historySort = "acted:desc";
    private static readonly IReadOnlyList<(string Key, string Text)> _pendingSortOptions =
    [
        SortSelect.Option("created:asc", "قدیمی‌ترین اول"),
        SortSelect.Option("created:desc", "جدیدترین اول"),
        SortSelect.Option("type:asc", "نوع درخواست"),
        SortSelect.Option("requester:asc", "درخواست‌کننده"),
    ];
    private static readonly IReadOnlyList<(string Key, string Text)> _historySortOptions =
    [
        SortSelect.Option("acted:desc", "جدیدترین تصمیم"),
        SortSelect.Option("acted:asc", "قدیمی‌ترین تصمیم"),
        SortSelect.Option("type:asc", "نوع درخواست"),
        SortSelect.Option("outcome:asc", "نتیجه"),
    ];

    private async Task OnPendingSortChangedAsync(string value)
    {
        _pendingSort = value;
        _pendingPage = 1;
        await LoadAsync();
    }

    private async Task OnHistorySortChangedAsync(string value)
    {
        _historySort = value;
        _historyPage = 1;
        await LoadHistoryAsync();
    }
    private int _pendingPage = 1;
    private int _pendingPageSize = 20;
    private int _pendingTotalCount;
    private bool _pendingLoading;

    private int _historyPage = 1;
    private int _historyPageSize = 20;
    private int _historyTotalCount;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var employeeId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var eid) ? (Guid?)eid : null;
        var claimedPositionId = Guid.TryParse(user.FindFirstValue("yas_active_position_id"), out var pid) ? (Guid?)pid : null;

        _employeeId = employeeId;
        _canReopenOwn = await Permissions.HasPermissionAsync(Perm.RequestsDecisionReopenOwn);
        // Re-verified fresh against the database rather than trusted from the cookie claim
        // alone, so a revoked or changed active position immediately loses this inbox.
        _approverPositionId = employeeId is Guid empId && await Workflows.HoldsActivePositionAsync(empId, claimedPositionId)
            ? claimedPositionId
            : null;

        await LoadAsync();
        _ready = true;
    }

    private async Task ShowPending()
    {
        _historyMode = false;
        _pendingPage = 1;
        await LoadAsync();
    }

    private async Task ShowHistory()
    {
        _historyMode = true;
        _historyPage = 1;
        await LoadHistoryAsync();
    }

    private async Task GoToPendingPageAsync(int page)
    {
        _pendingPage = page;
        await LoadAsync();
    }

    private async Task OnPendingFilterChangedAsync()
    {
        _pendingPage = 1;
        await LoadAsync();
    }

    private async Task OnPendingPageSizeChangedAsync(int size)
    {
        _pendingPageSize = size;
        _pendingPage = 1;
        await LoadAsync();
    }

    private async Task GoToHistoryPageAsync(int page)
    {
        _historyPage = page;
        await LoadHistoryAsync();
    }

    private async Task OnHistoryPageSizeChangedAsync(int size)
    {
        _historyPageSize = size;
        _historyPage = 1;
        await LoadHistoryAsync();
    }

    /// <summary>" (به نمایندگی از X)" when the decision was made for another position's holder, empty otherwise.</summary>
    private string DelegatedLabel(WorkflowStepDecision decision)
    {
        if (decision.DelegationId is null)
            return "";
        if (decision.ActedByEmployeeId != _employeeId)
            return _employeeNames.TryGetValue(decision.ActedByEmployeeId, out var delegateName) ? $" (توسط نماینده: {delegateName})" : " (توسط نماینده)";
        return decision.OnBehalfOfEmployeeId is Guid id && _employeeNames.TryGetValue(id, out var name)
            ? $" (به نمایندگی از {name})"
            : " (به‌عنوان جانشین)";
    }

    private void ToggleHistory(Guid stepId) => _expandedHistoryId = _expandedHistoryId == stepId ? null : stepId;

    private async Task LoadAsync()
    {
        if (_approverPositionId is not Guid positionId)
        {
            _items = [];
            _pendingTotalCount = 0;
            return;
        }

        _pendingLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            // Own position's steps plus anything delegated to this employee today (spec §15).
            _delegations = await Workflows.GetActiveDelegationsAsync(_employeeId, DateTime.Now);
            var query = WorkflowService.PendingFor(db, positionId, _delegations).AsNoTracking();
            query = _pendingFilter.Apply(query, db);

            _pendingTotalCount = await query.CountAsync();
            if (_pendingPage > 1 && (_pendingPage - 1) * _pendingPageSize >= _pendingTotalCount)
                _pendingPage = Math.Max(1, (int)Math.Ceiling(_pendingTotalCount / (double)_pendingPageSize));

            var (pendingKey, pendingDesc) = SortSelect.Split(_pendingSort);
            var requests = await WorkflowRequestSort.Apply(query, pendingKey, pendingDesc, db).Include(x => x.Steps)
                .Include(x => x.RequesterActions)
                .Include(x => x.StepDecisions)
                .Include(x => x.FieldChanges)
                .AsSplitQuery()
                .Skip((_pendingPage - 1) * _pendingPageSize)
                .Take(_pendingPageSize)
                .ToListAsync();

            var requesterIds = requests.Select(x => x.RequesterEmployeeId).Distinct().ToList();
            var requesterNames = requesterIds.Count == 0 ? [] : await db.Employees.AsNoTracking().Where(x => requesterIds.Contains(x.Id)).ToDictionaryAsync(x => x.Id, x => x.FullName);

            var actorIds = requests.SelectMany(x => x.Steps).Where(x => x.ActedByEmployeeId is not null).Select(x => x.ActedByEmployeeId!.Value).ToList();
            actorIds.AddRange(requests.SelectMany(x => x.StepDecisions).Select(x => x.ActedByEmployeeId));
            actorIds.AddRange(requests.SelectMany(x => x.StepDecisions).Where(x => x.OnBehalfOfEmployeeId is not null).Select(x => x.OnBehalfOfEmployeeId!.Value));
            actorIds.AddRange(requests.Where(x => x.ForceClosedByEmployeeId is not null).Select(x => x.ForceClosedByEmployeeId!.Value));
            actorIds.AddRange(requesterIds);
            actorIds.AddRange(requests.SelectMany(x => x.RequesterActions).Select(x => x.EmployeeId));
            actorIds = actorIds.Distinct().ToList();
            _employeeNames = actorIds.Count == 0 ? [] : await db.Employees.AsNoTracking().Where(x => actorIds.Contains(x.Id)).ToDictionaryAsync(x => x.Id, x => x.FullName);

            var pendingPositionIds = requests.SelectMany(x => x.Steps).Where(x => x.Status == WorkflowStepStatus.Pending).Select(x => x.ApproverPositionId).Distinct().ToList();
            _holderNames = pendingPositionIds.Count == 0 ? [] : await Workflows.GetCurrentHolderNamesAsync(pendingPositionIds);

            _items = requests.Select(r =>
            {
                // In a parallel group (spec §12.2) several positions wait side by side; show the step this
                // viewer can decide — their own position first, then one they cover by delegation.
                var group = r.CurrentSteps.Where(s => s.Status == WorkflowStepStatus.Pending).ToList();
                var current = group.FirstOrDefault(s => s.ApproverPositionId == positionId)
                              ?? group.FirstOrDefault(s => _delegations.Any(d => d.PositionId == s.ApproverPositionId))
                              ?? r.CurrentSteps.First();
                var hasPrevious = r.Steps.Any(s => s.Round == r.CurrentRound && s.Order < r.CurrentStepOrder);
                var name = requesterNames.TryGetValue(r.RequesterEmployeeId, out var n) ? n : "—";
                return new InboxItem(r, current, name, hasPrevious, current.ApproverPositionId != positionId);
            }).ToList();
        }
        finally { _pendingLoading = false; }
    }

    private async Task LoadHistoryAsync()
    {
        // The history covers the position's own decisions and anything this person decided on behalf of
        // another position (delegation), so delegated work does not disappear from the delegate's record.
        var positionId = _approverPositionId;
        var actorId = _employeeId;
        if (positionId is null && actorId is null)
        {
            _historyItems = [];
            _historyTotalCount = 0;
            return;
        }

        _historyLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // First, find just the matching decisions — cheap, and lets the database do the
            // filtering/ordering/paging/counting. This reads the permanent StepDecisions log,
            // not WorkflowRequestStep: Reopen() wipes a step's ActedBy/ActedAt when a later step
            // sends the request back to it, which used to make that approval vanish from here.
            // Superseded steps never produce a decision, so they can't appear as one either.
            var matchQuery = db.WorkflowStepDecisions.AsNoTracking()
                .Where(d => (positionId != null && d.ApproverPositionId == positionId) || (actorId != null && d.ActedByEmployeeId == actorId))
                .Join(
                    db.WorkflowRequests.AsNoTracking(),
                    d => d.RequestId,
                    r => r.Id,
                    (d, r) => new { DecisionId = d.Id, RequestId = r.Id, r.WorkflowType, d.Outcome, d.ActedAtUtc });

            if (_historyTypeFilter is WorkflowTypeCode typeFilter)
                matchQuery = matchQuery.Where(x => x.WorkflowType == typeFilter);
            if (_historyStatusFilter is WorkflowStepStatus statusFilter)
                matchQuery = matchQuery.Where(x => x.Outcome == statusFilter);
            if (_historyFrom is DateTime from)
                matchQuery = matchQuery.Where(x => x.ActedAtUtc >= from);
            if (_historyTo is DateTime to)
                matchQuery = matchQuery.Where(x => x.ActedAtUtc < to.AddDays(1));

            _historyTotalCount = await matchQuery.CountAsync();
            if (_historyPage > 1 && (_historyPage - 1) * _historyPageSize >= _historyTotalCount)
                _historyPage = Math.Max(1, (int)Math.Ceiling(_historyTotalCount / (double)_historyPageSize));

            var (historyKey, historyDesc) = SortSelect.Split(_historySort);
            var ordered = historyKey switch
            {
                "type" => WorkflowRequestSort.OrderByType(matchQuery, nameof(WorkflowRequest.WorkflowType), historyDesc),
                "outcome" => historyDesc ? matchQuery.OrderByDescending(x => x.Outcome) : matchQuery.OrderBy(x => x.Outcome),
                _ => historyDesc ? matchQuery.OrderByDescending(x => x.ActedAtUtc) : matchQuery.OrderBy(x => x.ActedAtUtc),
            };
            var matches = await ordered.ThenBy(x => x.DecisionId)
                .Skip((_historyPage - 1) * _historyPageSize)
                .Take(_historyPageSize)
                .ToListAsync();

            // Then load the full request (with every step, not just the matched one) for each
            // match, so an expanded card can show the whole picture — every submitted field and
            // the complete approval timeline — not just this one decision in isolation.
            var decisionIds = matches.Select(x => x.DecisionId).ToList();
            var decisionsById = decisionIds.Count == 0
                ? []
                : await db.WorkflowStepDecisions.AsNoTracking().Where(d => decisionIds.Contains(d.Id)).ToDictionaryAsync(d => d.Id);

            var requestIds = matches.Select(x => x.RequestId).Distinct().ToList();
            var requestsById = requestIds.Count == 0
                ? []
                : (await db.WorkflowRequests.AsNoTracking().Include(x => x.Steps).Include(x => x.RequesterActions).Include(x => x.StepDecisions).Include(x => x.FieldChanges).AsSplitQuery().Where(x => requestIds.Contains(x.Id)).ToListAsync())
                    .ToDictionary(x => x.Id);

            var requesterIds = requestsById.Values.Select(x => x.RequesterEmployeeId).Distinct().ToList();
            var requesterNames = requesterIds.Count == 0 ? [] : await db.Employees.AsNoTracking().Where(e => requesterIds.Contains(e.Id)).ToDictionaryAsync(e => e.Id, e => e.FullName);

            var actorIds = requestsById.Values.SelectMany(x => x.Steps).Where(x => x.ActedByEmployeeId is not null).Select(x => x.ActedByEmployeeId!.Value).ToList();
            actorIds.AddRange(requestsById.Values.SelectMany(x => x.StepDecisions).Select(x => x.ActedByEmployeeId));
            actorIds.AddRange(requestsById.Values.SelectMany(x => x.StepDecisions).Where(x => x.OnBehalfOfEmployeeId is not null).Select(x => x.OnBehalfOfEmployeeId!.Value));
            actorIds.AddRange(requestsById.Values.Where(x => x.ForceClosedByEmployeeId is not null).Select(x => x.ForceClosedByEmployeeId!.Value));
            actorIds.AddRange(requestsById.Values.SelectMany(x => x.RequesterActions).Select(x => x.EmployeeId));
            actorIds.AddRange(requesterIds);
            actorIds = actorIds.Distinct().ToList();
            _employeeNames = actorIds.Count == 0 ? [] : await db.Employees.AsNoTracking().Where(e => actorIds.Contains(e.Id)).ToDictionaryAsync(e => e.Id, e => e.FullName);

            var pendingPositionIds = requestsById.Values.SelectMany(x => x.Steps).Where(x => x.Status == WorkflowStepStatus.Pending).Select(x => x.ApproverPositionId).Distinct().ToList();
            _holderNames = pendingPositionIds.Count == 0 ? [] : await Workflows.GetCurrentHolderNamesAsync(pendingPositionIds);

            _historyItems = matches
                .Where(x => requestsById.ContainsKey(x.RequestId) && decisionsById.ContainsKey(x.DecisionId))
                .Select(x =>
                {
                    var request = requestsById[x.RequestId];
                    var decision = decisionsById[x.DecisionId];
                    var step = request.Steps.Single(s => s.Id == decision.StepId);
                    var requesterName = requesterNames.TryGetValue(request.RequesterEmployeeId, out var n) ? n : "—";
                    return new HistoryItem(request, decision, step.Name, requesterName);
                })
                .ToList();
        }
        finally { _historyLoading = false; }
    }

    private static readonly IReadOnlyList<(string Key, string Text)> _typeOptions =
        WorkflowFieldCatalog.AllTypes.Select(t => (t.ToString(), WorkflowFieldCatalog.GetDisplayName(t))).ToList();
    private static readonly IReadOnlyList<(string Key, string Text)> _outcomeOptions =
    [
        (nameof(WorkflowStepStatus.Approved), "تایید شد"),
        (nameof(WorkflowStepStatus.Rejected), "رد شد"),
        (nameof(WorkflowStepStatus.ReturnedToRequester), "بازگشت به درخواست‌کننده"),
        (nameof(WorkflowStepStatus.ReturnedToPreviousStep), "بازگشت به مرحله قبل"),
        (nameof(WorkflowStepStatus.ReturnedToSpecificStep), "بازگشت به مرحله دلخواه"),
    ];

    // The boxes edit the draft (_d…); "جستجو" copies it to the applied filters that LoadHistoryAsync reads.
    private WorkflowTypeCode? _dHistoryType;
    private WorkflowStepStatus? _dHistoryStatus;
    private DateTime? _dHistoryFrom, _dHistoryTo;
    private int _historyResetKey;
    private int HistoryActiveCount => (_historyTypeFilter is null ? 0 : 1) + (_historyStatusFilter is null ? 0 : 1) + (_historyFrom is null ? 0 : 1) + (_historyTo is null ? 0 : 1);

    private async Task SearchHistoryAsync()
    {
        _historyTypeFilter = _dHistoryType;
        _historyStatusFilter = _dHistoryStatus;
        _historyFrom = _dHistoryFrom;
        _historyTo = _dHistoryTo;
        _historyPage = 1;
        await LoadHistoryAsync();
    }

    private async Task ClearHistoryAsync()
    {
        _historyTypeFilter = _dHistoryType = null;
        _historyStatusFilter = _dHistoryStatus = null;
        _historyFrom = _dHistoryFrom = null;
        _historyTo = _dHistoryTo = null;
        _historyResetKey++;
        _historyPage = 1;
        await LoadHistoryAsync();
    }

    private static string ToPersianDigits(string value)
    {
        const string digits = "۰۱۲۳۴۵۶۷۸۹";
        var chars = value.Select(c => c is >= '0' and <= '9' ? digits[c - '0'] : c).ToArray();
        return new string(chars);
    }

    private static string PermissionFor(WorkflowAction action) => action switch
    {
        WorkflowAction.Approve => Perm.RequestsDecisionApprove,
        WorkflowAction.Reject => Perm.RequestsDecisionReject,
        WorkflowAction.ReturnToRequester => Perm.RequestsDecisionReturnToRequester,
        WorkflowAction.ReturnToPreviousStep => Perm.RequestsDecisionReturnToPreviousStep,
        WorkflowAction.ReturnToSpecificStep => Perm.RequestsDecisionReturnToSpecificStep,
        _ => throw new ArgumentOutOfRangeException(nameof(action), action, null),
    };

    // The values an approver is typing into the form part their step owns, per request. Seeded from what is
    // already stored (a step that was returned to sees what it filled the last time) and dropped once acted on.
    private Dictionary<Guid, Dictionary<string, string?>> _partValues = [];

    private Dictionary<string, string?> GetPartValues(InboxItem item)
    {
        if (_partValues.TryGetValue(item.Request.Id, out var existing))
            return existing;

        var seeded = new Dictionary<string, string?>(StringComparer.Ordinal);
        var part = WorkflowFieldCatalog.GetStepPart(item.Request.WorkflowType, item.CurrentStep.FillsPart);
        if (part is not null)
        {
            Dictionary<string, string?>? stored = null;
            try { stored = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string?>>(item.Request.FieldValuesJson); }
            catch (System.Text.Json.JsonException) { }
            foreach (var field in WorkflowFieldCatalog.GetFields(item.Request.WorkflowType, part.Part))
                if (stored is not null && stored.TryGetValue(field.Key, out var value))
                    seeded[field.Key] = value;
        }
        _partValues[item.Request.Id] = seeded;
        return seeded;
    }

    private Dictionary<Guid, int> _returnTargets = [];
    private int GetReturnTarget(Guid requestId) => _returnTargets.TryGetValue(requestId, out var t) ? t : 0;
    private void SetReturnTarget(Guid requestId, ChangeEventArgs e) => _returnTargets[requestId] = int.TryParse(e.Value?.ToString(), out var t) ? t : 0;

    private string GetComment(Guid requestId) => _comments.TryGetValue(requestId, out var c) ? c : "";
    private void SetComment(Guid requestId, ChangeEventArgs e) => _comments[requestId] = e.Value?.ToString() ?? "";

    private async Task Act(InboxItem item, WorkflowAction action)
    {
        if (_employeeId is not Guid employeeId || _approverPositionId is not Guid positionId)
            return;

        _actingRequestId = item.Request.Id;
        await InvokeAsync(StateHasChanged);
        try
        {
            // Re-verify authority right before acting, not just at page load — a position
            // reassignment mid-session must not let a stale claim approve anything.
            if (!await Workflows.HoldsActivePositionAsync(employeeId, positionId))
            {
                AppState.AddToast("سمت فعال شما دیگر معتبر نیست. صفحه را دوباره بارگذاری کنید.", ToastLevel.Error);
                return;
            }

            // The buttons are only hidden by <AuthorizeView>; enforce the matching permission here
            // too (spec §26.1/§26.4), so this handler never relies on the markup alone.
            if (!await Permissions.HasPermissionAsync(PermissionFor(action)))
            {
                AppState.AddToast("شما مجوز انجام این عملیات را ندارید.", ToastLevel.Error);
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var request = await db.WorkflowRequests.Include(x => x.Steps).SingleOrDefaultAsync(x => x.Id == item.Request.Id);
            if (request is null || request.Status != WorkflowRequestStatus.PendingApproval)
            {
                AppState.AddToast("این درخواست دیگر در این وضعیت نیست؛ فهرست به‌روزرسانی شد.", ToastLevel.Info);
                await LoadAsync();
                return;
            }

            // Either a step of the live group is at the acting employee's own position, or a delegation
            // covers one (spec §15.1/§15.2) — re-checked now, not trusted from when the page loaded.
            // A parallel group has several waiting steps; the actor decides only the one that is theirs.
            var stepOrderBefore = request.CurrentStepOrder;
            WorkflowRequestStep? currentStep = null;
            var acting = WorkflowService.ActingResult.Denied;
            foreach (var candidate in request.CurrentSteps.Where(x => x.Status == WorkflowStepStatus.Pending))
            {
                var result = await Workflows.ResolveActingAsync(employeeId, positionId, candidate, DateTime.Now);
                if (!result.Allowed)
                    continue;
                currentStep = candidate;
                acting = result;
                break;
            }
            if (currentStep is null)
            {
                AppState.AddToast("این مرحله دیگر به سمت شما ارجاع نشده است؛ فهرست به‌روزرسانی شد.", ToastLevel.Info);
                await LoadAsync();
                return;
            }

            // Approving a step that owns a form part needs that part filled in and valid (spec §26.1 — checked
            // on the server, naming the field and the reason). Reject and the return actions do not need it.
            IReadOnlyDictionary<string, string?>? partValues = null;
            if (action == WorkflowAction.Approve && WorkflowFieldCatalog.GetStepPart(request.WorkflowType, currentStep.FillsPart) is { } ownedPart)
            {
                var typed = GetPartValues(item);
                var partErrors = WorkflowFieldCatalog.ValidatePartValues(request.WorkflowType, ownedPart.Part, typed);
                if (partErrors.Count > 0)
                {
                    AppState.AddToast(string.Join(" ", partErrors.Select(e => $"{e.Label}: {e.Message}")), ToastLevel.Error);
                    return;
                }
                partValues = typed;
            }

            var comment = GetComment(item.Request.Id);
            try
            {
                switch (action)
                {
                    case WorkflowAction.Approve: request.Approve(currentStep.Id, employeeId, comment, acting.Authority, partValues); break;
                    case WorkflowAction.Reject: request.Reject(currentStep.Id, employeeId, comment, acting.Authority); break;
                    case WorkflowAction.ReturnToRequester: request.ReturnToRequester(currentStep.Id, employeeId, comment, acting.Authority); break;
                    case WorkflowAction.ReturnToPreviousStep: request.ReturnToPreviousStep(currentStep.Id, employeeId, comment, acting.Authority); break;
                    case WorkflowAction.ReturnToSpecificStep: request.ReturnToSpecificStep(currentStep.Id, employeeId, GetReturnTarget(item.Request.Id), comment, acting.Authority); break;
                }
            }
            catch (InvalidOperationException)
            {
                // Domain rules are English and internal; the user gets a Persian message instead.
                AppState.AddToast("این درخواست دیگر در وضعیتی نیست که بتوان درباره آن تصمیم گرفت؛ فهرست به‌روزرسانی شد.", ToastLevel.Info);
                await LoadAsync();
                return;
            }

            await NotificationSvc.StageAsync(db, request, action switch
            {
                WorkflowAction.Approve => WorkflowNotificationEvent.StepApproved,
                WorkflowAction.Reject => WorkflowNotificationEvent.Rejected,
                WorkflowAction.ReturnToRequester => WorkflowNotificationEvent.ReturnedToRequester,
                _ => WorkflowNotificationEvent.ReturnedToPreviousStep,
            }, stepOrderBefore);

            try
            {
                await db.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                // Someone else (or another tab) decided on this request between our read and write.
                AppState.AddToast("این درخواست هم‌زمان توسط شخص دیگری تغییر کرد و تصمیم شما ثبت نشد؛ فهرست به‌روزرسانی شد.", ToastLevel.Info);
                AppState.NotifyRequestBadgesChanged();
                await LoadAsync();
                return;
            }
            _comments.Remove(item.Request.Id);
            _returnTargets.Remove(item.Request.Id);
            _partValues.Remove(item.Request.Id);
            AppState.AddToast("ثبت شد.", ToastLevel.Success);
            AppState.NotifyRequestBadgesChanged();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            // Never let an unexpected failure here leave the buttons stuck on "در حال
            // ثبت..." forever — surface it and let the finally block below reset the UI.
            AppState.AddToast($"ثبت تصمیم با خطا مواجه شد: {ex.Message}", ToastLevel.Error);
        }
        finally
        {
            _actingRequestId = null;
        }
    }
}
