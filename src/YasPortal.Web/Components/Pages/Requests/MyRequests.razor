@page "/requests/mine"
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Domain.Workflows
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize(Policy = "Requests.View")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject WorkflowService Workflows
@inject AppState AppState
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>درخواست‌های من - یاس پورتال</PageTitle>

<div class="requests-page" dir="rtl">
    <div class="page-header">
        <div>
            <div class="page-kicker">درخواست‌ها و گردش‌کار</div>
            <h1 class="page-title"><i class="bx bx-list-check"></i> درخواست‌های من</h1>
            <p class="page-subtitle">وضعیت و روند تایید درخواست‌های ثبت‌شده توسط شما.</p>
        </div>
        <div class="form-actions">
            <button class="btn btn-secondary" disabled="@(_unseenCount == 0)" @onclick="MarkAllSeenAsync"><i class="bx bx-check-double"></i> خواندن همه@(_unseenCount > 0 ? $" ({ToPersianDigits(_unseenCount.ToString())})" : "")</button>
            <a class="btn btn-primary" href="/requests/new"><i class="bx bx-plus-circle"></i> درخواست جدید</a>
        </div>
    </div>

    @if (_loading)
    {
        <section class="card"><div class="empty-state"><i class="bx bx-loader-alt bx-spin"></i> در حال بارگذاری...</div></section>
    }
    else if (_requests.Count == 0)
    {
        <section class="card">
            <div class="empty-state">
                <i class="bx bx-inbox"></i><strong>هنوز درخواستی ثبت نکرده‌اید</strong>
                <span>هر وقت آماده بودید، اولین درخواست خود را ثبت کنید.</span>
                <a class="btn btn-primary" href="/requests/new" style="margin-top:14px"><i class="bx bx-plus-circle"></i> ثبت درخواست جدید</a>
            </div>
        </section>
    }
    else
    {
        @foreach (var request in _requests)
        {
            var expanded = _expandedId == request.Id;
            <div class="request-card @(expanded ? "is-expanded" : "")">
                <div class="request-card-header is-clickable" @onclick="() => Toggle(request.Id)">
                    <span class="request-card-icon"><i class="bx @WorkflowDisplay.IconFor(request.WorkflowType)"></i></span>
                    <span class="request-card-title">
                        <strong>@WorkflowFieldCatalog.GetDisplayName(request.WorkflowType)</strong>
                        <span>ثبت‌شده در @request.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                    </span>
                    @if (!request.RequesterHasSeenLatestUpdate)
                    {
                        <span class="badge badge-info">جدید</span>
                    }
                    <span class="badge @WorkflowDisplay.StatusBadgeClass(request.Status)">@WorkflowDisplay.StatusLabel(request.Status)</span>
                    <i class="bx bx-chevron-down request-card-chevron"></i>
                </div>

                @if (expanded)
                {
                    <div class="request-card-body">
                        <RequestSummary Request="request" EmployeeNames="_employeeNames" HolderNames="_holderNames" />

                        @if (request.Status == WorkflowRequestStatus.ReturnedToRequester && _editValues.TryGetValue(request.Id, out var editValues))
                        {
                            <div class="resubmit-panel">
                                <h3 class="section-title" style="font-size:12.5px;margin:0 0 8px">این درخواست به شما بازگشته — پس از اصلاح، دوباره ارسال کنید</h3>
                                <WorkflowFieldsForm Type="request.WorkflowType" Values="editValues" />
                                <div class="form-actions">
                                    <button class="btn btn-primary" disabled="@(_resubmittingId == request.Id)" @onclick="() => ResubmitAsync(request.Id)">
                                        @if (_resubmittingId == request.Id)
                                        {
                                            <i class="bx bx-loader-alt bx-spin"></i>
                                            <span>در حال ارسال...</span>
                                        }
                                        else
                                        {
                                            <i class="bx bx-send"></i>
                                            <span>ارسال مجدد</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        }

                        @if (request.CanBeCancelled)
                        {
                            <div class="form-actions" style="margin-top:14px">
                                <button class="btn btn-danger" disabled="@(_cancellingId == request.Id)" @onclick="() => CancelAsync(request.Id)">
                                    @if (_cancellingId == request.Id)
                                    {
                                        <i class="bx bx-loader-alt bx-spin"></i>
                                        <span>در حال لغو...</span>
                                    }
                                    else
                                    {
                                        <i class="bx bx-x-circle"></i>
                                        <span>لغو درخواست</span>
                                    }
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        <ServerPagination Page="_page" PageSize="_pageSize" TotalCount="_totalCount" Busy="_loading" PageChanged="GoToPageAsync" PageSizeChanged="OnPageSizeChangedAsync" />
    }
</div>

@code {
    private bool _loading = true;
    private Guid? _employeeId;
    private List<WorkflowRequest> _requests = [];
    private Dictionary<Guid, string> _employeeNames = [];
    private Dictionary<Guid, string> _holderNames = [];
    private Dictionary<Guid, Dictionary<string, string?>> _editValues = [];
    private Guid? _expandedId;
    private Guid? _resubmittingId;
    private Guid? _cancellingId;
    private int _page = 1;
    private int _pageSize = 20;
    private int _totalCount;
    private int _unseenCount;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _employeeId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var eid) ? eid : null;
        await LoadAsync();

        if (_requests.Count > 0)
            _expandedId = _requests[0].Id;
    }

    private async Task GoToPageAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task OnPageSizeChangedAsync(int size)
    {
        _pageSize = size;
        _page = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            if (_employeeId is not Guid employeeId)
                return;

            await using var db = await DbFactory.CreateDbContextAsync();
            var query = db.WorkflowRequests.AsNoTracking().Where(x => x.RequesterEmployeeId == employeeId);

            _totalCount = await query.CountAsync();
            if (_page > 1 && (_page - 1) * _pageSize >= _totalCount)
                _page = Math.Max(1, (int)Math.Ceiling(_totalCount / (double)_pageSize));

            _requests = await query.Include(x => x.Steps)
                .OrderByDescending(x => x.CreatedAtUtc)
                .Skip((_page - 1) * _pageSize)
                .Take(_pageSize)
                .ToListAsync();

            var actorIds = _requests.SelectMany(x => x.Steps).Where(x => x.ActedByEmployeeId is not null).Select(x => x.ActedByEmployeeId!.Value).Distinct().ToList();
            _employeeNames = actorIds.Count == 0 ? [] : await db.Employees.AsNoTracking().Where(x => actorIds.Contains(x.Id)).ToDictionaryAsync(x => x.Id, x => x.FullName);

            var pendingPositionIds = _requests.SelectMany(x => x.Steps).Where(x => x.Status == WorkflowStepStatus.Pending).Select(x => x.ApproverPositionId).Distinct().ToList();
            _holderNames = pendingPositionIds.Count == 0 ? [] : await Workflows.GetCurrentHolderNamesAsync(pendingPositionIds);

            _editValues = _requests.Where(x => x.Status == WorkflowRequestStatus.ReturnedToRequester)
                .ToDictionary(x => x.Id, x => ParseFieldValues(x.FieldValuesJson));

            _unseenCount = await Workflows.CountUnseenForRequesterAsync(employeeId);
        }
        finally { _loading = false; }
    }

    private async Task Toggle(Guid id)
    {
        _expandedId = _expandedId == id ? null : id;
        if (_expandedId != id)
            return;

        var request = _requests.FirstOrDefault(x => x.Id == id);
        if (request is null || request.RequesterHasSeenLatestUpdate)
            return;

        request.MarkSeenByRequester();
        await using var db = await DbFactory.CreateDbContextAsync();
        var tracked = await db.WorkflowRequests.FindAsync(id);
        if (tracked is not null)
        {
            tracked.MarkSeenByRequester();
            await db.SaveChangesAsync();
            _unseenCount = Math.Max(0, _unseenCount - 1);
            AppState.NotifyRequestBadgesChanged();
        }
    }

    private async Task MarkAllSeenAsync()
    {
        if (_employeeId is not Guid employeeId || _unseenCount == 0)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        // Marks every unseen request for this employee, not just the ones on the current
        // page — "mark all" has to mean all, especially once results are paginated.
        var unseen = await db.WorkflowRequests.Where(x => x.RequesterEmployeeId == employeeId && !x.RequesterHasSeenLatestUpdate).ToListAsync();
        foreach (var request in unseen)
            request.MarkSeenByRequester();
        await db.SaveChangesAsync();

        foreach (var request in _requests)
            request.MarkSeenByRequester();

        AppState.AddToast("همه درخواست‌ها به‌عنوان دیده‌شده علامت خوردند.", ToastLevel.Success);
        AppState.NotifyRequestBadgesChanged();
        _unseenCount = 0;
    }

    private async Task ResubmitAsync(Guid requestId)
    {
        if (!_editValues.TryGetValue(requestId, out var values))
            return;
        var summary = _requests.FirstOrDefault(x => x.Id == requestId);
        if (summary is null)
            return;

        var missing = WorkflowFieldCatalog.ValidateRequiredFields(summary.WorkflowType, values);
        if (missing.Count > 0)
        {
            AppState.AddToast($"تکمیل این فیلدها الزامی است: {string.Join("، ", missing)}", ToastLevel.Error);
            return;
        }

        _resubmittingId = requestId;
        await InvokeAsync(StateHasChanged);
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var tracked = await db.WorkflowRequests.Include(x => x.Steps).SingleOrDefaultAsync(x => x.Id == requestId);
            if (tracked is null || tracked.Status != WorkflowRequestStatus.ReturnedToRequester)
            {
                AppState.AddToast("این درخواست دیگر در وضعیت بازگشتی نیست؛ فهرست به‌روزرسانی شد.", ToastLevel.Info);
                await LoadAsync();
                return;
            }

            // Resolved fresh, not reused from the original round — the org hierarchy or a
            // fixed position's current holder may have changed since the first submission.
            var resolved = await Workflows.ResolveStepsAsync(tracked.WorkflowType, tracked.RequesterPositionId);
            if (!resolved.Success)
            {
                AppState.AddToast(resolved.Error!, ToastLevel.Error);
                return;
            }

            tracked.Resubmit(
                JsonSerializer.Serialize(values),
                resolved.Steps.Select(s => (s.StepDefinitionId, s.Order, s.Name, s.ApproverPositionId)).ToList());
            await db.SaveChangesAsync();

            AppState.AddToast("درخواست شما دوباره ارسال شد.", ToastLevel.Success);
            AppState.NotifyRequestBadgesChanged();
            await LoadAsync();
            _expandedId = requestId;
        }
        finally { _resubmittingId = null; }
    }

    private async Task CancelAsync(Guid requestId)
    {
        _cancellingId = requestId;
        await InvokeAsync(StateHasChanged);
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var tracked = await db.WorkflowRequests.SingleOrDefaultAsync(x => x.Id == requestId);
            if (tracked is null)
            {
                await LoadAsync();
                return;
            }

            try
            {
                tracked.Cancel();
            }
            catch (InvalidOperationException ex)
            {
                AppState.AddToast(ex.Message, ToastLevel.Error);
                await LoadAsync();
                return;
            }

            await db.SaveChangesAsync();
            AppState.AddToast("درخواست لغو شد.", ToastLevel.Success);
            AppState.NotifyRequestBadgesChanged();
            await LoadAsync();
        }
        finally { _cancellingId = null; }
    }

    private static Dictionary<string, string?> ParseFieldValues(string json)
    {
        try
        {
            return JsonSerializer.Deserialize<Dictionary<string, string?>>(json) ?? [];
        }
        catch (JsonException) { return []; }
    }

    private static string ToPersianDigits(string value)
    {
        const string digits = "۰۱۲۳۴۵۶۷۸۹";
        var chars = value.Select(c => c is >= '0' and <= '9' ? digits[c - '0'] : c).ToArray();
        return new string(chars);
    }
}
