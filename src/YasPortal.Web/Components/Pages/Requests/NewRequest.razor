@page "/requests/new"
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Domain.Workflows
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize(Policy = Perm.RequestsOwnCreate)]
@attribute [Authorize(Policy = "NonAdmin")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject WorkflowService Workflows
@inject NotificationService NotificationSvc
@inject AppState AppState
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

@* New request page: an employee picks a kind of request (leave, purchase and so on), fills in its form and submits it. *@
@* The approval path is worked out from the position they are acting in. Administrators cannot use this page; *@
@* they register requests for others from the administration area instead. *@
<PageTitle>درخواست جدید - یاس پورتال</PageTitle>

<div class="requests-page" dir="rtl">
    <SectionTabs Group="my-requests" />
    <div class="page-header">
        <div>
            <div class="page-kicker">درخواست‌ها و گردش‌کار</div>
            <h1 class="page-title"><i class="ti @Icons.NewRequest"></i> درخواست جدید</h1>
            <p class="page-subtitle">نوع درخواست را انتخاب کنید و فرم مربوطه را تکمیل نمایید.</p>
        </div>
        <div class="form-actions">
            <a class="btn btn-secondary" href="/requests/mine"><i class="ti @Icons.MyRequests"></i> درخواست‌های من</a>
        </div>
    </div>

    @* Cases: still checking the position, no valid active position (so no request can be sent), or the normal form. *@
    @if (!_ready)
    {
        <section class="card"><LoadingState Text="در حال بررسی سمت فعال..." /></section>
    }
    else if (_requesterPositionId is null)
    {
        @* Step 1: choose the type of request. Changing the type clears the form. *@
        <section class="card">
            <div class="empty-state"><i class="ti @Icons.Alert"></i><strong>سمت فعالی برای شما یافت نشد</strong><span>برای ثبت درخواست باید یک سمت فعال معتبر داشته باشید.</span></div>
        </section>
    }
    else
    {
        <section class="card">
            <h2 class="section-title">نوع درخواست</h2>
            <div class="request-type-grid">
                @foreach (var type in WorkflowFieldCatalog.CreatableTypes)
                {
                    <div class="request-type-card @(type == _selectedType ? "is-selected" : "")" @onclick="() => SelectType(type)">
                        <span class="request-type-card-icon"><i class="ti @WorkflowDisplay.IconFor(type)"></i></span>
                        <span>@WorkflowFieldCatalog.GetDisplayName(type)</span>
                    </div>
                }
            </div>
        </section>

        @* Step 2: the form fields for the chosen type, optional attachments for types that allow them, and the submit button. *@
        <section class="card request-form-card">
            <h2 class="section-title">جزئیات @WorkflowFieldCatalog.GetDisplayName(_selectedType)</h2>

            <WorkflowFieldsForm Type="_selectedType" Values="_values" />
            @if (WorkflowFieldCatalog.SupportsAttachments(_selectedType))
            {
                <RequestAttachmentPicker Files="_files" />
            }

            <div class="form-actions">
                <button class="btn btn-primary" disabled="@_submitting" @onclick="Submit">
                    @* The button shows a progress state while saving, so a second click cannot send a duplicate request. *@
                    @if (_submitting)
                    {
                        <i class="ti @Icons.Spinner"></i>
                        <span>در حال ثبت...</span>
                    }
                    else
                    {
                        <i class="ti @Icons.Send"></i>
                        <span>ثبت درخواست</span>
                    }
                </button>
            </div>
        </section>
    }
</div>

@code {
    private bool _ready;
    private Guid? _requesterEmployeeId;
    private Guid? _requesterPositionId;
    private WorkflowTypeCode _selectedType = WorkflowFieldCatalog.AllTypes[0];
    private Dictionary<string, string?> _values = [];
    private List<PendingAttachment> _files = [];
    private bool _submitting;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var employeeId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var eid) ? (Guid?)eid : null;
        var claimedPositionId = Guid.TryParse(user.FindFirstValue("yas_active_position_id"), out var pid) ? (Guid?)pid : null;

        _requesterEmployeeId = employeeId;
        // Re-verified fresh against the database rather than trusted from the cookie claim
        // alone, so a revoked or changed active position can never be used to submit a request.
        _requesterPositionId = employeeId is Guid empId && await Workflows.HoldsActivePositionAsync(empId, claimedPositionId)
            ? claimedPositionId
            : null;
        _ready = true;
    }

    private void SelectType(WorkflowTypeCode type)
    {
        _selectedType = type;
        _values = [];
        _files = [];
    }

    // Order of work: validate the form, build the approval path from the requester's position (refused if no valid path exists),
    // then save the request together with its attachments and the "waiting for you" notifications, and go to "my requests".
    private async Task Submit()
    {
        if (_requesterEmployeeId is not Guid employeeId || _requesterPositionId is not Guid positionId)
            return;

        // A second click while the first submission is still awaiting would otherwise create a duplicate request.
        if (_submitting)
            return;

        var errors = WorkflowFieldCatalog.ValidateValues(_selectedType, _values);
        if (errors.Count > 0)
        {
            AppState.AddToast(string.Join(" ", errors.Select(e => $"{e.Label}: {e.Message}")), ToastLevel.Error);
            return;
        }

        _submitting = true;
        try
        {
            var resolved = await Workflows.ResolveStepsAsync(_selectedType, positionId);
            if (!resolved.Success)
            {
                AppState.AddToast(resolved.Error!, ToastLevel.Error);
                return;
            }

            var fieldValuesJson = JsonSerializer.Serialize(_values);
            var request = new WorkflowRequest(
                _selectedType,
                employeeId,
                positionId,
                fieldValuesJson,
                resolved.Steps.Select(s => s.ToDomain()).ToList());

            await using var db = await DbFactory.CreateDbContextAsync();
            db.WorkflowRequests.Add(request);
            if (WorkflowFieldCatalog.SupportsAttachments(_selectedType))
                RequestAttachmentService.Stage(db, request.Id, employeeId, _files);
            await NotificationSvc.StageAsync(db, request, WorkflowNotificationEvent.Submitted);
            await db.SaveChangesAsync();

            AppState.AddToast("درخواست شما با موفقیت ثبت شد.", ToastLevel.Success);
            Navigation.NavigateTo("/requests/mine");
        }
        finally { _submitting = false; }
    }
}
