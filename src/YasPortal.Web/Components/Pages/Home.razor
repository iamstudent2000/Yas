@page "/"
@page "/home"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using YasPortal.Domain.Landing
@using YasPortal.Domain.Gallery
@using YasPortal.Infrastructure.Gallery
@using YasPortal.Infrastructure.Guides
@using YasPortal.Infrastructure.Landing
@using System.Security.Claims
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@implements IDisposable
@inject LandingContent Content
@inject HomeSlideProvider SlideProvider
@inject PortalLinkProvider LinkProvider
@inject HomeTileProvider TileProvider
@inject GuideProvider GuideProv
@inject GalleryProvider GalleryProv
@inject WorkflowService Workflows
@inject NotificationService NotificationsService
@inject AuthenticationStateProvider AuthState
@inject IAuthorizationService AuthzService
@inject NavigationManager Navigation
@* The public front page: open to everyone (texts from LandingContent, the links and slides, and a short preview of the guides and the gallery). The only sign-in button is the one in the top bar. At "/" a signed-in person is
   sent on to the dashboard (or, without that permission, sees a short welcome); "/home" shows this page to everyone, signed in or not
   (the sidebar's "صفحه اصلی" link). The personal sidebar appears only after sign-in. The search box is not here: it lives in the top bar (TopBarSearch). *@

<PageTitle>یاس پورتال</PageTitle>

@* Three views: nothing until loading is done; a short welcome (signed-in person at the root address without a dashboard); *@
@* or the full landing page with link menu, quick links, personal buttons, tiles, previews and the last section of up to four tiles. The general information cards are paused (see ShowInfo in the code part). *@
@if (!_ready)
{
    @* nothing until the first load has finished: the component is drawn once before OnInitializedAsync completes *@
}
else if (!_showLanding)
{
    <div class="card">
        <h1>خوش آمدید</h1>
        <p>به یاس پورتال خوش آمدید. از منوی کناری بخش مورد نظر خود را انتخاب کنید.</p>
    </div>
}
else
{
    <div class="landing" dir="rtl">
        @* Rotating slides (introduction banners written by an administrator); optional buttons link to a page or a downloadable file. *@
        @* The banner is the first thing under the top bar and always has the same height. The slides stop turning while the mouse is over them, so a text can be read in peace. *@
        @if (_slides.Count > 0)
        {
        <section class="landing-hero" aria-roledescription="carousel" aria-label="معرفی سامانه" @onmouseenter="() => _paused = true" @onmouseleave="() => _paused = false">
            @{ var slide = _slides[_index]; }
            <div class="landing-slide" @key="_index">
                <span class="landing-slide-icon"><i class="ti @slide.Icon"></i></span>
                <div class="landing-slide-body">
                    <h1>@slide.Title</h1>
                    <p>@slide.Text</p>
                    <div class="landing-slide-actions">
                        @if (!string.IsNullOrWhiteSpace(slide.LinkText) && !string.IsNullOrWhiteSpace(slide.LinkUrl) && slide.LinkUrl != "/login")
                        {
                            <a class="btn btn-secondary" href="@slide.LinkUrl">@slide.LinkText</a>
                        }
                        @if (slide.FileSlideId is Guid fileId)
                        {
                            <a class="btn btn-secondary" href="/landing/files/@fileId" download="@slide.FileName" target="_blank" rel="noopener"><i class="ti ti-paperclip"></i> @slide.FileName <small dir="ltr">(@FileSizeText(slide.FileSize))</small></a>
                        }
                    </div>
                </div>
            </div>
            @if (_slides.Count > 1)
            {
                <button type="button" class="landing-nav landing-nav-prev" title="قبلی" aria-label="اسلاید قبلی" @onclick="() => Go(_index - 1)"><i class="ti ti-chevron-right"></i></button>
                <button type="button" class="landing-nav landing-nav-next" title="بعدی" aria-label="اسلاید بعدی" @onclick="() => Go(_index + 1)"><i class="ti ti-chevron-left"></i></button>
                <div class="landing-dots">
                    @for (var i = 0; i < _slides.Count; i++)
                    {
                        var target = i;
                        <button type="button" class="landing-dot @(i == _index ? "is-active" : "")" aria-label="@($"اسلاید {i + 1}")" @onclick="() => Go(target)"></button>
                    }
                </div>
            }
        </section>
        }

        @* The link menu and quick-access links are maintained by an administrator in the home page content section. *@
        @if (_tree.Groups.Count > 0 || _tree.Ungrouped.Count > 0)
        {
            <LinkMenuBar Tree="_tree" />
        }

        @if (_tree.QuickAccess.Count > 0)
        {
            <section class="landing-quick" aria-label="دسترسی سریع">
                <div class="landing-quick-links">
                    <span class="landing-quick-title"><i class="ti ti-bolt"></i> دسترسی سریع</span>
                    @foreach (var link in _tree.QuickAccess)
                    {
                        <span class="lm-quick"><LinkMenuEntry Link="link" /></span>
                    }
                </div>
            </section>
        }

        @* For a signed-in person: buttons for their own work (new request, my requests, approvals inbox, notifications) with the number of items *@
        @* waiting. Only the pages the person may open are shown, with the same permission check as the sidebar. *@
        @if (_personal.Count > 0)
        {
            <section class="landing-tiles" aria-label="کارهای من">
                @foreach (var tile in _personal)
                {
                    <a class="landing-tile @(tile.Count > 0 ? "has-count" : "")" href="@tile.Href">
                        <span class="landing-link-icon"><i class="ti @tile.Icon"></i></span>
                        <span><strong>@tile.Label</strong>@if (tile.Count > 0) { <small>@tile.Count مورد منتظر شما</small> }</span>
                        @if (tile.Count > 0) { <span class="landing-count">@tile.Count</span> }
                    </a>
                }
            </section>
        }

        @* A few pictures of the gallery (the first ones in the order the administrators set); a click opens that picture large in the gallery. *@
        @if (_pictures.Count > 0)
        {
            <section class="landing-section">
                <h2 class="landing-heading"><i class="ti @Icons.Gallery"></i> گالری <small class="landing-hint">برای دیدن بزرگ‌تر روی تصویر بزنید</small> <a class="landing-more" href="/gallery">مشاهده همه</a></h2>
                <div class="landing-pictures">
                    @foreach (var picture in _pictures.Take(PicturesShown))
                    {
                        <a class="landing-picture" href="/gallery?open=@picture.Id" title="@picture.Title"><img src="@GalleryImage.UrlFor(picture.Id, picture.Version)" alt="@picture.Title" loading="lazy" decoding="async" /></a>
                    }
                </div>
            </section>
        }

        @* The first guides in their display order, each opening its page. *@
        @if (_guides.Count > 0)
        {
            <section class="landing-section">
                <h2 class="landing-heading"><i class="ti @Icons.Guide"></i> راهنماها <a class="landing-more" href="/guides">مشاهده همه</a></h2>
                <ul class="landing-guides">
                    @foreach (var guide in _guides.Take(GuidesShown))
                    {
                        <li><a href="/guides/@guide.Id"><strong>@guide.Title</strong>@if (!string.IsNullOrWhiteSpace(guide.Summary)) { <small>@guide.Summary</small> }</a></li>
                    }
                </ul>
            </section>
        }

        @* General information cards (paused while ShowInfo is false). *@
        @if (ShowInfo)
        {
        <section class="landing-section">
            <h2 class="landing-heading"><i class="ti ti-info-circle"></i> اطلاعات عمومی</h2>
            <div class="landing-info">
                @foreach (var info in _info)
                {
                    <article class="landing-info-card">
                        <span class="landing-link-icon"><i class="ti @info.Icon"></i></span>
                        <h3>@info.Title</h3>
                        <p>@info.Text</p>
                    </article>
                }
            </div>
        </section>
        }

        @* The last section: up to four tiles, defined by administrators on /admin/links (tab "کاشی‌ها"). A tile opens its address; other websites open in a new tab. *@
        @if (_tiles.Count > 0)
        {
            <section class="landing-section">
                <h2 class="landing-heading"><i class="ti ti-layout-grid"></i> دسترسی‌های ویژه</h2>
                @* One row of up to four tiles of the same height; the icon sits beside the title and the short text is under them. *@
                <div class="landing-big-tiles">
                    @foreach (var tile in _tiles)
                    {
                        var external = PortalLink.IsExternal(tile.Url);
                        <a class="landing-info-card landing-info-link" href="@tile.Url" target="@(external ? "_blank" : null)" rel="@(external ? "noopener noreferrer" : null)">
                            <span class="landing-big-tile-head"><span class="landing-link-icon"><i class="ti @tile.Icon"></i></span><h3>@tile.Title</h3></span>
                            @if (tile.Text is not null) { <p>@tile.Text</p> }
                        </a>
                    }
                </div>
            </section>
        }
    </div>
}

@code {
    // Pause switch: the «اطلاعات عمومی» cards are switched off for now. Set it to true to show them again.
    private const bool ShowInfo = false;
    private bool _ready, _signedIn, _canDashboard, _showLanding = true;
    // True while the mouse is over the slides (they do not turn then).
    private bool _paused;
    // A button of the "my work" row: where it leads, its text, its icon and the number of items waiting (0 = none).
    private sealed record PersonalTile(string Href, string Label, string Icon, int Count);
    private IReadOnlyList<PersonalTile> _personal = [];
    // What the front page shows from the guides and the gallery.
    private IReadOnlyList<GuideListItem> _guides = [];
    private IReadOnlyList<GalleryListItem> _pictures = [];
    // How many guides and pictures are previewed on this page.
    private const int GuidesShown = 5, PicturesShown = 6;
    private int _index;
    private IReadOnlyList<LandingSlide> _slides = [];
    private LinkTree _tree = LinkTree.Build([], []);
    private IReadOnlyList<LandingInfo> _info = [];
    // The tiles of the last section (switched-on ones, in order).
    private IReadOnlyList<HomeTile> _tiles = [];
    private Timer? _timer;

    // Loads the page content once. At the root address a signed-in person is redirected to the dashboard if allowed.
    protected override async Task OnInitializedAsync()
    {
        try { await LoadAsync(); }
        finally { _ready = true; }
    }

    private async Task LoadAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _signedIn = user.Identity?.IsAuthenticated == true;
        if (_signedIn)
        {
            _canDashboard = (await AuthzService.AuthorizeAsync(user, Perm.DashboardPageView)).Succeeded;
            var isRoot = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').Length == 0;
            if (isRoot)
            {
                _showLanding = false;
                if (_canDashboard)
                    Navigation.NavigateTo("/dashboard", replace: true);
                return;
            }
        }
        _guides = await GuideProv.ListAsync(_signedIn);
        if (_signedIn) _personal = await LoadPersonalAsync(user);
        _pictures = await GalleryProv.ListAsync();
        _slides = await SlideProvider.GetSlidesAsync();
        _tree = await LinkProvider.GetTreeAsync();
        _tiles = await TileProvider.ListAsync();
        _info = Content.Info;
    }

    // The "my work" buttons. The pages come from the "requests" and "notifications" sections of the sidebar, so a button appears only when
    // the person may open that page; the counters are the same ones the sidebar shows. A failure to count just shows the buttons without numbers.
    private async Task<IReadOnlyList<PersonalTile>> LoadPersonalAsync(ClaimsPrincipal user)
    {
        var requestTabs = await SectionNav.VisibleAsync(AuthzService, user, SectionNav.MyRequests);
        var notificationTabs = await SectionNav.VisibleAsync(AuthzService, user, SectionNav.Notifications);
        int mine = 0, inbox = 0, unread = 0;
        try
        {
            var employeeId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var eid) ? (Guid?)eid : null;
            var positionId = Guid.TryParse(user.FindFirstValue("yas_active_position_id"), out var pid) ? (Guid?)pid : null;
            mine = await Workflows.CountUnseenForRequesterAsync(employeeId);
            unread = await NotificationsService.CountUnreadAsync(employeeId);
            inbox = await Workflows.CountInboxAsync(employeeId, positionId, DateTime.Now);
        }
        catch
        {
            // Best-effort numbers; the buttons still work without them.
        }
        var tiles = new List<PersonalTile>();
        foreach (var tab in requestTabs)
        {
            switch (tab.Href)
            {
                case "/requests/new": tiles.Add(new(tab.Href, tab.Label, tab.Icon, 0)); break;
                case "/requests/mine": tiles.Add(new(tab.Href, tab.Label, tab.Icon, mine)); break;
                case "/requests/inbox": tiles.Add(new(tab.Href, tab.Label, tab.Icon, inbox)); break;
            }
        }
        if (notificationTabs.FirstOrDefault() is { } notifications)
            tiles.Add(new(notifications.Href, "اعلان‌ها", Icons.Bell, unread));
        return tiles;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Only in the live circuit (not while pre-rendering): the slides turn by themselves every 7 seconds. The timer is started once,
        // as soon as the slides are loaded (the very first drawing happens before they are loaded, so it must not be tied to it).
        if (_timer is null && _showLanding && _slides.Count > 1)
            _timer = new Timer(_ => _ = InvokeAsync(() => { if (!_paused) Go(_index + 1); }), null, TimeSpan.FromSeconds(7), TimeSpan.FromSeconds(7));
    }

    private static string FileSizeText(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024.0 / 1024.0:0.#} MB" : $"{Math.Max(1, bytes / 1024)} KB";

    private void Go(int to)
    {
        _index = ((to % _slides.Count) + _slides.Count) % _slides.Count;
        StateHasChanged();
    }

    public void Dispose() => _timer?.Dispose();
}
