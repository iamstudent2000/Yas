@page "/"
@page "/home"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using YasPortal.Infrastructure.Landing
@implements IDisposable
@inject LandingContent Content
@inject HomeSlideProvider SlideProvider
@inject AuthenticationStateProvider AuthState
@inject IAuthorizationService AuthzService
@inject NavigationManager Navigation
@* The public front page: open to everyone, shows only the texts from LandingContent (no database data). At "/" a signed-in person is
   sent on to the dashboard (or, without that permission, sees a short welcome); "/home" shows this page to everyone, signed in or not
   (the sidebar's "صفحه اصلی" link). The personal sidebar appears only after sign-in. *@

<PageTitle>یاس پورتال</PageTitle>

@if (!_ready)
{
    @* nothing until the first load has finished: the component is drawn once before OnInitializedAsync completes *@
}
else if (!_showLanding)
{
    <div class="card">
        <h1>خوش آمدید</h1>
        <p>به یاس پورتال خوش آمدید. از منوی کناری بخش مورد نظر خود را انتخاب کنید.</p>
    </div>
}
else
{
    <div class="landing" dir="rtl">
        @if (_slides.Count > 0)
        {
        <section class="landing-hero" aria-roledescription="carousel" aria-label="معرفی سامانه">
            @{ var slide = _slides[_index]; }
            <div class="landing-slide" @key="_index">
                <span class="landing-slide-icon"><i class="ti @slide.Icon"></i></span>
                <div class="landing-slide-body">
                    <h1>@slide.Title</h1>
                    <p>@slide.Text</p>
                    <div class="landing-slide-actions">
                        @if (!_signedIn)
                        {
                            <a class="btn btn-primary" href="/login"><i class="ti @Icons.LogIn"></i> ورود به سامانه</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(slide.LinkText) && !string.IsNullOrWhiteSpace(slide.LinkUrl) && slide.LinkUrl != "/login")
                        {
                            <a class="btn btn-secondary" href="@slide.LinkUrl">@slide.LinkText</a>
                        }
                        @if (slide.FileSlideId is Guid fileId)
                        {
                            <a class="btn btn-secondary" href="/landing/files/@fileId" download="@slide.FileName" target="_blank" rel="noopener"><i class="ti ti-paperclip"></i> @slide.FileName <small dir="ltr">(@FileSizeText(slide.FileSize))</small></a>
                        }
                    </div>
                </div>
            </div>
            @if (_slides.Count > 1)
            {
                <button type="button" class="landing-nav landing-nav-prev" title="قبلی" aria-label="اسلاید قبلی" @onclick="() => Go(_index - 1)"><i class="ti ti-chevron-right"></i></button>
                <button type="button" class="landing-nav landing-nav-next" title="بعدی" aria-label="اسلاید بعدی" @onclick="() => Go(_index + 1)"><i class="ti ti-chevron-left"></i></button>
                <div class="landing-dots">
                    @for (var i = 0; i < _slides.Count; i++)
                    {
                        var target = i;
                        <button type="button" class="landing-dot @(i == _index ? "is-active" : "")" aria-label="@($"اسلاید {i + 1}")" @onclick="() => Go(target)"></button>
                    }
                </div>
            }
        </section>
        }

        <section class="landing-section">
            <h2 class="landing-heading"><i class="ti ti-bolt"></i> دسترسی سریع</h2>
            <div class="landing-links">
                @foreach (var link in _links)
                {
                    <a class="landing-link" href="@link.Url">
                        <span class="landing-link-icon"><i class="ti @link.Icon"></i></span>
                        <span><strong>@link.Title</strong>@if (!string.IsNullOrWhiteSpace(link.Hint)) { <small>@link.Hint</small> }</span>
                    </a>
                }
            </div>
        </section>

        <section class="landing-section">
            <h2 class="landing-heading"><i class="ti ti-info-circle"></i> اطلاعات عمومی</h2>
            <div class="landing-info">
                @foreach (var info in _info)
                {
                    <article class="landing-info-card">
                        <span class="landing-link-icon"><i class="ti @info.Icon"></i></span>
                        <h3>@info.Title</h3>
                        <p>@info.Text</p>
                    </article>
                }
            </div>
        </section>

        <section class="landing-cta">
            <div>
                <strong>منوها و امکانات شما پس از ورود نمایش داده می‌شود</strong>
                <span>هر کاربر فقط بخش‌هایی را می‌بیند که مجوز آن‌ها را دارد.</span>
            </div>
            @if (!_signedIn)
            {
                <a class="btn btn-primary" href="/login"><i class="ti @Icons.LogIn"></i> ورود</a>
            }
        </section>
    </div>
}

@code {
    private bool _ready, _signedIn, _canDashboard, _showLanding = true;
    private int _index;
    private IReadOnlyList<LandingSlide> _slides = [];
    private IReadOnlyList<LandingLink> _links = [];
    private IReadOnlyList<LandingInfo> _info = [];
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        try { await LoadAsync(); }
        finally { _ready = true; }
    }

    private async Task LoadAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _signedIn = user.Identity?.IsAuthenticated == true;
        if (_signedIn)
        {
            _canDashboard = (await AuthzService.AuthorizeAsync(user, Perm.DashboardPageView)).Succeeded;
            var isRoot = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').Length == 0;
            if (isRoot)
            {
                _showLanding = false;
                if (_canDashboard)
                    Navigation.NavigateTo("/dashboard", replace: true);
                return;
            }
        }
        _slides = await SlideProvider.GetSlidesAsync();
        _links = Content.QuickLinks;
        _info = Content.Info;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Only in the live circuit (not while pre-rendering): the slides turn by themselves every 7 seconds.
        if (firstRender && _showLanding && _slides.Count > 1)
            _timer = new Timer(_ => _ = InvokeAsync(() => { Go(_index + 1); }), null, TimeSpan.FromSeconds(7), TimeSpan.FromSeconds(7));
    }

    private static string FileSizeText(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024.0 / 1024.0:0.#} MB" : $"{Math.Max(1, bytes / 1024)} KB";

    private void Go(int to)
    {
        _index = ((to % _slides.Count) + _slides.Count) % _slides.Count;
        StateHasChanged();
    }

    public void Dispose() => _timer?.Dispose();
}
