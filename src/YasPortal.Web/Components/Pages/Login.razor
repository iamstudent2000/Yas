@page "/login"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Sign in - YasPortal</PageTitle>

<div class="login-page">
    <h1>YasPortal</h1>
    <h2>Sign in</h2>

    @if (Error)
    {
        <p role="alert">Invalid username or password.</p>
    }

    <form method="post" action="/account/login">
        <AntiforgeryToken />
        <div>
            <label for="username">Username</label>
            <input id="username" name="username" autocomplete="username" required />
        </div>
        <div>
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required />
        </div>
        <button type="submit">Sign in</button>
    </form>

    <p>Development accounts: <code>admin / Admin123!</code> and <code>employee / Employee123!</code>.</p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorValue { get; set; }

    private bool Error => string.Equals(ErrorValue, "1", StringComparison.Ordinal);
}
