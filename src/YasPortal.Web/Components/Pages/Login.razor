@page "/login"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>ورود | یاس پورتال</PageTitle>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="jasmine-bloom" viewBox="0 0 100 100">
        <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
            <ellipse cx="50" cy="23" rx="11" ry="23" />
            <ellipse cx="50" cy="23" rx="11" ry="23" transform="rotate(72 50 50)" />
            <ellipse cx="50" cy="23" rx="11" ry="23" transform="rotate(144 50 50)" />
            <ellipse cx="50" cy="23" rx="11" ry="23" transform="rotate(216 50 50)" />
            <ellipse cx="50" cy="23" rx="11" ry="23" transform="rotate(288 50 50)" />
            <circle cx="50" cy="50" r="6.5" />
        </g>
    </symbol>
</svg>

<div class="login-shell" dir="rtl">
    <main class="login-frame" aria-labelledby="login-title">
        <section class="login-brandpanel" aria-hidden="true">
            <svg class="bloom bloom-a" viewBox="0 0 100 100"><use href="#jasmine-bloom" /></svg>
            <svg class="bloom bloom-b" viewBox="0 0 100 100"><use href="#jasmine-bloom" /></svg>
            <svg class="bloom bloom-c" viewBox="0 0 100 100"><use href="#jasmine-bloom" /></svg>

            <div class="login-brandpanel-body">
                <div class="brandpanel-mark">
                    <svg viewBox="0 0 100 100"><use href="#jasmine-bloom" /></svg>
                </div>
                <div class="brandpanel-text">
                    <div class="brandpanel-name">یاس پورتال</div>
                    <p>سامانه یکپارچه مدیریت سازمان، سمت‌ها و دسترسی‌های کارکنان — در یک بستر واحد.</p>
                </div>
                <ul class="brandpanel-points">
                    <li><i class="bx bx-sitemap"></i> ساختار سازمانی شفاف و قابل پیگیری</li>
                    <li><i class="bx bx-id-card"></i> سمت‌ها و مجوزهای هر کارمند، دقیق و به‌روز</li>
                    <li><i class="bx bx-history"></i> رویدادهای سامانه، همیشه در دسترس</li>
                </ul>
            </div>
        </section>

        <section class="login-formpanel">
            <div class="login-formpanel-inner">
                <div class="login-heading">
                    <h1 id="login-title">خوش آمدید</h1>
                    <p>برای ورود به حساب کاربری خود، اطلاعات زیر را وارد کنید.</p>
                </div>

                @if (NoPositionError)
                {
                    <div class="login-alert login-alert-warning" role="alert">
                        <i class="bx bx-sitemap" aria-hidden="true"></i>
                        <div>
                            <strong>سمت فعالی برای حساب شما ثبت نشده است.</strong>
                            <span>برای ورود، ابتدا باید حداقل یک سمت فعال به شما تخصیص داده شود. لطفاً با مدیر سامانه
                                تماس بگیرید.</span>
                        </div>
                    </div>
                }
                else if (Error)
                {
                    <div class="login-alert" role="alert">
                        <i class="bx bx-error-circle" aria-hidden="true"></i>
                        <span>نام کاربری یا رمز عبور صحیح نیست.</span>
                    </div>
                }

                <form class="login-form" method="post" action="/account/login">
                    <AntiforgeryToken />

                    <div class="field">
                        <label for="username">نام کاربری</label>
                        <div class="input-wrap">
                            <i class="bx bx-user" aria-hidden="true"></i>
                            <input id="username" name="username" autocomplete="username"
                                   placeholder="نام کاربری خود را وارد کنید" required />
                        </div>
                    </div>

                    <div class="field">
                        <label for="password">رمز عبور</label>
                        <div class="input-wrap">
                            <i class="bx bx-lock-alt" aria-hidden="true"></i>
                            <input id="password" name="password" type="password" autocomplete="current-password"
                                   placeholder="رمز عبور خود را وارد کنید" required />
                        </div>
                    </div>

                    <button class="login-button" type="submit">
                        <span>ورود به سامانه</span>
                        <i class="bx bx-left-arrow-alt" aria-hidden="true"></i>
                    </button>
                </form>

                <div class="login-footer">
                    <i class="bx bx-shield-quarter" aria-hidden="true"></i>
                    <span>ورود امن به سامانه یاس پورتال</span>
                </div>

                <details class="development-accounts">
                    <summary>
                        <i class="bx bx-code-alt" aria-hidden="true"></i>
                        <span>حساب‌های توسعه</span>
                        <i class="bx bx-chevron-down summary-chevron" aria-hidden="true"></i>
                    </summary>
                    <div class="account-list">
                        <div class="account-row">
                            <span>مدیر سامانه</span>
                            <code>admin / Admin123!</code>
                        </div>
                        <div class="account-row">
                            <span>کارمند</span>
                            <code>employee / Employee123!</code>
                        </div>
                    </div>
                </details>
            </div>
        </section>
    </main>
</div>

<style>
    .login-shell {
        min-height: 100vh;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 28px;
        background: #eef1f7;
        color: #172033;
        font-family: inherit;
        box-sizing: border-box
    }

    .login-shell * {
        box-sizing: border-box
    }

    .login-frame {
        width: min(100%, 940px);
        display: grid;
        grid-template-columns: 1fr 1.05fr;
        border-radius: 24px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 30px 70px rgba(19, 39, 122, .16);
    }

    /* ---- Brand panel ---- */
    .login-brandpanel {
        position: relative;
        overflow: hidden;
        background: linear-gradient(160deg, #13277a 0%, #1d4ed8 62%, #2f6f4f 130%);
        color: #fff;
        padding: 44px 38px;
        display: flex;
        align-items: flex-end;
        min-height: 460px
    }

    .bloom {
        position: absolute;
        color: rgba(255, 255, 255, .16);
        pointer-events: none
    }

    .bloom-a {
        width: 260px;
        height: 260px;
        top: -70px;
        left: -60px
    }

    .bloom-b {
        width: 150px;
        height: 150px;
        bottom: 40px;
        left: 60%;
        color: rgba(255, 255, 255, .10);
        transform: rotate(28deg)
    }

    .bloom-c {
        width: 110px;
        height: 110px;
        top: 30%;
        right: -30px;
        color: rgba(255, 255, 255, .12);
        transform: rotate(-18deg)
    }

    .login-brandpanel-body {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 18px
    }

    .brandpanel-mark {
        width: 46px;
        height: 46px;
        color: #fff
    }

    .brandpanel-name {
        font-size: 22px;
        font-weight: 800;
        letter-spacing: -.01em
    }

    .brandpanel-text p {
        margin: 8px 0 0;
        max-width: 34ch;
        color: rgba(255, 255, 255, .82);
        font-size: 13px;
        line-height: 1.9
    }

    .brandpanel-points {
        margin: 6px 0 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 10px;
        border-top: 1px solid rgba(255, 255, 255, .18);
        padding-top: 18px
    }

    .brandpanel-points li {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 12.5px;
        color: rgba(255, 255, 255, .9)
    }

    .brandpanel-points i {
        font-size: 17px;
        color: rgba(255, 255, 255, .75)
    }

    /* ---- Form panel ---- */
    .login-formpanel {
        display: flex;
        align-items: center;
        padding: 40px
    }

    .login-formpanel-inner {
        width: 100%;
        max-width: 340px;
        margin: 0 auto
    }

    .login-heading {
        margin-bottom: 22px
    }

    .login-heading h1 {
        margin: 0;
        font-size: 25px;
        line-height: 1.5;
        font-weight: 800;
        color: #162033
    }

    .login-heading p {
        margin: 6px 0 0;
        color: #68758a;
        font-size: 13px;
        line-height: 1.8
    }

    .login-alert {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 18px;
        padding: 10px 12px;
        border: 1px solid #fecaca;
        border-radius: 10px;
        background: #fff5f5;
        color: #b42318;
        font-size: 12px;
        line-height: 1.7
    }

    .login-alert-warning {
        align-items: flex-start;
        border-color: #fed7aa;
        background: #fff8ed;
        color: #9a3412
    }

    .login-alert-warning i {
        margin-top: 2px
    }

    .login-alert-warning div {
        display: grid;
        gap: 2px
    }

    .login-alert-warning strong {
        font-weight: 800
    }

    .login-alert-warning span {
        color: #9a5a22
    }

    .login-alert i {
        font-size: 18px;
        flex: 0 0 auto
    }

    .login-form {
        display: grid;
        gap: 16px
    }

    .field {
        display: grid;
        gap: 7px
    }

    .field label {
        color: #344054;
        font-size: 13px;
        font-weight: 700
    }

    .input-wrap {
        position: relative
    }

    .input-wrap>i {
        position: absolute;
        top: 50%;
        right: 13px;
        transform: translateY(-50%);
        color: #8995a8;
        font-size: 19px;
        pointer-events: none
    }

    .input-wrap input {
        width: 100%;
        height: 46px;
        padding: 0 42px 0 13px;
        border: 1px solid #d9e0ea;
        border-radius: 11px;
        outline: none;
        background: #fff;
        color: #172033;
        font: inherit;
        font-size: 13px;
        transition: border-color .15s ease, box-shadow .15s ease
    }

    .input-wrap input::placeholder {
        color: #a0aaba
    }

    .input-wrap input:focus {
        border-color: #1d4ed8;
        box-shadow: 0 0 0 3px rgba(29, 78, 216, .10)
    }

    .login-button {
        width: 100%;
        height: 46px;
        margin-top: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border: 0;
        border-radius: 11px;
        background: #1d4ed8;
        color: #fff;
        cursor: pointer;
        font: inherit;
        font-size: 13px;
        font-weight: 800;
        transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
        box-shadow: 0 8px 18px rgba(29, 78, 216, .22)
    }

    .login-button:hover {
        background: #1739ad;
        transform: translateY(-1px);
        box-shadow: 0 10px 22px rgba(29, 78, 216, .26)
    }

    .login-button:active {
        transform: translateY(0)
    }

    .login-button i {
        font-size: 19px
    }

    .login-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 20px;
        color: #8490a3;
        font-size: 11px
    }

    .login-footer i {
        font-size: 16px
    }

    .development-accounts {
        margin-top: 20px;
        border-top: 1px solid #edf0f5;
        padding-top: 14px;
        color: #64748b;
        font-size: 11px
    }

    .development-accounts summary {
        display: flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
        list-style: none;
        user-select: none
    }

    .development-accounts summary::-webkit-details-marker {
        display: none
    }

    .development-accounts summary>i:first-child {
        color: #1d4ed8;
        font-size: 16px
    }

    .summary-chevron {
        margin-right: auto;
        transition: transform .15s ease;
        font-size: 16px
    }

    .development-accounts[open] .summary-chevron {
        transform: rotate(180deg)
    }

    .account-list {
        display: grid;
        gap: 7px;
        margin-top: 10px
    }

    .account-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 8px 10px;
        border-radius: 8px;
        background: #f7f9fc
    }

    .account-row code {
        direction: ltr;
        color: #475467;
        font-family: Consolas, monospace;
        font-size: 10px
    }

    @@media(max-width:860px) {
        .login-shell {
            padding: 0
        }

        .login-frame {
            grid-template-columns: 1fr;
            border-radius: 0;
            min-height: 100dvh;
            box-shadow: none
        }

        .login-brandpanel {
            min-height: 0;
            padding: 30px 24px 26px;
            align-items: flex-start
        }

        .brandpanel-points {
            display: none
        }

        .login-formpanel {
            padding: 30px 22px
        }
    }

    @@media(max-width:400px) {
        .login-heading h1 {
            font-size: 22px
        }
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorValue { get; set; }

    private bool Error => string.Equals(ErrorValue, "1", StringComparison.Ordinal);
    private bool NoPositionError => string.Equals(ErrorValue, "no-position", StringComparison.Ordinal);
}
