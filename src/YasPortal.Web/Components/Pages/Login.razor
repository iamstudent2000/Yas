@page "/login"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>ورود | یاس پورتال</PageTitle>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="jasmine-bloom" viewBox="0 0 100 100">
        <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
            <ellipse cx="50" cy="23" rx="11" ry="23" />
            <ellipse cx="50" cy="23" rx="11" ry="23" transform="rotate(72 50 50)" />
            <ellipse cx="50" cy="23" rx="11" ry="23" transform="rotate(144 50 50)" />
            <ellipse cx="50" cy="23" rx="11" ry="23" transform="rotate(216 50 50)" />
            <ellipse cx="50" cy="23" rx="11" ry="23" transform="rotate(288 50 50)" />
            <circle cx="50" cy="50" r="6.5" />
        </g>
    </symbol>
</svg>

<div class="login-shell" dir="rtl">
    <main class="login-frame" aria-labelledby="login-title">
        <section class="login-brandpanel" aria-hidden="true">
            <svg class="bloom bloom-a" viewBox="0 0 100 100"><use href="#jasmine-bloom" /></svg>
            <svg class="bloom bloom-b" viewBox="0 0 100 100"><use href="#jasmine-bloom" /></svg>
            <svg class="bloom bloom-c" viewBox="0 0 100 100"><use href="#jasmine-bloom" /></svg>

            <div class="login-brandpanel-body">
                <div class="brandpanel-mark">
                    <svg viewBox="0 0 100 100"><use href="#jasmine-bloom" /></svg>
                </div>
                <div class="brandpanel-text">
                    <div class="brandpanel-name">یاس پورتال</div>
                    <p>سامانه یکپارچه مدیریت سازمان، سمت‌ها و دسترسی‌های کارکنان — در یک بستر واحد.</p>
                </div>
                <ul class="brandpanel-points">
                    <li><i class="bx bx-sitemap"></i> ساختار سازمانی شفاف و قابل پیگیری</li>
                    <li><i class="bx bx-id-card"></i> سمت‌ها و مجوزهای هر کارمند، دقیق و به‌روز</li>
                    <li><i class="bx bx-history"></i> رویدادهای سامانه، همیشه در دسترس</li>
                </ul>
            </div>
        </section>

        <section class="login-formpanel">
            <div class="login-formpanel-inner">
                <div class="login-heading">
                    <h1 id="login-title">خوش آمدید</h1>
                    <p>برای ورود به حساب کاربری خود، اطلاعات زیر را وارد کنید.</p>
                </div>

                @if (NoPositionError)
                {
                    <div class="login-alert login-alert-warning" role="alert">
                        <i class="bx bx-sitemap" aria-hidden="true"></i>
                        <div>
                            <strong>سمت فعالی برای حساب شما ثبت نشده است.</strong>
                            <span>برای ورود، ابتدا باید حداقل یک سمت فعال به شما تخصیص داده شود. لطفاً با مدیر سامانه
                                تماس بگیرید.</span>
                        </div>
                    </div>
                }
                else if (Error)
                {
                    <div class="login-alert" role="alert">
                        <i class="bx bx-error-circle" aria-hidden="true"></i>
                        <span>نام کاربری یا رمز عبور صحیح نیست.</span>
                    </div>
                }

                <form class="login-form" method="post" action="/account/login">
                    <AntiforgeryToken />

                    <div class="field">
                        <label for="username">نام کاربری</label>
                        <div class="input-wrap">
                            <i class="bx bx-user" aria-hidden="true"></i>
                            <input id="username" name="username" autocomplete="username"
                                   placeholder="نام کاربری خود را وارد کنید" required />
                        </div>
                    </div>

                    <div class="field">
                        <label for="password">رمز عبور</label>
                        <div class="input-wrap">
                            <i class="bx bx-lock-alt" aria-hidden="true"></i>
                            <input id="password" name="password" type="password" autocomplete="current-password"
                                   placeholder="رمز عبور خود را وارد کنید" required />
                        </div>
                    </div>

                    <button class="login-button" type="submit">
                        <span>ورود به سامانه</span>
                        <i class="bx bx-left-arrow-alt" aria-hidden="true"></i>
                    </button>
                </form>

                <div class="login-footer">
                    <i class="bx bx-shield-quarter" aria-hidden="true"></i>
                    <span>ورود امن به سامانه یاس پورتال</span>
                </div>

                <details class="development-accounts">
                    <summary>
                        <i class="bx bx-code-alt" aria-hidden="true"></i>
                        <span>حساب‌های توسعه</span>
                        <i class="bx bx-chevron-down summary-chevron" aria-hidden="true"></i>
                    </summary>
                    <div class="account-list">
                        <div class="account-row">
                            <span>مدیر سامانه</span>
                            <code>admin / Admin123!</code>
                        </div>
                        <div class="account-row">
                            <span>کارمند</span>
                            <code>employee / Employee123!</code>
                        </div>
                    </div>
                </details>
            </div>
        </section>
    </main>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorValue { get; set; }

    private bool Error => string.Equals(ErrorValue, "1", StringComparison.Ordinal);
    private bool NoPositionError => string.Equals(ErrorValue, "no-position", StringComparison.Ordinal);
}
