@page "/login"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>ورود - یاس پورتال</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="brand">
            <h1>یاس پورتال</h1>
            <p>سامانه یکپارچه مدیریت و گردش کار</p>
        </div>

        @if (Error)
        {
            <div class="alert" role="alert">نام کاربری یا رمز عبور صحیح نیست.</div>
        }

        <form class="login-form" method="post" action="/account/login">
            <AntiforgeryToken />
            <div>
                <label for="username">نام کاربری</label>
                <input id="username" name="username" autocomplete="username" placeholder="نام کاربری خود را وارد کنید" required />
            </div>
            <div>
                <label for="password">رمز عبور</label>
                <input id="password" name="password" type="password" autocomplete="current-password" placeholder="رمز عبور خود را وارد کنید" required />
            </div>
            <button type="submit">ورود به سامانه</button>
        </form>

        <div class="demo-note">حساب‌های توسعه: <code>admin / Admin123!</code> و <code>employee / Employee123!</code></div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorValue { get; set; }

    private bool Error => string.Equals(ErrorValue, "1", StringComparison.Ordinal);
}
