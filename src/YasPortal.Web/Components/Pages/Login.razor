@page "/login"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>ورود | یاس پورتال</PageTitle>

<div class="login-shell" dir="rtl">
    <div class="login-decoration login-decoration-one"></div>
    <div class="login-decoration login-decoration-two"></div>

    <main class="login-card" aria-labelledby="login-title">
        <section class="login-brand">
            <div class="brand-mark" aria-hidden="true">
                <i class="bx bx-layer"></i>
            </div>
            <div>
                <div class="brand-name">یاس پورتال</div>
                <div class="brand-caption">سامانه یکپارچه سازمانی</div>
            </div>
        </section>

        <div class="login-heading">
            <h1 id="login-title">خوش آمدید</h1>
            <p>برای ورود به حساب کاربری خود اطلاعات زیر را وارد کنید.</p>
        </div>

        @if (Error)
        {
            <div class="login-alert" role="alert">
                <i class="bx bx-error-circle" aria-hidden="true"></i>
                <span>نام کاربری یا رمز عبور صحیح نیست.</span>
            </div>
        }

        <form class="login-form" method="post" action="/account/login">
            <AntiforgeryToken />

            <div class="field">
                <label for="username">نام کاربری</label>
                <div class="input-wrap">
                    <i class="bx bx-user" aria-hidden="true"></i>
                    <input id="username" name="username" autocomplete="username" placeholder="نام کاربری خود را وارد کنید" required autofocus />
                </div>
            </div>

            <div class="field">
                <label for="password">رمز عبور</label>
                <div class="input-wrap">
                    <i class="bx bx-lock-alt" aria-hidden="true"></i>
                    <input id="password" name="password" type="password" autocomplete="current-password" placeholder="رمز عبور خود را وارد کنید" required />
                </div>
            </div>

            <button class="login-button" type="submit">
                <span>ورود به سامانه</span>
                <i class="bx bx-left-arrow-alt" aria-hidden="true"></i>
            </button>
        </form>

        <div class="login-footer">
            <i class="bx bx-shield-quarter" aria-hidden="true"></i>
            <span>ورود امن به سامانه یاس پورتال</span>
        </div>

        <details class="development-accounts">
            <summary>
                <i class="bx bx-code-alt" aria-hidden="true"></i>
                <span>حساب‌های توسعه</span>
                <i class="bx bx-chevron-down summary-chevron" aria-hidden="true"></i>
            </summary>
            <div class="account-list">
                <div class="account-row">
                    <span>مدیر سامانه</span>
                    <code>admin / Admin123!</code>
                </div>
                <div class="account-row">
                    <span>کارمند</span>
                    <code>employee / Employee123!</code>
                </div>
            </div>
        </details>
    </main>
</div>

<style>
    .login-shell {
        min-height: 100vh;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        position: relative;
        overflow: hidden;
        padding: 32px 20px;
        background: #f4f7fb;
        color: #172033;
        font-family: inherit;
        box-sizing: border-box;
    }

    .login-shell * {
        box-sizing: border-box;
    }

    .login-decoration {
        position: absolute;
        border-radius: 999px;
        pointer-events: none;
        opacity: .65;
    }

    .login-decoration-one {
        width: 430px;
        height: 430px;
        top: -220px;
        right: -130px;
        background: #dfe9ff;
    }

    .login-decoration-two {
        width: 330px;
        height: 330px;
        bottom: -180px;
        left: -120px;
        background: #e5f7f3;
    }

    .login-card {
        width: min(100%, 430px);
        position: relative;
        z-index: 1;
        padding: 32px;
        border: 1px solid #e3e8f1;
        border-radius: 22px;
        background: rgba(255,255,255,.97);
        box-shadow: 0 22px 55px rgba(31, 49, 79, .12);
    }

    .login-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
    }

    .brand-mark {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        flex: 0 0 44px;
        border-radius: 13px;
        background: #2563eb;
        color: #fff;
        font-size: 23px;
        box-shadow: 0 8px 18px rgba(37,99,235,.22);
    }

    .brand-name {
        font-size: 18px;
        font-weight: 800;
        line-height: 1.4;
    }

    .brand-caption {
        margin-top: 2px;
        color: #718096;
        font-size: 12px;
    }

    .login-heading {
        margin-bottom: 22px;
    }

    .login-heading h1 {
        margin: 0;
        font-size: 24px;
        line-height: 1.5;
        font-weight: 800;
        color: #162033;
    }

    .login-heading p {
        margin: 6px 0 0;
        color: #68758a;
        font-size: 13px;
        line-height: 1.8;
    }

    .login-alert {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 18px;
        padding: 10px 12px;
        border: 1px solid #fecaca;
        border-radius: 10px;
        background: #fff5f5;
        color: #b42318;
        font-size: 12px;
        line-height: 1.7;
    }

    .login-alert i {
        font-size: 18px;
        flex: 0 0 auto;
    }

    .login-form {
        display: grid;
        gap: 16px;
    }

    .field {
        display: grid;
        gap: 7px;
    }

    .field label {
        color: #344054;
        font-size: 13px;
        font-weight: 700;
    }

    .input-wrap {
        position: relative;
    }

    .input-wrap > i {
        position: absolute;
        top: 50%;
        right: 13px;
        transform: translateY(-50%);
        color: #8995a8;
        font-size: 19px;
        pointer-events: none;
    }

    .input-wrap input {
        width: 100%;
        height: 46px;
        padding: 0 42px 0 13px;
        border: 1px solid #d9e0ea;
        border-radius: 11px;
        outline: none;
        background: #fff;
        color: #172033;
        font: inherit;
        font-size: 13px;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

    .input-wrap input::placeholder {
        color: #a0aaba;
    }

    .input-wrap input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37,99,235,.10);
    }

    .login-button {
        width: 100%;
        height: 46px;
        margin-top: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border: 0;
        border-radius: 11px;
        background: #2563eb;
        color: #fff;
        cursor: pointer;
        font: inherit;
        font-size: 13px;
        font-weight: 800;
        transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
        box-shadow: 0 8px 18px rgba(37,99,235,.20);
    }

    .login-button:hover {
        background: #1d4ed8;
        transform: translateY(-1px);
        box-shadow: 0 10px 22px rgba(37,99,235,.24);
    }

    .login-button:active {
        transform: translateY(0);
    }

    .login-button i {
        font-size: 19px;
    }

    .login-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 20px;
        color: #8490a3;
        font-size: 11px;
    }

    .login-footer i {
        font-size: 16px;
    }

    .development-accounts {
        margin-top: 20px;
        border-top: 1px solid #edf0f5;
        padding-top: 14px;
        color: #64748b;
        font-size: 11px;
    }

    .development-accounts summary {
        display: flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
        list-style: none;
        user-select: none;
    }

    .development-accounts summary::-webkit-details-marker {
        display: none;
    }

    .development-accounts summary > i:first-child {
        color: #2563eb;
        font-size: 16px;
    }

    .summary-chevron {
        margin-right: auto;
        transition: transform .15s ease;
        font-size: 16px;
    }

    .development-accounts[open] .summary-chevron {
        transform: rotate(180deg);
    }

    .account-list {
        display: grid;
        gap: 7px;
        margin-top: 10px;
    }

    .account-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 8px 10px;
        border-radius: 8px;
        background: #f7f9fc;
    }

    .account-row code {
        direction: ltr;
        color: #475467;
        font-family: Consolas, monospace;
        font-size: 10px;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorValue { get; set; }

    private bool Error => string.Equals(ErrorValue, "1", StringComparison.Ordinal);
}
