@page "/delegations"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Application.Authorization
@using YasPortal.Domain.Delegations
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IPermissionChecker Permissions
@inject WorkflowService Workflows
@inject NotificationService NotificationSvc
@inject AdminQueryService AdminQueries
@inject AppState AppState
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>تفویض اختیار - یاس پورتال</PageTitle>

<div class="requests-page" dir="rtl">
    <div class="page-header">
        <div>
            <div class="page-kicker">درخواست‌ها و گردش‌کار</div>
            <h1 class="page-title"><i class="bx bx-transfer"></i> تفویض اختیار</h1>
            <p class="page-subtitle">اختیار تایید یک سمت را برای بازه‌ای مشخص به همکار دیگری بسپارید. هر تصمیم به نام نماینده و با ذکر تفویض‌کننده ثبت می‌شود.</p>
        </div>
    </div>

    @if (!_ready)
    {
        <section class="card"><LoadingState /></section>
    }
    else if (!_canCreate && !_canManage)
    {
        <section class="card"><div class="empty-state"><i class="bx bx-lock-alt"></i><strong>مجوز تفویض اختیار ندارید</strong></div></section>
    }
    else
    {
        <section class="card dlg-create">
            <div class="dlg-section-head">
                <h2 class="card-title"><i class="bx bx-plus-circle"></i> تفویض جدید</h2>
                <p class="muted">اختیار به یک سمت داده می‌شود؛ هر کسی که در بازه‌ی تفویض آن سمت را دارد می‌تواند به نیابت تصمیم بگیرد.</p>
            </div>

            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">@(_canManage ? "سمت تفویض‌کننده (جانشین موقت توسط مدیر سامانه)" : "سمت شما")</label>
                    @if (_canManage)
                    {
                        <ServerSearchableGuidSelect @bind-Value="_positionId" SearchAsync="SearchPositionsAsync" Placeholder="انتخاب سمت..." />
                    }
                    else if (_ownPositionName is null)
                    {
                        <div class="readonly-field is-warning"><i class="bx bx-error-circle"></i> سمت فعال معتبری ندارید؛ تفویض ممکن نیست.</div>
                    }
                    else
                    {
                        <div class="readonly-field"><i class="bx bx-briefcase-alt-2"></i> <strong>@_ownPositionName</strong></div>
                    }
                </div>

                <div class="form-field">
                    <label class="form-label">سمت دریافت‌کننده‌ی تفویض</label>
                    <ServerSearchableGuidSelect @bind-Value="_delegatePositionId" SearchAsync="SearchDelegatePositionsAsync" Placeholder="انتخاب سمت..." />
                </div>

                <div class="form-field">
                    <label class="form-label">از تاریخ</label>
                    <PersianDatePicker @bind-Value="_from" Placeholder="تاریخ شروع" />
                </div>

                <div class="form-field">
                    <label class="form-label">تا تاریخ</label>
                    <PersianDatePicker @bind-Value="_to" Placeholder="تاریخ پایان" />
                </div>

                <div class="form-field dlg-submit">
                    <button class="btn btn-primary" disabled="@_busy" @onclick="CreateAsync"><i class="bx bx-check"></i> ثبت تفویض</button>
                </div>
            </div>
        </section>

        <div class="dlg-columns">
            <section class="card">
                <h2 class="card-title"><i class="bx bx-transfer"></i> @(_canManage ? "همه تفویض‌ها" : "تفویض‌های من")</h2>
                @if (_mine.Count == 0)
                {
                    <div class="empty-state is-compact"><i class="bx bx-transfer"></i><strong>تفویضی ثبت نشده است</strong></div>
                }
                @foreach (var row in _mine)
                {
                    <div class="dlg-row">
                        <div class="dlg-row-main">
                            <strong>@row.PositionName <i class="bx bx-left-arrow-alt"></i> @row.DelegatePositionName</strong>
                            <span>@WorkflowDisplay.ToPersianDate(row.Delegation.StartDate) تا @WorkflowDisplay.ToPersianDate(row.Delegation.EndDate)@(row.DelegatorName is null ? "" : " · تفویض‌کننده: " + row.DelegatorName)</span>
                        </div>
                        <div class="dlg-row-side">
                            @if (row.Delegation.ArrangedByAdmin)
                            {
                                <span class="badge badge-info">جانشین تعیین‌شده توسط مدیر</span>
                            }
                            <span class="badge @StatusClass(row.Status)">@StatusLabel(row.Status)</span>
                            @if (row.Status is DelegationStatus.Active or DelegationStatus.Upcoming)
                            {
                                <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => RevokeAsync(row.Delegation.Id)"><i class="bx bx-x"></i> لغو</button>
                            }
                        </div>
                    </div>
                }
                <ServerPagination Page="_minePage" PageSize="_minePageSize" TotalCount="_mineTotal" Busy="_listBusy" PageChanged="GoToMinePageAsync" PageSizeChanged="OnMinePageSizeChangedAsync" />
            </section>

            <section class="card">
                <h2 class="card-title"><i class="bx bx-inbox"></i> تفویض‌های دریافتی</h2>
                @if (_received.Count == 0)
                {
                    <div class="empty-state is-compact"><i class="bx bx-inbox"></i><strong>تفویضی به شما سپرده نشده است</strong></div>
                }
                @foreach (var row in _received)
                {
                    <div class="dlg-row">
                        <div class="dlg-row-main">
                            <strong>@row.PositionName</strong>
                            <span>@WorkflowDisplay.ToPersianDate(row.Delegation.StartDate) تا @WorkflowDisplay.ToPersianDate(row.Delegation.EndDate)@(row.DelegatorName is null ? "" : " · از " + row.DelegatorName)</span>
                        </div>
                        <div class="dlg-row-side">
                            <span class="badge @StatusClass(row.Status)">@StatusLabel(row.Status)</span>
                        </div>
                    </div>
                }
                <ServerPagination Page="_receivedPage" PageSize="_receivedPageSize" TotalCount="_receivedTotal" Busy="_listBusy" PageChanged="GoToReceivedPageAsync" PageSizeChanged="OnReceivedPageSizeChangedAsync" />
            </section>
        </div>
    }
</div>

@code {
    private sealed record Row(PositionDelegation Delegation, string PositionName, string DelegatePositionName, string? DelegatorName, DelegationStatus Status);

    private bool _ready, _busy, _canCreate, _canManage;
    private Guid? _employeeId, _ownPositionId, _positionId, _delegatePositionId;
    private string? _ownPositionName;
    private DateTime? _from, _to;
    private List<Row> _mine = [];
    private List<Row> _received = [];
    private List<Guid> _myPositionIds = [];

    // Each list is paged on its own, in the database, so a long history never loads at once.
    private int _minePage = 1, _minePageSize = 10, _mineTotal;
    private int _receivedPage = 1, _receivedPageSize = 10, _receivedTotal;
    private bool _listBusy;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _employeeId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var eid) ? eid : null;
        var claimed = Guid.TryParse(user.FindFirstValue("yas_active_position_id"), out var pid) ? (Guid?)pid : null;
        _canCreate = await Permissions.HasPermissionAsync("Requests.Delegation");
        _canManage = await Permissions.HasPermissionAsync("Admin.Delegation");
        if (_employeeId is Guid emp && await Workflows.HoldsActivePositionAsync(emp, claimed))
            _ownPositionId = claimed;
        await LoadAsync();
        _ready = true;
    }

    private async Task LoadAsync()
    {
        _ownPositionName = null;
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            if (_ownPositionId is Guid own)
                _ownPositionName = await db.Positions.AsNoTracking().Where(x => x.Id == own).Select(x => x.Name).SingleOrDefaultAsync();

            var me = _employeeId;
            _myPositionIds = await db.EmployeePositions.AsNoTracking().Where(ep => ep.EmployeeId == me && ep.EndedAt == null).Select(ep => ep.PositionId).ToListAsync();
        }
        await LoadMineAsync();
        await LoadReceivedAsync();
    }

    private async Task LoadMineAsync()
    {
        _listBusy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var me = _employeeId;
            var query = db.PositionDelegations.AsNoTracking().Where(d => _canManage || d.DelegatorEmployeeId == me);
            _mineTotal = await query.CountAsync();
            _minePage = ClampPage(_minePage, _minePageSize, _mineTotal);
            var rows = await query.OrderByDescending(d => d.CreatedAtUtc).Skip((_minePage - 1) * _minePageSize).Take(_minePageSize).ToListAsync();
            _mine = await MapAsync(db, rows);
        }
        finally { _listBusy = false; }
    }

    private async Task LoadReceivedAsync()
    {
        _listBusy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var ids = _myPositionIds;
            var query = db.PositionDelegations.AsNoTracking().Where(d => ids.Contains(d.DelegatePositionId));
            _receivedTotal = await query.CountAsync();
            _receivedPage = ClampPage(_receivedPage, _receivedPageSize, _receivedTotal);
            var rows = await query.OrderByDescending(d => d.CreatedAtUtc).Skip((_receivedPage - 1) * _receivedPageSize).Take(_receivedPageSize).ToListAsync();
            _received = await MapAsync(db, rows);
        }
        finally { _listBusy = false; }
    }

    /// <summary>Keeps the page number valid after the list shrinks (a delegation cancelled on the last page, say).</summary>
    private static int ClampPage(int page, int pageSize, int total) =>
        Math.Clamp(page, 1, Math.Max(1, (int)Math.Ceiling(total / (double)pageSize)));

    private static async Task<List<Row>> MapAsync(ApplicationDbContext db, List<PositionDelegation> rows)
    {
        var positionIds = rows.SelectMany(r => new[] { r.PositionId, r.DelegatePositionId }).Distinct().ToList();
        var empIds = rows.Select(r => r.DelegatorEmployeeId ?? Guid.Empty).Where(x => x != Guid.Empty).Distinct().ToList();
        var positions = await db.Positions.AsNoTracking().Where(p => positionIds.Contains(p.Id)).ToDictionaryAsync(p => p.Id, p => p.Name);
        var employees = await db.Employees.AsNoTracking().Where(e => empIds.Contains(e.Id)).ToDictionaryAsync(e => e.Id, e => e.FullName);

        var today = DateTime.Now;
        return rows.Select(d => new Row(d,
            positions.GetValueOrDefault(d.PositionId, "نامشخص"),
            positions.GetValueOrDefault(d.DelegatePositionId, "نامشخص"),
            d.DelegatorEmployeeId is Guid g ? employees.GetValueOrDefault(g) : null,
            d.StatusOn(today))).ToList();
    }

    private async Task GoToMinePageAsync(int page) { _minePage = page; await LoadMineAsync(); }
    private async Task OnMinePageSizeChangedAsync(int size) { _minePageSize = size; _minePage = 1; await LoadMineAsync(); }
    private async Task GoToReceivedPageAsync(int page) { _receivedPage = page; await LoadReceivedAsync(); }
    private async Task OnReceivedPageSizeChangedAsync(int size) { _receivedPageSize = size; _receivedPage = 1; await LoadReceivedAsync(); }

    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchPositionsAsync(string search, CancellationToken ct) =>
        AdminQueries.SearchPositionsWithHoldersAsync(search, null, ct, activeOnly: true);

    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchDelegatePositionsAsync(string search, CancellationToken ct) =>
        AdminQueries.SearchPositionsWithHoldersAsync(search, _canManage && _positionId is not null ? _positionId : _ownPositionId, ct, activeOnly: true);

    private void Fail(string message) => AppState.AddToast(message, ToastLevel.Error);

    private async Task CreateAsync()
    {
        if (_employeeId is not Guid me) return;
        if (_delegatePositionId is not Guid delegatePos) { Fail("سمت دریافت‌کننده تفویض را انتخاب کنید."); return; }
        if (_from is null || _to is null) { Fail("بازه تاریخ را کامل وارد کنید."); return; }
        if (_to.Value.Date < _from.Value.Date) { Fail("تاریخ پایان نمی‌تواند قبل از تاریخ شروع باشد."); return; }
        if (_to.Value.Date < DateTime.Now.Date) { Fail("بازه تفویض نمی‌تواند کاملاً در گذشته باشد."); return; }

        var admin = _canManage && _positionId is not null;
        var positionId = admin ? _positionId : (_canCreate ? _ownPositionId : null);
        if (positionId is not Guid pos) { Fail("سمتی برای تفویض انتخاب نشده است."); return; }
        if (pos == delegatePos) { Fail("یک سمت را نمی‌توان به خودش تفویض کرد."); return; }

        _busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            Guid? delegator = await db.EmployeePositions.Where(ep => ep.PositionId == pos && ep.EndedAt == null).Select(ep => (Guid?)ep.EmployeeId).FirstOrDefaultAsync();
            if (!admin && delegator != me)
            {
                Fail("فقط دارنده فعلی سمت می‌تواند اختیار آن را تفویض کند.");
                return;
            }
            if (!await db.Positions.AnyAsync(p => p.Id == pos && p.IsActive) || !await db.Positions.AnyAsync(p => p.Id == delegatePos && p.IsActive))
            {
                Fail("سمت غیرفعال را نمی‌توان تفویض داد یا دریافت کرد.");
                return;
            }
            var delegation = new PositionDelegation(pos, delegator, delegatePos, _from.Value, _to.Value, me, admin);
            db.PositionDelegations.Add(delegation);
            await NotificationSvc.StageDelegationReceivedAsync(db, delegation);
            await db.SaveChangesAsync();
            AppState.AddToast("تفویض ثبت شد.", ToastLevel.Success);
            _delegatePositionId = null; _from = null; _to = null; _positionId = null;
        }
        catch (ArgumentException ex)
        {
            Fail(ex.Message);
        }
        finally
        {
            _busy = false;
        }
        await LoadAsync();
    }

    private async Task RevokeAsync(Guid id)
    {
        if (_employeeId is not Guid me) return;
        _busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var d = await db.PositionDelegations.SingleOrDefaultAsync(x => x.Id == id);
            if (d is null) return;
            if (!_canManage && d.DelegatorEmployeeId != me)
            {
                AppState.AddToast("شما مجوز لغو این تفویض را ندارید.", ToastLevel.Error);
                return;
            }
            if (d.RevokedAtUtc is not null) return;
            d.Revoke(me);
            await db.SaveChangesAsync();
            AppState.AddToast("تفویض لغو شد.", ToastLevel.Success);
        }
        finally
        {
            _busy = false;
        }
        await LoadAsync();
    }

    private static string StatusLabel(DelegationStatus s) => s switch
    {
        DelegationStatus.Upcoming => "در انتظار شروع",
        DelegationStatus.Active => "فعال",
        DelegationStatus.Expired => "منقضی",
        _ => "لغو شده",
    };

    private static string StatusClass(DelegationStatus s) => s switch
    {
        DelegationStatus.Active => "badge-success",
        DelegationStatus.Upcoming => "badge-info",
        _ => "badge-muted",
    };
}
