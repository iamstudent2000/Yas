@page "/my-positions"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using YasPortal.Infrastructure.Persistence
@attribute [Authorize]
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>سمت‌های من - یاس پورتال</PageTitle>

<div class="page-header"><div><h1 class="page-title">سمت‌های من</h1><p class="page-subtitle">یک سمت را به عنوان سمت فعال انتخاب کنید؛ مجوزهای سامانه بر اساس آن اعمال می‌شوند.</p></div><span class="badge badge-muted"><i class="bx bx-info-circle"></i> انتخاب یک سمت</span></div>

@if (_positions is null)
{
    <section class="card"><p>در حال بارگذاری سمت‌ها...</p></section>
}
else if (_positions.Count == 0)
{
    <section class="card"><div class="empty-state"><div class="empty-icon"><i class="bx bx-id-card"></i></div><strong>هیچ سمت فعالی ثبت نشده است</strong><span>برای این حساب هنوز سمت فعالی تعریف نشده است.</span></div></section>
}
else
{
    <div class="position-grid">
        @foreach (var position in _positions)
        {
            <article class="position-card @(position.Id == _activePositionId ? "selected" : "")">
                <div class="position-icon"><i class="bx bx-briefcase-alt-2"></i></div>
                <div class="position-content"><h2>@position.Name</h2>@if (position.Id == _activePositionId){<span class="badge badge-success"><i class="bx bx-check-circle"></i> سمت فعال فعلی</span>}else{<span class="badge badge-muted">سمت دیگر</span>}</div>
                @if (position.Id != _activePositionId)
                {
                    <form method="post" action="/account/position"><AntiforgeryToken /><input type="hidden" name="positionId" value="@position.Id" /><button class="btn btn-primary" type="submit"><i class="bx bx-check"></i> انتخاب سمت</button></form>
                }
            </article>
        }
    </div>
}

@code {
    private List<PositionItem>? _positions;
    private Guid? _activePositionId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        if (!Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var employeeId)) return;
        if (Guid.TryParse(user.FindFirstValue("yas_active_position_id"), out var activePositionId)) _activePositionId = activePositionId;
        _positions = await Db.EmployeePositions.AsNoTracking().Where(x => x.EmployeeId == employeeId && x.EndedAt == null).OrderBy(x => x.Position.Name).Select(x => new PositionItem(x.PositionId, x.Position.Name)).ToListAsync();
    }

    private sealed record PositionItem(Guid Id, string Name);
}
