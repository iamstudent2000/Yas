@page "/my-positions"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using YasPortal.Infrastructure.Persistence
@attribute [Authorize]
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>سمت‌های من - یاس پورتال</PageTitle>

<div class="positions-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">سمت‌های من</h1>
            <p class="page-subtitle">یک سمت را به عنوان سمت فعال انتخاب کنید؛ مجوزهای سامانه بر اساس آن اعمال می‌شوند.</p>
        </div><span class="badge badge-muted"><i class="bx bx-info-circle"></i> انتخاب یک سمت</span>
    </div>

    @if (_positions is null)
    {
        <section class="card">
            <p>در حال بارگذاری سمت‌ها...</p>
        </section>
    }
    else if (_positions.Count == 0)
    {
        <section class="card">
            <div class="empty-state">
                <div class="empty-icon"><i class="bx bx-id-card"></i></div>
                @if (_isAdmin)
                {
                    <strong>حساب‌های مدیر سامانه سمتی ندارند</strong><span>دسترسی شما بر اساس نقش مدیریت سامانه اعمال
                        می‌شود، نه سمت سازمانی.</span>
                }
                else
                {
                    <strong>هیچ سمت فعالی ثبت نشده است</strong><span>برای این حساب هنوز سمت فعالی تعریف نشده است.</span>
                }
            </div>
        </section>
    }
    else
    {
        var active = _positions.FirstOrDefault(x => x.Id == _activePositionId);
        var others = _positions.Where(x => x.Id != _activePositionId).ToList();

        @if (active is not null)
        {
            <section class="position-active">
                <svg class="position-active-bloom" viewBox="0 0 100 100" aria-hidden="true">
                    <use href="#jasmine-bloom-outline" />
                </svg>
                <div class="position-active-icon"><i class="bx bx-briefcase-alt-2"></i></div>
                <div class="position-active-text">
                    <span>سمت فعال فعلی</span>
                    <h2>@active.Name</h2>
                </div>
                <span class="badge badge-success"><i class="bx bx-check-circle"></i> فعال</span>
            </section>
        }

        @if (others.Count > 0)
        {
            <section class="position-others">
                <h2 class="section-title">@(active is null ? "سمت‌های شما" : "سایر سمت‌های شما")</h2>
                <div class="position-list">
                    @foreach (var position in others)
                    {
                        <div class="position-row">
                            <span class="position-row-icon"><i class="bx bx-briefcase"></i></span>
                            <span class="position-row-name">@position.Name</span>
                            <form method="post" action="/account/position">
                                <AntiforgeryToken /><input type="hidden" name="positionId" value="@position.Id" />
                                <button class="btn btn-secondary" type="submit"><i class="bx bx-transfer-alt"></i> انتخاب
                                    به‌عنوان سمت فعال</button>
                            </form>
                        </div>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    private List<PositionItem>? _positions;
    private Guid? _activePositionId;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        _isAdmin = user.HasClaim("yas_is_admin", "True");
        if (!Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var employeeId)) return;
        if (Guid.TryParse(user.FindFirstValue("yas_active_position_id"), out var activePositionId)) _activePositionId =
activePositionId;
        _positions = await Db.EmployeePositions.AsNoTracking().Where(x => x.EmployeeId == employeeId && x.EndedAt ==
null).OrderBy(x => x.Position.Name).Select(x => new PositionItem(x.PositionId, x.Position.Name)).ToListAsync();
    }

    private sealed record PositionItem(Guid Id, string Name);
}
