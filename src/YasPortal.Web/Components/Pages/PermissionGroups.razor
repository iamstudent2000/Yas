@page "/admin/permission-groups"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Domain.Authorization
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Services
@attribute [Authorize(Policy = "Admin.Permissions")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AppState AppState

<PageTitle>گروه‌های مجوز - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <div class="page-header">
        <div>
            <div class="page-kicker">مدیریت سامانه / کنترل دسترسی</div>
            <h1 class="page-title">گروه‌های مجوز</h1>
            <p class="page-subtitle">یک مجموعه مجوز را یک‌بار تعریف کنید و بعد آن را به مدیر یا ترکیب دقیق «کارمند + سمت» اختصاص دهید.</p>
        </div>
        <div class="admin-page-actions">
            <a class="btn btn-secondary" href="/admin/permissions"><i class="bx bx-key"></i> مجوزها</a>
            <a class="btn btn-primary" href="/admin/access"><i class="bx bx-shield-quarter"></i> مدیریت دسترسی</a>
        </div>
    </div>

    <div class="admin-stat-grid">
        <div class="admin-stat"><span class="admin-stat-icon"><i class="bx bx-layer"></i></span><div><small>کل گروه‌ها</small><strong>@_groups.Count</strong></div></div>
        <div class="admin-stat"><span class="admin-stat-icon"><i class="bx bx-key"></i></span><div><small>کل مجوزهای پایه</small><strong>@_permissions.Count</strong></div></div>
        <div class="admin-stat"><span class="admin-stat-icon"><i class="bx bx-link"></i></span><div><small>گروه فعال انتخاب‌شده</small><strong>@(_selectedGroupId is null ? "—" : "۱")</strong></div></div>
    </div>

    <div class="group-admin-layout">
        <section class="card group-form-card">
            <div class="card-heading">
                <div class="card-heading-icon"><i class="bx @( _editingId is null ? "bx-layer-plus" : "bx-edit-alt")"></i></div>
                <div><h2 class="section-title">@(_editingId is null ? "گروه جدید" : "ویرایش گروه")</h2><p class="muted">نام گروه باید برای مدیر سیستم واضح و قابل تشخیص باشد.</p></div>
            </div>
            <label class="form-label">نام گروه</label>
            <input class="form-control" @bind="_name" maxlength="200" placeholder="مثلاً اپراتور درخواست" />
            <label class="form-label">توضیح</label>
            <textarea class="form-control" @bind="_description" maxlength="500" rows="4" placeholder="این گروه چه دسترسی‌هایی را پوشش می‌دهد؟"></textarea>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SaveGroup"><i class="bx bx-save"></i> @(_editingId is null ? "ایجاد گروه" : "ذخیره تغییرات")</button>
                @if (_editingId is not null) { <button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button> }
            </div>
            <div class="model-tip"><i class="bx bx-info-circle"></i><span>گروه‌ها فقط مجوز اضافه می‌کنند؛ هیچ Deny permission وجود ندارد.</span></div>
        </section>

        <section class="card group-list-card">
            <div class="card-toolbar">
                <div><h2 class="section-title">گروه‌ها</h2><p class="muted">یک گروه را انتخاب کنید تا مجوزهای آن را مدیریت کنید.</p></div>
                <div class="toolbar-search"><i class="bx bx-search"></i><input class="form-control" placeholder="جستجوی گروه..." @bind="_groupSearch" @bind:event="oninput" /></div>
            </div>
            <div class="group-cards">
                @foreach (var group in FilteredGroups)
                {
                    var selected = _selectedGroupId == group.Id;
                    <button type="button" class="managed-group-card @(selected ? "selected" : "")" @onclick="() => SelectGroup(group.Id)">
                        <span class="managed-group-icon"><i class="bx bx-layer"></i></span>
                        <span class="managed-group-content"><strong>@group.Name</strong><small>@group.PermissionCount مجوز · @(group.EmployeeAssignmentCount + group.PositionAssignmentCount) تخصیص</small>@if (!string.IsNullOrWhiteSpace(group.Description)){<em>@group.Description</em>}</span>
                        <span class="managed-group-actions" @onclick:stopPropagation="true"><button type="button" class="icon-button" title="ویرایش" @onclick="() => EditGroup(group.Id)"><i class="bx bx-edit-alt"></i></button>@if(group.EmployeeAssignmentCount + group.PositionAssignmentCount == 0){<button type="button" class="icon-button danger" title="حذف" @onclick="() => DeleteGroup(group.Id)"><i class="bx bx-trash"></i></button>}</span>
                    </button>
                }
                @if (FilteredGroups.Count == 0) { <div class="empty-state"><i class="bx bx-layer"></i><strong>گروهی پیدا نشد</strong><span>نام گروه را تغییر دهید یا یک گروه جدید بسازید.</span></div> }
            </div>
        </section>
    </div>

    @if (_selectedGroupId is Guid selectedGroupId && _groups.FirstOrDefault(x => x.Id == selectedGroupId) is GroupRow selectedGroup)
    {
        <section class="card group-permission-editor">
            <div class="editor-topbar">
                <div class="editor-title">
                    <div class="card-heading-icon"><i class="bx bx-lock-open-alt"></i></div>
                    <div><div class="page-kicker">گروه انتخاب‌شده</div><h2 class="section-title">@selectedGroup.Name</h2><p class="muted">@_selectedPermissionIds.Count از @_permissions.Count مجوز انتخاب شده است.</p></div>
                </div>
                <div class="editor-tools"><div class="toolbar-search"><i class="bx bx-search"></i><input class="form-control" placeholder="نام مجوز را جستجو کنید..." @bind="_search" @bind:event="oninput" /></div><label class="only-selected"><input type="checkbox" @bind="_onlySelected" /> فقط انتخاب‌شده‌ها</label></div>
            </div>

            <div class="bulk-toolbar">
                <span><strong>@FilteredPermissionGroups.SelectMany(x => x.Items).Count()</strong> مجوز نمایش داده می‌شود</span>
                <div><button class="btn btn-secondary btn-sm" disabled="@(_saving || !FilteredPermissionGroups.Any())" @onclick="() => SetVisiblePermissions(selectedGroupId, true)"><i class="bx bx-check-double"></i> انتخاب نتایج</button><button class="btn btn-secondary btn-sm" disabled="@(_saving || !FilteredPermissionGroups.Any())" @onclick="() => SetVisiblePermissions(selectedGroupId, false)"><i class="bx bx-x"></i> حذف نتایج</button></div>
            </div>

            <div class="permission-category-list">
                @foreach (var category in FilteredPermissionGroups)
                {
                    <section class="permission-category">
                        <header><div><span class="category-icon"><i class="bx bx-folder"></i></span><div><strong>@category.Title</strong><small>@category.Items.Count مجوز</small></div></div><div><button class="btn btn-secondary btn-sm" disabled="@_saving" @onclick="() => SetVisiblePermissions(selectedGroupId, category.Items, true)">انتخاب همه</button><button class="btn btn-secondary btn-sm" disabled="@_saving" @onclick="() => SetVisiblePermissions(selectedGroupId, category.Items, false)">حذف همه</button></div></header>
                        <div class="permission-choice-grid">
                            @foreach (var permission in category.Items)
                            {
                                var granted = _selectedPermissionIds.Contains(permission.Id);
                                <label class="permission-choice @(granted ? "selected" : "")">
                                    <input type="checkbox" checked="@granted" disabled="@_saving" @onchange="e => ToggleGroupPermission(selectedGroupId, permission.Id, e.Value is bool v && v)" />
                                    <span class="choice-box"><i class="bx bx-check"></i></span>
                                    <span class="choice-text"><strong>@permission.Name</strong><small>دسترسی پایه</small></span>
                                </label>
                            }
                        </div>
                    </section>
                }
            </div>
            @if (FilteredPermissionGroups.Count == 0) { <div class="empty-state"><i class="bx bx-search-alt"></i><strong>مجوزی پیدا نشد</strong><span>جستجو را تغییر دهید یا فیلتر «فقط انتخاب‌شده‌ها» را خاموش کنید.</span></div> }
        </section>
    }
    else
    {
        <section class="card editor-placeholder"><i class="bx bx-layer-plus"></i><strong>یک گروه را انتخاب کنید</strong><span>پس از انتخاب گروه، مجوزهای آن در همین صفحه و بدون نمایش کد فنی مدیریت می‌شوند.</span></section>
    }
</div>

@code {
    private List<GroupRow> _groups = [];
    private List<PermissionRow> _permissions = [];
    private Guid? _editingId, _selectedGroupId;
    private string _name = "", _description = "", _groupSearch = "", _search = "";
    private bool _saving, _onlySelected;
    private HashSet<Guid> _selectedPermissionIds = [];

    private IReadOnlyList<GroupRow> FilteredGroups => _groups.Where(x => string.IsNullOrWhiteSpace(_groupSearch) || x.Name.Contains(_groupSearch, StringComparison.OrdinalIgnoreCase) || (x.Description?.Contains(_groupSearch, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    private IReadOnlyList<PermissionGroupView> FilteredPermissionGroups => _permissions
        .Where(x => (string.IsNullOrWhiteSpace(_search) || x.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)) && (!_onlySelected || _selectedPermissionIds.Contains(x.Id)))
        .GroupBy(x => PermissionGroupTitle(x.Code), StringComparer.OrdinalIgnoreCase).OrderBy(x => x.Key)
        .Select(x => new PermissionGroupView(x.Key, x.OrderBy(p => p.Name).ToList())).ToList();

    private static string PermissionGroupTitle(string code) => code.Split('.', 2)[0] switch
    {
        "Dashboard" => "داشبورد", "Profile" => "پروفایل", "Requests" => "درخواست‌ها و گردش‌کار", "Employees" => "کارکنان", "Organizations" => "سازمان‌ها", "Positions" => "سمت‌ها", "Permissions" => "مجوزها", "Admin" => "مدیریت سامانه", _ => code.Split('.', 2)[0]
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _permissions = await db.Permissions.AsNoTracking().OrderBy(x => x.Name).Select(x => new PermissionRow(x.Id, x.Code, x.Name)).ToListAsync();
        _groups = await db.PermissionGroups.AsNoTracking().OrderBy(x => x.Name).Select(x => new GroupRow(x.Id, x.Name, x.Description, db.PermissionGroupPermissions.Count(gp => gp.GroupId == x.Id), db.UserPositionPermissionGroups.Count(a => a.GroupId == x.Id), db.EmployeePermissionGroups.Count(a => a.GroupId == x.Id))).ToListAsync();
        if (_selectedGroupId is Guid id) await LoadSelectedGroupAsync(id);
    }

    private async Task LoadSelectedGroupAsync(Guid groupId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _selectedPermissionIds = await db.PermissionGroupPermissions.AsNoTracking().Where(x => x.GroupId == groupId).Select(x => x.PermissionId).ToHashSetAsync();
    }

    private async Task SelectGroup(Guid id)
    {
        if (_saving) return;
        _selectedGroupId = id;
        _onlySelected = false;
        _search = "";
        await LoadSelectedGroupAsync(id);
    }

    private void EditGroup(Guid id) { var group = _groups.Single(x => x.Id == id); _editingId = id; _name = group.Name; _description = group.Description ?? ""; }
    private void CancelEdit() { _editingId = null; _name = _description = ""; }

    private async Task SaveGroup()
    {
        var name = _name.Trim();
        if (string.IsNullOrWhiteSpace(name)) { AppState.AddToast("نام گروه الزامی است.", ToastLevel.Error); return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.PermissionGroups.AnyAsync(x => x.Name == name && x.Id != (_editingId ?? Guid.Empty))) { AppState.AddToast("این نام گروه قبلاً استفاده شده است.", ToastLevel.Error); return; }
        if (_editingId is Guid id) { var group = await db.PermissionGroups.SingleAsync(x => x.Id == id); group.Rename(name, _description); }
        else db.PermissionGroups.Add(new PermissionGroup(name, _description));
        await db.SaveChangesAsync(); AppState.AddToast(_editingId is null ? "گروه ایجاد شد." : "گروه ویرایش شد.", ToastLevel.Success); CancelEdit(); await LoadAsync();
    }

    private async Task DeleteGroup(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.UserPositionPermissionGroups.AnyAsync(x => x.GroupId == id) || await db.EmployeePermissionGroups.AnyAsync(x => x.GroupId == id)) { AppState.AddToast("این گروه هنوز تخصیص دارد و قابل حذف نیست.", ToastLevel.Error); return; }
        var group = await db.PermissionGroups.SingleAsync(x => x.Id == id); db.PermissionGroups.Remove(group); await db.SaveChangesAsync();
        if (_selectedGroupId == id) { _selectedGroupId = null; _selectedPermissionIds.Clear(); }
        AppState.AddToast("گروه حذف شد.", ToastLevel.Success); await LoadAsync();
    }

    private async Task ToggleGroupPermission(Guid groupId, Guid permissionId, bool grant)
    {
        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var link = await db.PermissionGroupPermissions.SingleOrDefaultAsync(x => x.GroupId == groupId && x.PermissionId == permissionId);
            if (grant && link is null) { db.PermissionGroupPermissions.Add(new PermissionGroupPermission(groupId, permissionId)); _selectedPermissionIds.Add(permissionId); }
            else if (!grant && link is not null) { db.PermissionGroupPermissions.Remove(link); _selectedPermissionIds.Remove(permissionId); }
            else return;
            await db.SaveChangesAsync();
            await RefreshGroupCounts(groupId);
        }
        finally { _saving = false; }
    }

    private async Task SetVisiblePermissions(Guid groupId, bool grant) => await SetVisiblePermissions(groupId, FilteredPermissionGroups.SelectMany(x => x.Items).ToList(), grant);

    private async Task SetVisiblePermissions(Guid groupId, IReadOnlyList<PermissionRow> permissions, bool grant)
    {
        if (_saving || permissions.Count == 0) return;
        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var ids = permissions.Select(x => x.Id).ToHashSet();
            var existing = await db.PermissionGroupPermissions.Where(x => x.GroupId == groupId && ids.Contains(x.PermissionId)).ToListAsync();
            if (grant)
            {
                var existingIds = existing.Select(x => x.PermissionId).ToHashSet();
                foreach (var id in ids.Except(existingIds)) db.PermissionGroupPermissions.Add(new PermissionGroupPermission(groupId, id));
                _selectedPermissionIds.UnionWith(ids);
            }
            else
            {
                db.PermissionGroupPermissions.RemoveRange(existing);
                _selectedPermissionIds.ExceptWith(ids);
            }
            await db.SaveChangesAsync();
            await RefreshGroupCounts(groupId);
        }
        finally { _saving = false; }
    }

    private async Task RefreshGroupCounts(Guid groupId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var count = await db.PermissionGroupPermissions.CountAsync(x => x.GroupId == groupId);
        var index = _groups.FindIndex(x => x.Id == groupId);
        if (index >= 0) { var x = _groups[index]; _groups[index] = x with { PermissionCount = count }; }
    }

    private sealed record GroupRow(Guid Id, string Name, string? Description, int PermissionCount, int PositionAssignmentCount, int EmployeeAssignmentCount);
    private sealed record PermissionRow(Guid Id, string Code, string Name);
    private sealed record PermissionGroupView(string Title, IReadOnlyList<PermissionRow> Items);
}
