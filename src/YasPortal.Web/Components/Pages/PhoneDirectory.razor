@page "/phone-book"
@using Microsoft.AspNetCore.Authorization
@using YasPortal.Domain.PhoneBook
@using YasPortal.Infrastructure.PhoneBook
@using YasPortal.Web.Components.Shared
@attribute [Authorize(Policy = Perm.PhoneBookDirectoryView)]
@inject PhoneBookProvider Provider

<PageTitle>دفترچه تلفن - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <div class="page-header">
        <div>
            <div class="page-kicker">دسترسی سریع</div>
            <h1 class="page-title"><i class="ti @Icons.PhoneBook"></i> دفترچه تلفن</h1>
            <p class="page-subtitle">شماره‌های داخلی و تماس. در همه گروه‌ها جستجو کنید یا یک گروه را باز کنید و فقط در همان گروه بگردید.</p>
        </div>
    </div>

    @if (_tree is null)
    {
        <LoadingState />
    }
    else
    {
        <PhoneBookView Tree="_tree" />
    }
</div>

@code {
    private PhoneBookTree? _tree;

    protected override async Task OnInitializedAsync() => _tree = await Provider.GetTreeAsync();
}
