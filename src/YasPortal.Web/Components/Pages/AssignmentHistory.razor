@page "/admin/assignment-history"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Services
@using YasPortal.Web.Components.Shared
@attribute [Authorize(Policy = "Admin.AssignmentHistory")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AdminQueryService AdminQueries

<PageTitle>سوابق تخصیص سمت‌ها - یاس پورتال</PageTitle>

<div dir="rtl" class="history-page">
    <div class="page-header">
        <div>
            <div class="page-subtitle">مدیریت سامانه / سمت‌ها / سوابق</div>
            <h1 class="page-title">سوابق تخصیص سمت‌ها</h1>
            <p class="page-subtitle">تاریخچه کامل حضور کارکنان در سمت‌ها؛ شامل تخصیص‌های قبلی، آزادسازی و تخصیص مجدد.</p>
        </div>
        <div class="form-actions">
            <a class="btn btn-secondary" href="/admin/positions"><i class="bx bx-sitemap"></i> مدیریت سمت‌ها</a>
        </div>
    </div>

    <section class="card filters-card">
        <div class="filters-head">
            <div>
                <h2 class="section-title"><i class="bx bx-filter-alt"></i> فیلتر سوابق</h2>
                <p class="muted">برای دیتابیس‌های بزرگ فقط رکوردهای موردنیاز را دریافت کنید.</p>
            </div>
            <button class="btn btn-secondary btn-sm" @onclick="ResetFilters">پاک کردن فیلترها</button>
        </div>
        <div class="filters-grid">
            <div>
                <label class="form-label">کارمند</label>
                <ServerSearchableGuidSelect Value="@_employeeId" ValueChanged="EmployeeChanged" SearchAsync="SearchEmployeesAsync" SelectedText="@_employeeName" Placeholder="همه کارکنان" SearchPlaceholder="نام یا نام کاربری را جستجو کنید..." />
            </div>
            <div>
                <label class="form-label">سمت</label>
                <ServerSearchableGuidSelect Value="@_positionId" ValueChanged="PositionChanged" SearchAsync="SearchPositionsAsync" SelectedText="@_positionName" Placeholder="همه سمت‌ها" SearchPlaceholder="نام سمت را جستجو کنید..." />
            </div>
            <div>
                <label class="form-label">وضعیت</label>
                <select class="form-control" @bind="_status">
                    <option value="all">همه سوابق</option>
                    <option value="active">فقط تخصیص‌های فعال</option>
                    <option value="ended">فقط سوابق پایان‌یافته</option>
                </select>
            </div>
            <div class="filter-action">
                <button class="btn btn-primary" disabled="@_loading" @onclick="LoadAsync"><i class="bx bx-search"></i> جستجو</button>
            </div>
        </div>
    </section>

    <section class="card history-card">
        <div class="section-head">
            <div>
                <h2 class="section-title"><i class="bx bx-history"></i> تاریخچه</h2>
                <p class="muted">@_total رکورد</p>
            </div>
            <div class="page-size">
                <span class="muted">نمایش</span>
                <select class="form-control compact-select" @bind="_pageSize" @bind:after="ReloadFirstPageAsync">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <span class="muted">رکورد</span>
            </div>
        </div>

        @if (_loading)
        {
            <div class="empty-state"><i class="bx bx-loader-alt bx-spin"></i><span>در حال بارگذاری سوابق...</span></div>
        }
        else if (_rows.Count == 0)
        {
            <div class="empty-state"><i class="bx bx-history empty-icon"></i><strong>سابقه‌ای پیدا نشد</strong><span>فیلترها را تغییر دهید یا اولین تخصیص را از صفحه سمت‌ها انجام دهید.</span></div>
        }
        else
        {
            <div class="history-table-wrap">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>کارمند</th>
                            <th>سمت</th>
                            <th>شروع تخصیص</th>
                            <th>پایان تخصیص</th>
                            <th>وضعیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _rows)
                        {
                            <tr>
                                <td>
                                    <div class="person-cell">
                                        <span class="avatar"><i class="bx bx-user"></i></span>
                                        <span><strong>@row.EmployeeName</strong><small>@row.Username</small></span>
                                    </div>
                                </td>
                                <td><span class="position-cell"><i class="bx bx-briefcase"></i>@row.PositionName</span></td>
                                <td>@FormatDate(row.StartedAt)</td>
                                <td>@FormatDate(row.EndedAt)</td>
                                <td>
                                    @if (row.EndedAt is null)
                                    {
                                        <span class="status-pill active"><i class="bx bx-check-circle"></i> فعال</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill ended"><i class="bx bx-history"></i> پایان‌یافته</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_totalPages > 1)
            {
                <div class="pager">
                    <button class="btn btn-secondary btn-sm" disabled="@(_page <= 1)" @onclick="PreviousPage"><i class="bx bx-chevron-right"></i> قبلی</button>
                    <span>صفحه @_page از @_totalPages</span>
                    <button class="btn btn-secondary btn-sm" disabled="@(_page >= _totalPages)" @onclick="NextPage">بعدی <i class="bx bx-chevron-left"></i></button>
                </div>
            }
        }
    </section>

    <section class="info-grid">
        <div class="info-card"><i class="bx bx-user"></i><div><strong>سابقه کارکنان</strong><span>با انتخاب کارمند، تمام سمت‌هایی که در طول زمان داشته نمایش داده می‌شود.</span></div></div>
        <div class="info-card"><i class="bx bx-sitemap"></i><div><strong>سابقه سمت‌ها</strong><span>با انتخاب سمت، تمام کارکنانی که در آن سمت بوده‌اند نمایش داده می‌شود.</span></div></div>
        <div class="info-card"><i class="bx bx-shield-quarter"></i><div><strong>تخصیص فعال</strong><span>هر سمت همچنان فقط یک کارمند فعال دارد؛ سابقه فقط اطلاعات تاریخی را نگه می‌دارد.</span></div></div>
    </section>
</div>

@code {
    private List<HistoryRow> _rows = [];
    private Guid? _employeeId;
    private Guid? _positionId;
    private string _employeeName = "";
    private string _positionName = "";
    private string _status = "all";
    private int _page = 1;
    private int _pageSize = 50;
    private int _total;
    private int _totalPages = 1;
    private bool _loading;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var query = db.PositionAssignmentHistories.AsNoTracking().AsQueryable();

            if (_employeeId is Guid employeeId)
                query = query.Where(x => x.EmployeeId == employeeId);
            if (_positionId is Guid positionId)
                query = query.Where(x => x.PositionId == positionId);
            if (_status == "active")
                query = query.Where(x => x.EndedAt == null);
            else if (_status == "ended")
                query = query.Where(x => x.EndedAt != null);

            _total = await query.CountAsync();
            _totalPages = Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));
            _page = Math.Min(_page, _totalPages);

            _rows = await query
                .OrderByDescending(x => x.StartedAt ?? DateTime.MinValue)
                .ThenByDescending(x => x.EndedAt ?? DateTime.MaxValue)
                .Skip((_page - 1) * _pageSize)
                .Take(_pageSize)
                .Select(x => new HistoryRow(
                    x.Id,
                    x.Employee.FullName,
                    x.Employee.Username,
                    x.Position.Name,
                    x.StartedAt,
                    x.EndedAt))
                .ToListAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchEmployeesAsync(string search, CancellationToken ct) => AdminQueries.SearchEmployeesAsync(search, ct);
    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchPositionsAsync(string search, CancellationToken ct) => AdminQueries.SearchPositionsAsync(search, null, null, ct);

    private Task EmployeeChanged(Guid? id)
    {
        _employeeId = id;
        _employeeName = id is null ? "" : _employeeName;
        return Task.CompletedTask;
    }

    private Task PositionChanged(Guid? id)
    {
        _positionId = id;
        _positionName = id is null ? "" : _positionName;
        return Task.CompletedTask;
    }

    private async Task ResetFilters()
    {
        _employeeId = null;
        _positionId = null;
        _employeeName = "";
        _positionName = "";
        _status = "all";
        _page = 1;
        await LoadAsync();
    }

    private async Task ReloadFirstPageAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task PreviousPage()
    {
        if (_page <= 1) return;
        _page--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        if (_page >= _totalPages) return;
        _page++;
        await LoadAsync();
    }

    private static string FormatDate(DateTime? value) => value is null ? "—" : value.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm");

    private sealed record HistoryRow(Guid Id, string EmployeeName, string Username, string PositionName, DateTime? StartedAt, DateTime? EndedAt);
}

<style>
.history-page{max-width:1450px;margin:0 auto}
.filters-card,.history-card{margin-bottom:16px}
.filters-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:16px}
.filters-grid{display:grid;grid-template-columns:minmax(230px,1fr) minmax(230px,1fr) 180px auto;gap:12px;align-items:end}
.filter-action{display:flex;align-items:end}
.filter-action .btn{height:42px}
.history-card .section-head{margin-bottom:12px}
.page-size{display:flex;align-items:center;gap:7px}
.compact-select{width:78px!important;min-width:78px}
.history-table-wrap{overflow:auto;border:1px solid #eaecf0;border-radius:12px}
.history-table{width:100%;border-collapse:collapse;min-width:780px;background:#fff}
.history-table th{padding:11px 14px;text-align:right;background:#f8fafc;color:#475467;font-size:11px;font-weight:700;border-bottom:1px solid #eaecf0;white-space:nowrap}
.history-table td{padding:12px 14px;border-bottom:1px solid #f2f4f7;color:#344054;font-size:12px;vertical-align:middle}
.history-table tbody tr:last-child td{border-bottom:0}
.history-table tbody tr:hover{background:#fcfcfd}
.person-cell{display:flex;align-items:center;gap:9px;min-width:190px}
.person-cell>span:last-child{display:flex;flex-direction:column;gap:2px}
.person-cell small{color:#98a2b3;font-size:10px;direction:ltr;text-align:right}
.avatar{width:34px;height:34px;border-radius:9px;display:grid;place-items:center;background:#f2f4f7;color:#475467;flex:0 0 auto}
.position-cell{display:inline-flex;align-items:center;gap:6px;font-weight:600}
.position-cell i{color:#667085}
.status-pill{display:inline-flex;align-items:center;gap:5px;padding:5px 8px;border-radius:999px;font-size:10px;font-weight:700;white-space:nowrap}
.status-pill.active{background:#ecfdf3;color:#027a48}
.status-pill.ended{background:#f2f4f7;color:#667085}
.pager{display:flex;justify-content:center;align-items:center;gap:12px;padding-top:14px;font-size:12px;color:#667085}
.info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.info-card{display:flex;gap:10px;align-items:flex-start;padding:14px;border:1px solid #eaecf0;border-radius:12px;background:#fff}
.info-card>i{font-size:21px;color:#475467}
.info-card div{display:flex;flex-direction:column;gap:4px}
.info-card span{font-size:11px;line-height:1.7;color:#667085}
.empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;min-height:220px;color:#667085}
.empty-icon{font-size:34px}
@@media (max-width:1000px){.filters-grid{grid-template-columns:1fr 1fr}.filter-action{grid-column:1/-1}.info-grid{grid-template-columns:1fr}}
@@media (max-width:650px){.filters-grid{grid-template-columns:1fr}.filters-head{flex-direction:column}.page-size{display:none}}
</style>
