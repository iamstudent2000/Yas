@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Policy = "Dashboard.View")]

<PageTitle>داشبورد - یاس پورتال</PageTitle>

<AuthorizeView Context="auth">
    <Authorized>
        @{
            var isAdmin = auth.User.HasClaim("yas_is_admin", "True");
            var name = auth.User.Identity?.Name ?? "کاربر";
            var activePosition = auth.User.FindFirst("yas_active_position_name")?.Value;
        }
        <div class="dashboard-page">
            <div class="page-header">
                <div>
                    <h1 class="page-title">داشبورد</h1>
                    <p class="page-subtitle">@(isAdmin ? "مدیریت و نظارت بر سامانه" : "نمای کلی حساب و دسترسی‌های شما")</p>
                </div>
                <span class="badge badge-success"><i class="bx bx-check-circle"></i> حساب فعال</span>
            </div>

            <section class="dash-hero">
                <svg class="dash-hero-bloom" viewBox="0 0 100 100" aria-hidden="true">
                    <use href="#jasmine-bloom-outline" />
                </svg>
                <div class="dash-hero-text">
                    <p class="dash-hero-greeting">@GetGreeting()،</p>
                    <h2>@name</h2>
                    <p class="dash-hero-role">@(isAdmin ? "شما به‌عنوان مدیر سامانه وارد شده‌اید." : "خوش آمدید؛ در ادامه وضعیت حساب شما آمده است.")</p>
                </div>
                @if (isAdmin)
                {
                    <div class="dash-hero-position">
                        <span>سطح دسترسی</span>
                        <strong>مدیریت سامانه</strong>
                        <a href="/admin/organizations">مدیریت سازمان‌ها <i class="bx bx-left-arrow-alt"></i></a>
                    </div>
                }
                else
                {
                    <div class="dash-hero-position">
                        <span>سمت فعال</span>
                        <strong>@(activePosition ?? "انتخاب نشده")</strong>
                        <a href="/my-positions">تغییر سمت <i class="bx bx-left-arrow-alt"></i></a>
                    </div>
                }
            </section>

            <div class="dash-columns">
                <section class="dash-facts">
                    <div class="dash-fact">
                        <i class="bx bx-user"></i>
                        <div><span>حساب کاربری</span><strong>@name</strong></div>
                    </div>
                    <div class="dash-fact">
                        <i class="bx bx-shield-check"></i>
                        <div><span>سطح دسترسی</span><strong>@(isAdmin ? "مدیریت سامانه" : "کاربر سامانه")</strong></div>
                    </div>
                    @if (!isAdmin)
                    {
                        <div class="dash-fact">
                            <i class="bx bx-id-card"></i>
                            <div><span>سمت فعال</span><strong>@(activePosition ?? "انتخاب نشده")</strong></div>
                        </div>
                    }
                </section>

                <section class="dash-links">
                    <h2 class="section-title">دسترسی سریع</h2>
                    <a class="dash-link" href="/my-profile">
                        <span class="dash-link-icon"><i class="bx bx-user-circle"></i></span>
                        <span class="dash-link-text"><strong>پروفایل من</strong><small>مشاهده اطلاعات حساب و سازمان</small></span>
                        <i class="bx bx-left-arrow-alt dash-link-arrow"></i>
                    </a>
                    @if (!isAdmin)
                    {
                        <a class="dash-link" href="/my-positions">
                            <span class="dash-link-icon"><i class="bx bx-id-card"></i></span>
                            <span class="dash-link-text"><strong>سمت‌های من</strong><small>انتخاب سمت فعال</small></span>
                            <i class="bx bx-left-arrow-alt dash-link-arrow"></i>
                        </a>
                    }
                    @if (isAdmin)
                    {
                        <a class="dash-link" href="/admin/organizations">
                            <span class="dash-link-icon"><i class="bx bx-buildings"></i></span>
                            <span class="dash-link-text"><strong>سازمان‌ها</strong><small>مدیریت ساختار سازمانی</small></span>
                            <i class="bx bx-left-arrow-alt dash-link-arrow"></i>
                        </a>
                    }
                </section>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private static string GetGreeting() => DateTime.Now.Hour switch
    {
        >= 5 and < 12 => "صبح بخیر",
        >= 12 and < 17 => "ظهر بخیر",
        >= 17 and < 20 => "عصر بخیر",
        _ => "شب بخیر",
    };
}
