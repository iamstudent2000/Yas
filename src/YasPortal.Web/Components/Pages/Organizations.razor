@page "/organizations"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using YasPortal.Domain.Organization
@using YasPortal.Infrastructure.Persistence
@attribute [Authorize(Policy = "Admin.Organizations")]
@inject ApplicationDbContext Db

<PageTitle>سازمان‌ها - یاس پورتال</PageTitle>

<div dir="rtl" class="card">
    <h1>مدیریت سازمان‌ها</h1>
    <p style="color:#667085;">ایجاد، ویرایش، فعال‌سازی و غیرفعال‌سازی سازمان‌ها و تعیین سازمان کارکنان</p>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert">@_message</div>
    }

    <section class="card" style="box-shadow:none;background:#f8fafc;margin-top:20px;">
        <h2>@(_editingId is null ? "سازمان جدید" : "ویرایش سازمان")</h2>
        <label style="display:block;margin:12px 0 6px;font-weight:700;">نام سازمان</label>
        <input @bind="_name" maxlength="200" style="width:100%;box-sizing:border-box;padding:11px;border:1px solid #d0d5dd;border-radius:10px;" />
        <div style="display:flex;gap:10px;margin-top:14px;">
            <button @onclick="SaveOrganization" style="padding:10px 18px;border:0;border-radius:10px;background:#1769aa;color:white;font-weight:700;cursor:pointer;">ذخیره</button>
            @if (_editingId is not null)
            {
                <button @onclick="CancelEdit" style="padding:10px 18px;border:1px solid #d0d5dd;border-radius:10px;background:white;cursor:pointer;">انصراف</button>
            }
        </div>
    </section>

    <h2 style="margin-top:30px;">سازمان‌ها</h2>
    @foreach (var organization in _organizations ?? [])
    {
        <div class="card" style="box-shadow:none;border:1px solid #e8edf3;display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:12px;">
            <div>
                <strong style="font-size:18px;">@organization.Name</strong>
                <div style="color:#667085;margin-top:5px;">@organization.EmployeeCount کارمند</div>
            </div>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                <span style="font-weight:700;">@(organization.IsActive ? "فعال" : "غیرفعال")</span>
                <button @onclick="() => BeginEdit(organization.Id)">ویرایش</button>
                <button @onclick="() => ToggleOrganization(organization.Id)">@(organization.IsActive ? "غیرفعال کردن" : "فعال کردن")</button>
            </div>
        </div>
    }

    <hr style="margin:30px 0;border:0;border-top:1px solid #eaecf0;" />
    <h2>تعیین سازمان کارکنان</h2>
    <p style="color:#667085;">هر کارمند دقیقاً یک سازمان دارد. تغییر سازمان، سازمان قبلی را جایگزین می‌کند.</p>

    @foreach (var employee in _employees ?? [])
    {
        <div class="card" style="box-shadow:none;border:1px solid #e8edf3;display:grid;grid-template-columns:1fr 1fr auto;gap:12px;align-items:center;margin-bottom:10px;">
            <div><strong>@employee.FullName</strong><div style="font-size:13px;color:#667085;">@employee.Username</div></div>
            <select value="@employee.OrganizationId" @onchange="e => ChangeEmployeeOrganization(employee.Id, e.Value?.ToString())" style="padding:10px;border:1px solid #d0d5dd;border-radius:10px;">
                @foreach (var organization in _organizations.Where(x => x.IsActive))
                {
                    <option value="@organization.Id">@organization.Name</option>
                }
            </select>
            <span>@(employee.IsActive ? "فعال" : "غیرفعال")</span>
        </div>
    }
</div>

@code {
    private List<OrganizationItem> _organizations = [];
    private List<EmployeeItem> _employees = [];
    private Guid? _editingId;
    private string _name = string.Empty;
    private string? _message;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _organizations = await Db.Organizations.AsNoTracking().OrderBy(x => x.Name)
            .Select(x => new OrganizationItem(x.Id, x.Name, x.IsActive, x.Employees.Count)).ToListAsync();
        _employees = await Db.Employees.AsNoTracking().OrderBy(x => x.FullName)
            .Select(x => new EmployeeItem(x.Id, x.Username, x.FullName, x.OrganizationId, x.IsActive)).ToListAsync();
    }

    private void BeginEdit(Guid id)
    {
        var organization = _organizations.Single(x => x.Id == id);
        _editingId = id;
        _name = organization.Name;
        _message = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _name = string.Empty;
    }

    private async Task SaveOrganization()
    {
        var name = _name.Trim();
        if (string.IsNullOrWhiteSpace(name)) { _message = "نام سازمان الزامی است."; return; }
        if (await Db.Organizations.AnyAsync(x => x.Name == name && x.Id != (_editingId ?? Guid.Empty))) { _message = "سازمانی با این نام قبلاً ثبت شده است."; return; }

        if (_editingId is Guid id)
        {
            var organization = await Db.Organizations.SingleAsync(x => x.Id == id);
            organization.Rename(name);
            _message = "سازمان با موفقیت ویرایش شد.";
        }
        else
        {
            Db.Organizations.Add(new Organization(name));
            _message = "سازمان جدید با موفقیت ایجاد شد.";
        }
        await Db.SaveChangesAsync();
        CancelEdit();
        await LoadAsync();
    }

    private async Task ToggleOrganization(Guid id)
    {
        var organization = await Db.Organizations.SingleAsync(x => x.Id == id);
        if (organization.IsActive) organization.Deactivate(); else organization.Activate();
        await Db.SaveChangesAsync();
        _message = organization.IsActive ? "سازمان فعال شد." : "سازمان غیرفعال شد.";
        await LoadAsync();
    }

    private async Task ChangeEmployeeOrganization(Guid employeeId, string? value)
    {
        if (!Guid.TryParse(value, out var organizationId)) return;
        var organization = await Db.Organizations.SingleOrDefaultAsync(x => x.Id == organizationId && x.IsActive);
        if (organization is null) { _message = "فقط می‌توان کارمند را به یک سازمان فعال اختصاص داد."; return; }
        var employee = await Db.Employees.SingleAsync(x => x.Id == employeeId);
        employee.ChangeOrganization(organization.Id);
        await Db.SaveChangesAsync();
        _message = $"سازمان «{organization.Name}» برای کارمند ثبت شد.";
        await LoadAsync();
    }

    private sealed record OrganizationItem(Guid Id, string Name, bool IsActive, int EmployeeCount);
    private sealed record EmployeeItem(Guid Id, string Username, string FullName, Guid OrganizationId, bool IsActive);
}
