@page "/admin/organizations"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using YasPortal.Domain.Organization
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Services
@attribute [Authorize(Policy = "Admin.Organizations")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AppState AppState

<PageTitle>سازمان‌ها - یاس پورتال</PageTitle>

<div class="page-header">
    <div><div class="page-subtitle">مدیریت سامانه / سازمان‌ها</div><h1 class="page-title">مدیریت سازمان‌ها</h1><p class="page-subtitle">ایجاد سازمان، تغییر وضعیت و تعیین سازمان هر کارمند</p></div>
    <a class="btn btn-secondary" href="/dashboard"><i class="bx bx-arrow-back"></i> داشبورد</a>
</div>

<div class="stat-grid">
    <div class="stat-card"><div class="stat-icon"><i class="bx bx-buildings"></i></div><span class="stat-label">کل سازمان‌ها</span><strong class="stat-value">@_organizations.Count</strong></div>
    <div class="stat-card"><div class="stat-icon"><i class="bx bx-check-circle"></i></div><span class="stat-label">سازمان‌های فعال</span><strong class="stat-value">@_organizations.Count(x => x.IsActive)</strong></div>
    <div class="stat-card"><div class="stat-icon"><i class="bx bx-group"></i></div><span class="stat-label">کل کارکنان</span><strong class="stat-value">@_employees.Count</strong></div>
</div>

<div class="organization-grid">
    <section class="card">
        <h2 class="section-title"><i class="bx bx-plus-circle"></i> @(_editingId is null ? "ایجاد سازمان جدید" : "ویرایش سازمان")</h2>
        <label class="form-label">نام سازمان</label><input class="form-control" @bind="_name" maxlength="200" placeholder="مثلاً معاونت منابع انسانی" />
        <div class="form-actions"><button class="btn btn-primary" @onclick="SaveOrganization"><i class="bx bx-save"></i> @(_editingId is null ? "ایجاد سازمان" : "ذخیره")</button>@if (_editingId is not null){<button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button>}</div>
    </section>
    <section class="card table-card">
        <div class="table-toolbar"><h2 class="section-title" style="margin:0;">فهرست سازمان‌ها</h2></div>
        @if (_organizations.Count == 0){<div class="empty-state"><div class="empty-icon"><i class="bx bx-buildings"></i></div><strong>سازمانی ثبت نشده است</strong></div>}
        else{<div class="data-table-wrap"><table class="data-table"><thead><tr><th>سازمان</th><th>کارکنان</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>@foreach(var organization in _organizations){<tr><td><strong>@organization.Name</strong></td><td>@organization.EmployeeCount نفر</td><td><span class="badge @(organization.IsActive ? "badge-success" : "badge-muted")"><i class="bx @(organization.IsActive ? "bx-check-circle" : "bx-minus-circle")"></i> @(organization.IsActive ? "فعال" : "غیرفعال")</span></td><td class="action-cell"><button class="btn btn-secondary btn-sm" @onclick="() => BeginEdit(organization.Id)"><i class="bx bx-edit-alt"></i> ویرایش</button>@if(organization.IsActive && organization.EmployeeCount > 0){<button class="btn btn-disabled btn-sm" disabled title="تا زمانی که کارمندی به این سازمان وابسته است، امکان غیرفعال‌سازی وجود ندارد"><i class="bx bx-lock-alt"></i> غیرفعال کردن</button>}else{<button class="btn @(organization.IsActive ? "btn-danger" : "btn-primary") btn-sm" @onclick="() => ToggleOrganization(organization.Id)"><i class="bx @(organization.IsActive ? "bx-pause-circle" : "bx-play-circle")"></i> @(organization.IsActive ? "غیرفعال کردن" : "فعال کردن")</button>}</td></tr>}</tbody></table></div>}
    </section>
</div>

<section class="card organization-assignment">
    <div class="page-header compact-header"><div><h2 class="section-title" style="margin:0;">تخصیص سازمان به کارکنان</h2><p class="page-subtitle">هر کارمند دقیقاً یک سازمان دارد و تغییر انتخاب، سازمان قبلی را جایگزین می‌کند.</p></div><span class="badge badge-muted"><i class="bx bx-link"></i> یک سازمان برای هر کارمند</span></div>
    <div class="employee-list">@foreach(var employee in _employees){var currentOrganization=_organizations.FirstOrDefault(x=>x.Id==employee.OrganizationId);<div class="employee-row" @key="employee.Id"><div class="employee-info"><div class="employee-avatar">@GetInitial(employee.FullName)</div><div><strong>@employee.FullName</strong><span>@employee.Username</span></div></div><select @key="GetOrganizationSelectKey(employee)" class="form-control" value="@employee.OrganizationId" @onchange="e=>ChangeEmployeeOrganization(employee.Id,e.Value?.ToString())">@if(currentOrganization is not null && !currentOrganization.IsActive){<option value="@currentOrganization.Id">@currentOrganization.Name (غیرفعال - سازمان فعلی)</option>}@foreach(var organization in _organizations.Where(x=>x.IsActive)){<option value="@organization.Id">@organization.Name</option>}</select><span class="badge @(employee.IsActive ? "badge-success" : "badge-muted")">@(employee.IsActive ? "فعال" : "غیرفعال")</span></div>}</div>
</section>

@code {
    private List<OrganizationItem> _organizations=[];
    private List<EmployeeItem> _employees=[];
    private Guid? _editingId;
    private string _name=string.Empty;
    private long _organizationListVersion;

    protected override async Task OnInitializedAsync()=>await LoadAsync();
    private async Task LoadAsync(){await using var db=await DbFactory.CreateDbContextAsync();_organizations=await db.Organizations.AsNoTracking().OrderBy(x=>x.Name).Select(x=>new OrganizationItem(x.Id,x.Name,x.IsActive,x.Employees.Count)).ToListAsync();_employees=await db.Employees.AsNoTracking().OrderBy(x=>x.FullName).Select(x=>new EmployeeItem(x.Id,x.Username,x.FullName,x.OrganizationId,x.IsActive)).ToListAsync();_organizationListVersion++;}
    private string GetOrganizationSelectKey(EmployeeItem employee)=>$"{employee.Id:N}:{employee.OrganizationId:N}:{_organizationListVersion}";
    private void BeginEdit(Guid id){var x=_organizations.Single(x=>x.Id==id);_editingId=id;_name=x.Name;} private void CancelEdit(){_editingId=null;_name=string.Empty;}
    private async Task SaveOrganization(){var name=_name.Trim();if(string.IsNullOrWhiteSpace(name)){AppState.AddToast("نام سازمان الزامی است.",ToastLevel.Error);return;}await using var db=await DbFactory.CreateDbContextAsync();if(await db.Organizations.AnyAsync(x=>x.Name==name&&x.Id!=(_editingId??Guid.Empty))){AppState.AddToast("سازمانی با این نام قبلاً ثبت شده است.",ToastLevel.Error);return;}if(_editingId is Guid id){(await db.Organizations.SingleAsync(x=>x.Id==id)).Rename(name);AppState.AddToast("سازمان با موفقیت ویرایش شد.",ToastLevel.Success);}else{db.Organizations.Add(new Organization(name));AppState.AddToast("سازمان جدید با موفقیت ایجاد شد.",ToastLevel.Success);}await db.SaveChangesAsync();CancelEdit();await LoadAsync();}
    private async Task ToggleOrganization(Guid id){await using var db=await DbFactory.CreateDbContextAsync();var x=await db.Organizations.Include(o=>o.Employees).SingleAsync(x=>x.Id==id);if(x.IsActive&&x.Employees.Any()){AppState.AddToast("این سازمان دارای کارمند است و تا زمان انتقال کارکنان قابل غیرفعال‌سازی نیست.",ToastLevel.Error);return;}if(x.IsActive)x.Deactivate();else x.Activate();await db.SaveChangesAsync();AppState.AddToast(x.IsActive?"سازمان فعال شد.":"سازمان غیرفعال شد.",ToastLevel.Success);await LoadAsync();}
    private async Task ChangeEmployeeOrganization(Guid employeeId,string? value){if(!Guid.TryParse(value,out var organizationId))return;await using var db=await DbFactory.CreateDbContextAsync();var organization=await db.Organizations.SingleOrDefaultAsync(x=>x.Id==organizationId&&x.IsActive);if(organization is null){AppState.AddToast("فقط سازمان فعال قابل انتخاب است.",ToastLevel.Error);await LoadAsync();return;}var employee=await db.Employees.SingleAsync(x=>x.Id==employeeId);employee.ChangeOrganization(organization.Id);await db.SaveChangesAsync();AppState.AddToast($"سازمان «{organization.Name}» برای کارمند ثبت شد.",ToastLevel.Success);await LoadAsync();}
    private static string GetInitial(string value)=>string.IsNullOrWhiteSpace(value)?"ک":value.Trim()[0].ToString();
    private sealed record OrganizationItem(Guid Id,string Name,bool IsActive,int EmployeeCount); private sealed record EmployeeItem(Guid Id,string Username,string FullName,Guid OrganizationId,bool IsActive);
}

<style>
.organization-grid{display:grid;grid-template-columns:minmax(260px,320px) 1fr;gap:16px;align-items:start}.data-table-wrap{overflow:auto}.employee-list{border:1px solid #e6ebf2;border-radius:12px;overflow:hidden}.employee-row{display:grid;grid-template-columns:1fr 280px 80px;align-items:center;gap:14px;padding:11px 14px;border-bottom:1px solid #edf0f4}.employee-row:last-child{border-bottom:0}.employee-info{display:flex;align-items:center;gap:10px}.employee-avatar{width:36px;height:36px;border-radius:10px;background:#eef4ff;color:#155eef;display:grid;place-items:center;font-weight:700}.employee-info strong{display:block;font-size:13px}.employee-info span{display:block;color:#667085;font-size:11px;margin-top:2px}.action-cell{white-space:nowrap}.btn-sm{padding:7px 10px;font-size:12px}.btn-disabled{background:#f2f4f7;color:#98a2b3;border:1px solid #eaecf0;cursor:not-allowed}.form-actions{display:flex;gap:8px;margin-top:13px}.compact-header{margin-bottom:15px}.empty-state{text-align:center;padding:35px;color:#667085}.empty-icon{font-size:34px;margin-bottom:8px;color:#98a2b3}
@@media(max-width:900px){.organization-grid{grid-template-columns:1fr}.employee-row{grid-template-columns:1fr}.employee-row .badge{justify-self:start}}
</style>
