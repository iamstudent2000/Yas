@page "/admin/organizations"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using YasPortal.Domain.Organization
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Services
@using YasPortal.Web.Components.Shared
@attribute [Authorize(Policy = "Admin.Organizations")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AdminQueryService AdminQueries
@inject AppState AppState

<PageTitle>سازمان‌ها - یاس پورتال</PageTitle>

<div class="page-header"><div><div class="page-subtitle">مدیریت سامانه / سازمان‌ها</div><h1 class="page-title">مدیریت سازمان‌ها</h1><p class="page-subtitle">ایجاد سازمان، تغییر وضعیت و تعیین سازمان هر کارمند</p></div><a class="btn btn-secondary" href="/dashboard"><i class="bx bx-arrow-back"></i> داشبورد</a></div>

<div class="stat-grid"><div class="stat-card"><div class="stat-icon"><i class="bx bx-buildings"></i></div><span class="stat-label">کل سازمان‌ها</span><strong class="stat-value">@_organizationTotal</strong></div><div class="stat-card"><div class="stat-icon"><i class="bx bx-check-circle"></i></div><span class="stat-label">سازمان‌های فعال</span><strong class="stat-value">@_activeOrganizationCount</strong></div><div class="stat-card"><div class="stat-icon"><i class="bx bx-group"></i></div><span class="stat-label">کل کارکنان</span><strong class="stat-value">@_employeeTotal</strong></div></div>

<div class="organization-grid">
    <section class="card"><h2 class="section-title"><i class="bx bx-plus-circle"></i> @(_editingId is null ? "ایجاد سازمان جدید" : "ویرایش سازمان")</h2><label class="form-label">نام سازمان</label><input class="form-control" @bind="_name" maxlength="200" placeholder="مثلاً معاونت منابع انسانی" /><div class="form-actions"><button class="btn btn-primary" @onclick="SaveOrganization"><i class="bx bx-save"></i> @(_editingId is null ? "ایجاد سازمان" : "ذخیره")</button>@if(_editingId is not null){<button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button>}</div></section>
    <section class="card table-card">
        <div class="table-toolbar"><div><h2 class="section-title" style="margin:0">فهرست سازمان‌ها</h2><p class="muted">جستجو و صفحه‌بندی در SQL Server انجام می‌شود.</p></div><div class="toolbar-search"><i class="bx bx-search"></i><input class="form-control" placeholder="نام سازمان..." @bind="_organizationSearch" @bind:event="oninput" @onkeyup="OrganizationSearchChanged" /></div></div>
        @if(_organizationLoading){<div class="empty-state">در حال بارگذاری...</div>}else if(_organizations.Count==0){<div class="empty-state"><div class="empty-icon"><i class="bx bx-buildings"></i></div><strong>سازمانی پیدا نشد</strong></div>}else{<div class="data-table-wrap"><table class="data-table"><thead><tr><th>سازمان</th><th>کارکنان</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>@foreach(var organization in _organizations){<tr><td><strong>@organization.Name</strong></td><td>@organization.EmployeeCount نفر</td><td><span class="badge @(organization.IsActive?"badge-success":"badge-muted")">@(organization.IsActive?"فعال":"غیرفعال")</span></td><td class="action-cell"><button class="btn btn-secondary btn-sm" @onclick="()=>BeginEdit(organization)"><i class="bx bx-edit-alt"></i> ویرایش</button><button class="btn @(organization.IsActive?"btn-danger":"btn-primary") btn-sm" @onclick="()=>ToggleOrganization(organization.Id)"><i class="bx @(organization.IsActive?"bx-pause-circle":"bx-play-circle")"></i> @(organization.IsActive?"غیرفعال کردن":"فعال کردن")</button></td></tr>}</tbody></table></div>}
        <ServerPagination Page="@_organizationPage" PageSize="@PageSize" TotalCount="@_organizationTotal" Busy="@_organizationLoading" PageChanged="OrganizationPageChanged" />
    </section>
</div>

<section class="card organization-assignment">
    <div class="page-header compact-header"><div><h2 class="section-title" style="margin:0;">تخصیص سازمان به کارکنان</h2><p class="page-subtitle">کارمند را جستجو کنید؛ فقط صفحه جاری از کارکنان به مرورگر ارسال می‌شود.</p></div></div>
    <div class="table-toolbar"><div></div><div class="toolbar-search"><i class="bx bx-search"></i><input class="form-control" placeholder="نام یا نام کاربری کارمند..." @bind="_employeeSearch" @bind:event="oninput" @onkeyup="EmployeeSearchChanged" /></div></div>
    @if(_employeeLoading){<div class="empty-state">در حال بارگذاری...</div>}else{<div class="employee-list">@foreach(var employee in _employees){<div class="employee-row"><div class="employee-info"><div class="employee-avatar">@GetInitial(employee.FullName)</div><div><strong>@employee.FullName</strong><span>@employee.Username</span></div></div><ServerSearchableGuidSelect Value="@GetEmployeeOrganization(employee.Id)" ValueChanged="id=>ChangeEmployeeOrganization(employee.Id,id)" SearchAsync="SearchOrganizationsAsync" SelectedText="@employee.OrganizationName" Placeholder="انتخاب سازمان" SearchPlaceholder="نام سازمان..." /><span class="badge @(employee.IsActive?"badge-success":"badge-muted")">@(employee.IsActive?"فعال":"غیرفعال")</span></div>}</div>}
    <ServerPagination Page="@_employeePage" PageSize="@PageSize" TotalCount="@_employeeTotal" Busy="@_employeeLoading" PageChanged="EmployeePageChanged" />
</section>

@code {
    private List<AdminQueryService.OrganizationPageRow> _organizations=[];
    private List<AdminQueryService.EmployeePageRow> _employees=[];
    private Guid? _editingId;
    private string _name=string.Empty,_organizationSearch="",_employeeSearch="";
    private int _organizationPage=1,_employeePage=1,_organizationTotal,_employeeTotal,_activeOrganizationCount;
    private const int PageSize=20;
    private bool _organizationLoading,_employeeLoading;
    private readonly Dictionary<Guid,Guid> _employeeOrganizationIds=[];

    protected override async Task OnInitializedAsync()=>await LoadAsync();
    private async Task LoadAsync(){await LoadOrganizationsAsync();await LoadEmployeesAsync();await LoadStatsAsync();}
    private async Task LoadOrganizationsAsync(){_organizationLoading=true;try{var r=await AdminQueries.GetOrganizationsAsync(_organizationPage,PageSize,_organizationSearch);_organizations=r.Items.ToList();_organizationTotal=r.TotalCount;}finally{_organizationLoading=false;}}
    private async Task LoadEmployeesAsync(){_employeeLoading=true;try{var r=await AdminQueries.GetEmployeesAsync(_employeePage,PageSize,_employeeSearch);_employees=r.Items.ToList();_employeeTotal=r.TotalCount;_employeeOrganizationIds.Clear();await using var db=await DbFactory.CreateDbContextAsync();var ids=_employees.Select(x=>x.Id).ToList();var rows=await db.Employees.AsNoTracking().Where(x=>ids.Contains(x.Id)).Select(x=>new{x.Id,x.OrganizationId}).ToListAsync();foreach(var x in rows)_employeeOrganizationIds[x.Id]=x.OrganizationId;}finally{_employeeLoading=false;}}
    private async Task LoadStatsAsync(){await using var db=await DbFactory.CreateDbContextAsync();_activeOrganizationCount=await db.Organizations.CountAsync(x=>x.IsActive);}
    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchOrganizationsAsync(string search,CancellationToken ct)=>AdminQueries.SearchOrganizationsAsync(search,true,ct);
    private Guid? GetEmployeeOrganization(Guid id)=>_employeeOrganizationIds.TryGetValue(id,out var value)?value:null;
    private async Task OrganizationSearchChanged(KeyboardEventArgs e){if(e.Key is "Enter" or "Tab"||_organizationSearch.Length==0){_organizationPage=1;await LoadOrganizationsAsync();}}
    private async Task EmployeeSearchChanged(KeyboardEventArgs e){if(e.Key is "Enter" or "Tab"||_employeeSearch.Length==0){_employeePage=1;await LoadEmployeesAsync();}}
    private async Task OrganizationPageChanged(int page){_organizationPage=page;await LoadOrganizationsAsync();}
    private async Task EmployeePageChanged(int page){_employeePage=page;await LoadEmployeesAsync();}
    private void BeginEdit(AdminQueryService.OrganizationPageRow x){_editingId=x.Id;_name=x.Name;}
    private void CancelEdit(){_editingId=null;_name=string.Empty;}
    private async Task SaveOrganization(){var name=_name.Trim();if(string.IsNullOrWhiteSpace(name)){AppState.AddToast("نام سازمان الزامی است.",ToastLevel.Error);return;}await using var db=await DbFactory.CreateDbContextAsync();if(await db.Organizations.AnyAsync(x=>x.Name==name&&x.Id!=(_editingId??Guid.Empty))){AppState.AddToast("سازمانی با این نام قبلاً ثبت شده است.",ToastLevel.Error);return;}if(_editingId is Guid id){(await db.Organizations.SingleAsync(x=>x.Id==id)).Rename(name);}else{db.Organizations.Add(new Organization(name));}await db.SaveChangesAsync();await AppState.NotifyDataChangedAsync();AppState.AddToast(_editingId is null?"سازمان جدید ایجاد شد.":"سازمان ویرایش شد.",ToastLevel.Success);CancelEdit();await LoadAsync();}
    private async Task ToggleOrganization(Guid id){await using var db=await DbFactory.CreateDbContextAsync();var x=await db.Organizations.Include(o=>o.Employees).SingleAsync(x=>x.Id==id);if(x.IsActive)x.Deactivate();else x.Activate();await db.SaveChangesAsync();await AppState.NotifyDataChangedAsync();AppState.AddToast(x.IsActive?"سازمان فعال شد.":"سازمان غیرفعال شد.",ToastLevel.Success);await LoadAsync();}
    private async Task ChangeEmployeeOrganization(Guid employeeId,Guid? organizationId){if(organizationId is not Guid oid)return;await using var db=await DbFactory.CreateDbContextAsync();var organization=await db.Organizations.SingleOrDefaultAsync(x=>x.Id==oid&&x.IsActive);if(organization is null){AppState.AddToast("فقط سازمان فعال قابل انتخاب است.",ToastLevel.Error);return;}var employee=await db.Employees.SingleAsync(x=>x.Id==employeeId);employee.ChangeOrganization(oid);await db.SaveChangesAsync();await AppState.NotifyDataChangedAsync();AppState.AddToast($"سازمان «{organization.Name}» ثبت شد.",ToastLevel.Success);await LoadAsync();}
    private static string GetInitial(string value)=>string.IsNullOrWhiteSpace(value)?"ک":value.Trim()[0].ToString();
}

<style>
.organization-grid{display:grid;grid-template-columns:minmax(260px,320px) 1fr;gap:16px;align-items:start}.data-table-wrap{overflow:auto}.employee-list{border:1px solid #e6ebf2;border-radius:12px;overflow:hidden}.employee-row{display:grid;grid-template-columns:1fr 280px 80px;align-items:center;gap:14px;padding:11px 14px;border-bottom:1px solid #edf0f4}.employee-row:last-child{border-bottom:0}.employee-info{display:flex;align-items:center;gap:10px}.employee-avatar{width:36px;height:36px;border-radius:10px;background:#eef4ff;color:#155eef;display:grid;place-items:center;font-weight:700}.employee-info strong{display:block;font-size:13px}.employee-info span{display:block;color:#667085;font-size:11px;margin-top:2px}.action-cell{white-space:nowrap}.btn-sm{padding:7px 10px;font-size:12px}.form-actions{display:flex;gap:8px;margin-top:13px}.compact-header{margin-bottom:15px}.empty-state{text-align:center;padding:35px;color:#667085}.empty-icon{font-size:34px;margin-bottom:8px;color:#98a2b3}@@media(max-width:900px){.organization-grid{grid-template-columns:1fr}.employee-row{grid-template-columns:1fr}.employee-row .badge{justify-self:start}}
</style>
