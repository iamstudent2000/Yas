@page "/guides/{Id:guid}"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using YasPortal.Domain.Guides
@using YasPortal.Infrastructure.Guides
@using YasPortal.Web.Components.Shared
@attribute [AllowAnonymous]
@inject GuideProvider Provider
@inject AuthenticationStateProvider AuthState
@inject IPermissionChecker PermissionChecker
@* Open to everyone, also before sign-in, but a visitor can open only a public guide. A guide that is off, or is for signed-in people
   only, looks exactly like a guide that does not exist. Holders of Admin.Guides.View may open any guide, and an author their own (to preview it). *@

@if (_loading)
{
    <div class="admin-page" dir="rtl"><LoadingState /></div>
}
else if (_guide is null)
{
    <StatusPage Icon="@Icons.NotFound" Tone="is-info" Code="۴۰۴" Title="راهنما پیدا نشد"
                Message="@(_signedIn ? "این راهنما وجود ندارد یا برای شما در دسترس نیست." : "این راهنما وجود ندارد یا فقط برای کاربران واردشده است.")">
        @if (!_signedIn)
        {
            <a class="btn btn-secondary" href="/login"><i class="ti @Icons.LogIn"></i> ورود</a>
        }
        <a class="btn btn-primary" href="/guides"><i class="ti @Icons.Guide"></i> همه راهنماها</a>
    </StatusPage>
}
else
{
    <PageTitle>@_guide.Title - راهنمای کاربری</PageTitle>
    <div class="admin-page" dir="rtl">
        <div class="page-header">
            <div>
                <div class="page-kicker">راهنمای کاربری</div>
                <h1 class="page-title"><i class="ti @Icons.Guide"></i> @_guide.Title</h1>
                @if (!_guide.IsActive)
                {
                    <p class="page-subtitle"><span class="badge badge-muted">غیرفعال</span> این راهنما برای دیگران دیده نمی‌شود؛ شما فقط برای پیش‌نمایش آن را می‌بینید.</p>
                }
            </div>
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="window.print()"><i class="ti @Icons.Print"></i> چاپ</button>
                <a class="btn btn-secondary" href="/guides"><i class="ti @Icons.Back"></i> همه راهنماها</a>
            </div>
        </div>

        <article class="card guide-article">
            @if (_guide.Summary is not null)
            {
                <p class="guide-summary">@_guide.Summary</p>
            }
            <div class="guide-html" dir="rtl">@((MarkupString)_html)</div>
        </article>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _loading = true, _signedIn;
    private UserGuide? _guide;
    private string _html = "";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _signedIn = user.Identity?.IsAuthenticated == true;
        var canPreview = _signedIn && await PermissionChecker.HasPermissionAsync(Perm.AdminGuidesView);
        // a person who may edit their own guides can also open their own guide while it is off
        Guid? authorId = _signedIn && await PermissionChecker.HasPermissionAsync(Perm.GuidesOwnManage) && Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var eid) ? eid : null;
        _guide = await Provider.GetAsync(Id, _signedIn, canPreview, authorId);
        // cleaned again here (it was also cleaned when saved): this text is shown to people who are not signed in
        _html = _guide is null ? "" : GuideHtmlSanitizer.Sanitize(_guide.ContentHtml);
        _loading = false;
    }
}
