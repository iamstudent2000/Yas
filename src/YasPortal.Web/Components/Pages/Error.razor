@page "/error"
@using YasPortal.Web.Components.Shared

@* Generic error screen: shown when something unexpected fails while handling a request. *@
@* It only displays a friendly message and a link back to the home page; the technical details are not shown to users. *@
<PageTitle>خطا - یاس پورتال</PageTitle>

<StatusPage Icon="@Icons.Alert" Tone="is-danger" Title="مشکلی پیش آمد"
            Message="درخواست شما انجام نشد. لطفاً چند لحظه بعد دوباره تلاش کنید."
            Hint="اگر خطا تکرار شد، زمان و کاری که انجام می‌دادید را به مدیر سامانه اطلاع دهید.">
    <a class="btn btn-secondary" href="/"><i class="ti @Icons.Home"></i> صفحه اصلی</a>
</StatusPage>
