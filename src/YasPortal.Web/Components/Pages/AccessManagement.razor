@page "/admin/access"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using YasPortal.Domain.Authorization
@using YasPortal.Infrastructure.Persistence
@using YasPortal.Web.Services
@attribute [Authorize(Policy = "Admin.Users")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AppState AppState

<PageTitle>مدیریت دسترسی - یاس پورتال</PageTitle>

<div class="page-header" dir="rtl">
    <div>
        <div class="page-subtitle">مدیریت سامانه / دسترسی</div>
        <h1 class="page-title">مدیریت دسترسی</h1>
        <p class="page-subtitle">یک محل واحد برای مدیریت <strong>مجوز مستقیم</strong>، <strong>گروه مجوز</strong> و مشاهده <strong>مجوزهای نهایی</strong>.</p>
    </div>
    <a class="btn btn-secondary" href="/admin/users"><i class="bx bx-group"></i> کاربران</a>
</div>

<section class="card access-selector" dir="rtl">
    <div class="selector-heading">
        <div>
            <h2 class="section-title" style="margin:0">۱. موضوع دسترسی را انتخاب کنید</h2>
            <p class="page-subtitle">برای کارمند، مجوزها همیشه به ترکیب دقیق «کارمند + سمت» تعلق دارند. مدیر سامانه نیازی به سمت ندارد.</p>
        </div>
    </div>
    <div class="access-selector-grid">
        <div>
            <label class="form-label">کاربر</label>
            <select class="form-control" value="@(_employeeId?.ToString() ?? "")" @onchange="EmployeeChanged">
                <option value="">انتخاب کاربر</option>
                @foreach (var e in _employees)
                {
                    <option value="@e.Id">@e.FullName — @e.Username @(e.IsAdmin ? "(مدیر سامانه)" : "(کارمند)")</option>
                }
            </select>
        </div>
        @if (_selectedEmployee?.IsAdmin != true)
        {
            <div>
                <label class="form-label">سمت</label>
                <select class="form-control" value="@(_positionId?.ToString() ?? "")" @onchange="PositionChanged" disabled="@(_employeeId is null)">
                    <option value="">انتخاب سمت</option>
                    @foreach (var p in _employeePositions)
                    {
                        <option value="@p.Id">@p.Name @(p.IsActive ? "" : "(غیرفعال)")</option>
                    }
                </select>
                @if (_employeeId is not null && _employeePositions.Count == 0)
                {
                    <div class="help-text warning-text">این کارمند هنوز هیچ سمت فعالی ندارد. ابتدا از صفحه کاربران سمت را تخصیص دهید.</div>
                }
            </div>
        }
    </div>
</section>

@if (_selectedEmployee is not null && (_selectedEmployee.IsAdmin || _positionId is not null))
{
    <section class="card access-summary" dir="rtl">
        <div class="subject-info">
            <div class="subject-avatar"><i class="bx @( _selectedEmployee.IsAdmin ? "bx-shield-quarter" : "bx-user")"></i></div>
            <div>
                <strong>@_selectedEmployee.FullName</strong>
                <div class="subject-subtitle">
                    @if (_selectedEmployee.IsAdmin)
                    {
                        <span>مدیر سامانه · دسترسی مستقیم روی حساب</span>
                    }
                    else
                    {
                        <span>کارمند · @(_employeePositions.FirstOrDefault(x => x.Id == _positionId)?.Name ?? "سمت انتخاب نشده")</span>
                    }
                </div>
            </div>
        </div>
        <div class="summary-stats">
            <div><strong>@_assignedGroupIds.Count</strong><span>گروه</span></div>
            <div><strong>@_directPermissionIds.Count</strong><span>مستقیم</span></div>
            <div><strong>@_effectivePermissions.Count</strong><span>نهایی</span></div>
        </div>
    </section>

    <section class="card access-panel direct-panel" dir="rtl">
        <div class="section-head">
            <div>
                <div class="panel-kicker">۲. دسترسی مستقیم</div>
                <h2 class="section-title" style="margin:0"><i class="bx bx-key"></i> مجوزهای مستقیم</h2>
                <p class="page-subtitle">مجوز مستقیم مستقل از گروه‌هاست و فقط برای همین حساب یا همین «کارمند + سمت» ذخیره می‌شود.</p>
            </div>
            <div class="direct-count"><strong>@_directPermissionIds.Count</strong><span>مجوز مستقیم</span></div>
        </div>

        <div class="permission-tools">
            <div class="permission-search permission-search-wide">
                <i class="bx bx-search"></i>
                <input class="form-control" placeholder="نام مجوز را جستجو کنید..." @bind="_permissionSearch" @bind:event="oninput" />
            </div>
            <select class="form-control category-select" @bind="_permissionCategory">
                <option value="">همه بخش‌ها</option>
                @foreach (var category in PermissionCategories)
                {
                    <option value="@category">@category</option>
                }
            </select>
            <label class="filter-check"><input type="checkbox" @bind="_onlySelected" /> فقط انتخاب‌شده‌ها</label>
        </div>

        <div class="selection-toolbar">
            <span><strong>@FilteredPermissionGroups.SelectMany(x => x.Items).Count()</strong> مجوز نمایش داده می‌شود · <strong>@_directPermissionIds.Count</strong> مستقیم انتخاب شده</span>
            <div class="toolbar-actions">
                <button class="btn btn-secondary btn-sm" disabled="@(_saving || !FilteredPermissionGroups.Any())" @onclick="() => SetDirectForVisible(true)">انتخاب نتایج</button>
                <button class="btn btn-secondary btn-sm" disabled="@(_saving || !FilteredPermissionGroups.Any())" @onclick="() => SetDirectForVisible(false)">حذف نتایج</button>
            </div>
        </div>

        @if (!FilteredPermissionGroups.Any())
        {
            <div class="empty-state permission-empty">
                <i class="bx bx-key"></i>
                @if (_permissions.Count == 0)
                {
                    <strong>هیچ مجوزی در سامانه ثبت نشده است</strong>
                    <span>ابتدا مجوزها را در صفحه «مجوزها» ایجاد کنید.</span>
                }
                else if (_onlySelected)
                {
                    <strong>مجوز مستقیم انتخاب‌شده‌ای پیدا نشد</strong>
                    <span>فیلتر «فقط انتخاب‌شده‌ها» را خاموش کنید تا همه مجوزها را ببینید.</span>
                }
                else
                {
                    <strong>مجوزی مطابق فیلتر پیدا نشد</strong>
                    <span>عبارت جستجو یا بخش انتخاب‌شده را تغییر دهید.</span>
                }
            </div>
        }
        else
        {
            <div class="permission-groups direct-permission-list">
                @foreach (var group in FilteredPermissionGroups)
                {
                    <section class="permission-group">
                        <div class="permission-group-header">
                            <div><strong>@group.Title</strong><span>@group.Items.Count مجوز</span></div>
                            <div class="permission-group-actions">
                                <button class="btn btn-secondary btn-sm" disabled="@_saving" @onclick="() => SetDirect(group.Items, true)">همه این بخش</button>
                                <button class="btn btn-secondary btn-sm" disabled="@_saving" @onclick="() => SetDirect(group.Items, false)">حذف این بخش</button>
                            </div>
                        </div>
                        <div class="permission-grid">
                            @foreach (var p in group.Items)
                            {
                                var granted = _directPermissionIds.Contains(p.Id);
                                <label class="permission-card @(granted ? "granted" : "")">
                                    <input type="checkbox" checked="@granted" disabled="@_saving" @onchange="e => ToggleDirect(p.Id, e.Value is bool value && value)" />
                                    <span class="permission-check-box"></span>
                                    <span class="permission-name"><strong>@p.Name</strong><small>@group.Title</small></span>
                                    @if (granted)
                                    {
                                        <span class="direct-selected-label">مستقیم</span>
                                        <i class="bx bx-check permission-granted-icon"></i>
                                    }
                                </label>
                            }
                        </div>
                    </section>
                }
            </div>
        }
    </section>

    <div class="access-two-col" dir="rtl">
        <section class="card access-panel">
            <div class="section-head">
                <div>
                    <div class="panel-kicker">۳. گروه‌ها</div>
                    <h2 class="section-title" style="margin:0"><i class="bx bx-layer"></i> گروه‌های مجوز</h2>
                    <p class="page-subtitle">هر گروه مجموعه‌ای از مجوزهاست؛ با اختصاص گروه، همه مجوزهای آن به این موضوع دسترسی اضافه می‌شوند.</p>
                </div>
                <div class="permission-search">
                    <i class="bx bx-search"></i>
                    <input class="form-control" placeholder="جستجوی گروه..." @bind="_groupSearch" @bind:event="oninput" />
                </div>
            </div>

            <div class="selection-toolbar">
                <span>@FilteredGroups.Count گروه نمایش داده می‌شود · <strong>@_assignedGroupIds.Count</strong> انتخاب شده</span>
                @if (!string.IsNullOrWhiteSpace(_groupSearch))
                {
                    <button class="btn btn-secondary btn-sm" @onclick="ClearGroupSearch">پاک کردن جستجو</button>
                }
            </div>

            <div class="group-list">
                @foreach (var g in FilteredGroups)
                {
                    var selected = _assignedGroupIds.Contains(g.Id);
                    <label class="group-row @(selected ? "selected" : "")">
                        <input type="checkbox" checked="@selected" disabled="@_saving" @onchange="e => ToggleGroup(g.Id, e.Value is bool value && value)"/>
                        <span class="selection-box"></span>
                        <span class="group-content">
                            <strong>@g.Name</strong>
                            <small>@g.PermissionCount مجوز@(string.IsNullOrWhiteSpace(g.Description) ? "" : $" · {g.Description}")</small>
                        </span>
                        @if (selected)
                        {
                            <span class="selected-mark"><i class="bx bx-check"></i> انتخاب شده</span>
                        }
                    </label>
                }
                @if (FilteredGroups.Count == 0)
                {
                    <div class="empty-state">گروهی با این عبارت پیدا نشد.</div>
                }
            </div>
        </section>

        <section class="card effective-panel" dir="rtl">
            <div class="section-head">
                <div>
                    <div class="panel-kicker">۴. نتیجه دسترسی</div>
                    <h2 class="section-title" style="margin:0"><i class="bx bx-shield-quarter"></i> مجوزهای نهایی</h2>
                    <p class="page-subtitle">نتیجه اجتماع <strong>مجوزهای مستقیم + تمام مجوزهای گروه‌های انتخاب‌شده</strong>. هیچ Deny permission وجود ندارد.</p>
                </div>
                <div class="effective-search">
                    <i class="bx bx-search"></i>
                    <input class="form-control" placeholder="جستجو در مجوزهای نهایی..." @bind="_effectiveSearch" @bind:event="oninput" />
                </div>
            </div>

            <div class="effective-grid">
                @foreach (var group in FilteredEffectiveGroups)
                {
                    <section class="effective-group">
                        <div class="effective-group-header"><strong>@group.Title</strong><span>@group.Items.Count</span></div>
                        @foreach (var p in group.Items)
                        {
                            <div class="effective-row">
                                <div class="effective-name"><i class="bx bx-check-circle"></i><strong>@p.Name</strong></div>
                                <div class="source-badges">
                                    @if (p.Direct)
                                    {
                                        <span class="source-badge direct">مستقیم</span>
                                    }
                                    @if (p.ViaGroup)
                                    {
                                        <span class="source-badge group">گروه</span>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                }
            </div>
            @if (!FilteredEffectiveGroups.Any())
            {
                <div class="empty-state">هیچ مجوز نهایی برای این موضوع دسترسی وجود ندارد.</div>
            }
        </section>
    </div>
}
else
{
    <section class="card empty-state access-empty" dir="rtl">
        <i class="bx bx-shield-quarter"></i>
        <strong>ابتدا کاربر را انتخاب کنید</strong>
        <span>سپس برای کارمند، سمت موردنظر را انتخاب کنید تا Direct + Group + Effective permissions نمایش داده شود.</span>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "employee")]
    public Guid? EmployeeQueryId { get; set; }

    private List<EmployeeRow> _employees = [];
    private List<PositionRow> _employeePositions = [];
    private List<GroupRow> _groups = [];
    private List<PermissionRow> _permissions = [];
    private List<EffectivePermissionRow> _effectivePermissions = [];

    private Guid? _employeeId;
    private Guid? _positionId;
    private EmployeeRow? _selectedEmployee;
    private HashSet<Guid> _assignedGroupIds = [];
    private HashSet<Guid> _directPermissionIds = [];
    private string _groupSearch = "";
    private string _permissionSearch = "";
    private string _permissionCategory = "";
    private string _effectiveSearch = "";
    private bool _onlySelected;
    private bool _saving;

    private IReadOnlyList<string> PermissionCategories => _permissions.Select(x => PermissionGroupTitle(x.Code)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();

    private IReadOnlyList<GroupRow> FilteredGroups => _groups
        .Where(x => string.IsNullOrWhiteSpace(_groupSearch)
            || x.Name.Contains(_groupSearch, StringComparison.OrdinalIgnoreCase)
            || (x.Description?.Contains(_groupSearch, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    private IReadOnlyList<PermissionGroupView> FilteredPermissionGroups => _permissions
        .Where(x => (string.IsNullOrWhiteSpace(_permissionSearch) || x.Name.Contains(_permissionSearch, StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrWhiteSpace(_permissionCategory) || PermissionGroupTitle(x.Code).Equals(_permissionCategory, StringComparison.OrdinalIgnoreCase))
            && (!_onlySelected || _directPermissionIds.Contains(x.Id)))
        .GroupBy(x => PermissionGroupTitle(x.Code), StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x.Key)
        .Select(x => new PermissionGroupView(x.Key, x.OrderBy(p => p.Name).ToList()))
        .ToList();

    private IReadOnlyList<EffectiveGroupView> FilteredEffectiveGroups => _effectivePermissions
        .Where(x => string.IsNullOrWhiteSpace(_effectiveSearch) || x.Name.Contains(_effectiveSearch, StringComparison.OrdinalIgnoreCase))
        .GroupBy(x => PermissionGroupTitle(x.Code), StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x.Key)
        .Select(x => new EffectiveGroupView(x.Key, x.OrderBy(p => p.Name).ToList()))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadLists();
        if (EmployeeQueryId is Guid id && _employees.Any(x => x.Id == id))
        {
            _employeeId = id;
            _selectedEmployee = _employees.First(x => x.Id == id);
            await PrepareEmployeeSelection(id);
            await LoadAccess(id);
        }
    }

    private async Task LoadLists()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _employees = await db.Employees.AsNoTracking().OrderBy(x => x.FullName).Select(x => new EmployeeRow(x.Id, x.Username, x.FullName, x.IsAdmin)).ToListAsync();
        _groups = await db.PermissionGroups.AsNoTracking().OrderBy(x => x.Name).Select(x => new GroupRow(x.Id, x.Name, x.Description, db.PermissionGroupPermissions.Count(p => p.GroupId == x.Id))).ToListAsync();
        _permissions = await db.Permissions.AsNoTracking().OrderBy(x => x.Name).Select(x => new PermissionRow(x.Id, x.Code, x.Name)).ToListAsync();
    }

    private async Task EmployeeChanged(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _employeeId = null;
            _selectedEmployee = null;
            _positionId = null;
            _employeePositions = [];
            ClearAccessState();
            return;
        }

        _employeeId = id;
        _selectedEmployee = _employees.First(x => x.Id == id);
        await PrepareEmployeeSelection(id);
        await LoadAccess(id);
    }

    private async Task PrepareEmployeeSelection(Guid employeeId)
    {
        _positionId = null;
        _employeePositions = [];
        if (_selectedEmployee?.IsAdmin == true) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        _employeePositions = await db.EmployeePositions.AsNoTracking()
            .Where(x => x.EmployeeId == employeeId)
            .OrderByDescending(x => x.EndedAt == null)
            .ThenBy(x => x.Position.Name)
            .Select(x => new PositionRow(x.PositionId, x.Position.Name, x.EndedAt == null))
            .ToListAsync();
        _positionId = _employeePositions.FirstOrDefault(x => x.IsActive)?.Id;
    }

    private async Task PositionChanged(ChangeEventArgs e)
    {
        _positionId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        if (_employeeId is Guid employeeId) await LoadAccess(employeeId);
    }

    private async Task LoadAccess(Guid employeeId)
    {
        ClearAccessState();
        if (_selectedEmployee?.IsAdmin == true)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _assignedGroupIds = await db.EmployeePermissionGroups.AsNoTracking().Where(x => x.EmployeeId == employeeId).Select(x => x.GroupId).ToHashSetAsync();
            _directPermissionIds = await db.EmployeePermissions.AsNoTracking().Where(x => x.EmployeeId == employeeId).Select(x => x.PermissionId).ToHashSetAsync();
        }
        else if (_positionId is Guid positionId)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _assignedGroupIds = await db.UserPositionPermissionGroups.AsNoTracking().Where(x => x.EmployeeId == employeeId && x.PositionId == positionId).Select(x => x.GroupId).ToHashSetAsync();
            _directPermissionIds = await db.UserPositionPermissions.AsNoTracking().Where(x => x.EmployeeId == employeeId && x.PositionId == positionId).Select(x => x.PermissionId).ToHashSetAsync();
        }
        else return;

        await RebuildEffectivePermissions();
    }

    private async Task RebuildEffectivePermissions()
    {
        var groupPermissionIds = new HashSet<Guid>();
        if (_assignedGroupIds.Count > 0)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            groupPermissionIds = await db.PermissionGroupPermissions.AsNoTracking().Where(x => _assignedGroupIds.Contains(x.GroupId)).Select(x => x.PermissionId).ToHashSetAsync();
        }

        _effectivePermissions = _permissions
            .Where(x => _directPermissionIds.Contains(x.Id) || groupPermissionIds.Contains(x.Id))
            .Select(x => new EffectivePermissionRow(x.Id, x.Code, x.Name, _directPermissionIds.Contains(x.Id), groupPermissionIds.Contains(x.Id)))
            .ToList();
    }

    private async Task ToggleGroup(Guid groupId, bool assign)
    {
        if (_employeeId is not Guid employeeId || (!_selectedEmployee!.IsAdmin && !_positionId.HasValue)) return;
        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (_selectedEmployee.IsAdmin)
            {
                var link = await db.EmployeePermissionGroups.SingleOrDefaultAsync(x => x.EmployeeId == employeeId && x.GroupId == groupId);
                if (assign && link is null) db.EmployeePermissionGroups.Add(new EmployeePermissionGroup(employeeId, groupId));
                else if (!assign && link is not null) db.EmployeePermissionGroups.Remove(link);
            }
            else
            {
                var positionId = _positionId!.Value;
                if (!await db.EmployeePositions.AnyAsync(x => x.EmployeeId == employeeId && x.PositionId == positionId && x.EndedAt == null))
                {
                    AppState.AddToast("این سمت فعال نیست.", ToastLevel.Error);
                    return;
                }
                var link = await db.UserPositionPermissionGroups.SingleOrDefaultAsync(x => x.EmployeeId == employeeId && x.PositionId == positionId && x.GroupId == groupId);
                if (assign && link is null) db.UserPositionPermissionGroups.Add(new UserPositionPermissionGroup(employeeId, positionId, groupId));
                else if (!assign && link is not null) db.UserPositionPermissionGroups.Remove(link);
            }
            await db.SaveChangesAsync();
            await LoadAccess(employeeId);
        }
        finally { _saving = false; }
    }

    private async Task ToggleDirect(Guid permissionId, bool grant)
    {
        if (_employeeId is not Guid employeeId || (!_selectedEmployee!.IsAdmin && !_positionId.HasValue)) return;
        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (_selectedEmployee.IsAdmin)
            {
                var link = await db.EmployeePermissions.SingleOrDefaultAsync(x => x.EmployeeId == employeeId && x.PermissionId == permissionId);
                if (grant && link is null) db.EmployeePermissions.Add(new EmployeePermission(employeeId, permissionId));
                else if (!grant && link is not null) db.EmployeePermissions.Remove(link);
            }
            else
            {
                var positionId = _positionId!.Value;
                if (!await db.EmployeePositions.AnyAsync(x => x.EmployeeId == employeeId && x.PositionId == positionId && x.EndedAt == null))
                {
                    AppState.AddToast("این سمت فعال نیست.", ToastLevel.Error);
                    return;
                }
                var link = await db.UserPositionPermissions.SingleOrDefaultAsync(x => x.EmployeeId == employeeId && x.PositionId == positionId && x.PermissionId == permissionId);
                if (grant && link is null) db.UserPositionPermissions.Add(new UserPositionPermission(employeeId, positionId, permissionId));
                else if (!grant && link is not null) db.UserPositionPermissions.Remove(link);
            }
            await db.SaveChangesAsync();
            await LoadAccess(employeeId);
        }
        finally { _saving = false; }
    }

    private async Task SetDirect(IReadOnlyList<PermissionRow> permissions, bool grant) => await SetDirectForIds(permissions.Select(x => x.Id), grant);

    private async Task SetDirectForVisible(bool grant) => await SetDirectForIds(FilteredPermissionGroups.SelectMany(x => x.Items).Select(x => x.Id), grant);

    private async Task SetDirectForIds(IEnumerable<Guid> permissionIds, bool grant)
    {
        if (_employeeId is not Guid employeeId || (!_selectedEmployee!.IsAdmin && !_positionId.HasValue)) return;
        var ids = permissionIds.Distinct().ToArray();
        if (ids.Length == 0) return;
        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (!_selectedEmployee.IsAdmin && !await db.EmployeePositions.AnyAsync(x => x.EmployeeId == employeeId && x.PositionId == _positionId!.Value && x.EndedAt == null))
            {
                AppState.AddToast("این سمت فعال نیست.", ToastLevel.Error);
                return;
            }

            if (_selectedEmployee.IsAdmin)
            {
                var existing = await db.EmployeePermissions.Where(x => x.EmployeeId == employeeId && ids.Contains(x.PermissionId)).ToListAsync();
                var existingIds = existing.Select(x => x.PermissionId).ToHashSet();
                if (grant) db.EmployeePermissions.AddRange(ids.Where(x => !existingIds.Contains(x)).Select(x => new EmployeePermission(employeeId, x)));
                else db.EmployeePermissions.RemoveRange(existing);
            }
            else
            {
                var positionId = _positionId!.Value;
                var existing = await db.UserPositionPermissions.Where(x => x.EmployeeId == employeeId && x.PositionId == positionId && ids.Contains(x.PermissionId)).ToListAsync();
                var existingIds = existing.Select(x => x.PermissionId).ToHashSet();
                if (grant) db.UserPositionPermissions.AddRange(ids.Where(x => !existingIds.Contains(x)).Select(x => new UserPositionPermission(employeeId, positionId, x)));
                else db.UserPositionPermissions.RemoveRange(existing);
            }
            await db.SaveChangesAsync();
            await LoadAccess(employeeId);
        }
        finally { _saving = false; }
    }

    private void ClearAccessState()
    {
        _assignedGroupIds = [];
        _directPermissionIds = [];
        _effectivePermissions = [];
    }

    private void ClearGroupSearch() => _groupSearch = "";

    private static string PermissionGroupTitle(string code)
    {
        var prefix = code.Split('.', 2)[0];
        return prefix switch
        {
            "Dashboard" => "داشبورد",
            "Profile" => "پروفایل",
            "Requests" => "درخواست‌ها و گردش‌کار",
            "Employees" => "کارکنان",
            "Organizations" => "سازمان‌ها",
            "Positions" => "سمت‌ها",
            "Permissions" => "مجوزها",
            "Admin" => "مدیریت سامانه",
            _ => prefix
        };
    }

