@page "/store/orders"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using YasPortal.Domain.Store
@using YasPortal.Domain.Workflows
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize(Policy = Perm.StoreOrdersCreate)]
@attribute [Authorize(Policy = "NonAdmin")]
@inject StoreOrderService Orders
@inject StoreLotteryService Lottery
@inject AuthenticationStateProvider AuthState
@* The person's own store orders. Listed by employee, so an order sent while acting in one position is still here under another. *@

<PageTitle>سفارش‌های من در فروشگاه - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <SectionTabs Group="store" />
    <div class="page-header">
        <div>
            <div class="page-kicker">فروشگاه</div>
            <h1 class="page-title"><i class="ti @Icons.Box"></i> سفارش‌های من</h1>
            <p class="page-subtitle">درخواست‌های کالای شما، در هر سمتی که ثبت شده باشند. مراحل تأیید را در «درخواست‌های من» ببینید.</p>
        </div>
        <div class="form-actions">
            <a class="btn btn-secondary" href="/requests/mine"><i class="ti @Icons.MyRequests"></i> درخواست‌های من</a>
            <a class="btn btn-primary" href="/store"><i class="ti @Icons.Store"></i> فروشگاه</a>
        </div>
    </div>

    @if (_lottery.Count > 0)
    {
        <section class="card">
            <h2 class="section-title"><i class="ti @Icons.Box"></i> ثبت‌نام‌های قرعه‌کشی من</h2>
            <div class="data-table-wrap">
                <table class="data-table">
                    <thead><tr><th>کالا</th><th>مقدار</th><th>تاریخ ثبت‌نام</th><th>وضعیت</th></tr></thead>
                    <tbody>
                        @foreach (var l in _lottery)
                        {
                            <tr>
                                <td>@l.ItemName</td>
                                <td>@WorkflowDisplay.ToPersianDigits(l.Quantity.ToString("0.###")) @l.Unit</td>
                                <td>@WorkflowDisplay.ToPersianDateTime(l.AppliedAtUtc)</td>
                                <td><span class="badge @(l.Status == LotteryEntryStatus.Won ? "badge-success" : l.Status == LotteryEntryStatus.Applied ? "badge-info" : "badge-muted")">@StoreLottery.StatusText(l.Status)</span>
                                    @if (l.Status == LotteryEntryStatus.Won) { <span class="muted"> — سفارش آن در فهرست پایین است</span> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (_loading)
    {
        <LoadingState />
    }
    else if (_rows.Count == 0)
    {
        <section class="card"><div class="empty-state"><div class="empty-icon"><i class="ti @Icons.Box"></i></div><strong>هنوز سفارشی ثبت نکرده‌اید</strong><span>از صفحه فروشگاه برای کالای موردنیاز درخواست ثبت کنید.</span></div></section>
    }
    else
    {
        <section class="card">
            <div class="data-table-wrap">
                <table class="data-table">
                    <thead><tr><th>شماره</th><th>تاریخ</th><th>اقلام</th><th>وضعیت</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var o in _rows)
                        {
                            <tr>
                                <td dir="ltr" style="text-align:right">@o.Id.ToString("N")[..8].ToUpperInvariant()</td>
                                <td>@WorkflowDisplay.ToPersianDateTime(o.CreatedAtUtc)</td>
                                <td>@o.Summary</td>
                                <td><span class="badge @BadgeFor(o)">@StoreOrderService.StatusText(o.Status, o.IssuedAtUtc is not null)</span></td>
                                <td><div class="form-actions">
                                    @if (o.Status == WorkflowRequestStatus.ReturnedToRequester && o.IssuedAtUtc is null)
                                    {
                                        <a class="btn btn-primary btn-sm" href="/store/orders/edit/@o.RequestId"><i class="ti @Icons.Edit"></i> ویرایش و ارسال مجدد</a>
                                    }
                                    <a class="btn btn-secondary btn-sm" href="/store/orders/@o.Id"><i class="ti @Icons.Print"></i> جزئیات و چاپ</a>
                                </div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <ServerPagination Page="_pageNo" PageSize="_pageSize" TotalCount="_total" Busy="_loading" PageChanged="PageChangedAsync" PageSizeChanged="PageSizeChangedAsync" />
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private Guid? _employeeId;
    private int _pageNo = 1, _pageSize = 20, _total;
    private IReadOnlyList<StoreOrderRow> _rows = [];
    private IReadOnlyList<LotteryMineRow> _lottery = [];

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _employeeId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        if (_employeeId is Guid id)
        {
            (_rows, _total) = await Orders.ListMineAsync(id, _pageNo, _pageSize);
            _lottery = await Lottery.ListMineAsync(id);
        }
        _loading = false;
    }

    private static string BadgeFor(StoreOrderRow o) => o.Status switch
    {
        WorkflowRequestStatus.Approved => o.IssuedAtUtc is null ? "badge-info" : "badge-success",
        WorkflowRequestStatus.Rejected or WorkflowRequestStatus.Cancelled => "badge-danger",
        WorkflowRequestStatus.ReturnedToRequester => "badge-warning",
        _ => "badge-muted",
    };

    private async Task PageChangedAsync(int p) { _pageNo = p; await LoadAsync(); }
    private async Task PageSizeChangedAsync(int s) { _pageSize = s; _pageNo = 1; await LoadAsync(); }
}
