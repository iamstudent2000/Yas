@page "/store/orders"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using YasPortal.Domain.Store
@using YasPortal.Domain.Workflows
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize(Policy = Perm.StoreOrdersCreate)]
@attribute [Authorize(Policy = "NonAdmin")]
@inject StoreOrderService Orders
@inject StoreLotteryService Lottery
@inject AuthenticationStateProvider AuthState
@* The person's own store orders. Listed by employee, so an order sent while acting in one position is still here under another. *@

<PageTitle>سفارش‌های من در فروشگاه - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <SectionTabs Group="store" />
    <div class="page-header">
        <div>
            <div class="page-kicker">فروشگاه</div>
            <h1 class="page-title"><i class="ti @Icons.Box"></i> سفارش‌های من</h1>
            <p class="page-subtitle">درخواست‌های کالای شما، در هر سمتی که ثبت شده باشند. مراحل تأیید را در «درخواست‌های من» ببینید.</p>
        </div>
        <div class="form-actions">
            <a class="btn btn-secondary" href="/requests/mine"><i class="ti @Icons.MyRequests"></i> درخواست‌های من</a>
            <a class="btn btn-primary" href="/store"><i class="ti @Icons.Store"></i> فروشگاه</a>
        </div>
    </div>

    <div class="form-actions no-print">
        <button class="btn @(_tab == "orders" ? "btn-primary" : "btn-secondary")" @onclick="@(() => SwitchTab("orders"))">سفارش‌ها</button>
        <button class="btn @(_tab == "lottery" ? "btn-primary" : "btn-secondary")" @onclick="@(() => SwitchTab("lottery"))">قرعه‌کشی‌ها@(_lottery.Count > 0 ? $" ({WorkflowDisplay.ToPersianDigits(_lottery.Count.ToString())})" : "")</button>
    </div>

    <ListFilterBar Busy="_loading" ActiveCount="FilterCount" CanClear="@(FilterCount > 0 || HasDraft)" OnSearch="ApplyFiltersAsync" OnClear="ClearFiltersAsync">
        <div class="admin-filter"><label class="form-label">جستجوی کالا</label>
            <input class="form-control" placeholder="نام یا کد کالا..." @bind="_dSearch" @bind:event="oninput" /></div>
        <div class="admin-filter"><label class="form-label">وضعیت</label>
            <LookupSelect @key="_tab" Options="@(_tab == "orders" ? OrderStatusOptions : LotteryStatusOptions)" Value="@_dStatus" ValueChanged="k => _dStatus = string.IsNullOrEmpty(k) ? null : k" Placeholder="همه وضعیت‌ها" /></div>
        <div class="admin-filter"><label class="form-label">@(_tab == "orders" ? "تاریخ ثبت از" : "تاریخ ثبت‌نام از")</label><PersianDatePicker @key="_tab" Value="_dFrom" ValueChanged="d => _dFrom = d" Placeholder="تاریخ" /></div>
        <div class="admin-filter"><label class="form-label">تا تاریخ</label><PersianDatePicker @key="_tab" Value="_dTo" ValueChanged="d => _dTo = d" Placeholder="تاریخ" /></div>
    </ListFilterBar>

    @if (_tab == "lottery")
    {
        if (_loading) { <LoadingState /> }
        else if (SortedLottery.Count == 0)
        {
            <section class="card"><div class="empty-state"><div class="empty-icon"><i class="ti @Icons.Box"></i></div><strong>@(_lottery.Count == 0 ? "در هیچ قرعه‌کشی ثبت‌نام نکرده‌اید" : "نتیجه‌ای با این فیلتر پیدا نشد")</strong></div></section>
        }
        else
        {
        <section class="card">
            <div class="data-table-wrap">
                <table class="data-table">
                    <thead><tr><SortableHeader Text="کالا" Column="item" CurrentSort="@_lotSort" CurrentDescending="@_lotDesc" OnSort="LotSortBy" /><SortableHeader Text="مقدار" Column="qty" CurrentSort="@_lotSort" CurrentDescending="@_lotDesc" OnSort="LotSortBy" /><SortableHeader Text="تاریخ ثبت‌نام" Column="date" CurrentSort="@_lotSort" CurrentDescending="@_lotDesc" OnSort="LotSortBy" /><SortableHeader Text="وضعیت" Column="status" CurrentSort="@_lotSort" CurrentDescending="@_lotDesc" OnSort="LotSortBy" /></tr></thead>
                    <tbody>
                        @foreach (var l in SortedLottery)
                        {
                            <tr>
                                <td>@l.ItemName</td>
                                <td>@WorkflowDisplay.ToPersianDigits(l.Quantity.ToString("0.###")) @l.Unit</td>
                                <td>@WorkflowDisplay.ToPersianDateTime(l.AppliedAtUtc)</td>
                                <td><span class="badge @(l.Status == LotteryEntryStatus.Won ? "badge-success" : l.Status == LotteryEntryStatus.Applied ? "badge-info" : "badge-muted")">@StoreLottery.StatusText(l.Status)</span>
                                    @if (l.Status == LotteryEntryStatus.Won) { <span class="muted"> — سفارش آن در تب «سفارش‌ها» است</span> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
        }
    }
    else if (_loading)
    {
        <LoadingState />
    }
    else if (_rows.Count == 0)
    {
        <section class="card"><div class="empty-state"><div class="empty-icon"><i class="ti @Icons.Box"></i></div><strong>@(FilterCount > 0 ? "نتیجه‌ای با این فیلتر پیدا نشد" : "هنوز سفارشی ثبت نکرده‌اید")</strong><span>@(FilterCount > 0 ? "فیلتر را تغییر دهید یا پاک کنید." : "از صفحه فروشگاه برای کالای موردنیاز درخواست ثبت کنید.")</span></div></section>
    }
    else
    {
        <section class="card">
            <div class="data-table-wrap">
                <table class="data-table">
                    <thead><tr><SortableHeader Text="شماره" Column="number" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortByAsync" /><SortableHeader Text="تاریخ" Column="date" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortByAsync" /><th>اقلام</th><SortableHeader Text="وضعیت" Column="status" CurrentSort="@_sortBy" CurrentDescending="@_sortDesc" OnSort="SortByAsync" /><th></th></tr></thead>
                    <tbody>
                        @foreach (var o in _rows)
                        {
                            <tr>
                                <td dir="ltr" style="text-align:right">@o.Id.ToString("N")[..8].ToUpperInvariant()</td>
                                <td>@WorkflowDisplay.ToPersianDateTime(o.CreatedAtUtc)</td>
                                <td>@o.Summary</td>
                                <td><span class="badge @BadgeFor(o)">@StoreOrderService.StatusText(o.Status, o.IssuedAtUtc is not null)</span></td>
                                <td><div class="form-actions">
                                    @if (o.Status == WorkflowRequestStatus.ReturnedToRequester && o.IssuedAtUtc is null)
                                    {
                                        <a class="btn btn-primary btn-sm" href="/store/orders/edit/@o.RequestId"><i class="ti @Icons.Edit"></i> ویرایش و ارسال مجدد</a>
                                    }
                                    <a class="btn btn-secondary btn-sm" href="/store/orders/@o.Id"><i class="ti @Icons.Print"></i> جزئیات و چاپ</a>
                                </div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <ServerPagination Page="_pageNo" PageSize="_pageSize" TotalCount="_total" Busy="_loading" PageChanged="PageChangedAsync" PageSizeChanged="PageSizeChangedAsync" />
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private Guid? _employeeId;
    private int _pageNo = 1, _pageSize = 20, _total;
    private IReadOnlyList<StoreOrderRow> _rows = [];
    private IReadOnlyList<LotteryMineRow> _lottery = [];
    private string? _sortBy, _lotSort;
    private bool _sortDesc, _lotDesc;

    private string _tab = "orders";
    // draft (typed, not applied yet) and applied filters; «جستجو» copies draft to applied
    private string _dSearch = "", _search = "";
    private string? _dStatus, _status;
    private DateTime? _dFrom, _from, _dTo, _to;

    private static readonly IReadOnlyList<(string Key, string Text)> OrderStatusOptions =
    [
        ("pending", "در انتظار تأیید"), ("waiting", "تأیید شده، در انتظار تحویل"), ("issued", "تحویل داده شد"),
        ("returned", "بازگشت به درخواست‌کننده"), ("rejected", "رد شد"), ("cancelled", "لغو شد"),
    ];
    private static readonly IReadOnlyList<(string Key, string Text)> LotteryStatusOptions = Enum.GetValues<LotteryEntryStatus>()
        .Select(s => (((int)s).ToString(), StoreLottery.StatusText(s))).ToList();

    private int FilterCount => (string.IsNullOrWhiteSpace(_search) ? 0 : 1) + (_status is null ? 0 : 1) + (_from is null ? 0 : 1) + (_to is null ? 0 : 1);
    private bool HasDraft => !string.IsNullOrWhiteSpace(_dSearch) || _dStatus is not null || _dFrom is not null || _dTo is not null;

    private async Task SwitchTab(string tab)
    {
        if (_tab == tab) return;
        _tab = tab;
        (_dSearch, _search, _dStatus, _status, _dFrom, _from, _dTo, _to) = ("", "", null, null, null, null, null, null);
        _pageNo = 1;
        await LoadAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        (_search, _status, _from, _to) = (_dSearch.Trim(), _dStatus, _dFrom, _dTo);
        _pageNo = 1;
        await LoadAsync();
    }

    private async Task ClearFiltersAsync()
    {
        (_dSearch, _dStatus, _dFrom, _dTo) = ("", null, null, null);
        await ApplyFiltersAsync();
    }

    private IReadOnlyList<LotteryMineRow> SortedLottery => TableSort.Apply(_lottery.Where(MatchesLottery), _lotSort, _lotDesc,
        ("item", l => l.ItemName), ("qty", l => l.Quantity), ("date", l => l.AppliedAtUtc), ("status", l => StoreLottery.StatusText(l.Status)));
    private void LotSortBy(string col) => (_lotSort, _lotDesc) = TableSort.Toggle(_lotSort, _lotDesc, col);
    private bool MatchesLottery(LotteryMineRow l) =>
        (string.IsNullOrWhiteSpace(_search) || l.ItemName.Contains(_search, StringComparison.CurrentCultureIgnoreCase))
        && (_status is null || ((int)l.Status).ToString() == _status)
        && (_from is not DateTime f || l.AppliedAtUtc >= f.Date.ToUniversalTime())
        && (_to is not DateTime t || l.AppliedAtUtc < t.Date.AddDays(1).ToUniversalTime());

    private async Task SortByAsync(string col) { (_sortBy, _sortDesc) = TableSort.Toggle(_sortBy, _sortDesc, col); _pageNo = 1; await LoadAsync(); }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _employeeId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        if (_employeeId is Guid id)
        {
            (_rows, _total) = await Orders.ListMineAsync(id, _pageNo, _pageSize, _sortBy, _sortDesc, _search, _status, _from?.Date.ToUniversalTime(), _to?.Date.AddDays(1).ToUniversalTime());
            _lottery = await Lottery.ListMineAsync(id);
        }
        _loading = false;
    }

    private static string BadgeFor(StoreOrderRow o) => o.Status switch
    {
        WorkflowRequestStatus.Approved => o.IssuedAtUtc is null ? "badge-info" : "badge-success",
        WorkflowRequestStatus.Rejected or WorkflowRequestStatus.Cancelled => "badge-danger",
        WorkflowRequestStatus.ReturnedToRequester => "badge-warning",
        _ => "badge-muted",
    };

    private async Task PageChangedAsync(int p) { _pageNo = p; await LoadAsync(); }
    private async Task PageSizeChangedAsync(int s) { _pageSize = s; _pageNo = 1; await LoadAsync(); }
}
