@page "/store"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using YasPortal.Domain.Store
@using YasPortal.Infrastructure.Store
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize(Policy = Perm.StoreShopView)]
@inject StoreService Store
@inject StoreCart Cart
@inject IPermissionChecker PermissionChecker
@inject AuthenticationStateProvider AuthState
@inject AppState AppState
@* The catalogue every signed-in person with Store.Shop.View can browse. People who may order also get the cart. *@

<PageTitle>فروشگاه - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <div class="page-header">
        <div>
            <div class="page-kicker">فروشگاه</div>
            <h1 class="page-title"><i class="ti @Icons.Store"></i> فروشگاه</h1>
            <p class="page-subtitle">کالاهای موجود در انبار سازمان و وضعیت موجودی آن‌ها.@(_canOrder ? " برای درخواست، کالا را به سبد اضافه کنید." : "")</p>
        </div>
        @if (_canOrder)
        {
            <div class="form-actions">
                <a class="btn btn-secondary" href="/store/orders"><i class="ti @Icons.Box"></i> سفارش‌های من</a>
                <a class="btn btn-primary" href="/store/cart"><i class="ti @Icons.Store"></i> سبد خرید@(Cart.Count > 0 ? " (" + WorkflowDisplay.ToPersianDigits(Cart.Count.ToString()) + ")" : "")</a>
            </div>
        }
    </div>

    <section class="card list-filter">
        <div class="admin-row-grid">
            <div class="form-field is-grow"><label class="form-label">جستجو</label>
                <input class="form-control" placeholder="نام یا کد کالا..." @bind="_search" @bind:event="oninput" @bind:after="SearchChangedAsync" /></div>
            <div class="form-field admin-row-check"><label class="check-row"><input type="checkbox" checked="@_inStockOnly" @onchange="InStockChangedAsync" /> فقط کالاهای موجود</label></div>
        </div>
        <div class="store-chips" role="group" aria-label="گروه کالا">
            <button type="button" class="store-chip @(_categoryId is null ? "is-active" : "")" @onclick="() => CategoryChangedAsync(null)">همه</button>
            @foreach (var c in _categories)
            {
                <button type="button" class="store-chip @(_categoryId == c.Id ? "is-active" : "")" @onclick="() => CategoryChangedAsync(c.Id.ToString())">@c.Name</button>
            }
        </div>
    </section>

    @if (_loading)
    {
        <LoadingState />
    }
    else if (_page.Rows.Count == 0)
    {
        <section class="card"><div class="empty-state"><div class="empty-icon"><i class="ti @Icons.Box"></i></div><strong>کالایی پیدا نشد</strong><span>جستجو یا گروه را تغییر دهید.</span></div></section>
    }
    else
    {
        <div class="store-grid">
            @foreach (var item in _page.Rows)
            {
                var window = item.WindowOn(DateTime.Now);
                <article class="store-card @(item.Stock <= 0 ? "is-out" : "")">
                    <div class="store-card-top">
                        <span class="store-card-icon"><i class="ti @Icons.Box"></i></span>
                        <div class="store-card-title">
                            <strong>@item.Name</strong>
                            <span class="store-card-meta">@item.CategoryName · <span dir="ltr">@item.Code</span></span>
                        </div>
                    </div>
                    @if (item.Description is not null) {<p class="store-card-desc">@item.Description</p>}
                    <div class="store-card-badges">
                        @if (item.Stock <= 0) { <span class="badge badge-danger">ناموجود</span> }
                        else { <span class="badge badge-success">موجود · @WorkflowDisplay.ToPersianDigits(item.Stock.ToString("0.###")) @item.Unit</span> }
                        @if (item.IsLottery) {<span class="badge badge-info">قرعه‌کشی</span>}
                        @switch (window)
                        {
                            case StoreRequestWindow.NotYet: <span class="badge badge-muted">درخواست از @WorkflowDisplay.ToPersianDate(item.RequestOpensOn!.Value)</span> break;
                            case StoreRequestWindow.Closed: <span class="badge badge-danger">دوره درخواست بسته شد</span> break;
                            default: if (item.RequestClosesOn is DateTime closes) { <span class="badge badge-warning">درخواست تا @WorkflowDisplay.ToPersianDate(closes)</span> } break;
                        }
                    </div>
                    @if (item.MaxPerRequest > 0)
                    {
                        <dl class="store-card-facts"><dt>حداکثر در هر درخواست</dt><dd>@WorkflowDisplay.ToPersianDigits(item.MaxPerRequest.ToString("0.###")) @item.Unit</dd></dl>
                    }
                    @if (_canOrder)
                    {
                        <div class="store-card-buy">
                            @if (CanAdd(item))
                            {
                                <input class="form-control" inputmode="decimal" autocomplete="off" placeholder="۱" aria-label="مقدار" value="@QtyText(item.Id)" @onchange="e => SetQty(item.Id, e.Value?.ToString())" />
                                <button class="btn btn-primary btn-sm" @onclick="() => AddToCart(item)"><i class="ti @Icons.Add"></i> افزودن به سبد</button>
                                @if (Cart.QuantityOf(item.Id) > 0) {<span class="muted">در سبد: @WorkflowDisplay.ToPersianDigits(Cart.QuantityOf(item.Id).ToString("0.###"))</span>}
                            }
                            else if (item.IsLottery) { <span class="muted">این کالا با قرعه‌کشی توزیع می‌شود.</span> }
                        </div>
                    }
                </article>
            }
        </div>
        <ServerPagination Page="_pageNo" PageSize="_pageSize" TotalCount="_page.Total" Busy="_loading" PageSizes="@(new[] { 12, 24, 48, 96 })" PageChanged="PageChangedAsync" PageSizeChanged="PageSizeChangedAsync" />
    }
</div>

@code {
    private bool _loading = true;
    private string _search = "";
    private Guid? _categoryId;
    private int _pageNo = 1, _pageSize = 24;
    private StorePage<StoreItemRow> _page = new([], 0);
    private IReadOnlyList<StoreCategory> _categories = [];
    private bool _inStockOnly;
    private CancellationTokenSource? _cts;
    private bool _canOrder;
    private readonly Dictionary<Guid, string> _qty = [];

    private void SetQty(Guid id, string? text) => _qty[id] = text ?? "";

    private string QtyText(Guid id) => _qty.TryGetValue(id, out var v) ? v : "";

    private bool CanAdd(StoreItemRow item) => !item.IsLottery && item.Stock > 0 && item.WindowOn(DateTime.Now) == StoreRequestWindow.Open;

    private void AddToCart(StoreItemRow item)
    {
        if (!StoreNumber.TryParse(QtyText(item.Id), out var q) || q < 0) { AppState.AddToast("مقدار را به صورت عدد وارد کنید.", ToastLevel.Error); return; }
        if (q == 0) q = 1;
        var total = Cart.QuantityOf(item.Id) + q;
        if (item.MaxPerRequest > 0 && total > item.MaxPerRequest) { AppState.AddToast($"حداکثر «{item.Name}» در هر درخواست {WorkflowDisplay.ToPersianDigits(item.MaxPerRequest.ToString("0.###"))} {item.Unit} است.", ToastLevel.Error); return; }
        if (total > item.Stock) { AppState.AddToast($"موجودی «{item.Name}» کافی نیست.", ToastLevel.Error); return; }
        Cart.Add(item, q);
        _qty.Remove(item.Id);
        AppState.AddToast("به سبد اضافه شد.", ToastLevel.Success);
    }

    protected override async Task OnInitializedAsync()
    {
        // admins are kept out of the requester pages, so they do not get the cart either
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _canOrder = !user.HasClaim("yas_is_admin", "True") && await PermissionChecker.HasPermissionAsync(Perm.StoreOrdersCreate);
        _categories = await Store.ListCategoriesAsync(false);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _cts?.Cancel();
        var cts = _cts = new CancellationTokenSource();
        _loading = true;
        try
        {
            _page = await Store.SearchItemsAsync(_search, _categoryId, true, _pageNo, _pageSize, _inStockOnly ? true : null, cts.Token);
            _loading = false;
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            _loading = false;
            AppState.AddToast("خواندن فهرست کالاها انجام نشد.", ToastLevel.Error);
        }
    }

    private async Task InStockChangedAsync(ChangeEventArgs e) { _inStockOnly = e.Value is true; _pageNo = 1; await LoadAsync(); }
    private async Task SearchChangedAsync() { _pageNo = 1; await LoadAsync(); }
    private async Task CategoryChangedAsync(string? key) { _categoryId = Guid.TryParse(key, out var g) ? g : null; _pageNo = 1; await LoadAsync(); }
    private async Task PageChangedAsync(int p) { _pageNo = p; await LoadAsync(); }
    private async Task PageSizeChangedAsync(int s) { _pageSize = s; _pageNo = 1; await LoadAsync(); }
}
