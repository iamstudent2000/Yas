@page "/store/cart"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using YasPortal.Infrastructure.Store
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize(Policy = Perm.StoreOrdersCreate)]
@attribute [Authorize(Policy = "NonAdmin")]
@inject StoreCart Cart
@inject StoreOrderService Orders
@inject WorkflowService Workflows
@inject AuthenticationStateProvider AuthState
@inject AppState AppState
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>سبد خرید فروشگاه - یاس پورتال</PageTitle>

<div class="admin-page" dir="rtl">
    <div class="page-header">
        <div>
            <div class="page-kicker">فروشگاه</div>
            <h1 class="page-title"><i class="ti @Icons.Store"></i> سبد خرید</h1>
            <p class="page-subtitle">با ارسال سبد، یک درخواست کالا ثبت می‌شود و پس از تأیید مسئولان، انباردار کالا را تحویل می‌دهد. سفارش به نام شماست و در هر سمتی که باشید دیده می‌شود.</p>
        </div>
        <div class="form-actions">
            <a class="btn btn-secondary" href="/store"><i class="ti @Icons.Back"></i> ادامه خرید</a>
            <a class="btn btn-secondary" href="/store/orders"><i class="ti @Icons.Box"></i> سفارش‌های من</a>
        </div>
    </div>

    @if (Cart.Count == 0)
    {
        <section class="card"><div class="empty-state"><div class="empty-icon"><i class="ti @Icons.Store"></i></div><strong>سبد خرید خالی است</strong><span>از صفحه فروشگاه کالا اضافه کنید.</span></div></section>
    }
    else
    {
        <section class="card">
            <div class="data-table-wrap">
                <table class="data-table">
                    <thead><tr><th>کالا</th><th>مقدار</th><th>واحد</th><th>حداکثر در درخواست</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var line in Cart.Lines)
                        {
                            <tr>
                                <td><strong>@line.Name</strong> <span class="muted" dir="ltr">@line.Code</span></td>
                                <td><input class="form-control" style="width:90px" inputmode="decimal" autocomplete="off" value="@WorkflowDisplay.ToPersianDigits(line.Quantity.ToString("0.###"))" @onchange="e => ChangeQuantity(line, e.Value?.ToString())" /></td>
                                <td>@line.Unit</td>
                                <td>@(line.MaxPerRequest == 0 ? "—" : WorkflowDisplay.ToPersianDigits(line.MaxPerRequest.ToString("0.###")))</td>
                                <td><button class="btn btn-danger btn-sm" @onclick="() => Cart.Remove(line.ItemId)"><i class="ti @Icons.Delete"></i> حذف</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="card admin-form-row">
            <div class="admin-row-grid">
                <div class="form-field is-grow"><label class="form-label">توضیحات (اختیاری)</label><input class="form-control" @bind="_note" maxlength="@YasPortal.Domain.Store.StoreOrder.NoteMax" /></div>
                <div class="form-field admin-row-submit"><div class="form-actions">
                    <button class="btn btn-primary" disabled="@_busy" @onclick="SubmitAsync"><i class="ti @Icons.Send"></i> ثبت درخواست</button>
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="Cart.Clear">خالی‌کردن سبد</button>
                </div></div>
            </div>
        </section>
    }
</div>

@code {
    private bool _busy;
    private string _note = "";

    protected override void OnInitialized() => Cart.Changed += OnCartChanged;

    private void OnCartChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Cart.Changed -= OnCartChanged;

    private void ChangeQuantity(StoreCartLine line, string? text)
    {
        if (!StoreNumber.TryParse(text, out var q) || q <= 0) { AppState.AddToast("مقدار باید عددی بزرگ‌تر از صفر باشد.", ToastLevel.Error); StateHasChanged(); return; }
        Cart.Add(new StoreItemRow(line.ItemId, line.Code, line.Name, Guid.Empty, "", line.Unit, null, true, 0, line.MaxPerRequest), q, replace: true);
    }

    private async Task SubmitAsync()
    {
        if (_busy) return;
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        var employeeId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var eid) ? (Guid?)eid : null;
        var claimedPositionId = Guid.TryParse(user.FindFirstValue("yas_active_position_id"), out var pid) ? (Guid?)pid : null;
        // the active position is re-checked against the database, like every other request: it only routes the approval
        if (employeeId is not Guid emp || claimedPositionId is not Guid pos || !await Workflows.HoldsActivePositionAsync(emp, pos))
        {
            AppState.AddToast("سمت فعالی برای شما یافت نشد؛ برای ثبت درخواست باید یک سمت فعال معتبر داشته باشید.", ToastLevel.Error);
            return;
        }
        _busy = true;
        try
        {
            var result = await Orders.PlaceAsync(emp, pos, Cart.Lines.Select(l => (l.ItemId, l.Quantity)).ToList(), _note, DateTime.Now);
            if (!result.Ok) { AppState.AddToast(result.Error ?? "ثبت درخواست انجام نشد.", ToastLevel.Error); return; }
            Cart.Clear();
            AppState.AddToast("درخواست کالا ثبت شد و برای تأیید ارسال شد.", ToastLevel.Success);
            Navigation.NavigateTo("/store/orders");
        }
        catch (Exception) { AppState.AddToast("ثبت درخواست انجام نشد.", ToastLevel.Error); }
        finally { _busy = false; }
    }
}
