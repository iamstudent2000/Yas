@page "/notifications/send"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using YasPortal.Domain.Notifications
@using YasPortal.Web.Components.Shared
@using YasPortal.Web.Services
@attribute [Authorize(Policy = Perm.NotificationsMessageSend)]
@inject NotificationService NotificationSvc
@inject AdminQueryService AdminQueries
@inject AppState AppState
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>ارسال اعلان - یاس پورتال</PageTitle>

<div class="requests-page" dir="rtl">
    <div class="page-header">
        <div>
            <div class="page-kicker">درخواست‌ها و گردش‌کار</div>
            <h1 class="page-title"><i class="ti @Icons.SendNotification"></i> ارسال اعلان</h1>
            <p class="page-subtitle">یک پیام کوتاه برای یک یا چند نفر بفرستید. پیام در بخش اعلان‌های هر گیرنده نمایش داده می‌شود و فرستنده‌اش شما هستید. هر پیامی که فرستاده‌اید را می‌توانید پس بگیرید.</p>
        </div>
    </div>

    <section class="card">
        <div class="form-grid">
            <div class="form-field" style="grid-column:1 / -1">
                <label class="check-row"><input type="checkbox" checked="@_everyone" @onchange="OnEveryoneChangedAsync" /> <i class="ti @Icons.Broadcast"></i> همه کارکنان فعال</label>
                <small class="muted">با انتخاب این گزینه، بقیه‌ی انتخاب‌ها لازم نیست.</small>
            </div>

            @if (!_everyone)
            {
                <div class="form-field">
                    <label class="form-label"><i class="ti @Icons.Organization"></i> افزودن همه‌ی اعضای یک سازمان</label>
                    <ServerSearchableGuidSelect @key="_pickKey" Value="null" ValueChanged="AddOrganizationAsync"
                                                SearchAsync="SearchOrganizationsAsync" Placeholder="افزودن سازمان..."
                                                SearchPlaceholder="نام سازمان را جستجو کنید..." />
                </div>

                <div class="form-field" style="grid-column:1 / -1">
                    <label class="form-label"><i class="ti @Icons.PickFromList"></i> انتخاب افراد از فهرست (با تیک)</label>
                    @if (true)
                    {
                        <div class="audience-browser">
                            <div class="audience-browser-filters">
                                <input class="form-control" value="@_browseText" placeholder="بخشی از نام، کد یا نام کاربری..."
                                       @oninput="e => _browseText = e.Value?.ToString()" @onkeydown="OnBrowseKeyAsync" />
                                <ServerSearchableGuidSelect @key="_browseKey" Value="_browseOrgId" ValueChanged="id => { _browseOrgId = id; return Task.CompletedTask; }"
                                                            SearchAsync="SearchOrganizationsAsync" Placeholder="همه‌ی سازمان‌ها" SearchPlaceholder="نام سازمان..." />
                                <button type="button" class="btn btn-primary" disabled="@_browsing" @onclick="BrowseAsync"><i class="ti @Icons.Search"></i> جستجو</button>
                            </div>
                            @if (_browseResults is not null)
                            {
                                @if (_browseResults.Count == 0)
                                {
                                    <div class="muted" style="padding:10px">کسی پیدا نشد.</div>
                                }
                                else
                                {
                                    <div class="audience-browser-actions">
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="CheckAll">تیک همه‌ی نتیجه‌ها</button>
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="UncheckAll">برداشتن تیک‌ها</button>
                                        <button type="button" class="btn btn-primary btn-sm" disabled="@(_checked.Count == 0)" @onclick="AddCheckedAsync"><i class="ti @Icons.Add"></i> افزودن @_checked.Count.ToString("N0") نفر تیک‌خورده</button>
                                        <small class="muted">@(_browseResults.Count >= BrowseLimit ? $"اولین {BrowseLimit} نتیجه؛ جستجو را دقیق‌تر کنید." : $"{_browseResults.Count} نتیجه")</small>
                                    </div>
                                    <div class="audience-browser-list">
                                        @foreach (var item in _browseResults)
                                        {
                                            var already = _employees.ContainsKey(item.Id);
                                            <label class="check-row">
                                                <input type="checkbox" disabled="@already" checked="@(already || _checked.Contains(item.Id))" @onchange="e => ToggleChecked(item.Id, e.Value is true)" />
                                                <span>@item.Text</span>
                                                @if (already)
                                                {
                                                    <small class="muted">(افزوده شده)</small>
                                                }
                                            </label>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>

                <div class="form-field" style="grid-column:1 / -1">
                    <label class="form-label"><i class="ti @Icons.RecipientGroup"></i> گروه‌های من</label>
                    @if (_groups.Count == 0)
                    {
                        <small class="muted">هنوز گروهی ندارید. گیرندگان را انتخاب کنید و با «ذخیره به‌عنوان گروه» برای دفعات بعد نگه دارید.</small>
                    }
                    else
                    {
                        <div class="audience-chips">
                            @foreach (var group in _groups)
                            {
                                var used = _groupIds.ContainsKey(group.Id);
                                <span class="audience-chip @(used ? "is-on" : "")">
                                    <button type="button" class="audience-chip-main" title="@(used ? "برداشتن از گیرندگان" : "افزودن به گیرندگان")" @onclick="() => ToggleGroupAsync(group)">@group.Name (@group.MemberCount.ToString("N0"))</button>
                                    <button type="button" title="بارگذاری اعضا در فهرست دستی برای ویرایش" @onclick="() => LoadGroupMembersAsync(group)"><i class="ti @Icons.Edit"></i></button>
                                    @if (_deleteGroupId == group.Id)
                                    {
                                        <button type="button" class="audience-chip-confirm" title="تأیید حذف گروه" @onclick="() => DeleteGroupAsync(group)">حذف شود؟</button>
                                    }
                                    else
                                    {
                                        <button type="button" title="حذف گروه" @onclick="() => _deleteGroupId = group.Id"><i class="ti @Icons.Delete"></i></button>
                                    }
                                </span>
                            }
                        </div>
                    }
                </div>

                @if (_employees.Count > 0 || _organizations.Count > 0 || _groupIds.Count > 0)
                {
                    <div class="form-field" style="grid-column:1 / -1">
                        <label class="form-label">گیرندگان انتخاب‌شده</label>
                        <div class="audience-chips">
                            @foreach (var item in _organizations)
                            {
                                <span class="audience-chip"><i class="ti @Icons.Organization"></i> @item.Value<button type="button" title="حذف" @onclick="() => RemoveOrganizationAsync(item.Key)"><i class="ti @Icons.Close"></i></button></span>
                            }
                            @foreach (var item in _groupIds)
                            {
                                <span class="audience-chip"><i class="ti @Icons.RecipientGroup"></i> @item.Value<button type="button" title="حذف" @onclick="() => RemoveGroupAsync(item.Key)"><i class="ti @Icons.Close"></i></button></span>
                            }
                            @foreach (var item in _employees)
                            {
                                <span class="audience-chip">@item.Value<button type="button" title="حذف" @onclick="() => RemoveEmployeeAsync(item.Key)"><i class="ti @Icons.Close"></i></button></span>
                            }
                        </div>
                        <div class="audience-save">
                            <input class="form-control" maxlength="@RecipientGroup.MaxNameLength" value="@_groupName" placeholder="نام گروه برای ذخیره..." @oninput="e => _groupName = e.Value?.ToString() ?? string.Empty" />
                            <button type="button" class="btn btn-secondary" disabled="@(_busy || _groupName.Trim().Length == 0)" @onclick="SaveGroupAsync"><i class="ti @Icons.Save"></i> ذخیره به‌عنوان گروه</button>
                        </div>
                        <small class="muted">هم‌نام بودن با گروه قبلی، اعضای آن را جایگزین می‌کند. گروه ذخیره‌شده فهرستی از همین افراد است (نه خودِ سازمان).</small>
                    </div>
                }
            }

            @if (!CurrentAudience().IsEmpty && _recipientCount is int total && total + _excluded.Count > 0)
            {
                <div class="form-field" style="grid-column:1 / -1">
                    <button type="button" class="btn btn-secondary" @onclick="ToggleReviewAsync"><i class="ti @Icons.PickFromList"></i> @(_showReview ? "بستن فهرست گیرندگان" : "مشاهده و ویرایش فهرست گیرندگان") @(_excluded.Count > 0 ? $"({_excluded.Count:N0} نفر کنار گذاشته شد)" : "")</button>
                    @if (_showReview)
                    {
                        <div class="audience-browser">
                            <div class="audience-browser-filters">
                                <input class="form-control" value="@_reviewText" placeholder="جستجو در گیرندگان..." @oninput="e => _reviewText = e.Value?.ToString()" @onkeydown="OnReviewKeyAsync" />
                                <span></span>
                                <button type="button" class="btn btn-primary" @onclick="LoadReviewAsync"><i class="ti @Icons.Search"></i> جستجو</button>
                            </div>
                            <div class="audience-browser-actions">
                                <small class="muted">تیک را از کسانی که نباید پیام را بگیرند بردارید. @_reviewTotal.ToString("N0") نفر در این فهرست.</small>
                                @if (_excluded.Count > 0)
                                {
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ClearExclusionsAsync">بازگرداندن همه</button>
                                }
                            </div>
                            <div class="audience-browser-list">
                                @foreach (var item in _reviewItems)
                                {
                                    <label class="check-row">
                                        <input type="checkbox" checked="@(!_excluded.Contains(item.Id))" @onchange="e => ToggleRecipientAsync(item.Id, e.Value is true)" />
                                        <span>@item.Text</span>
                                    </label>
                                }
                                @if (_reviewItems.Count < _reviewTotal)
                                {
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="MoreReviewAsync">نمایش بیشتر</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            @if (_recipientCount is int count)
            {
                <div class="form-field" style="grid-column:1 / -1">
                    <small class="muted"><i class="ti @Icons.Users"></i> این پیام برای @count.ToString("N0") نفر ارسال می‌شود.</small>
                </div>
            }
            <div class="form-field" style="grid-column:1 / -1">
                <label class="form-label">متن اعلان</label>
                <textarea class="form-control" rows="4" maxlength="@Notification.MaxMessageLength" placeholder="پیام خود را بنویسید..."
                          value="@_message" @oninput="e => _message = e.Value?.ToString() ?? string.Empty"></textarea>
                <small class="muted">@_message.Trim().Length از @Notification.MaxMessageLength نویسه</small>
            </div>
            <div class="form-field dlg-submit">
                @if (_confirming)
                {
                    <span class="muted">ارسال برای @(_recipientCount?.ToString("N0")) نفر؟ بعداً می‌توانید آن را پس بگیرید.</span>
                    <button class="btn btn-primary" disabled="@_busy" @onclick="SendAsync"><i class="ti @Icons.Send"></i> بله، ارسال شود</button>
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="@(() => _confirming = false)">انصراف</button>
                }
                else
                {
                    <button class="btn btn-primary" disabled="@(_busy || !CanSubmit)" @onclick="BeginSendAsync">
                        @if (_busy)
                        {
                            <i class="ti @Icons.Spinner"></i>
                        }
                        else
                        {
                            <i class="ti @Icons.Send"></i>
                        }
                        ارسال اعلان
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="card table-card" style="margin-top:14px">
        <div class="card-toolbar">
            <div>
                <h2 class="section-title"><i class="ti @Icons.Message"></i> اعلان‌های ارسالی من <span class="badge badge-muted">@_total</span></h2>
                <p class="muted">هر پیام یک بار نمایش داده می‌شود، با تعداد گیرندگان و خوانده‌شده‌ها. «پس‌گرفتن» پیام را از فهرست همه‌ی گیرندگان پنهان می‌کند.</p>
            </div>
        </div>
        @if (_loading)
        {
            <LoadingState />
        }
        else if (_sent.Count == 0)
        {
            <div class="empty-state is-compact"><i class="ti @Icons.NoNotifications"></i><strong>هنوز اعلانی نفرستاده‌اید</strong></div>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr><th>گیرنده‌ها</th><th>متن</th><th>زمان ارسال</th><th>وضعیت</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _sent)
                        {
                            <tr class="@(row.Removed == row.Total ? "row-muted" : "")">
                                <td>
                                    @if (row.RecipientName is not null)
                                    {
                                        @row.RecipientName
                                    }
                                    else
                                    {
                                        <strong>@row.Total.ToString("N0") نفر</strong>
                                        @if (!string.IsNullOrWhiteSpace(row.AudienceLabel))
                                        {
                                            <br /><small class="muted">@row.AudienceLabel</small>
                                        }
                                    }
                                </td>
                                <td style="white-space:pre-line">@row.Message</td>
                                <td>@WorkflowDisplay.ToPersianDateTime(row.CreatedAtUtc)</td>
                                <td>
                                    <span class="badge @(row.Read == row.Total ? "badge-success" : "badge-muted")"><i class="ti @(row.Read == row.Total ? Icons.ConfirmAll : Icons.Awaiting)"></i> @row.Read.ToString("N0") از @row.Total.ToString("N0") خوانده شد</span>
                                    @if (row.Removed > 0)
                                    {
                                        <br /><span class="badge badge-warning"><i class="ti @Icons.Retract"></i> @(row.Removed == row.Total ? "پس‌گرفته شد" : $"{row.Removed:N0} مورد پس‌گرفته شد")</span>
                                    }
                                </td>
                                <td>
                                    @if (row.Removed < row.Total)
                                    {
                                        @if (_retractKey == row.Key)
                                        {
                                            <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => RetractAsync(row.Key)">تأیید پس‌گرفتن</button>
                                            <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="@(() => _retractKey = null)">انصراف</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="@(() => _retractKey = row.Key)"><i class="ti @Icons.Retract"></i> پس‌گرفتن</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <ServerPagination Page="_page" PageSize="_pageSize" TotalCount="_total" Busy="_loading" PageChanged="GoToPageAsync" PageSizeChanged="OnPageSizeChangedAsync" />
        }
    </section>
</div>

@code {
    private const int BrowseLimit = 100;

    private Guid? _employeeId;
    private bool _everyone;
    // Picked people / organizations / groups (id → display text), in pick order.
    private readonly Dictionary<Guid, string> _employees = [];
    private readonly Dictionary<Guid, string> _organizations = [];
    private readonly Dictionary<Guid, string> _groupIds = [];
    private readonly Dictionary<Guid, string> _seen = [];
    private List<NotificationService.GroupSummary> _groups = [];
    private Guid? _deleteGroupId;
    private string _groupName = string.Empty;
    private int _pickKey, _browseKey;
    private int? _recipientCount;
    private string _message = string.Empty;
    private bool _busy, _confirming;
    private Guid? _retractKey;

    // The tick-box list.
    private bool _browsing;
    private string? _browseText;
    private Guid? _browseOrgId;
    private List<AdminQueryService.LookupItem>? _browseResults;
    private readonly HashSet<Guid> _checked = [];

    // The review list: everyone the audience reaches, so some can be ticked off before sending.
    private readonly HashSet<Guid> _excluded = [];
    private bool _showReview;
    private string? _reviewText;
    private List<AdminQueryService.LookupItem> _reviewItems = [];
    private int _reviewTotal;
    private const int ReviewPage = 100;

    private bool _loading = true;
    private List<NotificationService.SentGroup> _sent = [];
    private int _page = 1;
    private int _pageSize = 10;
    private int _total;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _employeeId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : null;
        await LoadGroupsAsync();
        await LoadAsync();
    }

    private bool CanSubmit => _message.Trim().Length > 0 && !CurrentAudience().IsEmpty;

    private NotificationService.Audience CurrentAudience() =>
        new(_everyone, _employees.Keys.ToList(), _organizations.Keys.ToList(), _groupIds.Keys.ToList(), _excluded.ToList());

    private async Task RefreshCountAsync()
    {
        _confirming = false;
        var audience = CurrentAudience();
        _recipientCount = _employeeId is Guid senderId && !audience.IsEmpty ? await NotificationSvc.CountRecipientsAsync(senderId, audience) : null;
        if (audience.IsEmpty) _excluded.Clear();
        if (_showReview) await LoadReviewAsync();
    }

    private async Task ToggleReviewAsync()
    {
        _showReview = !_showReview;
        if (_showReview) await LoadReviewAsync();
    }

    private async Task LoadReviewAsync()
    {
        if (_employeeId is not Guid senderId) return;
        (_reviewItems, _reviewTotal) = await NotificationSvc.ListRecipientsAsync(senderId, CurrentAudience(), _reviewText, 0, ReviewPage);
    }

    private async Task MoreReviewAsync()
    {
        if (_employeeId is not Guid senderId) return;
        var (more, total) = await NotificationSvc.ListRecipientsAsync(senderId, CurrentAudience(), _reviewText, _reviewItems.Count, ReviewPage);
        _reviewItems.AddRange(more);
        _reviewTotal = total;
    }

    private async Task OnReviewKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadReviewAsync();
    }

    private async Task ToggleRecipientAsync(Guid id, bool receives)
    {
        if (receives) _excluded.Remove(id);
        else _excluded.Add(id);
        _confirming = false;
        _recipientCount = _employeeId is Guid senderId ? await NotificationSvc.CountRecipientsAsync(senderId, CurrentAudience()) : null;
    }

    private async Task ClearExclusionsAsync()
    {
        _excluded.Clear();
        await RefreshCountAsync();
    }

    private async Task LoadGroupsAsync()
    {
        _groups = _employeeId is Guid owner ? await NotificationSvc.ListGroupsAsync(owner) : [];
        // Forget groups that no longer exist.
        foreach (var gone in _groupIds.Keys.Where(k => _groups.All(g => g.Id != k)).ToList())
            _groupIds.Remove(gone);
    }

    private async Task OnEveryoneChangedAsync(ChangeEventArgs e)
    {
        _everyone = e.Value is true;
        await RefreshCountAsync();
    }

    private async Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchOrganizationsAsync(string search, CancellationToken ct)
    {
        var items = await AdminQueries.SearchOrganizationsAsync(search, true, ct);
        foreach (var item in items) _seen[item.Id] = item.Text;
        return items;
    }

    private bool TryAddEmployee(Guid id, string text)
    {
        if (_employees.ContainsKey(id)) return true;
        if (_employees.Count >= NotificationService.MaxSelectedRecipients)
        {
            AppState.AddToast($"حداکثر {NotificationService.MaxSelectedRecipients} نفر را می‌توان یکی‌یکی انتخاب کرد؛ برای تعداد بیشتر از سازمان یا گروه استفاده کنید.", ToastLevel.Warning);
            return false;
        }
        _employees[id] = text;
        return true;
    }

    private async Task AddOrganizationAsync(Guid? id)
    {
        if (id is not Guid organizationId) return;
        _organizations[organizationId] = _seen.TryGetValue(organizationId, out var text) ? text : organizationId.ToString();
        _pickKey++;
        await RefreshCountAsync();
    }

    private async Task RemoveEmployeeAsync(Guid id)
    {
        _employees.Remove(id);
        await RefreshCountAsync();
    }

    private async Task RemoveOrganizationAsync(Guid id)
    {
        _organizations.Remove(id);
        await RefreshCountAsync();
    }

    private async Task RemoveGroupAsync(Guid id)
    {
        _groupIds.Remove(id);
        await RefreshCountAsync();
    }

    // ---- tick-box list ----

    private async Task OnBrowseKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BrowseAsync();
    }

    private async Task BrowseAsync()
    {
        if (_browsing) return;
        _browsing = true;
        try
        {
            _browseResults = (await AdminQueries.BrowseActiveEmployeesAsync(_browseText, _browseOrgId, _employeeId, BrowseLimit)).ToList();
            _checked.Clear();
        }
        finally { _browsing = false; }
    }

    private void ToggleChecked(Guid id, bool on)
    {
        if (on) _checked.Add(id);
        else _checked.Remove(id);
    }

    private void CheckAll()
    {
        foreach (var item in _browseResults ?? [])
            if (!_employees.ContainsKey(item.Id)) _checked.Add(item.Id);
    }

    private void UncheckAll() => _checked.Clear();

    private async Task AddCheckedAsync()
    {
        foreach (var item in (_browseResults ?? []).Where(x => _checked.Contains(x.Id)))
            if (!TryAddEmployee(item.Id, item.Text)) break;
        _checked.Clear();
        await RefreshCountAsync();
    }

    // ---- groups ----

    private async Task ToggleGroupAsync(NotificationService.GroupSummary group)
    {
        if (!_groupIds.Remove(group.Id))
            _groupIds[group.Id] = group.Name;
        await RefreshCountAsync();
    }

    private async Task LoadGroupMembersAsync(NotificationService.GroupSummary group)
    {
        if (_employeeId is not Guid owner) return;
        var members = await NotificationSvc.GetGroupMembersAsync(owner, group.Id);
        foreach (var member in members)
            if (!TryAddEmployee(member.Id, member.Text)) break;
        _groupName = group.Name;
        AppState.AddToast("اعضای گروه به فهرست دستی اضافه شد؛ ویرایش کنید و با همان نام دوباره ذخیره کنید.", ToastLevel.Info);
        await RefreshCountAsync();
    }

    private async Task SaveGroupAsync()
    {
        if (_busy || _employeeId is not Guid owner) return;
        _busy = true;
        try
        {
            var result = await NotificationSvc.SaveGroupAsync(owner, _groupName, CurrentAudience());
            if (!result.Ok)
            {
                AppState.AddToast(result.Error ?? "ذخیره‌ی گروه انجام نشد.", ToastLevel.Error);
                return;
            }
            AppState.AddToast($"گروه «{_groupName.Trim()}» با {result.Count:N0} عضو ذخیره شد.", ToastLevel.Success);
            _groupName = string.Empty;
            await LoadGroupsAsync();
        }
        finally { _busy = false; }
    }

    private async Task DeleteGroupAsync(NotificationService.GroupSummary group)
    {
        if (_busy || _employeeId is not Guid owner) return;
        _busy = true;
        try
        {
            var result = await NotificationSvc.DeleteGroupAsync(owner, group.Id);
            _deleteGroupId = null;
            AppState.AddToast(result.Ok ? $"گروه «{group.Name}» حذف شد." : result.Error ?? "انجام نشد.", result.Ok ? ToastLevel.Success : ToastLevel.Error);
            await LoadGroupsAsync();
            await RefreshCountAsync();
        }
        finally { _busy = false; }
    }

    // ---- sent history ----

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            if (_employeeId is not Guid employeeId)
            {
                _sent = [];
                _total = 0;
                return;
            }
            (_sent, _total) = await NotificationSvc.ListSentAsync(employeeId, _page, _pageSize);
            if (_sent.Count == 0 && _page > 1)
            {
                _page = Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));
                (_sent, _total) = await NotificationSvc.ListSentAsync(employeeId, _page, _pageSize);
            }
        }
        finally { _loading = false; }
    }

    // A message to several people asks for one more click before it goes out; a message to one person goes straight away.
    private async Task BeginSendAsync()
    {
        if (!CanSubmit) return;
        await RefreshCountAsync();
        if (_recipientCount is int count && count > 1)
        {
            _confirming = true;
            return;
        }
        await SendAsync();
    }

    private async Task SendAsync()
    {
        if (_busy || _employeeId is not Guid senderId) return;
        _busy = true;
        try
        {
            var result = await NotificationSvc.SendAsync(senderId, CurrentAudience(), _message);
            _confirming = false;
            if (!result.Ok)
            {
                AppState.AddToast(result.Error ?? "ارسال اعلان انجام نشد.", ToastLevel.Error);
                return;
            }
            AppState.AddToast(result.Sent == 1 ? "اعلان ارسال شد." : $"اعلان برای {result.Sent:N0} نفر ارسال شد.", ToastLevel.Success);
            _message = string.Empty;
            _employees.Clear();
            _organizations.Clear();
            _groupIds.Clear();
            _excluded.Clear();
            _showReview = false;
            _everyone = false;
            _checked.Clear();
            _browseResults = null;
            _recipientCount = null;
            _pickKey++;
            _page = 1;
            await LoadAsync();
        }
        finally { _busy = false; }
    }

    private async Task RetractAsync(Guid key)
    {
        if (_busy || _employeeId is not Guid senderId) return;
        _busy = true;
        try
        {
            var result = await NotificationSvc.RetractAsync(senderId, key);
            _retractKey = null;
            AppState.AddToast(result.Ok ? $"پیام از فهرست {result.Count:N0} گیرنده پس‌گرفته شد." : result.Error ?? "انجام نشد.", result.Ok ? ToastLevel.Success : ToastLevel.Error);
            if (result.Ok) await LoadAsync();
        }
        finally { _busy = false; }
    }

    private async Task GoToPageAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task OnPageSizeChangedAsync(int size)
    {
        _pageSize = Math.Clamp(size, 1, 100);
        _page = 1;
        await LoadAsync();
    }
}
