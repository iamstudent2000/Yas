@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inherits LayoutComponentBase

<div class="application-shell">
    <header class="topbar">
        <a href="/">یاس پورتال</a>
        <AuthorizeView>
            <Authorized Context="auth">
                <div class="user-area">
                    <span>@auth.User.Identity?.Name</span>
                    <form method="post" action="/account/logout">
                        <AntiforgeryToken />
                        <button type="submit">خروج</button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <a href="/login">ورود</a>
            </NotAuthorized>
        </AuthorizeView>
    </header>

    <div class="application-body">
        <AuthorizeView>
            <Authorized Context="auth">
                <aside class="sidebar">
                    @if (auth.User.HasClaim("yas_is_admin", "True"))
                    {
                        <h3>مدیریت سیستم</h3>
                        <nav>
                            <a href="/dashboard">داشبورد مدیریت</a>
                            <a href="/admin/users">کاربران</a>
                            <a href="/admin/positions">سمت‌ها</a>
                            <a href="/admin/permissions">مجوزها</a>
                        </nav>
                    }
                    else
                    {
                        <h3>حساب کاربری</h3>
                        <nav>
                            <a href="/dashboard">داشبورد من</a>
                            <a href="/my-profile">پروفایل من</a>
                        </nav>
                    }
                </aside>
            </Authorized>
        </AuthorizeView>

        <main class="content">
            @Body
        </main>
    </div>
</div>
