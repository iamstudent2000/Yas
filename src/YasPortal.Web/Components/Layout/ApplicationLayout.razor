@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inherits LayoutComponentBase

<div class="application-shell" dir="rtl">
    <header class="topbar">
        <a class="brand" href="/dashboard"><span class="brand-mark"><i class="bx bx-layer"></i></span><span>یاس پورتال</span></a>
        <AuthorizeView>
            <Authorized Context="auth">
                <div class="topbar-user">
                    <YasPortal.Web.Components.Shared.ActivePositionSelector />
                    <span class="user-avatar"><i class="bx bx-user"></i></span>
                    <div><strong>@auth.User.Identity?.Name</strong><small>حساب کاربری</small></div>
                    <form method="post" action="/account/logout"><AntiforgeryToken /><button type="submit" class="icon-button" title="خروج"><i class="bx bx-log-out"></i></button></form>
                </div>
            </Authorized>
            <NotAuthorized><a class="btn btn-primary" href="/login"><i class="bx bx-log-in"></i> ورود</a></NotAuthorized>
        </AuthorizeView>
    </header>
    <div class="application-body">
        <AuthorizeView>
            <Authorized Context="layoutAuth">
                <aside class="sidebar">
                    <div class="sidebar-section-title">منوی اصلی</div>
                    <nav class="sidebar-nav">
                        <AuthorizeView Policy="Dashboard.View" Context="dashboardAuth">
                            <NavLink href="/dashboard" Match="NavLinkMatch.All"><i class="bx bx-grid-alt"></i><span>داشبورد</span></NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="Profile.View" Context="profileAuth">
                            <NavLink href="/my-profile"><i class="bx bx-user-circle"></i><span>پروفایل من</span></NavLink>
                        </AuthorizeView>
                        <NavLink href="/my-positions"><i class="bx bx-id-card"></i><span>سمت‌های من</span></NavLink>
                    </nav>

                    <div class="sidebar-section-title admin-title">مدیریت سامانه</div>
                    <nav class="sidebar-nav">
                        <AuthorizeView Policy="Admin.Users" Context="usersAuth">
                            <NavLink href="/admin/users"><i class="bx bx-group"></i><span>کاربران</span></NavLink>
                            <NavLink href="/admin/access"><i class="bx bx-shield-quarter"></i><span>مدیریت دسترسی</span></NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="Admin.Positions" Context="positionsAuth">
                            <NavLink href="/admin/positions"><i class="bx bx-briefcase-alt-2"></i><span>سمت‌ها</span></NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="Admin.Permissions" Context="permissionsAuth">
                            <NavLink href="/admin/permissions"><i class="bx bx-key"></i><span>مجوزها</span></NavLink>
                            <NavLink href="/admin/permission-groups"><i class="bx bx-layer"></i><span>گروه‌های مجوز</span></NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="Admin.Organizations" Context="organizationsAuth">
                            <NavLink href="/admin/organizations"><i class="bx bx-buildings"></i><span>سازمان‌ها</span></NavLink>
                        </AuthorizeView>
                    </nav>

                    <div class="sidebar-footer"><i class="bx bx-shield-quarter"></i><div><strong>امنیت فعال</strong><small>دسترسی بر اساس مجوز</small></div></div>
                </aside>
            </Authorized>
        </AuthorizeView>
        <main class="content">@Body</main>
    </div>

    <YasPortal.Web.Components.AppNotifications />
</div>
