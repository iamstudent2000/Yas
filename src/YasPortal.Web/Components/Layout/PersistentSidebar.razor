@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject IJSRuntime JS

<input id="sidebar-pin-toggle" class="sidebar-shell-toggle" type="checkbox" checked="@(!_isMinimal)"
       @onchange="OnSidebarToggleChanged" />

<aside class="sidebar @(_isMinimal ? "sidebar-rail" : "sidebar-pinned") @(_stateLoaded ? "sidebar-state-ready" : "")">
    <div class="sidebar-panel">
        <label class="sidebar-brand" for="sidebar-pin-toggle"
               title="@(_isMinimal ? "پین کردن منو" : "جمع کردن منو")"
               aria-label="@(_isMinimal ? "پین کردن منو" : "جمع کردن منو")">
            <span class="brand-mark"><svg viewBox="0 0 100 100" aria-hidden="true">
                    <use href="#jasmine-bloom-outline" />
                </svg></span><span class="brand-text">یاس پورتال</span>
        </label>
        <nav class="sidebar-nav">
            <div class="sidebar-group">
                <button type="button" class="sidebar-group-toggle @(_accountExpanded ? "expanded" : "")"
                        @onclick="ToggleAccountGroup"><i class="bx bx-user-circle"></i><span class="group-title">حساب
                    کاربری</span><i class="bx bx-chevron-down group-chevron"></i></button>
                    <div class="sidebar-group-items @(_accountExpanded ? "expanded" : "")">
                        <AuthorizeView Policy="Dashboard.View">
                            <NavLink href="/dashboard" Match="NavLinkMatch.All"><i
                                class="bx bx-grid-alt"></i><span>داشبورد</span></NavLink>
                            </AuthorizeView>
                            <AuthorizeView Policy="Profile.View">
                                <NavLink href="/my-profile"><i class="bx bx-user-circle"></i><span>پروفایل من</span></NavLink>
                            </AuthorizeView>
                            <AuthorizeView Context="myPositionsAuth">
                                <Authorized>
                                    @if (!myPositionsAuth.User.HasClaim("yas_is_admin", "True"))
                                    {
                                        <NavLink href="/my-positions"><i class="bx bx-id-card"></i><span>سمت‌های من</span></NavLink>
                                    }
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </div>
                    <div class="sidebar-group">
                        <button type="button"
                                class="sidebar-group-toggle @(_accessExpanded ? "expanded" : "") @(_accessActive ? "active-parent" : "")"
                                @onclick="ToggleAccessGroup"><i class="bx bx-group"></i><span class="group-title">مدیریت کاربران و
                            دسترسی‌ها</span><i class="bx bx-chevron-down group-chevron"></i></button>
                            <div class="sidebar-group-items @(_accessExpanded ? "expanded" : "")">
                                <AuthorizeView Policy="Admin.Users">
                                    <NavLink href="/admin/users"><i class="bx bx-group"></i><span>کاربران</span></NavLink>
                                </AuthorizeView>
                                <AuthorizeView Policy="Admin.Access">
                                    <NavLink href="/admin/access"><i class="bx bx-shield-quarter"></i><span>مدیریت دسترسی</span>
                                    </NavLink>
                                </AuthorizeView>
                                <AuthorizeView Policy="Admin.Permissions">
                                    <NavLink href="/admin/permissions"><i class="bx bx-key"></i><span>مجوزها</span></NavLink>
                                </AuthorizeView>
                                <AuthorizeView Policy="Admin.Permissions">
                                    <NavLink href="/admin/permission-groups"><i class="bx bx-layer"></i><span>گروه‌های مجوز</span>
                                    </NavLink>
                                </AuthorizeView>
                            </div>
                        </div>
                        <div class="sidebar-group">
                            <button type="button"
                                    class="sidebar-group-toggle @(_structureExpanded ? "expanded" : "") @(_structureActive ? "active-parent" : "")"
                                    @onclick="ToggleStructureGroup"><i class="bx bx-buildings"></i><span class="group-title">ساختار
                                سازمانی</span><i class="bx bx-chevron-down group-chevron"></i></button>
                                <div class="sidebar-group-items @(_structureExpanded ? "expanded" : "")">
                                    <AuthorizeView Policy="Admin.Positions">
                                        <NavLink href="/admin/positions"><i class="bx bx-briefcase-alt-2"></i><span>سمت‌ها</span></NavLink>
                                    </AuthorizeView>
                                    <AuthorizeView Policy="Admin.Organizations">
                                        <NavLink href="/admin/organizations"><i class="bx bx-buildings"></i><span>سازمان‌ها</span></NavLink>
                                    </AuthorizeView>
                                    <AuthorizeView Policy="Admin.AssignmentHistory">
                                        <NavLink href="/admin/assignment-history"><i class="bx bx-history"></i><span>سوابق تخصیص
                                            سمت‌ها</span></NavLink>
                                        </AuthorizeView>
                                    </div>
                                </div>
                                <AuthorizeView Policy="Admin.AuditLog">
                                    <NavLink href="/admin/audit-log"><i class="bx bx-file-find"></i><span>گزارش رویدادها</span></NavLink>
                                </AuthorizeView>
                            </nav>
                            <div class="sidebar-footer"><i class="bx bx-shield-quarter"></i>
                                <div><strong>امنیت فعال</strong><small>دسترسی بر اساس مجوز</small></div>
                            </div>
                        </div>
                    </aside>

@code {
    private const string StorageKey = "yasportal.sidebar.minimal";
    private const string ExpansionStorageKey = "yasportal.sidebar.groups";
    private bool _isMinimal;
    private bool _stateLoaded;
    private bool _accountExpanded = true;
    private bool _accessExpanded;
    private bool _structureExpanded;
    private bool _accessActive;
    private bool _structureActive;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            if (bool.TryParse(stored, out var minimal)) _isMinimal = minimal;
            var groups = await JS.InvokeAsync<string?>("localStorage.getItem", ExpansionStorageKey);
            if (!string.IsNullOrWhiteSpace(groups))
            {
                var values = groups.Split('|', StringSplitOptions.RemoveEmptyEntries);
                _accountExpanded = values.Contains("account", StringComparer.OrdinalIgnoreCase);
                _accessExpanded = values.Contains("access", StringComparer.OrdinalIgnoreCase);
                _structureExpanded = values.Contains("structure", StringComparer.OrdinalIgnoreCase);
            }
        }
        catch (InvalidOperationException) { }
        finally { _stateLoaded = true; StateHasChanged(); }
    }

    private async Task ToggleAccountGroup() { _accountExpanded = !_accountExpanded; await PersistGroups(); }
    private async Task ToggleAccessGroup() { _accessExpanded = !_accessExpanded; await PersistGroups(); }
    private async Task ToggleStructureGroup() { _structureExpanded = !_structureExpanded; await PersistGroups(); }

    private async Task PersistGroups()
    {
        var value = string.Join('|', new[] { _accountExpanded ? "account" : null, _accessExpanded ? "access" : null,
_structureExpanded ? "structure" : null }.Where(x => x is not null));
        try { await JS.InvokeVoidAsync("localStorage.setItem", ExpansionStorageKey, value); }
        catch (InvalidOperationException)
        { }
    }

    private async Task OnSidebarToggleChanged(ChangeEventArgs args)
    {
        // The checkbox now represents "pinned open", so minimal is its inverse.
        _isMinimal = !(args.Value is bool value && value);
        await PersistSidebarState();
    }
    private async Task PersistSidebarState()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey,
_isMinimal.ToString().ToLowerInvariant());
        }
        catch (InvalidOperationException) { }
    }
}
