@using Microsoft.AspNetCore.Components.Authorization

<style>
    .sidebar-shell-toggle {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .sidebar-minimal-toggle {
        width: 32px;
        height: 32px;
        margin: 0 0 12px auto;
        border: 1px solid #e6ebf2;
        border-radius: 9px;
        background: #f8fafc;
        color: #667085;
        display: grid;
        place-items: center;
        cursor: pointer;
        transition: .15s;
    }

    .sidebar-minimal-toggle:hover {
        background: #eef4ff;
        color: #155eef;
    }

    .sidebar-minimal-toggle .expanded-icon { display: inline; }
    .sidebar-minimal-toggle .collapsed-icon { display: none; }

    .sidebar-shell-toggle:checked ~ .sidebar {
        width: 76px;
        flex-basis: 76px;
        padding-inline: 10px;
    }

    .sidebar-shell-toggle:checked ~ .sidebar .sidebar-section-title,
    .sidebar-shell-toggle:checked ~ .sidebar .sidebar-nav a span,
    .sidebar-shell-toggle:checked ~ .sidebar .sidebar-footer div {
        display: none;
    }

    .sidebar-shell-toggle:checked ~ .sidebar .sidebar-nav a {
        justify-content: center;
        padding-inline: 8px;
    }

    .sidebar-shell-toggle:checked ~ .sidebar .sidebar-nav a i {
        width: auto;
        font-size: 20px;
    }

    .sidebar-shell-toggle:checked ~ .sidebar .sidebar-footer {
        justify-content: center;
        padding: 10px;
    }

    .sidebar-shell-toggle:checked ~ .sidebar .sidebar-minimal-toggle {
        margin-inline: auto;
    }

    .sidebar-shell-toggle:checked ~ .sidebar .sidebar-minimal-toggle .expanded-icon { display: none; }
    .sidebar-shell-toggle:checked ~ .sidebar .sidebar-minimal-toggle .collapsed-icon { display: inline; }

    @media (max-width: 850px) {
        .sidebar-shell-toggle,
        .sidebar-minimal-toggle {
            display: none;
        }
    }
</style>

<input id="sidebar-minimal-toggle" class="sidebar-shell-toggle" type="checkbox" />

<aside class="sidebar">
    <label class="sidebar-minimal-toggle" for="sidebar-minimal-toggle" title="تغییر وضعیت منو" aria-label="تغییر وضعیت منو">
        <i class="bx bx-chevron-left expanded-icon"></i>
        <i class="bx bx-chevron-right collapsed-icon"></i>
    </label>

    <div class="sidebar-section-title">منوی اصلی</div>
    <nav class="sidebar-nav">
        <AuthorizeView Policy="Dashboard.View">
            <NavLink href="/dashboard" Match="NavLinkMatch.All"><i class="bx bx-grid-alt"></i><span>داشبورد</span></NavLink>
        </AuthorizeView>
        <AuthorizeView Policy="Profile.View">
            <NavLink href="/my-profile"><i class="bx bx-user-circle"></i><span>پروفایل من</span></NavLink>
        </AuthorizeView>
        <NavLink href="/my-positions"><i class="bx bx-id-card"></i><span>سمت‌های من</span></NavLink>
    </nav>

    <div class="sidebar-section-title admin-title">مدیریت سامانه</div>
    <nav class="sidebar-nav">
        <AuthorizeView Policy="Admin.Users">
            <NavLink href="/admin/users"><i class="bx bx-group"></i><span>کاربران</span></NavLink>
        </AuthorizeView>
        <AuthorizeView Policy="Admin.Access">
            <NavLink href="/admin/access"><i class="bx bx-shield-quarter"></i><span>مدیریت دسترسی</span></NavLink>
        </AuthorizeView>
        <AuthorizeView Policy="Admin.Positions">
            <NavLink href="/admin/positions"><i class="bx bx-briefcase-alt-2"></i><span>سمت‌ها</span></NavLink>
        </AuthorizeView>
        <AuthorizeView Policy="Admin.AssignmentHistory">
            <NavLink href="/admin/assignment-history"><i class="bx bx-history"></i><span>سوابق تخصیص سمت‌ها</span></NavLink>
        </AuthorizeView>
        <AuthorizeView Policy="Admin.AuditLog">
            <NavLink href="/admin/audit-log"><i class="bx bx-file-find"></i><span>گزارش رویدادها</span></NavLink>
        </AuthorizeView>
        <AuthorizeView Policy="Admin.Permissions">
            <NavLink href="/admin/permissions"><i class="bx bx-key"></i><span>مجوزها</span></NavLink>
            <NavLink href="/admin/permission-groups"><i class="bx bx-layer"></i><span>گروه‌های مجوز</span></NavLink>
        </AuthorizeView>
        <AuthorizeView Policy="Admin.Organizations">
            <NavLink href="/admin/organizations"><i class="bx bx-buildings"></i><span>سازمان‌ها</span></NavLink>
        </AuthorizeView>
    </nav>

    <div class="sidebar-footer"><i class="bx bx-shield-quarter"></i><div><strong>امنیت فعال</strong><small>دسترسی بر اساس مجوز</small></div></div>
</aside>
