@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using System.Security.Claims
@using YasPortal.Web.Services
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject WorkflowService Workflows
@inject NotificationService NotificationsService
@inject AppState AppState
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService

<input id="sidebar-pin-toggle" class="sidebar-shell-toggle" type="checkbox" checked="@(!_isMinimal)"
       @onchange="OnSidebarToggleChanged" />

<aside class="sidebar @(_isMinimal ? "sidebar-rail" : "sidebar-pinned") @(_stateLoaded ? "sidebar-state-ready" : "")">
    <div class="sidebar-panel">
        <label class="sidebar-brand" for="sidebar-pin-toggle"
               title="@(_isMinimal ? "پین کردن منو" : "جمع کردن منو")"
               aria-label="@(_isMinimal ? "پین کردن منو" : "جمع کردن منو")">
            <span class="brand-mark"><svg viewBox="0 0 100 100" aria-hidden="true">
                    <use href="#jasmine-bloom-outline" />
                </svg></span><span class="brand-text">یاس پورتال</span>
        </label>
        <nav class="sidebar-nav">
            @if (_accountGroupVisible)
            {
                <div class="sidebar-group">
                    <button type="button" class="sidebar-group-toggle @(_accountExpanded ? "expanded" : "")"
                            @onclick="ToggleAccountGroup"><i class="ti @Icons.AccountGroup"></i><span class="group-title">حساب
                        کاربری</span><i class="ti @Icons.ChevronDown group-chevron"></i></button>
                    <div class="sidebar-group-items @(_accountExpanded ? "expanded" : "")">
                        <AuthorizeView Policy="@Perm.DashboardPageView">
                            <NavLink href="/dashboard" Match="NavLinkMatch.All"><i
                                class="ti @Icons.Dashboard"></i><span>داشبورد</span></NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Perm.ProfileOwnView">
                            <NavLink href="/my-profile"><i class="ti @Icons.Profile"></i><span>پروفایل من</span></NavLink>
                        </AuthorizeView>
                        <NavLink href="/settings/appearance"><i class="ti @Icons.Appearance"></i><span>ظاهر برنامه</span></NavLink>
                        <AuthorizeView Context="myPositionsAuth">
                            <Authorized>
                                @if (!myPositionsAuth.User.HasClaim("yas_is_admin", "True"))
                                {
                                    <NavLink href="/my-positions"><i class="ti @Icons.Position"></i><span>سمت‌های من</span></NavLink>
                                }
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </div>
            }
            @if (_accessGroupVisible)
            {
                <div class="sidebar-group">
                    <button type="button"
                            class="sidebar-group-toggle @(_accessExpanded ? "expanded" : "") @(_accessActive ? "active-parent" : "")"
                            @onclick="ToggleAccessGroup"><i class="ti @Icons.AccessGroup"></i><span class="group-title">مدیریت کاربران و
                        دسترسی‌ها</span><i class="ti @Icons.ChevronDown group-chevron"></i></button>
                    <div class="sidebar-group-items @(_accessExpanded ? "expanded" : "")">
                        <AuthorizeView Policy="@Perm.AdminUsersView">
                            <NavLink href="/admin/users"><i class="ti @Icons.Users"></i><span>کاربران</span></NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Perm.AdminAccessView">
                            <NavLink href="/admin/access"><i class="ti @Icons.AccessManagement"></i><span>مدیریت دسترسی</span>
                            </NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Perm.AdminUsersView">
                            <NavLink href="/admin/password-policy"><i class="ti @Icons.PasswordPolicy"></i><span>سیاست رمز عبور</span></NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Perm.AdminPermissionsView">
                            <NavLink href="/admin/permissions"><i class="ti @Icons.Permission"></i><span>مجوزها</span></NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Perm.AdminPermissionsView">
                            <NavLink href="/admin/permission-groups"><i class="ti @Icons.PermissionGroup"></i><span>گروه‌های مجوز</span>
                            </NavLink>
                        </AuthorizeView>
                    </div>
                </div>
            }
            @if (_structureGroupVisible)
            {
                <div class="sidebar-group">
                    <button type="button"
                            class="sidebar-group-toggle @(_structureExpanded ? "expanded" : "") @(_structureActive ? "active-parent" : "")"
                            @onclick="ToggleStructureGroup"><i class="ti @Icons.OrgStructure"></i><span class="group-title">ساختار
                        سازمانی</span><i class="ti @Icons.ChevronDown group-chevron"></i></button>
                    <div class="sidebar-group-items @(_structureExpanded ? "expanded" : "")">
                        <AuthorizeView Policy="@Perm.AdminPositionsView">
                            <NavLink href="/admin/positions"><i class="ti @Icons.Position"></i><span>سمت‌ها</span></NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Perm.AdminOrganizationsView">
                            <NavLink href="/admin/organizations"><i class="ti @Icons.Organization"></i><span>سازمان‌ها</span></NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Perm.AdminAssignmentHistoryView">
                            <NavLink href="/admin/assignment-history"><i class="ti @Icons.History"></i><span>سوابق تخصیص
                                سمت‌ها</span></NavLink>
                        </AuthorizeView>
                        @if (_delegationsVisible)
                        {
                            <NavLink href="/delegations"><i class="ti @Icons.Delegation"></i><span>تفویض اختیار</span></NavLink>
                        }
                    </div>
                </div>
            }
            <AuthorizeView Policy="@Perm.AdminAuditLogView">
                <NavLink href="/admin/audit-log"><i class="ti @Icons.AuditLog"></i><span>گزارش رویدادها</span></NavLink>
            </AuthorizeView>
            @if (_requestsGroupVisible)
            {
                <div class="sidebar-group">
                    <button type="button"
                            class="sidebar-group-toggle @(_requestsExpanded ? "expanded" : "") @(_requestsActive ? "active-parent" : "")"
                            @onclick="ToggleRequestsGroup"><i class="ti @Icons.RequestsGroup"></i><span class="group-title">درخواست‌ها و
                        گردش‌کار</span><i class="ti @Icons.ChevronDown group-chevron"></i></button>
                    <div class="sidebar-group-items @(_requestsExpanded ? "expanded" : "")">
                        <AuthorizeView Policy="@Perm.RequestsOwnCreate">
                          <AuthorizeView Policy="NonAdmin" Context="nonAdminAuth">
                            <NavLink href="/requests/new"><i class="ti @Icons.NewRequest"></i><span>درخواست جدید</span></NavLink>
                          </AuthorizeView>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Perm.AdminRequestsView">
                            <NavLink href="/admin/requests" Match="NavLinkMatch.All"><i class="ti @Icons.RequestsReport"></i><span>گزارش درخواست‌ها</span></NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Perm.AdminRequestsCreateForOthers">
                            <NavLink href="/admin/requests/new"><i class="ti @Icons.NewRequestForOthers"></i><span>ثبت درخواست برای دیگران</span></NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Perm.RequestsOwnView">
                          <AuthorizeView Policy="NonAdmin" Context="nonAdminAuth">
                            <NavLink href="/requests/mine"><i class="ti @Icons.MyRequests"></i><span>درخواست‌های من</span>@if (_myRequestsBadge > 0)
                                {
                                    <span class="nav-badge">@_myRequestsBadge</span>
                                }</NavLink>
                          </AuthorizeView>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Perm.RequestsOwnView">
                          <AuthorizeView Policy="NonAdmin" Context="nonAdminAuth">
                            <NavLink href="/requests/inbox"><i class="ti @Icons.Inbox"></i><span>کارتابل تاییدات</span>@if (_inboxBadge > 0)
                                {
                                    <span class="nav-badge">@_inboxBadge</span>
                                }</NavLink>
                          </AuthorizeView>
                        </AuthorizeView>
                        <AuthorizeView Policy="Requests.ViewSubordinates">
                          <AuthorizeView Policy="NonAdmin" Context="nonAdminAuth">
                            <NavLink href="/requests/team"><i class="ti @Icons.Subordinates"></i><span>درخواست‌های زیرمجموعه</span></NavLink>
                          </AuthorizeView>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Perm.RequestsOwnView">
                          <AuthorizeView Policy="NonAdmin" Context="nonAdminAuth">
                            <NavLink href="/notifications" Match="NavLinkMatch.All"><i class="ti @Icons.Bell"></i><span>اعلان‌ها</span>@if (_notificationBadge > 0)
                                {
                                    <span class="nav-badge">@_notificationBadge</span>
                                }</NavLink>
                          </AuthorizeView>
                        </AuthorizeView>
                        <AuthorizeView Policy="AdminOnly">
                            <NavLink href="/admin/notifications" Match="NavLinkMatch.All"><i class="ti @Icons.Bell"></i><span>اعلان‌های مدیر</span>@if (_notificationBadge > 0)
                                {
                                    <span class="nav-badge">@_notificationBadge</span>
                                }</NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Perm.NotificationsMessageSend">
                            <NavLink href="/notifications/send"><i class="ti @Icons.SendNotification"></i><span>ارسال اعلان</span></NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Perm.AdminNotificationsView">
                            <NavLink href="/admin/notifications/report"><i class="ti @Icons.NotificationsReport"></i><span>گزارش اعلان‌ها</span></NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Perm.AdminWorkflowsView">
                            <NavLink href="/admin/workflows"><i class="ti @Icons.Workflow"></i><span>مدیریت مراحل گردش‌کار</span></NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Perm.AdminRequestsReopen">
                            <NavLink href="/admin/rejected-requests"><i class="ti @Icons.RejectedRequests"></i><span>درخواست‌های ردشده</span></NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Perm.AdminRequestsForceClose">
                            <NavLink href="/admin/active-requests"><i class="ti @Icons.ActiveRequests"></i><span>درخواست‌های فعال</span></NavLink>
                        </AuthorizeView>
                    </div>
                </div>
            }
        </nav>
                            <div class="sidebar-footer"><i class="ti @Icons.Secure"></i>
                                <div><strong>امنیت فعال</strong><small>دسترسی بر اساس مجوز</small></div>
                            </div>
                        </div>
                    </aside>

@code {
    private const string StorageKey = "yasportal.sidebar.minimal";
    private const string ExpansionStorageKey = "yasportal.sidebar.groups";
    private bool _isMinimal;
    private bool _stateLoaded;
    private bool _accountExpanded = true;
    private bool _accessExpanded;
    private bool _structureExpanded;
    private bool _accessActive;
    private bool _structureActive;
    private bool _requestsExpanded;
    private bool _requestsActive;
    private int _inboxBadge;
    private int _notificationBadge;
    private int _myRequestsBadge;

    private bool _accountGroupVisible;
    private bool _accessGroupVisible;
    private bool _structureGroupVisible;
    private bool _requestsGroupVisible;
    private bool _delegationsVisible;

    private static readonly string[] AccessGroupPaths = { "admin/users", "admin/access", "admin/permissions", "admin/permission-groups", "admin/password-policy" };
    private static readonly string[] StructureGroupPaths = { "admin/positions", "admin/organizations", "admin/assignment-history", "delegations" };
    private static readonly string[] RequestsGroupPaths = { "requests/new", "admin/requests", "admin/requests/new", "requests/mine", "requests/inbox", "requests/team", "notifications", "admin/notifications", "admin/workflows", "admin/active-requests", "admin/rejected-requests" };

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        AppState.OnChange += OnAppStateChanged;
        UpdateActiveGroups(Navigation.Uri);
        await UpdateGroupVisibilityAsync();
        await RefreshBadgesAsync();
    }

    // A group's title/button is only worth showing if at least one of its sub-items would
    // actually render for this user — otherwise it's a dead-end heading pointing at nothing.
    // Each check mirrors the policy(ies) gating that group's own <AuthorizeView> items, so this
    // can't drift out of sync with what a user can actually open inside the group.
    private async Task UpdateGroupVisibilityAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

        async Task<bool> Can(string policy) => (await AuthorizationService.AuthorizeAsync(user, resource: null, policyName: policy)).Succeeded;

        _accountGroupVisible = await Can(Perm.DashboardPageView)
            || await Can(Perm.ProfileOwnView)
            || !user.HasClaim("yas_is_admin", "True");
        _accessGroupVisible = await Can(Perm.AdminUsersView) || await Can(Perm.AdminAccessView) || await Can(Perm.AdminPermissionsView);
        _structureGroupVisible = await Can(Perm.AdminPositionsView) || await Can(Perm.AdminOrganizationsView) || await Can(Perm.AdminAssignmentHistoryView)
            || await Can(Perm.DelegationsOwnManage) || await Can(Perm.AdminDelegationsView);
        _requestsGroupVisible = await Can(Perm.RequestsOwnCreate) || await Can(Perm.AdminRequestsCreateForOthers) || await Can(Perm.AdminRequestsView) || await Can(Perm.RequestsOwnView)
            || await Can(Perm.AdminWorkflowsView) || await Can(Perm.AdminRequestsForceClose) || await Can(Perm.AdminRequestsReopen) || await Can(Perm.RequestsTeamView) || await Can(Perm.RequestsTeamApprovalsView)
            || await Can(Perm.NotificationsMessageSend) || await Can(Perm.AdminNotificationsView)
            || user.HasClaim("yas_is_admin", "True"); // administrators always get their notifications entry
        _delegationsVisible = await Can(Perm.DelegationsOwnManage) || await Can(Perm.AdminDelegationsView);
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateActiveGroups(e.Location);
        await RefreshBadgesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateActiveGroups(string uri)
    {
        var path = Navigation.ToBaseRelativePath(uri).Split('?', '#')[0].Trim('/');
        _accessActive = AccessGroupPaths.Any(p => path.StartsWith(p, StringComparison.OrdinalIgnoreCase));
        _structureActive = StructureGroupPaths.Any(p => path.StartsWith(p, StringComparison.OrdinalIgnoreCase));
        _requestsActive = RequestsGroupPaths.Any(p => path.StartsWith(p, StringComparison.OrdinalIgnoreCase));
    }

    private async void OnAppStateChanged()
    {
        await RefreshBadgesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshBadgesAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            var employeeId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var eid) ? (Guid?)eid : null;
            var activePositionId = Guid.TryParse(user.FindFirstValue("yas_active_position_id"), out var pid) ? (Guid?)pid : null;

            _myRequestsBadge = await Workflows.CountUnseenForRequesterAsync(employeeId);
            _notificationBadge = await NotificationsService.CountUnreadAsync(employeeId);
            _inboxBadge = await Workflows.CountInboxAsync(employeeId, activePositionId, DateTime.Now);
        }
        catch
        {
            // Best-effort UI badge; never let a transient failure break the sidebar itself.
            _inboxBadge = 0;
            _myRequestsBadge = 0;
            _notificationBadge = 0;
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        AppState.OnChange -= OnAppStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            if (bool.TryParse(stored, out var minimal)) _isMinimal = minimal;
            var groups = await JS.InvokeAsync<string?>("localStorage.getItem", ExpansionStorageKey);
            if (!string.IsNullOrWhiteSpace(groups))
            {
                var values = groups.Split('|', StringSplitOptions.RemoveEmptyEntries);
                _accountExpanded = values.Contains("account", StringComparer.OrdinalIgnoreCase);
                _accessExpanded = values.Contains("access", StringComparer.OrdinalIgnoreCase);
                _structureExpanded = values.Contains("structure", StringComparer.OrdinalIgnoreCase);
                _requestsExpanded = values.Contains("requests", StringComparer.OrdinalIgnoreCase);
            }
        }
        catch (InvalidOperationException) { }
        finally { _stateLoaded = true; StateHasChanged(); }
    }

    private async Task ToggleAccountGroup() { _accountExpanded = !_accountExpanded; await PersistGroups(); }
    private async Task ToggleAccessGroup() { _accessExpanded = !_accessExpanded; await PersistGroups(); }
    private async Task ToggleStructureGroup() { _structureExpanded = !_structureExpanded; await PersistGroups(); }
    private async Task ToggleRequestsGroup() { _requestsExpanded = !_requestsExpanded; await PersistGroups(); }

    private async Task PersistGroups()
    {
        var value = string.Join('|', new[] { _accountExpanded ? "account" : null, _accessExpanded ? "access" : null,
_structureExpanded ? "structure" : null, _requestsExpanded ? "requests" : null }.Where(x => x is not null));
        try { await JS.InvokeVoidAsync("localStorage.setItem", ExpansionStorageKey, value); }
        catch (InvalidOperationException)
        { }
    }

    private async Task OnSidebarToggleChanged(ChangeEventArgs args)
    {
        // The checkbox now represents "pinned open", so minimal is its inverse.
        _isMinimal = !(args.Value is bool value && value);
        await PersistSidebarState();
    }
    private async Task PersistSidebarState()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey,
_isMinimal.ToString().ToLowerInvariant());
        }
        catch (InvalidOperationException) { }
    }
}
