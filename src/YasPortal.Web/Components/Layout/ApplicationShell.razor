@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="jasmine-bloom-outline" viewBox="0 0 100 100">
        <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
            <ellipse cx="50" cy="23" rx="11" ry="23" />
            <ellipse cx="50" cy="23" rx="11" ry="23" transform="rotate(72 50 50)" />
            <ellipse cx="50" cy="23" rx="11" ry="23" transform="rotate(144 50 50)" />
            <ellipse cx="50" cy="23" rx="11" ry="23" transform="rotate(216 50 50)" />
            <ellipse cx="50" cy="23" rx="11" ry="23" transform="rotate(288 50 50)" />
            <circle cx="50" cy="50" r="6.5" />
        </g>
    </symbol>
</svg>


<div class="application-shell" dir="rtl">
    <div class="application-body">
        <AuthorizeView>
            <Authorized>
                <PersistentSidebar />
            </Authorized>
        </AuthorizeView>

        <div class="shell-main">
            <header class="topbar">
                <AuthorizeView>
                    <Authorized Context="auth">
                        <div class="topbar-user">
                            <YasPortal.Web.Components.Shared.ActivePositionSelector />
                            <span class="user-avatar"><i class="bx bx-user"></i></span>
                            <div><strong>@auth.User.Identity?.Name</strong><small>حساب کاربری</small></div>
                            <form method="post" action="/account/logout"><AntiforgeryToken /><button type="submit" class="icon-button" title="خروج"><i class="bx bx-log-out"></i></button></form>
                        </div>
                    </Authorized>
                    <NotAuthorized><a class="btn btn-primary" href="/login"><i class="bx bx-log-in"></i> ورود</a></NotAuthorized>
                </AuthorizeView>
            </header>

            <main class="content">
                <Routes />
            </main>
        </div>
    </div>
    <YasPortal.Web.Components.AppNotifications />
</div>
