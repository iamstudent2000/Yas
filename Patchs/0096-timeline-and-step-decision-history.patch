+    /// <summary>
+    /// Formats a real WorkflowRequesterAction timestamp for a round, when one was recorded.
+    /// Requests submitted before RequesterActions existed have none for round 1 — CreatedAtUtc is
+    /// used for that row instead — but resubmit/cancel on old data will render without a time,
+    /// same as before this feature, rather than showing a wrong or made-up timestamp.
+    /// </summary>
+    private string? GetActionTime(int round, WorkflowRequesterActionKind kind)
+    {
+        var action = Request.RequesterActions
+            .Where(a => a.Round == round && a.Kind == kind)
+            .OrderByDescending(a => a.AtUtc)
+            .FirstOrDefault();
+        return action?.AtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm");
+    }
