@@ -0,0 +1,321 @@
+@page "/admin/workflows"
+@using Microsoft.AspNetCore.Authorization
+@using Microsoft.EntityFrameworkCore
+@using YasPortal.Domain.Workflows
+@using YasPortal.Infrastructure.Persistence
+@using YasPortal.Web.Components.Shared
+@using YasPortal.Web.Services
+@attribute [Authorize(Policy = "Admin.Workflows")]
+@inject IDbContextFactory<ApplicationDbContext> DbFactory
+@inject AdminQueryService AdminQueries
+@inject AppState AppState
+
+<PageTitle>مراحل گردش‌کار - یاس پورتال</PageTitle>
+
+<div class="admin-page" dir="rtl">
+    <div class="page-header">
+        <div>
+            <div class="page-kicker">مدیریت سامانه / گردش‌کار</div>
+            <h1 class="page-title"><i class="bx bx-git-branch"></i> مراحل گردش‌کار</h1>
+            <p class="page-subtitle">فیلدهای هر نوع گردش‌کار ثابت است؛ مسیر تایید (مراحل) هر نوع را اینجا تعریف کنید.</p>
+        </div>
+    </div>
+
+    <div class="admin-two-col">
+        <section class="card">
+            <div class="card-heading">
+                <div class="card-heading-icon"><i class="bx bx-list-ul"></i></div>
+                <div>
+                    <h2 class="section-title">انواع گردش‌کار</h2>
+                    <p class="muted">یک نوع را انتخاب کنید تا مراحل تایید آن را ببینید.</p>
+                </div>
+            </div>
+            <div class="admin-list-rows">
+                @foreach (var type in WorkflowFieldCatalog.AllTypes)
+                {
+                    var selected = _selectedType == type;
+                    <div class="admin-list-row @(selected ? "admin-list-row-selected" : "")" @onclick="() => SelectType(type)">
+                        <div class="admin-list-primary">
+                            <span class="admin-list-avatar"><i class="bx bx-shape-square"></i></span>
+                            <span class="admin-list-text">
+                                <strong>@WorkflowFieldCatalog.GetDisplayName(type)</strong>
+                                <span class="badge badge-muted">@type</span>
+                            </span>
+                        </div>
+                        <div class="admin-list-meta">
+                            <span class="admin-pill"><i class="bx bx-list-check"></i> @StepCountFor(type) مرحله</span>
+                        </div>
+                    </div>
+                }
+            </div>
+        </section>
+
+        <section class="card">
+            <div class="card-heading">
+                <div class="card-heading-icon"><i class="bx @(_editingId is null ? "bx-layer-plus" : "bx-edit-alt")"></i></div>
+                <div>
+                    <h2 class="section-title">@(_editingId is null ? "مرحله جدید" : "ویرایش مرحله")</h2>
+                    <p class="muted">برای «@WorkflowFieldCatalog.GetDisplayName(_selectedType)» یک مرحله تایید تعریف کنید.</p>
+                </div>
+            </div>
+
+            <label class="form-label">نام مرحله</label>
+            <input class="form-control" @bind="_name" maxlength="200" placeholder="مثلاً تایید مدیر مستقیم" />
+
+            <label class="form-label">نحوه تعیین تاییدکننده</label>
+            <div class="form-radio-group">
+                <label><input type="radio" name="approverKind" checked="@(_ruleKind == ApproverRuleKind.RequesterManagerLevel)" @onchange='() => _ruleKind = ApproverRuleKind.RequesterManagerLevel' /> بر اساس سلسله‌مراتب درخواست‌کننده (چند سطح بالاتر)</label>
+                <label><input type="radio" name="approverKind" checked="@(_ruleKind == ApproverRuleKind.SpecificPosition)" @onchange='() => _ruleKind = ApproverRuleKind.SpecificPosition' /> یک سمت ثابت مشخص</label>
+            </div>
+
+            @if (_ruleKind == ApproverRuleKind.RequesterManagerLevel)
+            {
+                <label class="form-label">چند سطح بالاتر از سمت درخواست‌کننده؟</label>
+                <input class="form-control" type="number" min="1" max="10" @bind="_managerLevel" />
+                <p class="muted">۱ یعنی مدیر مستقیم سمت درخواست‌کننده، ۲ یعنی مدیرِ مدیر او و به همین ترتیب.</p>
+            }
+            else
+            {
+                <label class="form-label">سمت تاییدکننده</label>
+                <ServerSearchableGuidSelect Value="@_approverPositionId" ValueChanged="id => _approverPositionId = id"
+                                            SearchAsync="SearchPositionsAsync" SelectedText="@_approverPositionSearch" Placeholder="یک سمت را انتخاب کنید"
+                                            SearchPlaceholder="نام یا کد سمت را جستجو کنید..." />
+            }
+
+            <div class="form-actions">
+                <button class="btn btn-primary" @onclick="SaveStep"><i class="bx bx-save"></i> @(_editingId is null ? "افزودن مرحله" : "ذخیره")</button>
+                @if (_editingId is not null)
+                {
+                    <button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button>
+                }
+            </div>
+
+            <hr class="section-divider" />
+
+            @if (_loading)
+            {
+                <div class="empty-state">در حال بارگذاری...</div>
+            }
+            else if (_steps.Count == 0)
+            {
+                <div class="empty-state"><i class="bx bx-error-circle"></i><strong>هنوز مرحله‌ای تعریف نشده است</strong><span>تا وقتی حداقل یک مرحله تعریف نشود، کارمندان نمی‌توانند این نوع گردش‌کار را ثبت کنند.</span></div>
+            }
+            else
+            {
+                <div class="admin-list-table-head"><span>ترتیب</span><span>مرحله</span><span>عملیات</span></div>
+                <div class="admin-list-rows">
+                    @foreach (var step in _steps.OrderBy(x => x.Order))
+                    {
+                        <div class="admin-list-row">
+                            <div class="admin-list-primary">
+                                <span class="admin-list-avatar">@step.Order</span>
+                                <span class="admin-list-text">
+                                    <strong>@step.Name</strong>
+                                    <span>@DescribeRule(step)</span>
+                                    @if (!step.IsActive)
+                                    {
+                                        <span class="badge badge-muted">غیرفعال</span>
+                                    }
+                                </span>
+                            </div>
+                            <div class="admin-list-actions">
+                                <button type="button" class="btn btn-secondary btn-sm" title="انتقال به بالا" disabled="@(step.Order == _steps.Min(x => x.Order))" @onclick="() => MoveUp(step.Id)"><i class="bx bx-up-arrow-alt"></i></button>
+                                <button type="button" class="btn btn-secondary btn-sm" title="انتقال به پایین" disabled="@(step.Order == _steps.Max(x => x.Order))" @onclick="() => MoveDown(step.Id)"><i class="bx bx-down-arrow-alt"></i></button>
+                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => EditStep(step)"><i class="bx bx-edit-alt"></i> ویرایش</button>
+                                <button type="button" class="btn btn-danger btn-sm" @onclick="() => DeleteStep(step.Id)"><i class="bx bx-trash"></i> حذف</button>
+                            </div>
+                        </div>
+                    }
+                </div>
+            }
+        </section>
+    </div>
+</div>
+
+@code {
+    private WorkflowTypeCode _selectedType = WorkflowFieldCatalog.AllTypes[0];
+    private List<WorkflowStepDefinition> _steps = [];
+    private Dictionary<WorkflowTypeCode, int> _stepCounts = [];
+    private Dictionary<Guid, string> _positionNames = [];
+    private bool _loading;
+
+    private Guid? _editingId;
+    private string _name = "";
+    private ApproverRuleKind _ruleKind = ApproverRuleKind.RequesterManagerLevel;
+    private int _managerLevel = 1;
+    private Guid? _approverPositionId;
+    private string _approverPositionSearch = "";
+
+    protected override async Task OnInitializedAsync()
+    {
+        await using var db = await DbFactory.CreateDbContextAsync();
+        foreach (var type in WorkflowFieldCatalog.AllTypes)
+            _stepCounts[type] = await db.WorkflowStepDefinitions.CountAsync(x => x.WorkflowType == type);
+        await LoadStepsAsync();
+    }
+
+    private int StepCountFor(WorkflowTypeCode type) => _stepCounts.TryGetValue(type, out var count) ? count : 0;
+
+    private async Task SelectType(WorkflowTypeCode type)
+    {
+        _selectedType = type;
+        CancelEdit();
+        await LoadStepsAsync();
+    }
+
+    private async Task LoadStepsAsync()
+    {
+        _loading = true;
+        await InvokeAsync(StateHasChanged);
+        try
+        {
+            await using var db = await DbFactory.CreateDbContextAsync();
+            _steps = await db.WorkflowStepDefinitions.AsNoTracking().Where(x => x.WorkflowType == _selectedType).OrderBy(x => x.Order).ToListAsync();
+            var positionIds = _steps.Where(x => x.ApproverPositionId is not null).Select(x => x.ApproverPositionId!.Value).Distinct().ToList();
+            _positionNames = positionIds.Count == 0
+                ? []
+                : await db.Positions.AsNoTracking().Where(x => positionIds.Contains(x.Id)).ToDictionaryAsync(x => x.Id, x => x.Name);
+            _stepCounts[_selectedType] = _steps.Count;
+        }
+        finally { _loading = false; }
+    }
+
+    private string DescribeRule(WorkflowStepDefinition step) => step.ApproverRuleKind == ApproverRuleKind.RequesterManagerLevel
+        ? $"{ToPersianDigits(step.ManagerLevel!.Value.ToString())} سطح بالاتر از درخواست‌کننده"
+        : $"سمت ثابت: {(_positionNames.TryGetValue(step.ApproverPositionId!.Value, out var name) ? name : "؟")}";
+
+    private void EditStep(WorkflowStepDefinition step)
+    {
+        _editingId = step.Id;
+        _name = step.Name;
+        _ruleKind = step.ApproverRuleKind;
+        _managerLevel = step.ManagerLevel ?? 1;
+        _approverPositionId = step.ApproverPositionId;
+        _approverPositionSearch = step.ApproverPositionId is Guid pid && _positionNames.TryGetValue(pid, out var name) ? name : "";
+    }
+
+    private void CancelEdit()
+    {
+        _editingId = null;
+        _name = "";
+        _ruleKind = ApproverRuleKind.RequesterManagerLevel;
+        _managerLevel = 1;
+        _approverPositionId = null;
+        _approverPositionSearch = "";
+    }
+
+    private async Task SaveStep()
+    {
+        var name = _name.Trim();
+        if (string.IsNullOrWhiteSpace(name))
+        {
+            AppState.AddToast("نام مرحله الزامی است.", ToastLevel.Error);
+            return;
+        }
+        if (_ruleKind == ApproverRuleKind.RequesterManagerLevel && _managerLevel < 1)
+        {
+            AppState.AddToast("سطح مدیریت باید حداقل ۱ باشد.", ToastLevel.Error);
+            return;
+        }
+        if (_ruleKind == ApproverRuleKind.SpecificPosition && _approverPositionId is null)
+        {
+            AppState.AddToast("یک سمت تاییدکننده را انتخاب کنید.", ToastLevel.Error);
+            return;
+        }
+
+        await using var db = await DbFactory.CreateDbContextAsync();
+        if (_editingId is Guid id)
+        {
+            var existing = await db.WorkflowStepDefinitions.SingleAsync(x => x.Id == id);
+            existing.Rename(name);
+            if (_ruleKind == ApproverRuleKind.RequesterManagerLevel)
+                existing.UseManagerLevel(_managerLevel);
+            else
+                existing.UseSpecificPosition(_approverPositionId!.Value);
+            await db.SaveChangesAsync();
+            AppState.AddToast("مرحله ویرایش شد.", ToastLevel.Success);
+        }
+        else
+        {
+            var nextOrder = (await db.WorkflowStepDefinitions.Where(x => x.WorkflowType == _selectedType).Select(x => (int?)x.Order).MaxAsync() ?? 0) + 1;
+            var step = _ruleKind == ApproverRuleKind.RequesterManagerLevel
+                ? new WorkflowStepDefinition(_selectedType, nextOrder, name, _managerLevel)
+                : new WorkflowStepDefinition(_selectedType, nextOrder, name, _approverPositionId!.Value);
+            db.WorkflowStepDefinitions.Add(step);
+            await db.SaveChangesAsync();
+            AppState.AddToast("مرحله اضافه شد.", ToastLevel.Success);
+        }
+        CancelEdit();
+        await LoadStepsAsync();
+    }
+
+    private async Task DeleteStep(Guid id)
+    {
+        await using var db = await DbFactory.CreateDbContextAsync();
+        if (await db.WorkflowRequestSteps.AnyAsync(x => x.StepDefinitionId == id))
+        {
+            AppState.AddToast("این مرحله در درخواست‌های موجود استفاده شده و قابل حذف نیست؛ می‌توانید آن را غیرفعال کنید.", ToastLevel.Error);
+            return;
+        }
+        var existing = await db.WorkflowStepDefinitions.SingleAsync(x => x.Id == id);
+        var removedOrder = existing.Order;
+        db.WorkflowStepDefinitions.Remove(existing);
+        await db.SaveChangesAsync();
+
+        // Close the gap only after the delete is committed, so this never collides
+        // with the unique (WorkflowType, Order) index mid-transaction.
+        var later = await db.WorkflowStepDefinitions.Where(x => x.WorkflowType == _selectedType && x.Order > removedOrder).OrderBy(x => x.Order).ToListAsync();
+        foreach (var step in later)
+            step.SetOrder(step.Order - 1);
+        await db.SaveChangesAsync();
+
+        AppState.AddToast("مرحله حذف شد.", ToastLevel.Success);
+        if (_editingId == id)
+            CancelEdit();
+        await LoadStepsAsync();
+    }
+
+    private async Task MoveUp(Guid id)
+    {
+        var ordered = _steps.OrderBy(x => x.Order).ToList();
+        var index = ordered.FindIndex(x => x.Id == id);
+        if (index <= 0)
+            return;
+        await SwapOrder(ordered[index].Id, ordered[index - 1].Id);
+    }
+
+    private async Task MoveDown(Guid id)
+    {
+        var ordered = _steps.OrderBy(x => x.Order).ToList();
+        var index = ordered.FindIndex(x => x.Id == id);
+        if (index < 0 || index >= ordered.Count - 1)
+            return;
+        await SwapOrder(ordered[index].Id, ordered[index + 1].Id);
+    }
+
+    private async Task SwapOrder(Guid firstId, Guid secondId)
+    {
+        await using var db = await DbFactory.CreateDbContextAsync();
+        var first = await db.WorkflowStepDefinitions.SingleAsync(x => x.Id == firstId);
+        var second = await db.WorkflowStepDefinitions.SingleAsync(x => x.Id == secondId);
+        var firstOrder = first.Order;
+        var secondOrder = second.Order;
+        // Move the first step to a temporary, definitely-unused order first so the two
+        // updates never momentarily collide on the unique (WorkflowType, Order) index.
+        first.SetOrder(secondOrder + 1000);
+        await db.SaveChangesAsync();
+        second.SetOrder(firstOrder);
+        first.SetOrder(secondOrder);
+        await db.SaveChangesAsync();
+        await LoadStepsAsync();
+    }
+
+    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchPositionsAsync(string search, CancellationToken ct) => AdminQueries.SearchPositionsAsync(search, null, null, ct);
+
+    private static string ToPersianDigits(string value)
+    {
+        var digits = "۰۱۲۳۴۵۶۷۸۹";
+        var chars = value.Select(c => c is >= '0' and <= '9' ? digits[c - '0'] : c).ToArray();
+        return new string(chars);
+    }
+}
diff --git a/src/YasPortal.Web/Components/Pages/Requests/Inbox.razor b/src/YasPortal.Web/Components/Pages/Requests/Inbox.razor
new file mode 100644
index 0000000..b14dfa3
--- /dev/null
+++ b/src/YasPortal.Web/Components/Pages/Requests/Inbox.razor
@@ -0,0 +1,221 @@
+@page "/requests/inbox"
+@using System.Security.Claims
+@using System.Text.Json
+@using Microsoft.AspNetCore.Authorization
+@using Microsoft.AspNetCore.Components.Authorization
+@using Microsoft.EntityFrameworkCore
+@using YasPortal.Domain.Workflows
+@using YasPortal.Infrastructure.Persistence
+@using YasPortal.Web.Services
+@attribute [Authorize(Policy = "Requests.View")]
+@inject IDbContextFactory<ApplicationDbContext> DbFactory
+@inject WorkflowService Workflows
+@inject AppState AppState
+@inject AuthenticationStateProvider AuthenticationStateProvider
+
+<PageTitle>کارتابل تاییدات - یاس پورتال</PageTitle>
+
+<div class="admin-page" dir="rtl">
+    <div class="page-header">
+        <div>
+            <div class="page-kicker">درخواست‌ها و گردش‌کار</div>
+            <h1 class="page-title"><i class="bx bx-inbox"></i> کارتابل تاییدات</h1>
+            <p class="page-subtitle">درخواست‌هایی که در انتظار تصمیم شما (بر اساس سمت فعال شما) هستند.</p>
+        </div>
+    </div>
+
+    @if (!_ready)
+    {
+        <section class="card"><div class="empty-state"><i class="bx bx-loader-alt bx-spin"></i> در حال بررسی سمت فعال...</div></section>
+    }
+    else if (_approverPositionId is null)
+    {
+        <section class="card"><div class="empty-state"><i class="bx bx-error-circle"></i><strong>سمت فعالی برای شما یافت نشد</strong></div></section>
+    }
+    else if (_items.Count == 0)
+    {
+        <section class="card"><div class="empty-state"><i class="bx bx-check-circle"></i><strong>کارتابل شما خالی است</strong></div></section>
+    }
+    else
+    {
+        <div class="admin-list-rows">
+            @foreach (var item in _items)
+            {
+                var busy = _actingRequestId == item.Request.Id;
+                <section class="card">
+                    <div class="admin-list-row">
+                        <div class="admin-list-primary">
+                            <span class="admin-list-avatar"><i class="bx bx-file"></i></span>
+                            <span class="admin-list-text">
+                                <strong>@WorkflowFieldCatalog.GetDisplayName(item.Request.WorkflowType)</strong>
+                                <span>از طرف @item.RequesterName — @item.Request.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
+                            </span>
+                        </div>
+                        <div class="admin-list-meta"><span class="admin-pill"><i class="bx bx-flag"></i> @item.CurrentStep.Name</span></div>
+                    </div>
+
+                    <div class="form-fields-summary">
+                        @foreach (var field in WorkflowFieldCatalog.GetFields(item.Request.WorkflowType))
+                        {
+                            var value = GetFieldValue(item.Request, field.Key);
+                            if (!string.IsNullOrWhiteSpace(value))
+                            {
+                                <p><strong>@field.Label:</strong> @value</p>
+                            }
+                        }
+                    </div>
+
+                    <label class="form-label">نظر (اختیاری)</label>
+                    <textarea class="form-control" rows="2" value="@GetComment(item.Request.Id)" @oninput="e => SetComment(item.Request.Id, e)"></textarea>
+
+                    <div class="form-actions">
+                        <AuthorizeView Policy="Requests.Approve">
+                            <button class="btn btn-primary" disabled="@busy" @onclick="() => Act(item, WorkflowAction.Approve)"><i class="bx bx-check"></i> تایید</button>
+                        </AuthorizeView>
+                        <AuthorizeView Policy="Requests.Reject">
+                            <button class="btn btn-danger" disabled="@busy" @onclick="() => Act(item, WorkflowAction.Reject)"><i class="bx bx-x"></i> رد</button>
+                        </AuthorizeView>
+                        <AuthorizeView Policy="Requests.ReturnToRequester">
+                            <button class="btn btn-secondary" disabled="@busy" @onclick="() => Act(item, WorkflowAction.ReturnToRequester)"><i class="bx bx-undo"></i> بازگشت به درخواست‌کننده</button>
+                        </AuthorizeView>
+                        <AuthorizeView Policy="Requests.ReturnToPreviousStep">
+                            <button class="btn btn-secondary" disabled="@(busy || !item.HasPreviousStep)" @onclick="() => Act(item, WorkflowAction.ReturnToPreviousStep)"><i class="bx bx-chevron-right"></i> بازگشت به مرحله قبل</button>
+                        </AuthorizeView>
+                    </div>
+                </section>
+            }
+        </div>
+    }
+</div>
+
+@code {
+    private enum WorkflowAction { Approve, Reject, ReturnToRequester, ReturnToPreviousStep }
+
+    private sealed record InboxItem(WorkflowRequest Request, WorkflowRequestStep CurrentStep, string RequesterName, bool HasPreviousStep);
+
+    private bool _ready;
+    private Guid? _employeeId;
+    private Guid? _approverPositionId;
+    private List<InboxItem> _items = [];
+    private Dictionary<Guid, string> _comments = [];
+    private Guid? _actingRequestId;
+
+    protected override async Task OnInitializedAsync()
+    {
+        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
+        var employeeId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var eid) ? (Guid?)eid : null;
+        var claimedPositionId = Guid.TryParse(user.FindFirstValue("yas_active_position_id"), out var pid) ? (Guid?)pid : null;
+
+        _employeeId = employeeId;
+        // Re-verified fresh against the database rather than trusted from the cookie claim
+        // alone, so a revoked or changed active position immediately loses this inbox.
+        _approverPositionId = employeeId is Guid empId && await Workflows.HoldsActivePositionAsync(empId, claimedPositionId)
+            ? claimedPositionId
+            : null;
+
+        await LoadAsync();
+        _ready = true;
+    }
+
+    private async Task LoadAsync()
+    {
+        if (_approverPositionId is not Guid positionId)
+        {
+            _items = [];
+            return;
+        }
+
+        await using var db = await DbFactory.CreateDbContextAsync();
+        var requests = await db.WorkflowRequests.AsNoTracking().Include(x => x.Steps)
+            .Where(x => x.Status == WorkflowRequestStatus.PendingApproval
+                        && x.Steps.Any(s => s.Order == x.CurrentStepOrder && s.Status == WorkflowStepStatus.Pending && s.ApproverPositionId == positionId))
+            .OrderBy(x => x.CreatedAtUtc)
+            .ToListAsync();
+
+        var requesterIds = requests.Select(x => x.RequesterEmployeeId).Distinct().ToList();
+        var requesterNames = requesterIds.Count == 0 ? [] : await db.Employees.AsNoTracking().Where(x => requesterIds.Contains(x.Id)).ToDictionaryAsync(x => x.Id, x => x.FullName);
+
+        _items = requests.Select(r =>
+        {
+            var current = r.Steps.Single(s => s.Order == r.CurrentStepOrder);
+            var hasPrevious = r.Steps.Any(s => s.Order < r.CurrentStepOrder);
+            var name = requesterNames.TryGetValue(r.RequesterEmployeeId, out var n) ? n : "—";
+            return new InboxItem(r, current, name, hasPrevious);
+        }).ToList();
+    }
+
+    private string GetComment(Guid requestId) => _comments.TryGetValue(requestId, out var c) ? c : "";
+    private void SetComment(Guid requestId, ChangeEventArgs e) => _comments[requestId] = e.Value?.ToString() ?? "";
+
+    private static string? GetFieldValue(WorkflowRequest request, string key)
+    {
+        try
+        {
+            var values = JsonSerializer.Deserialize<Dictionary<string, string?>>(request.FieldValuesJson);
+            return values is not null && values.TryGetValue(key, out var value) ? value : null;
+        }
+        catch (JsonException) { return null; }
+    }
+
+    private async Task Act(InboxItem item, WorkflowAction action)
+    {
+        if (_employeeId is not Guid employeeId || _approverPositionId is not Guid positionId)
+            return;
+
+        _actingRequestId = item.Request.Id;
+        await InvokeAsync(StateHasChanged);
+        try
+        {
+            // Re-verify authority right before acting, not just at page load — a position
+            // reassignment mid-session must not let a stale claim approve anything.
+            if (!await Workflows.HoldsActivePositionAsync(employeeId, positionId))
+            {
+                AppState.AddToast("سمت فعال شما دیگر معتبر نیست. صفحه را دوباره بارگذاری کنید.", ToastLevel.Error);
+                return;
+            }
+
+            await using var db = await DbFactory.CreateDbContextAsync();
+            var request = await db.WorkflowRequests.Include(x => x.Steps).SingleOrDefaultAsync(x => x.Id == item.Request.Id);
+            if (request is null || request.Status != WorkflowRequestStatus.PendingApproval)
+            {
+                AppState.AddToast("این درخواست دیگر در این وضعیت نیست؛ فهرست به‌روزرسانی شد.", ToastLevel.Info);
+                await LoadAsync();
+                return;
+            }
+
+            var currentStep = request.CurrentStep;
+            if (currentStep.ApproverPositionId != positionId)
+            {
+                AppState.AddToast("این مرحله دیگر به سمت شما ارجاع نشده است؛ فهرست به‌روزرسانی شد.", ToastLevel.Info);
+                await LoadAsync();
+                return;
+            }
+
+            var comment = GetComment(item.Request.Id);
+            try
+            {
+                switch (action)
+                {
+                    case WorkflowAction.Approve: request.Approve(currentStep.Id, employeeId, comment); break;
+                    case WorkflowAction.Reject: request.Reject(currentStep.Id, employeeId, comment); break;
+                    case WorkflowAction.ReturnToRequester: request.ReturnToRequester(currentStep.Id, employeeId, comment); break;
+                    case WorkflowAction.ReturnToPreviousStep: request.ReturnToPreviousStep(currentStep.Id, employeeId, comment); break;
+                }
+            }
+            catch (InvalidOperationException ex)
+            {
+                AppState.AddToast(ex.Message, ToastLevel.Error);
+                return;
+            }
+
+            await db.SaveChangesAsync();
+            _comments.Remove(item.Request.Id);
+            AppState.AddToast("ثبت شد.", ToastLevel.Success);
+            await LoadAsync();
+        }
+        finally
+        {
+            _actingRequestId = null;
+        }
+    }
+}
diff --git a/src/YasPortal.Web/Components/Pages/Requests/MyRequests.razor b/src/YasPortal.Web/Components/Pages/Requests/MyRequests.razor
new file mode 100644
