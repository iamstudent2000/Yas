     private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchPositionsAsync(string search, CancellationToken ct) => AdminQueries.SearchPositionsAsync(search, null, null, ct);
+    private Task<IReadOnlyList<AdminQueryService.LookupItem>> SearchEmployeesAsync(string search, CancellationToken ct) => AdminQueries.SearchEmployeesAsync(search, ct);
+
+    private async Task PreviewEmployeeChanged(Guid? employeeId)
+    {
+        _previewEmployeeId = employeeId;
+        _previewResults = [];
+        _previewHolderNames = [];
+        if (employeeId is not Guid id)
+            return;
+
+        _previewLoading = true;
+        await InvokeAsync(StateHasChanged);
+        try
+        {
+            await using var db = await DbFactory.CreateDbContextAsync();
+            var positions = await db.EmployeePositions.AsNoTracking()
+                .Where(x => x.EmployeeId == id && x.EndedAt == null)
+                .Join(db.Positions.AsNoTracking(), ep => ep.PositionId, p => p.Id, (ep, p) => new { p.Id, p.Name })
+                .ToListAsync();
+
+            var results = new List<(string, WorkflowService.ResolveResult)>();
+            var allApproverIds = new HashSet<Guid>();
+            foreach (var position in positions)
+            {
+                var result = await WorkflowSvc.ResolveStepsAsync(_selectedType, position.Id);
+                results.Add((position.Name, result));
+                if (result.Success)
+                    foreach (var step in result.Steps)
+                        allApproverIds.Add(step.ApproverPositionId);
+            }
+            _previewResults = results;
+            _previewHolderNames = allApproverIds.Count == 0 ? [] : await WorkflowSvc.GetCurrentHolderNamesAsync(allApproverIds);
+        }
+        finally { _previewLoading = false; }
+    }
+
+    /// <summary>Adds a copy of an existing step at the end of the list — a quick way to build
+    /// out a similar path (e.g. the same fixed-position step reused for another workflow type
+    /// isn't supported directly here, but duplicating within a type to tweak one field is).</summary>
+    private async Task DuplicateStep(WorkflowStepDefinition step)
+    {
+        await using var db = await DbFactory.CreateDbContextAsync();
+        var nextOrder = (await db.WorkflowStepDefinitions.Where(x => x.WorkflowType == _selectedType).Select(x => (int?)x.Order).MaxAsync() ?? 0) + 1;
+        var copy = step.ApproverRuleKind == ApproverRuleKind.RequesterManagerLevel
+            ? new WorkflowStepDefinition(_selectedType, nextOrder, step.Name + " (کپی)", step.ManagerLevel!.Value)
+            : new WorkflowStepDefinition(_selectedType, nextOrder, step.Name + " (کپی)", step.ApproverPositionId!.Value);
+        db.WorkflowStepDefinitions.Add(copy);
+        await db.SaveChangesAsync();
+        AppState.AddToast("مرحله کپی شد؛ می‌توانید آن را ویرایش کنید.", ToastLevel.Success);
+        await LoadStepsAsync();
+    }
 
