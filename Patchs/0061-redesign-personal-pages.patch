diff --git a/src/YasPortal.Web/wwwroot/css/personal-pages.css b/src/YasPortal.Web/wwwroot/css/personal-pages.css
new file mode 100644
index 0000000..71c62cc
--- /dev/null
+++ b/src/YasPortal.Web/wwwroot/css/personal-pages.css
@@ -0,0 +1,92 @@
+/* =============================================================
+   Personal pages — Dashboard, My Profile, My Positions
+   Scoped under .dashboard-page / .profile-page / .positions-page so
+   nothing here can leak into the admin section or other pages.
+   Loaded after the admin stylesheet set so its refinements win; see
+   App.razor for the <link> order note.
+   ============================================================= */
+
+.badge-primary{background:#eef2ff;color:#1d4ed8}
+
+/* ---- shared "fact row" pattern used by dashboard + profile ---- */
+.dash-facts,.profile-facts{display:flex;flex-direction:column;gap:0;margin:0;padding:0}
+.dash-fact,.profile-fact{display:flex;align-items:center;gap:12px;padding:13px 4px;border-bottom:1px solid #eef1f5}
+.dash-fact:last-child,.profile-fact:last-child{border-bottom:0}
+.dash-fact i,.profile-fact dt i{width:34px;height:34px;flex:0 0 34px;display:grid;place-items:center;border-radius:10px;background:#eef2ff;color:#1d4ed8;font-size:17px}
+.dash-fact div{display:flex;flex-direction:column;gap:2px;min-width:0}
+.dash-fact span,.profile-fact dt{margin:0;font-size:11.5px;color:#667085;display:flex;align-items:center;gap:8px}
+.dash-fact strong,.profile-fact dd{margin:0;font-size:13.5px;font-weight:700;color:#1b2333;overflow:hidden;text-overflow:ellipsis}
+.profile-fact{justify-content:space-between}
+.profile-fact dt{flex:0 0 auto}
+.profile-fact dd{text-align:left}
+
+/* =============================================================
+   Dashboard
+   ============================================================= */
+.dash-hero{position:relative;overflow:hidden;display:flex;align-items:center;gap:20px;flex-wrap:wrap;background:#fff;border:1px solid #e6ebf2;border-radius:16px;padding:22px 26px;margin-bottom:16px;box-shadow:0 6px 24px rgba(16,24,40,.045)}
+.dash-hero-bloom{position:absolute;width:190px;height:190px;left:-40px;top:-50px;color:#eef2ff;pointer-events:none}
+.dash-hero-text{position:relative;flex:1 1 260px;min-width:0}
+.dash-hero-greeting{margin:0;font-size:13px;color:#667085}
+.dash-hero-text h2{margin:2px 0 0;font-size:24px;font-weight:800;letter-spacing:-.01em;color:#141c2c}
+.dash-hero-role{margin:6px 0 0;font-size:12.5px;color:#667085;line-height:1.8}
+.dash-hero-position{position:relative;flex:0 0 auto;display:flex;flex-direction:column;gap:6px;padding:14px 18px;border-radius:13px;background:linear-gradient(160deg,#eef2ff,#eafaf1);min-width:170px}
+.dash-hero-position span{font-size:11px;color:#3854a6}
+.dash-hero-position strong{font-size:15px;font-weight:800;color:#182751}
+.dash-hero-position a{display:inline-flex;align-items:center;gap:4px;margin-top:2px;font-size:11.5px;font-weight:700;color:#1d4ed8}
+.dash-hero-position a i{font-size:14px}
+
+.dash-columns{display:grid;grid-template-columns:1fr 1.15fr;gap:16px;align-items:start}
+.dash-facts,.dash-links{background:#fff;border:1px solid #e6ebf2;border-radius:16px;padding:18px 20px;box-shadow:0 6px 24px rgba(16,24,40,.04)}
+
+.dash-link{display:flex;align-items:center;gap:12px;padding:12px 8px;border-radius:11px;color:inherit;transition:background .14s}
+.dash-link+.dash-link{margin-top:2px}
+.dash-link:hover{background:#f7f9fc}
+.dash-link-icon{width:38px;height:38px;flex:0 0 38px;display:grid;place-items:center;border-radius:11px;background:#eef2ff;color:#1d4ed8;font-size:19px}
+.dash-link-text{display:flex;flex-direction:column;gap:2px;flex:1;min-width:0}
+.dash-link-text strong{font-size:13.5px;color:#1b2333}
+.dash-link-text small{font-size:11.5px;color:#667085}
+.dash-link-arrow{color:#98a2b3;font-size:17px;flex:0 0 auto}
+
+@media(max-width:900px){.dash-columns{grid-template-columns:1fr}}
+@media(max-width:520px){.dash-hero{padding:18px}.dash-hero-text h2{font-size:20px}.dash-hero-position{width:100%}}
+
+/* =============================================================
+   Profile
+   ============================================================= */
+.profile-identity{position:relative;overflow:hidden;display:flex;align-items:center;gap:16px;background:#fff;border:1px solid #e6ebf2;border-radius:16px;padding:22px 26px;margin-bottom:16px;box-shadow:0 6px 24px rgba(16,24,40,.045)}
+.profile-avatar{position:relative;width:58px;height:58px;flex:0 0 58px;display:grid;place-items:center;border-radius:50%;background:linear-gradient(160deg,#1d4ed8,#2f6f4f);color:#fff;font-size:22px;font-weight:800}
+.profile-identity-text{position:relative;min-width:0}
+.profile-identity-text h2{margin:0;font-size:20px;font-weight:800;color:#141c2c}
+.profile-identity-chips{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:9px}
+.profile-chip{display:inline-flex;align-items:center;padding:4px 10px;border-radius:999px;background:#f2f4f7;color:#475467;font-size:11px;font-weight:600}
+.profile-identity-bloom{position:absolute;width:170px;height:170px;left:-40px;top:-60px;color:#f2f4f7;pointer-events:none}
+
+.profile-columns{display:grid;grid-template-columns:1.1fr 1fr;gap:16px;align-items:start}
+.profile-card{background:#fff;border:1px solid #e6ebf2;border-radius:16px;padding:18px 20px;box-shadow:0 6px 24px rgba(16,24,40,.04)}
+.profile-org-card p{margin:12px 0 0;color:#667085;font-size:12.5px;line-height:1.85}
+.profile-org-status{display:flex}
+.profile-org-link{display:inline-flex;align-items:center;gap:5px;margin-top:14px;font-size:12.5px;font-weight:700;color:#1d4ed8}
+.profile-org-link i{font-size:15px}
+
+@media(max-width:900px){.profile-columns{grid-template-columns:1fr}}
+@media(max-width:520px){.profile-identity{padding:18px;gap:12px}.profile-avatar{width:48px;height:48px;flex-basis:48px;font-size:18px}.profile-identity-text h2{font-size:17px}}
+
+/* =============================================================
+   My positions
+   ============================================================= */
+.position-active{position:relative;overflow:hidden;display:flex;align-items:center;gap:16px;background:linear-gradient(160deg,#eef2ff,#eafaf1);border:1px solid #d8e5ff;border-radius:16px;padding:20px 24px;margin-bottom:16px}
+.position-active-bloom{position:absolute;width:180px;height:180px;left:-40px;top:-55px;color:rgba(29,78,216,.08);pointer-events:none}
+.position-active-icon{position:relative;width:46px;height:46px;flex:0 0 46px;display:grid;place-items:center;border-radius:13px;background:#fff;color:#1d4ed8;font-size:23px;box-shadow:0 6px 16px rgba(29,78,216,.14)}
+.position-active-text{position:relative;flex:1;min-width:0}
+.position-active-text span{font-size:11.5px;color:#3854a6}
+.position-active-text h2{margin:2px 0 0;font-size:19px;font-weight:800;color:#182751}
+
+.position-others{background:#fff;border:1px solid #e6ebf2;border-radius:16px;padding:6px 20px 10px;box-shadow:0 6px 24px rgba(16,24,40,.04)}
+.position-others .section-title{padding-top:12px}
+.position-list{display:flex;flex-direction:column}
+.position-row{display:flex;align-items:center;gap:12px;padding:12px 2px;border-top:1px solid #eef1f5}
+.position-row-icon{width:36px;height:36px;flex:0 0 36px;display:grid;place-items:center;border-radius:10px;background:#f2f4f7;color:#667085;font-size:18px}
+.position-row-name{flex:1;min-width:0;font-size:13.5px;font-weight:700;color:#1b2333;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.position-row form{flex:0 0 auto}
+
+@media(max-width:600px){.position-active{padding:16px;gap:12px}.position-active-text h2{font-size:17px}.position-row{flex-wrap:wrap}.position-row form{width:100%}.position-row .btn{width:100%;justify-content:center}}
