+/* Pass 6: compact icon-rail sidebar. Collapsed, the sidebar is a narrow
+   icon-only rail; hovering it (or focusing anything inside) slides a wider
+   panel over the content without reflowing the page. Pinned, the panel is
+   simply always at full width. Flat treatment throughout — no drop shadows,
+   hairline dividers only, and tighter type/spacing than the previous pass.
+   Was an inline <style> block in PersistentSidebar.razor.
+   Markup: .sidebar > .sidebar-panel > .sidebar-brand + .sidebar-nav + .sidebar-footer,
+   with .sidebar-group / .sidebar-group-toggle / .sidebar-group-items inside nav. */
+:root {
+    --sidebar-rail-w: 60px;
+    --sidebar-open-w: 246px;
+}
+
+.sidebar-shell-toggle {
+    position: absolute;
+    opacity: 0;
+    pointer-events: none;
+}
+
+/* The <aside> reserves layout width; .sidebar-panel is what actually expands,
+   so hover-expansion overlays the content instead of pushing it. */
+/* position:sticky always creates a stacking context, so .sidebar-panel's
+   z-index is scoped inside .sidebar. The rail must therefore outrank the
+   sticky topbar (z-index 1000) itself, or the hover-expanded panel would
+   slide underneath it. */
+.sidebar {
+    visibility: hidden;
+    position: sticky;
+    top: 0;
+    z-index: 1100;
+    height: 100vh;
+    overflow: visible;
+    padding: 0;
+    border: 0;
+    border-left: 0;
+    background: transparent;
+    box-shadow: none;
+    flex: 0 0 var(--sidebar-open-w);
+    width: var(--sidebar-open-w);
+    transition: flex-basis .16s ease, width .16s ease;
+}
+
+.sidebar.sidebar-state-ready {
+    visibility: visible;
+}
+
+.sidebar.sidebar-rail {
+    flex-basis: var(--sidebar-rail-w);
+    width: var(--sidebar-rail-w);
+}
+
+.sidebar-panel {
+    position: absolute;
+    inset-block: 0;
+    inset-inline-start: 0;
+    z-index: 1099;
+    width: var(--sidebar-open-w);
+    display: flex;
+    flex-direction: column;
+    gap: 2px;
+    padding: 10px 8px;
+    overflow-x: hidden;
+    overflow-y: auto;
+    scrollbar-width: thin;
+    background: #fff;
+    border-inline-end: 1px solid #eceff4;
+    transition: width .16s ease;
+}
+
+.sidebar-rail .sidebar-panel {
+    width: var(--sidebar-rail-w);
+}
+
+.sidebar-rail:hover .sidebar-panel,
+.sidebar-rail:focus-within .sidebar-panel {
+    width: var(--sidebar-open-w);
+    border-inline-end-color: #e4e8ee;
+}
+
+/* Brand / pin control */
+.sidebar-brand {
+    display: flex;
+    align-items: center;
+    gap: 9px;
+    min-height: 36px;
+    margin: 0 0 8px;
+    padding: 3px 5px;
+    border-radius: 9px;
+    color: #155eef;
+    cursor: pointer;
+    user-select: none;
+}
+
+.sidebar-brand:hover {
+    background: #f4f7fd;
+}
+
+.sidebar-brand .brand-mark {
+    width: 30px;
+    height: 30px;
+    flex: 0 0 30px;
+    border-radius: 9px;
+    display: grid;
+    place-items: center;
+    background: #155eef;
+    color: #fff;
+    box-shadow: none;
+}
+
+.sidebar-brand .brand-mark svg {
+    width: 18px;
+    height: 18px;
+}
+
+.sidebar-brand .brand-text {
+    font-size: 15px;
+    font-weight: 700;
+    white-space: nowrap;
+}
+
+/* Group headers */
+.sidebar-group {
+    margin-bottom: 1px;
+}
+
+.sidebar-group-toggle {
+    width: 100%;
+    display: flex;
+    align-items: center;
+    gap: 9px;
+    min-height: 34px;
+    padding: 6px 5px;
+    border: 0;
+    border-radius: 8px;
+    background: transparent;
+    color: #475467;
+    font: inherit;
+    font-size: 12.5px;
+    text-align: right;
+    cursor: pointer;
+    transition: background .12s ease, color .12s ease;
+}
+
+.sidebar-group-toggle:hover {
+    background: #f4f6f9;
+    color: #172033;
+}
+
+.sidebar-group-toggle i:first-child {
+    width: 30px;
+    flex: 0 0 30px;
+    text-align: center;
+    font-size: 17px;
+    line-height: 1;
+    color: #667085;
+}
+
+.sidebar-group-toggle .group-title {
+    flex: 1;
+    min-width: 0;
+    font-weight: 600;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+
+.sidebar-group-toggle .group-chevron {
+    font-size: 14px;
+    color: #b6becc;
+    transition: transform .15s ease;
+}
+
+.sidebar-group-toggle.expanded .group-chevron {
+    transform: rotate(180deg);
+}
+
+.sidebar-group-toggle.active-parent {
+    color: #155eef;
+    font-weight: 700;
+}
+
+.sidebar-group-toggle.active-parent i:first-child,
+.sidebar-group-toggle.active-parent .group-chevron {
+    color: #155eef;
+}
+
+/* Child links */
+.sidebar-group-items {
+    display: flex;
+    flex-direction: column;
+    gap: 1px;
+    margin: 1px 0 3px;
+    padding-inline-start: 0;
+    padding-inline-end: 19px;
+    border: 0;
+    border-inline-end: 1px solid #eef1f5;
+    overflow: hidden;
+    max-height: 0;
+    opacity: 0;
+    visibility: hidden;
+    transition: max-height .14s ease, opacity .1s ease;
+}
+
+.sidebar-group-items.expanded {
+    max-height: 400px;
+    opacity: 1;
+    visibility: visible;
+}
+
+.sidebar-nav {
+    display: flex;
+    flex-direction: column;
+    gap: 1px;
+}
+
+.sidebar-nav a,
+.sidebar-group-items a {
+    display: flex;
+    align-items: center;
+    gap: 9px;
+    min-height: 31px;
+    padding: 5px 7px;
+    border: 1px solid transparent;
+    border-radius: 7px;
+    font-size: 12.5px;
+    color: #475467;
+    white-space: nowrap;
+    transition: background .12s ease, color .12s ease;
+}
+
+.sidebar-nav a i,
+.sidebar-group-items a i {
+    font-size: 16px;
+    line-height: 1;
+    color: #98a2b3;
+}
+
+.sidebar-nav a:hover,
+.sidebar-group-items a:hover {
+    background: #f4f6f9;
+    color: #172033;
+    border-color: transparent;
+}
+
+.sidebar-nav a.active,
+.sidebar-group-items a.active {
+    background: #eef4ff;
+    color: #155eef;
+    font-weight: 700;
+    border-color: transparent;
+    box-shadow: none;
+}
+
+.sidebar-nav a.active i,
+.sidebar-group-items a.active i {
+    color: #155eef;
+}
+
+/* Ungrouped top-level links (e.g. audit log) keep the rail's icon gutter. */
+.sidebar-nav > a i {
+    width: 30px;
+    flex: 0 0 30px;
+    text-align: center;
+}
+
+/* Footer */
+.sidebar-footer {
+    margin: auto 0 0;
+    display: flex;
+    align-items: center;
+    gap: 9px;
+    padding: 8px 5px 2px;
+    border: 0;
+    border-top: 1px solid #eef1f5;
+    border-radius: 0;
+    background: transparent;
+    white-space: nowrap;
+}
+
+.sidebar-footer i {
+    width: 30px;
+    flex: 0 0 30px;
+    text-align: center;
+    font-size: 17px;
+    color: #98a2b3;
+}
+
+.sidebar-footer strong {
+    display: block;
+    font-size: 11.5px;
+}
+
+.sidebar-footer small {
+    display: block;
+    font-size: 10.5px;
+    color: #98a2b3;
+}
+
+/* Rail state: hide every label, keep only the icon gutter visible. */
+.sidebar-rail .sidebar-panel:not(:hover) .brand-text,
+.sidebar-rail .sidebar-panel:not(:hover) .group-title,
+.sidebar-rail .sidebar-panel:not(:hover) .group-chevron,
+.sidebar-rail .sidebar-panel:not(:hover) .sidebar-nav a span,
+.sidebar-rail .sidebar-panel:not(:hover) .sidebar-footer div {
+    opacity: 0;
+    pointer-events: none;
+}
+
+/* Collapsed groups still show their icon, so expose children on the rail only
+   while it is open; otherwise the rail would show duplicate icon rows. */
+.sidebar-rail .sidebar-panel:not(:hover) .sidebar-group-items {
+    max-height: 0;
+    opacity: 0;
+    visibility: hidden;
+}
+
+.sidebar-rail .sidebar-panel:not(:hover) .sidebar-footer {
+    border-top-color: transparent;
+}
+
+@media (max-width:850px) {
+
+    .sidebar-shell-toggle,
+    .sidebar-brand {
+        display: none;
     }
 
