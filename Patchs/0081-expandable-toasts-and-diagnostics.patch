From 5caf376d5ce0dc4787e2f53303fce9a40105b117 Mon Sep 17 00:00:00 2001
From: Claude <claude@example.com>
Date: Sun, 27 Sep 2026 15:49:49 +0000
Subject: [PATCH] Make toasts expandable to read full error text; log full
 diagnostics (entity type/state) for concurrency failures

---
 .../Components/AppNotifications.razor         | 13 ++++++++++--
 .../Pages/Requests/MyRequests.razor           | 20 +++++++++++++++++--
 .../wwwroot/css/notifications.css             | 12 +++++++++++
 3 files changed, 41 insertions(+), 4 deletions(-)

diff --git a/src/YasPortal.Web/Components/AppNotifications.razor b/src/YasPortal.Web/Components/AppNotifications.razor
index f3c25e6..509ced1 100644
--- a/src/YasPortal.Web/Components/AppNotifications.razor
+++ b/src/YasPortal.Web/Components/AppNotifications.razor
@@ -5,12 +5,13 @@
 <div class="app-toast-container" aria-live="polite" aria-relevant="additions removals">
     @foreach (var toast in AppState.Toasts)
     {
-        <div @key="toast.Id" class="app-toast app-toast-@toast.Level.ToString().ToLowerInvariant()" role="status">
+        var expanded = _expandedIds.Contains(toast.Id);
+        <div @key="toast.Id" class="app-toast app-toast-@toast.Level.ToString().ToLowerInvariant() @(expanded ? "app-toast-expanded" : "")" role="status">
             <div class="app-toast-icon" aria-hidden="true">
                 <i class="@GetIcon(toast.Level)"></i>
             </div>
 
-            <div class="app-toast-content">
+            <div class="app-toast-content" @onclick="() => ToggleExpanded(toast.Id)" style="cursor:pointer">
                 <div class="app-toast-title">@GetTitle(toast.Level)</div>
                 <div class="app-toast-message">@toast.Message</div>
             </div>
@@ -23,6 +24,14 @@
 </div>
 
 @code {
+    private readonly HashSet<Guid> _expandedIds = [];
+
+    private void ToggleExpanded(Guid id)
+    {
+        if (!_expandedIds.Add(id))
+            _expandedIds.Remove(id);
+    }
+
     protected override void OnInitialized()
     {
         AppState.OnChange += HandleStateChanged;
diff --git a/src/YasPortal.Web/Components/Pages/Requests/MyRequests.razor b/src/YasPortal.Web/Components/Pages/Requests/MyRequests.razor
index 482be30..2c173ae 100644
--- a/src/YasPortal.Web/Components/Pages/Requests/MyRequests.razor
+++ b/src/YasPortal.Web/Components/Pages/Requests/MyRequests.razor
@@ -283,7 +283,7 @@
         {
             // Never let an unexpected failure here leave the button stuck on "در حال
             // ارسال..." forever — surface it and let the finally block below reset the UI.
-            AppState.AddToast($"ثبت مجدد درخواست با خطا مواجه شد: {ex.Message}", ToastLevel.Error);
+            LogAndToastFailure(ex, "ثبت مجدد درخواست");
         }
         finally { _resubmittingId = null; }
     }
@@ -320,7 +320,7 @@
         }
         catch (Exception ex)
         {
-            AppState.AddToast($"لغو درخواست با خطا مواجه شد: {ex.Message}", ToastLevel.Error);
+            LogAndToastFailure(ex, "لغو درخواست");
         }
         finally { _cancellingId = null; }
     }
@@ -340,4 +340,20 @@
         var chars = value.Select(c => c is >= '0' and <= '9' ? digits[c - '0'] : c).ToArray();
         return new string(chars);
     }
+
+    /// <summary>
+    /// Logs full diagnostic detail to the server console (the toast itself only shows a short
+    /// summary, and for a DbUpdateConcurrencyException in particular the useful part — exactly
+    /// which entities were involved — isn't in .Message at all, only in .Entries).
+    /// </summary>
+    private void LogAndToastFailure(Exception ex, string actionDescription)
+    {
+        Console.WriteLine($"[{actionDescription}] {ex}");
+        if (ex is DbUpdateConcurrencyException concurrencyEx)
+        {
+            foreach (var entry in concurrencyEx.Entries)
+                Console.WriteLine($"  -> Entity: {entry.Entity.GetType().Name}, State: {entry.State}");
+        }
+        AppState.AddToast($"{actionDescription} با خطا مواجه شد: {ex.Message}", ToastLevel.Error);
+    }
 }
diff --git a/src/YasPortal.Web/wwwroot/css/notifications.css b/src/YasPortal.Web/wwwroot/css/notifications.css
index 804c960..d8c579b 100644
--- a/src/YasPortal.Web/wwwroot/css/notifications.css
+++ b/src/YasPortal.Web/wwwroot/css/notifications.css
@@ -106,6 +106,18 @@
     -webkit-line-clamp: 2;
 }
 
+.app-toast-container > .app-toast.app-toast-expanded {
+    overflow: visible !important;
+}
+
+.app-toast-expanded .app-toast-message {
+    display: block;
+    -webkit-line-clamp: unset;
+    max-height: 240px;
+    overflow-y: auto;
+    white-space: pre-wrap;
+}
+
 .app-toast-close {
     flex: 0 0 22px;
     width: 22px;
-- 
2.43.0

